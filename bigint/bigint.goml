package bigint;

use std::text;

const MAX_SHIFT: isize = 100000000;

#[derive(PartialEq, Eq, Debug)]
pub enum BigIntError {
    InvalidRadix(isize),
    EmptyInput,
    InvalidDigit {
        offset: isize,
        value: byte,
        radix: isize,
    },
    DivisionByZero,
    NegativeExponent(isize),
    ShiftTooLarge(isize),
}

impl ToString for BigIntError {
    fn to_string(self: BigIntError) -> string {
        match self {
            BigIntError::InvalidRadix(value) => "invalid BigInt radix " + value.to_string(),
            BigIntError::EmptyInput => "BigInt input has no digits",
            BigIntError::InvalidDigit { offset, value, radix } => {
                "invalid BigInt digit " + value.to_string() + " at byte " + offset.to_string()
                    + " for radix "
                    + radix.to_string()
            },
            BigIntError::DivisionByZero => "BigInt division by zero",
            BigIntError::NegativeExponent(value) => {
                "BigInt negative exponent " + value.to_string()
            },
            BigIntError::ShiftTooLarge(value) => {
                "BigInt shift count exceeds implementation limit: " + value.to_string()
            },
        }
    }
}

pub struct BigInteger {
    negative_value: bool,
    limbs_value: Vec[u32],
}

fn clone_limbs(value: Vec[u32]) -> Vec[u32] {
    let result = Vec::with_capacity(value.len());
    let mut index = 0;
    while index < value.len() {
        result.push(value[index]);
        index += 1;
    }
    result
}

fn normalize_limbs(value: Vec[u32]) -> () {
    let mut length = value.len();
    while length > 1 && value[length - 1] == 0 {
        length -= 1;
    }
    if length == 0 {
        value.push(0);
    } else {
        value.truncate(length);
    }
}

fn limbs_are_zero(value: Vec[u32]) -> bool {
    value.len() == 1 && value[0] == 0
}

fn make_owned(negative: bool, limbs: Vec[u32]) -> BigInteger {
    normalize_limbs(limbs);
    BigInteger { negative_value: negative && !limbs_are_zero(limbs), limbs_value: limbs }
}

fn make_copy(negative: bool, limbs: Vec[u32]) -> BigInteger {
    make_owned(negative, clone_limbs(limbs))
}

fn copy_big(value: BigInteger) -> BigInteger {
    make_copy(value.negative_value, value.limbs_value)
}

fn magnitude_compare(left: Vec[u32], right: Vec[u32]) -> isize {
    if left.len() < right.len() {
        return -1
    } else if left.len() > right.len() {
        return 1
    }
    let mut index = left.len();
    while index > 0 {
        let offset = index - 1;
        if left[offset] < right[offset] {
            return -1
        } else if left[offset] > right[offset] {
            return 1
        }
        index -= 1;
    }
    0
}

fn magnitude_add(left: Vec[u32], right: Vec[u32]) -> Vec[u32] {
    let length = if left.len() > right.len() {
        left.len()
    } else {
        right.len()
    };
    let result = Vec::with_capacity(length + 1);
    let mut carry = 0.to_u64();
    let mut index = 0;
    while index < length {
        let left_limb = if index < left.len() {
            left[index].to_u64()
        } else {
            0.to_u64()
        };
        let right_limb = if index < right.len() {
            right[index].to_u64()
        } else {
            0.to_u64()
        };
        let sum = left_limb + right_limb + carry;
        result.push((sum & 0xffffffff).to_u32());
        carry = sum >> 32;
        index += 1;
    }
    if carry != 0 {
        result.push(carry.to_u32());
    }
    result
}

fn magnitude_subtract(left: Vec[u32], right: Vec[u32]) -> Vec[u32] {
    let result = Vec::with_capacity(left.len());
    let base = 1.to_u64() << 32;
    let mut borrow = 0.to_u64();
    let mut index = 0;
    while index < left.len() {
        let left_limb = left[index].to_u64();
        let right_limb = if index < right.len() {
            right[index].to_u64()
        } else {
            0.to_u64()
        };
        let subtrahend = right_limb + borrow;
        if left_limb >= subtrahend {
            result.push((left_limb - subtrahend).to_u32());
            borrow = 0;
        } else {
            result.push((base + left_limb - subtrahend).to_u32());
            borrow = 1;
        }
        index += 1;
    }
    normalize_limbs(result);
    result
}

fn magnitude_multiply(left: Vec[u32], right: Vec[u32]) -> Vec[u32] {
    if limbs_are_zero(left) || limbs_are_zero(right) {
        return Vec::from_array([0])
    }
    let result: Vec[u32] = Vec::with_capacity(left.len() + right.len());
    let mut fill = 0;
    while fill < left.len() + right.len() {
        result.push(0);
        fill += 1;
    }
    let mut left_index = 0;
    while left_index < left.len() {
        let mut carry = 0.to_u64();
        let mut right_index = 0;
        while right_index < right.len() {
            let offset = left_index + right_index;
            let product = left[left_index].to_u64() * right[right_index].to_u64()
                + result[offset].to_u64()
                + carry;
            result[offset] = (product & 0xffffffff).to_u32();
            carry = product >> 32;
            right_index += 1;
        }
        result[left_index + right.len()] = carry.to_u32();
        left_index += 1;
    }
    normalize_limbs(result);
    result
}

fn magnitude_multiply_small(value: Vec[u32], factor: u32) -> () {
    if factor == 0 {
        value.truncate(1);
        value[0] = 0;
        return
    }
    let mut carry = 0.to_u64();
    let mut index = 0;
    while index < value.len() {
        let product = value[index].to_u64() * factor.to_u64() + carry;
        value[index] = (product & 0xffffffff).to_u32();
        carry = product >> 32;
        index += 1;
    }
    if carry != 0 {
        value.push(carry.to_u32());
    }
}

fn magnitude_add_small(value: Vec[u32], addend: u32) -> () {
    let mut carry = addend.to_u64();
    let mut index = 0;
    while carry != 0 {
        if index == value.len() {
            value.push(carry.to_u32());
            carry = 0;
        } else {
            let sum = value[index].to_u64() + carry;
            value[index] = (sum & 0xffffffff).to_u32();
            carry = sum >> 32;
            index += 1;
        }
    }
}

fn magnitude_divide_small(value: Vec[u32], divisor: u32) -> u32 {
    let mut remainder = 0.to_u64();
    let mut index = value.len();
    while index > 0 {
        let offset = index - 1;
        let current = (remainder << 32) | value[offset].to_u64();
        value[offset] = (current / divisor.to_u64()).to_u32();
        remainder = current % divisor.to_u64();
        index -= 1;
    }
    normalize_limbs(value);
    remainder.to_u32()
}

fn uint32_bit_length(value: u32) -> isize {
    let mut remaining = value;
    let mut result = 0;
    while remaining != 0 {
        remaining >>= 1;
        result += 1;
    }
    result
}

fn magnitude_bit_length(value: Vec[u32]) -> isize {
    if limbs_are_zero(value) {
        0
    } else {
        (value.len() - 1) * 32 + uint32_bit_length(value[value.len() - 1])
    }
}

fn magnitude_shift_left(value: Vec[u32], count: isize) -> Vec[u32] {
    if count == 0 || limbs_are_zero(value) {
        return clone_limbs(value)
    }
    let word_count = count / 32;
    let bit_count = count % 32;
    let result = Vec::with_capacity(value.len() + word_count + 1);
    let mut index = 0;
    while index < word_count {
        result.push(0);
        index += 1;
    }
    let mut carry = 0.to_u64();
    index = 0;
    while index < value.len() {
        let shifted = (value[index].to_u64() << bit_count) | carry;
        result.push((shifted & 0xffffffff).to_u32());
        carry = shifted >> 32;
        index += 1;
    }
    if carry != 0 {
        result.push(carry.to_u32());
    }
    result
}

fn magnitude_shift_right(value: Vec[u32], count: isize) -> Vec[u32] {
    if count == 0 {
        return clone_limbs(value)
    }
    let word_count = count / 32;
    let bit_count = count % 32;
    if word_count >= value.len() {
        return Vec::from_array([0])
    }
    let result = Vec::with_capacity(value.len() - word_count);
    let mut index = word_count;
    while index < value.len() {
        let mut limb = value[index] >> bit_count;
        if bit_count != 0 && index + 1 < value.len() {
            limb |= value[index + 1] << (32 - bit_count);
        }
        result.push(limb);
        index += 1;
    }
    normalize_limbs(result);
    result
}

fn magnitude_has_discarded_bits(value: Vec[u32], count: isize) -> bool {
    let word_count = count / 32;
    let bit_count = count % 32;
    if word_count >= value.len() {
        return !limbs_are_zero(value)
    }
    let mut index = 0;
    while index < word_count {
        if value[index] != 0 {
            return true
        }
        index += 1;
    }
    bit_count != 0 && value[word_count] & ((1.to_u32() << bit_count) - 1) != 0
}

fn magnitude_set_bit(value: Vec[u32], bit: isize) -> () {
    let word = bit / 32;
    while value.len() <= word {
        value.push(0);
    }
    value[word] |= 1.to_u32() << (bit % 32);
}

fn magnitude_div_rem(numerator: Vec[u32], denominator: Vec[u32]) -> (Vec[u32], Vec[u32]) {
    if magnitude_compare(numerator, denominator) < 0 {
        return (Vec::from_array([0]), clone_limbs(numerator))
    }
    let mut remainder = clone_limbs(numerator);
    let quotient = Vec::from_array([0]);
    let mut shift = magnitude_bit_length(numerator) - magnitude_bit_length(denominator);
    let mut shifted = magnitude_shift_left(denominator, shift);
    while shift >= 0 {
        if magnitude_compare(remainder, shifted) >= 0 {
            remainder = magnitude_subtract(remainder, shifted);
            magnitude_set_bit(quotient, shift);
        }
        if shift > 0 {
            shifted = magnitude_shift_right(shifted, 1);
        }
        shift -= 1;
    }
    normalize_limbs(quotient);
    (quotient, remainder)
}

fn digit_value(value: byte) -> Option[isize] {
    if value >= b'0' && value <= b'9' {
        Option::Some((value - b'0').to_isize())
    } else if value >= b'a' && value <= b'z' {
        Option::Some((value - b'a' + 10).to_isize())
    } else if value >= b'A' && value <= b'Z' {
        Option::Some((value - b'A' + 10).to_isize())
    } else {
        Option::None
    }
}

fn digit_byte(value: u32) -> byte {
    if value < 10 {
        (value + 48).to_u8()
    } else {
        (value + 87).to_u8()
    }
}

fn unsigned_to_string(value: Vec[u32], radix: isize) -> string {
    if limbs_are_zero(value) {
        return "0"
    }
    let remaining = clone_limbs(value);
    let reversed: Vec[byte] = Vec::new();
    while !limbs_are_zero(remaining) {
        reversed.push(digit_byte(magnitude_divide_small(remaining, radix.to_u32())));
    }
    let builder = text::StringBuilder::with_capacity(reversed.len());
    let mut index = reversed.len();
    while index > 0 {
        builder.values.push(reversed[index - 1]);
        index -= 1;
    }
    builder.finish()
}

fn twos_complement(value: BigInteger, width: isize) -> Vec[u32] {
    let result = Vec::with_capacity(width);
    let mut index = 0;
    while index < width {
        result.push(
            if index < value.limbs_value.len() {
                value.limbs_value[index]
            } else {
                0
            },
        );
        index += 1;
    }
    if value.negative_value {
        let mut carry = 1.to_u64();
        index = 0;
        while index < result.len() {
            let converted = (~result[index]).to_u64() + carry;
            result[index] = (converted & 0xffffffff).to_u32();
            carry = converted >> 32;
            index += 1;
        }
    }
    result
}

fn from_twos_complement(value: Vec[u32]) -> BigInteger {
    let negative = value[value.len() - 1] & 0x80000000 != 0;
    if !negative {
        make_owned(false, value)
    } else {
        let magnitude = Vec::with_capacity(value.len());
        let mut carry = 1.to_u64();
        let mut index = 0;
        while index < value.len() {
            let converted = (~value[index]).to_u64() + carry;
            magnitude.push((converted & 0xffffffff).to_u32());
            carry = converted >> 32;
            index += 1;
        }
        make_owned(true, magnitude)
    }
}

fn bitwise_width(left: BigInteger, right: BigInteger) -> isize {
    let maximum = if left.limbs_value.len() > right.limbs_value.len() {
        left.limbs_value.len()
    } else {
        right.limbs_value.len()
    };
    maximum + 1
}

fn validate_shift(count: isize) -> Result[isize, BigIntError] {
    if count < -MAX_SHIFT || count > MAX_SHIFT {
        Result::Err(BigIntError::ShiftTooLarge(count))
    } else if count < 0 {
        Result::Ok(-count)
    } else {
        Result::Ok(count)
    }
}

pub fn parse_radix(value: string, radix: isize) -> Result[BigInteger, BigIntError] {
    if radix < 2 || radix > 36 {
        return Result::Err(BigIntError::InvalidRadix(radix))
    }
    let mut index = 0;
    let mut negative = false;
    if index < value.byte_len() && (value.byte_get(index) == b'+' || value.byte_get(index) == b'-') {
        negative = value.byte_get(index) == b'-';
        index += 1;
    }
    if index == value.byte_len() {
        return Result::Err(BigIntError::EmptyInput)
    }
    let limbs = Vec::from_array([0]);
    while index < value.byte_len() {
        let current = value.byte_get(index);
        let digit = match digit_value(current) {
            Some(value) => value,
            None => {
                return Result::Err(
                    BigIntError::InvalidDigit { offset: index, value: current, radix },
                )
            },
        };
        if digit >= radix {
            return Result::Err(BigIntError::InvalidDigit { offset: index, value: current, radix })
        }
        magnitude_multiply_small(limbs, radix.to_u32());
        magnitude_add_small(limbs, digit.to_u32());
        index += 1;
    }
    Result::Ok(make_owned(negative, limbs))
}

pub fn parse(value: string) -> Result[BigInteger, BigIntError] {
    parse_radix(value, 10)
}

impl BigInteger {
    pub fn zero() -> BigInteger {
        make_owned(false, Vec::from_array([0]))
    }

    pub fn one() -> BigInteger {
        make_owned(false, Vec::from_array([1]))
    }

    pub fn from_uint64(value: u64) -> BigInteger {
        let limbs = Vec::from_array([(value & 0xffffffff).to_u32()]);
        let high = (value >> 32).to_u32();
        if high != 0 {
            limbs.push(high);
        }
        make_owned(false, limbs)
    }

    pub fn from_int64(value: i64) -> BigInteger {
        let negative = value < 0;
        let magnitude = if negative {
            (-(value + 1)).to_u64() + 1
        } else {
            value.to_u64()
        };
        let result = BigInteger::from_uint64(magnitude);
        make_copy(negative, result.limbs_value)
    }

    pub fn from_parts(negative: bool, limbs: Vec[u32]) -> BigInteger {
        make_copy(negative, limbs)
    }

    pub fn parse(value: string) -> Result[BigInteger, BigIntError] {
        parse(value)
    }

    pub fn parse_radix(value: string, radix: isize) -> Result[BigInteger, BigIntError] {
        parse_radix(value, radix)
    }

    pub fn is_zero(self: BigInteger) -> bool {
        limbs_are_zero(self.limbs_value)
    }

    pub fn is_negative(self: BigInteger) -> bool {
        self.negative_value
    }

    pub fn signum(self: BigInteger) -> isize {
        if self.is_zero() {
            0
        } else if self.negative_value {
            -1
        } else {
            1
        }
    }

    pub fn limbs(self: BigInteger) -> Vec[u32] {
        clone_limbs(self.limbs_value)
    }

    pub fn limb_count(self: BigInteger) -> isize {
        self.limbs_value.len()
    }

    pub fn bit_length(self: BigInteger) -> isize {
        magnitude_bit_length(self.limbs_value)
    }

    pub fn copy(self: BigInteger) -> BigInteger {
        copy_big(self)
    }

    pub fn abs(self: BigInteger) -> BigInteger {
        make_copy(false, self.limbs_value)
    }

    pub fn negate(self: BigInteger) -> BigInteger {
        make_copy(!self.negative_value, self.limbs_value)
    }

    pub fn compare(self: BigInteger, other: BigInteger) -> isize {
        if self.negative_value && !other.negative_value {
            -1
        } else if !self.negative_value && other.negative_value {
            1
        } else {
            let magnitude = magnitude_compare(self.limbs_value, other.limbs_value);
            if self.negative_value {
                -magnitude
            } else {
                magnitude
            }
        }
    }

    pub fn add(self: BigInteger, other: BigInteger) -> BigInteger {
        if self.negative_value == other.negative_value {
            make_owned(self.negative_value, magnitude_add(self.limbs_value, other.limbs_value))
        } else {
            match magnitude_compare(self.limbs_value, other.limbs_value) {
                0 => BigInteger::zero(),
                result => if result > 0 {
                    make_owned(
                        self.negative_value,
                        magnitude_subtract(self.limbs_value, other.limbs_value),
                    )
                } else {
                    make_owned(
                        other.negative_value,
                        magnitude_subtract(other.limbs_value, self.limbs_value),
                    )
                },
            }
        }
    }

    pub fn subtract(self: BigInteger, other: BigInteger) -> BigInteger {
        self.add(other.negate())
    }

    pub fn multiply(self: BigInteger, other: BigInteger) -> BigInteger {
        make_owned(
            self.negative_value != other.negative_value,
            magnitude_multiply(self.limbs_value, other.limbs_value),
        )
    }

    pub fn div_rem(self: BigInteger, other: BigInteger) -> Result[
        (BigInteger, BigInteger),
        BigIntError,
    ] {
        if other.is_zero() {
            return Result::Err(BigIntError::DivisionByZero)
        }
        let (quotient, remainder) = magnitude_div_rem(self.limbs_value, other.limbs_value);
        Result::Ok(
            (
                make_owned(self.negative_value != other.negative_value, quotient),
                make_owned(self.negative_value, remainder),
            ),
        )
    }

    pub fn divide(self: BigInteger, other: BigInteger) -> Result[BigInteger, BigIntError] {
        let (quotient, _) = self.div_rem(other)?;
        Result::Ok(quotient)
    }

    pub fn remainder(self: BigInteger, other: BigInteger) -> Result[BigInteger, BigIntError] {
        let (_, remainder) = self.div_rem(other)?;
        Result::Ok(remainder)
    }

    pub fn pow(self: BigInteger, exponent: isize) -> Result[BigInteger, BigIntError] {
        if exponent < 0 {
            return Result::Err(BigIntError::NegativeExponent(exponent))
        }
        let mut remaining = exponent;
        let mut base = copy_big(self);
        let mut result = BigInteger::one();
        while remaining > 0 {
            if remaining % 2 == 1 {
                result = result.multiply(base);
            }
            remaining /= 2;
            if remaining > 0 {
                base = base.multiply(base);
            }
        }
        Result::Ok(result)
    }

    pub fn bit_and(self: BigInteger, other: BigInteger) -> BigInteger {
        let width = bitwise_width(self, other);
        let left = twos_complement(self, width);
        let right = twos_complement(other, width);
        let result = Vec::with_capacity(width);
        let mut index = 0;
        while index < width {
            result.push(left[index] & right[index]);
            index += 1;
        }
        from_twos_complement(result)
    }

    pub fn bit_or(self: BigInteger, other: BigInteger) -> BigInteger {
        let width = bitwise_width(self, other);
        let left = twos_complement(self, width);
        let right = twos_complement(other, width);
        let result = Vec::with_capacity(width);
        let mut index = 0;
        while index < width {
            result.push(left[index] | right[index]);
            index += 1;
        }
        from_twos_complement(result)
    }

    pub fn bit_xor(self: BigInteger, other: BigInteger) -> BigInteger {
        let width = bitwise_width(self, other);
        let left = twos_complement(self, width);
        let right = twos_complement(other, width);
        let result = Vec::with_capacity(width);
        let mut index = 0;
        while index < width {
            result.push(left[index] ^ right[index]);
            index += 1;
        }
        from_twos_complement(result)
    }

    pub fn bit_not(self: BigInteger) -> BigInteger {
        let width = self.limbs_value.len() + 1;
        let encoded = twos_complement(self, width);
        let result = Vec::with_capacity(width);
        let mut index = 0;
        while index < width {
            result.push(~encoded[index]);
            index += 1;
        }
        from_twos_complement(result)
    }

    pub fn shift_left(self: BigInteger, count: isize) -> Result[BigInteger, BigIntError] {
        let magnitude = validate_shift(count)?;
        if count < 0 {
            self.shift_right(magnitude)
        } else {
            Result::Ok(
                make_owned(self.negative_value, magnitude_shift_left(self.limbs_value, magnitude)),
            )
        }
    }

    pub fn shift_right(self: BigInteger, count: isize) -> Result[BigInteger, BigIntError] {
        let magnitude = validate_shift(count)?;
        if count < 0 {
            self.shift_left(magnitude)
        } else if !self.negative_value {
            Result::Ok(make_owned(false, magnitude_shift_right(self.limbs_value, magnitude)))
        } else {
            let discarded = magnitude_has_discarded_bits(self.limbs_value, magnitude);
            let shifted = magnitude_shift_right(self.limbs_value, magnitude);
            if discarded {
                magnitude_add_small(shifted, 1);
            }
            Result::Ok(make_owned(true, shifted))
        }
    }

    pub fn to_string_radix(self: BigInteger, radix: isize) -> Result[string, BigIntError] {
        if radix < 2 || radix > 36 {
            return Result::Err(BigIntError::InvalidRadix(radix))
        }
        let digits = unsigned_to_string(self.limbs_value, radix);
        Result::Ok(
            if self.negative_value {
                "-" + digits
            } else {
                digits
            },
        )
    }
}

impl PartialEq for BigInteger {
    fn eq(self: BigInteger, other: BigInteger) -> bool {
        self.compare(other) == 0
    }
}

impl Eq for BigInteger {}

impl ToString for BigInteger {
    fn to_string(self: BigInteger) -> string {
        match self.to_string_radix(10) {
            Ok(value) => value,
            Err(_) => "0",
        }
    }
}

impl Debug for BigInteger {
    fn debug(self: BigInteger) -> string {
        self.to_string()
    }
}
