package stringx;

use gomlang::quickjs::runtime;

const MAX_STRING_LENGTH: isize = 16777216;

#[derive(PartialEq, Eq, Debug)]
pub enum StringError {
    InvalidCount,
    LengthLimit,
}

fn empty() -> runtime::JsString {
    runtime::JsString::from_code_units(Vec::new())
}

fn clamp(value: isize, minimum: isize, maximum: isize) -> isize {
    if value < minimum {
        minimum
    } else if value > maximum {
        maximum
    } else {
        value
    }
}

fn matches_at(value: runtime::JsString, search: runtime::JsString, offset: isize) -> bool {
    if offset < 0 || offset + search.len() > value.len() {
        false
    } else {
        let mut index = 0;
        while index < search.len() {
            if value.get(offset + index) != search.get(index) {
                return false
            } else {};
            index += 1;
        }
        true
    }
}

pub fn index_of(value: runtime::JsString, search: runtime::JsString, from_index: isize) -> isize {
    let mut offset = clamp(from_index, 0, value.len());
    if search.len() == 0 {
        return offset
    } else {};
    while offset + search.len() <= value.len() {
        if matches_at(value, search, offset) {
            return offset
        } else {};
        offset += 1;
    }
    return -1
}

pub fn last_index_of(value: runtime::JsString, search: runtime::JsString, from_index: isize) -> isize {
    let mut offset = clamp(from_index, 0, value.len());
    if search.len() == 0 {
        return offset
    } else if search.len() > value.len() {
        return -1
    } else if offset + search.len() > value.len() {
        offset = value.len() - search.len();
    } else {};
    while offset >= 0 {
        if matches_at(value, search, offset) {
            return offset
        } else {};
        offset -= 1;
    }
    return -1
}

pub fn includes(value: runtime::JsString, search: runtime::JsString, from_index: isize) -> bool {
    index_of(value, search, from_index) >= 0
}

pub fn starts_with(value: runtime::JsString, search: runtime::JsString, position: isize) -> bool {
    matches_at(value, search, clamp(position, 0, value.len()))
}

pub fn ends_with(value: runtime::JsString, search: runtime::JsString, end_position: isize) -> bool {
    let end = clamp(end_position, 0, value.len());
    matches_at(value, search, end - search.len())
}

fn relative_index(value: isize, length: isize) -> isize {
    if value < 0 {
        if value < -length {
            0
        } else {
            length + value
        }
    } else {
        clamp(value, 0, length)
    }
}

pub fn relative_position(value: isize, length: isize) -> isize {
    relative_index(value, length)
}

pub fn slice(value: runtime::JsString, start: isize, end: isize) -> runtime::JsString {
    let from = relative_index(start, value.len());
    let to = relative_index(end, value.len());
    if to <= from {
        empty()
    } else {
        value.slice(from, to)
    }
}

pub fn substring(value: runtime::JsString, start: isize, end: isize) -> runtime::JsString {
    let first = clamp(start, 0, value.len());
    let second = clamp(end, 0, value.len());
    if first <= second {
        value.slice(first, second)
    } else {
        value.slice(second, first)
    }
}

pub fn at(value: runtime::JsString, index: isize) -> Option[runtime::JsString] {
    let offset = if index < 0 {
        value.len() + index
    } else {
        index
    };
    if offset < 0 || offset >= value.len() {
        Option::None
    } else {
        Option::Some(runtime::JsString::from_code_units(Vec::from_array([value.get(offset)])))
    }
}

pub fn char_at(value: runtime::JsString, index: isize) -> runtime::JsString {
    match at(value, index) {
        Some(value) => value,
        None => empty(),
    }
}

pub fn char_code_at(value: runtime::JsString, index: isize) -> Option[u16] {
    if index < 0 || index >= value.len() {
        Option::None
    } else {
        Option::Some(value.get(index))
    }
}

pub fn code_point_at(value: runtime::JsString, index: isize) -> Option[u32] {
    if index < 0 || index >= value.len() {
        Option::None
    } else {
        let first = value.get(index);
        if runtime::is_high_surrogate(first) && index + 1 < value.len() {
            match runtime::combine_surrogates(first, value.get(index + 1)) {
                Some(value) => Option::Some(value),
                None => Option::Some(first.to_u32()),
            }
        } else {
            Option::Some(first.to_u32())
        }
    }
}

fn checked_length(length: isize) -> Result[isize, StringError] {
    if length < 0 || length > MAX_STRING_LENGTH {
        Result::Err(StringError::LengthLimit)
    } else {
        Result::Ok(length)
    }
}

pub fn repeat(value: runtime::JsString, count: isize) -> Result[runtime::JsString, StringError] {
    if count < 0 {
        return Result::Err(StringError::InvalidCount)
    } else if count == 0 || value.len() == 0 {
        return Result::Ok(empty())
    } else if count > MAX_STRING_LENGTH / value.len() {
        return Result::Err(StringError::LengthLimit)
    } else {};
    let length = checked_length(value.len() * count)?;
    let units: Vec[u16] = Vec::with_capacity(length);
    let mut repetition = 0;
    while repetition < count {
        let mut index = 0;
        while index < value.len() {
            units.push(value.get(index));
            index += 1;
        }
        repetition += 1;
    }
    Result::Ok(runtime::JsString::from_code_units(units))
}

fn padding(value: runtime::JsString, target_length: isize, fill: runtime::JsString) -> Result[
    runtime::JsString,
    StringError,
] {
    if target_length <= value.len() || fill.len() == 0 {
        return Result::Ok(empty())
    } else {};
    let required = checked_length(target_length)? - value.len();
    let units: Vec[u16] = Vec::with_capacity(required);
    let mut index = 0;
    while index < required {
        units.push(fill.get(index % fill.len()));
        index += 1;
    }
    Result::Ok(runtime::JsString::from_code_units(units))
}

pub fn pad_start(value: runtime::JsString, target_length: isize, fill: runtime::JsString) -> Result[
    runtime::JsString,
    StringError,
] {
    Result::Ok(padding(value, target_length, fill)?.concat(value))
}

pub fn pad_end(value: runtime::JsString, target_length: isize, fill: runtime::JsString) -> Result[
    runtime::JsString,
    StringError,
] {
    Result::Ok(value.concat(padding(value, target_length, fill)?))
}

fn whitespace(value: u16) -> bool {
    value >= 0x0009 && value <= 0x000d || value == 0x0020 || value == 0x00a0 || value == 0x1680
        || value >= 0x2000 && value <= 0x200a
        || value == 0x2028
        || value == 0x2029
        || value == 0x202f
        || value == 0x205f
        || value == 0x3000
        || value == 0xfeff
}

pub fn trim_start(value: runtime::JsString) -> runtime::JsString {
    let mut start = 0;
    while start < value.len() && whitespace(value.get(start)) {
        start += 1;
    }
    value.slice(start, value.len())
}

pub fn trim_end(value: runtime::JsString) -> runtime::JsString {
    let mut end = value.len();
    while end > 0 && whitespace(value.get(end - 1)) {
        end -= 1;
    }
    value.slice(0, end)
}

pub fn trim(value: runtime::JsString) -> runtime::JsString {
    trim_end(trim_start(value))
}

fn append_value(output: Vec[u16], value: runtime::JsString) -> () {
    let mut index = 0;
    while index < value.len() {
        output.push(value.get(index));
        index += 1;
    }
}

pub fn replace_all(
    value: runtime::JsString,
    search: runtime::JsString,
    replacement: runtime::JsString,
) -> Result[runtime::JsString, StringError] {
    let output: Vec[u16] = Vec::new();
    let mut offset = 0;
    while offset <= value.len() {
        if matches_at(value, search, offset) {
            if output.len() > MAX_STRING_LENGTH - replacement.len() {
                return Result::Err(StringError::LengthLimit)
            } else {};
            append_value(output, replacement);
            if search.len() == 0 {
                if offset < value.len() {
                    output.push(value.get(offset));
                } else {};
                offset += 1;
            } else {
                offset += search.len();
            }
        } else {
            if offset < value.len() {
                output.push(value.get(offset));
            } else {};
            offset += 1;
        }
        if output.len() > MAX_STRING_LENGTH {
            return Result::Err(StringError::LengthLimit)
        } else {}
    }
    Result::Ok(runtime::JsString::from_code_units(output))
}

pub fn split(value: runtime::JsString, separator: runtime::JsString, limit: isize) -> Vec[
    runtime::JsString,
] {
    let result: Vec[runtime::JsString] = Vec::new();
    if limit <= 0 {
        return result
    } else if separator.len() == 0 {
        let mut index = 0;
        while index < value.len() && result.len() < limit {
            result.push(value.slice(index, index + 1));
            index += 1;
        }
        return result
    } else {};
    let mut start = 0;
    while result.len() < limit {
        let offset = index_of(value, separator, start);
        if offset < 0 {
            result.push(value.slice(start, value.len()));
            return result
        } else {
            result.push(value.slice(start, offset));
            start = offset + separator.len();
        }
    }
    result
}
