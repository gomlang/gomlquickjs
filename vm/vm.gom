package vm;

use gomlang::quickjs::arrayx;
use gomlang::quickjs::bytecode;
use gomlang::quickjs::dtoa;
use gomlang::quickjs::runtime;
use std::collections;
use std::math;
use std::num;
use std::text;

const MAX_CALL_DEPTH: int = 256;

pub enum VmErrorKind {
    VerificationFailed(Vec[bytecode::VerifyError]),
    StackUnderflow,
    InvalidConstant(int),
    InvalidLocal(int),
    InvalidUpvalue(int),
    InvalidJump(int),
    ExpectedObject,
    InvalidPropertyKey,
    TypeError(string),
    RangeError(string),
    ReferenceError(string),
    SyntaxError(string),
    SyntaxErrorAt(string, bytecode::SourceLocation),
    UriError(string),
    CallDepthExceeded,
    UnsupportedInstruction,
    Thrown(runtime::Value),
}

impl Debug for VmErrorKind {
    fn debug(self: VmErrorKind) -> string {
        match self {
            VmErrorKind::VerificationFailed(errors) => {
                "VerificationFailed(" + errors.len().to_string() + ")"
            },
            VmErrorKind::StackUnderflow => "StackUnderflow",
            VmErrorKind::InvalidConstant(index) => "InvalidConstant(" + index.to_string() + ")",
            VmErrorKind::InvalidLocal(index) => "InvalidLocal(" + index.to_string() + ")",
            VmErrorKind::InvalidUpvalue(index) => "InvalidUpvalue(" + index.to_string() + ")",
            VmErrorKind::InvalidJump(target) => "InvalidJump(" + target.to_string() + ")",
            VmErrorKind::ExpectedObject => "ExpectedObject",
            VmErrorKind::InvalidPropertyKey => "InvalidPropertyKey",
            VmErrorKind::TypeError(message) => "TypeError(" + message + ")",
            VmErrorKind::RangeError(message) => "RangeError(" + message + ")",
            VmErrorKind::ReferenceError(message) => "ReferenceError(" + message + ")",
            VmErrorKind::SyntaxError(message) => "SyntaxError(" + message + ")",
            VmErrorKind::SyntaxErrorAt(message, location) => {
                "SyntaxError(" + message + " at " + location.line.to_string() + ":"
                    + location.column.to_string()
                    + ")"
            },
            VmErrorKind::UriError(message) => "UriError(" + message + ")",
            VmErrorKind::CallDepthExceeded => "CallDepthExceeded",
            VmErrorKind::UnsupportedInstruction => "UnsupportedInstruction",
            VmErrorKind::Thrown(_) => "Thrown",
        }
    }
}

#[derive(Debug)]
pub struct VmError {
    pub offset: int,
    pub kind: VmErrorKind,
}

#[derive(PartialEq, Eq, Debug)]
pub struct NativeError {
    pub message: string,
}

type NativeCallable = (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
    runtime::Value,
    NativeError,
];

type NativeConstructorCallable = (runtime::Heap, runtime::ObjectId, Vec[runtime::Value]) -> Result[
    runtime::Value,
    NativeError,
];

type VmCallable = (runtime::Value, Vec[runtime::Value], int) -> Result[runtime::Value, VmError];

type VmConstructorCallable = (
    runtime::ObjectId,
    Vec[runtime::Value],
    Option[runtime::ObjectId],
    runtime::Value,
    int,
) -> Result[runtime::Value, VmError];

type VmConstructorPrepareCallable = (Vec[runtime::Value], int) -> Result[
    Vec[runtime::Value],
    VmError,
];

type VmSelfAllocatingConstructorCallable = (Vec[runtime::Value], int) -> Result[
    runtime::Value,
    VmError,
];

struct VmConstructorCallbacks {
    callback: Option[VmConstructorCallable],
    prepare: Option[VmConstructorPrepareCallable],
    self_allocating: Option[VmSelfAllocatingConstructorCallable],
}

type DynamicFunctionCompiler = (string, string) -> Result[bytecode::Function, string];

type DynamicEvalCompiler = (string, Vec[bytecode::EvalBinding]) -> Result[
    bytecode::Function,
    bytecode::SourceError,
];

pub type DynamicModuleLoader = (runtime::Value, runtime::Value, runtime::Value, int) -> Result[
    runtime::Value,
    VmError,
];

pub type AsyncFunctionRunner = (runtime::Value, int) -> Result[runtime::Value, VmError];

pub type AsyncGeneratorRunner = (runtime::Value, int) -> Result[runtime::Value, VmError];

pub struct HostPromiseCapability {
    promise_value: runtime::Value,
    resolve_value: runtime::Value,
    reject_value: runtime::Value,
}

impl HostPromiseCapability {
    pub fn new(promise: runtime::Value, resolve: runtime::Value, reject: runtime::Value) -> HostPromiseCapability {
        HostPromiseCapability {
            promise_value: promise,
            resolve_value: resolve,
            reject_value: reject,
        }
    }

    pub fn promise(self: HostPromiseCapability) -> runtime::Value {
        self.promise_value
    }

    pub fn resolve(self: HostPromiseCapability) -> runtime::Value {
        self.resolve_value
    }

    pub fn reject(self: HostPromiseCapability) -> runtime::Value {
        self.reject_value
    }
}

pub type HostPromiseCapabilityFactory = () -> Result[HostPromiseCapability, VmError];

pub type WorkerModuleLoader = (Context, runtime::ObjectId, string) -> Result[runtime::Value, string];

pub type MicrotaskDrainer = () -> int;

pub type MicrotaskPending = () -> bool;

pub enum PrimitiveKind {
    Boolean,
    Number,
    String,
    BigInt,
    Symbol,
}

pub enum ErrorPrototypeKind {
    Error,
    InternalError,
    TypeError,
    RangeError,
    ReferenceError,
    SyntaxError,
