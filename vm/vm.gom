    heap: runtime::Heap,
    functions: HashMap[runtime::ObjectId, Closure],
    bound_functions: HashMap[runtime::ObjectId, BoundFunction],
    function_objects: HashMap[uint64, runtime::ObjectId],
    template_objects: HashMap[uint64, runtime::ObjectId],
    native_functions: HashMap[runtime::ObjectId, NativeCallable],
    native_constructor_functions: HashMap[runtime::ObjectId, NativeConstructorCallable],
    vm_functions: HashMap[runtime::ObjectId, VmCallable],
    vm_constructor_functions: HashMap[runtime::ObjectId, VmConstructorCallbacks],
    native_constructors: collections::HashSet[runtime::ObjectId],
    stack: Vec[runtime::Value],
    locals: Vec[Ref[runtime::Value]],
    upvalues: Vec[UpvalueCell],
    global_object: Option[runtime::ObjectId],
    primitive_prototypes: PrimitivePrototypes,
    error_prototypes: ErrorPrototypes,
    object_builtin_tags: HashMap[runtime::ObjectId, runtime::JsString],
    regexp_constructor: Option[runtime::Value],
    iterator_symbol: Option[runtime::Symbol],
    to_primitive_symbol: Option[runtime::Symbol],
    has_instance_symbol: Option[runtime::Symbol],
    callee: Option[runtime::Value],
    arguments: Vec[runtime::Value],
    arguments_object: Ref[Option[runtime::ObjectId]],
    this_value: Ref[Option[runtime::Value]],
    home_object: Option[runtime::ObjectId],
    new_target: Option[runtime::Value],
    instance_initializer: Ref[Option[runtime::ObjectId]],
    active_frames: Vec[ActiveFrame],
    generators: GeneratorRuntime,
    dynamic_eval_compiler: Ref[Option[DynamicEvalCompiler]],
    dynamic_module_loader: Ref[Option[DynamicModuleLoader]],
    depth: int,
    eval_environment: Ref[Option[Ref[EvalEnvironment]]],
}

pub struct Context {
    heap_value: runtime::Heap,
    functions_value: HashMap[runtime::ObjectId, Closure],
    bound_functions_value: HashMap[runtime::ObjectId, BoundFunction],
    function_objects_value: HashMap[uint64, runtime::ObjectId],
    template_objects_value: HashMap[uint64, runtime::ObjectId],
    native_functions_value: HashMap[runtime::ObjectId, NativeCallable],
    native_constructor_functions_value: HashMap[runtime::ObjectId, NativeConstructorCallable],
    vm_functions_value: HashMap[runtime::ObjectId, VmCallable],
    vm_constructor_functions_value: HashMap[runtime::ObjectId, VmConstructorCallbacks],
    native_constructors_value: collections::HashSet[runtime::ObjectId],
    global_object_value: Ref[Option[runtime::ObjectId]],
    primitive_prototypes_value: PrimitivePrototypes,
    error_prototypes_value: ErrorPrototypes,
    regexp_constructor_value: Ref[Option[runtime::Value]],
    well_known_symbols_value: WellKnownSymbols,
    iterator_symbol_value: Ref[Option[runtime::Symbol]],
    object_builtin_tags_value: HashMap[runtime::ObjectId, runtime::JsString],
    dynamic_function_compiler_value: Ref[Option[DynamicFunctionCompiler]],
    dynamic_eval_compiler_value: Ref[Option[DynamicEvalCompiler]],
    dynamic_module_loader_value: Ref[Option[DynamicModuleLoader]],
    promise_capability_factory_value: Ref[Option[HostPromiseCapabilityFactory]],
    active_frames_value: Vec[ActiveFrame],
    host_jobs_value: Vec[HostJob],
    microtask_drainer_value: Ref[Option[MicrotaskDrainer]],
    microtask_pending_value: Ref[Option[MicrotaskPending]],
    generators_value: GeneratorRuntime,
    external_roots_value: Vec[Ref[runtime::Value]],
    virtual_modules_value: HashMap[string, runtime::Value],
    worker_module_loader_value: Ref[Option[WorkerModuleLoader]],
    current_module_path_value: Ref[Option[string]],
}

fn push_optional_root(roots: Vec[runtime::Value], value: Option[runtime::Value]) -> unit {
    match value {
        Some(value) => roots.push(value),
        None => (),
    }
}

fn push_optional_object_root(roots: Vec[runtime::Value], value: Option[runtime::ObjectId]) -> unit {
    match value {
        Some(value) => roots.push(runtime::Value::Object(value)),
        None => (),
    }
}

fn push_upvalue_roots(roots: Vec[runtime::Value], upvalues: Vec[UpvalueCell]) -> unit {
    for upvalue in upvalues {
        match upvalue {
            UpvalueCell::Value(value) => roots.push(value.get()),
            UpvalueCell::This(value) => push_optional_root(roots, value.get()),
        }
    }
}

fn push_eval_environment_roots(
    roots: Vec[runtime::Value],
    environment: Option[Ref[EvalEnvironment]],
) -> unit {
    let mut current = environment;
    loop {
        match current {
            Some(value) => {
                for (_, cell) in value.get().values.entries() {
                    roots.push(cell.get())
                }
                current = value.get().parent;
            },
            None => return,
        }
    }
}

fn push_active_frame_roots(roots: Vec[runtime::Value], frame: ActiveFrame) -> unit {
    for value in frame.stack {
        roots.push(value)
    }
    for value in frame.locals {
        roots.push(value.get())
    }
    push_upvalue_roots(roots, frame.upvalues);
    for value in frame.arguments {
        roots.push(value)
    }
    push_optional_root(roots, frame.this_value.get());
    push_optional_root(roots, frame.callee);
    push_optional_object_root(roots, frame.home_object);
    push_optional_root(roots, frame.new_target);
    push_optional_object_root(roots, frame.instance_initializer.get());
    push_optional_object_root(roots, frame.arguments_object.get());
    push_eval_environment_roots(roots, frame.eval_environment.get());
}

fn push_generator_frame_roots(roots: Vec[runtime::Value], frame: GeneratorFrame) -> unit {
    for value in frame.stack {
        roots.push(value)
    }
    for value in frame.locals {
        roots.push(value.get())
    }
    push_upvalue_roots(roots, frame.upvalues);
    for value in frame.arguments {
        roots.push(value)
    }
    push_optional_root(roots, frame.this_value.get());
    push_optional_root(roots, frame.callee);
    push_optional_object_root(roots, frame.home_object);
    push_optional_root(roots, frame.new_target);
    push_optional_object_root(roots, frame.instance_initializer.get());
    push_optional_object_root(roots, frame.arguments_object.get());
    for value in frame.request_roots.get() {
        roots.push(value)
    }
    push_eval_environment_roots(roots, frame.eval_environment.get());
}

fn generator_active_frame(frame: GeneratorFrame) -> ActiveFrame {
    ActiveFrame {
        function: frame.function,
        offset: frame.offset,
        stack: frame.stack,
        locals: frame.locals,
        upvalues: frame.upvalues,
        arguments: frame.arguments,
        this_value: frame.this_value,
        callee: frame.callee,
        home_object: frame.home_object,
        new_target: frame.new_target,
        instance_initializer: frame.instance_initializer,
        arguments_object: frame.arguments_object,
        eval_environment: frame.eval_environment,
    }
}

fn generator_result(heap: runtime::Heap, value: runtime::Value, done: bool) -> Result[
    runtime::Value,
    VmError,
] {
    let object = match runtime::new_ordinary_object(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(-1, VmErrorKind::TypeError(value.message))),
    };
    if !runtime::define_own_property(
        heap,
        object,
        runtime::string_property_key("value"),
        runtime::data_descriptor(value, true, true, true),
    )
        || !runtime::define_own_property(
            heap,
            object,
            runtime::string_property_key("done"),
            runtime::data_descriptor(runtime::Value::Bool(done), true, true, true),
        ) {
        Result::Err(error(-1, VmErrorKind::TypeError("cannot create generator result")))
    } else {
        Result::Ok(runtime::Value::Object(object))
    }
}

fn generator_completion_result(heap: runtime::Heap, completion: GeneratorCompletion) -> Result[
    runtime::Value,
    VmError,
] {
    match completion {
        GeneratorCompletion::Yield(value) => generator_result(heap, value, false),
        GeneratorCompletion::Return(value) => generator_result(heap, value, true),
        GeneratorCompletion::Await(_) => Result::Err(
            error(-1, VmErrorKind::TypeError("await escaped an async function frame")),
        ),
    }
}

impl Context {
    pub fn new(heap: runtime::Heap) -> Context {
        Context {
            heap_value: heap,
            functions_value: HashMap::{},
            bound_functions_value: HashMap::{},
            function_objects_value: HashMap::{},
            template_objects_value: HashMap::{},
            native_functions_value: HashMap::{},
            native_constructor_functions_value: HashMap::{},
            vm_functions_value: HashMap::{},
            vm_constructor_functions_value: HashMap::{},
            native_constructors_value: collections::HashSet::new(),
            global_object_value: Ref::new(Option::None),
            primitive_prototypes_value: PrimitivePrototypes::new(),
            error_prototypes_value: ErrorPrototypes::new(),
            regexp_constructor_value: Ref::new(Option::None),
            well_known_symbols_value: WellKnownSymbols::new(),
            iterator_symbol_value: Ref::new(Option::None),
            object_builtin_tags_value: HashMap::{},
            dynamic_function_compiler_value: Ref::new(Option::None),
            dynamic_eval_compiler_value: Ref::new(Option::None),
            dynamic_module_loader_value: Ref::new(Option::None),
            promise_capability_factory_value: Ref::new(Option::None),
            active_frames_value: Vec::[],
            host_jobs_value: Vec::[],
            microtask_drainer_value: Ref::new(Option::None),
            microtask_pending_value: Ref::new(Option::None),
            generators_value: GeneratorRuntime::new(),
            external_roots_value: Vec::[],
            virtual_modules_value: HashMap::{},
            worker_module_loader_value: Ref::new(Option::None),
            current_module_path_value: Ref::new(Option::None),
        }
    }

    pub fn heap(self: Context) -> runtime::Heap {
        self.heap_value
    }

    pub fn add_external_root(self: Context, value: Ref[runtime::Value]) -> unit {
        self.external_roots_value.push(value)
    }

    pub fn register_virtual_module(self: Context, specifier: string, value: runtime::Value) -> unit {
        self.virtual_modules_value[specifier] = value;
    }

    pub fn virtual_module(self: Context, specifier: string) -> Option[runtime::Value] {
        self.virtual_modules_value.get(specifier)
    }

    pub fn set_worker_module_loader(self: Context, loader: WorkerModuleLoader) -> unit {
        self.worker_module_loader_value.set(Option::Some(loader))
    }

    pub fn load_worker_module(
        self: Context,
        context: Context,
        global: runtime::ObjectId,
        path: string,
    ) -> Result[runtime::Value, string] {
        match self.worker_module_loader_value.get() {
            Some(loader) => loader(context, global, path),
            None => Result::Err("Worker module loader is not installed"),
        }
    }

    pub fn current_module_path(self: Context) -> Option[string] {
        self.current_module_path_value.get()
    }

    pub fn set_current_module_path(self: Context, path: Option[string]) -> unit {
        self.current_module_path_value.set(path)
    }

    pub fn collect_garbage(self: Context) -> runtime::GcStats {
        match self.microtask_pending_value.get() {
            Some(pending) => if pending() {
                let live = self.heap_value.live_count();
                return runtime::GcStats {
                    live_before: live,
                    reachable: live,
                    collected: 0,
                    live_after: live,
                }
            } else {},
            None => (),
        };
        let roots: Vec[runtime::Value] = Vec::[];
        let edges: Vec[runtime::GcEdge] = Vec::[];
        push_optional_object_root(roots, self.global_object_value.get());
        push_optional_root(roots, self.regexp_constructor_value.get());
        push_optional_object_root(roots, self.generators_value.prototype.get());
        push_optional_object_root(roots, self.generators_value.async_generator_prototype.get());
        for value in self.external_roots_value {
            roots.push(value.get())
        }
        for (_, value) in self.virtual_modules_value.entries() {
            roots.push(value)
        }
        for frame in self.active_frames_value {
            push_active_frame_roots(roots, frame)
        }
        for job in self.host_jobs_value {
            match job {
                HostJob::Callback { callback, arguments } => {
                    roots.push(callback);
                    for value in arguments {
                        roots.push(value)
                    }
                },
                HostJob::Task { roots: values, .. } => for value in values {
                    roots.push(value)
                },
            }
        }
        for (owner, frame) in self.generators_value.states.entries() {
            let values: Vec[runtime::Value] = Vec::[];
            push_generator_frame_roots(values, frame);
            edges.push(runtime::GcEdge { owner, values })
        }
        for (generator, _) in self.generators_value.async_roots.entries() {
            roots.push(runtime::Value::Object(generator))
        }
        for (owner, closure) in self.functions_value.entries() {
            let values: Vec[runtime::Value] = Vec::[];
            push_upvalue_roots(values, closure.upvalues);
            push_optional_object_root(values, closure.home_object.get());
            push_optional_root(values, closure.new_target);
            push_optional_object_root(values, closure.instance_initializer.get());
            push_eval_environment_roots(values, closure.eval_environment);
            edges.push(runtime::GcEdge { owner, values })
        }
        for (owner, bound) in self.bound_functions_value.entries() {
            let values: Vec[runtime::Value] = Vec::[bound.target, bound.this_value];
            for value in bound.arguments {
                values.push(value)
            }
            edges.push(runtime::GcEdge { owner, values })
        }
        for (_, object) in self.template_objects_value.entries() {
            roots.push(runtime::Value::Object(object))
        }
        for kind in Vec::[
            ErrorPrototypeKind::Error,
            ErrorPrototypeKind::InternalError,
            ErrorPrototypeKind::TypeError,
            ErrorPrototypeKind::RangeError,
            ErrorPrototypeKind::ReferenceError,
            ErrorPrototypeKind::SyntaxError,
            ErrorPrototypeKind::UriError,
        ] {
            push_optional_object_root(roots, self.error_prototypes_value.slot(kind).get())
        }
        match self.iterator_symbol_value.get() {
            Some(value) => roots.push(runtime::Value::Symbol(value)),
            None => (),
        };
        for kind in Vec::[
            WellKnownSymbolKind::AsyncIterator,
            WellKnownSymbolKind::HasInstance,
            WellKnownSymbolKind::IsConcatSpreadable,
            WellKnownSymbolKind::Match,
            WellKnownSymbolKind::MatchAll,
            WellKnownSymbolKind::Replace,
            WellKnownSymbolKind::Search,
            WellKnownSymbolKind::Species,
            WellKnownSymbolKind::Split,
            WellKnownSymbolKind::ToPrimitive,
            WellKnownSymbolKind::ToStringTag,
            WellKnownSymbolKind::Unscopables,
        ] {
            match self.well_known_symbols_value.slot(kind).get() {
                Some(value) => roots.push(runtime::Value::Symbol(value)),
                None => (),
            }
        }
        let result = self.heap_value.collect_with_edges(roots, edges);
        let stale: Vec[runtime::ObjectId] = Vec::[];
        for (object, _) in self.generators_value.states.entries() {
            if !self.heap_value.contains(object) {
                stale.push(object)
            } else {}
        }
        for object in stale {
            let _ = self.generators_value.states.remove(object);
        }
        result
    }

    pub fn run_finalization_jobs_at_depth(self: Context, depth: int) -> int {
        let mut count = 0;
        while count < 16777216 {
            let job = match runtime::pop_finalization_job(self.heap_value) {
                Some(value) => value,
                None => return count,
            };
            let _ = self.invoke_with_this_at_depth(
                job.callback,
                Vec::[job.held],
                runtime::Value::Undefined,
                depth,
            );
            count += 1;
        }
        count
    }

    pub fn enqueue_host_job(self: Context, callback: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
        unit,
        VmError,
    ] {
        match callback {
            runtime::Value::Object(object) => if object.is_callable()
                && self.heap_value.contains(object) {
                self.host_jobs_value.push(HostJob::Callback { callback, arguments });
                Result::Ok(())
            } else {
                Result::Err(error(-1, VmErrorKind::TypeError("host job callback is not callable")))
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("host job callback is not callable"))),
        }
    }

    pub fn enqueue_host_task(self: Context, callback: HostTask, roots: Vec[runtime::Value]) -> unit {
        self.host_jobs_value.push(HostJob::Task { callback, roots })
    }

    pub fn set_microtask_queue(self: Context, drainer: MicrotaskDrainer, pending: MicrotaskPending) -> unit {
        self.microtask_drainer_value.set(Option::Some(drainer));
        self.microtask_pending_value.set(Option::Some(pending))
    }

    fn run_microtasks(self: Context) -> int {
        match self.microtask_drainer_value.get() {
            Some(drain) => drain(),
            None => 0,
        }
    }

    pub fn run_pending_jobs_at_depth(self: Context, depth: int) -> Result[int, VmError] {
        let mut count = self.run_finalization_jobs_at_depth(depth);
        count += self.run_microtasks();
        while !self.host_jobs_value.is_empty() && count < 16777216 {
            let job = self.host_jobs_value.remove(0);
            match job {
                HostJob::Callback { callback, arguments } => {
                    let _ = self.invoke_with_this_at_depth(
                        callback,
                        arguments,
                        runtime::Value::Undefined,
                        depth,
                    )?;
                },
                HostJob::Task { callback, .. } => callback(depth)?,
            };
            count += 1;
            count += self.run_finalization_jobs_at_depth(depth);
            count += self.run_microtasks();
        }
        Result::Ok(count)
    }

    pub fn run_pending_jobs(self: Context) -> Result[int, VmError] {
        self.run_pending_jobs_at_depth(0)
    }

    pub fn set_generator_prototype(self: Context, prototype: runtime::ObjectId) -> Result[
        unit,
        VmError,
    ] {
        if self.heap_value.contains(prototype) {
            self.generators_value.prototype.set(Option::Some(prototype));
            Result::Ok(())
        } else {
            Result::Err(error(-1, VmErrorKind::TypeError("invalid generator prototype")))
        }
    }

    pub fn set_async_generator_prototype(self: Context, prototype: runtime::ObjectId) -> Result[
        unit,
        VmError,
    ] {
        if self.heap_value.contains(prototype) {
            self.generators_value.async_generator_prototype.set(Option::Some(prototype));
            Result::Ok(())
        } else {
            Result::Err(error(-1, VmErrorKind::TypeError("invalid async generator prototype")))
        }
    }

    pub fn resume_generator_at_depth(
        self: Context,
        generator: runtime::Value,
        input: runtime::Value,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        generator_completion_result(
            self.heap_value,
            self.resume_generator_completion_at_depth(
                generator,
                input,
                GeneratorResumeKind::Next,
                depth,
            )?,
        )
    }

    pub fn resume_generator_raw_at_depth(
        self: Context,
        generator: runtime::Value,
        input: runtime::Value,
        depth: int,
    ) -> Result[GeneratorCompletion, VmError] {
        self.resume_generator_completion_at_depth(
            generator,
            input,
            GeneratorResumeKind::Next,
            depth,
        )
    }

    pub fn throw_generator_at_depth(
        self: Context,
        generator: runtime::Value,
        input: runtime::Value,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        generator_completion_result(
            self.heap_value,
            self.resume_generator_completion_at_depth(
                generator,
                input,
                GeneratorResumeKind::Throw,
                depth,
            )?,
        )
    }

    pub fn throw_generator_raw_at_depth(
        self: Context,
        generator: runtime::Value,
        input: runtime::Value,
        depth: int,
    ) -> Result[GeneratorCompletion, VmError] {
        self.resume_generator_completion_at_depth(
            generator,
            input,
            GeneratorResumeKind::Throw,
            depth,
        )
    }

    pub fn return_generator_at_depth(
        self: Context,
        generator: runtime::Value,
        input: runtime::Value,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        generator_completion_result(
            self.heap_value,
            self.resume_generator_completion_at_depth(
                generator,
                input,
                GeneratorResumeKind::Return,
                depth,
            )?,
        )
    }

    pub fn return_generator_raw_at_depth(
        self: Context,
        generator: runtime::Value,
        input: runtime::Value,
        depth: int,
    ) -> Result[GeneratorCompletion, VmError] {
        self.resume_generator_completion_at_depth(
            generator,
            input,
            GeneratorResumeKind::Return,
            depth,
        )
    }

    fn resume_generator_completion_at_depth(
        self: Context,
        generator: runtime::Value,
        input: runtime::Value,
        kind: GeneratorResumeKind,
        depth: int,
    ) -> Result[GeneratorCompletion, VmError] {
        let object = match generator {
            runtime::Value::Object(value) => value,
            _ => return Result::Err(
                error(-1, VmErrorKind::TypeError("generator method receiver is not an object")),
            ),
        };
        let frame = match self.generators_value.states.get(object) {
            Some(value) => value,
            None => return Result::Err(
                error(-1, VmErrorKind::TypeError("generator method receiver is incompatible")),
            ),
        };
        let start = match frame.status.get() {
            GeneratorStatus::Completed => match kind {
                GeneratorResumeKind::Next => {
                    return Result::Ok(GeneratorCompletion::Return(runtime::Value::Undefined))
                },
                GeneratorResumeKind::Throw => {
                    return Result::Err(error(-1, VmErrorKind::Thrown(input)))
                },
                GeneratorResumeKind::Return => {
                    return Result::Ok(GeneratorCompletion::Return(input))
                },
            },
            GeneratorStatus::Executing => return Result::Err(
                error(-1, VmErrorKind::TypeError("generator is already executing")),
            ),
            GeneratorStatus::SuspendedStart => match kind {
                GeneratorResumeKind::Next => 0,
                GeneratorResumeKind::Throw => {
                    frame.status.set(GeneratorStatus::Completed);
                    return Result::Err(error(-1, VmErrorKind::Thrown(input)))
                },
                GeneratorResumeKind::Return => {
                    frame.status.set(GeneratorStatus::Completed);
                    return Result::Ok(GeneratorCompletion::Return(input))
                },
            },
            GeneratorStatus::SuspendedYield | GeneratorStatus::SuspendedAwait => match kind {
                GeneratorResumeKind::Next => {
                    frame.stack.push(input);
                    frame.offset.get()
                },
                GeneratorResumeKind::Throw => {
                    let throw_offset = frame.offset.get() - 1;
                    let target = match frame.function.generator_throw_target(throw_offset) {
                        Some(value) => Option::Some(value),
                        None => handler_target(frame.function, throw_offset),
                    };
                    match target {
                        Some(target) => {
                            frame.stack.clear();
                            frame.stack.push(input);
                            target
                        },
                        None => {
                            frame.status.set(GeneratorStatus::Completed);
                            return Result::Err(error(throw_offset, VmErrorKind::Thrown(input)))
                        },
                    }
                },
                GeneratorResumeKind::Return => {
                    let return_offset = frame.offset.get() - 1;
                    match frame.function.generator_return_target(return_offset) {
                        Some(target) => {
                            frame.stack.clear();
                            frame.stack.push(input);
                            target
                        },
                        None => {
                            frame.status.set(GeneratorStatus::Completed);
                            return Result::Ok(GeneratorCompletion::Return(input))
                        },
                    }
                },
            },
        };
        frame.status.set(GeneratorStatus::Executing);
        self.active_frames_value.push(generator_active_frame(frame));
        let machine = Machine {
            function: frame.function,
            heap: self.heap_value,
            functions: self.functions_value,
            bound_functions: self.bound_functions_value,
            function_objects: self.function_objects_value,
            template_objects: self.template_objects_value,
            native_functions: self.native_functions_value,
            native_constructor_functions: self.native_constructor_functions_value,
            vm_functions: self.vm_functions_value,
            vm_constructor_functions: self.vm_constructor_functions_value,
            native_constructors: self.native_constructors_value,
            stack: frame.stack,
            locals: frame.locals,
            upvalues: frame.upvalues,
            global_object: self.global_object_value.get(),
            primitive_prototypes: self.primitive_prototypes_value,
            error_prototypes: self.error_prototypes_value,
            object_builtin_tags: self.object_builtin_tags_value,
            regexp_constructor: self.regexp_constructor_value.get(),
            iterator_symbol: self.iterator_symbol_value.get(),
            to_primitive_symbol: self.well_known_symbols_value.slot(
                WellKnownSymbolKind::ToPrimitive,
            ).get(),
            has_instance_symbol: self.well_known_symbols_value.slot(
                WellKnownSymbolKind::HasInstance,
            ).get(),
            callee: frame.callee,
            arguments: frame.arguments,
            arguments_object: frame.arguments_object,
            this_value: frame.this_value,
            home_object: frame.home_object,
            new_target: frame.new_target,
            instance_initializer: frame.instance_initializer,
            active_frames: self.active_frames_value,
            generators: self.generators_value,
            dynamic_eval_compiler: self.dynamic_eval_compiler_value,
            dynamic_module_loader: self.dynamic_module_loader_value,
            depth: depth + 1,
            eval_environment: frame.eval_environment,
        };
        let result = execute_machine_from(machine, start);
        let _ = self.active_frames_value.pop();
        match result {
            Ok(ExecutionResult::Yield(value, offset)) => {
                frame.offset.set(offset);
                frame.status.set(GeneratorStatus::SuspendedYield);
                Result::Ok(GeneratorCompletion::Yield(value))
            },
            Ok(ExecutionResult::Await(value, offset)) => {
                frame.offset.set(offset);
                frame.status.set(GeneratorStatus::SuspendedAwait);
                Result::Ok(GeneratorCompletion::Await(value))
            },
            Ok(ExecutionResult::Return(value)) => {
                frame.status.set(GeneratorStatus::Completed);
                Result::Ok(GeneratorCompletion::Return(value))
            },
            Err(value) => {
                frame.status.set(GeneratorStatus::Completed);
                Result::Err(value)
            },
        }
    }

    pub fn global_object(self: Context) -> Option[runtime::ObjectId] {
        self.global_object_value.get()
    }

    pub fn set_global_object(self: Context, object: runtime::ObjectId) -> Result[unit, VmError] {
        if self.heap_value.contains(object) {
            self.global_object_value.set(Option::Some(object));
            Result::Ok(())
        } else {
            Result::Err(
                error(-1, VmErrorKind::TypeError("global object does not belong to this heap")),
            )
        }
    }

    pub fn set_dynamic_function_compiler(
        self: Context,
        callback: (string, string) -> Result[bytecode::Function, string],
    ) -> unit {
        self.dynamic_function_compiler_value.set(Option::Some(callback))
    }

    pub fn compile_dynamic_function_source(
        self: Context,
        parameter_source: string,
        body_source: string,
    ) -> Result[bytecode::Function, VmError] {
        match self.dynamic_function_compiler_value.get() {
            Some(callback) => match callback(parameter_source, body_source) {
                Ok(value) => Result::Ok(value),
                Err(message) => Result::Err(error(-1, VmErrorKind::SyntaxError(message))),
            },
            None => Result::Err(
                error(-1, VmErrorKind::TypeError("dynamic Function compiler is not installed")),
            ),
        }
    }

    pub fn set_dynamic_eval_compiler(
        self: Context,
        callback: (string, Vec[bytecode::EvalBinding]) -> Result[
            bytecode::Function,
            bytecode::SourceError,
        ],
    ) -> unit {
        self.dynamic_eval_compiler_value.set(Option::Some(callback))
    }

    pub fn set_dynamic_module_loader(self: Context, callback: DynamicModuleLoader) -> unit {
        self.dynamic_module_loader_value.set(Option::Some(callback))
    }

    pub fn set_async_function_runner(self: Context, callback: AsyncFunctionRunner) -> unit {
        self.generators_value.async_function_runner.set(Option::Some(callback))
    }

    pub fn set_async_generator_runner(self: Context, callback: AsyncGeneratorRunner) -> unit {
        self.generators_value.async_generator_runner.set(Option::Some(callback))
    }

    pub fn link_async_function(self: Context, promise: runtime::Value, generator: runtime::Value) -> Result[
        unit,
        VmError,
    ] {
        let promise = match promise {
            runtime::Value::Object(value) => value,
            _ => return Result::Err(
                error(-1, VmErrorKind::TypeError("async function result is not an object")),
            ),
        };
        let generator = match generator {
            runtime::Value::Object(value) => value,
            _ => return Result::Err(
                error(-1, VmErrorKind::TypeError("async function frame is not an object")),
            ),
        };
        if self.heap_value.contains(promise)
            && self.generators_value.states.get(generator).is_some() {
            self.generators_value.async_roots[generator] = true;
            Result::Ok(())
        } else {
            Result::Err(error(-1, VmErrorKind::TypeError("cannot link async function frame")))
        }
    }

    pub fn release_async_function(self: Context, generator: runtime::Value) -> unit {
        match generator {
            runtime::Value::Object(value) => {
                let _ = self.generators_value.async_roots.remove(value);
            },
            _ => (),
        }
    }

    pub fn set_generator_request_roots(
        self: Context,
        generator: runtime::Value,
        roots: Vec[runtime::Value],
    ) -> unit {
        match generator {
            runtime::Value::Object(value) => match self.generators_value.states.get(value) {
                Some(frame) => frame.request_roots.set(roots),
                None => (),
            },
            _ => (),
        }
    }

    pub fn set_promise_capability_factory(self: Context, callback: HostPromiseCapabilityFactory) -> unit {
        self.promise_capability_factory_value.set(Option::Some(callback))
    }

    pub fn new_host_promise_capability(self: Context) -> Result[HostPromiseCapability, VmError] {
        match self.promise_capability_factory_value.get() {
            Some(callback) => callback(),
            None => Result::Err(
                error(-1, VmErrorKind::TypeError("Promise capability factory is not installed")),
            ),
        }
    }

    pub fn value_to_string_at_depth(self: Context, value: runtime::Value, depth: int) -> Result[
        runtime::JsString,
        VmError,
    ] {
        match self.to_primitive_string_at_depth(value, depth)? {
            runtime::Value::Undefined => Result::Ok(js_string("undefined")),
            runtime::Value::Null => Result::Ok(js_string("null")),
            runtime::Value::Bool(value) => Result::Ok(js_string(value.to_string())),
            runtime::Value::Int(value) => Result::Ok(js_string(value.to_string())),
            runtime::Value::Float(value) => {
                Result::Ok(js_string(dtoa::number_to_string(value)))
            },
            runtime::Value::String(value) => Result::Ok(value),
            runtime::Value::BigInt(value) => Result::Ok(js_string(value.to_string())),
            runtime::Value::Symbol(_) => Result::Err(
                error(-1, VmErrorKind::TypeError("cannot convert symbol to string")),
            ),
            runtime::Value::Object(_) => Result::Err(
                error(-1, VmErrorKind::TypeError("cannot convert object to primitive value")),
            ),
        }
    }

    pub fn rejection_value(self: Context, failure: VmError) -> runtime::Value {
        match failure.kind {
            VmErrorKind::Thrown(value) => value,
            VmErrorKind::TypeError(message) => materialize_error_value_with_runtime(
                self.heap_value,
                self.error_prototypes_value,
                self.object_builtin_tags_value,
                self.error_prototypes_value.type_error_value.get(),
                "TypeError",
                message,
                false,
            ),
            VmErrorKind::RangeError(message) => materialize_error_value_with_runtime(
                self.heap_value,
                self.error_prototypes_value,
                self.object_builtin_tags_value,
                self.error_prototypes_value.range_error_value.get(),
                "RangeError",
                message,
                false,
            ),
            VmErrorKind::ReferenceError(message) => materialize_error_value_with_runtime(
                self.heap_value,
                self.error_prototypes_value,
                self.object_builtin_tags_value,
                self.error_prototypes_value.reference_error_value.get(),
                "ReferenceError",
                message,
                false,
            ),
            VmErrorKind::SyntaxError(message) | VmErrorKind::SyntaxErrorAt(message, _) => {
                materialize_error_value_with_runtime(
                    self.heap_value,
                    self.error_prototypes_value,
                    self.object_builtin_tags_value,
                    self.error_prototypes_value.syntax_error_value.get(),
                    "SyntaxError",
                    message,
                    false,
                )
            },
            VmErrorKind::UriError(message) => materialize_error_value_with_runtime(
                self.heap_value,
                self.error_prototypes_value,
                self.object_builtin_tags_value,
                self.error_prototypes_value.uri_error_value.get(),
                "URIError",
                message,
                false,
            ),
            VmErrorKind::CallDepthExceeded => materialize_error_value_with_runtime(
                self.heap_value,
                self.error_prototypes_value,
                self.object_builtin_tags_value,
                self.error_prototypes_value.internal_error_value.get(),
                "InternalError",
                "call depth exceeded",
                false,
            ),
            value => fallback_error_value("RuntimeError", value.debug()),
        }
    }

    pub fn compile_dynamic_eval_source(
        self: Context,
        source: string,
        bindings: Vec[bytecode::EvalBinding],
    ) -> Result[bytecode::Function, VmError] {
        match self.dynamic_eval_compiler_value.get() {
            Some(callback) => match callback(source, bindings) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(
                    error(-1, VmErrorKind::SyntaxErrorAt(value.message, value.location)),
                ),
            },
            None => Result::Err(
                error(-1, VmErrorKind::TypeError("dynamic eval compiler is not installed")),
            ),
        }
    }

    pub fn set_primitive_prototype(self: Context, kind: PrimitiveKind, object: runtime::ObjectId) -> Result[
        unit,
        VmError,
    ] {
        let runtime_kind = match kind {
            PrimitiveKind::Boolean => runtime::PrimitivePrototypeKind::Boolean,
            PrimitiveKind::Number => runtime::PrimitivePrototypeKind::Number,
            PrimitiveKind::String => runtime::PrimitivePrototypeKind::String,
            PrimitiveKind::BigInt => runtime::PrimitivePrototypeKind::BigInt,
            PrimitiveKind::Symbol => runtime::PrimitivePrototypeKind::Symbol,
        };
        if self.heap_value.set_primitive_prototype(runtime_kind, object) {
            self.primitive_prototypes_value.slot(kind).set(Option::Some(object));
            Result::Ok(())
        } else {
            Result::Err(
                error(
                    -1,
                    VmErrorKind::TypeError("primitive prototype does not belong to this heap"),
                ),
            )
        }
    }

    pub fn set_error_prototype(self: Context, kind: ErrorPrototypeKind, object: runtime::ObjectId) -> Result[
        unit,
        VmError,
    ] {
        if self.heap_value.contains(object) {
            self.error_prototypes_value.slot(kind).set(Option::Some(object));
            Result::Ok(())
        } else {
            Result::Err(
                error(-1, VmErrorKind::TypeError("error prototype does not belong to this heap")),
            )
        }
    }

    pub fn set_iterator_symbol(self: Context, symbol: runtime::Symbol) -> unit {
        self.iterator_symbol_value.set(Option::Some(symbol))
    }

    pub fn set_well_known_symbol(self: Context, kind: WellKnownSymbolKind, symbol: runtime::Symbol) -> unit {
        self.well_known_symbols_value.slot(kind).set(Option::Some(symbol));
        match kind {
            WellKnownSymbolKind::AsyncIterator => {
                self.generators_value.async_iterator_symbol.set(Option::Some(symbol));
            },
            _ => (),
        }
    }

    pub fn well_known_symbol(self: Context, kind: WellKnownSymbolKind) -> Option[runtime::Symbol] {
        self.well_known_symbols_value.slot(kind).get()
    }

    pub fn set_object_builtin_tag(self: Context, object: runtime::ObjectId, tag: runtime::JsString) -> bool {
        if self.heap_value.contains(object) {
            self.object_builtin_tags_value[object] = tag;
            true
        } else {
            false
        }
    }

    pub fn object_builtin_tag(self: Context, object: runtime::ObjectId) -> Option[runtime::JsString] {
        self.object_builtin_tags_value.get(object)
    }

    pub fn set_regexp_constructor(self: Context, value: runtime::Value) -> Result[unit, VmError] {
        match value {
            runtime::Value::Object(object) => if object.is_callable()
                && self.heap_value.contains(object) {
                self.regexp_constructor_value.set(Option::Some(value));
                Result::Ok(())
            } else {
                Result::Err(error(-1, VmErrorKind::TypeError("invalid RegExp constructor")))
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("invalid RegExp constructor"))),
        }
    }

    pub fn iterator_symbol(self: Context) -> Option[runtime::Symbol] {
        self.iterator_symbol_value.get()
    }

    pub fn new_native_function(
        self: Context,
        callback: (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
            runtime::Value,
            NativeError,
        ],
    ) -> Result[runtime::Value, VmError] {
        match runtime::new_object(
            self.heap_value,
            runtime::ObjectKind::Function,
            match self.heap_value.function_prototype() {
                Some(value) => Option::Some(value),
                None => self.heap_value.object_prototype(),
            },
        ) {
            Ok(object) => {
                self.native_functions_value[object] = callback;
                Result::Ok(runtime::Value::Object(object))
            },
            Err(value) => Result::Err(error(-1, VmErrorKind::TypeError(value.message))),
        }
    }

    pub fn new_vm_function(
        self: Context,
        callback: (runtime::Value, Vec[runtime::Value], int) -> Result[runtime::Value, VmError],
    ) -> Result[runtime::Value, VmError] {
        match runtime::new_object(
            self.heap_value,
            runtime::ObjectKind::Function,
            match self.heap_value.function_prototype() {
                Some(value) => Option::Some(value),
                None => self.heap_value.object_prototype(),
            },
        ) {
            Ok(object) => {
                self.vm_functions_value[object] = callback;
                Result::Ok(runtime::Value::Object(object))
            },
            Err(value) => Result::Err(error(-1, VmErrorKind::TypeError(value.message))),
        }
    }

    pub fn new_bound_function(
        self: Context,
        target: runtime::Value,
        this_value: runtime::Value,
        arguments: Vec[runtime::Value],
    ) -> Result[runtime::Value, VmError] {
        match target {
            runtime::Value::Object(object) => if object.is_callable()
                && self.heap_value.contains(object) {
                match runtime::new_object(
                    self.heap_value,
                    runtime::ObjectKind::Function,
                    match self.heap_value.function_prototype() {
                        Some(value) => Option::Some(value),
                        None => self.heap_value.object_prototype(),
                    },
                ) {
                    Ok(bound) => {
                        self.bound_functions_value[bound] = BoundFunction {
                            target,
                            this_value,
                            arguments,
                        };
                        Result::Ok(runtime::Value::Object(bound))
                    },
                    Err(value) => {
                        Result::Err(error(-1, VmErrorKind::TypeError(value.message)))
                    },
                }
            } else {
                Result::Err(error(-1, VmErrorKind::TypeError("value is not callable")))
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("value is not callable"))),
        }
    }

    pub fn mark_native_constructor(self: Context, value: runtime::Value) -> Result[unit, VmError] {
        match value {
            runtime::Value::Object(object) => if self.native_functions_value.get(object).is_some()
                || self.vm_functions_value.get(object).is_some() {
                self.native_constructors_value.insert(object);
                Result::Ok(())
            } else {
                Result::Err(error(-1, VmErrorKind::TypeError("value is not a host function")))
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("value is not callable"))),
        }
    }

    pub fn set_native_constructor_callback(
        self: Context,
        value: runtime::Value,
        callback: (runtime::Heap, runtime::ObjectId, Vec[runtime::Value]) -> Result[
            runtime::Value,
            NativeError,
        ],
    ) -> Result[unit, VmError] {
        match value {
            runtime::Value::Object(object) => if self.native_functions_value.get(object).is_some() {
                self.native_constructor_functions_value[object] = callback;
                self.native_constructors_value.insert(object);
                Result::Ok(())
            } else {
                Result::Err(error(-1, VmErrorKind::TypeError("value is not a native function")))
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("value is not callable"))),
        }
    }

    pub fn set_vm_constructor_callback(
        self: Context,
        value: runtime::Value,
        callback: (
            runtime::ObjectId,
            Vec[runtime::Value],
            Option[runtime::ObjectId],
            runtime::Value,
            int,
        ) -> Result[runtime::Value, VmError],
    ) -> Result[unit, VmError] {
        match value {
            runtime::Value::Object(object) => if self.vm_functions_value.get(object).is_some() {
                self.vm_constructor_functions_value[object] = VmConstructorCallbacks {
                    callback: Option::Some(callback),
                    prepare: Option::None,
                    self_allocating: Option::None,
                };
                self.native_constructors_value.insert(object);
                Result::Ok(())
            } else {
                Result::Err(error(-1, VmErrorKind::TypeError("value is not a VM function")))
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("value is not callable"))),
        }
    }

    pub fn set_vm_constructor_prepare_callback(
        self: Context,
        value: runtime::Value,
        prepare: (Vec[runtime::Value], int) -> Result[Vec[runtime::Value], VmError],
    ) -> Result[unit, VmError] {
        match value {
            runtime::Value::Object(object) => match self.vm_constructor_functions_value.get(object) {
                Some(callbacks) => {
                    self.vm_constructor_functions_value[object] = VmConstructorCallbacks {
                        callback: callbacks.callback,
                        prepare: Option::Some(prepare),
                        self_allocating: callbacks.self_allocating,
                    };
                    Result::Ok(())
                },
                None => Result::Err(
                    error(-1, VmErrorKind::TypeError("value has no VM constructor callback")),
                ),
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("value is not callable"))),
        }
    }

    pub fn set_vm_self_allocating_constructor_callback(
        self: Context,
        value: runtime::Value,
        callback: (Vec[runtime::Value], int) -> Result[runtime::Value, VmError],
    ) -> Result[unit, VmError] {
        match value {
            runtime::Value::Object(object) => if self.vm_functions_value.get(object).is_some() {
                self.vm_constructor_functions_value[object] = VmConstructorCallbacks {
                    callback: Option::None,
                    prepare: Option::None,
                    self_allocating: Option::Some(callback),
                };
                self.native_constructors_value.insert(object);
                Result::Ok(())
            } else {
                Result::Err(error(-1, VmErrorKind::TypeError("value is not a VM function")))
            },
            _ => Result::Err(error(-1, VmErrorKind::TypeError("value is not callable"))),
        }
    }
}

pub fn max_call_depth() -> int {
    MAX_CALL_DEPTH
}

fn error(offset: int, kind: VmErrorKind) -> VmError {
    VmError { offset, kind }
}

fn fallback_error_value(name: string, message: string) -> runtime::Value {
    runtime::Value::String(js_string(name + ": " + message))
}

fn materialize_error_value_with_runtime(
    heap: runtime::Heap,
    error_prototypes: ErrorPrototypes,
    object_builtin_tags: HashMap[runtime::ObjectId, runtime::JsString],
    prototype: Option[runtime::ObjectId],
    name: string,
    message: string,
    own_name: bool,
) -> runtime::Value {
    let prototype = match prototype {
        Some(value) => Option::Some(value),
        None => error_prototypes.error_value.get(),
    };
    let prototype = match prototype {
        Some(value) => value,
        None => return fallback_error_value(name, message),
    };
    let object = match runtime::new_ordinary_object(heap, Option::Some(prototype)) {
        Ok(value) => value,
        Err(_) => return fallback_error_value(name, message),
    };
    object_builtin_tags[object] = js_string("Error");
    if own_name
        && !runtime::define_own_property(
            heap,
            object,
            runtime::string_property_key("name"),
            runtime::data_descriptor(runtime::Value::String(js_string(name)), true, false, true),
        ) {
        return fallback_error_value(name, message)
    } else {};
    if !runtime::define_own_property(
        heap,
        object,
        runtime::string_property_key("message"),
        runtime::data_descriptor(runtime::Value::String(js_string(message)), true, false, true),
    ) {
        fallback_error_value(name, message)
    } else {
        runtime::Value::Object(object)
    }
}

fn materialize_error_value(
    machine: Machine,
    prototype: Option[runtime::ObjectId],
    name: string,
    message: string,
    own_name: bool,
) -> runtime::Value {
    materialize_error_value_with_runtime(
        machine.heap,
        machine.error_prototypes,
        machine.object_builtin_tags,
        prototype,
        name,
        message,
        own_name,
    )
}

fn stack_line(function: bytecode::Function, offset: int) -> string {
    let source_name = match function.source_name() {
        Some(value) => value.to_host_string().unwrap_or("<input>"),
        None => "<input>",
    };
    match function.source_location(offset) {
        Some(location) => {
            "    at " + source_name + ":" + location.line.to_string() + ":"
                + location.column.to_string()
        },
        None => "    at " + source_name + ":1:1",
    }
}

fn error_stack(machine: Machine, offset: int) -> runtime::JsString {
    let mut result = "";
    let mut index = machine.active_frames.len();
    while index > 0 {
        index -= 1;
        let frame = machine.active_frames[index];
        let frame_offset = if index + 1 == machine.active_frames.len() {
            offset
        } else {
            frame.offset.get()
        };
        if result != "" {
            result += "\n";
        } else {};
        result += stack_line(frame.function, frame_offset);
    }
    js_string(result)
}

fn ensure_error_stack(machine: Machine, value: runtime::Value, offset: int) -> runtime::Value {
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return value,
    };
    match machine.object_builtin_tags.get(object) {
        Some(tag) => if tag != js_string("Error") {
            return value
        } else {},
        None => return value,
    };
    match machine.heap.get(object) {
        Some(target) => if target.own_property(runtime::string_property_key("stack")).is_some() {
            return value
        } else {},
        None => return value,
    };
    let _ = runtime::define_own_property(
        machine.heap,
        object,
        runtime::string_property_key("stack"),
        runtime::data_descriptor(
            runtime::Value::String(error_stack(machine, offset)),
            true,
            false,
            true,
        ),
    );
    value
}

fn error_value(machine: Machine, kind: VmErrorKind) -> runtime::Value {
    match kind {
        VmErrorKind::Thrown(value) => value,
        VmErrorKind::TypeError(message) => materialize_error_value(
            machine,
            machine.error_prototypes.type_error_value.get(),
            "TypeError",
            message,
            false,
        ),
        VmErrorKind::RangeError(message) => materialize_error_value(
            machine,
            machine.error_prototypes.range_error_value.get(),
            "RangeError",
            message,
            false,
        ),
        VmErrorKind::ReferenceError(message) => materialize_error_value(
            machine,
            machine.error_prototypes.reference_error_value.get(),
            "ReferenceError",
            message,
            false,
        ),
        VmErrorKind::SyntaxError(message) => materialize_error_value(
            machine,
            machine.error_prototypes.syntax_error_value.get(),
            "SyntaxError",
            message,
            false,
        ),
        VmErrorKind::SyntaxErrorAt(message, location) => {
            let value = materialize_error_value(
                machine,
                machine.error_prototypes.syntax_error_value.get(),
                "SyntaxError",
                message,
                false,
            );
            let object = match value {
                runtime::Value::Object(value) => value,
                _ => return value,
            };
            let _ = runtime::define_own_property(
                machine.heap,
                object,
                runtime::string_property_key("stack"),
                runtime::data_descriptor(
                    runtime::Value::String(
                        js_string(
                            "    at <input>:" + location.line.to_string() + ":"
                                + location.column.to_string(),
                        ),
                    ),
                    true,
                    false,
                    true,
                ),
            );
            value
        },
        VmErrorKind::UriError(message) => materialize_error_value(
            machine,
            machine.error_prototypes.uri_error_value.get(),
            "URIError",
            message,
            false,
        ),
        VmErrorKind::CallDepthExceeded => materialize_error_value(
            machine,
            machine.error_prototypes.internal_error_value.get(),
            "InternalError",
            "call depth exceeded",
            true,
        ),
        value => fallback_error_value("RuntimeError", value.debug()),
    }
}

fn error_value_at(machine: Machine, kind: VmErrorKind, offset: int) -> runtime::Value {
    ensure_error_stack(machine, error_value(machine, kind), offset)
}

fn catchable(kind: VmErrorKind) -> bool {
    match kind {
        VmErrorKind::Thrown(_) | VmErrorKind::TypeError(_) | VmErrorKind::RangeError(_) | VmErrorKind::ReferenceError(_) | VmErrorKind::SyntaxError(_) | VmErrorKind::SyntaxErrorAt(_, _) | VmErrorKind::UriError(_) | VmErrorKind::CallDepthExceeded => true,
        _ => false,
    }
}

fn native_error_kind(message: string) -> VmErrorKind {
    if text::starts_with_at(message, 0, "RangeError: ") {
        VmErrorKind::RangeError(message.byte_slice(12, message.byte_len()))
    } else if text::starts_with_at(message, 0, "ReferenceError: ") {
        VmErrorKind::ReferenceError(message.byte_slice(16, message.byte_len()))
    } else if text::starts_with_at(message, 0, "SyntaxError: ") {
        VmErrorKind::SyntaxError(message.byte_slice(13, message.byte_len()))
    } else if text::starts_with_at(message, 0, "URIError: ") {
        VmErrorKind::UriError(message.byte_slice(10, message.byte_len()))
    } else if text::starts_with_at(message, 0, "TypeError: ") {
        VmErrorKind::TypeError(message.byte_slice(11, message.byte_len()))
    } else {
        VmErrorKind::TypeError(message)
    }
}

fn handler_target(function: bytecode::Function, offset: int) -> Option[int] {
    let handlers = function.exception_handlers();
    let mut selected: Option[bytecode::ExceptionHandler] = Option::None;
    for handler in handlers {
        if offset >= handler.start && offset < handler.end {
            selected = match selected {
                Some(previous) => if handler.start > previous.start
                    || (handler.start == previous.start && handler.end < previous.end) {
                    Option::Some(handler)
                } else {
                    Option::Some(previous)
                },
                None => Option::Some(handler),
            };
        } else {}
    }
    match selected {
        Some(handler) => Option::Some(handler.target),
        None => Option::None,
    }
}

fn pop(machine: Machine, offset: int) -> Result[runtime::Value, VmError] {
    match machine.stack.pop() {
        Some(value) => Result::Ok(value),
        None => Result::Err(error(offset, VmErrorKind::StackUnderflow)),
    }
}

enum PrimitiveHint {
    Default,
    Number,
    String,
}

fn primitive_hint_name(hint: PrimitiveHint) -> runtime::Value {
    runtime::Value::String(
        js_string(
            match hint {
                PrimitiveHint::Default => "default",
                PrimitiveHint::Number => "number",
                PrimitiveHint::String => "string",
            },
        ),
    )
}

fn primitive_result(value: runtime::Value) -> Option[runtime::Value] {
    match value {
        runtime::Value::Object(_) => Option::None,
        _ => Option::Some(value),
    }
}

fn ordinary_to_primitive(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    hint: PrimitiveHint,
) -> Result[runtime::Value, VmError] {
    let receiver = runtime::Value::Object(object);
    let names = match hint {
        PrimitiveHint::String => Vec::["toString", "valueOf"],
        PrimitiveHint::Default | PrimitiveHint::Number => Vec::["valueOf", "toString"],
    };
    for name in names {
        let method = read_property(machine, offset, receiver, runtime::string_property_key(name))?;
        match method {
            runtime::Value::Object(callable) => if callable.is_callable() {
                let result = call_value(machine, offset, method, Vec::[], receiver)?;
                match primitive_result(result) {
                    Some(value) => return Result::Ok(value),
                    None => (),
                }
            } else {},
            _ => (),
        }
    }
    Result::Err(error(offset, VmErrorKind::TypeError("cannot convert object to primitive value")))
}

fn to_primitive(machine: Machine, offset: int, value: runtime::Value, hint: PrimitiveHint) -> Result[
    runtime::Value,
    VmError,
] {
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return Result::Ok(value),
    };
    match machine.to_primitive_symbol {
        Some(symbol) => {
            let method = read_property(machine, offset, value, runtime::PropertyKey::Symbol(symbol))?;
            match method {
                runtime::Value::Undefined | runtime::Value::Null => (),
                runtime::Value::Object(callable) => if callable.is_callable() {
                    let result = call_value(
                        machine,
                        offset,
                        method,
                        Vec::[primitive_hint_name(hint)],
                        value,
                    )?;
                    return match primitive_result(result) {
                        Some(value) => Result::Ok(value),
                        None => Result::Err(
                            error(
                                offset,
                                VmErrorKind::TypeError(
                                    "Symbol.toPrimitive must return a primitive value",
                                ),
                            ),
                        ),
                    }
                } else {
                    return Result::Err(
                        error(offset, VmErrorKind::TypeError("Symbol.toPrimitive is not callable")),
                    )
                },
                _ => return Result::Err(
                    error(offset, VmErrorKind::TypeError("Symbol.toPrimitive is not callable")),
                ),
            }
        },
        None => (),
    };
    ordinary_to_primitive(machine, offset, object, hint)
}

fn number(machine: Machine, offset: int, value: runtime::Value) -> Result[float64, VmError] {
    match runtime::primitive_to_number(to_primitive(machine, offset, value, PrimitiveHint::Number)?) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    }
}

fn bigint_value(machine: Machine, offset: int, value: runtime::Value) -> Result[
    runtime::BigInt,
    VmError,
] {
    let primitive = to_primitive(machine, offset, value, PrimitiveHint::Number)?;
    match primitive {
        runtime::Value::String(value) => match runtime::string_to_bigint(value) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(error(offset, VmErrorKind::SyntaxError(value.message))),
        },
        _ => match runtime::primitive_to_bigint(primitive) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
        },
    }
}

fn js_string(value: string) -> runtime::JsString {
    let bytes = value.to_bytes();
    runtime::JsString::from_utf8(bytes.slice(0, bytes.len()))
}

fn host_string(value: runtime::JsString) -> string {
    let bytes = value.to_utf8();
    let builder = text::StringBuilder::with_capacity(bytes.len());
    for value in bytes {
        builder.values.push(value)
    }
    builder.finish()
}

fn is_string(value: runtime::Value) -> bool {
    match value {
        runtime::Value::String(_) => true,
        _ => false,
    }
}

fn primitive_to_string(machine: Machine, offset: int, value: runtime::Value) -> Result[
    runtime::JsString,
    VmError,
] {
    match to_primitive(machine, offset, value, PrimitiveHint::String)? {
        runtime::Value::Undefined => Result::Ok(js_string("undefined")),
        runtime::Value::Null => Result::Ok(js_string("null")),
        runtime::Value::Bool(value) => Result::Ok(js_string(value.to_string())),
        runtime::Value::Int(value) => Result::Ok(js_string(value.to_string())),
        runtime::Value::Float(value) => Result::Ok(js_string(dtoa::number_to_string(value))),
        runtime::Value::String(value) => Result::Ok(value),
        runtime::Value::BigInt(value) => Result::Ok(js_string(value.to_string())),
        runtime::Value::Symbol(_) => Result::Err(
            error(offset, VmErrorKind::TypeError("cannot convert symbol to string")),
        ),
        runtime::Value::Object(_) => Result::Err(
            error(offset, VmErrorKind::TypeError("cannot convert object to primitive value")),
        ),
    }
}

fn template_array(machine: Machine, offset: int, values: Vec[Option[runtime::JsString]]) -> Result[
    runtime::ObjectId,
    VmError,
] {
    let object = match runtime::new_array(machine.heap, values.len()) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    let mut index = 0;
    while index < values.len() {
        if !runtime::define_own_property(
            machine.heap,
            object,
            runtime::string_property_key(index.to_string()),
            runtime::data_descriptor(
                match values[index] {
                    Some(value) => runtime::Value::String(value),
                    None => runtime::Value::Undefined,
                },
                false,
                true,
                false,
            ),
        ) {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("cannot define template element")),
            )
        } else {};
        index += 1;
    }
    Result::Ok(object)
}

fn materialize_template(machine: Machine, offset: int, template: Ref[bytecode::TemplateConstant]) -> Result[
    runtime::Value,
    VmError,
] {
    let identity = ptr_hash(template);
    match machine.template_objects.get(identity) {
        Some(object) => if machine.heap.contains(object) {
            return Result::Ok(runtime::Value::Object(object))
        } else {
            let _ = machine.template_objects.remove(identity);
        },
        None => (),
    };
    let raw_values: Vec[Option[runtime::JsString]] = Vec::[];
    for value in template.get().raw() {
        raw_values.push(Option::Some(value))
    }
    let raw = template_array(machine, offset, raw_values)?;
    if !runtime::seal_object(machine.heap, raw, true) {
        return Result::Err(error(offset, VmErrorKind::TypeError("cannot freeze template raw")))
    } else {};
    let cooked = template_array(machine, offset, template.get().cooked())?;
    if !runtime::define_own_property(
        machine.heap,
        cooked,
        runtime::string_property_key("raw"),
        runtime::data_descriptor(runtime::Value::Object(raw), false, false, false),
    )
        || !runtime::seal_object(machine.heap, cooked, true) {
        return Result::Err(error(offset, VmErrorKind::TypeError("cannot freeze template object")))
    } else {};
    machine.template_objects[identity] = cooked;
    Result::Ok(runtime::Value::Object(cooked))
}

fn constant_value(machine: Machine, offset: int, index: int) -> Result[runtime::Value, VmError] {
    match machine.function.constant(index) {
        Some(bytecode::Constant::Float(value)) => Result::Ok(runtime::Value::Float(value)),
        Some(bytecode::Constant::String(value)) => Result::Ok(runtime::Value::String(value)),
        Some(bytecode::Constant::BigInt(value)) => Result::Ok(runtime::Value::BigInt(value)),
        Some(bytecode::Constant::Function(function)) => {
            if function.get().upvalue_count() == 0 && function.get().constructable()
                && !function.get().class_constructor() {
                let identity = ptr_hash(function);
                match machine.function_objects.get(identity) {
                    Some(object) => if machine.heap.contains(object) {
                        Result::Ok(runtime::Value::Object(object))
                    } else {
                        let _ = machine.function_objects.remove(identity);
                        materialize_function(machine, offset, Option::Some(identity), function)
                    },
                    None => materialize_function(machine, offset, Option::Some(identity), function),
                }
            } else {
                materialize_function(machine, offset, Option::None, function)
            }
        },
        Some(bytecode::Constant::Template(template)) => {
            materialize_template(machine, offset, template)
        },
        None => Result::Err(error(offset, VmErrorKind::InvalidConstant(index))),
    }
}

fn arguments_length_value(length: int) -> runtime::Value {
    if length <= 2147483647 {
        runtime::Value::Int(length.to_int32())
    } else {
        runtime::Value::Float(num::parse_float64(length.to_string()).unwrap_or(0.0))
    }
}

fn throw_restricted_arguments_property(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, NativeError] {
    let _ = heap;
    let _ = this_value;
    let _ = arguments;
    Result::Err(NativeError { message: "TypeError: restricted arguments property" })
}

fn arguments_thrower(machine: Machine, offset: int) -> Result[runtime::Value, VmError] {
    let object = match runtime::new_object(
        machine.heap,
        runtime::ObjectKind::Function,
        match machine.heap.function_prototype() {
            Some(value) => Option::Some(value),
            None => machine.heap.object_prototype(),
        },
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    machine.native_functions[object] = throw_restricted_arguments_property;
    if !runtime::define_own_property(
        machine.heap,
        object,
        runtime::string_property_key("length"),
        runtime::data_descriptor(runtime::Value::Int(0), false, false, true),
    )
        || !runtime::define_own_property(
            machine.heap,
            object,
            runtime::string_property_key("name"),
            runtime::data_descriptor(runtime::Value::String(js_string("")), false, false, true),
        )
        || !runtime::prevent_extensions(machine.heap, object) {
        return Result::Err(error(offset, VmErrorKind::TypeError("cannot create arguments thrower")))
    } else {};
    Result::Ok(runtime::Value::Object(object))
}

fn materialize_arguments(machine: Machine, offset: int) -> Result[runtime::Value, VmError] {
    match machine.arguments_object.get() {
        Some(value) => if machine.heap.contains(value) {
            return Result::Ok(runtime::Value::Object(value))
        } else {
            machine.arguments_object.set(Option::None)
        },
        None => (),
    };
    let object = match runtime::new_ordinary_object(machine.heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    machine.object_builtin_tags[object] = js_string("Arguments");
    if !runtime::define_own_property(
        machine.heap,
        object,
        runtime::string_property_key("length"),
        runtime::data_descriptor(arguments_length_value(machine.arguments.len()), true, false, true),
    ) {
        return Result::Err(error(offset, VmErrorKind::TypeError("cannot define arguments length")))
    } else {};
    let mut index = 0;
    while index < machine.arguments.len() {
        if !runtime::define_own_property(
            machine.heap,
            object,
            runtime::string_property_key(index.to_string()),
            runtime::data_descriptor(machine.arguments[index], true, true, true),
        ) {
            return Result::Err(error(offset, VmErrorKind::TypeError("cannot define argument")))
        } else {};
        match machine.function.argument_local(index) {
            Some(local) => if local >= 0 && local < machine.locals.len() {
                if !runtime::map_argument_index(
                    machine.heap,
                    object,
                    index.to_uint32(),
                    machine.locals[local],
                ) {
                    return Result::Err(error(offset, VmErrorKind::TypeError("cannot map argument")))
                } else {}
            } else {
                return Result::Err(error(offset, VmErrorKind::InvalidLocal(local)))
            },
            None => (),
        };
        index += 1;
    }
    let callee_key = runtime::string_property_key("callee");
    let callee_defined = if machine.function.strict() {
        let thrower = arguments_thrower(machine, offset)?;
        runtime::define_own_property(
            machine.heap,
            object,
            callee_key,
            runtime::accessor_descriptor(Option::Some(thrower), Option::Some(thrower), false, false),
        )
    } else {
        runtime::define_own_property(
            machine.heap,
            object,
            callee_key,
            runtime::data_descriptor(
                machine.callee.unwrap_or(runtime::Value::Undefined),
                true,
                false,
                true,
            ),
        )
    };
    if !callee_defined {
        return Result::Err(error(offset, VmErrorKind::TypeError("cannot define arguments callee")))
    } else {};
    match (machine.iterator_symbol, machine.heap.array_prototype()) {
        (Some(symbol), Some(prototype)) => match runtime::get_property(
            machine.heap,
            prototype,
            runtime::PropertyKey::Symbol(symbol),
        ) {
            Ok(Some(value)) => if !runtime::define_own_property(
                machine.heap,
                object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::data_descriptor(value, true, false, true),
            ) {
                return Result::Err(
                    error(offset, VmErrorKind::TypeError("cannot define arguments iterator")),
                )
            } else {},
            Ok(None) => (),
            Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
        },
        _ => (),
    };
    machine.arguments_object.set(Option::Some(object));
    Result::Ok(runtime::Value::Object(object))
}

pub fn is_constructor(self: Context, value: runtime::Value) -> bool {
    let mut current = value;
    let mut object = match current {
        runtime::Value::Object(value) => value,
        _ => return false,
    };
    loop {
        match self.bound_functions_value.get(object) {
            Some(value) => {
                current = value.target;
                object = match current {
                    runtime::Value::Object(value) => value,
                    _ => return false,
                };
            },
            None => break,
        }
    }
    match self.functions_value.get(object) {
        Some(value) => value.function.get().constructable(),
        None => self.native_constructors_value.contains(object),
    }
}

pub fn function_source(self: Context, value: runtime::Value) -> Option[runtime::JsString] {
    match value {
        runtime::Value::Object(object) => match self.functions_value.get(object) {
            Some(closure) => closure.function.get().source_text(),
            None => Option::None,
        },
        _ => Option::None,
    }
}

pub fn function_source_name(self: Context, value: runtime::Value) -> Option[runtime::JsString] {
    match value {
        runtime::Value::Object(object) => match self.functions_value.get(object) {
            Some(closure) => closure.function.get().source_name(),
            None => Option::None,
        },
        _ => Option::None,
    }
}

pub fn function_definition_location(self: Context, value: runtime::Value) -> Option[
    bytecode::SourceLocation,
] {
    match value {
        runtime::Value::Object(object) => match self.functions_value.get(object) {
            Some(closure) => closure.function.get().definition_location(),
            None => Option::None,
        },
        _ => Option::None,
    }
}

fn materialize_rest_arguments(machine: Machine, offset: int, start: int) -> Result[
    runtime::Value,
    VmError,
] {
    let length = if start < machine.arguments.len() {
        machine.arguments.len() - start
    } else {
        0
    };
    let object = match runtime::new_array(machine.heap, length) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    let mut index = 0;
    while index < length {
        if !runtime::define_own_property(
            machine.heap,
            object,
            runtime::string_property_key(index.to_string()),
            runtime::data_descriptor(machine.arguments[start + index], true, true, true),
        ) {
            return Result::Err(error(offset, VmErrorKind::TypeError("cannot define rest argument")))
        } else {};
        index += 1;
    }
    Result::Ok(runtime::Value::Object(object))
}

fn materialize_function(
    machine: Machine,
    offset: int,
    identity: Option[uint64],
    function: Ref[bytecode::Function],
) -> Result[runtime::Value, VmError] {
    match runtime::new_object(
        machine.heap,
        runtime::ObjectKind::Function,
        match machine.heap.function_prototype() {
            Some(value) => Option::Some(value),
            None => machine.heap.object_prototype(),
        },
    ) {
        Ok(object) => {
            let upvalues: Vec[UpvalueCell] = Vec::[];
            let mut index = 0;
            while index < function.get().upvalue_count() {
                let cell = match function.get().upvalue_source(index) {
                    Some(bytecode::UpvalueSource::Local(local)) => {
                        if local < 0 || local >= machine.locals.len() {
                            return Result::Err(error(offset, VmErrorKind::InvalidLocal(local)))
                        } else {
                            UpvalueCell::Value(machine.locals[local])
                        }
                    },
                    Some(bytecode::UpvalueSource::Upvalue(upvalue)) => {
                        if upvalue < 0 || upvalue >= machine.upvalues.len() {
                            return Result::Err(error(offset, VmErrorKind::InvalidUpvalue(upvalue)))
                        } else {
                            machine.upvalues[upvalue]
                        }
                    },
                    Some(bytecode::UpvalueSource::Closure) => {
                        UpvalueCell::Value(Ref::new(runtime::Value::Object(object)))
                    },
                    Some(bytecode::UpvalueSource::This) => UpvalueCell::This(machine.this_value),
                    Some(bytecode::UpvalueSource::Arguments) => {
                        UpvalueCell::Value(Ref::new(materialize_arguments(machine, offset)?))
                    },
                    None => return Result::Err(error(offset, VmErrorKind::InvalidUpvalue(index))),
                };
                upvalues.push(cell);
                index += 1;
            }
            machine.functions[object] = Closure {
                function,
                upvalues,
                home_object: Ref::new(
                    if function.get().inherit_home_object() {
                        machine.home_object
                    } else {
                        Option::None
                    },
                ),
                new_target: if function.get().lexical_this() {
                    machine.new_target
                } else {
                    Option::None
                },
                instance_initializer: Ref::new(Option::None),
                eval_environment: machine.eval_environment.get(),
            };
            if !runtime::define_own_property(
                machine.heap,
                object,
                runtime::string_property_key("length"),
                runtime::data_descriptor(
                    runtime::Value::Int(function.get().function_length().to_int32()),
                    false,
                    false,
                    true,
                ),
            ) {
                return Result::Err(
                    error(offset, VmErrorKind::TypeError("cannot initialize function length")),
                )
            } else {};
            if !runtime::define_own_property(
                machine.heap,
                object,
                runtime::string_property_key("name"),
                runtime::data_descriptor(
                    runtime::Value::String(function.get().name().unwrap_or(js_string(""))),
                    false,
                    false,
                    true,
                ),
            ) {
                return Result::Err(
                    error(offset, VmErrorKind::TypeError("cannot initialize function name")),
                )
            } else {};
            match function.get().definition_location() {
                Some(location) => if !runtime::define_own_property(
                    machine.heap,
                    object,
                    runtime::string_property_key("lineNumber"),
                    runtime::data_descriptor(
                        runtime::Value::Int(location.line.to_int32()),
                        false,
                        false,
                        true,
                    ),
                )
                    || !runtime::define_own_property(
                        machine.heap,
                        object,
                        runtime::string_property_key("columnNumber"),
                        runtime::data_descriptor(
                            runtime::Value::Int(location.column.to_int32()),
                            false,
                            false,
                            true,
                        ),
                    ) {
                    return Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError("cannot initialize function source position"),
                        ),
                    )
                } else {},
                None => (),
            };
            if function.get().constructable() {
                let prototype = match runtime::new_ordinary_object(machine.heap, Option::None) {
                    Ok(value) => value,
                    Err(value) => {
                        return Result::Err(error(offset, VmErrorKind::TypeError(value.message)))
                    },
                };
                if !runtime::define_own_property(
                    machine.heap,
                    object,
                    runtime::string_property_key("prototype"),
                    runtime::data_descriptor(runtime::Value::Object(prototype), true, false, false),
                )
                    || !runtime::define_own_property(
                        machine.heap,
                        prototype,
                        runtime::string_property_key("constructor"),
                        runtime::data_descriptor(runtime::Value::Object(object), true, false, true),
                    ) {
                    return Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError("cannot initialize function prototype"),
                        ),
                    )
                } else {}
            } else {};
            match identity {
                Some(value) => {
                    machine.function_objects[value] = object;
                },
                None => (),
            };
            Result::Ok(runtime::Value::Object(object))
        },
        Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    }
}

fn field_key(machine: Machine, offset: int, index: int) -> Result[runtime::PropertyKey, VmError] {
    match machine.function.constant(index) {
        Some(bytecode::Constant::String(value)) => {
            Result::Ok(runtime::js_string_property_key(value))
        },
        Some(_) => Result::Err(error(offset, VmErrorKind::InvalidPropertyKey)),
        None => Result::Err(error(offset, VmErrorKind::InvalidConstant(index))),
    }
}

fn global_object(machine: Machine, offset: int) -> Result[runtime::ObjectId, VmError] {
    match machine.global_object {
        Some(object) => if machine.heap.contains(object) {
            Result::Ok(object)
        } else {
            Result::Err(error(offset, VmErrorKind::TypeError("global object is no longer alive")))
        },
        None => Result::Err(error(offset, VmErrorKind::TypeError("global object is not installed"))),
    }
}

fn eval_name(machine: Machine, offset: int, index: int) -> Result[string, VmError] {
    match machine.function.constant(index) {
        Some(bytecode::Constant::String(value)) => match value.to_host_string() {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(error(offset, VmErrorKind::InvalidPropertyKey)),
        },
        Some(_) => Result::Err(error(offset, VmErrorKind::InvalidPropertyKey)),
        None => Result::Err(error(offset, VmErrorKind::InvalidConstant(index))),
    }
}

fn eval_environment_cell(environment: Option[Ref[EvalEnvironment]], name: string) -> Option[
    Ref[runtime::Value],
] {
    let mut current = environment;
    loop {
        match current {
            Some(value) => match value.get().values.get(name) {
                Some(cell) => return Option::Some(cell),
                None => {
                    current = value.get().parent;
                },
            },
            None => return Option::None,
        }
    }
}

fn read_eval_binding(machine: Machine, offset: int, index: int, missing_is_undefined: bool) -> Result[
    runtime::Value,
    VmError,
] {
    let name = eval_name(machine, offset, index)?;
    match eval_environment_cell(machine.eval_environment.get(), name) {
        Some(cell) => Result::Ok(cell.get()),
        None => {
            let object = global_object(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            if missing_is_undefined {
                match runtime::get_property_descriptor(machine.heap, object, key) {
                    Ok(Some(_)) => read_object_property(
                        machine,
                        offset,
                        object,
                        runtime::Value::Object(object),
                        key,
                    ),
                    Ok(None) => Result::Ok(runtime::Value::Undefined),
                    Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
                }
            } else {
                read_global_property(machine, offset, object, key)
            }
        },
    }
}

fn write_eval_binding(machine: Machine, offset: int, index: int, value: runtime::Value) -> Result[
    unit,
    VmError,
] {
    let name = eval_name(machine, offset, index)?;
    match eval_environment_cell(machine.eval_environment.get(), name) {
        Some(cell) => {
            cell.set(value);
            Result::Ok(())
        },
        None => {
            let object = global_object(machine, offset)?;
            write_property(
                machine,
                offset,
                runtime::Value::Object(object),
                field_key(machine, offset, index)?,
                value,
            )
        },
    }
}

fn initialize_eval_binding(machine: Machine, offset: int, index: int) -> Result[unit, VmError] {
    let name = eval_name(machine, offset, index)?;
    match machine.eval_environment.get() {
        Some(environment) => {
            let values = environment.get().values;
            if values.get(name).is_none() {
                values[name] = Ref::new(runtime::Value::Undefined);
            } else {};
            Result::Ok(())
        },
        None => {
            let object = global_object(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            let exists = match machine.heap.get(object) {
                Some(value) => value.own_property(key).is_some(),
                None => false,
            };
            if exists
                || runtime::define_own_property(
                    machine.heap,
                    object,
                    key,
                    runtime::data_descriptor(runtime::Value::Undefined, true, true, true),
                ) {
                Result::Ok(())
            } else {
                Result::Err(error(offset, VmErrorKind::TypeError("cannot declare eval variable")))
            }
        },
    }
}

fn delete_eval_binding(machine: Machine, offset: int, index: int) -> Result[bool, VmError] {
    let name = eval_name(machine, offset, index)?;
    let mut current = machine.eval_environment.get();
    while true {
        match current {
            Some(environment) => {
                let value = environment.get();
                if value.values.get(name).is_some() {
                    value.values.remove(name);
                    return Result::Ok(true)
                } else {
                    current = value.parent;
                }
            },
            None => {
                return Result::Ok(
                    runtime::delete_property(
                        machine.heap,
                        global_object(machine, offset)?,
                        field_key(machine, offset, index)?,
                    ),
                )
            },
        }
    }
    Result::Ok(false)
}

fn enter_eval_environment(machine: Machine) -> unit {
    let environment = Ref::new(
        EvalEnvironment { values: HashMap::{}, parent: machine.eval_environment.get() },
    );
    machine.eval_environment.set(Option::Some(environment))
}

fn property_key(machine: Machine, offset: int, value: runtime::Value) -> Result[
    runtime::PropertyKey,
    VmError,
] {
    match to_primitive(machine, offset, value, PrimitiveHint::String)? {
        runtime::Value::String(value) => Result::Ok(runtime::js_string_property_key(value)),
        runtime::Value::Symbol(value) => Result::Ok(runtime::PropertyKey::Symbol(value)),
        runtime::Value::Undefined => Result::Ok(runtime::string_property_key("undefined")),
        runtime::Value::Null => Result::Ok(runtime::string_property_key("null")),
        runtime::Value::Bool(value) => Result::Ok(runtime::string_property_key(value.to_string())),
        runtime::Value::Int(value) => Result::Ok(runtime::string_property_key(value.to_string())),
        runtime::Value::Float(value) => {
            Result::Ok(runtime::string_property_key(dtoa::number_to_string(value)))
        },
        runtime::Value::BigInt(value) => {
            Result::Ok(runtime::string_property_key(value.to_string()))
        },
        runtime::Value::Object(_) => Result::Err(
            error(offset, VmErrorKind::TypeError("cannot convert object to property key")),
        ),
    }
}

fn property_key_value(machine: Machine, offset: int, value: runtime::Value) -> Result[
    runtime::Value,
    VmError,
] {
    match property_key(machine, offset, value)? {
        runtime::PropertyKey::String(value) => Result::Ok(runtime::Value::String(value)),
        runtime::PropertyKey::Symbol(value) => Result::Ok(runtime::Value::Symbol(value)),
    }
}

fn property_name(key: runtime::PropertyKey, name: string) -> bool {
    match key {
        runtime::PropertyKey::String(value) => value == js_string(name),
        runtime::PropertyKey::Symbol(_) => false,
    }
}

fn string_property_index(key: runtime::PropertyKey) -> Option[int] {
    let value = match key {
        runtime::PropertyKey::String(value) => value,
        runtime::PropertyKey::Symbol(_) => return Option::None,
    };
    if value.len() == 1 && value.get(0) == 48 {
        return Option::Some(0)
    } else if value.len() == 0 || value.get(0) == 48 {
        return Option::None
    } else {};
    let mut result = 0;
    let mut offset = 0;
    while offset < value.len() {
        let code_unit = value.get(offset);
        if code_unit < 48 || code_unit > 57 || result > 429496729 {
            return Option::None
        } else {};
        result = result * 10 + (code_unit - 48).to_int();
        if result > 4294967294 {
            return Option::None
        } else {};
        offset += 1;
    }
    Option::Some(result)
}

fn read_prototype_property(
    machine: Machine,
    offset: int,
    prototype: Ref[Option[runtime::ObjectId]],
    receiver: runtime::Value,
    key: runtime::PropertyKey,
) -> Result[runtime::Value, VmError] {
    match prototype.get() {
        Some(object) => read_object_property(machine, offset, object, receiver, key),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn proxy_parts(machine: Machine, offset: int, object: runtime::ObjectId) -> Result[
    Option[(runtime::ObjectId, runtime::ObjectId)],
    VmError,
] {
    let value = match machine.heap.get(object) {
        Some(value) => value,
        None => return Result::Err(error(offset, VmErrorKind::TypeError("proxy is invalid"))),
    };
    if !value.is_proxy() {
        return Result::Ok(Option::None)
    } else {};
    match (value.proxy_target(), value.proxy_handler()) {
        (Some(target), Some(handler)) => Result::Ok(Option::Some((target, handler))),
        _ => Result::Err(error(offset, VmErrorKind::TypeError("proxy has been revoked"))),
    }
}

fn proxy_trap(machine: Machine, offset: int, handler: runtime::ObjectId, name: string) -> Result[
    Option[runtime::Value],
    VmError,
] {
    let value = read_object_property(
        machine,
        offset,
        handler,
        runtime::Value::Object(handler),
        runtime::string_property_key(name),
    )?;
    match value {
        runtime::Value::Undefined | runtime::Value::Null => Result::Ok(Option::None),
        _ => Result::Ok(Option::Some(value)),
    }
}

fn property_key_runtime_value(key: runtime::PropertyKey) -> runtime::Value {
    match key {
        runtime::PropertyKey::String(value) => runtime::Value::String(value),
        runtime::PropertyKey::Symbol(value) => runtime::Value::Symbol(value),
    }
}

fn proxy_target_descriptor(
    machine: Machine,
    offset: int,
    target: runtime::ObjectId,
    key: runtime::PropertyKey,
) -> Result[Option[runtime::PropertyDescriptor], VmError] {
    match machine.heap.get(target) {
        Some(value) => Result::Ok(value.own_property(key)),
        None => Result::Err(error(offset, VmErrorKind::TypeError("proxy target is invalid"))),
    }
}

fn validate_proxy_get(
    machine: Machine,
    offset: int,
    target: runtime::ObjectId,
    key: runtime::PropertyKey,
    result: runtime::Value,
) -> Result[runtime::Value, VmError] {
    match proxy_target_descriptor(machine, offset, target, key)? {
        Some(descriptor) => if !runtime::descriptor_configurable(descriptor) {
            if runtime::descriptor_is_data(descriptor) && !runtime::descriptor_writable(descriptor) {
                match runtime::descriptor_value(descriptor) {
                    Some(value) => if !runtime::same_value(result, value) {
                        return Result::Err(
                            error(
                                offset,
                                VmErrorKind::TypeError(
                                    "proxy get trap violated a non-writable property",
                                ),
                            ),
                        )
                    } else {},
                    None => (),
                }
            } else if !runtime::descriptor_is_data(descriptor)
                && runtime::descriptor_get(descriptor).is_none()
                && !runtime::same_value(result, runtime::Value::Undefined) {
                return Result::Err(
                    error(
                        offset,
                        VmErrorKind::TypeError("proxy get trap violated an accessor property"),
                    ),
                )
            } else {}
        } else {},
        None => (),
    };
    Result::Ok(result)
}

fn validate_proxy_set(
    machine: Machine,
    offset: int,
    target: runtime::ObjectId,
    key: runtime::PropertyKey,
    value: runtime::Value,
) -> Result[unit, VmError] {
    match proxy_target_descriptor(machine, offset, target, key)? {
        Some(descriptor) => if !runtime::descriptor_configurable(descriptor) {
            if runtime::descriptor_is_data(descriptor) && !runtime::descriptor_writable(descriptor) {
                match runtime::descriptor_value(descriptor) {
                    Some(current) => if !runtime::same_value(value, current) {
                        return Result::Err(
                            error(
                                offset,
                                VmErrorKind::TypeError(
                                    "proxy set trap violated a non-writable property",
                                ),
                            ),
                        )
                    } else {},
                    None => (),
                }
            } else if !runtime::descriptor_is_data(descriptor)
                && runtime::descriptor_set(descriptor).is_none() {
                return Result::Err(
                    error(
                        offset,
                        VmErrorKind::TypeError("proxy set trap violated an accessor property"),
                    ),
                )
            } else {}
        } else {},
        None => (),
    };
    Result::Ok(())
}

fn read_object_property(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    receiver: runtime::Value,
    key: runtime::PropertyKey,
) -> Result[runtime::Value, VmError] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "get")? {
            Some(trap) => return validate_proxy_get(
                machine,
                offset,
                target,
                key,
                call_value(
                    machine,
                    offset,
                    trap,
                    Vec::[runtime::Value::Object(target), property_key_runtime_value(key), receiver],
                    runtime::Value::Object(handler),
                )?,
            ),
            None => return read_object_property(machine, offset, target, receiver, key),
        },
        None => (),
    };
    match runtime::get_property_descriptor(machine.heap, object, key) {
        Ok(Some(runtime::PropertyDescriptor::Data { value, .. })) => Result::Ok(value),
        Ok(Some(runtime::PropertyDescriptor::Accessor { get: Some(value), .. })) => {
            call_value(machine, offset, value, Vec::[], receiver)
        },
        Ok(Some(runtime::PropertyDescriptor::Accessor { get: None, .. })) | Ok(None) => {
            Result::Ok(runtime::Value::Undefined)
        },
        Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    }
}

fn read_property(machine: Machine, offset: int, receiver: runtime::Value, key: runtime::PropertyKey) -> Result[
    runtime::Value,
    VmError,
] {
    match receiver {
        runtime::Value::Object(object) => {
            read_object_property(machine, offset, object, receiver, key)
        },
        runtime::Value::String(value) => if property_name(key, "length") {
            Result::Ok(runtime::Value::Int(value.len().to_int32()))
        } else {
            match string_property_index(key) {
                Some(index) => if index < value.len() {
                    Result::Ok(
                        runtime::Value::String(
                            runtime::JsString::from_code_units(Vec::[value.get(index)]),
                        ),
                    )
                } else {
                    read_prototype_property(
                        machine,
                        offset,
                        machine.primitive_prototypes.string_value,
                        receiver,
                        key,
                    )
                },
                None => read_prototype_property(
                    machine,
                    offset,
                    machine.primitive_prototypes.string_value,
                    receiver,
                    key,
                ),
            }
        },
        runtime::Value::Bool(_) => read_prototype_property(
            machine,
            offset,
            machine.primitive_prototypes.boolean_value,
            receiver,
            key,
        ),
        runtime::Value::Int(_) | runtime::Value::Float(_) => read_prototype_property(
            machine,
            offset,
            machine.primitive_prototypes.number_value,
            receiver,
            key,
        ),
        runtime::Value::BigInt(_) => read_prototype_property(
            machine,
            offset,
            machine.primitive_prototypes.bigint_value,
            receiver,
            key,
        ),
        runtime::Value::Symbol(value) => if property_name(key, "description") {
            match value.description() {
                Some(value) => Result::Ok(runtime::Value::String(value)),
                None => Result::Ok(runtime::Value::Undefined),
            }
        } else {
            read_prototype_property(
                machine,
                offset,
                machine.primitive_prototypes.symbol_value,
                receiver,
                key,
            )
        },
        runtime::Value::Undefined | runtime::Value::Null => Result::Err(
            error(offset, VmErrorKind::TypeError("cannot read property of null or undefined")),
        ),
    }
}

fn global_reference_name(key: runtime::PropertyKey) -> string {
    match key {
        runtime::PropertyKey::String(value) => value.to_host_string().unwrap_or("<global>"),
        runtime::PropertyKey::Symbol(_) => "<symbol>",
    }
}

fn read_global_property(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
) -> Result[runtime::Value, VmError] {
    match runtime::get_property_descriptor(machine.heap, object, key) {
        Ok(Some(_)) => {
            read_object_property(machine, offset, object, runtime::Value::Object(object), key)
        },
        Ok(None) => Result::Err(
            error(
                offset,
                VmErrorKind::ReferenceError(global_reference_name(key) + " is not defined"),
            ),
        ),
        Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    }
}

fn write_object_property(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    receiver: runtime::Value,
    key: runtime::PropertyKey,
    value: runtime::Value,
) -> Result[unit, VmError] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "set")? {
            Some(trap) => {
                let result = call_value(
                    machine,
                    offset,
                    trap,
                    Vec::[
                        runtime::Value::Object(target),
                        property_key_runtime_value(key),
                        value,
                        receiver,
                    ],
                    runtime::Value::Object(handler),
                )?;
                if runtime::to_boolean(result) {
                    validate_proxy_set(machine, offset, target, key, value)?;
                    return Result::Ok(())
                } else if !machine.function.strict() {
                    return Result::Ok(())
                } else {
                    return Result::Err(
                        error(offset, VmErrorKind::TypeError("proxy set trap returned false")),
                    )
                }
            },
            None => {
                let written = reflect_set_property(machine, offset, target, receiver, key, value)?;
                if written || !machine.function.strict() {
                    return Result::Ok(())
                } else {
                    return Result::Err(
                        error(offset, VmErrorKind::TypeError("property is not writable")),
                    )
                }
            },
        },
        None => (),
    };
    if runtime::is_typed_array_numeric_property(machine.heap, object, key) {
        let converted = if runtime::is_bigint_typed_array(machine.heap, object) {
            runtime::Value::BigInt(bigint_value(machine, offset, value)?)
        } else {
            runtime::Value::Float(number(machine, offset, value)?)
        };
        return match runtime::set_property(machine.heap, object, key, converted) {
            Ok(written) => if written || !machine.function.strict() {
                Result::Ok(())
            } else {
                Result::Err(error(offset, VmErrorKind::TypeError("property is not writable")))
            },
            Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
        }
    } else {};
    match runtime::get_property_descriptor(machine.heap, object, key) {
        Ok(Some(runtime::PropertyDescriptor::Accessor { set: Some(setter), .. })) => {
            let _ = call_value(machine, offset, setter, Vec::[value], receiver)?;
            Result::Ok(())
        },
        Ok(_) => match runtime::set_property(machine.heap, object, key, value) {
            Ok(written) => if written || !machine.function.strict() {
                Result::Ok(())
            } else {
                Result::Err(error(offset, VmErrorKind::TypeError("property is not writable")))
            },
            Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
        },
        Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    }
}

fn define_copied_property(
    machine: Machine,
    offset: int,
    target: runtime::ObjectId,
    key: runtime::PropertyKey,
    value: runtime::Value,
) -> Result[unit, VmError] {
    if runtime::define_own_property(
        machine.heap,
        target,
        key,
        runtime::data_descriptor(value, true, true, true),
    ) {
        Result::Ok(())
    } else {
        Result::Err(error(offset, VmErrorKind::TypeError("cannot copy object property")))
    }
}

fn array_literal_target(machine: Machine, offset: int, value: runtime::Value) -> Result[
    runtime::ObjectId,
    VmError,
] {
    match value {
        runtime::Value::Object(object) => match machine.heap.get(object) {
            Some(value) => match value.kind() {
                runtime::ObjectKind::Array => Result::Ok(object),
                _ => Result::Err(
                    error(offset, VmErrorKind::TypeError("array literal target is invalid")),
                ),
            },
            None => Result::Err(
                error(offset, VmErrorKind::TypeError("array literal target is invalid")),
            ),
        },
        _ => Result::Err(error(offset, VmErrorKind::TypeError("array literal target is invalid"))),
    }
}

fn append_array_literal_value(
    machine: Machine,
    offset: int,
    array: runtime::ObjectId,
    value: runtime::Value,
) -> Result[unit, VmError] {
    match arrayx::push(machine.heap, array, Vec::[value]) {
        Ok(_) => Result::Ok(()),
        Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.to_string()))),
    }
}

fn append_array_literal(machine: Machine, offset: int) -> Result[unit, VmError] {
    let value = pop(machine, offset)?;
    let target = pop(machine, offset)?;
    let array = array_literal_target(machine, offset, target)?;
    append_array_literal_value(machine, offset, array, value)?;
    machine.stack.push(target);
    Result::Ok(())
}

fn append_array_literal_hole(machine: Machine, offset: int) -> Result[unit, VmError] {
    let target = pop(machine, offset)?;
    let array = array_literal_target(machine, offset, target)?;
    let length = match arrayx::length(machine.heap, array) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.to_string()))),
    };
    if !runtime::define_own_property(
        machine.heap,
        array,
        runtime::string_property_key("length"),
        runtime::data_descriptor(
            if length + 1 <= 2147483647 {
                runtime::Value::Int((length + 1).to_int32())
            } else {
                runtime::Value::Float(num::parse_float64((length + 1).to_string()).unwrap_or(0.0))
            },
            true,
            false,
            false,
        ),
    ) {
        return Result::Err(error(offset, VmErrorKind::TypeError("cannot append array hole")))
    } else {};
    machine.stack.push(target);
    Result::Ok(())
}

fn append_iterator_values(
    machine: Machine,
    offset: int,
    array: runtime::ObjectId,
    iterator: runtime::Value,
) -> Result[unit, VmError] {
    match iterator {
        runtime::Value::Object(_) => {},
        _ => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("iterator result is not an object")),
            )
        },
    };
    let next = read_property(machine, offset, iterator, runtime::string_property_key("next"))?;
    loop {
        let result = call_value(machine, offset, next, Vec::[], iterator)?;
        match result {
            runtime::Value::Object(_) => {},
            _ => {
                return Result::Err(
                    error(offset, VmErrorKind::TypeError("iterator next result is not an object")),
                )
            },
        };
        let done = read_property(machine, offset, result, runtime::string_property_key("done"))?;
        if runtime::to_boolean(done) {
            return Result::Ok(())
        } else {};
        let value = read_property(machine, offset, result, runtime::string_property_key("value"))?;
        append_array_literal_value(machine, offset, array, value)?
    }
}

fn append_custom_iterable(
    machine: Machine,
    offset: int,
    array: runtime::ObjectId,
    source: runtime::Value,
) -> Result[bool, VmError] {
    let symbol = match machine.iterator_symbol {
        Some(value) => value,
        None => return Result::Ok(false),
    };
    let method = read_property(machine, offset, source, runtime::PropertyKey::Symbol(symbol))?;
    match method {
        runtime::Value::Undefined => Result::Ok(false),
        runtime::Value::Null => Result::Err(
            error(offset, VmErrorKind::TypeError("array spread value is not iterable")),
        ),
        runtime::Value::Object(value) => if value.is_callable() {
            let iterator = call_value(machine, offset, method, Vec::[], source)?;
            append_iterator_values(machine, offset, array, iterator)?;
            Result::Ok(true)
        } else {
            Result::Err(error(offset, VmErrorKind::TypeError("iterator method is not callable")))
        },
        _ => Result::Err(error(offset, VmErrorKind::TypeError("iterator method is not callable"))),
    }
}

fn enumeration_array(machine: Machine, offset: int, keys: Vec[runtime::JsString]) -> Result[
    runtime::Value,
    VmError,
] {
    let array = match runtime::new_array(machine.heap, keys.len()) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    let mut index = 0;
    while index < keys.len() {
        if !runtime::define_own_property(
            machine.heap,
            array,
            runtime::string_property_key(index.to_string()),
            runtime::data_descriptor(runtime::Value::String(keys[index]), true, true, true),
        ) {
            return Result::Err(error(offset, VmErrorKind::TypeError("cannot create enumeration")))
        } else {};
        index += 1;
    }
    Result::Ok(runtime::Value::Object(array))
}

fn proxy_own_keys(machine: Machine, offset: int, object: runtime::ObjectId) -> Result[
    Vec[runtime::PropertyKey],
    VmError,
] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "ownKeys")? {
            Some(trap) => {
                let value = call_value(
                    machine,
                    offset,
                    trap,
                    Vec::[runtime::Value::Object(target)],
                    runtime::Value::Object(handler),
                )?;
                let values = argument_array_values(machine, offset, value)?;
                let keys: Vec[runtime::PropertyKey] = Vec::[];
                for value in values {
                    let key = match value {
                        runtime::Value::String(value) => runtime::PropertyKey::String(value),
                        runtime::Value::Symbol(value) => runtime::PropertyKey::Symbol(value),
                        _ => return Result::Err(
                            error(
                                offset,
                                VmErrorKind::TypeError(
                                    "proxy ownKeys trap returned a non-property key",
                                ),
                            ),
                        ),
                    };
                    for existing in keys {
                        if existing == key {
                            return Result::Err(
                                error(
                                    offset,
                                    VmErrorKind::TypeError(
                                        "proxy ownKeys trap returned a duplicate key",
                                    ),
                                ),
                            )
                        } else {}
                    }
                    keys.push(key)
                }
                let target_keys = runtime::own_property_keys(machine.heap, target);
                let target_object = match machine.heap.get(target) {
                    Some(value) => value,
                    None => return Result::Err(
                        error(offset, VmErrorKind::TypeError("proxy target is invalid")),
                    ),
                };
                for target_key in target_keys {
                    let mut present = false;
                    for key in keys {
                        if key == target_key {
                            present = true;
                        } else {}
                    }
                    let descriptor = target_object.own_property(target_key);
                    match descriptor {
                        Some(value) => if !present
                            && (!runtime::descriptor_configurable(value)
                                || !target_object.extensible()) {
                            return Result::Err(
                                error(
                                    offset,
                                    VmErrorKind::TypeError(
                                        "proxy ownKeys trap omitted a required key",
                                    ),
                                ),
                            )
                        } else {},
                        None => (),
                    }
                }
                if !target_object.extensible() && keys.len() != target_keys.len() {
                    return Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError(
                                "proxy ownKeys trap added a key to a non-extensible target",
                            ),
                        ),
                    )
                } else {};
                Result::Ok(keys)
            },
            None => Result::Ok(runtime::own_property_keys(machine.heap, target)),
        },
        None => Result::Ok(runtime::own_property_keys(machine.heap, object)),
    }
}

fn push_own_keys(machine: Machine, offset: int) -> Result[unit, VmError] {
    let value = pop(machine, offset)?;
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(error(offset, VmErrorKind::TypeError("target is not an object"))),
    };
    let keys = proxy_own_keys(machine, offset, object)?;
    let array = match runtime::new_array(machine.heap, keys.len()) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    let mut index = 0;
    while index < keys.len() {
        if !runtime::define_own_property(
            machine.heap,
            array,
            runtime::string_property_key(index.to_string()),
            runtime::data_descriptor(property_key_runtime_value(keys[index]), true, true, true),
        ) {
            return Result::Err(error(offset, VmErrorKind::TypeError("cannot create key array")))
        } else {};
        index += 1;
    }
    machine.stack.push(runtime::Value::Object(array));
    Result::Ok(())
}

fn proxy_get_prototype_of(machine: Machine, offset: int, object: runtime::ObjectId) -> Result[
    Option[runtime::ObjectId],
    VmError,
] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "getPrototypeOf")? {
            Some(trap) => {
                let result = call_value(
                    machine,
                    offset,
                    trap,
                    Vec::[runtime::Value::Object(target)],
                    runtime::Value::Object(handler),
                )?;
                let prototype = match result {
                    runtime::Value::Null => Option::None,
                    runtime::Value::Object(value) => Option::Some(value),
                    _ => return Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError(
                                "proxy getPrototypeOf trap returned an invalid prototype",
                            ),
                        ),
                    ),
                };
                if !proxy_is_extensible(machine, offset, target)?
                    && proxy_get_prototype_of(machine, offset, target)? != prototype {
                    Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError("proxy getPrototypeOf trap violated the target"),
                        ),
                    )
                } else {
                    Result::Ok(prototype)
                }
            },
            None => proxy_get_prototype_of(machine, offset, target),
        },
        None => match machine.heap.get(object) {
            Some(value) => Result::Ok(value.prototype()),
            None => Result::Err(error(offset, VmErrorKind::TypeError("object is invalid"))),
        },
    }
}

fn proxy_is_extensible(machine: Machine, offset: int, object: runtime::ObjectId) -> Result[
    bool,
    VmError,
] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "isExtensible")? {
            Some(trap) => {
                let result = runtime::to_boolean(
                    call_value(
                        machine,
                        offset,
                        trap,
                        Vec::[runtime::Value::Object(target)],
                        runtime::Value::Object(handler),
                    )?,
                );
                if result != proxy_is_extensible(machine, offset, target)? {
                    Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError("proxy isExtensible trap violated the target"),
                        ),
                    )
                } else {
                    Result::Ok(result)
                }
            },
            None => proxy_is_extensible(machine, offset, target),
        },
        None => match machine.heap.get(object) {
            Some(value) => Result::Ok(value.extensible()),
            None => Result::Err(error(offset, VmErrorKind::TypeError("object is invalid"))),
        },
    }
}

fn proxy_set_prototype_of(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    prototype: Option[runtime::ObjectId],
) -> Result[bool, VmError] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "setPrototypeOf")? {
            Some(trap) => {
                let prototype_value = match prototype {
                    Some(value) => runtime::Value::Object(value),
                    None => runtime::Value::Null,
                };
                let result = runtime::to_boolean(
                    call_value(
                        machine,
                        offset,
                        trap,
                        Vec::[runtime::Value::Object(target), prototype_value],
                        runtime::Value::Object(handler),
                    )?,
                );
                if !result || proxy_is_extensible(machine, offset, target)? {
                    Result::Ok(result)
                } else if proxy_get_prototype_of(machine, offset, target)? == prototype {
                    Result::Ok(true)
                } else {
                    Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError("proxy setPrototypeOf trap violated the target"),
                        ),
                    )
                }
            },
            None => proxy_set_prototype_of(machine, offset, target, prototype),
        },
        None => Result::Ok(runtime::set_prototype_of(machine.heap, object, prototype)),
    }
}

fn proxy_prevent_extensions(machine: Machine, offset: int, object: runtime::ObjectId) -> Result[
    bool,
    VmError,
] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "preventExtensions")? {
            Some(trap) => {
                let result = runtime::to_boolean(
                    call_value(
                        machine,
                        offset,
                        trap,
                        Vec::[runtime::Value::Object(target)],
                        runtime::Value::Object(handler),
                    )?,
                );
                if result && proxy_is_extensible(machine, offset, target)? {
                    Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError(
                                "proxy preventExtensions trap violated the target",
                            ),
                        ),
                    )
                } else {
                    Result::Ok(result)
                }
            },
            None => proxy_prevent_extensions(machine, offset, target),
        },
        None => Result::Ok(runtime::prevent_extensions(machine.heap, object)),
    }
}

fn push_get_prototype_of(machine: Machine, offset: int) -> Result[unit, VmError] {
    let target = reflect_target(offset, pop(machine, offset)?)?;
    machine.stack.push(
        match proxy_get_prototype_of(machine, offset, target)? {
            Some(value) => runtime::Value::Object(value),
            None => runtime::Value::Null,
        },
    );
    Result::Ok(())
}

fn push_set_prototype_of(machine: Machine, offset: int) -> Result[unit, VmError] {
    let prototype = match pop(machine, offset)? {
        runtime::Value::Null => Option::None,
        runtime::Value::Object(value) => Option::Some(value),
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("prototype is not an object or null")),
        ),
    };
    let target = reflect_target(offset, pop(machine, offset)?)?;
    machine.stack.push(
        runtime::Value::Bool(proxy_set_prototype_of(machine, offset, target, prototype)?),
    );
    Result::Ok(())
}

fn push_is_extensible(machine: Machine, offset: int) -> Result[unit, VmError] {
    let target = reflect_target(offset, pop(machine, offset)?)?;
    machine.stack.push(runtime::Value::Bool(proxy_is_extensible(machine, offset, target)?));
    Result::Ok(())
}

fn push_prevent_extensions(machine: Machine, offset: int) -> Result[unit, VmError] {
    let target = reflect_target(offset, pop(machine, offset)?)?;
    machine.stack.push(runtime::Value::Bool(proxy_prevent_extensions(machine, offset, target)?));
    Result::Ok(())
}

fn own_property_enumerable(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
) -> Result[Option[bool], VmError] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(
            machine,
            offset,
            handler,
            "getOwnPropertyDescriptor",
        )? {
            Some(trap) => {
                let result = call_value(
                    machine,
                    offset,
                    trap,
                    Vec::[runtime::Value::Object(target), property_key_runtime_value(key)],
                    runtime::Value::Object(handler),
                )?;
                match result {
                    runtime::Value::Undefined => Result::Ok(Option::None),
                    runtime::Value::Object(descriptor) => Result::Ok(
                        Option::Some(
                            runtime::to_boolean(
                                read_property(
                                    machine,
                                    offset,
                                    runtime::Value::Object(descriptor),
                                    runtime::string_property_key("enumerable"),
                                )?,
                            ),
                        ),
                    ),
                    _ => Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError(
                                "proxy getOwnPropertyDescriptor trap returned an invalid descriptor",
                            ),
                        ),
                    ),
                }
            },
            None => match machine.heap.get(target) {
                Some(value) => Result::Ok(
                    value.own_property(key).map(
                        |descriptor| {
                            runtime::descriptor_enumerable(descriptor)
                        },
                    ),
                ),
                None => Result::Err(
                    error(offset, VmErrorKind::TypeError("proxy target is invalid")),
                ),
            },
        },
        None => match machine.heap.get(object) {
            Some(value) => Result::Ok(
                value.own_property(key).map(|descriptor| runtime::descriptor_enumerable(descriptor)),
            ),
            None => Result::Err(error(offset, VmErrorKind::TypeError("object is invalid"))),
        },
    }
}

fn enumerable_property(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
) -> Result[bool, VmError] {
    let mut cursor = Option::Some(object);
    while cursor.is_some() {
        match cursor {
            Some(current) => match own_property_enumerable(machine, offset, current, key)? {
                Some(value) => return Result::Ok(value),
                None => {
                    cursor = proxy_get_prototype_of(machine, offset, current)?;
                },
            },
            None => (),
        }
    }
    Result::Ok(false)
}

fn push_enumerable_property(machine: Machine, offset: int) -> Result[unit, VmError] {
    let source = pop(machine, offset)?;
    let key = property_key(machine, offset, pop(machine, offset)?)?;
    let object = match source {
        runtime::Value::Object(value) => value,
        runtime::Value::String(value) => {
            let enumerable = match key {
                runtime::PropertyKey::String(_) => match string_property_index(key) {
                    Some(index) => index >= 0 && index < value.len(),
                    None => false,
                },
                runtime::PropertyKey::Symbol(_) => false,
            };
            machine.stack.push(runtime::Value::Bool(enumerable));
            return Result::Ok(())
        },
        _ => {
            machine.stack.push(runtime::Value::Bool(false));
            return Result::Ok(())
        },
    };
    machine.stack.push(runtime::Value::Bool(enumerable_property(machine, offset, object, key)?));
    Result::Ok(())
}

fn enumerate_value(machine: Machine, offset: int) -> Result[unit, VmError] {
    let source = pop(machine, offset)?;
    let keys: Vec[runtime::JsString] = Vec::[];
    match source {
        runtime::Value::Object(object) => {
            let visited: collections::HashSet[runtime::JsString] = collections::HashSet::new();
            let mut cursor = Option::Some(object);
            while cursor.is_some() {
                match cursor {
                    Some(current) => {
                        let target = match machine.heap.get(current) {
                            Some(value) => value,
                            None => {
                                return Result::Err(
                                    error(
                                        offset,
                                        VmErrorKind::TypeError("enumerated object is invalid"),
                                    ),
                                )
                            },
                        };
                        let current_is_proxy = target.is_proxy();
                        for key in proxy_own_keys(machine, offset, current)? {
                            match key {
                                runtime::PropertyKey::String(name) => if !visited.contains(name) {
                                    visited.insert(name);
                                    if current_is_proxy {
                                        keys.push(name)
                                    } else {
                                        match target.own_property(key) {
                                            Some(descriptor) => if runtime::descriptor_enumerable(
                                                descriptor,
                                            ) {
                                                keys.push(name)
                                            } else {},
                                            None => (),
                                        }
                                    }
                                } else {},
                                runtime::PropertyKey::Symbol(_) => (),
                            }
                        }
                        cursor = proxy_get_prototype_of(machine, offset, current)?;
                    },
                    None => (),
                }
            }
        },
        runtime::Value::String(value) => {
            let mut index = 0;
            while index < value.len() {
                keys.push(js_string(index.to_string()));
                index += 1;
            }
        },
        runtime::Value::Undefined | runtime::Value::Null | runtime::Value::Bool(_) | runtime::Value::Int(_) | runtime::Value::Float(_) | runtime::Value::Symbol(_) | runtime::Value::BigInt(_) => (),
    };
    machine.stack.push(enumeration_array(machine, offset, keys)?);
    Result::Ok(())
}

fn start_iterator(machine: Machine, offset: int) -> Result[unit, VmError] {
    let source = pop(machine, offset)?;
    let symbol = match machine.iterator_symbol {
        Some(value) => value,
        None => return Result::Err(error(offset, VmErrorKind::TypeError("value is not iterable"))),
    };
    let method = read_property(machine, offset, source, runtime::PropertyKey::Symbol(symbol))?;
    match method {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("iterator method is not callable")),
            )
        } else {},
        _ => return Result::Err(error(offset, VmErrorKind::TypeError("value is not iterable"))),
    };
    let iterator = call_value(machine, offset, method, Vec::[], source)?;
    match iterator {
        runtime::Value::Object(_) => {},
        _ => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("iterator result is not an object")),
            )
        },
    };
    let next = read_property(machine, offset, iterator, runtime::string_property_key("next"))?;
    match next {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("iterator next is not callable")),
            )
        } else {},
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("iterator next is not callable")),
        ),
    };
    machine.stack.push(iterator);
    machine.stack.push(next);
    Result::Ok(())
}

fn start_async_iterator(machine: Machine, offset: int) -> Result[unit, VmError] {
    let source = pop(machine, offset)?;
    let method = match machine.generators.async_iterator_symbol.get() {
        Some(symbol) => match read_property(
            machine,
            offset,
            source,
            runtime::PropertyKey::Symbol(symbol),
        )? {
            runtime::Value::Undefined | runtime::Value::Null => Option::None,
            value => Option::Some(value),
        },
        None => Option::None,
    };
    let selected = match method {
        Some(value) => value,
        None => {
            let symbol = match machine.iterator_symbol {
                Some(value) => value,
                None => return Result::Err(
                    error(offset, VmErrorKind::TypeError("value is not async iterable")),
                ),
            };
            read_property(machine, offset, source, runtime::PropertyKey::Symbol(symbol))?
        },
    };
    match selected {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("async iterator method is not callable")),
            )
        } else {},
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("value is not async iterable")),
        ),
    };
    let iterator = call_value(machine, offset, selected, Vec::[], source)?;
    match iterator {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("async iterator result is not an object")),
        ),
    };
    let next = read_property(machine, offset, iterator, runtime::string_property_key("next"))?;
    match next {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("async iterator next is not callable")),
            )
        } else {},
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("async iterator next is not callable")),
        ),
    };
    machine.stack.push(iterator);
    machine.stack.push(next);
    Result::Ok(())
}

fn advance_iterator(machine: Machine, offset: int) -> Result[unit, VmError] {
    let next = pop(machine, offset)?;
    let iterator = pop(machine, offset)?;
    let result = call_value(machine, offset, next, Vec::[], iterator)?;
    push_iterator_result(machine, offset, result, "iterator next result is not an object")
}

fn push_iterator_result(machine: Machine, offset: int, result: runtime::Value, message: string) -> Result[
    unit,
    VmError,
] {
    match result {
        runtime::Value::Object(_) => {},
        _ => {
            return Result::Err(error(offset, VmErrorKind::TypeError(message)))
        },
    };
    let done = read_property(machine, offset, result, runtime::string_property_key("done"))?;
    machine.stack.push(result);
    machine.stack.push(runtime::Value::Bool(runtime::to_boolean(done)));
    Result::Ok(())
}

fn advance_iterator_with_value(machine: Machine, offset: int) -> Result[unit, VmError] {
    let input = pop(machine, offset)?;
    let next = pop(machine, offset)?;
    let iterator = pop(machine, offset)?;
    let result = call_value(machine, offset, next, Vec::[input], iterator)?;
    push_iterator_result(machine, offset, result, "iterator next result is not an object")
}

fn call_iterator_next(machine: Machine, offset: int, with_value: bool) -> Result[unit, VmError] {
    let input = if with_value {
        Option::Some(pop(machine, offset)?)
    } else {
        Option::None
    };
    let next = pop(machine, offset)?;
    let iterator = pop(machine, offset)?;
    let arguments = match input {
        Some(value) => Vec::[value],
        None => Vec::[],
    };
    machine.stack.push(call_value(machine, offset, next, arguments, iterator)?);
    Result::Ok(())
}

fn call_iterator_resume(machine: Machine, offset: int, returning: bool) -> Result[unit, VmError] {
    let input = pop(machine, offset)?;
    let iterator = pop(machine, offset)?;
    let name = if returning {
        "return"
    } else {
        "throw"
    };
    let method = read_property(machine, offset, iterator, runtime::string_property_key(name))?;
    match method {
        runtime::Value::Undefined | runtime::Value::Null => if returning {
            machine.stack.push(generator_result(machine.heap, input, true)?);
            Result::Ok(())
        } else {
            let return_method = read_property(
                machine,
                offset,
                iterator,
                runtime::string_property_key("return"),
            )?;
            match return_method {
                runtime::Value::Undefined | runtime::Value::Null => Result::Err(
                    error(
                        offset,
                        VmErrorKind::TypeError("iterator does not provide a throw method"),
                    ),
                ),
                _ => {
                    let result = call_value(machine, offset, return_method, Vec::[], iterator)?;
                    machine.stack.push(runtime::Value::Bool(false));
                    machine.stack.push(result);
                    Result::Ok(())
                },
            }
        },
        _ => {
            let result = call_value(machine, offset, method, Vec::[input], iterator)?;
            if !returning {
                machine.stack.push(runtime::Value::Bool(true))
            } else {};
            machine.stack.push(result);
            Result::Ok(())
        },
    }
}

fn decode_iterator_result(machine: Machine, offset: int) -> Result[unit, VmError] {
    let result = pop(machine, offset)?;
    push_iterator_result(machine, offset, result, "iterator result is not an object")
}

fn decode_iterator_throw_result(machine: Machine, offset: int) -> Result[unit, VmError] {
    let result = pop(machine, offset)?;
    let has_throw = pop(machine, offset)?;
    match has_throw {
        runtime::Value::Bool(true) => push_iterator_result(
            machine,
            offset,
            result,
            "iterator throw result is not an object",
        ),
        _ => match result {
            runtime::Value::Object(_) => Result::Err(
                error(offset, VmErrorKind::TypeError("iterator does not provide a throw method")),
            ),
            _ => Result::Err(
                error(offset, VmErrorKind::TypeError("iterator return result is not an object")),
            ),
        },
    }
}

fn resume_iterator_method(machine: Machine, offset: int, returning: bool) -> Result[unit, VmError] {
    let input = pop(machine, offset)?;
    let iterator = pop(machine, offset)?;
    let name = if returning {
        "return"
    } else {
        "throw"
    };
    let method = read_property(machine, offset, iterator, runtime::string_property_key(name))?;
    match method {
        runtime::Value::Undefined | runtime::Value::Null => if returning {
            machine.stack.push(generator_result(machine.heap, input, true)?);
            machine.stack.push(runtime::Value::Bool(true));
            Result::Ok(())
        } else {
            close_iterator_value(machine, offset, iterator)?;
            Result::Err(
                error(offset, VmErrorKind::TypeError("iterator does not provide a throw method")),
            )
        },
        _ => {
            let result = call_value(machine, offset, method, Vec::[input], iterator)?;
            push_iterator_result(
                machine,
                offset,
                result,
                if returning {
                    "iterator return result is not an object"
                } else {
                    "iterator throw result is not an object"
                },
            )
        },
    }
}

fn close_iterator_value(machine: Machine, offset: int, iterator: runtime::Value) -> Result[
    unit,
    VmError,
] {
    let method = read_property(machine, offset, iterator, runtime::string_property_key("return"))?;
    match method {
        runtime::Value::Undefined | runtime::Value::Null => Result::Ok(()),
        runtime::Value::Object(object) => if object.is_callable() {
            let result = call_value(machine, offset, method, Vec::[], iterator)?;
            match result {
                runtime::Value::Object(_) => Result::Ok(()),
                _ => Result::Err(
                    error(offset, VmErrorKind::TypeError("iterator return result is not an object")),
                ),
            }
        } else {
            Result::Err(error(offset, VmErrorKind::TypeError("iterator return is not callable")))
        },
        _ => Result::Err(error(offset, VmErrorKind::TypeError("iterator return is not callable"))),
    }
}

fn close_iterator(machine: Machine, offset: int) -> Result[unit, VmError] {
    let iterator = pop(machine, offset)?;
    close_iterator_value(machine, offset, iterator)
}

fn close_iterator_throw(machine: Machine, offset: int) -> Result[unit, VmError] {
    let exception = pop(machine, offset)?;
    let iterator = pop(machine, offset)?;
    let _ = close_iterator_value(machine, offset, iterator);
    machine.stack.push(exception);
    Result::Ok(())
}

fn append_array_spread(machine: Machine, offset: int) -> Result[unit, VmError] {
    let source = pop(machine, offset)?;
    let target = pop(machine, offset)?;
    let array = array_literal_target(machine, offset, target)?;
    match source {
        runtime::Value::Object(source_array) => {
            if !append_custom_iterable(machine, offset, array, source)? {
                let length = match arrayx::length(machine.heap, source_array) {
                    Ok(value) => value,
                    Err(_) => {
                        return Result::Err(
                            error(
                                offset,
                                VmErrorKind::TypeError("array spread value is not iterable"),
                            ),
                        )
                    },
                };
                let mut index = 0;
                while index < length {
                    let value = read_property(
                        machine,
                        offset,
                        source,
                        runtime::string_property_key(index.to_string()),
                    )?;
                    append_array_literal_value(machine, offset, array, value)?;
                    index += 1;
                }
            } else {}
        },
        runtime::Value::String(value) => {
            let mut index = 0;
            while index < value.len() {
                let width = if runtime::is_high_surrogate(value.get(index))
                    && index + 1 < value.len()
                    && runtime::is_low_surrogate(value.get(index + 1)) {
                    2
                } else {
                    1
                };
                append_array_literal_value(
                    machine,
                    offset,
                    array,
                    runtime::Value::String(value.slice(index, index + width)),
                )?;
                index += width;
            }
        },
        _ => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("array spread value is not iterable")),
            )
        },
    };
    machine.stack.push(target);
    Result::Ok(())
}

fn define_accessor_property_with_key(
    machine: Machine,
    offset: int,
    key: runtime::PropertyKey,
    getter: bool,
    enumerable: bool,
) -> Result[unit, VmError] {
    let accessor = pop(machine, offset)?;
    let target = match pop(machine, offset)? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("accessor target is not an object")),
        ),
    };
    match accessor {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(error(offset, VmErrorKind::TypeError("accessor is not callable")))
        } else {},
        _ => return Result::Err(error(offset, VmErrorKind::TypeError("accessor is not callable"))),
    };
    if !enumerable {
        match accessor {
            runtime::Value::Object(value) => match machine.functions.get(value) {
                Some(closure) => closure.home_object.set(Option::Some(target)),
                None => (),
            },
            _ => (),
        }
    } else {};
    let current = match machine.heap.get(target) {
        Some(value) => value.own_property(key),
        None => return Result::Err(
            error(offset, VmErrorKind::TypeError("accessor target is invalid")),
        ),
    };
    let previous_get = match current {
        Some(value) => runtime::descriptor_get(value),
        None => Option::None,
    };
    let previous_set = match current {
        Some(value) => runtime::descriptor_set(value),
        None => Option::None,
    };
    let descriptor = if getter {
        runtime::accessor_descriptor(Option::Some(accessor), previous_set, enumerable, true)
    } else {
        runtime::accessor_descriptor(previous_get, Option::Some(accessor), enumerable, true)
    };
    if runtime::define_own_property(machine.heap, target, key, descriptor) {
        Result::Ok(())
    } else {
        Result::Err(error(offset, VmErrorKind::TypeError("cannot define accessor property")))
    }
}

fn define_accessor_property(machine: Machine, offset: int, index: int, getter: bool) -> Result[
    unit,
    VmError,
] {
    let key = field_key(machine, offset, index)?;
    define_accessor_property_with_key(machine, offset, key, getter, true)
}

fn define_computed_accessor_property(machine: Machine, offset: int, getter: bool) -> Result[
    unit,
    VmError,
] {
    let accessor = pop(machine, offset)?;
    let key = property_key(machine, offset, pop(machine, offset)?)?;
    machine.stack.push(accessor);
    define_accessor_property_with_key(machine, offset, key, getter, true)
}

fn define_class_element_with_key(
    machine: Machine,
    offset: int,
    key: runtime::PropertyKey,
    kind: int,
) -> Result[unit, VmError] {
    if kind == 1 {
        define_accessor_property_with_key(machine, offset, key, true, false)
    } else if kind == 2 {
        define_accessor_property_with_key(machine, offset, key, false, false)
    } else {
        let method = pop(machine, offset)?;
        let target = match pop(machine, offset)? {
            runtime::Value::Object(value) => value,
            _ => return Result::Err(
                error(offset, VmErrorKind::TypeError("class method target is not an object")),
            ),
        };
        match method {
            runtime::Value::Object(value) => if !value.is_callable() {
                return Result::Err(
                    error(offset, VmErrorKind::TypeError("class method is not callable")),
                )
            } else {},
            _ => return Result::Err(
                error(offset, VmErrorKind::TypeError("class method is not callable")),
            ),
        };
        match method {
            runtime::Value::Object(value) => match machine.functions.get(value) {
                Some(closure) => closure.home_object.set(Option::Some(target)),
                None => (),
            },
            _ => (),
        };
        if runtime::define_own_property(
            machine.heap,
            target,
            key,
            runtime::data_descriptor(method, true, false, true),
        ) {
            Result::Ok(())
        } else {
            Result::Err(error(offset, VmErrorKind::TypeError("cannot define class method")))
        }
    }
}

fn define_class_element(machine: Machine, offset: int, index: int, kind: int) -> Result[
    unit,
    VmError,
] {
    let key = field_key(machine, offset, index)?;
    define_class_element_with_key(machine, offset, key, kind)
}

fn define_computed_class_element(machine: Machine, offset: int, kind: int) -> Result[unit, VmError] {
    let method = pop(machine, offset)?;
    let key = property_key(machine, offset, pop(machine, offset)?)?;
    machine.stack.push(method);
    define_class_element_with_key(machine, offset, key, kind)
}

fn callable_constructor(machine: Machine, object: runtime::ObjectId) -> bool {
    if !machine.heap.contains(object) || !object.is_callable() {
        false
    } else {
        match machine.functions.get(object) {
            Some(closure) => closure.function.get().constructable(),
            None => if machine.native_constructors.contains(object) {
                true
            } else {
                match machine.bound_functions.get(object) {
                    Some(bound) => match bound.target {
                        runtime::Value::Object(target) => callable_constructor(machine, target),
                        _ => false,
                    },
                    None => false,
                }
            },
        }
    }
}

fn bound_arguments(bound: BoundFunction, arguments: Vec[runtime::Value]) -> Vec[runtime::Value] {
    let combined: Vec[runtime::Value] = Vec::with_capacity(bound.arguments.len() + arguments.len());
    for value in bound.arguments {
        combined.push(value)
    }
    for value in arguments {
        combined.push(value)
    }
    combined
}

fn set_class_heritage(machine: Machine, offset: int, derived: bool) -> Result[unit, VmError] {
    let heritage = pop(machine, offset)?;
    let class = match pop(machine, offset)? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("class value is not an object")),
        ),
    };
    match machine.functions.get(class) {
        Some(closure) => closure.home_object.set(Option::Some(class)),
        None => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("class constructor is not a source function")),
            )
        },
    };
    if !derived {
        return Result::Ok(())
    } else {};
    match heritage {
        runtime::Value::Null => {
            let prototype = match read_object_property(
                machine,
                offset,
                class,
                runtime::Value::Object(class),
                runtime::string_property_key("prototype"),
            )? {
                runtime::Value::Object(value) => value,
                _ => return Result::Err(
                    error(offset, VmErrorKind::TypeError("class prototype is not an object")),
                ),
            };
            if runtime::set_prototype_of(machine.heap, prototype, Option::None) {
                Result::Ok(())
            } else {
                Result::Err(error(offset, VmErrorKind::TypeError("cannot set class prototype")))
            }
        },
        runtime::Value::Object(base) => {
            if !callable_constructor(machine, base) {
                return Result::Err(
                    error(offset, VmErrorKind::TypeError("class heritage is not a constructor")),
                )
            } else {};
            let base_prototype = match read_object_property(
                machine,
                offset,
                base,
                heritage,
                runtime::string_property_key("prototype"),
            )? {
                runtime::Value::Object(value) => Option::Some(value),
                runtime::Value::Null => Option::None,
                _ => return Result::Err(
                    error(
                        offset,
                        VmErrorKind::TypeError("class heritage prototype is not an object or null"),
                    ),
                ),
            };
            let prototype = match read_object_property(
                machine,
                offset,
                class,
                runtime::Value::Object(class),
                runtime::string_property_key("prototype"),
            )? {
                runtime::Value::Object(value) => value,
                _ => return Result::Err(
                    error(offset, VmErrorKind::TypeError("class prototype is not an object")),
                ),
            };
            if !runtime::set_prototype_of(machine.heap, class, Option::Some(base))
                || !runtime::set_prototype_of(machine.heap, prototype, base_prototype) {
                Result::Err(error(offset, VmErrorKind::TypeError("cannot set class heritage")))
            } else {
                Result::Ok(())
            }
        },
        _ => Result::Err(
            error(offset, VmErrorKind::TypeError("class heritage is not a constructor")),
        ),
    }
}

fn source_function_closure(machine: Machine, offset: int, value: runtime::Value) -> Result[
    Closure,
    VmError,
] {
    match value {
        runtime::Value::Object(object) => match machine.functions.get(object) {
            Some(closure) => Result::Ok(closure),
            None => Result::Err(
                error(offset, VmErrorKind::TypeError("value is not a source function")),
            ),
        },
        _ => Result::Err(error(offset, VmErrorKind::TypeError("value is not a source function"))),
    }
}

fn set_function_home_object(machine: Machine, offset: int) -> Result[unit, VmError] {
    let function = pop(machine, offset)?;
    let home = match pop(machine, offset)? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("home value is not an object")),
        ),
    };
    let closure = source_function_closure(machine, offset, function)?;
    closure.home_object.set(Option::Some(home));
    machine.stack.push(function);
    Result::Ok(())
}

fn set_class_instance_initializer(machine: Machine, offset: int) -> Result[unit, VmError] {
    let initializer = pop(machine, offset)?;
    let home = match pop(machine, offset)? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("home value is not an object")),
        ),
    };
    let class = match pop(machine, offset)? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("class value is not an object")),
        ),
    };
    let initializer_object = match initializer {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("class initializer is not a function")),
        ),
    };
    let initializer_closure = source_function_closure(machine, offset, initializer)?;
    initializer_closure.home_object.set(Option::Some(home));
    match machine.functions.get(class) {
        Some(closure) => {
            closure.instance_initializer.set(Option::Some(initializer_object));
            Result::Ok(())
        },
        None => Result::Err(
            error(offset, VmErrorKind::TypeError("class constructor is not a source function")),
        ),
    }
}

fn private_object(offset: int, value: runtime::Value, message: string) -> Result[
    runtime::ObjectId,
    VmError,
] {
    match value {
        runtime::Value::Object(object) => Result::Ok(object),
        _ => Result::Err(error(offset, VmErrorKind::TypeError(message))),
    }
}

fn private_callable(machine: Machine, offset: int, value: runtime::Value) -> Result[unit, VmError] {
    match value {
        runtime::Value::Object(object) => if object.is_callable() {
            Result::Ok(())
        } else {
            Result::Err(error(offset, VmErrorKind::TypeError("private method is not callable")))
        },
        _ => Result::Err(error(offset, VmErrorKind::TypeError("private method is not callable"))),
    }
}

fn define_this_private_element(machine: Machine, offset: int, kind: int) -> Result[unit, VmError] {
    let value = pop(machine, offset)?;
    let name = private_object(offset, pop(machine, offset)?, "invalid private name")?;
    let receiver = private_object(
        offset,
        current_this(machine, offset)?,
        "private element receiver is not an object",
    )?;
    let defined = if kind == 0 {
        runtime::define_private_field(machine.heap, receiver, name, value)
    } else if kind == 1 {
        private_callable(machine, offset, value)?;
        runtime::define_private_method(machine.heap, receiver, name, value)
    } else if kind == 2 {
        private_callable(machine, offset, value)?;
        runtime::define_private_accessor(machine.heap, receiver, name, value, true)
    } else {
        private_callable(machine, offset, value)?;
        runtime::define_private_accessor(machine.heap, receiver, name, value, false)
    };
    if defined {
        Result::Ok(())
    } else {
        Result::Err(error(offset, VmErrorKind::TypeError("cannot define private element")))
    }
}

fn read_private_element(
    machine: Machine,
    offset: int,
    receiver_value: runtime::Value,
    name_value: runtime::Value,
) -> Result[runtime::Value, VmError] {
    let receiver = private_object(
        offset,
        receiver_value,
        "private element receiver is not an object",
    )?;
    let name = private_object(offset, name_value, "invalid private name")?;
    match runtime::private_element(machine.heap, receiver, name) {
        Some(runtime::PrivateElement::Field(value)) | Some(runtime::PrivateElement::Method(value)) => Result::Ok(
            value,
        ),
        Some(runtime::PrivateElement::Accessor { get: Some(getter), .. }) => {
            call_value(machine, offset, getter, Vec::[], receiver_value)
        },
        Some(runtime::PrivateElement::Accessor { get: None, .. }) => {
            Result::Ok(runtime::Value::Undefined)
        },
        None => Result::Err(
            error(offset, VmErrorKind::TypeError("object does not have the private element")),
        ),
    }
}

fn write_private_element(
    machine: Machine,
    offset: int,
    receiver_value: runtime::Value,
    name_value: runtime::Value,
    value: runtime::Value,
) -> Result[unit, VmError] {
    let receiver = private_object(
        offset,
        receiver_value,
        "private element receiver is not an object",
    )?;
    let name = private_object(offset, name_value, "invalid private name")?;
    match runtime::private_element(machine.heap, receiver, name) {
        Some(runtime::PrivateElement::Field(_)) => if runtime::set_private_field(
            machine.heap,
            receiver,
            name,
            value,
        ) {
            Result::Ok(())
        } else {
            Result::Err(error(offset, VmErrorKind::TypeError("cannot set private field")))
        },
        Some(runtime::PrivateElement::Accessor { set: Some(setter), .. }) => {
            let _ = call_value(machine, offset, setter, Vec::[value], receiver_value)?;
            Result::Ok(())
        },
        Some(runtime::PrivateElement::Accessor { set: None, .. }) | Some(runtime::PrivateElement::Method(_)) => Result::Err(
            error(offset, VmErrorKind::TypeError("private element is not writable")),
        ),
        None => Result::Err(
            error(offset, VmErrorKind::TypeError("object does not have the private element")),
        ),
    }
}

fn define_this_field_with_key(machine: Machine, offset: int, key: runtime::PropertyKey) -> Result[
    unit,
    VmError,
] {
    let value = pop(machine, offset)?;
    let receiver = match current_this(machine, offset)? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("field receiver is not an object")),
        ),
    };
    if runtime::define_own_property(
        machine.heap,
        receiver,
        key,
        runtime::data_descriptor(value, true, true, true),
    ) {
        Result::Ok(())
    } else {
        Result::Err(error(offset, VmErrorKind::TypeError("cannot define class field")))
    }
}

fn define_this_field(machine: Machine, offset: int, index: int) -> Result[unit, VmError] {
    let key = field_key(machine, offset, index)?;
    define_this_field_with_key(machine, offset, key)
}

fn define_computed_this_field(machine: Machine, offset: int) -> Result[unit, VmError] {
    let value = pop(machine, offset)?;
    let key = property_key(machine, offset, pop(machine, offset)?)?;
    machine.stack.push(value);
    define_this_field_with_key(machine, offset, key)
}

fn initialize_instance_fields(machine: Machine, offset: int) -> Result[unit, VmError] {
    match machine.instance_initializer.get() {
        Some(initializer) => {
            let receiver = current_this(machine, offset)?;
            let _ = call_value(
                machine,
                offset,
                runtime::Value::Object(initializer),
                Vec::[],
                receiver,
            )?;
            Result::Ok(())
        },
        None => Result::Ok(()),
    }
}

fn excluded_property(key: runtime::PropertyKey, excluded: Vec[runtime::PropertyKey]) -> bool {
    for value in excluded {
        if value == key {
            return true
        } else {}
    }
    false
}

fn copy_data_properties_value(
    machine: Machine,
    offset: int,
    target_value: runtime::Value,
    source: runtime::Value,
    excluded: Vec[runtime::PropertyKey],
    reject_nullish: bool,
) -> Result[unit, VmError] {
    let target = match target_value {
        runtime::Value::Object(value) => value,
        _ => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("object spread target is not an object")),
            )
        },
    };
    match source {
        runtime::Value::Object(source_object) => {
            for key in proxy_own_keys(machine, offset, source_object)? {
                if excluded_property(key, excluded) {} else {
                    match own_property_enumerable(machine, offset, source_object, key)? {
                        Some(enumerable) => if enumerable {
                            let value = read_object_property(
                                machine,
                                offset,
                                source_object,
                                source,
                                key,
                            )?;
                            define_copied_property(machine, offset, target, key, value)?
                        } else {},
                        None => (),
                    }
                }
            }
        },
        runtime::Value::String(value) => {
            let mut index = 0;
            while index < value.len() {
                let key = runtime::string_property_key(index.to_string());
                if excluded_property(key, excluded) {} else {
                    define_copied_property(
                        machine,
                        offset,
                        target,
                        key,
                        runtime::Value::String(
                            runtime::JsString::from_code_units(Vec::[value.get(index)]),
                        ),
                    )?;
                };
                index += 1;
            }
        },
        runtime::Value::Undefined | runtime::Value::Null => if reject_nullish {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("cannot destructure null or undefined")),
            )
        } else {},
        runtime::Value::Bool(_) | runtime::Value::Int(_) | runtime::Value::Float(_) | runtime::Value::BigInt(_) | runtime::Value::Symbol(_) => (),
    };
    machine.stack.push(target_value);
    Result::Ok(())
}

fn copy_data_properties(machine: Machine, offset: int) -> Result[unit, VmError] {
    let source = pop(machine, offset)?;
    let target = pop(machine, offset)?;
    copy_data_properties_value(machine, offset, target, source, Vec::[], false)
}

fn copy_data_properties_excluded(machine: Machine, offset: int, count: int) -> Result[unit, VmError] {
    if count < 0 {
        return Result::Err(error(offset, VmErrorKind::UnsupportedInstruction))
    } else {};
    let excluded: Vec[runtime::PropertyKey] = Vec::with_capacity(count);
    for _ in 0..count {
        excluded.push(property_key(machine, offset, pop(machine, offset)?)?)
    }
    let source = pop(machine, offset)?;
    let target = pop(machine, offset)?;
    copy_data_properties_value(machine, offset, target, source, excluded, true)
}

fn write_property(
    machine: Machine,
    offset: int,
    receiver: runtime::Value,
    key: runtime::PropertyKey,
    value: runtime::Value,
) -> Result[unit, VmError] {
    match receiver {
        runtime::Value::Object(object) => {
            write_object_property(machine, offset, object, receiver, key, value)
        },
        runtime::Value::Undefined | runtime::Value::Null => Result::Err(
            error(offset, VmErrorKind::TypeError("cannot assign property of null or undefined")),
        ),
        _ => if machine.function.strict() {
            Result::Err(
                error(offset, VmErrorKind::TypeError("cannot assign property of a primitive")),
            )
        } else {
            Result::Ok(())
        },
    }
}

fn reflect_target(offset: int, value: runtime::Value) -> Result[runtime::ObjectId, VmError] {
    match value {
        runtime::Value::Object(value) => Result::Ok(value),
        _ => Result::Err(error(offset, VmErrorKind::TypeError("Reflect target is not an object"))),
    }
}

fn vm_descriptor_object(machine: Machine, offset: int, descriptor: runtime::PropertyDescriptor) -> Result[
    runtime::Value,
    VmError,
] {
    let object = match runtime::new_null_prototype_object(machine.heap) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    let values: Vec[(string, runtime::Value)] = Vec::[];
    match runtime::descriptor_value(descriptor) {
        Some(value) => {
            values.push(("value", value));
            values.push(
                ("writable", runtime::Value::Bool(runtime::descriptor_writable(descriptor))),
            )
        },
        None => {
            values.push(
                (
                    "get",
                    match runtime::descriptor_get(descriptor) {
                        Some(value) => value,
                        None => runtime::Value::Undefined,
                    },
                ),
            );
            values.push(
                (
                    "set",
                    match runtime::descriptor_set(descriptor) {
                        Some(value) => value,
                        None => runtime::Value::Undefined,
                    },
                ),
            )
        },
    };
    values.push(("enumerable", runtime::Value::Bool(runtime::descriptor_enumerable(descriptor))));
    values.push(
        ("configurable", runtime::Value::Bool(runtime::descriptor_configurable(descriptor))),
    );
    for (name, value) in values {
        if !runtime::define_own_property(
            machine.heap,
            object,
            runtime::string_property_key(name),
            runtime::data_descriptor(value, true, true, true),
        ) {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("cannot create property descriptor")),
            )
        } else {}
    }
    Result::Ok(runtime::Value::Object(object))
}

fn define_receiver_property(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
    descriptor: runtime::PropertyDescriptor,
) -> Result[bool, VmError] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "defineProperty")? {
            Some(trap) => {
                let result = runtime::to_boolean(
                    call_value(
                        machine,
                        offset,
                        trap,
                        Vec::[
                            runtime::Value::Object(target),
                            property_key_runtime_value(key),
                            vm_descriptor_object(machine, offset, descriptor)?,
                        ],
                        runtime::Value::Object(handler),
                    )?,
                );
                if !result {
                    return Result::Ok(false)
                } else {};
                let target_object = match machine.heap.get(target) {
                    Some(value) => value,
                    None => return Result::Err(
                        error(offset, VmErrorKind::TypeError("proxy target is invalid")),
                    ),
                };
                let current = target_object.own_property(key);
                if !runtime::compatible_property_descriptor(
                    target_object.extensible(),
                    descriptor,
                    current,
                ) {
                    return Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError(
                                "proxy defineProperty trap accepted an incompatible descriptor",
                            ),
                        ),
                    )
                } else {};
                if !runtime::descriptor_configurable(descriptor) {
                    match current {
                        Some(value) => if runtime::descriptor_configurable(value) {
                            return Result::Err(
                                error(
                                    offset,
                                    VmErrorKind::TypeError(
                                        "proxy defineProperty trap violated the target",
                                    ),
                                ),
                            )
                        } else {},
                        None => return Result::Err(
                            error(
                                offset,
                                VmErrorKind::TypeError(
                                    "proxy defineProperty trap violated the target",
                                ),
                            ),
                        ),
                    }
                } else {};
                Result::Ok(true)
            },
            None => define_receiver_property(machine, offset, target, key, descriptor),
        },
        None => Result::Ok(runtime::define_own_property(machine.heap, object, key, descriptor)),
    }
}

fn reflect_set_property(
    machine: Machine,
    offset: int,
    target: runtime::ObjectId,
    receiver: runtime::Value,
    key: runtime::PropertyKey,
    value: runtime::Value,
) -> Result[bool, VmError] {
    match proxy_parts(machine, offset, target)? {
        Some((proxy_target, handler)) => match proxy_trap(machine, offset, handler, "set")? {
            Some(trap) => {
                let result = runtime::to_boolean(
                    call_value(
                        machine,
                        offset,
                        trap,
                        Vec::[
                            runtime::Value::Object(proxy_target),
                            property_key_runtime_value(key),
                            value,
                            receiver,
                        ],
                        runtime::Value::Object(handler),
                    )?,
                );
                if result {
                    validate_proxy_set(machine, offset, proxy_target, key, value)?
                } else {};
                return Result::Ok(result)
            },
            None => return reflect_set_property(machine, offset, proxy_target, receiver, key, value),
        },
        None => (),
    };
    if runtime::is_typed_array_numeric_property(machine.heap, target, key) {
        match receiver {
            runtime::Value::Object(receiver_object) => if receiver_object == target {
                let converted = if runtime::is_bigint_typed_array(machine.heap, target) {
                    runtime::Value::BigInt(bigint_value(machine, offset, value)?)
                } else {
                    runtime::Value::Float(number(machine, offset, value)?)
                };
                return match runtime::set_property(machine.heap, target, key, converted) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => {
                        Result::Err(error(offset, VmErrorKind::TypeError(value.message)))
                    },
                }
            } else if !runtime::is_typed_array_valid_numeric_property(machine.heap, target, key) {
                return Result::Ok(true)
            } else {},
            _ => if !runtime::is_typed_array_valid_numeric_property(machine.heap, target, key) {
                return Result::Ok(true)
            } else {},
        }
    } else {};
    let descriptor = match runtime::get_property_descriptor(machine.heap, target, key) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    match descriptor {
        Some(runtime::PropertyDescriptor::Accessor { set, .. }) => match set {
            Some(setter) => {
                let _ = call_value(machine, offset, setter, Vec::[value], receiver)?;
                return Result::Ok(true)
            },
            None => return Result::Ok(false),
        },
        Some(descriptor) => if !runtime::descriptor_writable(descriptor) {
            return Result::Ok(false)
        } else {},
        None => (),
    };
    let receiver = match receiver {
        runtime::Value::Object(value) => value,
        _ => return Result::Ok(false),
    };
    let own = match machine.heap.get(receiver) {
        Some(value) => value.own_property(key),
        None => return Result::Err(error(offset, VmErrorKind::TypeError("receiver is invalid"))),
    };
    let next = match own {
        Some(descriptor) => if runtime::descriptor_is_data(descriptor)
            && runtime::descriptor_writable(descriptor) {
            runtime::data_descriptor(
                value,
                true,
                runtime::descriptor_enumerable(descriptor),
                runtime::descriptor_configurable(descriptor),
            )
        } else {
            return Result::Ok(false)
        },
        None => runtime::data_descriptor(value, true, true, true),
    };
    define_receiver_property(machine, offset, receiver, key, next)
}

fn push_reflect_get(machine: Machine, offset: int) -> Result[unit, VmError] {
    let receiver = pop(machine, offset)?;
    let key = property_key(machine, offset, pop(machine, offset)?)?;
    let target_value = pop(machine, offset)?;
    let target = reflect_target(offset, target_value)?;
    machine.stack.push(read_object_property(machine, offset, target, receiver, key)?);
    Result::Ok(())
}

fn push_reflect_set(machine: Machine, offset: int) -> Result[unit, VmError] {
    let receiver = pop(machine, offset)?;
    let value = pop(machine, offset)?;
    let key = property_key(machine, offset, pop(machine, offset)?)?;
    let target = reflect_target(offset, pop(machine, offset)?)?;
    machine.stack.push(
        runtime::Value::Bool(reflect_set_property(machine, offset, target, receiver, key, value)?),
    );
    Result::Ok(())
}

fn delete_property(
    machine: Machine,
    offset: int,
    receiver: runtime::Value,
    key: runtime::PropertyKey,
) -> Result[runtime::Value, VmError] {
    match receiver {
        runtime::Value::Object(object) => {
            match proxy_parts(machine, offset, object)? {
                Some((target, handler)) => match proxy_trap(
                    machine,
                    offset,
                    handler,
                    "deleteProperty",
                )? {
                    Some(trap) => {
                        let result = call_value(
                            machine,
                            offset,
                            trap,
                            Vec::[runtime::Value::Object(target), property_key_runtime_value(key)],
                            runtime::Value::Object(handler),
                        )?;
                        let deleted = runtime::to_boolean(result);
                        if deleted {
                            match proxy_target_descriptor(machine, offset, target, key)? {
                                Some(descriptor) => {
                                    let target_object = match machine.heap.get(target) {
                                        Some(value) => value,
                                        None => return Result::Err(
                                            error(
                                                offset,
                                                VmErrorKind::TypeError("proxy target is invalid"),
                                            ),
                                        ),
                                    };
                                    if !runtime::descriptor_configurable(descriptor)
                                        || !target_object.extensible() {
                                        return Result::Err(
                                            error(
                                                offset,
                                                VmErrorKind::TypeError(
                                                    "proxy deleteProperty trap violated the target",
                                                ),
                                            ),
                                        )
                                    } else {}
                                },
                                None => (),
                            };
                            return Result::Ok(runtime::Value::Bool(deleted))
                        } else if !machine.function.strict() {
                            return Result::Ok(runtime::Value::Bool(false))
                        } else {
                            return Result::Err(
                                error(
                                    offset,
                                    VmErrorKind::TypeError(
                                        "proxy deleteProperty trap returned false",
                                    ),
                                ),
                            )
                        }
                    },
                    None => {
                        let deleted = runtime::delete_property(machine.heap, target, key);
                        if deleted || !machine.function.strict() {
                            return Result::Ok(runtime::Value::Bool(deleted))
                        } else {
                            return Result::Err(
                                error(
                                    offset,
                                    VmErrorKind::TypeError("property is not configurable"),
                                ),
                            )
                        }
                    },
                },
                None => (),
            };
            let deleted = runtime::delete_property(machine.heap, object, key);
            if deleted || !machine.function.strict() {
                Result::Ok(runtime::Value::Bool(deleted))
            } else {
                Result::Err(error(offset, VmErrorKind::TypeError("property is not configurable")))
            }
        },
        runtime::Value::String(value) => if property_name(key, "length") {
            if machine.function.strict() {
                Result::Err(error(offset, VmErrorKind::TypeError("property is not configurable")))
            } else {
                Result::Ok(runtime::Value::Bool(false))
            }
        } else {
            match string_property_index(key) {
                Some(index) => if index < value.len() && machine.function.strict() {
                    Result::Err(
                        error(offset, VmErrorKind::TypeError("property is not configurable")),
                    )
                } else {
                    Result::Ok(runtime::Value::Bool(index >= value.len()))
                },
                None => Result::Ok(runtime::Value::Bool(true)),
            }
        },
        runtime::Value::Undefined | runtime::Value::Null => Result::Err(
            error(offset, VmErrorKind::TypeError("cannot delete property of null or undefined")),
        ),
        _ => Result::Ok(runtime::Value::Bool(true)),
    }
}

fn has_property(machine: Machine, offset: int, object: runtime::ObjectId, key: runtime::PropertyKey) -> Result[
    bool,
    VmError,
] {
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "has")? {
            Some(trap) => {
                let result = runtime::to_boolean(
                    call_value(
                        machine,
                        offset,
                        trap,
                        Vec::[runtime::Value::Object(target), property_key_runtime_value(key)],
                        runtime::Value::Object(handler),
                    )?,
                );
                if !result {
                    match proxy_target_descriptor(machine, offset, target, key)? {
                        Some(descriptor) => {
                            let target_object = match machine.heap.get(target) {
                                Some(value) => value,
                                None => return Result::Err(
                                    error(offset, VmErrorKind::TypeError("proxy target is invalid")),
                                ),
                            };
                            if !runtime::descriptor_configurable(descriptor)
                                || !target_object.extensible() {
                                return Result::Err(
                                    error(
                                        offset,
                                        VmErrorKind::TypeError("proxy has trap violated the target"),
                                    ),
                                )
                            } else {}
                        },
                        None => (),
                    }
                } else {};
                Result::Ok(result)
            },
            None => has_property(machine, offset, target, key),
        },
        None => match runtime::get_property_descriptor(machine.heap, object, key) {
            Ok(value) => Result::Ok(value.is_some()),
            Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
        },
    }
}

fn to_uint32(value: float64) -> uint32 {
    if !math::is_finite(value) || value == 0.0 {
        0
    } else {
        let integer = math::trunc(value);
        let mut remaining = integer - math::floor(integer / 4294967296.0) * 4294967296.0;
        let mut place = 2147483648.0;
        let mut mask: uint32 = 0x80000000;
        let mut result: uint32 = 0;
        while mask != 0 {
            if remaining >= place {
                result = result | mask;
                remaining -= place;
            } else {};
            place /= 2.0;
            mask >>= 1;
        }
        result
    }
}

fn to_int32(value: float64) -> int32 {
    to_uint32(value).to_int32()
}

fn uint32_number(value: uint32) -> float64 {
    num::parse_float64(value.to_string()).unwrap_or(0.0)
}

fn remainder(left: float64, right: float64) -> float64 {
    if math::is_nan(left) || math::is_nan(right) || math::is_infinite(left) || right == 0.0 {
        runtime::primitive_to_number(runtime::Value::Undefined).unwrap_or(0.0)
    } else if math::is_infinite(right) {
        left
    } else {
        left - math::trunc(left / right) * right
    }
}

fn compare_strings(left: runtime::JsString, right: runtime::JsString) -> int {
    let mut index = 0;
    let common = if left.len() < right.len() {
        left.len()
    } else {
        right.len()
    };
    while index < common {
        if left.get(index) < right.get(index) {
            return -1
        } else if left.get(index) > right.get(index) {
            return 1
        } else {};
        index += 1;
    }
    if left.len() < right.len() {
        -1
    } else if left.len() > right.len() {
        1
    } else {
        0
    }
}

fn compare_bigint_number(value: runtime::BigInt, number: float64) -> Option[int] {
    if math::is_nan(number) {
        Option::None
    } else if math::is_infinite(number) {
        Option::Some(
            if number < 0.0 {
                1
            } else {
                -1
            },
        )
    } else {
        let truncated = math::trunc(number);
        let converted = match runtime::integral_number_to_bigint(truncated) {
            Ok(value) => value,
            Err(_) => return Option::None,
        };
        let comparison = value.compare(converted);
        if comparison != 0 || truncated == number {
            Option::Some(comparison)
        } else if number > 0.0 {
            Option::Some(-1)
        } else {
            Option::Some(1)
        }
    }
}

fn equal_bigint_number(value: runtime::BigInt, number: float64) -> bool {
    if !math::is_finite(number) || math::trunc(number) != number {
        false
    } else {
        match runtime::integral_number_to_bigint(number) {
            Ok(converted) => value == converted,
            Err(_) => false,
        }
    }
}

fn bigint_count(offset: int, value: runtime::BigInt, limit: int, operation: string) -> Result[
    int,
    VmError,
] {
    if value.limb_count() != 1 {
        return Result::Err(
            error(offset, VmErrorKind::RangeError(operation + " exceeds implementation limit")),
        )
    } else {};
    let magnitude = value.limbs()[0].to_int();
    if magnitude > limit {
        Result::Err(
            error(offset, VmErrorKind::RangeError(operation + " exceeds implementation limit")),
        )
    } else if value.negative() {
        Result::Ok(-magnitude)
    } else {
        Result::Ok(magnitude)
    }
}

fn less_than(machine: Machine, offset: int, left: runtime::Value, right: runtime::Value) -> Result[
    bool,
    VmError,
] {
    let left = to_primitive(machine, offset, left, PrimitiveHint::Number)?;
    let right = to_primitive(machine, offset, right, PrimitiveHint::Number)?;
    match (left, right) {
        (runtime::Value::String(left), runtime::Value::String(right)) => {
            Result::Ok(compare_strings(left, right) < 0)
        },
        (runtime::Value::BigInt(left), runtime::Value::String(right)) => {
            Result::Ok(
                match runtime::string_to_bigint(right) {
                    Ok(value) => left.compare(value) < 0,
                    Err(_) => false,
                },
            )
        },
        (runtime::Value::String(left), runtime::Value::BigInt(right)) => {
            Result::Ok(
                match runtime::string_to_bigint(left) {
                    Ok(value) => value.compare(right) < 0,
                    Err(_) => false,
                },
            )
        },
        (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => {
            Result::Ok(left.compare(right) < 0)
        },
        (runtime::Value::BigInt(left), right) => {
            let right = number(machine, offset, right)?;
            Result::Ok(
                match compare_bigint_number(left, right) {
                    Some(value) => value < 0,
                    None => false,
                },
            )
        },
        (left, runtime::Value::BigInt(right)) => {
            let left = number(machine, offset, left)?;
            Result::Ok(
                match compare_bigint_number(right, left) {
                    Some(value) => value > 0,
                    None => false,
                },
            )
        },
        _ => {
            let left_number = number(machine, offset, left)?;
            let right_number = number(machine, offset, right)?;
            Result::Ok(
                !math::is_nan(left_number) && !math::is_nan(right_number)
                    && left_number < right_number,
            )
        },
    }
}

fn less_than_or_equal(machine: Machine, offset: int, left: runtime::Value, right: runtime::Value) -> Result[
    bool,
    VmError,
] {
    let left = to_primitive(machine, offset, left, PrimitiveHint::Number)?;
    let right = to_primitive(machine, offset, right, PrimitiveHint::Number)?;
    match (left, right) {
        (runtime::Value::String(left), runtime::Value::String(right)) => {
            Result::Ok(compare_strings(left, right) <= 0)
        },
        (runtime::Value::BigInt(left), runtime::Value::String(right)) => {
            Result::Ok(
                match runtime::string_to_bigint(right) {
                    Ok(value) => left.compare(value) <= 0,
                    Err(_) => false,
                },
            )
        },
        (runtime::Value::String(left), runtime::Value::BigInt(right)) => {
            Result::Ok(
                match runtime::string_to_bigint(left) {
                    Ok(value) => value.compare(right) <= 0,
                    Err(_) => false,
                },
            )
        },
        (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => {
            Result::Ok(left.compare(right) <= 0)
        },
        (runtime::Value::BigInt(left), right) => {
            let right = number(machine, offset, right)?;
            Result::Ok(
                match compare_bigint_number(left, right) {
                    Some(value) => value <= 0,
                    None => false,
                },
            )
        },
        (left, runtime::Value::BigInt(right)) => {
            let left = number(machine, offset, left)?;
            Result::Ok(
                match compare_bigint_number(right, left) {
                    Some(value) => value >= 0,
                    None => false,
                },
            )
        },
        _ => {
            let left_number = number(machine, offset, left)?;
            let right_number = number(machine, offset, right)?;
            Result::Ok(
                !math::is_nan(left_number) && !math::is_nan(right_number)
                    && left_number <= right_number,
            )
        },
    }
}

fn abstract_equal(machine: Machine, offset: int, left: runtime::Value, right: runtime::Value) -> Result[
    bool,
    VmError,
] {
    match (left, right) {
        (runtime::Value::Undefined, runtime::Value::Null) | (
            runtime::Value::Null,
            runtime::Value::Undefined,
        ) => Result::Ok(true),
        (runtime::Value::Bool(value), other) => {
            abstract_equal(
                machine,
                offset,
                runtime::Value::Int(
                    if value {
                        1
                    } else {
                        0
                    },
                ),
                other,
            )
        },
        (other, runtime::Value::Bool(value)) => {
            abstract_equal(
                machine,
                offset,
                other,
                runtime::Value::Int(
                    if value {
                        1
                    } else {
                        0
                    },
                ),
            )
        },
        (runtime::Value::BigInt(left), runtime::Value::String(right)) => {
            Result::Ok(
                match runtime::string_to_bigint(right) {
                    Ok(value) => left == value,
                    Err(_) => false,
                },
            )
        },
        (runtime::Value::String(left), runtime::Value::BigInt(right)) => {
            Result::Ok(
                match runtime::string_to_bigint(left) {
                    Ok(value) => value == right,
                    Err(_) => false,
                },
            )
        },
        (runtime::Value::BigInt(left), runtime::Value::Int(right)) => {
            Result::Ok(left == runtime::BigInt::from_int64(right.to_int64()))
        },
        (runtime::Value::Int(left), runtime::Value::BigInt(right)) => {
            Result::Ok(runtime::BigInt::from_int64(left.to_int64()) == right)
        },
        (runtime::Value::BigInt(left), runtime::Value::Float(right)) => {
            Result::Ok(equal_bigint_number(left, right))
        },
        (runtime::Value::Float(left), runtime::Value::BigInt(right)) => {
            Result::Ok(equal_bigint_number(right, left))
        },
        (runtime::Value::String(left), runtime::Value::Int(_)) | (
            runtime::Value::String(left),
            runtime::Value::Float(_),
        ) => {
            let converted = number(machine, offset, runtime::Value::String(left))?;
            Result::Ok(runtime::strict_equal(runtime::Value::Float(converted), right))
        },
        (runtime::Value::Int(_), runtime::Value::String(right)) | (
            runtime::Value::Float(_),
            runtime::Value::String(right),
        ) => {
            let converted = number(machine, offset, runtime::Value::String(right))?;
            Result::Ok(runtime::strict_equal(left, runtime::Value::Float(converted)))
        },
        (runtime::Value::Object(_), runtime::Value::String(_)) | (
            runtime::Value::Object(_),
            runtime::Value::Int(_),
        ) | (runtime::Value::Object(_), runtime::Value::Float(_)) | (
            runtime::Value::Object(_),
            runtime::Value::BigInt(_),
        ) | (runtime::Value::Object(_), runtime::Value::Symbol(_)) => {
            let primitive = to_primitive(machine, offset, left, PrimitiveHint::Default)?;
            abstract_equal(machine, offset, primitive, right)
        },
        (runtime::Value::String(_), runtime::Value::Object(_)) | (
            runtime::Value::Int(_),
            runtime::Value::Object(_),
        ) | (runtime::Value::Float(_), runtime::Value::Object(_)) | (
            runtime::Value::BigInt(_),
            runtime::Value::Object(_),
        ) | (runtime::Value::Symbol(_), runtime::Value::Object(_)) => {
            let primitive = to_primitive(machine, offset, right, PrimitiveHint::Default)?;
            abstract_equal(machine, offset, left, primitive)
        },
        _ => Result::Ok(runtime::strict_equal(left, right)),
    }
}

fn push_numeric_binary(machine: Machine, offset: int, instruction: bytecode::Instruction) -> Result[
    unit,
    VmError,
] {
    let right_source = pop(machine, offset)?;
    let left_source = pop(machine, offset)?;
    let left_value = to_primitive(machine, offset, left_source, PrimitiveHint::Number)?;
    let right_value = to_primitive(machine, offset, right_source, PrimitiveHint::Number)?;
    match (left_value, right_value) {
        (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => {
            let result = match instruction {
                bytecode::Instruction::Mul => Result::Ok(left.multiply(right)),
                bytecode::Instruction::Div => match left.divide(right) {
                    Ok(value) => Result::Ok(value),
                    Err(_) => Result::Err(
                        error(offset, VmErrorKind::RangeError("BigInt division by zero")),
                    ),
                },
                bytecode::Instruction::Mod => match left.remainder(right) {
                    Ok(value) => Result::Ok(value),
                    Err(_) => Result::Err(
                        error(offset, VmErrorKind::RangeError("BigInt division by zero")),
                    ),
                },
                bytecode::Instruction::Sub => Result::Ok(left.subtract(right)),
                bytecode::Instruction::Pow => {
                    if right.negative() {
                        Result::Err(
                            error(offset, VmErrorKind::RangeError("BigInt negative exponent")),
                        )
                    } else {
                        let exponent = bigint_count(offset, right, 1000000, "BigInt exponent")?;
                        match left.pow(exponent) {
                            Ok(value) => Result::Ok(value),
                            Err(_) => Result::Err(
                                error(offset, VmErrorKind::RangeError("invalid BigInt exponent")),
                            ),
                        }
                    }
                },
                _ => Result::Err(error(offset, VmErrorKind::UnsupportedInstruction)),
            }?;
            machine.stack.push(runtime::Value::BigInt(result));
            return Result::Ok(())
        },
        (runtime::Value::BigInt(_), _) | (_, runtime::Value::BigInt(_)) => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("cannot mix BigInt and Number operands")),
            )
        },
        _ => (),
    };
    let left = number(machine, offset, left_value)?;
    let right = number(machine, offset, right_value)?;
    let result = match instruction {
        bytecode::Instruction::Mul => left * right,
        bytecode::Instruction::Div => left / right,
        bytecode::Instruction::Mod => remainder(left, right),
        bytecode::Instruction::Sub => left - right,
        bytecode::Instruction::Pow => math::pow(left, right),
        _ => return Result::Err(error(offset, VmErrorKind::UnsupportedInstruction)),
    };
    machine.stack.push(runtime::Value::Float(result));
    Result::Ok(())
}

fn push_add(machine: Machine, offset: int) -> Result[unit, VmError] {
    let right_source = pop(machine, offset)?;
    let left_source = pop(machine, offset)?;
    let left = to_primitive(machine, offset, left_source, PrimitiveHint::Default)?;
    let right = to_primitive(machine, offset, right_source, PrimitiveHint::Default)?;
    if is_string(left) || is_string(right) {
        let left_string = primitive_to_string(machine, offset, left)?;
        let right_string = primitive_to_string(machine, offset, right)?;
        machine.stack.push(runtime::Value::String(left_string.concat(right_string)));
        Result::Ok(())
    } else {
        match (left, right) {
            (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => {
                machine.stack.push(runtime::Value::BigInt(left.add(right)));
                Result::Ok(())
            },
            (runtime::Value::BigInt(_), _) | (_, runtime::Value::BigInt(_)) => {
                Result::Err(
                    error(offset, VmErrorKind::TypeError("cannot mix BigInt and Number operands")),
                )
            },
            _ => {
                let left_number = number(machine, offset, left)?;
                let right_number = number(machine, offset, right)?;
                machine.stack.push(runtime::Value::Float(left_number + right_number));
                Result::Ok(())
            },
        }
    }
}

fn push_bitwise_binary(machine: Machine, offset: int, instruction: bytecode::Instruction) -> Result[
    unit,
    VmError,
] {
    let right_source = pop(machine, offset)?;
    let left_source = pop(machine, offset)?;
    let left_value = to_primitive(machine, offset, left_source, PrimitiveHint::Number)?;
    let right_value = to_primitive(machine, offset, right_source, PrimitiveHint::Number)?;
    match (left_value, right_value) {
        (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => {
            let result = match instruction {
                bytecode::Instruction::BitAnd => left.bit_and(right),
                bytecode::Instruction::BitXor => left.bit_xor(right),
                bytecode::Instruction::BitOr => left.bit_or(right),
                _ => return Result::Err(error(offset, VmErrorKind::UnsupportedInstruction)),
            };
            machine.stack.push(runtime::Value::BigInt(result));
            return Result::Ok(())
        },
        (runtime::Value::BigInt(_), _) | (_, runtime::Value::BigInt(_)) => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("cannot mix BigInt and Number operands")),
            )
        },
        _ => (),
    };
    let left = to_int32(number(machine, offset, left_value)?);
    let right = to_int32(number(machine, offset, right_value)?);
    let result = match instruction {
        bytecode::Instruction::BitAnd => left & right,
        bytecode::Instruction::BitXor => left ^ right,
        bytecode::Instruction::BitOr => left | right,
        _ => return Result::Err(error(offset, VmErrorKind::UnsupportedInstruction)),
    };
    machine.stack.push(runtime::Value::Int(result));
    Result::Ok(())
}

fn push_shift(machine: Machine, offset: int, instruction: bytecode::Instruction) -> Result[
    unit,
    VmError,
] {
    let right_source = pop(machine, offset)?;
    let left_source = pop(machine, offset)?;
    let left_value = to_primitive(machine, offset, left_source, PrimitiveHint::Number)?;
    let right_value = to_primitive(machine, offset, right_source, PrimitiveHint::Number)?;
    match (left_value, right_value) {
        (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => {
            if instruction == bytecode::Instruction::Shr {
                return Result::Err(
                    error(offset, VmErrorKind::TypeError("BigInt has no unsigned right shift")),
                )
            } else {};
            let count = bigint_count(offset, right, 100000000, "BigInt shift count")?;
            let result = match instruction {
                bytecode::Instruction::Shl => left.shift_left(count),
                bytecode::Instruction::Sar => left.shift_right(count),
                _ => return Result::Err(error(offset, VmErrorKind::UnsupportedInstruction)),
            };
            match result {
                Ok(value) => machine.stack.push(runtime::Value::BigInt(value)),
                Err(_) => {
                    return Result::Err(
                        error(
                            offset,
                            VmErrorKind::RangeError(
                                "BigInt shift count exceeds implementation limit",
                            ),
                        ),
                    )
                },
            };
            return Result::Ok(())
        },
        (runtime::Value::BigInt(_), _) | (_, runtime::Value::BigInt(_)) => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("cannot mix BigInt and Number operands")),
            )
        },
        _ => (),
    };
    let right = to_uint32(number(machine, offset, right_value)?) & 31;
    match instruction {
        bytecode::Instruction::Shl => {
            let left = to_int32(number(machine, offset, left_value)?);
            machine.stack.push(runtime::Value::Int(left << right));
        },
        bytecode::Instruction::Sar => {
            let left = to_int32(number(machine, offset, left_value)?);
            machine.stack.push(runtime::Value::Int(left >> right));
        },
        bytecode::Instruction::Shr => {
            let left = to_uint32(number(machine, offset, left_value)?);
            machine.stack.push(runtime::Value::Float(uint32_number(left >> right)));
        },
        _ => return Result::Err(error(offset, VmErrorKind::UnsupportedInstruction)),
    };
    Result::Ok(())
}

fn push_comparison(machine: Machine, offset: int, instruction: bytecode::Instruction) -> Result[
    unit,
    VmError,
] {
    let right = pop(machine, offset)?;
    let left = pop(machine, offset)?;
    let result = match instruction {
        bytecode::Instruction::Lt => less_than(machine, offset, left, right)?,
        bytecode::Instruction::Lte => less_than_or_equal(machine, offset, left, right)?,
        bytecode::Instruction::Gt => {
            let left = to_primitive(machine, offset, left, PrimitiveHint::Number)?;
            let right = to_primitive(machine, offset, right, PrimitiveHint::Number)?;
            less_than(machine, offset, right, left)?
        },
        bytecode::Instruction::Gte => {
            let left = to_primitive(machine, offset, left, PrimitiveHint::Number)?;
            let right = to_primitive(machine, offset, right, PrimitiveHint::Number)?;
            less_than_or_equal(machine, offset, right, left)?
        },
        bytecode::Instruction::Eq => abstract_equal(machine, offset, left, right)?,
        bytecode::Instruction::Neq => !abstract_equal(machine, offset, left, right)?,
        bytecode::Instruction::StrictEq => runtime::strict_equal(left, right),
        bytecode::Instruction::StrictNeq => !runtime::strict_equal(left, right),
        _ => return Result::Err(error(offset, VmErrorKind::UnsupportedInstruction)),
    };
    machine.stack.push(runtime::Value::Bool(result));
    Result::Ok(())
}

fn push_in(machine: Machine, offset: int) -> Result[unit, VmError] {
    let right = pop(machine, offset)?;
    let left = pop(machine, offset)?;
    let object = match right {
        runtime::Value::Object(value) => value,
        _ => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("right operand of in is not an object")),
            )
        },
    };
    let key = property_key(machine, offset, left)?;
    let result = has_property(machine, offset, object, key)?;
    machine.stack.push(runtime::Value::Bool(result));
    Result::Ok(())
}

fn push_with_has_binding(machine: Machine, offset: int) -> Result[unit, VmError] {
    let right = pop(machine, offset)?;
    let left = pop(machine, offset)?;
    let object = match right {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("with environment is not an object")),
        ),
    };
    let key = property_key(machine, offset, left)?;
    if !has_property(machine, offset, object, key)? {
        machine.stack.push(runtime::Value::Bool(false));
        return Result::Ok(())
    } else {};
    let global = match machine.global_object {
        Some(value) => value,
        None => {
            machine.stack.push(runtime::Value::Bool(true));
            return Result::Ok(())
        },
    };
    let symbol_object = read_object_property(
        machine,
        offset,
        global,
        runtime::Value::Object(global),
        runtime::string_property_key("Symbol"),
    )?;
    let symbol = match symbol_object {
        runtime::Value::Object(value) => match read_object_property(
            machine,
            offset,
            value,
            runtime::Value::Object(value),
            runtime::string_property_key("unscopables"),
        )? {
            runtime::Value::Symbol(value) => value,
            _ => {
                machine.stack.push(runtime::Value::Bool(true));
                return Result::Ok(())
            },
        },
        _ => {
            machine.stack.push(runtime::Value::Bool(true));
            return Result::Ok(())
        },
    };
    let blocked = match read_object_property(
        machine,
        offset,
        object,
        runtime::Value::Object(object),
        runtime::PropertyKey::Symbol(symbol),
    )? {
        runtime::Value::Object(value) => runtime::to_boolean(
            read_object_property(machine, offset, value, runtime::Value::Object(value), key)?,
        ),
        _ => false,
    };
    machine.stack.push(runtime::Value::Bool(!blocked));
    Result::Ok(())
}

fn ordinary_has_instance(machine: Machine, offset: int, right: runtime::Value, left: runtime::Value) -> Result[
    bool,
    VmError,
] {
    let constructor = match right {
        runtime::Value::Object(value) => if value.is_callable() && machine.heap.contains(value) {
            value
        } else {
            return Result::Ok(false)
        },
        _ => return Result::Ok(false),
    };
    match machine.bound_functions.get(constructor) {
        Some(bound) => return instance_of_value(machine, offset, left, bound.target),
        None => (),
    };
    let object = match left {
        runtime::Value::Object(value) => value,
        _ => return Result::Ok(false),
    };
    let prototype = match read_object_property(
        machine,
        offset,
        constructor,
        right,
        runtime::string_property_key("prototype"),
    )? {
        runtime::Value::Object(value) => value,
        _ => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("constructor prototype is not an object")),
            )
        },
    };
    let mut cursor = proxy_get_prototype_of(machine, offset, object)?;
    while cursor.is_some() {
        match cursor {
            Some(value) => if value == prototype {
                return Result::Ok(true)
            } else {
                cursor = proxy_get_prototype_of(machine, offset, value)?;
            },
            None => (),
        }
    }
    Result::Ok(false)
}

fn instance_of_value(machine: Machine, offset: int, left: runtime::Value, right: runtime::Value) -> Result[
    bool,
    VmError,
] {
    let object = match right {
        runtime::Value::Object(value) => if machine.heap.contains(value) {
            value
        } else {
            return Result::Err(
                error(
                    offset,
                    VmErrorKind::TypeError("right operand of instanceof is not an object"),
                ),
            )
        },
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("right operand of instanceof is not an object")),
        ),
    };
    match machine.has_instance_symbol {
        Some(symbol) => match read_object_property(
            machine,
            offset,
            object,
            right,
            runtime::PropertyKey::Symbol(symbol),
        )? {
            runtime::Value::Undefined | runtime::Value::Null => (),
            method => {
                return Result::Ok(
                    runtime::to_boolean(call_value(machine, offset, method, Vec::[left], right)?),
                )
            },
        },
        None => (),
    };
    if !object.is_callable() {
        Result::Err(
            error(offset, VmErrorKind::TypeError("right operand of instanceof is not callable")),
        )
    } else {
        ordinary_has_instance(machine, offset, right, left)
    }
}

fn push_instance_of(machine: Machine, offset: int) -> Result[unit, VmError] {
    let right = pop(machine, offset)?;
    let left = pop(machine, offset)?;
    machine.stack.push(runtime::Value::Bool(instance_of_value(machine, offset, left, right)?));
    Result::Ok(())
}

fn push_is_prototype_of(machine: Machine, offset: int) -> Result[unit, VmError] {
    let candidate = pop(machine, offset)?;
    let prototype = match pop(machine, offset)? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(error(offset, VmErrorKind::TypeError("prototype is invalid"))),
    };
    let object = match candidate {
        runtime::Value::Object(value) => value,
        _ => {
            machine.stack.push(runtime::Value::Bool(false));
            return Result::Ok(())
        },
    };
    let mut cursor = proxy_get_prototype_of(machine, offset, object)?;
    while cursor.is_some() {
        match cursor {
            Some(value) => if value == prototype {
                machine.stack.push(runtime::Value::Bool(true));
                return Result::Ok(())
            } else {
                cursor = proxy_get_prototype_of(machine, offset, value)?;
            },
            None => (),
        }
    }
    machine.stack.push(runtime::Value::Bool(false));
    Result::Ok(())
}

fn local_get(machine: Machine, offset: int, index: int) -> Result[runtime::Value, VmError] {
    if index < 0 || index >= machine.locals.len() {
        Result::Err(error(offset, VmErrorKind::InvalidLocal(index)))
    } else {
        Result::Ok(machine.locals[index].get())
    }
}

fn local_put(machine: Machine, offset: int, index: int, value: runtime::Value) -> Result[
    unit,
    VmError,
] {
    if index < 0 || index >= machine.locals.len() {
        Result::Err(error(offset, VmErrorKind::InvalidLocal(index)))
    } else {
        machine.locals[index].set(value);
        Result::Ok(())
    }
}

fn local_clone(machine: Machine, offset: int, index: int) -> Result[unit, VmError] {
    if index < 0 || index >= machine.locals.len() {
        Result::Err(error(offset, VmErrorKind::InvalidLocal(index)))
    } else {
        machine.locals[index] = Ref::new(machine.locals[index].get());
        Result::Ok(())
    }
}

fn upvalue_get(machine: Machine, offset: int, index: int) -> Result[runtime::Value, VmError] {
    if index < 0 || index >= machine.upvalues.len() {
        Result::Err(error(offset, VmErrorKind::InvalidUpvalue(index)))
    } else {
        match machine.upvalues[index] {
            UpvalueCell::Value(value) => Result::Ok(value.get()),
            UpvalueCell::This(value) => match value.get() {
                Some(current) => Result::Ok(current),
                None => Result::Err(
                    error(
                        offset,
                        VmErrorKind::ReferenceError("this is not initialized before super()"),
                    ),
                ),
            },
        }
    }
}

fn upvalue_put(machine: Machine, offset: int, index: int, value: runtime::Value) -> Result[
    unit,
    VmError,
] {
    if index < 0 || index >= machine.upvalues.len() {
        Result::Err(error(offset, VmErrorKind::InvalidUpvalue(index)))
    } else {
        match machine.upvalues[index] {
            UpvalueCell::Value(cell) => {
                cell.set(value);
                Result::Ok(())
            },
            UpvalueCell::This(_) => Result::Err(
                error(offset, VmErrorKind::TypeError("cannot assign lexical this")),
            ),
        }
    }
}

fn current_this(machine: Machine, offset: int) -> Result[runtime::Value, VmError] {
    match machine.this_value.get() {
        Some(value) => Result::Ok(value),
        None => Result::Err(
            error(offset, VmErrorKind::ReferenceError("this is not initialized before super()")),
        ),
    }
}

fn super_base(machine: Machine, offset: int) -> Result[Option[runtime::ObjectId], VmError] {
    let home = match machine.home_object {
        Some(value) => value,
        None => return Result::Err(
            error(offset, VmErrorKind::TypeError("function has no super binding")),
        ),
    };
    match machine.heap.get(home) {
        Some(value) => Result::Ok(value.prototype()),
        None => Result::Err(error(offset, VmErrorKind::TypeError("super home object is invalid"))),
    }
}

fn read_super_property(machine: Machine, offset: int, key: runtime::PropertyKey) -> Result[
    runtime::Value,
    VmError,
] {
    let receiver = current_this(machine, offset)?;
    match super_base(machine, offset)? {
        Some(base) => read_object_property(machine, offset, base, receiver, key),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn write_super_property(
    machine: Machine,
    offset: int,
    key: runtime::PropertyKey,
    value: runtime::Value,
) -> Result[unit, VmError] {
    let receiver = current_this(machine, offset)?;
    match super_base(machine, offset)? {
        Some(base) => match runtime::get_property_descriptor(machine.heap, base, key) {
            Ok(Some(runtime::PropertyDescriptor::Accessor { set: Some(setter), .. })) => {
                let _ = call_value(machine, offset, setter, Vec::[value], receiver)?;
                Result::Ok(())
            },
            Ok(Some(runtime::PropertyDescriptor::Accessor { set: None, .. })) => Result::Err(
                error(offset, VmErrorKind::TypeError("super property has no setter")),
            ),
            Ok(Some(runtime::PropertyDescriptor::Data { writable: false, .. })) => Result::Err(
                error(offset, VmErrorKind::TypeError("super property is not writable")),
            ),
            Ok(_) => match receiver {
                runtime::Value::Object(object) => match runtime::set_property(
                    machine.heap,
                    object,
                    key,
                    value,
                ) {
                    Ok(true) => Result::Ok(()),
                    Ok(false) => Result::Err(
                        error(offset, VmErrorKind::TypeError("cannot write super property")),
                    ),
                    Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
                },
                _ => Result::Err(
                    error(offset, VmErrorKind::TypeError("super receiver is not an object")),
                ),
            },
            Err(value) => Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
        },
        None => Result::Err(error(offset, VmErrorKind::TypeError("super base is null"))),
    }
}

fn pop_arguments(machine: Machine, offset: int, count: int) -> Result[Vec[runtime::Value], VmError] {
    let arguments: Vec[runtime::Value] = Vec::with_capacity(count);
    for _ in 0..count {
        arguments.push(runtime::Value::Undefined)
    }
    let mut index = count;
    while index > 0 {
        index -= 1;
        arguments[index] = pop(machine, offset)?;
    }
    Result::Ok(arguments)
}

fn initialize_call_locals(function: bytecode::Function, arguments: Vec[runtime::Value], offset: int) -> Result[
    Vec[Ref[runtime::Value]],
    VmError,
] {
    let verification = bytecode::verify(function);
    if !verification.errors.is_empty() {
        Result::Err(error(offset, VmErrorKind::VerificationFailed(verification.errors)))
    } else {
        let locals: Vec[Ref[runtime::Value]] = Vec::with_capacity(function.local_count());
        for _ in 0..function.local_count() {
            locals.push(Ref::new(runtime::Value::Undefined))
        }
        let count = if arguments.len() < function.parameter_count() {
            arguments.len()
        } else {
            function.parameter_count()
        };
        let mut index = 0;
        while index < count {
            locals[index].set(arguments[index]);
            index += 1;
        }
        Result::Ok(locals)
    }
}

fn closure_this_cell(upvalues: Vec[UpvalueCell]) -> Option[Ref[Option[runtime::Value]]] {
    for upvalue in upvalues {
        match upvalue {
            UpvalueCell::This(value) => return Option::Some(value),
            UpvalueCell::Value(_) => (),
        }
    }
    Option::None
}

fn capture_eval_upvalues(machine: Machine, offset: int, function: bytecode::Function) -> Result[
    Vec[UpvalueCell],
    VmError,
] {
    let upvalues: Vec[UpvalueCell] = Vec::[];
    let mut index = 0;
    while index < function.upvalue_count() {
        let cell = match function.upvalue_source(index) {
            Some(bytecode::UpvalueSource::Local(local)) => {
                if local < 0 || local >= machine.locals.len() {
                    return Result::Err(error(offset, VmErrorKind::InvalidLocal(local)))
                } else {
                    UpvalueCell::Value(machine.locals[local])
                }
            },
            Some(bytecode::UpvalueSource::Upvalue(upvalue)) => {
                if upvalue < 0 || upvalue >= machine.upvalues.len() {
                    return Result::Err(error(offset, VmErrorKind::InvalidUpvalue(upvalue)))
                } else {
                    machine.upvalues[upvalue]
                }
            },
            Some(bytecode::UpvalueSource::Closure) => match machine.callee {
                Some(value) => UpvalueCell::Value(Ref::new(value)),
                None => UpvalueCell::Value(Ref::new(runtime::Value::Undefined)),
            },
            Some(bytecode::UpvalueSource::This) => UpvalueCell::This(machine.this_value),
            Some(bytecode::UpvalueSource::Arguments) => {
                UpvalueCell::Value(Ref::new(materialize_arguments(machine, offset)?))
            },
            None => return Result::Err(error(offset, VmErrorKind::InvalidUpvalue(index))),
        };
        upvalues.push(cell);
        index += 1;
    }
    Result::Ok(upvalues)
}

fn evaluate_source(
    machine: Machine,
    offset: int,
    arguments: int,
    bindings: Vec[bytecode::EvalBinding],
) -> Result[runtime::Value, VmError] {
    let values = pop_arguments(machine, offset, arguments)?;
    let source = if values.is_empty() {
        runtime::Value::Undefined
    } else {
        values[0]
    };
    let source_text = match source {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => value,
            Err(value) => return Result::Err(error(offset, VmErrorKind::SyntaxError(value.debug()))),
        },
        _ => return Result::Ok(source),
    };
    let function = match machine.dynamic_eval_compiler.get() {
        Some(callback) => match callback(source_text, bindings) {
            Ok(value) => value,
            Err(value) => return Result::Err(
                error(offset, VmErrorKind::SyntaxErrorAt(value.message, value.location)),
            ),
        },
        None => return Result::Err(
            error(offset, VmErrorKind::TypeError("dynamic eval compiler is not installed")),
        ),
    };
    let locals = initialize_call_locals(function, Vec::[], offset)?;
    let upvalues = capture_eval_upvalues(machine, offset, function)?;
    execute_initialized(
        function,
        machine.heap,
        machine.functions,
        machine.bound_functions,
        machine.function_objects,
        machine.template_objects,
        machine.native_functions,
        machine.native_constructor_functions,
        machine.vm_functions,
        machine.vm_constructor_functions,
        machine.native_constructors,
        machine.global_object,
        machine.primitive_prototypes,
        machine.error_prototypes,
        machine.object_builtin_tags,
        machine.regexp_constructor,
        machine.iterator_symbol,
        machine.to_primitive_symbol,
        machine.has_instance_symbol,
        Option::None,
        Vec::[],
        locals,
        upvalues,
        machine.this_value,
        machine.home_object,
        machine.new_target,
        machine.instance_initializer,
        machine.eval_environment,
        machine.active_frames,
        machine.generators,
        machine.dynamic_eval_compiler,
        machine.dynamic_module_loader,
        machine.depth + 1,
    )
}

fn push_dynamic_import(machine: Machine, offset: int) -> Result[unit, VmError] {
    let referrer = pop(machine, offset)?;
    let options = pop(machine, offset)?;
    let specifier = pop(machine, offset)?;
    let loader = match machine.dynamic_module_loader.get() {
        Some(value) => value,
        None => return Result::Err(
            error(offset, VmErrorKind::TypeError("dynamic module loader is not installed")),
        ),
    };
    let promise = loader(specifier, options, referrer, machine.depth)?;
    machine.stack.push(promise);
    Result::Ok(())
}

fn sloppy_this_value(machine: Machine, offset: int, value: runtime::Value) -> Result[
    runtime::Value,
    VmError,
] {
    match value {
        runtime::Value::Undefined | runtime::Value::Null => match machine.global_object {
            Some(object) => if machine.heap.contains(object) {
                Result::Ok(runtime::Value::Object(object))
            } else {
                Result::Err(
                    error(offset, VmErrorKind::TypeError("global object is no longer alive")),
                )
            },
            None => Result::Ok(value),
        },
        runtime::Value::Object(_) => Result::Ok(value),
        primitive => {
            let prototype = match primitive {
                runtime::Value::Bool(_) => machine.primitive_prototypes.boolean_value.get(),
                runtime::Value::Int(_) | runtime::Value::Float(_) => {
                    machine.primitive_prototypes.number_value.get()
                },
                runtime::Value::String(_) => machine.primitive_prototypes.string_value.get(),
                runtime::Value::BigInt(_) => machine.primitive_prototypes.bigint_value.get(),
                runtime::Value::Symbol(_) => machine.primitive_prototypes.symbol_value.get(),
                _ => Option::None,
            };
            let object = match runtime::new_object(
                machine.heap,
                runtime::ObjectKind::Ordinary,
                match prototype {
                    Some(value) => Option::Some(value),
                    None => machine.heap.object_prototype(),
                },
            ) {
                Ok(value) => value,
                Err(value) => {
                    return Result::Err(error(offset, VmErrorKind::TypeError(value.message)))
                },
            };
            if runtime::set_primitive_value(machine.heap, object, primitive) {
                Result::Ok(runtime::Value::Object(object))
            } else {
                Result::Err(error(offset, VmErrorKind::TypeError("cannot box this value")))
            }
        },
    }
}

fn create_generator(
    machine: Machine,
    offset: int,
    object: runtime::ObjectId,
    function: bytecode::Function,
    arguments: Vec[runtime::Value],
    locals: Vec[Ref[runtime::Value]],
    closure: Closure,
    this_value: Ref[Option[runtime::Value]],
    new_target: Option[runtime::Value],
    eval_environment: Ref[Option[Ref[EvalEnvironment]]],
) -> Result[runtime::Value, VmError] {
    let configured_prototype = if function.generator() && function.asynchronous() {
        machine.generators.async_generator_prototype.get()
    } else {
        machine.generators.prototype.get()
    };
    let prototype = match configured_prototype {
        Some(value) => Option::Some(value),
        None => machine.heap.object_prototype(),
    };
    let generator = match runtime::new_ordinary_object(machine.heap, prototype) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    let verification = bytecode::verify(function);
    if !verification.errors.is_empty() {
        return Result::Err(error(offset, VmErrorKind::VerificationFailed(verification.errors)))
    } else {};
    machine.generators.states[generator] = GeneratorFrame {
        function,
        stack: Vec::with_capacity(verification.max_stack),
        locals,
        upvalues: closure.upvalues,
        arguments,
        this_value,
        callee: Option::Some(runtime::Value::Object(object)),
        home_object: closure.home_object.get(),
        new_target,
        instance_initializer: closure.instance_initializer,
        arguments_object: Ref::new(Option::None),
        request_roots: Ref::new(Vec::[]),
        offset: Ref::new(0),
        status: Ref::new(GeneratorStatus::SuspendedStart),
        depth: machine.depth + 1,
        eval_environment,
    };
    Result::Ok(runtime::Value::Object(generator))
}

fn proxy_argument_array(machine: Machine, offset: int, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    VmError,
] {
    let array = match runtime::new_array(machine.heap, arguments.len()) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
    };
    let mut index = 0;
    while index < arguments.len() {
        if !runtime::define_own_property(
            machine.heap,
            array,
            runtime::string_property_key(index.to_string()),
            runtime::data_descriptor(arguments[index], true, true, true),
        ) {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("cannot create proxy argument array")),
            )
        } else {};
        index += 1;
    }
    Result::Ok(runtime::Value::Object(array))
}

fn call_value_with_mode(
    machine: Machine,
    offset: int,
    callee: runtime::Value,
    arguments: Vec[runtime::Value],
    this_value: runtime::Value,
    constructing: bool,
    new_target: Option[runtime::Value],
) -> Result[runtime::Value, VmError] {
    if machine.depth >= MAX_CALL_DEPTH {
        return Result::Err(error(offset, VmErrorKind::CallDepthExceeded))
    } else {};
    match callee {
        runtime::Value::Object(object) => if !object.is_callable() || !machine.heap.contains(object) {
            Result::Err(error(offset, VmErrorKind::TypeError("value is not callable")))
        } else {
            match machine.bound_functions.get(object) {
                Some(bound) => return call_value_with_mode(
                    machine,
                    offset,
                    bound.target,
                    bound_arguments(bound, arguments),
                    bound.this_value,
                    false,
                    Option::None,
                ),
                None => (),
            };
            match proxy_parts(machine, offset, object)? {
                Some((target, handler)) => match proxy_trap(machine, offset, handler, "apply")? {
                    Some(trap) => return call_value(
                        machine,
                        offset,
                        trap,
                        Vec::[
                            runtime::Value::Object(target),
                            this_value,
                            proxy_argument_array(machine, offset, arguments)?,
                        ],
                        runtime::Value::Object(handler),
                    ),
                    None => return call_value_with_mode(
                        machine,
                        offset,
                        runtime::Value::Object(target),
                        arguments,
                        this_value,
                        constructing,
                        new_target,
                    ),
                },
                None => (),
            };
            match machine.functions.get(object) {
                Some(closure) => {
                    let function = closure.function.get();
                    if function.class_constructor() && !constructing {
                        return Result::Err(
                            error(
                                offset,
                                VmErrorKind::TypeError(
                                    "class constructor cannot be invoked without new",
                                ),
                            ),
                        )
                    } else {};
                    let locals = initialize_call_locals(function, arguments, offset)?;
                    let this_cell = if function.lexical_this() {
                        match closure_this_cell(closure.upvalues) {
                            Some(value) => value,
                            None => Ref::new(Option::Some(runtime::Value::Undefined)),
                        }
                    } else {
                        Ref::new(
                            if function.derived_constructor() && constructing {
                                Option::None
                            } else if function.strict() {
                                Option::Some(this_value)
                            } else {
                                Option::Some(sloppy_this_value(machine, offset, this_value)?)
                            },
                        )
                    };
                    let eval_environment = Ref::new(
                        Option::Some(
                            Ref::new(
                                EvalEnvironment {
                                    values: HashMap::{},
                                    parent: closure.eval_environment,
                                },
                            ),
                        ),
                    );
                    if function.generator() || function.asynchronous() {
                        if constructing {
                            return Result::Err(
                                error(
                                    offset,
                                    VmErrorKind::TypeError(
                                        if function.asynchronous() {
                                            "async function is not a constructor"
                                        } else {
                                            "generator function is not a constructor"
                                        },
                                    ),
                                ),
                            )
                        } else {};
                        let suspended = create_generator(
                            machine,
                            offset,
                            object,
                            function,
                            arguments,
                            locals,
                            closure,
                            this_cell,
                            new_target,
                            eval_environment,
                        )?;
                        if function.asynchronous() && function.generator() {
                            return match machine.generators.async_generator_runner.get() {
                                Some(runner) => runner(suspended, machine.depth + 1),
                                None => Result::Err(
                                    error(
                                        offset,
                                        VmErrorKind::TypeError(
                                            "async generator runner is not installed",
                                        ),
                                    ),
                                ),
                            }
                        } else if function.asynchronous() {
                            return match machine.generators.async_function_runner.get() {
                                Some(runner) => runner(suspended, machine.depth + 1),
                                None => Result::Err(
                                    error(
                                        offset,
                                        VmErrorKind::TypeError(
                                            "async function runner is not installed",
                                        ),
                                    ),
                                ),
                            }
                        } else {
                            return Result::Ok(suspended)
                        }
                    } else {};
                    let result = execute_initialized(
                        function,
                        machine.heap,
                        machine.functions,
                        machine.bound_functions,
                        machine.function_objects,
                        machine.template_objects,
                        machine.native_functions,
                        machine.native_constructor_functions,
                        machine.vm_functions,
                        machine.vm_constructor_functions,
                        machine.native_constructors,
                        machine.global_object,
                        machine.primitive_prototypes,
                        machine.error_prototypes,
                        machine.object_builtin_tags,
                        machine.regexp_constructor,
                        machine.iterator_symbol,
                        machine.to_primitive_symbol,
                        machine.has_instance_symbol,
                        Option::Some(runtime::Value::Object(object)),
                        arguments,
                        locals,
                        closure.upvalues,
                        this_cell,
                        closure.home_object.get(),
                        if function.lexical_this() {
                            closure.new_target
                        } else {
                            new_target
                        },
                        closure.instance_initializer,
                        eval_environment,
                        machine.active_frames,
                        machine.generators,
                        machine.dynamic_eval_compiler,
                        machine.dynamic_module_loader,
                        machine.depth + 1,
                    )?;
                    if function.derived_constructor() && constructing {
                        match result {
                            runtime::Value::Object(_) => Result::Ok(result),
                            runtime::Value::Undefined => match this_cell.get() {
                                Some(value) => Result::Ok(value),
                                None => Result::Err(
                                    error(
                                        offset,
                                        VmErrorKind::ReferenceError(
                                            "derived constructor did not initialize this",
                                        ),
                                    ),
                                ),
                            },
                            _ => Result::Err(
                                error(
                                    offset,
                                    VmErrorKind::TypeError(
                                        "derived constructor returned a non-object value",
                                    ),
                                ),
                            ),
                        }
                    } else {
                        Result::Ok(result)
                    }
                },
                None => match machine.native_functions.get(object) {
                    Some(callback) => match callback(machine.heap, this_value, arguments) {
                        Ok(value) => Result::Ok(ensure_error_stack(machine, value, offset)),
                        Err(value) => {
                            Result::Err(error(offset, native_error_kind(value.message)))
                        },
                    },
                    None => match machine.vm_functions.get(object) {
                        Some(callback) => match callback(this_value, arguments, machine.depth) {
                            Ok(value) => Result::Ok(value),
                            Err(VmError { offset: inner_offset, kind }) => if inner_offset < 0 {
                                Result::Err(error(offset, kind))
                            } else {
                                Result::Err(VmError { offset: inner_offset, kind })
                            },
                        },
                        None => Result::Err(
                            error(offset, VmErrorKind::TypeError("callable has no implementation")),
                        ),
                    },
                },
            }
        },
        _ => Result::Err(error(offset, VmErrorKind::TypeError("value is not callable"))),
    }
}

fn call_value(
    machine: Machine,
    offset: int,
    callee: runtime::Value,
    arguments: Vec[runtime::Value],
    this_value: runtime::Value,
) -> Result[runtime::Value, VmError] {
    call_value_with_mode(machine, offset, callee, arguments, this_value, false, Option::None)
}

fn construct_value_with_new_target(
    machine: Machine,
    offset: int,
    callee: runtime::Value,
    arguments: Vec[runtime::Value],
    new_target: runtime::Value,
) -> Result[runtime::Value, VmError] {
    let object = match callee {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(error(offset, VmErrorKind::TypeError("value is not a constructor"))),
    };
    match machine.bound_functions.get(object) {
        Some(bound) => {
            let target = bound.target;
            let effective_new_target = if runtime::same_value(new_target, callee) {
                target
            } else {
                new_target
            };
            return construct_value_with_new_target(
                machine,
                offset,
                target,
                bound_arguments(bound, arguments),
                effective_new_target,
            )
        },
        None => (),
    };
    match proxy_parts(machine, offset, object)? {
        Some((target, handler)) => match proxy_trap(machine, offset, handler, "construct")? {
            Some(trap) => {
                let result = call_value(
                    machine,
                    offset,
                    trap,
                    Vec::[
                        runtime::Value::Object(target),
                        proxy_argument_array(machine, offset, arguments)?,
                        new_target,
                    ],
                    runtime::Value::Object(handler),
                )?;
                return match result {
                    runtime::Value::Object(_) => Result::Ok(result),
                    _ => Result::Err(
                        error(
                            offset,
                            VmErrorKind::TypeError("proxy construct trap returned a non-object"),
                        ),
                    ),
                }
            },
            None => return construct_value_with_new_target(
                machine,
                offset,
                runtime::Value::Object(target),
                arguments,
                new_target,
            ),
        },
        None => (),
    };
    let source_function = machine.functions.get(object);
    let source_constructable = match source_function {
        Some(closure) => closure.function.get().constructable(),
        None => false,
    };
    if !machine.heap.contains(object) || !object.is_callable()
        || !source_constructable && !machine.native_constructors.contains(object) {
        let message = match source_function {
            Some(closure) => match closure.function.get().name() {
                Some(name) => host_string(name) + " is not a constructor",
                None => "value is not a constructor",
            },
            None => "value is not a constructor",
        };
        return Result::Err(error(offset, VmErrorKind::TypeError(message)))
    } else {};
    let new_target_object = match new_target {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(
            error(offset, VmErrorKind::TypeError("new target is not an object")),
        ),
    };
    let arguments = match machine.vm_constructor_functions.get(object) {
        Some(callbacks) => match callbacks.prepare {
            Some(prepare) => prepare(arguments, machine.depth)?,
            None => arguments,
        },
        None => arguments,
    };
    match machine.vm_constructor_functions.get(object) {
        Some(callbacks) => match callbacks.self_allocating {
            Some(callback) => return callback(arguments, machine.depth),
            None => (),
        },
        None => (),
    };
    let prototype = match read_object_property(
        machine,
        offset,
        new_target_object,
        new_target,
        runtime::string_property_key("prototype"),
    )? {
        runtime::Value::Object(value) => Option::Some(value),
        _ => Option::None,
    };
    let derived = match source_function {
        Some(closure) => closure.function.get().derived_constructor(),
        None => false,
    };
    let receiver = if derived {
        runtime::Value::Undefined
    } else {
        match runtime::new_ordinary_object(machine.heap, prototype) {
            Ok(value) => runtime::Value::Object(value),
            Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.message))),
        }
    };
    match (receiver, machine.native_constructor_functions.get(object)) {
        (runtime::Value::Object(receiver_object), Some(callback)) => {
            return match callback(machine.heap, receiver_object, arguments) {
                Ok(runtime::Value::Object(value)) => Result::Ok(runtime::Value::Object(value)),
                Ok(_) => Result::Ok(receiver),
                Err(value) => Result::Err(error(offset, native_error_kind(value.message))),
            }
        },
        _ => (),
    };
    match (receiver, machine.vm_constructor_functions.get(object)) {
        (runtime::Value::Object(receiver_object), Some(callbacks)) => {
            return match callbacks.callback {
                Some(callback) => match callback(
                    receiver_object,
                    arguments,
                    prototype,
                    new_target,
                    machine.depth,
                ) {
                    Ok(runtime::Value::Object(value)) => Result::Ok(runtime::Value::Object(value)),
                    Ok(_) => Result::Ok(receiver),
                    Err(value) => Result::Err(value),
                },
                None => Result::Err(
                    error(offset, VmErrorKind::TypeError("constructor callback is unavailable")),
                ),
            }
        },
        _ => (),
    };
    match call_value_with_mode(
        machine,
        offset,
        callee,
        arguments,
        receiver,
        true,
        Option::Some(new_target),
    )? {
        runtime::Value::Object(value) => Result::Ok(runtime::Value::Object(value)),
        _ => Result::Ok(receiver),
    }
}

fn construct_value(
    machine: Machine,
    offset: int,
    callee: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, VmError] {
    construct_value_with_new_target(machine, offset, callee, arguments, callee)
}

fn call_super_constructor(machine: Machine, offset: int, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    VmError,
] {
    if machine.this_value.get().is_some() {
        return Result::Err(
            error(offset, VmErrorKind::ReferenceError("super() called more than once")),
        )
    } else {};
    let base = match super_base(machine, offset)? {
        Some(value) => runtime::Value::Object(value),
        None => return Result::Err(
            error(offset, VmErrorKind::TypeError("super constructor is null")),
        ),
    };
    let new_target = match machine.new_target {
        Some(value) => value,
        None => return Result::Err(
            error(offset, VmErrorKind::TypeError("new target is unavailable")),
        ),
    };
    let result = construct_value_with_new_target(machine, offset, base, arguments, new_target)?;
    machine.this_value.set(Option::Some(result));
    initialize_instance_fields(machine, offset)?;
    Result::Ok(result)
}

fn push_super_call(machine: Machine, offset: int, argument_count: int) -> Result[unit, VmError] {
    let arguments = pop_arguments(machine, offset, argument_count)?;
    let result = call_super_constructor(machine, offset, arguments)?;
    machine.stack.push(result);
    Result::Ok(())
}

fn push_super_array_call(machine: Machine, offset: int) -> Result[unit, VmError] {
    let array = pop(machine, offset)?;
    let arguments = argument_array_values(machine, offset, array)?;
    let result = call_super_constructor(machine, offset, arguments)?;
    machine.stack.push(result);
    Result::Ok(())
}

fn push_call(machine: Machine, offset: int, argument_count: int, method: bool) -> Result[
    unit,
    VmError,
] {
    let arguments = pop_arguments(machine, offset, argument_count)?;
    let callee = pop(machine, offset)?;
    let this_value = if method {
        pop(machine, offset)?
    } else {
        runtime::Value::Undefined
    };
    let result = call_value(machine, offset, callee, arguments, this_value)?;
    machine.stack.push(result);
    Result::Ok(())
}

fn push_construct(machine: Machine, offset: int, argument_count: int) -> Result[unit, VmError] {
    let arguments = pop_arguments(machine, offset, argument_count)?;
    let callee = pop(machine, offset)?;
    let result = construct_value(machine, offset, callee, arguments)?;
    machine.stack.push(result);
    Result::Ok(())
}

fn push_construct_with_new_target(machine: Machine, offset: int, argument_count: int) -> Result[
    unit,
    VmError,
] {
    let arguments = pop_arguments(machine, offset, argument_count)?;
    let new_target = pop(machine, offset)?;
    let callee = pop(machine, offset)?;
    let result = construct_value_with_new_target(machine, offset, callee, arguments, new_target)?;
    machine.stack.push(result);
    Result::Ok(())
}

fn argument_array_values(machine: Machine, offset: int, value: runtime::Value) -> Result[
    Vec[runtime::Value],
    VmError,
] {
    let object = array_literal_target(machine, offset, value)?;
    let length = match arrayx::length(machine.heap, object) {
        Ok(value) => value,
        Err(value) => return Result::Err(error(offset, VmErrorKind::TypeError(value.to_string()))),
    };
    let arguments: Vec[runtime::Value] = Vec::with_capacity(length);
    let mut index = 0;
    while index < length {
        arguments.push(
            read_property(
                machine,
                offset,
                runtime::Value::Object(object),
                runtime::string_property_key(index.to_string()),
            )?,
        );
        index += 1;
    }
    Result::Ok(arguments)
}

fn push_array_call(machine: Machine, offset: int, method: bool) -> Result[unit, VmError] {
    let array = pop(machine, offset)?;
    let arguments = argument_array_values(machine, offset, array)?;
    let callee = pop(machine, offset)?;
    let this_value = if method {
        pop(machine, offset)?
    } else {
        runtime::Value::Undefined
    };
    let result = call_value(machine, offset, callee, arguments, this_value)?;
    machine.stack.push(result);
    Result::Ok(())
}

fn push_array_construct(machine: Machine, offset: int) -> Result[unit, VmError] {
    let array = pop(machine, offset)?;
    let arguments = argument_array_values(machine, offset, array)?;
    let callee = pop(machine, offset)?;
    let result = construct_value(machine, offset, callee, arguments)?;
    machine.stack.push(result);
    Result::Ok(())
}

fn jump(machine: Machine, offset: int, target: int) -> Result[StepResult, VmError] {
    if target < 0 || target >= machine.function.code_len() {
        Result::Err(error(offset, VmErrorKind::InvalidJump(target)))
    } else {
        Result::Ok(StepResult::Continue(target))
    }
}

fn step(machine: Machine, offset: int, instruction: bytecode::Instruction) -> Result[
    StepResult,
    VmError,
] {
    let mut next = offset + 1;
    match instruction {
        bytecode::Instruction::PushI32(value) => {
            machine.stack.push(runtime::Value::Int(value))
        },
        bytecode::Instruction::PushConst(index) => {
            machine.stack.push(constant_value(machine, offset, index)?)
        },
        bytecode::Instruction::Undefined => machine.stack.push(runtime::Value::Undefined),
        bytecode::Instruction::Null => machine.stack.push(runtime::Value::Null),
        bytecode::Instruction::PushFalse => machine.stack.push(runtime::Value::Bool(false)),
        bytecode::Instruction::PushTrue => machine.stack.push(runtime::Value::Bool(true)),
        bytecode::Instruction::PushThis => machine.stack.push(current_this(machine, offset)?),
        bytecode::Instruction::PushNewTarget => machine.stack.push(
            match machine.new_target {
                Some(value) => value,
                None => runtime::Value::Undefined,
            },
        ),
        bytecode::Instruction::PushArguments => {
            machine.stack.push(materialize_arguments(machine, offset)?)
        },
        bytecode::Instruction::PushRest(start) => {
            machine.stack.push(materialize_rest_arguments(machine, offset, start)?)
        },
        bytecode::Instruction::NewObject => match runtime::new_ordinary_object(
            machine.heap,
            Option::None,
        ) {
            Ok(object) => machine.stack.push(runtime::Value::Object(object)),
            Err(value) => {
                return Result::Err(error(offset, VmErrorKind::TypeError(value.message)))
            },
        },
        bytecode::Instruction::NewArray(length) => match runtime::new_array(machine.heap, length) {
            Ok(object) => machine.stack.push(runtime::Value::Object(object)),
            Err(value) => {
                return Result::Err(error(offset, VmErrorKind::TypeError(value.message)))
            },
        },
        bytecode::Instruction::NewPrivateName => match machine.heap.allocate(
            runtime::ObjectKind::Ordinary,
            Option::None,
        ) {
            Ok(object) => machine.stack.push(runtime::Value::Object(object)),
            Err(value) => {
                return Result::Err(error(offset, VmErrorKind::TypeError(value.message)))
            },
        },
        bytecode::Instruction::NewRegExp(pattern, flags) => {
            let constructor = match machine.regexp_constructor {
                Some(value) => value,
                None => return Result::Err(
                    error(offset, VmErrorKind::TypeError("RegExp is not installed")),
                ),
            };
            let pattern = constant_value(machine, offset, pattern)?;
            let flags = constant_value(machine, offset, flags)?;
            let value = construct_value(machine, offset, constructor, Vec::[pattern, flags])?;
            machine.stack.push(value);
        },
        bytecode::Instruction::ArrayAppend => append_array_literal(machine, offset)?,
        bytecode::Instruction::ArrayAppendHole => append_array_literal_hole(machine, offset)?,
        bytecode::Instruction::ArrayAppendSpread => append_array_spread(machine, offset)?,
        bytecode::Instruction::CopyDataProperties => copy_data_properties(machine, offset)?,
        bytecode::Instruction::CopyDataPropertiesExcluded(count) => {
            copy_data_properties_excluded(machine, offset, count)?
        },
        bytecode::Instruction::Enumerate => enumerate_value(machine, offset)?,
        bytecode::Instruction::EnumerableProperty => push_enumerable_property(machine, offset)?,
        bytecode::Instruction::OwnKeys => push_own_keys(machine, offset)?,
        bytecode::Instruction::GetPrototypeOf => push_get_prototype_of(machine, offset)?,
        bytecode::Instruction::SetPrototypeOf => push_set_prototype_of(machine, offset)?,
        bytecode::Instruction::IsExtensible => push_is_extensible(machine, offset)?,
        bytecode::Instruction::PreventExtensions => push_prevent_extensions(machine, offset)?,
        bytecode::Instruction::IteratorStart => start_iterator(machine, offset)?,
        bytecode::Instruction::AsyncIteratorStart => start_async_iterator(machine, offset)?,
        bytecode::Instruction::IteratorNext => advance_iterator(machine, offset)?,
        bytecode::Instruction::IteratorNextValue => {
            advance_iterator_with_value(machine, offset)?
        },
        bytecode::Instruction::IteratorThrow => resume_iterator_method(machine, offset, false)?,
        bytecode::Instruction::IteratorReturn => resume_iterator_method(machine, offset, true)?,
        bytecode::Instruction::IteratorCallNext => call_iterator_next(machine, offset, false)?,
        bytecode::Instruction::IteratorCallNextValue => {
            call_iterator_next(machine, offset, true)?
        },
        bytecode::Instruction::IteratorCallThrow => {
            call_iterator_resume(machine, offset, false)?
        },
        bytecode::Instruction::IteratorCallReturn => {
            call_iterator_resume(machine, offset, true)?
        },
        bytecode::Instruction::IteratorResult => decode_iterator_result(machine, offset)?,
        bytecode::Instruction::IteratorThrowResult => {
            decode_iterator_throw_result(machine, offset)?
        },
        bytecode::Instruction::IteratorClose => close_iterator(machine, offset)?,
        bytecode::Instruction::IteratorCloseThrow => close_iterator_throw(machine, offset)?,
        bytecode::Instruction::Drop => {
            let _ = pop(machine, offset)?;
        },
        bytecode::Instruction::Dup => {
            let value = pop(machine, offset)?;
            machine.stack.push(value);
            machine.stack.push(value);
        },
        bytecode::Instruction::GetLoc(index) => {
            machine.stack.push(local_get(machine, offset, index)?)
        },
        bytecode::Instruction::PutLoc(index) => {
            let value = pop(machine, offset)?;
            local_put(machine, offset, index, value)?;
        },
        bytecode::Instruction::SetLoc(index) => {
            let value = pop(machine, offset)?;
            machine.stack.push(value);
            local_put(machine, offset, index, value)?;
        },
        bytecode::Instruction::CloneLoc(index) => local_clone(machine, offset, index)?,
        bytecode::Instruction::GetUpvalue(index) => {
            machine.stack.push(upvalue_get(machine, offset, index)?)
        },
        bytecode::Instruction::PutUpvalue(index) => {
            let value = pop(machine, offset)?;
            upvalue_put(machine, offset, index, value)?;
        },
        bytecode::Instruction::SetUpvalue(index) => {
            let value = pop(machine, offset)?;
            machine.stack.push(value);
            upvalue_put(machine, offset, index, value)?;
        },
        bytecode::Instruction::GetGlobal(index) => {
            let object = global_object(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            machine.stack.push(read_global_property(machine, offset, object, key)?)
        },
        bytecode::Instruction::SetGlobal(index) => {
            let value = pop(machine, offset)?;
            let object = global_object(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            write_property(machine, offset, runtime::Value::Object(object), key, value)?;
            machine.stack.push(value);
        },
        bytecode::Instruction::DeleteGlobal(index) => {
            let object = global_object(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            machine.stack.push(
                runtime::Value::Bool(runtime::delete_property(machine.heap, object, key)),
            );
        },
        bytecode::Instruction::GetEval(index) => {
            machine.stack.push(read_eval_binding(machine, offset, index, false)?)
        },
        bytecode::Instruction::GetEvalOrUndefined(index) => {
            machine.stack.push(read_eval_binding(machine, offset, index, true)?)
        },
        bytecode::Instruction::SetEval(index) => {
            let value = pop(machine, offset)?;
            write_eval_binding(machine, offset, index, value)?;
            machine.stack.push(value);
        },
        bytecode::Instruction::DeleteEval(index) => {
            machine.stack.push(runtime::Value::Bool(delete_eval_binding(machine, offset, index)?));
        },
        bytecode::Instruction::InitEval(index) => initialize_eval_binding(machine, offset, index)?,
        bytecode::Instruction::EnterEvalEnvironment => enter_eval_environment(machine),
        bytecode::Instruction::GetField(index) => {
            let receiver = pop(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            machine.stack.push(read_property(machine, offset, receiver, key)?)
        },
        bytecode::Instruction::PutField(index) => {
            let value = pop(machine, offset)?;
            let receiver = pop(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            write_property(machine, offset, receiver, key, value)?;
        },
        bytecode::Instruction::DefineGetter(index) => {
            define_accessor_property(machine, offset, index, true)?
        },
        bytecode::Instruction::DefineSetter(index) => {
            define_accessor_property(machine, offset, index, false)?
        },
        bytecode::Instruction::DefineGetterComputed => {
            define_computed_accessor_property(machine, offset, true)?
        },
        bytecode::Instruction::DefineSetterComputed => {
            define_computed_accessor_property(machine, offset, false)?
        },
        bytecode::Instruction::DefineClassMethod(index) => {
            define_class_element(machine, offset, index, 0)?
        },
        bytecode::Instruction::DefineClassGetter(index) => {
            define_class_element(machine, offset, index, 1)?
        },
        bytecode::Instruction::DefineClassSetter(index) => {
            define_class_element(machine, offset, index, 2)?
        },
        bytecode::Instruction::DefineClassMethodComputed => {
            define_computed_class_element(machine, offset, 0)?
        },
        bytecode::Instruction::DefineClassGetterComputed => {
            define_computed_class_element(machine, offset, 1)?
        },
        bytecode::Instruction::DefineClassSetterComputed => {
            define_computed_class_element(machine, offset, 2)?
        },
        bytecode::Instruction::DefineThisField(index) => {
            define_this_field(machine, offset, index)?
        },
        bytecode::Instruction::DefineThisFieldComputed => {
            define_computed_this_field(machine, offset)?
        },
        bytecode::Instruction::DefineThisPrivateField => {
            define_this_private_element(machine, offset, 0)?
        },
        bytecode::Instruction::DefineThisPrivateMethod => {
            define_this_private_element(machine, offset, 1)?
        },
        bytecode::Instruction::DefineThisPrivateGetter => {
            define_this_private_element(machine, offset, 2)?
        },
        bytecode::Instruction::DefineThisPrivateSetter => {
            define_this_private_element(machine, offset, 3)?
        },
        bytecode::Instruction::SetClassInstanceInitializer => {
            set_class_instance_initializer(machine, offset)?
        },
        bytecode::Instruction::SetFunctionHomeObject => {
            set_function_home_object(machine, offset)?
        },
        bytecode::Instruction::SetClassHeritage(derived) => {
            set_class_heritage(machine, offset, derived)?
        },
        bytecode::Instruction::GetSuperField(index) => {
            let key = field_key(machine, offset, index)?;
            machine.stack.push(read_super_property(machine, offset, key)?)
        },
        bytecode::Instruction::PutSuperField(index) => {
            let value = pop(machine, offset)?;
            let key = field_key(machine, offset, index)?;
            write_super_property(machine, offset, key, value)?
        },
        bytecode::Instruction::GetSuperEl => {
            let key = property_key(machine, offset, pop(machine, offset)?)?;
            machine.stack.push(read_super_property(machine, offset, key)?)
        },
        bytecode::Instruction::PutSuperEl => {
            let value = pop(machine, offset)?;
            let key = property_key(machine, offset, pop(machine, offset)?)?;
            write_super_property(machine, offset, key, value)?
        },
        bytecode::Instruction::GetArrayEl => {
            let key = property_key(machine, offset, pop(machine, offset)?)?;
            let receiver = pop(machine, offset)?;
            machine.stack.push(read_property(machine, offset, receiver, key)?)
        },
        bytecode::Instruction::PutArrayEl => {
            let value = pop(machine, offset)?;
            let key = property_key(machine, offset, pop(machine, offset)?)?;
            let receiver = pop(machine, offset)?;
            write_property(machine, offset, receiver, key, value)?;
        },
        bytecode::Instruction::ReflectGet => push_reflect_get(machine, offset)?,
        bytecode::Instruction::ReflectSet => push_reflect_set(machine, offset)?,
        bytecode::Instruction::GetPrivate => {
            let name = pop(machine, offset)?;
            let receiver = pop(machine, offset)?;
            machine.stack.push(read_private_element(machine, offset, receiver, name)?)
        },
        bytecode::Instruction::PutPrivate => {
            let value = pop(machine, offset)?;
            let name = pop(machine, offset)?;
            let receiver = pop(machine, offset)?;
            write_private_element(machine, offset, receiver, name, value)?
        },
        bytecode::Instruction::HasPrivate => {
            let receiver = private_object(
                offset,
                pop(machine, offset)?,
                "right operand of private in is not an object",
            )?;
            let name = private_object(offset, pop(machine, offset)?, "invalid private name")?;
            machine.stack.push(
                runtime::Value::Bool(runtime::has_private_element(machine.heap, receiver, name)),
            )
        },
        bytecode::Instruction::Call(arguments) => push_call(machine, offset, arguments, false)?,
        bytecode::Instruction::CallMethod(arguments) => {
            push_call(machine, offset, arguments, true)?
        },
        bytecode::Instruction::Construct(arguments) => {
            push_construct(machine, offset, arguments)?
        },
        bytecode::Instruction::ConstructWithNewTarget(arguments) => {
            push_construct_with_new_target(machine, offset, arguments)?
        },
        bytecode::Instruction::CallArray => push_array_call(machine, offset, false)?,
        bytecode::Instruction::CallMethodArray => push_array_call(machine, offset, true)?,
        bytecode::Instruction::ConstructArray => push_array_construct(machine, offset)?,
        bytecode::Instruction::CallSuper(arguments) => {
            push_super_call(machine, offset, arguments)?
        },
        bytecode::Instruction::CallSuperArray => push_super_array_call(machine, offset)?,
        bytecode::Instruction::Eval(arguments, site) => {
            let bindings = match machine.function.eval_site(site) {
                Some(value) => value,
                None => return Result::Err(error(offset, VmErrorKind::InvalidConstant(site))),
            };
            let value = evaluate_source(machine, offset, arguments, bindings)?;
            machine.stack.push(value)
        },
        bytecode::Instruction::DynamicImport => push_dynamic_import(machine, offset)?,
        bytecode::Instruction::InitializeInstanceFields => {
            initialize_instance_fields(machine, offset)?
        },
        bytecode::Instruction::Await => return Result::Ok(
            StepResult::Await(pop(machine, offset)?, next),
        ),
        bytecode::Instruction::Yield => return Result::Ok(
            StepResult::Yield(pop(machine, offset)?, next),
        ),
        bytecode::Instruction::Return => return Result::Ok(
            StepResult::Return(pop(machine, offset)?),
        ),
        bytecode::Instruction::ReturnUndef => {
            return Result::Ok(StepResult::Return(runtime::Value::Undefined))
        },
        bytecode::Instruction::Throw => {
            let value = pop(machine, offset)?;
            return Result::Err(error(offset, VmErrorKind::Thrown(value)))
        },
        bytecode::Instruction::ThrowTypeError => {
            return Result::Err(
                error(offset, VmErrorKind::TypeError("assignment to immutable function name")),
            )
        },
        bytecode::Instruction::ThrowReferenceError => {
            return Result::Err(
                error(offset, VmErrorKind::ReferenceError("invalid super property deletion")),
            )
        },
        bytecode::Instruction::IfFalse(target) => {
            let condition = pop(machine, offset)?;
            if !runtime::to_boolean(condition) {
                return jump(machine, offset, target)
            } else {}
        },
        bytecode::Instruction::IfTrue(target) => {
            let condition = pop(machine, offset)?;
            if runtime::to_boolean(condition) {
                return jump(machine, offset, target)
            } else {}
        },
        bytecode::Instruction::Goto(target) => return jump(machine, offset, target),
        bytecode::Instruction::Neg => {
            let value = to_primitive(machine, offset, pop(machine, offset)?, PrimitiveHint::Number)?;
            match value {
                runtime::Value::BigInt(value) => {
                    machine.stack.push(runtime::Value::BigInt(value.negate()))
                },
                _ => machine.stack.push(runtime::Value::Float(-number(machine, offset, value)?)),
            }
        },
        bytecode::Instruction::Plus => {
            let value = to_primitive(machine, offset, pop(machine, offset)?, PrimitiveHint::Number)?;
            match value {
                runtime::Value::BigInt(_) => {
                    return Result::Err(
                        error(offset, VmErrorKind::TypeError("cannot apply unary plus to BigInt")),
                    )
                },
                _ => machine.stack.push(runtime::Value::Float(number(machine, offset, value)?)),
            }
        },
        bytecode::Instruction::LNot => {
            let value = pop(machine, offset)?;
            machine.stack.push(runtime::Value::Bool(!runtime::to_boolean(value)))
        },
        bytecode::Instruction::Not => {
            let value = to_primitive(machine, offset, pop(machine, offset)?, PrimitiveHint::Number)?;
            match value {
                runtime::Value::BigInt(value) => {
                    machine.stack.push(runtime::Value::BigInt(value.bit_not()))
                },
                _ => machine.stack.push(
                    runtime::Value::Int(~to_int32(number(machine, offset, value)?)),
                ),
            }
        },
        bytecode::Instruction::TypeOf => {
            let value = pop(machine, offset)?;
            machine.stack.push(runtime::Value::String(js_string(runtime::type_of(value))))
        },
        bytecode::Instruction::ToPrimitiveDefault => {
            let value = pop(machine, offset)?;
            machine.stack.push(to_primitive(machine, offset, value, PrimitiveHint::Default)?)
        },
        bytecode::Instruction::ToPrimitiveNumber => {
            let value = pop(machine, offset)?;
            machine.stack.push(to_primitive(machine, offset, value, PrimitiveHint::Number)?)
        },
        bytecode::Instruction::ToPrimitiveString => {
            let value = pop(machine, offset)?;
            machine.stack.push(to_primitive(machine, offset, value, PrimitiveHint::String)?)
        },
        bytecode::Instruction::ToPropertyKey => {
            let value = pop(machine, offset)?;
            machine.stack.push(property_key_value(machine, offset, value)?)
        },
        bytecode::Instruction::RequireObjectCoercible => {
            let value = pop(machine, offset)?;
            match value {
                runtime::Value::Undefined | runtime::Value::Null => return Result::Err(
                    error(offset, VmErrorKind::TypeError("cannot destructure null or undefined")),
                ),
                _ => machine.stack.push(value),
            }
        },
        bytecode::Instruction::Delete => {
            let key = property_key(machine, offset, pop(machine, offset)?)?;
            let receiver = pop(machine, offset)?;
            machine.stack.push(delete_property(machine, offset, receiver, key)?)
        },
        bytecode::Instruction::DeleteOptional => {
            let key_value = pop(machine, offset)?;
            let receiver = pop(machine, offset)?;
            match receiver {
                runtime::Value::Undefined | runtime::Value::Null => {
                    machine.stack.push(runtime::Value::Bool(true))
                },
                _ => {
                    let key = property_key(machine, offset, key_value)?;
                    machine.stack.push(delete_property(machine, offset, receiver, key)?)
                },
            }
        },
        bytecode::Instruction::Mul | bytecode::Instruction::Div | bytecode::Instruction::Mod | bytecode::Instruction::Sub | bytecode::Instruction::Pow => push_numeric_binary(
            machine,
            offset,
            instruction,
        )?,
        bytecode::Instruction::Add => push_add(machine, offset)?,
        bytecode::Instruction::Shl | bytecode::Instruction::Sar | bytecode::Instruction::Shr => push_shift(
            machine,
            offset,
            instruction,
        )?,
        bytecode::Instruction::Lt | bytecode::Instruction::Lte | bytecode::Instruction::Gt | bytecode::Instruction::Gte | bytecode::Instruction::Eq | bytecode::Instruction::Neq | bytecode::Instruction::StrictEq | bytecode::Instruction::StrictNeq => push_comparison(
            machine,
            offset,
            instruction,
        )?,
        bytecode::Instruction::In => push_in(machine, offset)?,
        bytecode::Instruction::WithHasBinding => push_with_has_binding(machine, offset)?,
        bytecode::Instruction::InstanceOf => push_instance_of(machine, offset)?,
        bytecode::Instruction::IsPrototypeOf => push_is_prototype_of(machine, offset)?,
        bytecode::Instruction::BitAnd | bytecode::Instruction::BitXor | bytecode::Instruction::BitOr => push_bitwise_binary(
            machine,
            offset,
            instruction,
        )?,
        bytecode::Instruction::IsUndefinedOrNull => {
            let value = pop(machine, offset)?;
            let result = match value {
                runtime::Value::Undefined | runtime::Value::Null => true,
                _ => false,
            };
            machine.stack.push(runtime::Value::Bool(result));
        },
    };
    Result::Ok(StepResult::Continue(next))
}

fn execute_initialized(
    function: bytecode::Function,
    heap: runtime::Heap,
    functions: HashMap[runtime::ObjectId, Closure],
    bound_functions: HashMap[runtime::ObjectId, BoundFunction],
    function_objects: HashMap[uint64, runtime::ObjectId],
    template_objects: HashMap[uint64, runtime::ObjectId],
    native_functions: HashMap[runtime::ObjectId, NativeCallable],
    native_constructor_functions: HashMap[runtime::ObjectId, NativeConstructorCallable],
    vm_functions: HashMap[runtime::ObjectId, VmCallable],
    vm_constructor_functions: HashMap[runtime::ObjectId, VmConstructorCallbacks],
    native_constructors: collections::HashSet[runtime::ObjectId],
    global_object: Option[runtime::ObjectId],
    primitive_prototypes: PrimitivePrototypes,
    error_prototypes: ErrorPrototypes,
    object_builtin_tags: HashMap[runtime::ObjectId, runtime::JsString],
    regexp_constructor: Option[runtime::Value],
    iterator_symbol: Option[runtime::Symbol],
    to_primitive_symbol: Option[runtime::Symbol],
    has_instance_symbol: Option[runtime::Symbol],
    callee: Option[runtime::Value],
    arguments: Vec[runtime::Value],
    locals: Vec[Ref[runtime::Value]],
    upvalues: Vec[UpvalueCell],
    this_value: Ref[Option[runtime::Value]],
    home_object: Option[runtime::ObjectId],
    new_target: Option[runtime::Value],
    instance_initializer: Ref[Option[runtime::ObjectId]],
    eval_environment: Ref[Option[Ref[EvalEnvironment]]],
    active_frames: Vec[ActiveFrame],
    generators: GeneratorRuntime,
    dynamic_eval_compiler: Ref[Option[DynamicEvalCompiler]],
    dynamic_module_loader: Ref[Option[DynamicModuleLoader]],
    depth: int,
) -> Result[runtime::Value, VmError] {
    let verification = bytecode::verify(function);
    if !verification.errors.is_empty() {
        return Result::Err(error(-1, VmErrorKind::VerificationFailed(verification.errors)))
    } else {};
    let stack = Vec::with_capacity(verification.max_stack);
    let arguments_object = Ref::new(Option::None);
    let frame_offset = Ref::new(0);
    active_frames.push(
        ActiveFrame {
            function,
            offset: frame_offset,
            stack,
            locals,
            upvalues,
            arguments,
            this_value,
            callee,
            home_object,
            new_target,
            instance_initializer,
            arguments_object,
            eval_environment,
        },
    );
    let machine = Machine {
        function,
        heap,
        functions,
        bound_functions,
        function_objects,
        template_objects,
        native_functions,
        native_constructor_functions,
        vm_functions,
        vm_constructor_functions,
        native_constructors,
        stack,
        locals,
        upvalues,
        global_object,
        primitive_prototypes,
        error_prototypes,
        object_builtin_tags,
        regexp_constructor,
        iterator_symbol,
        to_primitive_symbol,
        has_instance_symbol,
        callee,
        arguments,
        arguments_object,
        this_value,
        home_object,
        new_target,
        instance_initializer,
        eval_environment,
        active_frames,
        generators,
        dynamic_eval_compiler,
        dynamic_module_loader,
        depth,
    };
    let result = execute_machine(machine);
    let _ = active_frames.pop();
    result
}

fn execute_machine(machine: Machine) -> Result[runtime::Value, VmError] {
    match execute_machine_from(machine, 0)? {
        ExecutionResult::Return(value) => Result::Ok(value),
        ExecutionResult::Yield(_, offset) => Result::Err(
            error(offset, VmErrorKind::TypeError("yield escaped a generator frame")),
        ),
        ExecutionResult::Await(_, offset) => Result::Err(
            error(offset, VmErrorKind::TypeError("await escaped an async function frame")),
        ),
    }
}

fn execute_machine_from(machine: Machine, start: int) -> Result[ExecutionResult, VmError] {
    let mut offset = start;
    while offset >= 0 && offset < machine.function.code_len() {
        if !machine.active_frames.is_empty() {
            machine.active_frames[machine.active_frames.len() - 1].offset.set(offset);
        } else {};
        let instruction = match machine.function.instruction(offset) {
            Some(value) => value,
            None => return Result::Err(error(offset, VmErrorKind::InvalidJump(offset))),
        };
        match step(machine, offset, instruction) {
            Ok(StepResult::Continue(value)) => {
                offset = value;
            },
            Ok(StepResult::Yield(value, next)) => {
                return Result::Ok(ExecutionResult::Yield(value, next))
            },
            Ok(StepResult::Await(value, next)) => {
                return Result::Ok(ExecutionResult::Await(value, next))
            },
            Ok(StepResult::Return(value)) => return Result::Ok(ExecutionResult::Return(value)),
            Err(value) => if catchable(value.kind) {
                match handler_target(machine.function, offset) {
                    Some(target) => {
                        machine.stack.clear();
                        machine.stack.push(error_value_at(machine, value.kind, value.offset));
                        offset = target;
                    },
                    None => if machine.depth <= 0 {
                        return Result::Err(value)
                    } else {
                        return match value.kind {
                            VmErrorKind::CallDepthExceeded => Result::Err(value),
                            VmErrorKind::Thrown(thrown) => Result::Err(
                                error(
                                    value.offset,
                                    VmErrorKind::Thrown(
                                        ensure_error_stack(machine, thrown, value.offset),
                                    ),
                                ),
                            ),
                            kind => Result::Err(
                                error(
                                    value.offset,
                                    VmErrorKind::Thrown(error_value_at(machine, kind, value.offset)),
                                ),
                            ),
                        }
                    },
                }
            } else {
                return Result::Err(value)
            },
        }
    }
    Result::Err(error(offset, VmErrorKind::InvalidJump(offset)))
}

impl Context {
    pub fn execute(self: Context, function: bytecode::Function) -> Result[runtime::Value, VmError] {
        let global_this = match self.global_object_value.get() {
            Some(value) => runtime::Value::Object(value),
            None => runtime::Value::Undefined,
        };
        if function.local_count() < 0 {
            return execute_initialized(
                function,
                self.heap_value,
                self.functions_value,
                self.bound_functions_value,
                self.function_objects_value,
                self.template_objects_value,
                self.native_functions_value,
                self.native_constructor_functions_value,
                self.vm_functions_value,
                self.vm_constructor_functions_value,
                self.native_constructors_value,
                self.global_object_value.get(),
                self.primitive_prototypes_value,
                self.error_prototypes_value,
                self.object_builtin_tags_value,
                self.regexp_constructor_value.get(),
                self.iterator_symbol_value.get(),
                self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
                self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
                Option::None,
                Vec::[],
                Vec::[],
                Vec::[],
                Ref::new(Option::Some(global_this)),
                Option::None,
                Option::None,
                Ref::new(Option::None),
                Ref::new(Option::None),
                self.active_frames_value,
                self.generators_value,
                self.dynamic_eval_compiler_value,
                self.dynamic_module_loader_value,
                0,
            )
        } else {};
        let locals: Vec[Ref[runtime::Value]] = Vec::with_capacity(function.local_count());
        for _ in 0..function.local_count() {
            locals.push(Ref::new(runtime::Value::Undefined))
        }
        execute_initialized(
            function,
            self.heap_value,
            self.functions_value,
            self.bound_functions_value,
            self.function_objects_value,
            self.template_objects_value,
            self.native_functions_value,
            self.native_constructor_functions_value,
            self.vm_functions_value,
            self.vm_constructor_functions_value,
            self.native_constructors_value,
            self.global_object_value.get(),
            self.primitive_prototypes_value,
            self.error_prototypes_value,
            self.object_builtin_tags_value,
            self.regexp_constructor_value.get(),
            self.iterator_symbol_value.get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
            Option::None,
            Vec::[],
            locals,
            Vec::[],
            Ref::new(Option::Some(global_this)),
            Option::None,
            Option::None,
            Ref::new(Option::None),
            Ref::new(Option::None),
            self.active_frames_value,
            self.generators_value,
            self.dynamic_eval_compiler_value,
            self.dynamic_module_loader_value,
            0,
        )
    }

    pub fn execute_with_locals(
        self: Context,
        function: bytecode::Function,
        initial_locals: Vec[runtime::Value],
    ) -> Result[runtime::Value, VmError] {
        let locals: Vec[Ref[runtime::Value]] = Vec::with_capacity(initial_locals.len());
        for value in initial_locals {
            locals.push(Ref::new(value))
        }
        self.execute_with_local_cells(function, locals)
    }

    pub fn execute_with_local_cells(
        self: Context,
        function: bytecode::Function,
        initial_locals: Vec[Ref[runtime::Value]],
    ) -> Result[runtime::Value, VmError] {
        if function.local_count() < 0 {
            return execute_initialized(
                function,
                self.heap_value,
                self.functions_value,
                self.bound_functions_value,
                self.function_objects_value,
                self.template_objects_value,
                self.native_functions_value,
                self.native_constructor_functions_value,
                self.vm_functions_value,
                self.vm_constructor_functions_value,
                self.native_constructors_value,
                self.global_object_value.get(),
                self.primitive_prototypes_value,
                self.error_prototypes_value,
                self.object_builtin_tags_value,
                self.regexp_constructor_value.get(),
                self.iterator_symbol_value.get(),
                self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
                self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
                Option::None,
                Vec::[],
                Vec::[],
                Vec::[],
                Ref::new(Option::Some(runtime::Value::Undefined)),
                Option::None,
                Option::None,
                Ref::new(Option::None),
                Ref::new(Option::None),
                self.active_frames_value,
                self.generators_value,
                self.dynamic_eval_compiler_value,
                self.dynamic_module_loader_value,
                0,
            )
        } else {};
        if initial_locals.len() > function.local_count() {
            return Result::Err(error(-1, VmErrorKind::InvalidLocal(initial_locals.len() - 1)))
        } else {};
        let locals: Vec[Ref[runtime::Value]] = Vec::with_capacity(function.local_count());
        for value in initial_locals {
            locals.push(value)
        }
        while locals.len() < function.local_count() {
            locals.push(Ref::new(runtime::Value::Undefined))
        }
        execute_initialized(
            function,
            self.heap_value,
            self.functions_value,
            self.bound_functions_value,
            self.function_objects_value,
            self.template_objects_value,
            self.native_functions_value,
            self.native_constructor_functions_value,
            self.vm_functions_value,
            self.vm_constructor_functions_value,
            self.native_constructors_value,
            self.global_object_value.get(),
            self.primitive_prototypes_value,
            self.error_prototypes_value,
            self.object_builtin_tags_value,
            self.regexp_constructor_value.get(),
            self.iterator_symbol_value.get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
            Option::None,
            Vec::[],
            locals,
            Vec::[],
            Ref::new(Option::Some(runtime::Value::Undefined)),
            Option::None,
            Option::None,
            Ref::new(Option::None),
            Ref::new(Option::None),
            self.active_frames_value,
            self.generators_value,
            self.dynamic_eval_compiler_value,
            self.dynamic_module_loader_value,
            0,
        )
    }

    pub fn execute_async_with_local_cells(
        self: Context,
        function: bytecode::Function,
        initial_locals: Vec[Ref[runtime::Value]],
    ) -> Result[runtime::Value, VmError] {
        if !function.asynchronous() || function.generator() {
            return Result::Err(
                error(-1, VmErrorKind::TypeError("function is not an async module body")),
            )
        } else if initial_locals.len() > function.local_count() {
            return Result::Err(error(-1, VmErrorKind::InvalidLocal(initial_locals.len() - 1)))
        } else {};
        let verification = bytecode::verify(function);
        if !verification.errors.is_empty() {
            return Result::Err(error(-1, VmErrorKind::VerificationFailed(verification.errors)))
        } else {};
        let locals: Vec[Ref[runtime::Value]] = Vec::with_capacity(function.local_count());
        for value in initial_locals {
            locals.push(value)
        }
        while locals.len() < function.local_count() {
            locals.push(Ref::new(runtime::Value::Undefined))
        }
        let prototype = match self.generators_value.prototype.get() {
            Some(value) => Option::Some(value),
            None => self.heap_value.object_prototype(),
        };
        let generator = match runtime::new_ordinary_object(self.heap_value, prototype) {
            Ok(value) => value,
            Err(value) => {
                return Result::Err(error(-1, VmErrorKind::TypeError(value.message)))
            },
        };
        self.generators_value.states[generator] = GeneratorFrame {
            function,
            stack: Vec::with_capacity(verification.max_stack),
            locals,
            upvalues: Vec::[],
            arguments: Vec::[],
            this_value: Ref::new(Option::Some(runtime::Value::Undefined)),
            callee: Option::None,
            home_object: Option::None,
            new_target: Option::None,
            instance_initializer: Ref::new(Option::None),
            arguments_object: Ref::new(Option::None),
            request_roots: Ref::new(Vec::[]),
            offset: Ref::new(0),
            status: Ref::new(GeneratorStatus::SuspendedStart),
            depth: 1,
            eval_environment: Ref::new(Option::None),
        };
        let suspended = runtime::Value::Object(generator);
        match self.generators_value.async_function_runner.get() {
            Some(runner) => runner(suspended, 0),
            None => Result::Err(
                error(-1, VmErrorKind::TypeError("async function runner is not installed")),
            ),
        }
    }

    pub fn invoke_with_this_at_depth(
        self: Context,
        callable: runtime::Value,
        arguments: Vec[runtime::Value],
        this_value: runtime::Value,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        let code: Vec[bytecode::Instruction] = Vec::[
            bytecode::Instruction::GetLoc(0),
            bytecode::Instruction::GetLoc(1),
        ];
        let mut index = 0;
        while index < arguments.len() {
            code.push(bytecode::Instruction::GetLoc(index + 2));
            index += 1;
        }
        code.push(bytecode::Instruction::CallMethod(arguments.len()));
        code.push(bytecode::Instruction::Return);
        let locals: Vec[Ref[runtime::Value]] = Vec::with_capacity(arguments.len() + 2);
        locals.push(Ref::new(this_value));
        locals.push(Ref::new(callable));
        for value in arguments {
            locals.push(Ref::new(value))
        }
        execute_initialized(
            bytecode::Function::new(Vec::[], code, locals.len()),
            self.heap_value,
            self.functions_value,
            self.bound_functions_value,
            self.function_objects_value,
            self.template_objects_value,
            self.native_functions_value,
            self.native_constructor_functions_value,
            self.vm_functions_value,
            self.vm_constructor_functions_value,
            self.native_constructors_value,
            self.global_object_value.get(),
            self.primitive_prototypes_value,
            self.error_prototypes_value,
            self.object_builtin_tags_value,
            self.regexp_constructor_value.get(),
            self.iterator_symbol_value.get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
            Option::None,
            Vec::[],
            locals,
            Vec::[],
            Ref::new(Option::Some(runtime::Value::Undefined)),
            Option::None,
            Option::None,
            Ref::new(Option::None),
            Ref::new(Option::None),
            self.active_frames_value,
            self.generators_value,
            self.dynamic_eval_compiler_value,
            self.dynamic_module_loader_value,
            depth,
        )
    }

    fn instruction_at_depth(
        self: Context,
        values: Vec[runtime::Value],
        instruction: bytecode::Instruction,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        let code: Vec[bytecode::Instruction] = Vec::with_capacity(values.len() + 2);
        let locals: Vec[Ref[runtime::Value]] = Vec::with_capacity(values.len());
        let mut index = 0;
        while index < values.len() {
            code.push(bytecode::Instruction::GetLoc(index));
            locals.push(Ref::new(values[index]));
            index += 1;
        }
        code.push(instruction);
        code.push(bytecode::Instruction::Return);
        execute_initialized(
            bytecode::Function::new(Vec::[], code, locals.len()),
            self.heap_value,
            self.functions_value,
            self.bound_functions_value,
            self.function_objects_value,
            self.template_objects_value,
            self.native_functions_value,
            self.native_constructor_functions_value,
            self.vm_functions_value,
            self.vm_constructor_functions_value,
            self.native_constructors_value,
            self.global_object_value.get(),
            self.primitive_prototypes_value,
            self.error_prototypes_value,
            self.object_builtin_tags_value,
            self.regexp_constructor_value.get(),
            self.iterator_symbol_value.get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
            Option::None,
            Vec::[],
            locals,
            Vec::[],
            Ref::new(Option::Some(runtime::Value::Undefined)),
            Option::None,
            Option::None,
            Ref::new(Option::None),
            Ref::new(Option::None),
            self.active_frames_value,
            self.generators_value,
            self.dynamic_eval_compiler_value,
            self.dynamic_module_loader_value,
            depth,
        )
    }

    pub fn reflect_get_at_depth(
        self: Context,
        target: runtime::Value,
        key: runtime::Value,
        receiver: runtime::Value,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        self.instruction_at_depth(
            Vec::[target, key, receiver],
            bytecode::Instruction::ReflectGet,
            depth,
        )
    }

    pub fn reflect_set_at_depth(
        self: Context,
        target: runtime::Value,
        key: runtime::Value,
        value: runtime::Value,
        receiver: runtime::Value,
        depth: int,
    ) -> Result[bool, VmError] {
        match self.instruction_at_depth(
            Vec::[target, key, value, receiver],
            bytecode::Instruction::ReflectSet,
            depth,
        )? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(error(-1, VmErrorKind::TypeError("Reflect.set returned no status"))),
        }
    }

    pub fn construct_with_new_target_at_depth(
        self: Context,
        constructor: runtime::Value,
        arguments: Vec[runtime::Value],
        new_target: runtime::Value,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        let argument_count = arguments.len();
        let values: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 2);
        values.push(constructor);
        values.push(new_target);
        for value in arguments {
            values.push(value)
        }
        self.instruction_at_depth(
            values,
            bytecode::Instruction::ConstructWithNewTarget(argument_count),
            depth,
        )
    }

    pub fn read_property_at_depth(
        self: Context,
        receiver: runtime::Value,
        key: runtime::Value,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        let locals: Vec[Ref[runtime::Value]] = Vec::[Ref::new(receiver), Ref::new(key)];
        execute_initialized(
            bytecode::Function::new(
                Vec::[],
                Vec::[
                    bytecode::Instruction::GetLoc(0),
                    bytecode::Instruction::GetLoc(1),
                    bytecode::Instruction::GetArrayEl,
                    bytecode::Instruction::Return,
                ],
                locals.len(),
            ),
            self.heap_value,
            self.functions_value,
            self.bound_functions_value,
            self.function_objects_value,
            self.template_objects_value,
            self.native_functions_value,
            self.native_constructor_functions_value,
            self.vm_functions_value,
            self.vm_constructor_functions_value,
            self.native_constructors_value,
            self.global_object_value.get(),
            self.primitive_prototypes_value,
            self.error_prototypes_value,
            self.object_builtin_tags_value,
            self.regexp_constructor_value.get(),
            self.iterator_symbol_value.get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
            Option::None,
            Vec::[],
            locals,
            Vec::[],
            Ref::new(Option::Some(runtime::Value::Undefined)),
            Option::None,
            Option::None,
            Ref::new(Option::None),
            Ref::new(Option::None),
            self.active_frames_value,
            self.generators_value,
            self.dynamic_eval_compiler_value,
            self.dynamic_module_loader_value,
            depth,
        )
    }

    pub fn has_property_at_depth(
        self: Context,
        target: runtime::Value,
        key: runtime::Value,
        depth: int,
    ) -> Result[bool, VmError] {
        match self.instruction_at_depth(Vec::[key, target], bytecode::Instruction::In, depth)? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(error(-1, VmErrorKind::TypeError("property test returned no status"))),
        }
    }

    pub fn delete_property_at_depth(
        self: Context,
        target: runtime::Value,
        key: runtime::Value,
        depth: int,
    ) -> Result[bool, VmError] {
        match self.instruction_at_depth(Vec::[target, key], bytecode::Instruction::Delete, depth)? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(
                error(-1, VmErrorKind::TypeError("property deletion returned no status")),
            ),
        }
    }

    pub fn own_keys_at_depth(self: Context, target: runtime::Value, depth: int) -> Result[
        runtime::Value,
        VmError,
    ] {
        self.instruction_at_depth(Vec::[target], bytecode::Instruction::OwnKeys, depth)
    }

    pub fn get_prototype_of_at_depth(self: Context, target: runtime::Value, depth: int) -> Result[
        runtime::Value,
        VmError,
    ] {
        self.instruction_at_depth(Vec::[target], bytecode::Instruction::GetPrototypeOf, depth)
    }

    pub fn instance_of_at_depth(
        self: Context,
        candidate: runtime::Value,
        constructor: runtime::Value,
        depth: int,
    ) -> Result[bool, VmError] {
        match self.instruction_at_depth(
            Vec::[candidate, constructor],
            bytecode::Instruction::InstanceOf,
            depth,
        )? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(error(-1, VmErrorKind::TypeError("instance test returned no status"))),
        }
    }

    pub fn ordinary_has_instance_at_depth(
        self: Context,
        constructor: runtime::Value,
        candidate: runtime::Value,
        depth: int,
    ) -> Result[bool, VmError] {
        let object = match constructor {
            runtime::Value::Object(value) => if value.is_callable()
                && self.heap_value.contains(value) {
                value
            } else {
                return Result::Ok(false)
            },
            _ => return Result::Ok(false),
        };
        match self.bound_functions_value.get(object) {
            Some(bound) => return self.instance_of_at_depth(candidate, bound.target, depth),
            None => (),
        };
        match candidate {
            runtime::Value::Object(_) => (),
            _ => return Result::Ok(false),
        };
        let prototype = match self.read_property_at_depth(
            constructor,
            runtime::Value::String(js_string("prototype")),
            depth,
        )? {
            runtime::Value::Object(value) => runtime::Value::Object(value),
            _ => return Result::Err(
                error(-1, VmErrorKind::TypeError("constructor prototype is not an object")),
            ),
        };
        self.is_prototype_of_at_depth(prototype, candidate, depth)
    }

    pub fn is_prototype_of_at_depth(
        self: Context,
        prototype: runtime::Value,
        candidate: runtime::Value,
        depth: int,
    ) -> Result[bool, VmError] {
        match self.instruction_at_depth(
            Vec::[prototype, candidate],
            bytecode::Instruction::IsPrototypeOf,
            depth,
        )? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(error(-1, VmErrorKind::TypeError("prototype test returned no status"))),
        }
    }

    pub fn set_prototype_of_at_depth(
        self: Context,
        target: runtime::Value,
        prototype: runtime::Value,
        depth: int,
    ) -> Result[bool, VmError] {
        match self.instruction_at_depth(
            Vec::[target, prototype],
            bytecode::Instruction::SetPrototypeOf,
            depth,
        )? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(
                error(-1, VmErrorKind::TypeError("prototype update returned no status")),
            ),
        }
    }

    pub fn is_extensible_at_depth(self: Context, target: runtime::Value, depth: int) -> Result[
        bool,
        VmError,
    ] {
        match self.instruction_at_depth(Vec::[target], bytecode::Instruction::IsExtensible, depth)? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(
                error(-1, VmErrorKind::TypeError("extensibility test returned no status")),
            ),
        }
    }

    pub fn prevent_extensions_at_depth(self: Context, target: runtime::Value, depth: int) -> Result[
        bool,
        VmError,
    ] {
        match self.instruction_at_depth(
            Vec::[target],
            bytecode::Instruction::PreventExtensions,
            depth,
        )? {
            runtime::Value::Bool(value) => Result::Ok(value),
            _ => Result::Err(
                error(-1, VmErrorKind::TypeError("prevent extensions returned no status")),
            ),
        }
    }

    pub fn create_data_property_at_depth(
        self: Context,
        receiver: runtime::Value,
        key: runtime::Value,
        value: runtime::Value,
        depth: int,
    ) -> Result[unit, VmError] {
        let locals: Vec[Ref[runtime::Value]] = Vec::[Ref::new(key), Ref::new(value)];
        match execute_initialized(
            bytecode::Function::new(
                Vec::[],
                Vec::[
                    bytecode::Instruction::GetLoc(0),
                    bytecode::Instruction::GetLoc(1),
                    bytecode::Instruction::DefineThisFieldComputed,
                    bytecode::Instruction::ReturnUndef,
                ],
                locals.len(),
            ),
            self.heap_value,
            self.functions_value,
            self.bound_functions_value,
            self.function_objects_value,
            self.template_objects_value,
            self.native_functions_value,
            self.native_constructor_functions_value,
            self.vm_functions_value,
            self.vm_constructor_functions_value,
            self.native_constructors_value,
            self.global_object_value.get(),
            self.primitive_prototypes_value,
            self.error_prototypes_value,
            self.object_builtin_tags_value,
            self.regexp_constructor_value.get(),
            self.iterator_symbol_value.get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
            Option::None,
            Vec::[],
            locals,
            Vec::[],
            Ref::new(Option::Some(receiver)),
            Option::None,
            Option::None,
            Ref::new(Option::None),
            Ref::new(Option::None),
            self.active_frames_value,
            self.generators_value,
            self.dynamic_eval_compiler_value,
            self.dynamic_module_loader_value,
            depth,
        ) {
            Ok(_) => Result::Ok(()),
            Err(value) => Result::Err(value),
        }
    }

    fn primitive_at_depth(
        self: Context,
        value: runtime::Value,
        instruction: bytecode::Instruction,
        depth: int,
    ) -> Result[runtime::Value, VmError] {
        let locals: Vec[Ref[runtime::Value]] = Vec::[Ref::new(value)];
        execute_initialized(
            bytecode::Function::new(
                Vec::[],
                Vec::[bytecode::Instruction::GetLoc(0), instruction, bytecode::Instruction::Return],
                1,
            ),
            self.heap_value,
            self.functions_value,
            self.bound_functions_value,
            self.function_objects_value,
            self.template_objects_value,
            self.native_functions_value,
            self.native_constructor_functions_value,
            self.vm_functions_value,
            self.vm_constructor_functions_value,
            self.native_constructors_value,
            self.global_object_value.get(),
            self.primitive_prototypes_value,
            self.error_prototypes_value,
            self.object_builtin_tags_value,
            self.regexp_constructor_value.get(),
            self.iterator_symbol_value.get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::ToPrimitive).get(),
            self.well_known_symbols_value.slot(WellKnownSymbolKind::HasInstance).get(),
            Option::None,
            Vec::[],
            locals,
            Vec::[],
            Ref::new(Option::Some(runtime::Value::Undefined)),
            Option::None,
            Option::None,
            Ref::new(Option::None),
            Ref::new(Option::None),
            self.active_frames_value,
            self.generators_value,
            self.dynamic_eval_compiler_value,
            self.dynamic_module_loader_value,
            depth,
        )
    }

    pub fn to_primitive_default_at_depth(self: Context, value: runtime::Value, depth: int) -> Result[
        runtime::Value,
        VmError,
    ] {
        self.primitive_at_depth(value, bytecode::Instruction::ToPrimitiveDefault, depth)
    }

    pub fn to_primitive_number_at_depth(self: Context, value: runtime::Value, depth: int) -> Result[
        runtime::Value,
        VmError,
    ] {
        self.primitive_at_depth(value, bytecode::Instruction::ToPrimitiveNumber, depth)
    }

    pub fn to_primitive_string_at_depth(self: Context, value: runtime::Value, depth: int) -> Result[
        runtime::Value,
        VmError,
    ] {
        self.primitive_at_depth(value, bytecode::Instruction::ToPrimitiveString, depth)
    }
}

pub fn execute(function: bytecode::Function, heap: runtime::Heap) -> Result[runtime::Value, VmError] {
    Context::new(heap).execute(function)
}

pub fn execute_with_locals(
    function: bytecode::Function,
    heap: runtime::Heap,
    initial_locals: Vec[runtime::Value],
) -> Result[runtime::Value, VmError] {
    Context::new(heap).execute_with_locals(function, initial_locals)
}
