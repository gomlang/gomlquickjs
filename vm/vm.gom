    HasInstance,
    IsConcatSpreadable,
    Match,
    MatchAll,
    Replace,
    Search,
    Species,
    Split,
    ToPrimitive,
    ToStringTag,
    Unscopables,
}

struct WellKnownSymbols {
    async_iterator_value: Ref[Option[runtime::Symbol]],
    has_instance_value: Ref[Option[runtime::Symbol]],
    is_concat_spreadable_value: Ref[Option[runtime::Symbol]],
    match_value: Ref[Option[runtime::Symbol]],
    match_all_value: Ref[Option[runtime::Symbol]],
    replace_value: Ref[Option[runtime::Symbol]],
    search_value: Ref[Option[runtime::Symbol]],
    species_value: Ref[Option[runtime::Symbol]],
    split_value: Ref[Option[runtime::Symbol]],
    to_primitive_value: Ref[Option[runtime::Symbol]],
    to_string_tag_value: Ref[Option[runtime::Symbol]],
    unscopables_value: Ref[Option[runtime::Symbol]],
}

impl WellKnownSymbols {
    fn new() -> WellKnownSymbols {
        WellKnownSymbols {
            async_iterator_value: Ref::new(Option::None),
            has_instance_value: Ref::new(Option::None),
            is_concat_spreadable_value: Ref::new(Option::None),
            match_value: Ref::new(Option::None),
            match_all_value: Ref::new(Option::None),
            replace_value: Ref::new(Option::None),
            search_value: Ref::new(Option::None),
            species_value: Ref::new(Option::None),
            split_value: Ref::new(Option::None),
            to_primitive_value: Ref::new(Option::None),
            to_string_tag_value: Ref::new(Option::None),
            unscopables_value: Ref::new(Option::None),
        }
    }

    fn slot(self: WellKnownSymbols, kind: WellKnownSymbolKind) -> Ref[Option[runtime::Symbol]] {
        match kind {
            WellKnownSymbolKind::AsyncIterator => self.async_iterator_value,
            WellKnownSymbolKind::HasInstance => self.has_instance_value,
            WellKnownSymbolKind::IsConcatSpreadable => self.is_concat_spreadable_value,
            WellKnownSymbolKind::Match => self.match_value,
            WellKnownSymbolKind::MatchAll => self.match_all_value,
            WellKnownSymbolKind::Replace => self.replace_value,
            WellKnownSymbolKind::Search => self.search_value,
            WellKnownSymbolKind::Species => self.species_value,
            WellKnownSymbolKind::Split => self.split_value,
            WellKnownSymbolKind::ToPrimitive => self.to_primitive_value,
            WellKnownSymbolKind::ToStringTag => self.to_string_tag_value,
            WellKnownSymbolKind::Unscopables => self.unscopables_value,
        }
    }
}

