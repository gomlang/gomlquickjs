package bytecode;

use gomlang::quickjs::runtime;

pub struct TemplateConstant {
    cooked_value: Vec[Option[runtime::JsString]],
    raw_value: Vec[runtime::JsString],
}

impl TemplateConstant {
    pub fn new(cooked: Vec[Option[runtime::JsString]], raw: Vec[runtime::JsString]) -> TemplateConstant {
        TemplateConstant { cooked_value: cooked, raw_value: raw }
    }

    pub fn cooked(self: TemplateConstant) -> Vec[Option[runtime::JsString]] {
        self.cooked_value
    }

    pub fn raw(self: TemplateConstant) -> Vec[runtime::JsString] {
        self.raw_value
    }
}

pub enum Constant {
    Float(f64),
    String(runtime::JsString),
    BigInt(runtime::BigInt),
    Function(Ref[Function]),
    Template(Ref[TemplateConstant]),
}

#[derive(PartialEq, Eq, Debug)]
pub enum UpvalueSource {
    Local(isize),
    Upvalue(isize),
    Closure,
    This,
    Arguments,
}

pub struct EvalBinding {
    pub name: string,
    pub source: UpvalueSource,
    pub variable: bool,
    pub writable: bool,
    pub named_function: bool,
    pub declaration_target: bool,
    pub environment_depth: isize,
}

#[derive(PartialEq, Eq, Debug)]
pub enum EvalDeclarationKind {
    Var,
    Function,
}

pub struct EvalDeclaration {
    pub name: string,
    pub kind: EvalDeclarationKind,
}

#[derive(PartialEq, Eq, Debug)]
pub enum ScriptBindingKind {
    Let,
    Const,
    Var,
    Function,
}

pub struct ScriptBinding {
    pub name: string,
    pub kind: ScriptBindingKind,
}

#[derive(PartialEq, Eq, Debug)]
pub struct ExceptionHandler {
    pub start: isize,
    pub end: isize,
    pub target: isize,
}

#[derive(PartialEq, Eq, Debug)]
pub struct GeneratorReturnHandler {
    pub yield_offset: isize,
    pub throw_target: isize,
    pub target: isize,
}

#[derive(PartialEq, Eq, Debug)]
pub enum Instruction {
    PushI32(i32),
    PushConst(isize),
    Undefined,
    Null,
    PushFalse,
    PushTrue,
    PushThis,
    PushNewTarget,
    PushArguments,
    PushRest(isize),
    NewObject,
    NewArray(isize),
    NewPrivateName,
    NewRegExp(isize, isize),
    ArrayAppend,
    ArrayAppendHole,
    ArrayAppendSpread,
    CopyDataProperties,
    CopyDataPropertiesExcluded(isize),
    Enumerate,
    EnumerableProperty,
    OwnKeys,
    GetPrototypeOf,
    SetPrototypeOf,
    IsExtensible,
    PreventExtensions,
    IteratorStart,
    AsyncIteratorStart,
    IteratorNext,
    IteratorNextValue,
    IteratorThrow,
    IteratorReturn,
    IteratorCallNext,
    IteratorCallNextValue,
    IteratorCallThrow,
    IteratorCallReturn,
    IteratorResult,
    IteratorThrowResult,
    IteratorClose,
    IteratorCloseThrow,
    Drop,
    Dup,
    GetLoc(isize),
    PutLoc(isize),
    SetLoc(isize),
    CloneLoc(isize),
    GetUpvalue(isize),
    PutUpvalue(isize),
    SetUpvalue(isize),
    GetGlobal(isize),
    SetGlobal(isize),
    DeleteGlobal(isize),
    GetEval(isize),
    GetEvalOrUndefined(isize),
    GetEvalOrUpvalue(isize, isize, isize),
    GetEvalOrArguments(isize, isize),
    SetEval(isize),
    SetEvalOrUpvalue(isize, isize, isize, bool, bool),
    DeleteEval(isize),
    DeleteEvalOrFalse(isize, isize),
    InitEval(isize),
    InitGlobalLexical(isize),
    EnterEvalEnvironment,
    GetField(isize),
    PutField(isize),
    DefineGetter(isize),
    DefineSetter(isize),
    DefineGetterComputed,
    DefineSetterComputed,
    DefineClassMethod(isize),
    DefineClassGetter(isize),
    DefineClassSetter(isize),
    DefineClassMethodComputed,
    DefineClassGetterComputed,
    DefineClassSetterComputed,
    DefineThisField(isize),
    DefineThisFieldComputed,
    DefineThisPrivateField,
    DefineThisPrivateMethod,
    DefineThisPrivateGetter,
    DefineThisPrivateSetter,
    SetClassInstanceInitializer,
    SetFunctionHomeObject,
    SetClassHeritage(bool),
    GetSuperField(isize),
    PutSuperField(isize),
    GetSuperEl,
    PutSuperEl,
    GetArrayEl,
    PutArrayEl,
    ReflectGet,
    ReflectSet,
    GetPrivate,
    PutPrivate,
    HasPrivate,
    Call(isize),
    CallMethod(isize),
    Construct(isize),
    ConstructWithNewTarget(isize),
    CallArray,
    CallMethodArray,
    ConstructArray,
    CallSuper(isize),
    CallSuperArray,
    Eval(isize, isize),
    DynamicImport,
    InitializeInstanceFields,
    Await,
    Yield,
    Return,
    ReturnUndef,
    Throw,
    ThrowTypeError,
    ThrowReferenceError,
    IfFalse(isize),
    IfTrue(isize),
    Goto(isize),
    Neg,
    Plus,
    LNot,
    Not,
    TypeOf,
    ToPrimitiveDefault,
    ToPrimitiveNumber,
    ToPrimitiveString,
    ToPropertyKey,
    RequireObjectCoercible,
    Delete,
    Mul,
    Div,
    Mod,
    Add,
    Sub,
    Pow,
    Shl,
    Sar,
    Shr,
    Lt,
    Lte,
    Gt,
    Gte,
    Eq,
    Neq,
    StrictEq,
