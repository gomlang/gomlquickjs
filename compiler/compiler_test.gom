    match execute_source_with_builtins(
        "let map = new Map(); map.set('a', 1); map.set('b', 2); let iterator = map.entries(); let first = iterator.next().value; map.delete('b'); map.set('c', 3); map.set('b', 4); let rest = []; for (let entry of iterator) rest.push(entry[0] + entry[1]); let all = []; for (let entry of map) all.push(entry[0] + entry[1]); let set = new Set(); set.add('a'); set.add('b'); let values = set.values(); let firstSet = values.next().value; set.delete('b'); set.add('c'); set.add('b'); let restSet = []; for (let value of values) restSet.push(value); let pairs = []; for (let pair of set.entries()) pairs.push(pair[0] + pair[1]); return map.size === 3 && first[0] === 'a' && first[1] === 1 && rest.join(',') === 'c3,b4' && all.join(',') === 'a1,c3,b4' && map[Symbol.iterator] === map.entries && set.size === 3 && firstSet === 'a' && restSet.join(',') === 'c,b' && pairs.join(',') === 'aa,cc,bb' && set.keys === set.values && set[Symbol.iterator] === set.values;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected live Map and Set iterator result"),
    }
}

#[test]
fn map_and_set_constructors_consume_iterables_and_require_new() -> unit {
    match execute_source_with_builtins(
        "let map = new Map([['a', 1], ['b', 2], ['a', 3]]); let set = new Set('😀x😀'); let additions = 0; class DerivedMap extends Map { set(key, value) { additions += 1; return super.set(key, value); } } let derived = new DerivedMap([['key', 7], ['next', 8]]); let closes = 0; let invalid = {[Symbol.iterator]() { return {next() { return {value: 1, done: false}; }, return() { closes += 1; return {}; }}; }}; let invalidFailed = false; try { new Map(invalid); } catch (error) { invalidFailed = error instanceof TypeError; } let callFailed = false; try { Map(); } catch (error) { callFailed = error instanceof TypeError; } return map.size === 2 && map.get('a') === 3 && Array.from(map.keys()).join(',') === 'a,b' && set.size === 2 && Array.from(set).join(',') === '😀,x' && derived instanceof DerivedMap && derived instanceof Map && derived.get('key') === 7 && derived.get('next') === 8 && additions === 2 && invalidFailed && closes === 1 && callFailed;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected iterable Map and Set constructor result"),
    }
}

#[test]
fn map_and_set_for_each_use_live_order_and_standard_arguments() -> unit {
    match execute_source_with_builtins(
        "let map = new Map([['a', 1], ['b', 2]]); let receiver = {prefix: 'm'}; let mapped = []; map.forEach(function(value, key, collection) { mapped.push(this.prefix + key + value + (collection === map)); if (key === 'a') { collection.delete('b'); collection.set('c', 3); } }, receiver); let set = new Set(['a', 'b']); let selected = []; set.forEach(function(value, key, collection) { selected.push(value + key + (collection === set)); if (value === 'a') { collection.delete('b'); collection.add('c'); } }); return mapped.join(',') === 'ma1true,mc3true' && selected.join(',') === 'aatrue,cctrue';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Map and Set forEach result"),
    }
}

#[test]
fn modern_map_grouping_upsert_and_species_execute() -> unit {
    match execute_source_with_builtins(
        "let indices = ''; let grouped = Map.groupBy([1, 2, 3, 4], function(value, index) { indices += index; return value % 2; }); let groupedFromSet = Set.groupBy(['aa', 'b', 'cc'], value => value.length); let map = new Map([['present', 1]]); let calls = 0; let present = map.getOrInsertComputed('present', function() { calls += 1; return 9; }); let inserted = map.getOrInsert('plain', 2); let computed = map.getOrInsertComputed('computed', function(key) { calls += 1; map.set(key, 'side'); return key + '-value'; }); let key = {}; let weak = new WeakMap(); let weakInserted = weak.getOrInsert(key, 3); let weakComputed = weak.getOrInsertComputed(key, function() { calls += 1; return 4; }); let rejected = false; try { weak.getOrInsertComputed(1, function() { return 5; }); } catch (error) { rejected = error instanceof TypeError; } let mapSpecies = Object.getOwnPropertyDescriptor(Map, Symbol.species); let setSpecies = Object.getOwnPropertyDescriptor(Set, Symbol.species); return grouped instanceof Map && grouped.get(1).join(',') === '1,3' && grouped.get(0).join(',') === '2,4' && groupedFromSet instanceof Map && groupedFromSet.get(2).join(',') === 'aa,cc' && indices === '0123' && present === 1 && inserted === 2 && computed === 'computed-value' && map.get('computed') === 'computed-value' && calls === 1 && weakInserted === 3 && weakComputed === 3 && rejected && Map.groupBy.length === 2 && Set.groupBy.length === 2 && map.getOrInsert.length === 2 && map.getOrInsertComputed.length === 2 && weak.getOrInsert.length === 2 && weak.getOrInsertComputed.length === 2 && mapSpecies.get.call(Map) === Map && !mapSpecies.enumerable && mapSpecies.configurable && setSpecies.get.call(Set) === Set && !setSpecies.enumerable && setSpecies.configurable;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected modern Map result"),
    }
}

#[test]
fn modern_set_composition_and_relations_execute() -> unit {
    match execute_source_with_builtins(
        "let left = new Set([1, 2, 3]); let right = new Set([3, 4]); let union = left.union(right); let intersection = left.intersection(right); let difference = left.difference(right); let symmetric = left.symmetricDifference(right); let relation = left.isSupersetOf(new Set([1, 2])) && new Set([1, 2]).isSubsetOf(left) && left.isDisjointFrom(new Set([8, 9])) && !left.isDisjointFrom(right); let log = ''; let setLike = {get size() { log += 's'; return 1; }, get has() { log += 'h'; return function(value) { log += 'H' + value; return value === 2; }; }, get keys() { log += 'k'; return function() { log += 'K'; return [2, 5][Symbol.iterator](); }; }}; let selected = new Set([1, 2]).intersection(setLike); let order = log; log = ''; let combined = new Set([1, 2]).union(setLike); let combinedOrder = log; let closed = 0; let iterable = {size: 1, has() { return false; }, keys() { let done = false; return {next() { if (done) return {done: true}; done = true; return {done: false, value: 2}; }, return() { closed += 1; return {}; }}; }}; let disjoint = new Set([1, 2, 3]).isDisjointFrom(iterable); return [...union].join(',') === '1,2,3,4' && [...intersection].join(',') === '3' && [...difference].join(',') === '1,2' && [...symmetric].join(',') === '1,2,4' && relation && [...selected].join(',') === '2' && order === 'shkK' && [...combined].join(',') === '1,2,5' && combinedOrder === 'shkK' && !disjoint && closed === 1 && union instanceof Set && Set.prototype.union.length === 1 && Set.prototype.intersection.length === 1 && Set.prototype.difference.length === 1 && Set.prototype.symmetricDifference.length === 1 && Set.prototype.isSubsetOf.length === 1;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected modern Set result"),
    }
}

