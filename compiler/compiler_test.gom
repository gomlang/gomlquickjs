#[test]
fn compiles_string_and_bigint_constants() -> unit {
    match execute_source("return \"go\" + \"ml\";") {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(text) => testing::assert_eq(text, "goml"),
            Err(error) => testing::fail(error.debug()),
        },
        _ => testing::fail("expected string"),
    };
    match execute_source("return 0x10n;") {
        runtime::Value::BigInt(value) => {
            testing::assert(!value.negative());
            testing::assert_eq(value.magnitude(), "16")
        },
        _ => testing::fail("expected BigInt"),
    }
}

