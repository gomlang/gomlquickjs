#[test]
fn await_context_and_async_constructors_report_compile_errors() -> unit {
    match compile("await 1;") {
        Ok(_) => testing::fail("expected await context error"),
        Err(errors) => testing::assert(
            has_message(errors, "await is only valid in async functions"),
        ),
    };
    match compile("class Invalid { async constructor() {} }") {
        Ok(_) => testing::fail("expected async constructor error"),
        Err(errors) => testing::assert(has_message(errors, "class constructor cannot be async")),
    }
}

