}

#[test]
fn quickjs_std_environment_eval_and_error_surface_execute() -> unit {
    match execute_source_with_builtins(
        "let name = 'GOML_QUICKJS_ENV_4D4B'; std.unsetenv(name); let missing = std.getenv(name) === undefined; let set = std.setenv(name, 42) === undefined; let visible = std.getenv(name) === '42' && std.getenviron()[name] === '42'; let pipe = std.popen('printf %s \"$GOML_QUICKJS_ENV_4D4B\"', 'r'); let inherited = pipe.readAsString(); pipe.close(); let evaluated = std.evalScript('var __std_eval_value_4d4b = 40; __std_eval_value_4d4b + 2'); let removed = std.unsetenv(name) === undefined && std.getenv(name) === undefined; return missing && set && visible && inherited === '42' && evaluated === 42 && globalThis.__std_eval_value_4d4b === 40 && removed && std.Error.EINVAL === 22 && std.Error.ENOENT === 2 && std.strerror(std.Error.ENOENT) === 'No such file or directory' && std.strerror(999) === 'Unknown error 999' && typeof std.in.readAsString === 'function' && typeof std.out.puts === 'function' && typeof std.err.printf === 'function' && std.out.flush() === undefined && std.out.tell() === -1 && std.out.tello() === -1n && std.out.fileno() === 1 && std.err.fileno() === 2 && std.out.error() === false && std.out.clearerr() === undefined && std.evalScript.length === 1 && std.getenv.length === 1 && std.setenv.length === 1;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected std environment and eval result"),
    }
}

