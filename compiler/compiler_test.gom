nYield.value === 6 && !returnYield.done && returnDone.value === 7 && returnDone.done && returned.length === 1 && returned[0] === 5 && missingThrowResult.value === true && !missingThrowResult.done && guardedDone.done && closed === 1 && immediateDone.value === 12 && immediateDone.done;",
