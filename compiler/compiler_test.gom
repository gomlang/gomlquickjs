package compiler;

use gomlang::quickjs::builtins;
use gomlang::quickjs::bytecode;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::num;
use std::testing;
use std::text;

fn expect_function(value: Result[bytecode::Function, Vec[CompileError]]) -> bytecode::Function {
    match value {
        Ok(function) => function,
        Err(errors) => {
            if errors.is_empty() {
                testing::fail("compilation failed without diagnostics")
            } else {
                testing::fail(errors[0].message)
            };
            bytecode::Function::new(Vec::[], Vec::[bytecode::Instruction::ReturnUndef], 0)
        },
    }
}

fn execute_source(source: string) -> runtime::Value {
    let function = expect_function(compile(source));
    match vm::execute(function, runtime::Heap::new()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn execute_source_with_builtins(source: string) -> runtime::Value {
    execute_source_with_builtins_named(source, "<input>")
}

fn execute_source_with_builtins_named(source: string, source_name: string) -> runtime::Value {
    let function = expect_function(compile_with_source_name(source, source_name));
    let context = vm::Context::new(runtime::Heap::new());
    install_dynamic_function_compiler(context);
    match builtins::install(context) {
        Ok(_) => (),
        Err(value) => testing::fail(value.message),
    };
    match context.execute(function) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn execute_source_with_builtins_jobs_property(source: string, name: string) -> runtime::Value {
    let function = expect_function(compile(source));
    let context = vm::Context::new(runtime::Heap::new());
    install_dynamic_function_compiler(context);
    match builtins::install(context) {
        Ok(_) => (),
        Err(value) => testing::fail(value.message),
    };
    let result = match context.execute(function) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    };
    match context.run_pending_jobs() {
        Ok(_) => (),
        Err(error) => testing::fail(error.kind.debug()),
    };
    let name_bytes = name.to_bytes();
    match context.read_property_at_depth(
        result,
        runtime::Value::String(runtime::JsString::from_utf8(name_bytes.slice(0, name_bytes.len()))),
        0,
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn expect_string(value: runtime::Value, expected: string) -> unit {
    match value {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, expected),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected string"),
    }
}

fn expect_int(value: runtime::Value, expected: int32) -> unit {
    match value {
        runtime::Value::Int(actual) => testing::assert_eq(actual, expected),
        runtime::Value::Float(actual) => {
            testing::assert_eq(actual, num::parse_float64(expected.to_string()).unwrap_or(0.0))
        },
        _ => testing::fail("expected number"),
    }
}

fn has_message(errors: Vec[CompileError], expected: string) -> bool {
    for error in errors {
        if text::find(error.message, expected).is_some() {
            return true
        } else {}
    }
    false
}

#[test]
fn compiles_arithmetic_precedence_end_to_end() -> unit {
    expect_int(execute_source("return 2 + 3 * 4;"), 14)
}

#[test]
fn compiles_locals_assignment_and_loop_end_to_end() -> unit {
    expect_int(
        execute_source(
            "let total = 0; let index = 0; while (index < 4) { total = total + index; index = index + 1; } return total;",
        ),
        6,
    )
}

#[test]
fn compiles_short_circuit_control_flow() -> unit {
    expect_int(
        execute_source(
            "let value = 0; false && (value = 1); true || (value = 2); null ?? (value = 3); return value;",
        ),
        3,
    );
    let function = expect_function(compile("let x = 1; return x && 2;"));
    let mut found_branch = false;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::IfFalse(_) => {
                found_branch = true;
            },
            _ => (),
        };
    }
    testing::assert(found_branch)
}

#[test]
fn compiles_conditional_and_sequence_expressions() -> unit {
    expect_int(
        execute_source(
            "let hits = 0; let value = (hits += 1, true ? (hits += 10, 7) : (hits += 100, 9)); let other = false ? (hits += 1000) : (hits += 2); return value * 100 + other;",
        ),
        713,
    )
}

#[test]
fn compiles_numeric_and_bitwise_compound_assignments() -> unit {
    expect_int(
        execute_source(
            "let value = 3; value += 5; value *= 2; value -= 4; value /= 3; value **= 3; value %= 10; value <<= 2; value >>= 1; value >>>= 1; value |= 8; value ^= 3; value &= 14; return value;",
        ),
        14,
    )
}

#[test]
fn logical_compound_assignments_short_circuit_writes() -> unit {
    expect_int(
        execute_source(
            "let hits = 0; let a = 0; a &&= (hits += 1); let b = 1; b ||= (hits += 2); let c = null; c ??= (hits += 4); let d = 5; d ??= (hits += 8); let e = 1; e &&= (hits += 16); let f = 0; f ||= (hits += 32); return hits + c + e + f;",
        ),
        128,
    )
}

#[test]
fn prefix_and_postfix_updates_convert_numbers_and_preserve_bigints() -> unit {
    match execute_source(
        "let number = '4'; let old_number = number++; let new_number = ++number; let bigint = 1n; let old_bigint = bigint++; let new_bigint = --bigint; return old_number === 4 && new_number === 6 && number === 6 && old_bigint === 1n && new_bigint === 1n && bigint === 1n;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected update result"),
    }
}

#[test]
fn member_assignments_evaluate_receiver_and_key_once() -> unit {
    expect_int(
        execute_source(
            "let object = { value: 1 }; let receiver_calls = 0; let key_calls = 0; function receiver() { receiver_calls += 1; return object; } function key() { key_calls += 1; return 'value'; } let assigned = receiver()[key()] += 4; let previous = receiver()[key()]++; let current = ++receiver()[key()]; return assigned * 10000 + previous * 1000 + current * 100 + receiver_calls * 10 + key_calls;",
        ),
        55733,
    )
}

#[test]
fn computed_object_keys_evaluate_before_values_once() -> unit {
    match execute_source(
        "let order = 0; function key() { order = order * 10 + 1; return 'value'; } function value() { order = order * 10 + 2; return 40; } let object = {[key()]: value() + 2}; return object.value === 42 && order === 12;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected computed object property result"),
    }
}

#[test]
fn object_methods_compile_as_receiver_aware_functions() -> unit {
    match execute_source(
        "let object = {base: 21, double(value) { return this.base * value; }, ['read']() { return this.base; }}; return object.double(2) === 42 && object.read() === 21;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected object method result"),
    }
}

#[test]
fn object_literal_getters_and_setters_share_accessor_descriptors() -> unit {
    match execute_source_with_builtins(
        "let stored = 1; let object = {get value() { return stored; }, set value(next) { stored = next; }, get doubled() { return this.value * 2; }}; object.value = 21; let descriptor = Object.getOwnPropertyDescriptor(object, 'value'); return object.value === 21 && object.doubled === 42 && typeof descriptor.get === 'function' && typeof descriptor.set === 'function' && Object.keys(object).join(',') === 'value,doubled';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected object accessor result"),
    }
}

#[test]
fn executes_object_literals_on_assignment_right_hand_sides() -> unit {
    match execute_source_with_builtins(
        "let value; value = {}; value = {get item() { return 4; }, set item(input) { this.saved = input; }}; let read = value.item; value.item = 7; if (read === 4) value = {id: value.saved}; else value = {}; return value.id === 7;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected object assignment result"),
    }
}

#[test]
fn preserves_surrogate_code_units_in_string_literals() -> unit {
    match execute_source_with_builtins(
        "let maximum = '\\u{10ffff}'; return '\\ud800'.charCodeAt(0) === 55296 && '\\udc00'.charCodeAt(0) === 56320 && '\\ud83d\\udc31'.length === 2 && '\\u{1f431}'.length === 2 && maximum.length === 2 && maximum === '\\u{dbff}\\u{dfff}';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected surrogate string result"),
    }
}

#[test]
fn computed_object_accessors_evaluate_keys_once_and_merge_descriptors() -> unit {
    match execute_source_with_builtins(
        "let keyHits = 0; let stored = 1; function key() { keyHits += 1; return 'value'; } let object = {get [key()]() { return stored; }, set [key()](next) { stored = next; }}; object.value = 42; let descriptor = Object.getOwnPropertyDescriptor(object, 'value'); return keyHits === 2 && object.value === 42 && typeof descriptor.get === 'function' && typeof descriptor.set === 'function';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected computed accessor result"),
    }
}

#[test]
fn function_prototype_call_apply_and_bind_preserve_this_arguments_and_throws() -> unit {
    match execute_source_with_builtins(
        "function sum(left, right) { return this.base + left + right; } let receiver = {base: 10}; let bound = sum.bind(receiver, 15); let token = {}; let caught = false; function fail() { throw token; } try { fail.call(null); } catch (error) { caught = error === token; } return sum.call(receiver, 15, 17) === 42 && sum.apply(receiver, [15, 17]) === 42 && bound(17) === 42 && sum instanceof Function && bound instanceof Function && Function.prototype instanceof Object && caught;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Function prototype result"),
    }
}

#[test]
fn bound_functions_forward_construction_new_target_and_instanceof() -> unit {
    match execute_source_with_builtins(
        "function Point(x, y) { this.x = x; this.y = y; } let receiver = {x: 99}; let Bound = Point.bind(receiver, 4); let point = new Bound(5); let Second = Bound.bind({x: 88}, 6); let second = new Second(); function Replacement(value) { this.ignored = value; return {value: value}; } let BoundReplacement = Replacement.bind(null, 7); let replacement = new BoundReplacement(); class Box { constructor(value) { this.value = value; } } let BoundBox = Box.bind(null, 9); let box = new BoundBox(); let classCallThrows = false; try { BoundBox(); } catch (error) { classCallThrows = error instanceof TypeError; } let BoundArray = Array.bind(null, 2); let array = new BoundArray(); let arrow = () => 1; let BoundArrow = arrow.bind(null); let arrowConstructThrows = false; try { new BoundArrow(); } catch (error) { arrowConstructThrows = error instanceof TypeError; } return point.x === 4 && point.y === 5 && receiver.x === 99 && point instanceof Point && point instanceof Bound && second.x === 4 && second.y === 6 && second instanceof Point && second instanceof Bound && second instanceof Second && replacement.value === 7 && replacement.ignored === undefined && box.value === 9 && box instanceof Box && box instanceof BoundBox && classCallThrows && array.length === 2 && array instanceof Array && Bound.length === 1 && Bound.prototype === undefined && arrowConstructThrows;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected bound constructor result"),
    }
}

#[test]
fn function_bind_reads_length_getters_and_preserves_abrupt_completion() -> unit {
    match execute_source_with_builtins(
        "let hits = 0; function target(first, second, third) {} Object.defineProperty(target, 'length', {configurable: true, get() { hits += 1; return 3.9; }}); let bound = target.bind(null, 1); function infinite() {} Object.defineProperty(infinite, 'length', {configurable: true, get() { return Infinity; }}); let infiniteBound = infinite.bind(null, 1); let token = {}; function fail() {} Object.defineProperty(fail, 'length', {configurable: true, get() { throw token; }}); let preserved = false; try { fail.bind(null); } catch (error) { preserved = error === token; } return bound.length === 2 && hits === 1 && infiniteBound.length === Infinity && preserved;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Function.bind length result"),
    }
}

#[test]
fn function_to_string_preserves_source_and_formats_native_callables() -> unit {
    expect_string(
        execute_source_with_builtins(
            "function ordinary(a){return a+1;} let arrow=x=>x; let object={m(a){return a;}}; class C{constructor(a){this.a=a;} static s(){} get x(){return 1;}} let getter=Object.getOwnPropertyDescriptor(C.prototype,'x').get; return [ordinary.toString(),arrow.toString(),object.m.toString(),C.toString(),C.s.toString(),getter.toString(),Function('a','return a + 1;').toString(),ordinary.bind(null).toString(),Math.max.toString(),Function.prototype.toString()].join('|');",
        ),
        "function ordinary(a){return a+1;}|x=>x|m(a){return a;}|class C{constructor(a){this.a=a;} static s(){} get x(){return 1;}}|s(){}|get x(){return 1;}|function anonymous(a\n) {\nreturn a + 1;\n}|function bound ordinary() {\n    [native code]\n}|function max() {\n    [native code]\n}|function () {\n    [native code]\n}",
    );
    expect_string(
        execute_source_with_builtins(
            "class D{static /*before*/ async *m(){}} return D.m.toString();",
        ),
        "async *m(){}",
    );
    expect_string(
        execute_source_with_builtins("function café(){return \"é\";} return café.toString();"),
        "function café(){return \"é\";}",
    );
    match execute_source_with_builtins(
        "try { Function.prototype.toString.call({}); } catch (error) { return error instanceof TypeError && Function.prototype.toString.name === 'toString' && Function.prototype.toString.length === 0; } return false;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Function toString validation"),
    }
}

#[test]
fn function_source_accessors_expose_quickjs_definition_metadata() -> unit {
    match execute_source_with_builtins_named(
        "\nfunction f(){}\nlet arrow=()=>1;\nclass C { constructor(){} static m(){} }\nlet dynamic=Function('return 1;');\nlet bound=f.bind(null);\nlet file=Object.getOwnPropertyDescriptor(Function.prototype,'fileName');\nlet line=Object.getOwnPropertyDescriptor(Function.prototype,'lineNumber');\nlet column=Object.getOwnPropertyDescriptor(Function.prototype,'columnNumber');\nreturn f.fileName==='named.js' && f.lineNumber===2 && f.columnNumber===1 && arrow.fileName==='named.js' && arrow.lineNumber===3 && arrow.columnNumber===11 && C.fileName==='named.js' && C.lineNumber===4 && C.columnNumber===11 && C.m.fileName==='named.js' && C.m.lineNumber===4 && C.m.columnNumber===34 && dynamic.fileName==='<input>' && dynamic.lineNumber===1 && dynamic.columnNumber===2 && bound.fileName===undefined && bound.lineNumber===undefined && bound.columnNumber===undefined && Math.max.fileName===undefined && file.get.name==='get fileName' && line.get.name==='get lineNumber' && column.get.name==='get columnNumber' && file.get.length===0 && line.get.length===0 && column.get.length===0 && !file.enumerable && file.configurable && file.set===undefined && file.get.call({})===undefined;",
        "named.js",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Function source metadata result"),
    }
}

#[test]
fn instanceof_dispatches_symbol_has_instance_and_exposes_the_default_method() -> unit {
    match execute_source_with_builtins(
        "let marker = {}; let calls = 0; let receiver = false; let handler = {[Symbol.hasInstance](value) { calls += 1; receiver = this === handler; return value === marker ? 1 : 0; }}; let direct = marker instanceof handler; let rejected = !({} instanceof handler); function Target() {} Object.defineProperty(Target, Symbol.hasInstance, {value(value) { return value === 7; }}); let bound = Target.bind(null); let delegated = 7 instanceof bound; let bad = false; try { marker instanceof {[Symbol.hasInstance]: 1}; } catch (error) { bad = error instanceof TypeError; } let token = {}; let abrupt = false; let throwing = {}; Object.defineProperty(throwing, Symbol.hasInstance, {get() { throw token; }}); try { marker instanceof throwing; } catch (error) { abrupt = error === token; } let method = Function.prototype[Symbol.hasInstance]; let descriptor = Object.getOwnPropertyDescriptor(Function.prototype, Symbol.hasInstance); return direct && rejected && calls === 2 && receiver && delegated && bad && abrupt && method.call({}, marker) === false && method.call(Array, []) && method.name === '[Symbol.hasInstance]' && method.length === 1 && !descriptor.writable && !descriptor.enumerable && !descriptor.configurable;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Symbol.hasInstance result"),
    }
}

#[test]
fn builtin_and_bound_functions_expose_standard_metadata() -> unit {
    match execute_source_with_builtins(
        "let functions = [Object, Object.create, Object.defineProperty, Object.fromEntries, Object.prototype.toString, Function, Function.prototype, Function.prototype.apply, Array, Array.from, Array.prototype.slice, String, String.fromCharCode, String.prototype.replace, Number, Number.isNaN, Number.prototype.toFixed, BigInt, Symbol, Symbol.for, Math.max, Math.abs, JSON.parse, JSON.stringify, RegExp, RegExp.prototype[Symbol.replace], Date, Date.UTC, Date.prototype.setHours, Map, Map.prototype.set, Set, Set.prototype.add, Promise, Promise.all, Promise.prototype.then, ArrayBuffer, DataView, Uint8Array]; let names = ['Object', 'create', 'defineProperty', 'fromEntries', 'toString', 'Function', '', 'apply', 'Array', 'from', 'slice', 'String', 'fromCharCode', 'replace', 'Number', 'isNaN', 'toFixed', 'BigInt', 'Symbol', 'for', 'max', 'abs', 'parse', 'stringify', 'RegExp', '[Symbol.replace]', 'Date', 'UTC', 'setHours', 'Map', 'set', 'Set', 'add', 'Promise', 'all', 'then', 'ArrayBuffer', 'DataView', 'Uint8Array']; let lengths = [1, 2, 3, 1, 0, 1, 0, 2, 1, 1, 2, 1, 1, 2, 1, 1, 1, 1, 0, 1, 2, 1, 2, 3, 2, 2, 7, 7, 4, 0, 2, 0, 1, 1, 1, 2, 1, 1, 3]; for (let i = 0; i < functions.length; i += 1) { let named = Object.getOwnPropertyDescriptor(functions[i], 'name'); let sized = Object.getOwnPropertyDescriptor(functions[i], 'length'); if (functions[i].name !== names[i] || functions[i].length !== lengths[i] || named.writable || named.enumerable || !named.configurable || sized.writable || sized.enumerable || !sized.configurable) return false; } let bound = Object.bind(null); let named = Object.getOwnPropertyDescriptor(bound, 'name'); return bound.name === 'bound Object' && bound.length === 1 && !named.writable && !named.enumerable && named.configurable;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected builtin function metadata result"),
    }
}

#[test]
fn builtin_metadata_batch_matches_quickjs_descriptors() -> unit {
    match execute_source_with_builtins(
        "let stringLength = Object.getOwnPropertyDescriptor(String.prototype, 'length'); let iteratorConstructor = Object.getOwnPropertyDescriptor(Iterator.prototype, 'constructor'); let objectProto = Object.getOwnPropertyDescriptor(Object.prototype, '__proto__'); let reflectTag = Object.getOwnPropertyDescriptor(Reflect, Symbol.toStringTag); let primitive = Date.prototype[Symbol.toPrimitive]; return Array.isArray.length === 1 && Object.is.length === 2 && BigInt.asIntN.length === 2 && BigInt.asUintN.length === 2 && WeakRef.length === 1 && WeakRef.prototype.constructor.length === 1 && FinalizationRegistry.length === 1 && FinalizationRegistry.prototype.constructor.length === 1 && FinalizationRegistry.prototype.register.length === 2 && FinalizationRegistry.prototype.unregister.length === 1 && RegExp.prototype.compile.length === 2 && RegExp.prototype[Symbol.matchAll].length === 1 && String.prototype.matchAll.length === 1 && !stringLength.writable && !stringLength.enumerable && stringLength.configurable && iteratorConstructor.get.length === 0 && iteratorConstructor.set.length === 0 && objectProto.get.length === 0 && objectProto.set.length === 1 && reflectTag.value === 'Reflect' && !reflectTag.writable && !reflectTag.enumerable && reflectTag.configurable && Date.prototype.toGMTString === Date.prototype.toUTCString && primitive.name === '[Symbol.toPrimitive]' && primitive.length === 1;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected QuickJS builtin metadata"),
    }
}

#[test]
fn dynamic_function_constructor_compiles_parameters_body_and_construction() -> unit {
    match execute_source_with_builtins(
