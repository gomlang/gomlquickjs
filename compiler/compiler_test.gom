#[test]
fn direct_eval_and_default_parameters_use_separate_linked_environments() -> unit {
    match execute_source_with_builtins(
        "let strictError = false; function strictFactory() { 'use strict'; return function(a = eval('var arguments')) {}; } try { strictFactory()(); } catch (error) { strictError = error instanceof SyntaxError; } let globalC = 'global'; let first = function(a = eval('var c = 1'), probe = () => c) { var c = 2; return c + ':' + probe(); }; let second = function(a = eval('var arguments = 1'), probe = () => arguments) { var arguments = 2; return arguments + ':' + probe(); }; let third = function named(a = eval('var c = 1'), b = c, probe = () => c) { return b + ':' + c + ':' + probe(); }; let fourth = function(a, b = globalC, probe = () => globalC) { eval('var globalC = 1'); return globalC + ':' + b + ':' + probe(); }; let fifth = function(a = eval('var c = 1'), probe = (value = eval('c')) => value) { return probe(); }; return strictError && first() === '2:1' && second() === '2:1' && third() === '1:1:1' && fourth() === '1:global:global' && fifth() === 1 && globalC === 'global';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected linked eval and parameter environments"),
    }
}

#[test]
fn runtime_computed_direct_eval_vars_survive_in_closures_and_are_deletable() -> unit {
    match execute_source_with_builtins(
        "function make(source) { let before = () => value; eval(source); return {value, before, after: () => value, plus, remove: () => delete value}; } function replace(source) { var target = () => 0; eval(source); return target(); } let first = make('var value = 40; function plus() { return value + 2; } value = plus();'); let second = make('var value = 7; function plus() { return value + 1; }'); let correct = first.value === 42 && first.before() === 42 && first.after() === 42 && first.plus() === 44 && second.before() === 7 && second.plus() === 8 && replace('function target() { return 9; }') === 9; let removed = first.remove(); let missing = false; try { first.after(); } catch (error) { missing = error instanceof ReferenceError; } return correct && removed && missing && second.after() === 7;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected persistent computed eval bindings"),
    }
}

#[test]
fn runtime_computed_eval_preserves_parameter_and_strict_environment_rules() -> unit {
    match execute_source_with_builtins(
        "let parameterSource = 'var c = 1'; let bodySource = 'var c = 2'; function run(a = eval(parameterSource), probe = () => c) { eval(bodySource); return c + ':' + probe(); } function strictRun(source) { 'use strict'; let result = eval(source); return result + ':' + typeof hidden; } return run() === '2:1' && strictRun('var hidden = 7; hidden') === '7:undefined' && typeof c === 'undefined';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected computed eval environment separation"),
    }
}

#[test]
fn runtime_computed_eval_rejects_lexical_conflicts_and_shadows_known_globals() -> unit {
    match execute_source_with_builtins(
        "function conflict(source) { let blocked = 1; try { eval(source); } catch (error) { return error instanceof SyntaxError && blocked === 1; } return false; } function sameSource(source) { try { eval(source); } catch (error) { return error instanceof SyntaxError; } return false; } function shadow(source) { let probe = () => Math; eval(source); return Math + ':' + probe(); } return conflict('var blocked = 2') && sameSource('var duplicate; let duplicate;') && shadow(\"var Math = 'shadowed'\") === 'shadowed:shadowed';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected computed eval conflict and shadowing semantics"),
    }
}

#[test]
fn runtime_computed_global_eval_vars_are_configurable_properties() -> unit {
    match execute_source_with_builtins(
        "let source = 'var created = 42'; eval(source); let result = created; let removed = delete created; return result === 42 && removed && typeof created === 'undefined';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected configurable global eval binding"),
    }
}

#[test]
fn runtime_computed_eval_environments_survive_gc_and_suspension() -> unit {
    match execute_source_with_builtins(
        "function* generate(source) { eval(source); yield retained.value; yield () => retained.value; } let iterator = generate('var retained = {value: 42}'); let first = iterator.next(); std.gc(); let second = iterator.next(); let reader = second.value; iterator.next(); std.gc(); let settled = 0; async function load(source) { eval(source); await 0; return retained.value; } load('var retained = {value: 43}').then(value => settled = value); std.gc(); Promise.drainJobs(); return first.value === 42 && reader() === 42 && settled === 43;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected rooted suspended eval environments"),
    }
}

#[test]
fn compiles_for_of_over_builtin_and_custom_iterables() -> unit {
    match execute_source_with_builtins(
        "let result = ''; for (let value of [1, , 3, 4]) { if (value === undefined) { result += 'u'; continue; } if (value === 4) break; result += value; } for (const char of '😀x') { result += char; } let nextReads = 0; let iterable = {[Symbol.iterator]() { let index = 0; let iterator = {}; Object.defineProperty(iterator, 'next', {get: function() { nextReads += 1; return function() { index += 1; if (index <= 2) { return {value: index * 10, done: false}; } return {done: true}; }; }}); return iterator; }}; for (var item of iterable) { result += item; } return result === '1u3😀x1020' && item === 20 && nextReads === 1;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected for-of result"),
    }
}

#[test]
fn compiles_for_in_with_ordering_shadowing_and_loop_control() -> unit {
    match execute_source_with_builtins(
        "let prototype = {inherited: 1, shadowed: 2}; let object = Object.create(prototype); object[2] = 'two'; object.first = 1; Object.defineProperty(object, 'shadowed', {value: 3, enumerable: false}); let symbol = Symbol('hidden'); object[symbol] = 4; let keys = []; for (let key in object) { if (key === 'first') continue; keys.push(key); if (key === 'inherited') break; } let arrayKeys = ''; for (const key in [1, , 3]) { arrayKeys += key; } let stringKeys = ''; for (var key in '😀x') { stringKeys += key; } let empty = true; for (let key in null) { empty = false; } return keys.join(',') === '2,inherited' && arrayKeys === '02' && stringKeys === '012' && key === '2' && empty;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected for-in result"),
    }
}

#[test]
fn compiles_do_while_continue_end_to_end() -> unit {
    expect_int(
        execute_source(
            "let i = 0; let total = 0; do { i = i + 1; if (i < 3) continue; total = total + i; } while (i < 4); return total;",
        ),
        7,
    )
}

#[test]
fn compiles_nested_loop_targets_end_to_end() -> unit {
    expect_int(
        execute_source(
            "let total = 0; for (let outer = 0; outer < 3; outer = outer + 1) { for (let inner = 0; inner < 4; inner = inner + 1) { if (inner == 1) continue; if (inner == 3) break; total = total + 1; } } return total;",
        ),
        6,
    )
}

#[test]
fn reports_break_and_continue_outside_loops() -> unit {
    match compile("break; continue; return 1;") {
        Err(errors) => {
            testing::assert_eq(errors.len(), 2);
            testing::assert(has_message(errors, "`break` is only valid inside a loop"));
            testing::assert(has_message(errors, "`continue` is only valid inside a loop"));
            for error in errors {
                testing::assert(error.span.start >= 0);
                testing::assert(error.span.end > error.span.start)
            }
        },
        Ok(_) => testing::fail("expected loop control diagnostics"),
    }
}

#[test]
fn compiles_switch_discriminant_once_with_strict_case_selection() -> unit {
    expect_int(
        execute_source(
            "let count = 0; let selected = 0; switch (count = count + 1) { case \"1\": selected = 99; break; case 1: selected = 7; break; default: selected = 9; } return count * 10 + selected;",
        ),
        17,
    );
    let function = expect_function(compile("switch (1) { case 1: break; }"));
    let mut found_strict_equal = false;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::StrictEq => {
                found_strict_equal = true;
            },
            _ => (),
        }
    }
    testing::assert(found_strict_equal)
}

#[test]
fn compiles_switch_default_fallthrough_and_break_end_to_end() -> unit {
    expect_int(
        execute_source(
            "let matched = 0; switch (2) { case \"2\": matched = 99; break; default: matched = 10; case 2: matched = matched + 2; case 3: matched = matched + 3; break; } let fallback = 0; switch (9) { case 1: fallback = 1; break; default: fallback = 10; case 2: fallback = fallback + 2; case 3: fallback = fallback + 3; break; } return matched * 100 + fallback;",
        ),
        515,
    )
}

#[test]
fn switch_break_and_continue_target_nearest_valid_construct() -> unit {
    expect_int(
        execute_source(
            "let total = 0; let i = 0; while (i < 4) { i = i + 1; switch (i) { case 1: continue; case 2: total = total + 2; break; default: total = total + 10; } total = total + 1; } return total;",
        ),
        25,
    )
}

#[test]
fn compiles_throw_to_vm_thrown_error_and_bytecode() -> unit {
    let function = expect_function(compile("throw 42;"));
    let mut found_throw = false;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::Throw => {
                found_throw = true;
            },
            _ => (),
        }
    }
    testing::assert(found_throw);
    match vm::execute(function, runtime::Heap::new()) {
        Err(vm::VmError { offset, kind: vm::VmErrorKind::Thrown(runtime::Value::Int(value)) }) => {
            testing::assert_eq(value, 42);
            testing::assert(offset >= 0)
        },
        Err(error) => testing::fail(error.kind.debug()),
        Ok(_) => testing::fail("expected thrown VM error"),
    }
}

#[test]
fn reports_switch_and_throw_syntax_errors_without_losing_following_code() -> unit {
    match compile("switch (1) { default: break; default: break; } throw\n1; missing;") {
        Err(errors) => {
            testing::assert(has_message(errors, "duplicate `default` clause"));
            testing::assert(has_message(errors, "line terminator is not allowed after `throw`"))
        },
        Ok(_) => testing::fail("expected recoverable switch and throw diagnostics"),
    }
}

#[test]
fn catches_explicit_values_and_nested_function_exceptions() -> unit {
    expect_int(execute_source("try { throw 42; } catch (value) { return value; }"), 42);
    expect_int(
        execute_source(
            "function inner() { throw 9; } function middle() { return inner(); } try { middle(); } catch (value) { return value + 1; }",
        ),
        10,
    );
    expect_int(
        execute_source("let result = 0; try { throw 3; } catch { result = 7; } return result;"),
        7,
    );
    match execute_source(
        "let thrown = {value: 5}; try { throw thrown; } catch (value) { return value === thrown; }",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected thrown object identity"),
    };
    expect_int(
        execute_source(
            "let read; try { throw 6; } catch (value) { read = function() { return value; }; } return read();",
        ),
        6,
    )
}

#[test]
fn selects_nearest_handler_and_runs_finally_after_catch_rethrow() -> unit {
    expect_int(
        execute_source(
            "try { try { throw 1; } catch (value) { throw value + 1; } } catch (value) { return value; }",
        ),
        2,
    );
    expect_int(
        execute_source(
            "let side = 0; try { try { throw 3; } catch (value) { throw value + 1; } finally { side = 10; } } catch (value) { return side + value; }",
        ),
        14,
    );
    expect_string(
        execute_source(
            "function fail() { return 1n + 1; } function middle() { return fail(); } try { middle(); } catch (value) { return typeof value; }",
        ),
        "string",
    )
}

#[test]
fn catches_type_range_and_native_errors() -> unit {
    expect_string(
        execute_source("try { return 1n + 1; } catch (error) { return typeof error; }"),
        "string",
    );
    match execute_source("try { return 1n / 0n; } catch (error) { return error; }") {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert(value.byte_slice(0, 11) == "RangeError:"),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected caught RangeError value"),
    };
    expect_string(
        execute_source_with_builtins(
            "try { return JSON.parse('{'); } catch (error) { return error instanceof SyntaxError ? typeof error : 'wrong'; }",
        ),
        "object",
    )
}

#[test]
fn materializes_catchable_vm_and_native_failures_as_error_objects() -> unit {
    match execute_source_with_builtins(
        "let type = false; let range = false; let reference = false; let syntax = false; let regexpSyntax = false; let uri = false; let nativeRange = false; try { 1n + 1; } catch (error) { type = error instanceof TypeError && error instanceof Error && error.name === 'TypeError' && typeof error.message === 'string' && Object.keys(error).length === 0; } try { 1n / 0n; } catch (error) { range = error instanceof RangeError && error.name === 'RangeError'; } class Base {} class Derived extends Base { constructor() { this.value = 1; super(); } } try { new Derived(); } catch (error) { reference = error instanceof ReferenceError && error.name === 'ReferenceError'; } try { JSON.parse('{'); } catch (error) { syntax = error instanceof SyntaxError && error.name === 'SyntaxError'; } try { new RegExp('('); } catch (error) { regexpSyntax = error instanceof SyntaxError && error.name === 'SyntaxError'; } try { decodeURIComponent('%'); } catch (error) { uri = error instanceof URIError && error.name === 'URIError'; } try { new ArrayBuffer(-1); } catch (error) { nativeRange = error instanceof RangeError; } let token = {}; let same = false; try { throw token; } catch (error) { same = error === token; } return type && range && reference && syntax && regexpSyntax && uri && nativeRange && same;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected catchable Error objects"),
    }
}

#[test]
fn finally_runs_on_normal_throw_return_break_and_continue_paths() -> unit {
    expect_int(
        execute_source(
            "let value = 0; try { value = 1; } finally { value = value + 2; } return value;",
        ),
        3,
    );
    expect_int(
        execute_source(
            "let value = 0; try { try { throw 4; } finally { value = 3; } } catch (error) { return value * 10 + error; }",
        ),
        34,
    );
    expect_int(
        execute_source(
            "function value() { let side = 1; try { return side; } finally { side = 9; } } return value();",
        ),
        1,
    );
    expect_int(
        execute_source(
            "let total = 0; let i = 0; while (i < 4) { i = i + 1; try { if (i === 1) { continue; } if (i === 3) { break; } total = total + i; } finally { total = total + 10; } } return total;",
        ),
        32,
    );
    expect_int(
        execute_source(
            "let total = 0; try { let i = 0; while (i < 3) { i = i + 1; if (i < 3) { continue; } break; } total = total + 1; } finally { total = total + 10; } return total;",
        ),
        11,
    )
}

#[test]
fn finally_abrupt_completion_overrides_prior_completion() -> unit {
    expect_int(
        execute_source(
            "function value() { try { return 1; } finally { return 2; } } return value();",
        ),
        2,
    );
    expect_int(
        execute_source(
            "try { try { throw 1; } finally { throw 2; } } catch (value) { return value; }",
        ),
        2,
    );
    expect_int(
        execute_source(
            "function value() { try { return 1; } finally { throw 2; } } try { return value(); } catch (error) { return error; }",
        ),
        2,
    );
    expect_int(
        execute_source(
            "function value() { let caught = 0; try { try { return 1; } catch (error) { caught = 100; } } finally { throw caught + 2; } } try { return value(); } catch (error) { return error; }",
        ),
        2,
    );
    expect_int(
        execute_source(
            "let index = 0; while (index < 2) { index = index + 1; try { continue; } finally { break; } } return index;",
        ),
        1,
    );
    expect_int(
        execute_source(
            "let index = 0; while (index < 2) { index = index + 1; try { break; } finally { if (index < 2) { continue; } } } return index;",
        ),
        2,
    )
}

#[test]
fn compiles_hoisted_function_declarations_with_parameters() -> unit {
    expect_int(
        execute_source("return add(20, 22); function add(left, right) { return left + right; }"),
        42,
    );
    expect_int(
        execute_source(
            "function value() { return 1; } function value() { return 2; } return value();",
        ),
        2,
    )
}

