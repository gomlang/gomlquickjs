        "function *values() { let input = yield 1; return input + 2; } function *inner() { yield 3; yield 4; return 5; } function *outer() { let result = yield *inner(); return result + 1; } function *guarded() { let value; try { value = 2 + (yield 6); } finally { value++; } return value; } let first = values(); let a = first.next(); let b = first.next(40); let c = first.next(); let second = outer(); let d = second.next(); let e = second.next(); let f = second.next(); let third = guarded(); let g = third.next(); let h = third.next(3); return a.value === 1 && a.done === false && b.value === 42 && b.done === true && c.value === undefined && c.done === true && d.value === 3 && e.value === 4 && f.value === 6 && f.done === true && g.value === 6 && h.value === 6 && h.done === true && third[Symbol.iterator]() === third && Object.prototype.toString.call(third) === '[object Generator]';",
    ) {
