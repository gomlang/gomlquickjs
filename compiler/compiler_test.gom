#[test]
fn compiles_duplicate_parameters_with_last_parameter_winning() -> unit {
    expect_int(
        execute_source(
            "let select = function(value, value) { return value; }; return select(1, 2);",
        ),
        2,
    );
    expect_int(
        execute_source(
            "let sum = function inner(value) { if (value < 1) return 0; return value + inner(value - 1); }; return sum(4);",
        ),
        10,
    )
}

#[test]
fn compiles_known_global_builtins_to_environment_aware_bytecode() -> unit {
    let function = expect_function(compile("return Math.max(3, 7);"));
    let mut found_global = false;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::GetEval(_) => {
                found_global = true;
            },
            _ => (),
        }
    }
    testing::assert(found_global);
    let context = vm::Context::new(runtime::Heap::new());
    match builtins::install(context) {
        Ok(_) => (),
        Err(value) => testing::fail(value.message),
    };
    match context.execute(function) {
        Ok(value) => expect_int(value, 7),
        Err(value) => testing::fail(value.kind.debug()),
    };
    let type_function = expect_function(compile("return typeof Math;"));
    match context.execute(type_function) {
        Ok(runtime::Value::String(value)) => match value.to_host_string() {
            Ok(text) => testing::assert_eq(text, "object"),
            Err(value) => testing::fail(value.debug()),
        },
        Ok(_) => testing::fail("expected global typeof string"),
        Err(value) => testing::fail(value.kind.debug()),
    }
}

#[test]
fn compiles_object_and_sparse_array_literals_through_json_stringify() -> unit {
    expect_string(
        execute_source_with_builtins(
            "let shorthand = 4; let first = {plain: 1, \"text-key\": 2, 1e2: 3, shorthand, plain: 5,}; let array = [1,,3,]; return JSON.stringify({first: first, array: array, lengths: [array.length, array[1]],});",
        ),
        "{\"first\":{\"100\":3,\"plain\":5,\"text-key\":2,\"shorthand\":4},\"array\":[1,null,3],\"lengths\":[3,null]}",
    );
    let function = expect_function(compile("return [{value: 1},,{}];"));
    let mut objects = 0;
    let mut arrays = 0;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::NewObject => {
                objects += 1;
            },
            bytecode::Instruction::NewArray(_) => {
                arrays += 1;
            },
            _ => (),
        }
    }
    testing::assert_eq(objects, 2);
    testing::assert_eq(arrays, 1)
}

#[test]
fn evaluates_literal_values_left_to_right_and_allocates_fresh_objects() -> unit {
    expect_string(
        execute_source(
            "let order = \"\"; function mark(value) { order = order + value; return value; } let object = {first: mark(\"a\"), second: mark(\"b\")}; let array = [mark(\"c\"),,mark(\"d\")]; return order + object.first + object.second + array[0] + array[2];",
        ),
        "abcdabcd",
    );
    match execute_source("return {} !== {} && [] !== [];") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected identity comparison"),
    }
}

#[test]
fn recognizes_object_and_array_constructor_globals() -> unit {
    let function = expect_function(compile("return Object !== Array;"));
    let mut globals = 0;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::GetEval(_) => {
                globals += 1;
            },
            _ => (),
        }
    }
    testing::assert_eq(globals, 2)
}

#[test]
