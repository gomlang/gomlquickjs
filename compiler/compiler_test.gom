#[test]
fn quickjs_os_file_descriptors_and_path_operations_execute() -> unit {
    match execute_source_with_builtins(
        "let directory = '__gomlquickjs_os_fs_35f644__'; let name = 'file.bin'; let path = directory + '/' + name; let link = directory + '/link'; os.remove(link); os.remove(path); os.remove(directory); let made = os.mkdir(directory, 0o755) === 0; let descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_TRUNC); let source = new Uint8Array(10); for (let index = 0; index < source.length; index++) source[index] = index; let wrote = os.write(descriptor, source.buffer, 0, source.length) === 10; let seeked = os.seek(descriptor, 0, std.SEEK_SET) === 0; let target = new Uint8Array(10); let read = os.read(descriptor, target.buffer, 0, target.length) === 10; let same = true; for (let index = 0; index < source.length; index++) same = same && source[index] === target[index]; let bigSeek = os.seek(descriptor, 6n, std.SEEK_SET) === 6n; let one = new Uint8Array(1); let oneRead = os.read(descriptor, one.buffer, 0, 1) === 1 && one[0] === 6; let closed = os.close(descriptor) === 0; let [files, readError] = os.readdir(directory); let touched = os.utimes(path, 10000, 10000) === 0; let [metadata, statError] = os.stat(path); let linked = os.symlink(name, link) === 0; let [linkMetadata, linkStatError] = os.lstat(link); let [linkTarget, linkError] = os.readlink(link); let [cwd, cwdError] = os.getcwd(); let [absolute, realError] = os.realpath('.'); let cleaned = os.remove(link) === 0 && os.remove(path) === 0 && os.remove(directory) === 0; return made && descriptor >= 3 && wrote && seeked && read && same && bigSeek && oneRead && closed && readError === 0 && files.indexOf(name) >= 0 && touched && statError === 0 && (metadata.mode & os.S_IFMT) === os.S_IFREG && metadata.mtime === 10000 && linked && linkStatError === 0 && (linkMetadata.mode & os.S_IFMT) === os.S_IFLNK && linkError === 0 && linkTarget === name && cwdError === 0 && realError === 0 && cwd === absolute && cleaned;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected os file descriptor and path result"),
    }
}

#[test]
fn quickjs_os_append_exclusive_dup_rename_and_clock_execute() -> unit {
    match execute_source_with_builtins(
        "let sourcePath = '__gomlquickjs_os_dup_4d4b__.txt'; let targetPath = '__gomlquickjs_os_dup_4d4b_moved__.txt'; os.remove(sourcePath); os.remove(targetPath); let descriptor = os.open(sourcePath, os.O_RDWR | os.O_CREAT | os.O_EXCL); let bytes = new Uint8Array([65, 66, 67, 68]); let wroteA = os.write(descriptor, bytes.buffer, 0, 1) === 1; let duplicate = os.dup(descriptor); let wroteB = os.write(duplicate, bytes.buffer, 1, 1) === 1; let fixed = os.dup2(descriptor, 77); let wroteC = os.write(fixed, bytes.buffer, 2, 1) === 1; let closed = os.close(descriptor) === 0 && os.close(duplicate) === 0 && os.close(fixed) === 0; let exclusive = os.open(sourcePath, os.O_WRONLY | os.O_CREAT | os.O_EXCL) === -std.Error.EEXIST; let appended = os.open(sourcePath, os.O_WRONLY | os.O_APPEND); os.seek(appended, 0, std.SEEK_SET); let wroteD = os.write(appended, bytes.buffer, 3, 1) === 1 && os.close(appended) === 0; let renamed = os.rename(sourcePath, targetPath) === 0; let contents = std.loadFile(targetPath); let before = os.now(); let slept = os.sleep(0); let after = os.now(); let removed = os.remove(targetPath) === 0; return wroteA && duplicate >= 3 && wroteB && fixed === 77 && wroteC && closed && exclusive && wroteD && renamed && contents === 'ABCD' && typeof before === 'number' && after >= before && slept === 0 && os.getpid() > 0 && os.O_APPEND === 1024 && os.O_EXCL === 128 && os.WNOHANG === 1 && os.S_IFSOCK === 0o140000 && os.ttyGetWinSize(-1) === null && os.ttySetRaw(-1) === undefined && removed;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected os descriptor and clock compatibility result"),
    }
}

#[test]
fn quickjs_os_pipe_nonblocking_exec_wait_and_kill_execute() -> unit {
    match execute_source_with_builtins(
        "let descriptors = os.pipe(); let process = os.exec(['sh', '-c', 'echo $FOO'], {stdout: descriptors[1], block: false, env: {FOO: 'hello'}}); let writeClosed = os.close(descriptors[1]) === 0; let file = std.fdopen(descriptors[0], 'r'); let first = file.getline(); let second = file.getline(); file.close(); let [waited, status] = os.waitpid(process, 0); let sleeping = os.exec(['cat'], {block: false}); let killed = os.kill(sleeping, os.SIGTERM) === 0; let [killedProcess, killedStatus] = os.waitpid(sleeping, 0); return process >= 1000 && writeClosed && first === 'hello' && second === null && waited === process && (status & 0x7f) === 0 && (status >> 8) === 0 && killed && killedProcess === sleeping && (killedStatus & 0x7f) === os.SIGTERM;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected os process compatibility result"),
    }
}

#[test]
fn quickjs_extended_json_and_timer_cancellation_surface_execute() -> unit {
    match execute_source_with_builtins(
        "let parsed = std.parseExtJSON(`{x:false, y:true, z:null, a:[+1, 0o10, 0xa0,], b:'abc',}`); let numbers = std.parseExtJSON('[Infinity, +Infinity, -Infinity, NaN, +NaN, -NaN, .1, -.2]'); let timer = os.setTimeout(function() {}, 1000); let cleared = os.clearTimeout(timer); return JSON.stringify(parsed) === '{\"x\":false,\"y\":true,\"z\":null,\"a\":[1,8,160],\"b\":\"abc\"}' && numbers[0] === Infinity && numbers[1] === Infinity && numbers[2] === -Infinity && Number.isNaN(numbers[3]) && Number.isNaN(numbers[4]) && Number.isNaN(numbers[5]) && numbers[6] === 0.1 && numbers[7] === -0.2 && cleared === undefined;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected extended JSON and timer surface result"),
    }
}

#[test]
fn quickjs_os_sleep_async_settles_through_the_host_job_queue() -> unit {
    expect_string(
        execute_source_with_builtins_jobs_property(
            "let state = {result: ''}; let promise = os.sleepAsync(0); state.result = promise instanceof Promise && os.sleepAsync.length === 1 ? 'promise' : 'invalid'; promise.then(value => state.result += value === undefined ? ',resolved' : ',value'); return state;",
            "result",
        ),
        "promise,resolved",
    )
}

#[test]
fn quickjs_os_chdir_coordinates_relative_io_processes_and_signals() -> unit {
    expect_string(
        execute_source_with_builtins_jobs_property(
            "let directory = '/tmp/gomlquickjs-chdir-signal-61f74c'; let dataPath = directory + '/data'; let scriptPath = directory + '/script.js'; os.remove(dataPath); os.remove(scriptPath); os.remove(directory); let original = os.getcwd()[0]; let made = os.mkdir(directory) === 0; let missing = os.chdir(directory + '/missing') === -std.Error.ENOENT; let changed = os.chdir(directory) === 0 && os.getcwd()[0] === os.realpath('.')[0]; let file = std.open('data', 'w'); file.puts('data'); file.close(); let loaded = std.loadFile('data') === 'data'; let descriptor = os.open('data', os.O_RDONLY); let buffer = new Uint8Array(4); let read = os.read(descriptor, buffer.buffer, 0, 4) === 4 && Array.from(buffer).join(',') === '100,97,116,97'; os.close(descriptor); let notDirectory = os.chdir('data') === -20; let script = std.open('script.js', 'w'); script.puts('globalThis.__relativeLoadScript = 17;'); script.close(); std.loadScript('script.js'); let loadedScript = globalThis.__relativeLoadScript === 17; let pipe = std.popen('printf %s \"$PWD\"', 'r'); let pipeDirectory = pipe.readAsString(); pipe.close(); let processDirectory = os.exec(['sh', '-c', 'test \"$(cat data)\" = data']) === 0; let state = {valid: made && missing && changed && loaded && read && notDirectory && loadedScript && pipeDirectory === directory && processDirectory, result: 'pending'}; os.signal(os.SIGUSR1, function() { state.result = state.valid ? 'passed' : 'failed'; }); std.gc(); let sent = os.kill(os.getpid(), os.SIGUSR1) === 0; state.valid = state.valid && sent && os.signal.length === 2 && os.chdir.length === 0; os.signal(os.SIGUSR1, undefined); let restored = os.chdir(original) === 0; state.valid = state.valid && restored && os.remove(dataPath) === 0 && os.remove(scriptPath) === 0 && os.remove(directory) === 0; return state;",
            "result",
        ),
        "passed",
    )
}

