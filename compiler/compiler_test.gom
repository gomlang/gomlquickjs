#[test]
fn builtin_namespace_imports_bind_std_and_os() -> unit {
    match execute_source_with_builtins(
        "import * as library from 'std'; import * as system from 'os'; let file = library.tmpfile(); file.puts('ok'); file.seek(0, library.SEEK_SET); return file.readAsString() === 'ok' && library === std && system === os;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected builtin namespace import result"),
    };
    match compile("import * as value from './missing.js';") {
        Ok(_) => testing::fail("expected unsupported import diagnostic"),
        Err(errors) => testing::assert(has_message(errors, "unsupported import module")),
    }
}

#[test]
fn import_meta_requires_module_compilation() -> unit {
    match compile("return import.meta;") {
        Ok(_) => testing::fail("expected import.meta module diagnostic"),
        Err(errors) => {
            testing::assert(has_message(errors, "import.meta is only valid in module code"))
        },
    };
    match compile_module("export const meta = import.meta;") {
        Ok(value) => {
            testing::assert(value.import_meta_index >= 0);
            testing::assert(!value.function.asynchronous())
        },
        Err(_) => testing::fail("expected import.meta module compilation"),
    };
    match compile_module("export const value = await Promise.resolve(42);") {
        Ok(value) => testing::assert(value.function.asynchronous()),
        Err(_) => testing::fail("expected top-level await module compilation"),
    }
}
