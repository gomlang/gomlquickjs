    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected dynamic Function result"),
    }
}

#[test]
fn function_apply_reads_generic_array_like_objects_and_accessors() -> unit {
    match execute_source_with_builtins(
        "let hits = 0; let prototype = {get 1() { hits += 1; return 'b'; }}; let values = Object.create(prototype); values.length = '2.9'; values[0] = 'a'; values[2] = 'ignored'; function combine(left, right) { return this.prefix + left + right; } let combined = combine.apply({prefix: '>'}, values); function inspect(first, second, third) { return first === 'x' && second === undefined && third === 'z'; } let sparse = inspect.apply(null, {length: 3, 0: 'x', 2: 'z'}); function count() { return arguments.length; } let lengths = count.apply(null, {length: -1, 0: 1}) === 0 && count.apply(null, {length: 'nope', 0: 1}) === 0; let token = {}; let abrupt = false; try { combine.apply(null, {length: 1, get 0() { throw token; }}); } catch (error) { abrupt = error === token; } let primitiveThrows = false; try { combine.apply(null, 'ab'); } catch (error) { primitiveThrows = error instanceof TypeError; } return combined === '>ab' && hits === 1 && sparse && lengths && abrupt && primitiveThrows;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected generic Function.apply result"),
    }
}

#[test]
fn function_apply_converts_array_like_length_with_number_hint() -> unit {
    match execute_source_with_builtins(
        "let order = ''; let values = {get length() { order += 'g,'; return {[Symbol.toPrimitive](hint) { order += hint + ','; return 2.9; }}; }, get 0() { order += 'a,'; return 4; }, get 1() { order += 'b,'; return 5; }}; function sum(left, right) { return left + right; } let token = {}; let preserved = false; try { sum.apply(null, {length: {[Symbol.toPrimitive]() { throw token; }}}); } catch (error) { preserved = error === token; } return sum.apply(null, values) === 9 && order === 'g,number,a,b,' && preserved;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Function.apply length conversion result"),
    }
}

#[test]
fn primitive_wrapper_constructors_store_values_and_string_indices() -> unit {
    match execute_source_with_builtins(
        "let number = new Number(41); let boolean = new Boolean(false); let string = new String('abc'); let descriptor = Object.getOwnPropertyDescriptor(string, '1'); class Numeric extends Number {} let derived = new Numeric(7); return typeof number === 'object' && number instanceof Number && number.valueOf() === 41 && number + 1 === 42 && number == 41 && number !== 41 && number.toString(16) === '29' && typeof boolean === 'object' && boolean instanceof Boolean && boolean.valueOf() === false && boolean == false && boolean !== false && !boolean === false && boolean.toString() === 'false' && typeof string === 'object' && string instanceof String && string.valueOf() === 'abc' && string.toString() === 'abc' && string.length === 3 && string[1] === 'b' && string.slice(1) === 'bc' && string + 'd' === 'abcd' && string == 'abc' && string !== 'abc' && descriptor.value === 'b' && descriptor.enumerable && !descriptor.writable && !descriptor.configurable && Object.keys(string).join(',') === '0,1,2' && derived instanceof Numeric && derived instanceof Number && derived.valueOf() === 7 && derived + 1 === 8;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected primitive wrapper result"),
    }
}

#[test]
