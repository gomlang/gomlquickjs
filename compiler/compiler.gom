package compiler;

use gomlang::quickjs::ast;
use gomlang::quickjs::bytecode;
use gomlang::quickjs::dtoa;
use gomlang::quickjs::parser;
use gomlang::quickjs::regexp;
use gomlang::quickjs::runtime;
use gomlang::quickjs::unicode;
use gomlang::quickjs::vm;
use std::num;
use std::text;

const IMPORT_META_BINDING: string = "$import.meta";

const IMPORT_REFERRER_BINDING: string = "$import.referrer";

#[derive(PartialEq, Eq, Debug)]
pub struct CompileError {
    pub message: string,
    pub span: ast::Span,
}

#[derive(PartialEq, Eq, Debug)]
pub enum ModuleImportKind {
    Namespace,
    Named,
    SideEffect,
}

pub struct ModuleAttribute {
    pub key: string,
    pub value: string,
}

pub struct ModuleImport {
    pub kind: ModuleImportKind,
    pub source: string,
    pub imported: string,
    pub local: string,
    pub local_index: isize,
    pub attributes: Vec[ModuleAttribute],
    pub span: ast::Span,
}

pub struct ModuleExport {
    pub exported: string,
    pub source: Option[string],
    pub imported: string,
    pub local_index: isize,
    pub attributes: Vec[ModuleAttribute],
    pub span: ast::Span,
}

pub struct CompiledModule {
    pub function: bytecode::Function,
    pub imports: Vec[ModuleImport],
    pub exports: Vec[ModuleExport],
    pub import_meta_index: isize,
    pub dynamic_import_referrer_index: isize,
}

#[derive(PartialEq, Eq)]
enum BindingKind {
    Let,
    Const,
    Var,
    NamedFunction,
}

struct Binding {
    name: string,
    index: isize,
    kind: BindingKind,
    span: ast::Span,
}

struct OuterBinding {
    name: string,
    source: bytecode::UpvalueSource,
    kind: BindingKind,
    declaration_target: bool,
    environment_depth: isize,
}

struct Upvalue {
    name: string,
    source: bytecode::UpvalueSource,
    kind: BindingKind,
}

struct Scope {
    bindings: HashMap[string, Binding],
}

struct WithBinding {
    name: string,
    scope_index: isize,
}

struct LoopContext {
    continue_jumps: Vec[isize],
    finalizer_depth: isize,
    label: Option[string],
}

struct BreakContext {
    break_jumps: Vec[isize],
    finalizer_depth: isize,
    label: Option[string],
}

struct SwitchJump {
    case_index: isize,
    offset: isize,
}

enum FinalizerKind {
    Statements(Vec[ast::Stmt]),
    Iterator(isize),
    AsyncIterator(isize),
}

struct FinallyContext {
    kind: FinalizerKind,
    active: bool,
}

struct ProtectedContext {
    segments: Vec[(isize, isize)],
    segment_start: isize,
    finalizer_depth: isize,
    active: bool,
}

struct DynamicEvalDeclaration {
    name: string,
    kind: bytecode::EvalDeclarationKind,
    offset: isize,
}

struct Compiler {
    constants: Vec[bytecode::Constant],
    code: Vec[bytecode::Instruction],
    eval_sites: Vec[Vec[bytecode::EvalBinding]],
    scopes: Vec[Scope],
    var_indices: Vec[isize],
    var_scope_index: Ref[isize],
    next_local: Ref[isize],
    loops: Vec[LoopContext],
    breakables: Vec[BreakContext],
    outer_bindings: Vec[OuterBinding],
    upvalues: Vec[Upvalue],
    parameter_count: isize,
    function_length: isize,
    strict: bool,
    strict_context: Ref[bool],
    arguments_available: bool,
    lexical_this: bool,
    lexical_arguments: bool,
    super_call_allowed: bool,
    super_property_allowed: bool,
    generator: bool,
    asynchronous: bool,
    used_await: Ref[bool],
    completion_local: Ref[Option[isize]],
    errors: Vec[CompileError],
    exception_handlers: Vec[bytecode::ExceptionHandler],
    generator_return_handlers: Vec[bytecode::GeneratorReturnHandler],
    finalizers: Vec[FinallyContext],
    protected_regions: Vec[ProtectedContext],
    source: Ref[string],
    source_name: Ref[string],
    source_locations: Vec[bytecode::SourceLocation],
    current_source_offset: Ref[isize],
    allow_unknown_globals: Ref[bool],
    pending_loop_label: Ref[Option[string]],
    direct_eval: Ref[bool],
    dynamic_eval_vars: Vec[string],
    dynamic_eval_declarations: Vec[DynamicEvalDeclaration],
    with_bindings: Vec[WithBinding],
    next_with_binding: Ref[isize],
    module_mode: Ref[bool],
    script_mode: Ref[bool],
    global_lexical_indices: HashMap[string, isize],
    global_var_kinds: HashMap[string, bytecode::ScriptBindingKind],
    global_declaration_offsets: HashMap[string, isize],
    runtime_eval_environment: bool,
}

enum AssignmentStorage {
    Local(isize),
    Upvalue(isize),
    Global(isize),
    Eval(isize),
    EvalOrUpvalue {
        name: isize,
        upvalue: isize,
        depth: isize,
    },
    Field {
        object: isize,
        property: isize,
    },
    Element {
        object: isize,
        property: isize,
    },
    WithIdentifier {
        receiver: isize,
        property: isize,
        name: string,
        span: ast::Span,
    },
    Private {
        object: isize,
        name: isize,
    },
    SuperField(isize),
    SuperElement(isize),
    Invalid,
}

struct AssignmentTarget {
    storage: AssignmentStorage,
    writable: bool,
    throws_on_write: bool,
    source_offset: isize,
}

enum ExcludedBindingKey {
    Constant(isize),
    Local(isize),
}

fn compile_error(compiler: Compiler, message: string, span: ast::Span) -> unit {
    compiler.errors.push(CompileError { message, span })
}

fn compiler_is_strict(compiler: Compiler) -> bool {
    compiler.strict || compiler.strict_context.get()
}

fn validate_strict_identifier(compiler: Compiler, name: string, span: ast::Span) -> unit {
    if compiler_is_strict(compiler) && name == "yield" {
        compile_error(compiler, "yield cannot be used as an identifier in strict mode", span)
    } else {}
}

fn emit(compiler: Compiler, instruction: bytecode::Instruction) -> isize {
    let offset = compiler.code.len();
    compiler.code.push(instruction);
    compiler.source_locations.push(
        source_location(compiler.source.get(), compiler.current_source_offset.get()),
    );
    offset
}

fn source_location(source: string, target: isize) -> bytecode::SourceLocation {
    let bytes = source.to_bytes();
    let limit = if target < 0 {
        0
    } else if target > bytes.len() {
        bytes.len()
    } else {
        target
    };
    let input = bytes.slice(0, bytes.len());
    let mut offset = 0;
    let mut line = 1;
    let mut column = 1;
    while offset < limit {
        let current = bytes[offset];
        if current == b'\n' {
            line += 1;
            column = 1;
            offset += 1;
        } else {
            match unicode::try_unicode_from_utf8_at(input, offset) {
                Some(decoded) => {
                    column += if decoded.code_point() > 0xffff {
                        2
                    } else {
                        1
                    };
                    offset += decoded.length();
                },
                None => {
                    column += 1;
                    offset += 1;
                },
            }
        }
    }
    bytecode::SourceLocation { line, column }
}

fn set_source_offset(compiler: Compiler, offset: isize) -> unit {
    compiler.current_source_offset.set(offset)
}

fn emit_at(compiler: Compiler, instruction: bytecode::Instruction, source_offset: isize) -> isize {
    set_source_offset(compiler, source_offset);
    emit(compiler, instruction)
}

fn first_source_byte_between(compiler: Compiler, start: isize, end: isize) -> isize {
    let source = compiler.source.get();
    let limit = if end < source.byte_len() {
        end
    } else {
        source.byte_len()
    };
    let mut offset = if start < 0 {
        0
    } else {
        start
    };
    while offset < limit {
        let current = source.byte_get(offset);
        if current != b' ' && current != b'\t' && current != b'\r' && current != b'\n' {
            return offset
        } else {};
        offset += 1;
    }
    if start < 0 {
        0
    } else {
        start
    }
}

fn current_offset(compiler: Compiler) -> isize {
    compiler.code.len()
}

fn patch_jump(compiler: Compiler, offset: isize, target: isize) -> bool {
    if offset < 0 || offset >= compiler.code.len() {
        false
    } else {
        match compiler.code[offset] {
            bytecode::Instruction::IfFalse(_) => {
                compiler.code[offset] = bytecode::Instruction::IfFalse(target);
                true
            },
            bytecode::Instruction::IfTrue(_) => {
                compiler.code[offset] = bytecode::Instruction::IfTrue(target);
                true
            },
            bytecode::Instruction::Goto(_) => {
                compiler.code[offset] = bytecode::Instruction::Goto(target);
                true
            },
            _ => false,
        }
    }
}

fn add_constant(compiler: Compiler, value: bytecode::Constant) -> isize {
    let index = compiler.constants.len();
    compiler.constants.push(value);
    index
}

fn binding_kind(value: ast::VariableKind) -> BindingKind {
    match value {
        ast::VariableKind::Let => BindingKind::Let,
        ast::VariableKind::Const => BindingKind::Const,
        ast::VariableKind::Var => BindingKind::Var,
    }
}

fn push_scope(compiler: Compiler) -> unit {
    compiler.scopes.push(Scope { bindings: HashMap::new() })
}

fn pop_scope(compiler: Compiler) -> unit {
    let _ = compiler.scopes.pop();
}

fn new_local(compiler: Compiler) -> isize {
    let index = compiler.next_local.get();
    compiler.next_local.set(index + 1);
    index
}

fn declare_in_scope(
    compiler: Compiler,
    scope_index: isize,
    name: string,
    kind: BindingKind,
    span: ast::Span,
) -> Option[Binding] {
    validate_strict_identifier(compiler, name, span);
    let scope = compiler.scopes[scope_index];
    match scope.bindings.get(name) {
        Some(previous) => {
            compile_error(compiler, "duplicate declaration of `" + name + "`", span);
            Option::Some(previous)
        },
        None => {
            let index = new_local(compiler);
            let binding = Binding { name, index, kind, span };
            scope.bindings.set(name, binding);
            Option::Some(binding)
        },
    }
}

fn declare_current(compiler: Compiler, name: string, kind: BindingKind, span: ast::Span) -> Option[
    Binding,
] {
    let scope_index = compiler.scopes.len() - 1;
    if compiler.script_mode.get() && scope_index == 0
        && (kind == BindingKind::Let || kind == BindingKind::Const)
        && compiler.global_var_kinds.get(name).is_some() {
        compile_error(compiler, "duplicate declaration of `" + name + "`", span)
    } else {};
    let binding = declare_in_scope(compiler, scope_index, name, kind, span);
    match binding {
        Some(value) => if compiler.script_mode.get() && scope_index == 0
            && (kind == BindingKind::Let || kind == BindingKind::Const) {
            compiler.global_lexical_indices[name] = value.index;
            record_global_declaration_offset(compiler, name, span.start);
        } else {},
        None => (),
    };
    binding
}

fn is_global_lexical_binding(compiler: Compiler, binding: Binding) -> bool {
    match compiler.global_lexical_indices.get(binding.name) {
        Some(index) => index == binding.index,
        None => false,
    }
}

fn record_global_declaration_offset(compiler: Compiler, name: string, offset: isize) -> unit {
    match compiler.global_declaration_offsets.get(name) {
        Some(previous) => if offset < previous {
            compiler.global_declaration_offsets[name] = offset;
        } else {},
        None => {
            compiler.global_declaration_offsets[name] = offset;
        },
    }
}

fn script_global_var_scope(compiler: Compiler) -> bool {
    compiler.script_mode.get() && compiler.var_scope_index.get() == 0
}

fn is_script_global_var(compiler: Compiler, name: string) -> bool {
    compiler.global_var_kinds.get(name).is_some()
}

fn record_global_var(
    compiler: Compiler,
    name: string,
    kind: bytecode::ScriptBindingKind,
    span: ast::Span,
) -> unit {
    record_global_declaration_offset(compiler, name, span.start);
    match compiler.scopes[0].bindings.get(name) {
        Some(binding) => if binding.kind != BindingKind::Var {
            compile_error(compiler, "duplicate declaration of `" + name + "`", span)
        } else {},
        None => (),
    };
    match compiler.global_var_kinds.get(name) {
        Some(bytecode::ScriptBindingKind::Function) => (),
        Some(_) => if kind == bytecode::ScriptBindingKind::Function {
            compiler.global_var_kinds[name] = kind;
        } else {},
        None => {
            compiler.global_var_kinds[name] = kind;
        },
    }
}

fn lookup_binding(compiler: Compiler, name: string) -> Option[Binding] {
    let mut index = compiler.scopes.len() - 1;
    loop {
        match compiler.scopes[index].bindings.get(name) {
            Some(binding) => return Option::Some(binding),
            None => if index == 0 {
                return Option::None
            } else {
                index -= 1;
            },
        }
    }
}

fn binding_scope_index(compiler: Compiler, name: string) -> Option[isize] {
    let mut index = compiler.scopes.len() - 1;
    loop {
        if compiler.scopes[index].bindings.get(name).is_some() {
            return Option::Some(index)
        } else if index == 0 {
            return Option::None
        } else {
            index -= 1;
        }
    }
}

fn is_known_global(name: string) -> bool {
    name == "undefined" || name == "NaN" || name == "Infinity" || name == "Math"
        || name == "Reflect"
        || name == "isNaN"
        || name == "isFinite"
        || name == "globalThis"
        || name == "performance"
        || name == "scriptArgs"
        || name == "Number"
        || name == "BigInt"
        || name == "RegExp"
        || name == "Date"
        || name == "Map"
        || name == "Set"
        || name == "WeakMap"
        || name == "WeakSet"
        || name == "WeakRef"
        || name == "FinalizationRegistry"
        || name == "Boolean"
        || name == "String"
        || name == "print"
        || name == "console"
        || name == "std"
        || name == "os"
        || name == "eval"
        || name == "__loadScript"
        || name == "parseInt"
        || name == "parseFloat"
        || name == "encodeURI"
        || name == "encodeURIComponent"
        || name == "decodeURI"
        || name == "decodeURIComponent"
        || name == "escape"
        || name == "unescape"
        || name == "JSON"
        || name == "Object"
        || name == "Array"
        || name == "Function"
        || name == "Error"
        || name == "EvalError"
        || name == "InternalError"
        || name == "RangeError"
        || name == "ReferenceError"
        || name == "SyntaxError"
        || name == "TypeError"
        || name == "URIError"
        || name == "AggregateError"
        || name == "Symbol"
        || name == "ArrayBuffer"
        || name == "SharedArrayBuffer"
        || name == "Atomics"
        || name == "DataView"
        || name == "Uint8Array"
        || name == "Int32Array"
        || name == "Float64Array"
        || name == "Uint8ClampedArray"
        || name == "Int8Array"
        || name == "Int16Array"
        || name == "Uint16Array"
        || name == "Uint32Array"
        || name == "Float16Array"
        || name == "Float32Array"
        || name == "BigInt64Array"
        || name == "BigUint64Array"
        || name == "Promise"
        || name == "Proxy"
        || name == "Iterator"
}

fn lookup_outer_binding(compiler: Compiler, name: string) -> Option[OuterBinding] {
    for binding in compiler.outer_bindings {
        if binding.name == name {
            return Option::Some(binding)
        } else {}
    }
    Option::None
}

fn upvalue_index(
    compiler: Compiler,
    name: string,
    source: bytecode::UpvalueSource,
    kind: BindingKind,
) -> isize {
    let mut index = 0;
    while index < compiler.upvalues.len() {
        if compiler.upvalues[index].name == name {
            return index
        } else {};
        index += 1;
    }
    compiler.upvalues.push(Upvalue { name, source, kind });
    compiler.upvalues.len() - 1
}

fn resolve_upvalue(compiler: Compiler, name: string) -> Option[(isize, BindingKind)] {
    match lookup_outer_binding(compiler, name) {
        Some(binding) => {
            let index = upvalue_index(compiler, name, binding.source, binding.kind);
            Option::Some((index, binding.kind))
        },
        None => Option::None,
    }
}

fn current_eval_environment_depth(compiler: Compiler) -> isize {
    if !compiler.runtime_eval_environment {
        0
    } else if compiler.var_scope_index.get() > 0 {
        2
    } else {
        1
    }
}

fn outer_binding_environment_depth(compiler: Compiler, name: string) -> isize {
    match lookup_outer_binding(compiler, name) {
        Some(binding) => current_eval_environment_depth(compiler) + binding.environment_depth,
        None => current_eval_environment_depth(compiler),
    }
}

fn visible_bindings(compiler: Compiler) -> Vec[OuterBinding] {
    let bindings: Vec[OuterBinding] = Vec::new();
    let mut scope_index = compiler.scopes.len();
    while scope_index > 0 {
        scope_index -= 1;
        for (name, binding) in compiler.scopes[scope_index].bindings.entries() {
            if is_global_lexical_binding(compiler, binding) {
                continue
            } else {};
            let mut found = false;
            for current in bindings {
                if current.name == name {
                    found = true;
                } else {}
            }
            if !found {
                bindings.push(
                    OuterBinding {
                        name,
                        source: bytecode::UpvalueSource::Local(binding.index),
                        kind: binding.kind,
                        declaration_target: scope_index >= compiler.var_scope_index.get(),
                        environment_depth: if compiler.runtime_eval_environment
                            && scope_index < compiler.var_scope_index.get() {
                            compiler.var_scope_index.get() - scope_index
                        } else {
                            0
                        },
                    },
                )
            } else {}
        }
    }
    for outer in compiler.outer_bindings {
        if outer.name == "$this" || outer.name == "$arguments" {
            continue
        } else {};
        let mut found = false;
        for current in bindings {
            if current.name == outer.name {
                found = true;
            } else {}
        }
        if !found {
            let index = upvalue_index(compiler, outer.name, outer.source, outer.kind);
            bindings.push(
                OuterBinding {
                    name: outer.name,
                    source: bytecode::UpvalueSource::Upvalue(index),
                    kind: outer.kind,
                    declaration_target: if compiler.runtime_eval_environment {
                        false
                    } else {
                        outer.declaration_target
                    },
                    environment_depth: current_eval_environment_depth(compiler)
                        + outer.environment_depth,
                },
            )
        } else {}
    }
    bindings
}

fn arrow_outer_bindings(compiler: Compiler) -> Vec[OuterBinding] {
    let bindings = visible_bindings(compiler);
    let this_source = if compiler.lexical_this {
        match resolve_upvalue(compiler, "$this") {
            Some((index, _)) => bytecode::UpvalueSource::Upvalue(index),
            None => bytecode::UpvalueSource::This,
        }
    } else {
        bytecode::UpvalueSource::This
    };
    bindings.push(
        OuterBinding {
            name: "$this",
            source: this_source,
            kind: BindingKind::Const,
            declaration_target: false,
            environment_depth: 0,
        },
    );
    let arguments_source = if compiler.lexical_arguments {
        match resolve_upvalue(compiler, "$arguments") {
            Some((index, _)) => Option::Some(bytecode::UpvalueSource::Upvalue(index)),
            None => Option::None,
        }
    } else if compiler.arguments_available {
        Option::Some(bytecode::UpvalueSource::Arguments)
    } else {
        Option::None
    };
    match arguments_source {
        Some(source) => bindings.push(
            OuterBinding {
                name: "$arguments",
                source,
                kind: BindingKind::Const,
                declaration_target: false,
                environment_depth: if compiler.lexical_arguments {
                    outer_binding_environment_depth(compiler, "$arguments")
                } else {
                    current_eval_environment_depth(compiler)
                },
            },
        ),
        None => (),
    };
    bindings
}

fn current_eval_bindings(compiler: Compiler) -> Vec[bytecode::EvalBinding] {
    let result: Vec[bytecode::EvalBinding] = Vec::new();
    for binding in arrow_outer_bindings(compiler) {
        if binding.name == IMPORT_META_BINDING {
            continue
        } else {};
        result.push(
            bytecode::EvalBinding {
                name: binding.name,
                source: binding.source,
                variable: binding.kind == BindingKind::Var,
                writable: binding.kind != BindingKind::Const
                    && binding.kind != BindingKind::NamedFunction,
                named_function: binding.kind == BindingKind::NamedFunction,
                declaration_target: binding.declaration_target,
                environment_depth: binding.environment_depth,
            },
        )
    }
    if compiler_is_strict(compiler) {
        result.push(
            bytecode::EvalBinding {
                name: "$strict",
                source: bytecode::UpvalueSource::Closure,
                variable: false,
                writable: false,
                named_function: false,
                declaration_target: false,
                environment_depth: 0,
            },
        )
    } else {};
    if compiler.super_call_allowed {
        result.push(
            bytecode::EvalBinding {
                name: "$super_call",
                source: bytecode::UpvalueSource::Closure,
                variable: false,
                writable: false,
                named_function: false,
                declaration_target: false,
                environment_depth: 0,
            },
        )
    } else {};
    if compiler.super_property_allowed {
        result.push(
            bytecode::EvalBinding {
                name: "$super_property",
                source: bytecode::UpvalueSource::Closure,
                variable: false,
                writable: false,
                named_function: false,
                declaration_target: false,
                environment_depth: 0,
            },
        )
    } else {};
    result
}

fn add_eval_site(compiler: Compiler, bindings: Vec[bytecode::EvalBinding]) -> isize {
    let index = compiler.eval_sites.len();
    compiler.eval_sites.push(bindings);
    index
}

fn has_dynamic_eval_var(compiler: Compiler, name: string) -> bool {
    for current in compiler.dynamic_eval_vars {
        if current == name {
            return true
        } else {}
    }
    false
}

fn add_dynamic_eval_var(
    compiler: Compiler,
    name: string,
    kind: bytecode::EvalDeclarationKind,
    span: ast::Span,
) -> unit {
    if !has_dynamic_eval_var(compiler, name) {
        compiler.dynamic_eval_vars.push(name)
    } else {};
    compiler.dynamic_eval_declarations.push(
        DynamicEvalDeclaration { name, kind, offset: span.start },
    )
}

fn dynamic_eval_declarations(compiler: Compiler) -> Vec[bytecode::EvalDeclaration] {
    let ordered: Vec[DynamicEvalDeclaration] = Vec::new();
    for declaration in compiler.dynamic_eval_declarations {
        let mut index = 0;
        while index < ordered.len() && ordered[index].offset <= declaration.offset {
            index += 1;
        }
        ordered.insert(index, declaration)
    }
    let result: Vec[bytecode::EvalDeclaration] = Vec::new();
    for declaration in ordered {
        result.push(bytecode::EvalDeclaration { name: declaration.name, kind: declaration.kind })
    }
    result
}

fn dynamic_eval_var_conflicts_current_scope(compiler: Compiler, name: string) -> bool {
    compiler.direct_eval.get() && !compiler_is_strict(compiler)
        && compiler.scopes.len() - 1 == compiler.var_scope_index.get()
        && has_dynamic_eval_var(compiler, name)
}

fn ensure_super_this_capture(compiler: Compiler) -> unit {
    if compiler.lexical_this {
        let _ = resolve_upvalue(compiler, "$this");
    } else {}
}

fn declare_var_pattern(compiler: Compiler, pattern: ast::BindingPattern) -> unit {
    let names: Vec[(string, ast::Span)] = Vec::new();
    collect_parameter_names(pattern, names);
    for (name, span) in names {
        validate_strict_identifier(compiler, name, span);
        if compiler.direct_eval.get() && compiler_is_strict(compiler)
            && (name == "arguments" || name == "eval") {
            compile_error(compiler, "invalid strict eval var binding `" + name + "`", span);
            continue
        } else {};
        let scope_index = compiler.var_scope_index.get();
        match compiler.scopes[scope_index].bindings.get(name) {
            Some(binding) => if binding.kind != BindingKind::Var {
                compile_error(compiler, "duplicate declaration of `" + name + "`", span)
            } else {},
            None => if script_global_var_scope(compiler) {
                record_global_var(compiler, name, bytecode::ScriptBindingKind::Var, span)
            } else if compiler.direct_eval.get() && !compiler_is_strict(compiler) {
                match lookup_outer_binding(compiler, name) {
                    Some(binding) => if binding.declaration_target {
                        if binding.kind != BindingKind::Var {
                            compile_error(compiler, "duplicate declaration of `" + name + "`", span)
                        } else {}
                    } else {
                        add_dynamic_eval_var(
                            compiler,
                            name,
                            bytecode::EvalDeclarationKind::Var,
                            span,
                        )
                    },
                    None => add_dynamic_eval_var(
                        compiler,
                        name,
                        bytecode::EvalDeclarationKind::Var,
                        span,
                    ),
                }
            } else {
                let index = new_local(compiler);
                compiler.scopes[scope_index].bindings.set(
                    name,
                    Binding { name, index, kind: BindingKind::Var, span },
                );
                compiler.var_indices.push(index)
            },
        }
    }
}

fn declare_var(compiler: Compiler, declaration: ast::VariableDeclarator) -> unit {
    declare_var_pattern(compiler, declaration.pattern.get())
}

fn collect_var_statement(compiler: Compiler, statement: ast::Stmt) -> unit {
    match statement {
        ast::Stmt::Block { body, .. } => collect_var_body(compiler, body),
        ast::Stmt::VariableDeclaration { kind, declarations, .. } => {
            if kind == ast::VariableKind::Var {
                for declaration in declarations {
                    declare_var(compiler, declaration)
                }
            } else {}
        },
        ast::Stmt::If { consequent, alternate, .. } => {
            collect_var_statement(compiler, consequent.get());
            match alternate {
                Some(value) => collect_var_statement(compiler, value.get()),
                None => (),
            }
        },
        ast::Stmt::While { body, .. } | ast::Stmt::With { body, .. } => {
            collect_var_statement(compiler, body.get())
        },
        ast::Stmt::For { initializer, body, .. } => {
            match initializer {
                Some(value) => collect_var_statement(compiler, value.get()),
                None => (),
            };
            collect_var_statement(compiler, body.get())
        },
        ast::Stmt::ForOf { kind, pattern, body, .. } => {
            if kind == ast::VariableKind::Var {
                declare_var_pattern(compiler, pattern.get())
            } else {};
            collect_var_statement(compiler, body.get())
        },
        ast::Stmt::ForIn { kind, pattern, body, .. } => {
            if kind == ast::VariableKind::Var {
                declare_var_pattern(compiler, pattern.get())
            } else {};
            collect_var_statement(compiler, body.get())
        },
        ast::Stmt::DoWhile { body, .. } => collect_var_statement(compiler, body.get()),
        ast::Stmt::Switch { cases, .. } => {
            for clause in cases {
                collect_var_body(compiler, clause.consequent)
            }
        },
        ast::Stmt::Try { block, handler, finalizer, .. } => {
            collect_var_body(compiler, block);
            match handler {
                Some(value) => collect_var_body(compiler, value.body),
                None => (),
            };
            match finalizer {
                Some(value) => collect_var_body(compiler, value),
                None => (),
            }
        },
        ast::Stmt::ExportDeclaration { declaration, .. } => {
            collect_var_statement(compiler, declaration.get())
        },
        ast::Stmt::ImportNamespace { .. } | ast::Stmt::ImportNamed { .. } | ast::Stmt::ImportSideEffect {
            ..,
        } | ast::Stmt::ExportNamed { .. } | ast::Stmt::ExportDefault { .. } | ast::Stmt::ExportAll {
            ..,
        } | ast::Stmt::ExportNamespace { .. } | ast::Stmt::FunctionDeclaration { .. } | ast::Stmt::ClassDeclaration {
            ..,
        } => (),
        ast::Stmt::Labelled { body, .. } => collect_var_statement(compiler, body.get()),
        ast::Stmt::Empty { .. } | ast::Stmt::Debugger { .. } | ast::Stmt::Expression { .. } | ast::Stmt::Break {
            ..,
        } | ast::Stmt::Continue { .. } | ast::Stmt::Return { .. } | ast::Stmt::Throw { .. } => (),
    }
}

fn collect_var_body(compiler: Compiler, body: Vec[ast::Stmt]) -> unit {
    for statement in body {
        collect_var_statement(compiler, statement)
    }
}

fn initialize_var_bindings(compiler: Compiler) -> unit {
    let var_scope_index = compiler.var_scope_index.get();
    for index in compiler.var_indices {
        let mut parameter_source: Option[isize] = Option::None;
        if var_scope_index > 0 {
            for (name, binding) in compiler.scopes[var_scope_index].bindings.entries() {
                if binding.index == index {
                    match compiler.scopes[0].bindings.get(name) {
                        Some(parameter) => {
                            parameter_source = Option::Some(parameter.index);
                        },
                        None => (),
                    }
                } else {}
            }
        } else {};
        match parameter_source {
            Some(source) => {
                let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
            },
            None => {
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            },
        };
        let _ = emit(compiler, bytecode::Instruction::PutLoc(index));
    }
    for name in compiler.dynamic_eval_vars {
        let index = string_constant(compiler, name);
        let _ = emit(compiler, bytecode::Instruction::InitEval(index));
    }
}

fn declare_lexical_statement(compiler: Compiler, statement: ast::Stmt) -> unit {
    match statement {
        ast::Stmt::VariableDeclaration { kind, declarations, .. } => {
            if kind != ast::VariableKind::Var {
                for declaration in declarations {
                    let names: Vec[(string, ast::Span)] = Vec::new();
                    collect_parameter_names(declaration.pattern.get(), names);
                    for (name, span) in names {
                        if dynamic_eval_var_conflicts_current_scope(compiler, name) {
                            compile_error(compiler, "duplicate declaration of `" + name + "`", span)
                        } else {
                            let _ = declare_current(compiler, name, binding_kind(kind), span);
                        }
                    }
                }
            } else {}
        },
        ast::Stmt::FunctionDeclaration { name, span, .. } => {
            if name == "" {
                compile_error(compiler, "function declaration requires a name", span)
            } else if compiler.script_mode.get() && compiler.scopes.len() == 1 {
                validate_strict_identifier(compiler, name, span);
                record_global_var(compiler, name, bytecode::ScriptBindingKind::Function, span)
            } else {
                match compiler.scopes[compiler.scopes.len() - 1].bindings.get(name) {
                    Some(binding) => {
                        validate_strict_identifier(compiler, name, span);
                        if binding.kind == BindingKind::Var {} else {
                            compile_error(compiler, "duplicate declaration of `" + name + "`", span)
                        }
                    },
                    None => if compiler.direct_eval.get() && !compiler_is_strict(compiler) {
                        match lookup_outer_binding(compiler, name) {
                            Some(binding) => if binding.declaration_target {
                                if binding.kind != BindingKind::Var {
                                    compile_error(
                                        compiler,
                                        "duplicate declaration of `" + name + "`",
                                        span,
                                    )
                                } else {}
                            } else {
                                add_dynamic_eval_var(
                                    compiler,
                                    name,
                                    bytecode::EvalDeclarationKind::Function,
                                    span,
                                )
                            },
                            None => add_dynamic_eval_var(
                                compiler,
                                name,
                                bytecode::EvalDeclarationKind::Function,
                                span,
                            ),
                        }
                    } else {
                        let _ = declare_current(compiler, name, BindingKind::Var, span);
                    },
                }
            }
        },
        ast::Stmt::ClassDeclaration { name, span, .. } => {
            if name == "" {
                compile_error(compiler, "class declaration requires a name", span)
            } else if dynamic_eval_var_conflicts_current_scope(compiler, name) {
                compile_error(compiler, "duplicate declaration of `" + name + "`", span)
            } else {
                let _ = declare_current(compiler, name, BindingKind::Let, span);
            }
        },
        ast::Stmt::ImportNamespace { default_specifier, local, span, .. } => {
            match default_specifier {
                Some(specifier) => {
                    let _ = declare_current(
                        compiler,
                        specifier.local,
                        BindingKind::Const,
                        specifier.span,
                    );
                },
                None => (),
            };
            let _ = declare_current(compiler, local, BindingKind::Const, span);
        },
        ast::Stmt::ImportNamed { specifiers, .. } => {
            for specifier in specifiers {
                let _ = declare_current(
                    compiler,
                    specifier.local,
                    BindingKind::Const,
                    specifier.span,
                );
            }
        },
        ast::Stmt::ImportSideEffect { .. } | ast::Stmt::ExportNamed { .. } | ast::Stmt::ExportAll {
            ..,
        } => (),
        ast::Stmt::ExportNamespace { local, span, .. } => {
            let _ = declare_current(compiler, local, BindingKind::Const, span);
        },
        ast::Stmt::ExportDefault { local, hoisted, declaration, named, span, .. } => {
            let _ = declare_current(
                compiler,
                local,
                if hoisted {
                    BindingKind::Var
                } else if declaration && named {
                    BindingKind::Let
                } else {
                    BindingKind::Const
                },
                span,
            );
        },
        ast::Stmt::ExportDeclaration { declaration, .. } => {
            declare_lexical_statement(compiler, declaration.get())
        },
        ast::Stmt::Labelled { body, .. } => declare_lexical_statement(compiler, body.get()),
        _ => (),
    }
}

fn declare_lexical_body(compiler: Compiler, body: Vec[ast::Stmt]) -> unit {
    for statement in body {
        declare_lexical_statement(compiler, statement)
    }
}

fn push_loop(compiler: Compiler) -> unit {
    let finalizer_depth = compiler.finalizers.len();
    let label = compiler.pending_loop_label.get();
    compiler.pending_loop_label.set(Option::None);
    compiler.loops.push(LoopContext { continue_jumps: Vec::new(), finalizer_depth, label });
    compiler.breakables.push(
        BreakContext { break_jumps: Vec::new(), finalizer_depth, label: Option::None },
    )
}

fn pop_loop(compiler: Compiler) -> LoopContext {
    match compiler.loops.pop() {
        Some(context) => context,
        None => LoopContext { continue_jumps: Vec::new(), finalizer_depth: 0, label: Option::None },
    }
}

fn push_breakable(compiler: Compiler) -> unit {
    compiler.breakables.push(
        BreakContext {
            break_jumps: Vec::new(),
            finalizer_depth: compiler.finalizers.len(),
            label: Option::None,
        },
    )
}

fn push_label_breakable(compiler: Compiler, label: string) -> unit {
    compiler.breakables.push(
        BreakContext {
            break_jumps: Vec::new(),
            finalizer_depth: compiler.finalizers.len(),
            label: Option::Some(label),
        },
    )
}

fn pop_breakable(compiler: Compiler) -> BreakContext {
    match compiler.breakables.pop() {
        Some(context) => context,
        None => BreakContext { break_jumps: Vec::new(), finalizer_depth: 0, label: Option::None },
    }
}

fn patch_loop_jumps(
    compiler: Compiler,
    break_context: BreakContext,
    loop_context: LoopContext,
    break_target: isize,
    continue_target: isize,
) -> unit {
    for offset in break_context.break_jumps {
        let _ = patch_jump(compiler, offset, break_target);
    }
    for offset in loop_context.continue_jumps {
        let _ = patch_jump(compiler, offset, continue_target);
    }
}

fn compile_loop_jump(compiler: Compiler, is_continue: bool, label: Option[string], span: ast::Span) -> unit {
    match label {
        Some(value) => validate_strict_identifier(compiler, value, span),
        None => (),
    };
    if is_continue {
        let mut selected = Option::None;
        let mut index = compiler.loops.len();
        while index > 0 {
            index -= 1;
            if label.is_none() || compiler.loops[index].label == label {
                selected = Option::Some(index);
                break
            } else {}
        }
        if selected.is_none() {
            compile_error(compiler, "`continue` is only valid inside a loop", span)
        } else {
            let loop_index = selected.unwrap_or(0);
            compile_active_finalizers_from(compiler, compiler.loops[loop_index].finalizer_depth);
            let offset = emit(compiler, bytecode::Instruction::Goto(-1));
            compiler.loops[loop_index].continue_jumps.push(offset)
        }
    } else {
        let mut selected = Option::None;
        let mut index = compiler.breakables.len();
        while index > 0 {
            index -= 1;
            if compiler.breakables[index].label == label {
                selected = Option::Some(index);
                break
            } else {}
        }
        if selected.is_none() {
            compile_error(compiler, "`break` is only valid inside a loop or switch statement", span)
        } else {
            let break_index = selected.unwrap_or(0);
            compile_active_finalizers_from(
                compiler,
                compiler.breakables[break_index].finalizer_depth,
            );
            let offset = emit(compiler, bytecode::Instruction::Goto(-1));
            compiler.breakables[break_index].break_jumps.push(offset)
        }
    }
}

fn begin_protected_region(compiler: Compiler) -> unit {
    compiler.protected_regions.push(
        ProtectedContext {
            segments: Vec::new(),
            segment_start: current_offset(compiler),
            finalizer_depth: compiler.finalizers.len(),
            active: true,
        },
    )
}

fn close_protected_segment(compiler: Compiler, index: isize) -> unit {
    let start = compiler.protected_regions[index].segment_start;
    let end = current_offset(compiler);
    if compiler.protected_regions[index].active && start < end {
        compiler.protected_regions[index].segments.push((start, end))
    } else {}
}

fn finish_protected_region(compiler: Compiler) -> Vec[(isize, isize)] {
    let index = compiler.protected_regions.len() - 1;
    close_protected_segment(compiler, index);
    match compiler.protected_regions.pop() {
        Some(context) => context.segments,
        None => Vec::new(),
    }
}

fn suspend_protected_regions(compiler: Compiler, finalizer_index: isize) -> Vec[isize] {
    let suspended: Vec[isize] = Vec::new();
    let mut index = 0;
    while index < compiler.protected_regions.len() {
        if compiler.protected_regions[index].active
            && compiler.protected_regions[index].finalizer_depth > finalizer_index {
            close_protected_segment(compiler, index);
            compiler.protected_regions[index].active = false;
            suspended.push(index)
        } else {};
        index += 1;
    }
    suspended
}

fn resume_protected_regions(compiler: Compiler, suspended: Vec[isize]) -> unit {
    let start = current_offset(compiler);
    for index in suspended {
        compiler.protected_regions[index].segment_start = start;
        compiler.protected_regions[index].active = true;
    }
}

fn compile_active_finalizers_from(compiler: Compiler, finalizer_depth: isize) -> unit {
    let mut index = compiler.finalizers.len();
    while index > finalizer_depth {
        index -= 1;
        if compiler.finalizers[index].active {
            let suspended = suspend_protected_regions(compiler, index);
            compiler.finalizers[index].active = false;
            compile_finalizer_kind(compiler, compiler.finalizers[index].kind);
            compiler.finalizers[index].active = true;
            resume_protected_regions(compiler, suspended);
        } else {}
    }
}

fn compile_finalizer_kind(compiler: Compiler, kind: FinalizerKind) -> unit {
    match kind {
        FinalizerKind::Statements(body) => compile_block(compiler, body),
        FinalizerKind::Iterator(local) => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(local));
            let _ = emit(compiler, bytecode::Instruction::IteratorClose);
        },
        FinalizerKind::AsyncIterator(local) => compile_async_iterator_close(compiler, local),
    }
}

fn compile_drop_object_result(compiler: Compiler) -> unit {
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let _ = emit(compiler, bytecode::Instruction::IsUndefinedOrNull);
    let invalid_nullish = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let _ = emit(compiler, bytecode::Instruction::TypeOf);
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let object_name = string_constant(compiler, "object");
    let _ = emit(compiler, bytecode::Instruction::PushConst(object_name));
    let _ = emit(compiler, bytecode::Instruction::StrictEq);
    let object_result = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let function_name = string_constant(compiler, "function");
    let _ = emit(compiler, bytecode::Instruction::PushConst(function_name));
    let _ = emit(compiler, bytecode::Instruction::StrictEq);
    let function_result = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let invalid_target = current_offset(compiler);
    let _ = patch_jump(compiler, invalid_nullish, invalid_target);
    let _ = emit(compiler, bytecode::Instruction::GetPrototypeOf);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let invalid_end = emit(compiler, bytecode::Instruction::Goto(-1));
    let object_target = current_offset(compiler);
    let _ = patch_jump(compiler, object_result, object_target);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let valid_object = emit(compiler, bytecode::Instruction::Goto(-1));
    let valid_target = current_offset(compiler);
    let _ = patch_jump(compiler, function_result, valid_target);
    let _ = patch_jump(compiler, valid_object, valid_target);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let _ = patch_jump(compiler, invalid_end, current_offset(compiler));
}

fn compile_async_iterator_close(compiler: Compiler, iterator: isize) -> unit {
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let return_name = string_constant(compiler, "return");
    let _ = emit(compiler, bytecode::Instruction::GetField(return_name));
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let _ = emit(compiler, bytecode::Instruction::IsUndefinedOrNull);
    let missing = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::CallMethod(0));
    emit_suspension(compiler, true);
    compile_drop_object_result(compiler);
    let end = emit(compiler, bytecode::Instruction::Goto(-1));
    let missing_target = current_offset(compiler);
    let _ = patch_jump(compiler, missing, missing_target);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let _ = patch_jump(compiler, end, current_offset(compiler));
}

fn compile_async_iterator_close_throw(compiler: Compiler, iterator: isize, exception: isize) -> unit {
    begin_protected_region(compiler);
    compile_async_iterator_close(compiler, iterator);
    let protected_segments = finish_protected_region(compiler);
    let close_completed = emit(compiler, bytecode::Instruction::Goto(-1));
    let handler_target = current_offset(compiler);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let rethrow_target = current_offset(compiler);
    let _ = patch_jump(compiler, close_completed, rethrow_target);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(exception));
    let _ = emit(compiler, bytecode::Instruction::Throw);
    for (start, end) in protected_segments {
        add_exception_handler(compiler, start, end, handler_target)
    }
}

fn compile_return_finalizers(compiler: Compiler) -> unit {
    compile_active_finalizers_from(compiler, 0)
}

fn emit_suspension(compiler: Compiler, awaiting: bool) -> unit {
    let yield_offset = emit(
        compiler,
        if awaiting {
            bytecode::Instruction::Await
        } else {
            bytecode::Instruction::Yield
        },
    );
    let skip = emit(compiler, bytecode::Instruction::Goto(-1));
    let target = current_offset(compiler);
    let completion = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(completion));
    compile_return_finalizers(compiler);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(completion));
    let _ = emit(compiler, bytecode::Instruction::Return);
    let _ = patch_jump(compiler, skip, current_offset(compiler));
    compiler.generator_return_handlers.push(
        bytecode::GeneratorReturnHandler { yield_offset, throw_target: -1, target },
    )
}

fn js_string(value: string) -> runtime::JsString {
    let bytes = value.to_bytes();
    runtime::JsString::from_utf8(bytes.slice(0, bytes.len()))
}

fn set_function_source(function: bytecode::Function, source: string, span: ast::Span) -> unit {
    if span.start >= 0 && span.end >= span.start && span.end <= source.byte_len() {
        function.set_source_text(js_string(source.byte_slice(span.start, span.end)))
    } else {}
}

fn append_literal_code_point(output: Vec[u16], code_point: u32) -> unit {
    if code_point <= 0xffff {
        output.push(code_point.to_u16())
    } else {
        match runtime::split_code_point(code_point) {
            Some((high, low)) => {
                output.push(high);
                output.push(low)
            },
            None => output.push(0xfffd),
        }
    }
}

fn literal_hex_value(raw: string, start: isize, count: isize) -> u32 {
    let mut value = 0.to_u32();
    for index in start..start + count {
        value = value * 16 + digit_value(raw.byte_get(index)).unwrap_or(0).to_u32();
    }
    value
}

fn append_literal_character(output: Vec[u16], raw: string, index: isize) -> isize {
    match raw.decode_at(index) {
        Some((character, width)) => {
            append_literal_code_point(output, character.to_u32());
            index + width
        },
        None => {
            output.push(0xfffd);
            index + 1
        },
    }
}

fn string_literal(raw: string) -> runtime::JsString {
    if raw.byte_len() < 2 {
        return js_string(raw)
    } else {};
    let template = raw.byte_get(0) == b'`' || raw.byte_get(0) == b'}';
    let output: Vec[u16] = Vec::with_capacity(raw.byte_len() - 2);
    let limit = if template && raw.byte_len() >= 2 && raw.byte_get(raw.byte_len() - 2) == b'$'
        && raw.byte_get(raw.byte_len() - 1) == b'{' {
        raw.byte_len() - 2
    } else {
        raw.byte_len() - 1
    };
    let mut index = 1;
    while index < limit {
        if template && raw.byte_get(index) == b'\r' {
            output.push(10);
            if index + 1 < limit && raw.byte_get(index + 1) == b'\n' {
                index += 2;
            } else {
                index += 1;
            }
        } else if raw.byte_get(index) != b'\\' {
            index = append_literal_character(output, raw, index);
        } else if index + 1 >= limit {
            index += 1;
        } else {
            let escaped = raw.byte_get(index + 1);
            if escaped == b'b' {
                output.push(8);
                index += 2;
            } else if escaped == b'f' {
                output.push(12);
                index += 2;
            } else if escaped == b'n' {
                output.push(10);
                index += 2;
            } else if escaped == b'r' {
                output.push(13);
                index += 2;
            } else if escaped == b't' {
                output.push(9);
                index += 2;
            } else if escaped == b'v' {
                output.push(11);
                index += 2;
            } else if escaped == b'0' {
                output.push(0);
                index += 2;
            } else if escaped == b'x' && index + 3 < limit {
                output.push(literal_hex_value(raw, index + 2, 2).to_u16());
                index += 4;
            } else if escaped == b'u' && index + 2 < limit && raw.byte_get(index + 2) == b'{' {
                let start = index + 3;
                let mut end = start;
                while end < limit && raw.byte_get(end) != b'}' {
                    end += 1;
                }
                append_literal_code_point(output, literal_hex_value(raw, start, end - start));
                index = if end < limit {
                    end + 1
                } else {
                    end
                };
            } else if escaped == b'u' && index + 5 < limit {
                output.push(literal_hex_value(raw, index + 2, 4).to_u16());
                index += 6;
            } else if escaped == b'\r' {
                if index + 2 < limit && raw.byte_get(index + 2) == b'\n' {
                    index += 3;
                } else {
                    index += 2;
                }
            } else if escaped == b'\n' {
                index += 2;
            } else if escaped < 128 {
                output.push(escaped.to_u16());
                index += 2;
            } else {
                index = append_literal_character(output, raw, index + 1);
            }
        }
    }
    runtime::JsString::from_code_units(output)
}

fn string_constant(compiler: Compiler, value: string) -> isize {
    add_constant(compiler, bytecode::Constant::String(js_string(value)))
}

fn template_constant(compiler: Compiler, cooked: Vec[Option[string]], raw: Vec[string]) -> isize {
    let cooked_values: Vec[Option[runtime::JsString]] = Vec::with_capacity(cooked.len());
    for value in cooked {
        cooked_values.push(
            match value {
                Some(value) => Option::Some(js_string(value)),
                None => Option::None,
            },
        )
    }
    let raw_values: Vec[runtime::JsString] = Vec::with_capacity(raw.len());
    for value in raw {
        raw_values.push(js_string(value))
    }
    add_constant(
        compiler,
        bytecode::Constant::Template(
            Ref::new(bytecode::TemplateConstant::new(cooked_values, raw_values)),
        ),
    )
}

fn normalized_numeric_text(value: string) -> string {
    text::replace(value, "_", "")
}

fn digit_value(value: byte) -> Option[isize] {
    if value >= b'0' && value <= b'9' {
        Option::Some((value - b'0').to_isize())
    } else if value >= b'a' && value <= b'f' {
        Option::Some((value - b'a').to_isize() + 10)
    } else if value >= b'A' && value <= b'F' {
        Option::Some((value - b'A').to_isize() + 10)
    } else {
        Option::None
    }
}

fn prefixed_parts(value: string) -> Option[(isize, isize)] {
    if value.byte_len() < 2 || value.byte_get(0) != b'0' {
        Option::None
    } else {
        match value.byte_get(1) {
            b'b' | b'B' => Option::Some((2, 2)),
            b'o' | b'O' => Option::Some((8, 2)),
            b'x' | b'X' => Option::Some((16, 2)),
            _ => Option::None,
        }
    }
}

fn parse_radix_float(value: string, start: isize, radix: isize) -> Result[f64, string] {
    let mut result = 0.0;
    let radix_value = num::parse_float64(radix.to_string()).unwrap_or(0.0);
    let mut index = start;
    if index >= value.byte_len() {
        return Result::Err("numeric literal has no digits")
    } else {};
    while index < value.byte_len() {
        match digit_value(value.byte_get(index)) {
            Some(digit) => if digit < radix {
                let digit_value = num::parse_float64(digit.to_string()).unwrap_or(0.0);
                result = result * radix_value + digit_value;
            } else {
                return Result::Err("digit is outside numeric literal radix")
            },
            None => return Result::Err("invalid digit in numeric literal"),
        };
        index += 1;
    }
    Result::Ok(result)
}

fn parse_number(value: string) -> Result[(bool, i32, f64), string] {
    let normalized = normalized_numeric_text(value);
    if normalized.byte_len() > 1 && normalized.byte_get(0) == b'0'
        && text::find_bytes(normalized, ".").is_none()
        && text::find_bytes(normalized, "e").is_none()
        && text::find_bytes(normalized, "E").is_none() {
        match num::parse_uint_radix(normalized, 8) {
            Ok(integer) => if integer <= 2147483647 {
                return Result::Ok((true, integer.to_i32(), 0.0))
            } else {},
            Err(_) => (),
        }
    } else {};
    match prefixed_parts(normalized) {
        Some((radix, start)) => match num::parse_uint_radix(
            normalized.byte_slice(start, normalized.byte_len()),
            radix,
        ) {
            Ok(integer) => if integer <= 2147483647 {
                Result::Ok((true, integer.to_i32(), 0.0))
            } else {
                match parse_radix_float(normalized, start, radix) {
                    Ok(number) => Result::Ok((false, 0, number)),
                    Err(message) => Result::Err(message),
                }
            },
            Err(_) => match parse_radix_float(normalized, start, radix) {
                Ok(number) => Result::Ok((false, 0, number)),
                Err(message) => Result::Err(message),
            },
        },
        None => if text::find_bytes(normalized, ".").is_none()
            && text::find_bytes(normalized, "e").is_none()
            && text::find_bytes(normalized, "E").is_none() {
            match num::parse_int(normalized) {
                Ok(integer) => if integer >= -2147483648 && integer <= 2147483647 {
                    Result::Ok((true, integer.to_i32(), 0.0))
                } else {
                    match num::parse_float64(normalized) {
                        Ok(number) => Result::Ok((false, 0, number)),
                        Err(message) => Result::Err(message),
                    }
                },
                Err(_) => match num::parse_float64(normalized) {
                    Ok(number) => Result::Ok((false, 0, number)),
                    Err(message) => Result::Err(message),
                },
            }
        } else {
            match num::parse_float64(normalized) {
                Ok(number) => Result::Ok((false, 0, number)),
                Err(message) => Result::Err(message),
            }
        },
    }
}

fn parse_bigint(value: string) -> Result[runtime::BigInt, string] {
    let mut normalized = normalized_numeric_text(value);
    if normalized.byte_len() == 0 || normalized.byte_get(normalized.byte_len() - 1) != b'n' {
        return Result::Err("BigInt literal must end in `n`")
    } else {};
    normalized = normalized.byte_slice(0, normalized.byte_len() - 1);
    let (radix, start) = match prefixed_parts(normalized) {
        Some(parts) => parts,
        None => (10, 0),
    };
    if start >= normalized.byte_len() {
        return Result::Err("BigInt literal has no digits")
    } else {};
    match runtime::BigInt::parse_radix(normalized.byte_slice(start, normalized.byte_len()), radix) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(value.to_string()),
    }
}

fn compile_plain_identifier(compiler: Compiler, name: string, span: ast::Span) -> unit {
    match lookup_binding(compiler, name) {
        Some(binding) => if is_global_lexical_binding(compiler, binding) {
            let index = string_constant(compiler, name);
            let _ = emit(compiler, bytecode::Instruction::GetEval(index));
        } else {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(binding.index));
        },
        None => if has_dynamic_eval_var(compiler, name) {
            let index = string_constant(compiler, name);
            let _ = emit(compiler, bytecode::Instruction::GetEval(index));
        } else {
            match resolve_upvalue(compiler, name) {
                Some((index, _)) => {
                    let depth = outer_binding_environment_depth(compiler, name);
                    if depth > 0 {
                        let name_index = string_constant(compiler, name);
                        let _ = emit(
                            compiler,
                            bytecode::Instruction::GetEvalOrUpvalue(name_index, index, depth),
                        );
                    } else {
                        let _ = emit(compiler, bytecode::Instruction::GetUpvalue(index));
                    }
                },
                None => {
                    if name == "arguments" && compiler.lexical_arguments {
                        match resolve_upvalue(compiler, "$arguments") {
                            Some((index, _)) => {
                                let name_index = string_constant(compiler, name);
                                let depth = outer_binding_environment_depth(compiler, "$arguments");
                                let _ = emit(
                                    compiler,
                                    bytecode::Instruction::GetEvalOrUpvalue(
                                        name_index,
                                        index,
                                        depth,
                                    ),
                                );
                                return
                            },
                            None => (),
                        }
                    } else {};
                    if name == "arguments" && compiler.arguments_available {
                        let name_index = string_constant(compiler, name);
                        let _ = emit(
                            compiler,
                            bytecode::Instruction::GetEvalOrArguments(
                                name_index,
                                current_eval_environment_depth(compiler),
                            ),
                        );
                        return
                    } else if is_known_global(name) || compiler.allow_unknown_globals.get() {
                        let index = string_constant(compiler, name);
                        let _ = emit(compiler, bytecode::Instruction::GetEval(index));
                        return
                    } else {
                        compile_error(compiler, "undefined identifier `" + name + "`", span)
                    };
                    let _ = emit(compiler, bytecode::Instruction::Undefined);
                },
            }
        },
    }
}

fn compile_with_binding_value(compiler: Compiler, name: string, span: ast::Span) -> unit {
    match lookup_binding(compiler, name) {
        Some(binding) => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(binding.index));
        },
        None => match resolve_upvalue(compiler, name) {
            Some((index, _)) => {
                let _ = emit(compiler, bytecode::Instruction::GetUpvalue(index));
            },
            None => {
                compile_error(compiler, "missing with environment", span);
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            },
        },
    }
}

fn compile_identifier(compiler: Compiler, name: string, span: ast::Span) -> unit {
    validate_strict_identifier(compiler, name, span);
    if compiler.with_bindings.is_empty() {
        compile_plain_identifier(compiler, name, span);
        return
    } else {};
    let property = string_constant(compiler, name);
    let misses: Vec[isize] = Vec::new();
    let ends: Vec[isize] = Vec::new();
    let local_scope = binding_scope_index(compiler, name);
    for binding in compiler.with_bindings {
        match local_scope {
            Some(value) => if binding.scope_index <= value {
                break
            } else {},
            None => (),
        };
        let target = current_offset(compiler);
        if !misses.is_empty() {
            let _ = patch_jump(compiler, misses[misses.len() - 1], target);
        } else {};
        let _ = emit(compiler, bytecode::Instruction::PushConst(property));
        compile_with_binding_value(compiler, binding.name, span);
        let _ = emit(compiler, bytecode::Instruction::WithHasBinding);
        misses.push(emit(compiler, bytecode::Instruction::IfFalse(-1)));
        compile_with_binding_value(compiler, binding.name, span);
        let _ = emit(compiler, bytecode::Instruction::GetField(property));
        ends.push(emit(compiler, bytecode::Instruction::Goto(-1)));
    }
    let fallback = current_offset(compiler);
    if !misses.is_empty() {
        let _ = patch_jump(compiler, misses[misses.len() - 1], fallback);
    } else {};
    compile_plain_identifier(compiler, name, span);
    let end = current_offset(compiler);
    for offset in ends {
        let _ = patch_jump(compiler, offset, end);
    }
}

fn compile_regexp_literal(compiler: Compiler, pattern: string, flags: string, span: ast::Span) -> unit {
    let bytes = pattern.to_bytes();
    let pattern_value = runtime::JsString::from_utf8(bytes.slice(0, bytes.len()));
    match regexp::compile_with_flags(pattern_value, flags) {
        Ok(_) => (),
        Err(value) => {
            compile_error(
                compiler,
                "invalid regular expression at UTF-16 offset " + value.offset.to_string() + ": "
                    + value.message,
                span,
            );
            let _ = emit(compiler, bytecode::Instruction::Undefined);
            return
        },
    };
    let pattern = string_constant(compiler, pattern);
    let flags = string_constant(compiler, flags);
    let _ = emit(compiler, bytecode::Instruction::NewRegExp(pattern, flags));
}

fn private_binding_name(name: string) -> string {
    "$private:#" + name
}

fn compile_private_name(compiler: Compiler, name: string, span: ast::Span) -> unit {
    let binding_name = private_binding_name(name);
    match lookup_binding(compiler, binding_name) {
        Some(binding) => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(binding.index));
        },
        None => match resolve_upvalue(compiler, binding_name) {
            Some((index, _)) => {
                let _ = emit(compiler, bytecode::Instruction::GetUpvalue(index));
            },
            None => {
                compile_error(compiler, "private name `#" + name + "` is not declared", span);
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            },
        },
    }
}

fn compile_number(compiler: Compiler, raw: string, span: ast::Span) -> unit {
    match parse_number(raw) {
        Ok((integer, int_value, float_value)) => if integer {
            let _ = emit(compiler, bytecode::Instruction::PushI32(int_value));
        } else {
            let index = add_constant(compiler, bytecode::Constant::Float(float_value));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
        },
        Err(message) => {
            compile_error(compiler, "invalid numeric literal: " + message, span);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
    }
}

fn compile_bigint(compiler: Compiler, raw: string, span: ast::Span) -> unit {
    match parse_bigint(raw) {
        Ok(value) => {
            let index = add_constant(compiler, bytecode::Constant::BigInt(value));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
        },
        Err(message) => {
            compile_error(compiler, "invalid BigInt literal: " + message, span);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
    }
}

fn has_optional_chain(expression: ast::Expr) -> bool {
    match expression {
        ast::Expr::Member { object, optional, .. } => {
            optional || has_optional_chain(object.get())
        },
        ast::Expr::Call { callee, optional, .. } => {
            optional || has_optional_chain(callee.get())
        },
        _ => false,
    }
}

fn parenthesized_has_optional_chain(expression: ast::Expr) -> bool {
    match expression {
        ast::Expr::Parenthesized { expression, .. } => {
            parenthesized_has_optional_chain(expression.get())
        },
        _ => has_optional_chain(expression),
    }
}

fn emit_optional_chain_test(
    compiler: Compiler,
    drop_count: isize,
    result_count: isize,
    short_circuit_true: bool,
    exits: Vec[isize],
) -> unit {
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let _ = emit(compiler, bytecode::Instruction::IsUndefinedOrNull);
    let present = emit(compiler, bytecode::Instruction::IfFalse(-1));
    let mut dropped = 0;
    while dropped < drop_count {
        let _ = emit(compiler, bytecode::Instruction::Drop);
        dropped += 1;
    }
    if short_circuit_true {
        let _ = emit(compiler, bytecode::Instruction::PushTrue);
    } else {
        let mut pushed = 0;
        while pushed < result_count {
            let _ = emit(compiler, bytecode::Instruction::Undefined);
            pushed += 1;
        }
    };
    exits.push(emit(compiler, bytecode::Instruction::Goto(-1)));
    let _ = patch_jump(compiler, present, current_offset(compiler));
}

fn patch_optional_chain_exits(compiler: Compiler, exits: Vec[isize]) -> unit {
    let end = current_offset(compiler);
    for exit in exits {
        let _ = patch_jump(compiler, exit, end);
    }
}

fn compile_chain_property(
    compiler: Compiler,
    property: ast::Expr,
    computed: bool,
    member_offset: isize,
    span: ast::Span,
) -> unit {
    if computed {
        compile_expression(compiler, property);
        let _ = emit_at(compiler, bytecode::Instruction::GetArrayEl, member_offset);
    } else {
        match property {
            ast::Expr::PrivateIdentifier { name, span } => {
                compile_private_name(compiler, name, span);
                let _ = emit_at(compiler, bytecode::Instruction::GetPrivate, member_offset);
            },
            ast::Expr::Identifier { name, .. } => {
                let index = string_constant(compiler, name);
                let _ = emit_at(compiler, bytecode::Instruction::GetField(index), member_offset);
            },
            _ => {
                compile_error(compiler, "named member requires an identifier", span);
                let _ = emit(compiler, bytecode::Instruction::Drop);
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            },
        }
    }
}

fn compile_chain_member_access(
    compiler: Compiler,
    object: ast::Expr,
    property: ast::Expr,
    computed: bool,
    optional: bool,
    span: ast::Span,
    keep_receiver: bool,
    result_count: isize,
    short_circuit_true: bool,
    exits: Vec[isize],
) -> unit {
    let member_offset = first_source_byte_between(
        compiler,
        ast::expr_span(object).end,
        ast::expr_span(property).start,
    );
    if match object {
        ast::Expr::Super { .. } => true,
        _ => false,
    } {
        if optional {
            compile_error(compiler, "optional chain cannot start from `super`", span);
            if keep_receiver {
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            } else {};
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        } else {
            if keep_receiver {
                compile_this_value(compiler)
            } else {};
            compile_member(
                compiler,
                ast::Expr::Member {
                    object: Ref::new(object),
                    property: Ref::new(property),
                    computed,
                    optional,
                    span,
                },
            )
        }
    } else {
        compile_chain_value(compiler, object, result_count, short_circuit_true, exits);
        if optional {
            emit_optional_chain_test(compiler, 1, result_count, short_circuit_true, exits)
        } else {};
        if keep_receiver {
            let _ = emit(compiler, bytecode::Instruction::Dup);
        } else {};
        compile_chain_property(compiler, property, computed, member_offset, span);
    }
}

fn compile_chain_value(
    compiler: Compiler,
    expression: ast::Expr,
    result_count: isize,
    short_circuit_true: bool,
    exits: Vec[isize],
) -> unit {
    match expression {
        ast::Expr::Member { object, property, computed, optional, span } => {
            if optional || has_optional_chain(object.get()) {
                compile_chain_member_access(
                    compiler,
                    object.get(),
                    property.get(),
                    computed,
                    optional,
                    span,
                    false,
                    result_count,
                    short_circuit_true,
                    exits,
                )
            } else {
                compile_member(
                    compiler,
                    ast::Expr::Member { object, property, computed, optional, span },
                )
            }
        },
        ast::Expr::Call { callee, arguments, optional, span } => {
            if optional || has_optional_chain(callee.get()) {
                compile_chain_call(
                    compiler,
                    callee.get(),
                    arguments,
                    optional,
                    span,
                    result_count,
                    short_circuit_true,
                    exits,
                )
            } else {
                compile_call(compiler, callee.get(), arguments, span)
            }
        },
        _ => compile_expression(compiler, expression),
    }
}

fn compile_optional_chain_expression(compiler: Compiler, expression: ast::Expr) -> unit {
    let exits: Vec[isize] = Vec::new();
    compile_chain_value(compiler, expression, 1, false, exits);
    patch_optional_chain_exits(compiler, exits);
}

fn compile_optional_chain_reference(compiler: Compiler, expression: ast::Expr) -> unit {
    let exits: Vec[isize] = Vec::new();
    match expression {
        ast::Expr::Member { object, property, computed, optional, span } => {
            compile_chain_member_access(
                compiler,
                object.get(),
                property.get(),
                computed,
                optional,
                span,
                true,
                2,
                false,
                exits,
            )
        },
        _ => {
            let _ = emit(compiler, bytecode::Instruction::Undefined);
            compile_expression(compiler, expression);
        },
    };
    patch_optional_chain_exits(compiler, exits);
}

fn compile_parenthesized_callee(compiler: Compiler, expression: ast::Expr) -> bool {
    match expression {
        ast::Expr::Parenthesized { expression, .. } => {
            compile_parenthesized_callee(compiler, expression.get())
        },
        ast::Expr::Member { .. } => {
            compile_optional_chain_reference(compiler, expression);
            true
        },
        _ => {
            compile_expression(compiler, expression);
            false
        },
    }
}

fn compile_member(compiler: Compiler, expression: ast::Expr) -> unit {
    match expression {
        ast::Expr::Member { object, property, computed, optional, span } => {
            let member_offset = first_source_byte_between(
                compiler,
                ast::expr_span(object.get()).end,
                ast::expr_span(property.get()).start,
            );
            if optional {
                compile_optional_chain_expression(
                    compiler,
                    ast::Expr::Member { object, property, computed, optional, span },
                )
            } else if match object.get() {
                ast::Expr::Super { .. } => true,
                _ => false,
            } {
                if !compiler.super_property_allowed {
                    compile_error(
                        compiler,
                        "super property access is not valid in this function",
                        span,
                    );
                    let _ = emit(compiler, bytecode::Instruction::Undefined);
                } else if computed {
                    ensure_super_this_capture(compiler);
                    compile_expression(compiler, property.get());
                    let _ = emit_at(compiler, bytecode::Instruction::GetSuperEl, member_offset);
                } else {
                    match property.get() {
                        ast::Expr::Identifier { name, .. } => {
                            ensure_super_this_capture(compiler);
                            let index = string_constant(compiler, name);
                            let _ = emit_at(
                                compiler,
                                bytecode::Instruction::GetSuperField(index),
                                member_offset,
                            );
                        },
                        _ => {
                            compile_error(
                                compiler,
                                "named super member requires an identifier",
                                span,
                            );
                            let _ = emit(compiler, bytecode::Instruction::Undefined);
                        },
                    }
                }
            } else if !computed
                && match property.get() {
                    ast::Expr::PrivateIdentifier { .. } => true,
                    _ => false,
                } {
                compile_expression(compiler, object.get());
                match property.get() {
                    ast::Expr::PrivateIdentifier { name, span } => {
                        compile_private_name(compiler, name, span)
                    },
                    _ => (),
                };
                let _ = emit_at(compiler, bytecode::Instruction::GetPrivate, member_offset);
            } else if computed {
                compile_expression(compiler, object.get());
                compile_expression(compiler, property.get());
                let _ = emit_at(compiler, bytecode::Instruction::GetArrayEl, member_offset);
            } else {
                match property.get() {
                    ast::Expr::Identifier { name, .. } => {
                        compile_expression(compiler, object.get());
                        let index = string_constant(compiler, name);
                        let _ = emit_at(
                            compiler,
                            bytecode::Instruction::GetField(index),
                            member_offset,
                        );
                    },
                    _ => {
                        compile_error(compiler, "named member requires an identifier", span);
                        compile_expression(compiler, object.get());
                        let _ = emit(compiler, bytecode::Instruction::Drop);
                        let _ = emit(compiler, bytecode::Instruction::Undefined);
                    },
                }
            }
        },
        _ => (),
    }
}

fn compile_this_value(compiler: Compiler) -> unit {
    if compiler.lexical_this {
        match resolve_upvalue(compiler, "$this") {
            Some((index, _)) => {
                let _ = emit(compiler, bytecode::Instruction::GetUpvalue(index));
            },
            None => {
                let _ = emit(compiler, bytecode::Instruction::PushThis);
            },
        }
    } else {
        let _ = emit(compiler, bytecode::Instruction::PushThis);
    }
}

fn call_arguments_have_spread(arguments: Vec[ast::Expr]) -> bool {
    for argument in arguments {
        match argument {
            ast::Expr::Spread { .. } => return true,
            _ => (),
        }
    }
    false
}

fn compile_call_argument_array(compiler: Compiler, arguments: Vec[ast::Expr]) -> unit {
    let _ = emit(compiler, bytecode::Instruction::NewArray(0));
    for argument in arguments {
        match argument {
            ast::Expr::Spread { argument, .. } => {
                compile_expression(compiler, argument.get());
                let _ = emit(compiler, bytecode::Instruction::ArrayAppendSpread);
            },
            _ => {
                compile_expression(compiler, argument);
                let _ = emit(compiler, bytecode::Instruction::ArrayAppend);
            },
        }
    }
}

fn compile_call_from_stack(
    compiler: Compiler,
    arguments: Vec[ast::Expr],
    spread: bool,
    method: bool,
    call_offset: isize,
) -> unit {
    if spread {
        compile_call_argument_array(compiler, arguments);
        let _ = emit_at(
            compiler,
            if method {
                bytecode::Instruction::CallMethodArray
            } else {
                bytecode::Instruction::CallArray
            },
            call_offset,
        );
    } else {
        for argument in arguments {
            compile_expression(compiler, argument)
        }
        let _ = emit_at(
            compiler,
            if method {
                bytecode::Instruction::CallMethod(arguments.len())
            } else {
                bytecode::Instruction::Call(arguments.len())
            },
            call_offset,
        );
    }
}

fn compile_chain_callee(
    compiler: Compiler,
    callee: ast::Expr,
    result_count: isize,
    short_circuit_true: bool,
    exits: Vec[isize],
) -> bool {
    match callee {
        ast::Expr::Member { object, property, computed, optional, span } => {
            compile_chain_member_access(
                compiler,
                object.get(),
                property.get(),
                computed,
                optional,
                span,
                true,
                result_count,
                short_circuit_true,
                exits,
            );
            true
        },
        ast::Expr::Parenthesized { expression, .. } => {
            compile_parenthesized_callee(compiler, expression.get())
        },
        _ => {
            compile_chain_value(compiler, callee, result_count, short_circuit_true, exits);
            false
        },
    }
}

fn compile_chain_call(
    compiler: Compiler,
    callee: ast::Expr,
    arguments: Vec[ast::Expr],
    optional: bool,
    span: ast::Span,
    result_count: isize,
    short_circuit_true: bool,
    exits: Vec[isize],
) -> unit {
    let call_offset = first_source_byte_between(compiler, ast::expr_span(callee).end, span.end);
    let method = compile_chain_callee(compiler, callee, result_count, short_circuit_true, exits);
    if optional {
        emit_optional_chain_test(
            compiler,
            if method {
                2
            } else {
                1
            },
            result_count,
            short_circuit_true,
            exits,
        )
    } else {};
    let spread = call_arguments_have_spread(arguments);
    compile_call_from_stack(compiler, arguments, spread, method, call_offset);
}

fn compile_call(
    compiler: Compiler,
    callee: ast::Expr,
    arguments: Vec[ast::Expr],
    call_span: ast::Span,
) -> unit {
    let spread = call_arguments_have_spread(arguments);
    let call_offset = first_source_byte_between(compiler, ast::expr_span(callee).end, call_span.end);
    if !spread
        && match callee {
            ast::Expr::Identifier { name, .. } => name == "eval",
            _ => false,
        } {
        compile_identifier(compiler, "eval", ast::expr_span(callee));
        for argument in arguments {
            compile_expression(compiler, argument)
        }
        let bindings = current_eval_bindings(compiler);
        let site = add_eval_site(compiler, bindings);
        let _ = emit_at(compiler, bytecode::Instruction::Eval(arguments.len(), site), call_offset);
        return
    } else {};
    match callee {
        ast::Expr::Parenthesized { expression, .. } => {
            if parenthesized_has_optional_chain(expression.get()) {
                let method = compile_parenthesized_callee(compiler, expression.get());
                compile_call_from_stack(compiler, arguments, spread, method, call_offset)
            } else {
                compile_call(compiler, expression.get(), arguments, call_span)
            }
        },
        ast::Expr::Super { span } => {
            if !compiler.super_call_allowed {
                compile_error(compiler, "super() is only valid in a derived constructor", span);
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            } else if spread {
                ensure_super_this_capture(compiler);
                compile_call_argument_array(compiler, arguments);
                let _ = emit_at(compiler, bytecode::Instruction::CallSuperArray, call_offset);
            } else {
                ensure_super_this_capture(compiler);
                for argument in arguments {
                    compile_expression(compiler, argument)
                }
                let _ = emit_at(
                    compiler,
                    bytecode::Instruction::CallSuper(arguments.len()),
                    call_offset,
                );
            }
        },
        ast::Expr::Member { object, property, computed, optional, span } => if optional {
            compile_optional_chain_expression(
                compiler,
                ast::Expr::Call {
                    callee: Ref::new(
                        ast::Expr::Member { object, property, computed, optional, span },
                    ),
                    arguments,
                    optional: false,
                    span: call_span,
                },
            )
        } else if match object.get() {
            ast::Expr::Super { .. } => true,
            _ => false,
        } {
            ensure_super_this_capture(compiler);
            compile_this_value(compiler);
            compile_member(
                compiler,
                ast::Expr::Member { object, property, computed, optional, span },
            );
            if spread {
                compile_call_argument_array(compiler, arguments);
                let _ = emit_at(compiler, bytecode::Instruction::CallMethodArray, call_offset);
            } else {
                for argument in arguments {
                    compile_expression(compiler, argument)
                }
                let _ = emit_at(
                    compiler,
                    bytecode::Instruction::CallMethod(arguments.len()),
                    call_offset,
                );
            }
        } else if !computed
            && match property.get() {
                ast::Expr::PrivateIdentifier { .. } => true,
                _ => false,
            } {
            compile_expression(compiler, object.get());
            let _ = emit(compiler, bytecode::Instruction::Dup);
            match property.get() {
                ast::Expr::PrivateIdentifier { name, span } => {
                    compile_private_name(compiler, name, span)
                },
                _ => (),
            };
            let _ = emit(compiler, bytecode::Instruction::GetPrivate);
            if spread {
                compile_call_argument_array(compiler, arguments);
                let _ = emit_at(compiler, bytecode::Instruction::CallMethodArray, call_offset);
            } else {
                for argument in arguments {
                    compile_expression(compiler, argument)
                }
                let _ = emit_at(
                    compiler,
                    bytecode::Instruction::CallMethod(arguments.len()),
                    call_offset,
                );
            }
        } else if computed {
            compile_expression(compiler, object.get());
            let _ = emit(compiler, bytecode::Instruction::Dup);
            compile_expression(compiler, property.get());
            let _ = emit(compiler, bytecode::Instruction::GetArrayEl);
            if spread {
                compile_call_argument_array(compiler, arguments);
                let _ = emit_at(compiler, bytecode::Instruction::CallMethodArray, call_offset);
            } else {
                for argument in arguments {
                    compile_expression(compiler, argument)
                }
                let _ = emit_at(
                    compiler,
                    bytecode::Instruction::CallMethod(arguments.len()),
                    call_offset,
                );
            }
        } else {
            match property.get() {
                ast::Expr::Identifier { name, .. } => {
                    compile_expression(compiler, object.get());
                    let _ = emit(compiler, bytecode::Instruction::Dup);
                    let index = string_constant(compiler, name);
                    let _ = emit(compiler, bytecode::Instruction::GetField(index));
                    if spread {
                        compile_call_argument_array(compiler, arguments);
                        let _ = emit_at(
                            compiler,
                            bytecode::Instruction::CallMethodArray,
                            call_offset,
                        );
                    } else {
                        for argument in arguments {
                            compile_expression(compiler, argument)
                        }
                        let _ = emit_at(
                            compiler,
                            bytecode::Instruction::CallMethod(arguments.len()),
                            call_offset,
                        );
                    }
                },
                _ => {
                    compile_error(compiler, "named member requires an identifier", span);
                    let _ = emit(compiler, bytecode::Instruction::Undefined);
                },
            }
        },
        _ => {
            compile_expression(compiler, callee);
            if spread {
                compile_call_argument_array(compiler, arguments);
                let _ = emit_at(compiler, bytecode::Instruction::CallArray, call_offset);
            } else {
                for argument in arguments {
                    compile_expression(compiler, argument)
                }
                let _ = emit_at(compiler, bytecode::Instruction::Call(arguments.len()), call_offset);
            }
        },
    }
}

fn compile_tagged_arguments(
    compiler: Compiler,
    template_index: isize,
    substitutions: Vec[Ref[ast::Expr]],
) -> unit {
    let _ = emit(compiler, bytecode::Instruction::PushConst(template_index));
    for substitution in substitutions {
        compile_expression(compiler, substitution.get())
    }
}

fn compile_tagged_template(
    compiler: Compiler,
    tag: ast::Expr,
    cooked: Vec[Option[string]],
    raw: Vec[string],
    substitutions: Vec[Ref[ast::Expr]],
) -> unit {
    let argument_count = substitutions.len() + 1;
    let template_index = template_constant(compiler, cooked, raw);
    match tag {
        ast::Expr::Parenthesized { expression, .. } => {
            let method = compile_parenthesized_callee(compiler, expression.get());
            compile_tagged_arguments(compiler, template_index, substitutions);
            let _ = emit(
                compiler,
                if method {
                    bytecode::Instruction::CallMethod(argument_count)
                } else {
                    bytecode::Instruction::Call(argument_count)
                },
            );
        },
        ast::Expr::Member { object, property, computed, optional, span } => if match object.get() {
            ast::Expr::Super { .. } => true,
            _ => false,
        } {
            ensure_super_this_capture(compiler);
            compile_this_value(compiler);
            compile_member(
                compiler,
                ast::Expr::Member { object, property, computed, optional, span },
            );
            compile_tagged_arguments(compiler, template_index, substitutions);
            let _ = emit(compiler, bytecode::Instruction::CallMethod(argument_count));
        } else if !computed
            && match property.get() {
                ast::Expr::PrivateIdentifier { .. } => true,
                _ => false,
            } {
            compile_expression(compiler, object.get());
            let _ = emit(compiler, bytecode::Instruction::Dup);
            match property.get() {
                ast::Expr::PrivateIdentifier { name, span } => {
                    compile_private_name(compiler, name, span)
                },
                _ => (),
            };
            let _ = emit(compiler, bytecode::Instruction::GetPrivate);
            compile_tagged_arguments(compiler, template_index, substitutions);
            let _ = emit(compiler, bytecode::Instruction::CallMethod(argument_count));
        } else if computed {
            compile_expression(compiler, object.get());
            let _ = emit(compiler, bytecode::Instruction::Dup);
            compile_expression(compiler, property.get());
            let _ = emit(compiler, bytecode::Instruction::GetArrayEl);
            compile_tagged_arguments(compiler, template_index, substitutions);
            let _ = emit(compiler, bytecode::Instruction::CallMethod(argument_count));
        } else {
            match property.get() {
                ast::Expr::Identifier { name, .. } => {
                    compile_expression(compiler, object.get());
                    let _ = emit(compiler, bytecode::Instruction::Dup);
                    let index = string_constant(compiler, name);
                    let _ = emit(compiler, bytecode::Instruction::GetField(index));
                    compile_tagged_arguments(compiler, template_index, substitutions);
                    let _ = emit(compiler, bytecode::Instruction::CallMethod(argument_count));
                },
                _ => {
                    compile_error(compiler, "named member requires an identifier", span);
                    let _ = emit(compiler, bytecode::Instruction::Undefined);
                },
            }
        },
        _ => {
            compile_expression(compiler, tag);
            compile_tagged_arguments(compiler, template_index, substitutions);
            let _ = emit(compiler, bytecode::Instruction::Call(argument_count));
        },
    }
}

fn compile_construct(compiler: Compiler, callee: ast::Expr, arguments: Vec[ast::Expr]) -> unit {
    compile_expression(compiler, callee);
    if call_arguments_have_spread(arguments) {
        compile_call_argument_array(compiler, arguments);
        let _ = emit(compiler, bytecode::Instruction::ConstructArray);
    } else {
        for argument in arguments {
            compile_expression(compiler, argument)
        }
        let _ = emit(compiler, bytecode::Instruction::Construct(arguments.len()));
    }
}

fn compile_plain_identifier_delete(compiler: Compiler, name: string) -> unit {
    if has_dynamic_eval_var(compiler, name) {
        let index = string_constant(compiler, name);
        let _ = emit(compiler, bytecode::Instruction::DeleteEval(index));
    } else if lookup_binding(compiler, name).is_some() {
        let _ = emit(compiler, bytecode::Instruction::PushFalse);
    } else if lookup_outer_binding(compiler, name).is_some() {
        let depth = outer_binding_environment_depth(compiler, name);
        if depth > 0 {
            let index = string_constant(compiler, name);
            let _ = emit(compiler, bytecode::Instruction::DeleteEvalOrFalse(index, depth));
        } else {
            let _ = emit(compiler, bytecode::Instruction::PushFalse);
        }
    } else if name == "arguments" && (compiler.arguments_available || compiler.lexical_arguments) {
        let depth = if compiler.lexical_arguments {
            outer_binding_environment_depth(compiler, "$arguments")
        } else {
            current_eval_environment_depth(compiler)
        };
        let index = string_constant(compiler, name);
        let _ = emit(compiler, bytecode::Instruction::DeleteEvalOrFalse(index, depth));
    } else {
        let index = string_constant(compiler, name);
        let _ = emit(compiler, bytecode::Instruction::DeleteEval(index));
    }
}

fn compile_with_identifier_delete(compiler: Compiler, name: string, span: ast::Span) -> unit {
    let property = string_constant(compiler, name);
    let misses: Vec[isize] = Vec::new();
    let ends: Vec[isize] = Vec::new();
    let local_scope = binding_scope_index(compiler, name);
    for binding in compiler.with_bindings {
        match local_scope {
            Some(value) => if binding.scope_index <= value {
                break
            } else {},
            None => (),
        };
        let target = current_offset(compiler);
        if !misses.is_empty() {
            let _ = patch_jump(compiler, misses[misses.len() - 1], target);
        } else {};
        let _ = emit(compiler, bytecode::Instruction::PushConst(property));
        compile_with_binding_value(compiler, binding.name, span);
        let _ = emit(compiler, bytecode::Instruction::WithHasBinding);
        misses.push(emit(compiler, bytecode::Instruction::IfFalse(-1)));
        compile_with_binding_value(compiler, binding.name, span);
        let _ = emit(compiler, bytecode::Instruction::PushConst(property));
        let _ = emit(compiler, bytecode::Instruction::Delete);
        ends.push(emit(compiler, bytecode::Instruction::Goto(-1)));
    }
    let fallback = current_offset(compiler);
    if !misses.is_empty() {
        let _ = patch_jump(compiler, misses[misses.len() - 1], fallback);
    } else {};
    compile_plain_identifier_delete(compiler, name);
    let end = current_offset(compiler);
    for offset in ends {
        let _ = patch_jump(compiler, offset, end);
    }
}

fn compile_optional_chain_member_delete(
    compiler: Compiler,
    object: ast::Expr,
    property: ast::Expr,
    computed: bool,
    optional: bool,
    span: ast::Span,
) -> unit {
    if match object {
        ast::Expr::Super { .. } => true,
        _ => false,
    } {
        if optional {
            compile_error(compiler, "optional chain cannot start from `super`", span)
        } else {};
        set_source_offset(compiler, span.start);
        let _ = emit(compiler, bytecode::Instruction::ThrowReferenceError);
        return
    } else {};
    if !computed
        && match property {
            ast::Expr::PrivateIdentifier { .. } => true,
            _ => false,
        } {
        compile_error(compiler, "private elements cannot be deleted", span);
        compile_expression(compiler, object);
        let _ = emit(compiler, bytecode::Instruction::Drop);
        let _ = emit(compiler, bytecode::Instruction::PushFalse);
        return
    } else {};
    let exits: Vec[isize] = Vec::new();
    compile_chain_value(compiler, object, 1, true, exits);
    if optional {
        emit_optional_chain_test(compiler, 1, 1, true, exits)
    } else {};
    if computed {
        compile_expression(compiler, property);
        let _ = emit(compiler, bytecode::Instruction::Delete);
    } else {
        match property {
            ast::Expr::Identifier { name, .. } => {
                let index = string_constant(compiler, name);
                let _ = emit(compiler, bytecode::Instruction::PushConst(index));
                let _ = emit(compiler, bytecode::Instruction::Delete);
            },
            _ => {
                compile_error(compiler, "named member requires an identifier", span);
                let _ = emit(compiler, bytecode::Instruction::Drop);
                let _ = emit(compiler, bytecode::Instruction::PushFalse);
            },
        }
    };
    patch_optional_chain_exits(compiler, exits);
}

fn compile_delete(compiler: Compiler, argument: ast::Expr) -> unit {
    if has_optional_chain(argument) {
        match argument {
            ast::Expr::Member { object, property, computed, optional, span } => {
                if !computed
                    && match property.get() {
                        ast::Expr::PrivateIdentifier { .. } => true,
                        _ => false,
                    } {
                    compile_optional_chain_expression(
                        compiler,
                        ast::Expr::Member { object, property, computed, optional, span },
                    );
                    let _ = emit(compiler, bytecode::Instruction::Drop);
                    let _ = emit(compiler, bytecode::Instruction::PushTrue);
                } else {
                    compile_optional_chain_member_delete(
                        compiler,
                        object.get(),
                        property.get(),
                        computed,
                        optional,
                        span,
                    )
                }
            },
            _ => {
                compile_optional_chain_expression(compiler, argument);
                let _ = emit(compiler, bytecode::Instruction::Drop);
                let _ = emit(compiler, bytecode::Instruction::PushTrue);
            },
        };
        return
    } else {};
    match argument {
        ast::Expr::Parenthesized { expression, .. } => {
            compile_delete(compiler, expression.get())
        },
        ast::Expr::Identifier { name, span } => if compiler_is_strict(compiler) {
            compile_error(compiler, "identifier deletion is not allowed in strict mode", span);
            let _ = emit(compiler, bytecode::Instruction::PushFalse);
        } else if compiler.with_bindings.is_empty() {
            compile_plain_identifier_delete(compiler, name)
        } else {
            compile_with_identifier_delete(compiler, name, span)
        },
        ast::Expr::Member { object, property, computed, optional, span } => if match object.get() {
            ast::Expr::Super { .. } => true,
            _ => false,
        } {
            set_source_offset(compiler, span.start);
            let _ = emit(compiler, bytecode::Instruction::ThrowReferenceError);
        } else if !computed
            && match property.get() {
                ast::Expr::PrivateIdentifier { .. } => true,
                _ => false,
            } {
            compile_error(compiler, "private elements cannot be deleted", span);
            compile_expression(compiler, object.get());
            let _ = emit(compiler, bytecode::Instruction::Drop);
            let _ = emit(compiler, bytecode::Instruction::PushFalse);
        } else if computed {
            compile_expression(compiler, object.get());
            compile_expression(compiler, property.get());
            let _ = emit(compiler, bytecode::Instruction::Delete);
        } else {
            match property.get() {
                ast::Expr::Identifier { name, .. } => {
                    compile_expression(compiler, object.get());
                    let index = string_constant(compiler, name);
                    let _ = emit(compiler, bytecode::Instruction::PushConst(index));
                    let _ = emit(compiler, bytecode::Instruction::Delete);
                },
                _ => {
                    compile_error(compiler, "named member requires an identifier", span);
                    let _ = emit(compiler, bytecode::Instruction::PushFalse);
                },
            }
        },
        _ => {
            compile_expression(compiler, argument);
            let _ = emit(compiler, bytecode::Instruction::Drop);
            let _ = emit(compiler, bytecode::Instruction::PushTrue);
        },
    }
}

fn compile_unary(
    compiler: Compiler,
    operator: ast::UnaryOperator,
    argument: ast::Expr,
    span: ast::Span,
) -> unit {
    if operator == ast::UnaryOperator::Delete {
        compile_delete(compiler, argument)
    } else if operator == ast::UnaryOperator::Typeof {
        match argument {
            ast::Expr::Identifier { name, span } => if !compiler.with_bindings.is_empty() {
                compile_identifier(compiler, name, span)
            } else {
                validate_strict_identifier(compiler, name, span);
                match lookup_binding(compiler, name) {
                    Some(binding) => if is_global_lexical_binding(compiler, binding) {
                        let index = string_constant(compiler, name);
                        let _ = emit(compiler, bytecode::Instruction::GetEval(index));
                    } else {
                        let _ = emit(compiler, bytecode::Instruction::GetLoc(binding.index));
                    },
                    None => if has_dynamic_eval_var(compiler, name) {
                        let index = string_constant(compiler, name);
                        let _ = emit(compiler, bytecode::Instruction::GetEval(index));
                    } else {
                        match resolve_upvalue(compiler, name) {
                            Some((index, _)) => {
                                let depth = outer_binding_environment_depth(compiler, name);
                                if depth > 0 {
                                    let name_index = string_constant(compiler, name);
                                    let _ = emit(
                                        compiler,
                                        bytecode::Instruction::GetEvalOrUpvalue(
                                            name_index,
                                            index,
                                            depth,
                                        ),
                                    );
                                } else {
                                    let _ = emit(compiler, bytecode::Instruction::GetUpvalue(index));
                                }
                            },
                            None => if name == "arguments" && compiler.lexical_arguments {
                                match resolve_upvalue(compiler, "$arguments") {
                                    Some((index, _)) => {
                                        let name_index = string_constant(compiler, name);
                                        let depth = outer_binding_environment_depth(
                                            compiler,
                                            "$arguments",
                                        );
                                        let _ = emit(
                                            compiler,
                                            bytecode::Instruction::GetEvalOrUpvalue(
                                                name_index,
                                                index,
                                                depth,
                                            ),
                                        );
                                    },
                                    None => {
                                        let _ = emit(compiler, bytecode::Instruction::Undefined);
                                    },
                                }
                            } else if name == "arguments" && compiler.arguments_available {
                                let name_index = string_constant(compiler, name);
                                let _ = emit(
                                    compiler,
                                    bytecode::Instruction::GetEvalOrArguments(
                                        name_index,
                                        current_eval_environment_depth(compiler),
                                    ),
                                );
                            } else if is_known_global(name) || compiler.allow_unknown_globals.get() {
                                let index = string_constant(compiler, name);
                                let _ = emit(
                                    compiler,
                                    bytecode::Instruction::GetEvalOrUndefined(index),
                                );
                            } else {
                                let _ = emit(compiler, bytecode::Instruction::Undefined);
                            },
                        }
                    },
                }
            },
            _ => compile_expression(compiler, argument),
        };
        let _ = emit(compiler, bytecode::Instruction::TypeOf);
    } else if operator == ast::UnaryOperator::Void {
        compile_expression(compiler, argument);
        let _ = emit(compiler, bytecode::Instruction::Drop);
        let _ = emit(compiler, bytecode::Instruction::Undefined);
    } else {
        compile_expression(compiler, argument);
        set_source_offset(compiler, span.start);
        let instruction = match operator {
            ast::UnaryOperator::LogicalNot => bytecode::Instruction::LNot,
            ast::UnaryOperator::BitwiseNot => bytecode::Instruction::Not,
            ast::UnaryOperator::Plus => bytecode::Instruction::Plus,
            ast::UnaryOperator::Minus => bytecode::Instruction::Neg,
            ast::UnaryOperator::Typeof => bytecode::Instruction::TypeOf,
            ast::UnaryOperator::Void => bytecode::Instruction::Undefined,
            ast::UnaryOperator::Delete => bytecode::Instruction::Delete,
        };
        let _ = emit(compiler, instruction);
    }
}

fn binary_instruction(operator: ast::BinaryOperator) -> Option[bytecode::Instruction] {
    match operator {
        ast::BinaryOperator::Power => Option::Some(bytecode::Instruction::Pow),
        ast::BinaryOperator::Multiply => Option::Some(bytecode::Instruction::Mul),
        ast::BinaryOperator::Divide => Option::Some(bytecode::Instruction::Div),
        ast::BinaryOperator::Remainder => Option::Some(bytecode::Instruction::Mod),
        ast::BinaryOperator::Add => Option::Some(bytecode::Instruction::Add),
        ast::BinaryOperator::Subtract => Option::Some(bytecode::Instruction::Sub),
        ast::BinaryOperator::ShiftLeft => Option::Some(bytecode::Instruction::Shl),
        ast::BinaryOperator::ShiftRight => Option::Some(bytecode::Instruction::Sar),
        ast::BinaryOperator::ShiftRightUnsigned => Option::Some(bytecode::Instruction::Shr),
        ast::BinaryOperator::Less => Option::Some(bytecode::Instruction::Lt),
        ast::BinaryOperator::LessEqual => Option::Some(bytecode::Instruction::Lte),
        ast::BinaryOperator::Greater => Option::Some(bytecode::Instruction::Gt),
        ast::BinaryOperator::GreaterEqual => Option::Some(bytecode::Instruction::Gte),
        ast::BinaryOperator::Equal => Option::Some(bytecode::Instruction::Eq),
        ast::BinaryOperator::NotEqual => Option::Some(bytecode::Instruction::Neq),
        ast::BinaryOperator::StrictEqual => Option::Some(bytecode::Instruction::StrictEq),
        ast::BinaryOperator::StrictNotEqual => Option::Some(bytecode::Instruction::StrictNeq),
        ast::BinaryOperator::In => Option::Some(bytecode::Instruction::In),
        ast::BinaryOperator::Instanceof => Option::Some(bytecode::Instruction::InstanceOf),
        ast::BinaryOperator::BitwiseAnd => Option::Some(bytecode::Instruction::BitAnd),
        ast::BinaryOperator::BitwiseXor => Option::Some(bytecode::Instruction::BitXor),
        ast::BinaryOperator::BitwiseOr => Option::Some(bytecode::Instruction::BitOr),
        ast::BinaryOperator::LogicalAnd | ast::BinaryOperator::LogicalOr | ast::BinaryOperator::NullishCoalescing => Option::None,
    }
}

fn compile_short_circuit(
    compiler: Compiler,
    operator: ast::BinaryOperator,
    left: ast::Expr,
    right: ast::Expr,
) -> unit {
    compile_expression(compiler, left);
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let branch = if operator == ast::BinaryOperator::LogicalAnd {
        emit(compiler, bytecode::Instruction::IfFalse(-1))
    } else if operator == ast::BinaryOperator::LogicalOr {
        emit(compiler, bytecode::Instruction::IfTrue(-1))
    } else {
        let _ = emit(compiler, bytecode::Instruction::IsUndefinedOrNull);
        emit(compiler, bytecode::Instruction::IfFalse(-1))
    };
    let _ = emit(compiler, bytecode::Instruction::Drop);
    compile_expression(compiler, right);
    let _ = patch_jump(compiler, branch, current_offset(compiler));
}

fn compile_binary(
    compiler: Compiler,
    operator: ast::BinaryOperator,
    left: ast::Expr,
    right: ast::Expr,
    span: ast::Span,
) -> unit {
    if operator == ast::BinaryOperator::In
        && match left {
            ast::Expr::PrivateIdentifier { .. } => true,
            _ => false,
        } {
        match left {
            ast::Expr::PrivateIdentifier { name, span } => {
                compile_private_name(compiler, name, span)
            },
            _ => (),
        };
        compile_expression(compiler, right);
        let _ = emit(compiler, bytecode::Instruction::HasPrivate);
    } else if operator == ast::BinaryOperator::LogicalAnd
        || operator == ast::BinaryOperator::LogicalOr
        || operator == ast::BinaryOperator::NullishCoalescing {
        compile_short_circuit(compiler, operator, left, right)
    } else {
        compile_expression(compiler, left);
        compile_expression(compiler, right);
        set_source_offset(
            compiler,
            first_source_byte_between(
                compiler,
                ast::expr_span(left).end,
                ast::expr_span(right).start,
            ),
        );
        match binary_instruction(operator) {
            Some(instruction) => {
                let _ = emit(compiler, instruction);
            },
            None => {
                compile_error(compiler, "binary operator is not supported by bytecode", span);
                let _ = emit(compiler, bytecode::Instruction::Drop);
                let _ = emit(compiler, bytecode::Instruction::Drop);
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            },
        }
    }
}

fn local_assignment_target(
    compiler: Compiler,
    name: string,
    index: isize,
    kind: BindingKind,
    span: ast::Span,
    upvalue: bool,
) -> AssignmentTarget {
    let named_function = kind == BindingKind::NamedFunction;
    let writable = kind != BindingKind::Const && !named_function;
    let _ = name;
    AssignmentTarget {
        storage: if upvalue {
            AssignmentStorage::Upvalue(index)
        } else {
            AssignmentStorage::Local(index)
        },
        writable,
        throws_on_write: kind == BindingKind::Const
            || named_function && compiler_is_strict(compiler),
        source_offset: span.start,
    }
}

fn plain_identifier_assignment_target(compiler: Compiler, name: string, span: ast::Span) -> AssignmentTarget {
    match lookup_binding(compiler, name) {
        Some(binding) => if is_global_lexical_binding(compiler, binding) {
            AssignmentTarget {
                storage: AssignmentStorage::Eval(string_constant(compiler, name)),
                writable: binding.kind != BindingKind::Const,
                throws_on_write: binding.kind == BindingKind::Const,
                source_offset: span.start,
            }
        } else {
            local_assignment_target(compiler, name, binding.index, binding.kind, span, false)
        },
        None => if has_dynamic_eval_var(compiler, name) {
            AssignmentTarget {
                storage: AssignmentStorage::Eval(string_constant(compiler, name)),
                writable: true,
                throws_on_write: false,
                source_offset: span.start,
            }
        } else {
            match resolve_upvalue(compiler, name) {
                Some((index, kind)) => {
                    let depth = outer_binding_environment_depth(compiler, name);
                    if depth > 0 {
                        let named_function = kind == BindingKind::NamedFunction;
                        AssignmentTarget {
                            storage: AssignmentStorage::EvalOrUpvalue {
                                name: string_constant(compiler, name),
                                upvalue: index,
                                depth,
                            },
                            writable: kind != BindingKind::Const && !named_function,
                            throws_on_write: kind == BindingKind::Const
                                || named_function && compiler_is_strict(compiler),
                            source_offset: span.start,
                        }
                    } else {
                        local_assignment_target(compiler, name, index, kind, span, true)
                    }
                },
                None => if is_known_global(name) || compiler.allow_unknown_globals.get() {
                    AssignmentTarget {
                        storage: AssignmentStorage::Eval(string_constant(compiler, name)),
                        writable: true,
                        throws_on_write: false,
                        source_offset: span.start,
                    }
                } else {
                    compile_error(compiler, "undefined assignment target `" + name + "`", span);
                    AssignmentTarget {
                        storage: AssignmentStorage::Invalid,
                        writable: false,
                        throws_on_write: false,
                        source_offset: span.start,
                    }
                },
            }
        },
    }
}

fn with_identifier_assignment_target(compiler: Compiler, name: string, span: ast::Span) -> AssignmentTarget {
    let receiver = new_local(compiler);
    let property = string_constant(compiler, name);
    let _ = emit(compiler, bytecode::Instruction::Undefined);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(receiver));
    let misses: Vec[isize] = Vec::new();
    let ends: Vec[isize] = Vec::new();
    let local_scope = binding_scope_index(compiler, name);
    for binding in compiler.with_bindings {
        match local_scope {
            Some(value) => if binding.scope_index <= value {
                break
            } else {},
            None => (),
        };
        let target = current_offset(compiler);
        if !misses.is_empty() {
            let _ = patch_jump(compiler, misses[misses.len() - 1], target);
        } else {};
        let _ = emit(compiler, bytecode::Instruction::PushConst(property));
        compile_with_binding_value(compiler, binding.name, span);
        let _ = emit(compiler, bytecode::Instruction::WithHasBinding);
        misses.push(emit(compiler, bytecode::Instruction::IfFalse(-1)));
        compile_with_binding_value(compiler, binding.name, span);
        let _ = emit(compiler, bytecode::Instruction::PutLoc(receiver));
        ends.push(emit(compiler, bytecode::Instruction::Goto(-1)));
    }
    let end = current_offset(compiler);
    if !misses.is_empty() {
        let _ = patch_jump(compiler, misses[misses.len() - 1], end);
    } else {};
    for offset in ends {
        let _ = patch_jump(compiler, offset, end);
    }
    AssignmentTarget {
        storage: AssignmentStorage::WithIdentifier { receiver, property, name, span },
        writable: true,
        throws_on_write: false,
        source_offset: span.start,
    }
}

fn prepare_assignment_target(compiler: Compiler, expression: ast::Expr, fallback_span: ast::Span) -> AssignmentTarget {
    match expression {
        ast::Expr::Identifier { name, span } => {
            validate_strict_identifier(compiler, name, span);
            if compiler.with_bindings.is_empty() {
                plain_identifier_assignment_target(compiler, name, span)
            } else {
                with_identifier_assignment_target(compiler, name, span)
            }
        },
        ast::Expr::Parenthesized { expression, .. } => {
            prepare_assignment_target(compiler, expression.get(), fallback_span)
        },
        ast::Expr::Member { object, property, computed, optional, span } => {
            if optional || has_optional_chain(object.get()) {
                compile_error(compiler, "optional chain is not an assignment target", span)
            } else {};
            let member_offset = first_source_byte_between(
                compiler,
                ast::expr_span(object.get()).end,
                ast::expr_span(property.get()).start,
            );
            if match object.get() {
                ast::Expr::Super { .. } => true,
                _ => false,
            } {
                if !compiler.super_property_allowed {
                    compile_error(compiler, "super property assignment is not valid here", span);
                    return AssignmentTarget {
                        storage: AssignmentStorage::Invalid,
                        writable: false,
                        throws_on_write: false,
                        source_offset: member_offset,
                    }
                } else if computed {
                    ensure_super_this_capture(compiler);
                    let property_local = new_local(compiler);
                    compile_expression(compiler, property.get());
                    let _ = emit(compiler, bytecode::Instruction::PutLoc(property_local));
                    return AssignmentTarget {
                        storage: AssignmentStorage::SuperElement(property_local),
                        writable: true,
                        throws_on_write: false,
                        source_offset: member_offset,
                    }
                } else {
                    match property.get() {
                        ast::Expr::Identifier { name, .. } => {
                            ensure_super_this_capture(compiler);
                            return AssignmentTarget {
                                storage: AssignmentStorage::SuperField(
                                    string_constant(compiler, name),
                                ),
                                writable: true,
                                throws_on_write: false,
                                source_offset: member_offset,
                            }
                        },
                        _ => {
                            compile_error(
                                compiler,
                                "named super member requires an identifier",
                                span,
                            );
                            return AssignmentTarget {
                                storage: AssignmentStorage::Invalid,
                                writable: false,
                                throws_on_write: false,
                                source_offset: member_offset,
                            }
                        },
                    }
                }
            } else {};
            let object_local = new_local(compiler);
            compile_expression(compiler, object.get());
            let _ = emit(compiler, bytecode::Instruction::PutLoc(object_local));
            if !computed
                && match property.get() {
                    ast::Expr::PrivateIdentifier { .. } => true,
                    _ => false,
                } {
                let name_local = new_local(compiler);
                match property.get() {
                    ast::Expr::PrivateIdentifier { name, span } => {
                        compile_private_name(compiler, name, span)
                    },
                    _ => (),
                };
                let _ = emit(compiler, bytecode::Instruction::PutLoc(name_local));
                AssignmentTarget {
                    storage: AssignmentStorage::Private { object: object_local, name: name_local },
                    writable: true,
                    throws_on_write: false,
                    source_offset: member_offset,
                }
            } else if computed {
                let property_local = new_local(compiler);
                compile_expression(compiler, property.get());
                let _ = emit(compiler, bytecode::Instruction::PutLoc(property_local));
                AssignmentTarget {
                    storage: AssignmentStorage::Element {
                        object: object_local,
                        property: property_local,
                    },
                    writable: true,
                    throws_on_write: false,
                    source_offset: member_offset,
                }
            } else {
                match property.get() {
                    ast::Expr::Identifier { name, .. } => AssignmentTarget {
                        storage: AssignmentStorage::Field {
                            object: object_local,
                            property: string_constant(compiler, name),
                        },
                        writable: true,
                        throws_on_write: false,
                        source_offset: member_offset,
                    },
                    _ => {
                        compile_error(compiler, "named member requires an identifier", span);
                        AssignmentTarget {
                            storage: AssignmentStorage::Invalid,
                            writable: false,
                            throws_on_write: false,
                            source_offset: member_offset,
                        }
                    },
                }
            }
        },
        _ => {
            compile_error(compiler, "invalid assignment target", fallback_span);
            AssignmentTarget {
                storage: AssignmentStorage::Invalid,
                writable: false,
                throws_on_write: false,
                source_offset: fallback_span.start,
            }
        },
    }
}

fn load_assignment_target(compiler: Compiler, target: AssignmentTarget) -> unit {
    set_source_offset(compiler, target.source_offset);
    match target.storage {
        AssignmentStorage::Local(index) => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(index));
        },
        AssignmentStorage::Upvalue(index) => {
            let _ = emit(compiler, bytecode::Instruction::GetUpvalue(index));
        },
        AssignmentStorage::Global(index) => {
            let _ = emit(compiler, bytecode::Instruction::GetGlobal(index));
        },
        AssignmentStorage::Eval(index) => {
            let _ = emit(compiler, bytecode::Instruction::GetEval(index));
        },
        AssignmentStorage::EvalOrUpvalue { name, upvalue, depth } => {
            let _ = emit(compiler, bytecode::Instruction::GetEvalOrUpvalue(name, upvalue, depth));
        },
        AssignmentStorage::Field { object, property } => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
            let _ = emit(compiler, bytecode::Instruction::GetField(property));
        },
        AssignmentStorage::Element { object, property } => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(property));
            let _ = emit(compiler, bytecode::Instruction::GetArrayEl);
        },
        AssignmentStorage::WithIdentifier { receiver, property, name, span } => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(receiver));
            let _ = emit(compiler, bytecode::Instruction::IsUndefinedOrNull);
            let fallback = emit(compiler, bytecode::Instruction::IfTrue(-1));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(receiver));
            let _ = emit(compiler, bytecode::Instruction::GetField(property));
            let end = emit(compiler, bytecode::Instruction::Goto(-1));
            let _ = patch_jump(compiler, fallback, current_offset(compiler));
            compile_plain_identifier(compiler, name, span);
            let _ = patch_jump(compiler, end, current_offset(compiler));
        },
        AssignmentStorage::Private { object, name } => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(name));
            let _ = emit(compiler, bytecode::Instruction::GetPrivate);
        },
        AssignmentStorage::SuperField(property) => {
            let _ = emit(compiler, bytecode::Instruction::GetSuperField(property));
        },
        AssignmentStorage::SuperElement(property) => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(property));
            let _ = emit(compiler, bytecode::Instruction::GetSuperEl);
        },
        AssignmentStorage::Invalid => {
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
    }
}

fn store_assignment_target(compiler: Compiler, target: AssignmentTarget) -> unit {
    let conditional = match target.storage {
        AssignmentStorage::EvalOrUpvalue { .. } => true,
        _ => false,
    };
    if target.throws_on_write && !conditional {
        set_source_offset(compiler, target.source_offset);
        let _ = emit(compiler, bytecode::Instruction::ThrowTypeError);
        return
    } else {};
    if !target.writable && !conditional {
        return
    } else {};
    set_source_offset(compiler, target.source_offset);
    match target.storage {
        AssignmentStorage::Local(index) => {
            let _ = emit(compiler, bytecode::Instruction::SetLoc(index));
        },
        AssignmentStorage::Upvalue(index) => {
            let _ = emit(compiler, bytecode::Instruction::SetUpvalue(index));
        },
        AssignmentStorage::Global(index) => {
            if compiler_is_strict(compiler) && compiler.allow_unknown_globals.get() {
                let _ = emit(compiler, bytecode::Instruction::GetGlobal(index));
                let _ = emit(compiler, bytecode::Instruction::Drop);
            } else {};
            let _ = emit(compiler, bytecode::Instruction::SetGlobal(index));
        },
        AssignmentStorage::Eval(index) => {
            if compiler_is_strict(compiler) {
                let _ = emit(compiler, bytecode::Instruction::GetEval(index));
                let _ = emit(compiler, bytecode::Instruction::Drop);
            } else {};
            let _ = emit(compiler, bytecode::Instruction::SetEval(index));
        },
        AssignmentStorage::EvalOrUpvalue { name, upvalue, depth } => {
            let _ = emit(
                compiler,
                bytecode::Instruction::SetEvalOrUpvalue(
                    name,
                    upvalue,
                    depth,
                    target.writable,
                    target.throws_on_write,
                ),
            );
        },
        AssignmentStorage::Field { object, property } => {
            let value = new_local(compiler);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let _ = emit(compiler, bytecode::Instruction::PutField(property));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
        },
        AssignmentStorage::Element { object, property } => {
            let value = new_local(compiler);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(property));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let _ = emit(compiler, bytecode::Instruction::PutArrayEl);
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
        },
        AssignmentStorage::WithIdentifier { receiver, property, name, span } => {
            let value = new_local(compiler);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(receiver));
            let _ = emit(compiler, bytecode::Instruction::IsUndefinedOrNull);
            let fallback = emit(compiler, bytecode::Instruction::IfTrue(-1));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(receiver));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let _ = emit(compiler, bytecode::Instruction::PutField(property));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let end = emit(compiler, bytecode::Instruction::Goto(-1));
            let _ = patch_jump(compiler, fallback, current_offset(compiler));
            let fallback_target = plain_identifier_assignment_target(compiler, name, span);
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            store_assignment_target(compiler, fallback_target);
            let _ = patch_jump(compiler, end, current_offset(compiler));
        },
        AssignmentStorage::Private { object, name } => {
            let value = new_local(compiler);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(name));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let _ = emit(compiler, bytecode::Instruction::PutPrivate);
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
        },
        AssignmentStorage::SuperField(property) => {
            let value = new_local(compiler);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let _ = emit(compiler, bytecode::Instruction::PutSuperField(property));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
        },
        AssignmentStorage::SuperElement(property) => {
            let value = new_local(compiler);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(property));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let _ = emit(compiler, bytecode::Instruction::PutSuperEl);
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
        },
        AssignmentStorage::Invalid => (),
    }
}

fn assignment_binary_operator(operator: ast::AssignmentOperator) -> Option[ast::BinaryOperator] {
    match operator {
        ast::AssignmentOperator::Add => Option::Some(ast::BinaryOperator::Add),
        ast::AssignmentOperator::Subtract => Option::Some(ast::BinaryOperator::Subtract),
        ast::AssignmentOperator::Multiply => Option::Some(ast::BinaryOperator::Multiply),
        ast::AssignmentOperator::Divide => Option::Some(ast::BinaryOperator::Divide),
        ast::AssignmentOperator::Remainder => Option::Some(ast::BinaryOperator::Remainder),
        ast::AssignmentOperator::Power => Option::Some(ast::BinaryOperator::Power),
        ast::AssignmentOperator::ShiftLeft => Option::Some(ast::BinaryOperator::ShiftLeft),
        ast::AssignmentOperator::ShiftRight => Option::Some(ast::BinaryOperator::ShiftRight),
        ast::AssignmentOperator::ShiftRightUnsigned => Option::Some(
            ast::BinaryOperator::ShiftRightUnsigned,
        ),
        ast::AssignmentOperator::BitwiseAnd => Option::Some(ast::BinaryOperator::BitwiseAnd),
        ast::AssignmentOperator::BitwiseOr => Option::Some(ast::BinaryOperator::BitwiseOr),
        ast::AssignmentOperator::BitwiseXor => Option::Some(ast::BinaryOperator::BitwiseXor),
        _ => Option::None,
    }
}

fn assignment_inferred_name(expression: ast::Expr) -> Option[string] {
    match expression {
        ast::Expr::Identifier { name, .. } => Option::Some(name),
        ast::Expr::Member { property, computed: false, .. } => match property.get() {
            ast::Expr::Identifier { name, .. } => Option::Some(name),
            ast::Expr::PrivateIdentifier { name, .. } => Option::Some("#" + name),
            _ => Option::None,
        },
        _ => Option::None,
    }
}

fn compile_logical_assignment(
    compiler: Compiler,
    operator: ast::AssignmentOperator,
    target: AssignmentTarget,
    right: ast::Expr,
) -> unit {
    load_assignment_target(compiler, target);
    let _ = emit(compiler, bytecode::Instruction::Dup);
    let branch = if operator == ast::AssignmentOperator::LogicalAnd {
        emit(compiler, bytecode::Instruction::IfFalse(-1))
    } else if operator == ast::AssignmentOperator::LogicalOr {
        emit(compiler, bytecode::Instruction::IfTrue(-1))
    } else {
        let _ = emit(compiler, bytecode::Instruction::IsUndefinedOrNull);
        emit(compiler, bytecode::Instruction::IfFalse(-1))
    };
    let _ = emit(compiler, bytecode::Instruction::Drop);
    compile_expression(compiler, right);
    store_assignment_target(compiler, target);
    let _ = patch_jump(compiler, branch, current_offset(compiler));
}

fn compile_assignment(
    compiler: Compiler,
    operator: ast::AssignmentOperator,
    left: ast::Expr,
    right: ast::Expr,
    span: ast::Span,
) -> unit {
    let inferred_name = assignment_inferred_name(left);
    let target = prepare_assignment_target(compiler, left, span);
    if operator == ast::AssignmentOperator::Assign {
        match inferred_name {
            Some(name) => compile_expression_with_inferred_name(compiler, right, name),
            None => compile_expression(compiler, right),
        };
        store_assignment_target(compiler, target)
    } else if operator == ast::AssignmentOperator::LogicalAnd
        || operator == ast::AssignmentOperator::LogicalOr
        || operator == ast::AssignmentOperator::NullishCoalescing {
        compile_logical_assignment(compiler, operator, target, right)
    } else {
        load_assignment_target(compiler, target);
        compile_expression(compiler, right);
        set_source_offset(
            compiler,
            first_source_byte_between(
                compiler,
                ast::expr_span(left).end,
                ast::expr_span(right).start,
            ),
        );
        match assignment_binary_operator(operator) {
            Some(binary) => match binary_instruction(binary) {
                Some(instruction) => {
                    let _ = emit(compiler, instruction);
                },
                None => compile_error(compiler, "compound assignment is not supported", span),
            },
            None => compile_error(compiler, "compound assignment is not supported", span),
        };
        store_assignment_target(compiler, target)
    }
}

fn compile_update(
    compiler: Compiler,
    operator: ast::UpdateOperator,
    argument: ast::Expr,
    prefix: bool,
    span: ast::Span,
) -> unit {
    let target = prepare_assignment_target(compiler, argument, span);
    let previous = new_local(compiler);
    load_assignment_target(compiler, target);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(previous));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(previous));
    let _ = emit(compiler, bytecode::Instruction::TypeOf);
    let bigint_name = string_constant(compiler, "bigint");
    let _ = emit(compiler, bytecode::Instruction::PushConst(bigint_name));
    let _ = emit(compiler, bytecode::Instruction::StrictEq);
    let bigint_branch = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(previous));
    set_source_offset(
        compiler,
        if prefix {
            span.start
        } else {
            first_source_byte_between(compiler, ast::expr_span(argument).end, span.end)
        },
    );
    let _ = emit(compiler, bytecode::Instruction::Plus);
    let _ = emit(compiler, bytecode::Instruction::SetLoc(previous));
    let _ = emit(compiler, bytecode::Instruction::PushI32(1));
    let _ = emit(
        compiler,
        if operator == ast::UpdateOperator::Increment {
            bytecode::Instruction::Add
        } else {
            bytecode::Instruction::Sub
        },
    );
    let end_number = emit(compiler, bytecode::Instruction::Goto(-1));
    let _ = patch_jump(compiler, bigint_branch, current_offset(compiler));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(previous));
    let one = add_constant(compiler, bytecode::Constant::BigInt(runtime::BigInt::from_int64(1)));
    let _ = emit(compiler, bytecode::Instruction::PushConst(one));
    let _ = emit(
        compiler,
        if operator == ast::UpdateOperator::Increment {
            bytecode::Instruction::Add
        } else {
            bytecode::Instruction::Sub
        },
    );
    let _ = patch_jump(compiler, end_number, current_offset(compiler));
    store_assignment_target(compiler, target);
    if prefix {} else {
        let _ = emit(compiler, bytecode::Instruction::Drop);
        let _ = emit(compiler, bytecode::Instruction::GetLoc(previous));
    }
}

fn compile_yield(
    compiler: Compiler,
    argument: Option[Ref[ast::Expr]],
    delegate: bool,
    span: ast::Span,
) -> unit {
    if !compiler.generator {
        compile_error(compiler, "yield is only valid in a generator function", span)
    } else {};
    if !delegate {
        match argument {
            Some(value) => compile_expression(compiler, value.get()),
            None => {
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            },
        };
        emit_suspension(compiler, false);
        return
    } else {};
    match argument {
        Some(value) => compile_expression(compiler, value.get()),
        None => {
            compile_error(compiler, "yield delegation requires an expression", span);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
    };
    let _ = emit(
        compiler,
        if compiler.asynchronous {
            bytecode::Instruction::AsyncIteratorStart
        } else {
            bytecode::Instruction::IteratorStart
        },
    );
    let next = new_local(compiler);
    let iterator = new_local(compiler);
    let received = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(next));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(next));
    if compiler.asynchronous {
        let _ = emit(compiler, bytecode::Instruction::IteratorCallNext);
        emit_suspension(compiler, true);
        let _ = emit(compiler, bytecode::Instruction::IteratorResult);
    } else {
        let _ = emit(compiler, bytecode::Instruction::IteratorNext);
    };
    let check_done = current_offset(compiler);
    let done = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let yield_value = current_offset(compiler);
    let value = string_constant(compiler, "value");
    let _ = emit(compiler, bytecode::Instruction::GetField(value));
    let yield_offset = emit(compiler, bytecode::Instruction::Yield);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(received));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(next));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(received));
    if compiler.asynchronous {
        let _ = emit(compiler, bytecode::Instruction::IteratorCallNextValue);
        emit_suspension(compiler, true);
        let _ = emit(compiler, bytecode::Instruction::IteratorResult);
    } else {
        let _ = emit(compiler, bytecode::Instruction::IteratorNextValue);
    };
    let _ = emit(compiler, bytecode::Instruction::Goto(check_done));
    let throw_target = current_offset(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(received));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(received));
    if compiler.asynchronous {
        let _ = emit(compiler, bytecode::Instruction::IteratorCallThrow);
        emit_suspension(compiler, true);
        let _ = emit(compiler, bytecode::Instruction::IteratorThrowResult);
    } else {
        let _ = emit(compiler, bytecode::Instruction::IteratorThrow);
    };
    let _ = emit(compiler, bytecode::Instruction::Goto(check_done));
    let return_target = current_offset(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(received));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(received));
    if compiler.asynchronous {
        let _ = emit(compiler, bytecode::Instruction::IteratorCallReturn);
        emit_suspension(compiler, true);
        let _ = emit(compiler, bytecode::Instruction::IteratorResult);
    } else {
        let _ = emit(compiler, bytecode::Instruction::IteratorReturn);
    };
    let return_done = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::Goto(yield_value));
    let _ = patch_jump(compiler, done, current_offset(compiler));
    let _ = emit(compiler, bytecode::Instruction::GetField(value));
    let end = emit(compiler, bytecode::Instruction::Goto(-1));
    let _ = patch_jump(compiler, return_done, current_offset(compiler));
    let _ = emit(compiler, bytecode::Instruction::GetField(value));
    let completion = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(completion));
    compile_return_finalizers(compiler);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(completion));
    let _ = emit(compiler, bytecode::Instruction::Return);
    let _ = patch_jump(compiler, end, current_offset(compiler));
    compiler.generator_return_handlers.push(
        bytecode::GeneratorReturnHandler { yield_offset, throw_target, target: return_target },
    )
}

fn compile_nested_function(
    parent: Compiler,
    name: Option[string],
    parameters: Vec[ast::FunctionParameter],
    body: Vec[ast::Stmt],
    span: ast::Span,
    arrow: bool,
    constructable: bool,
    class_constructor: bool,
    derived_constructor: bool,
    inherit_home_object: bool,
    force_strict: bool,
    generator: bool,
    asynchronous: bool,
) -> bytecode::Function {
    let function_inherit_home_object = inherit_home_object || arrow && parent.super_property_allowed;
    let strict_directive = function_body_is_strict(body);
    let strict = force_strict || strict_directive || compiler_is_strict(parent);
    let child = compiler_new(
        parameters,
        if arrow {
            arrow_outer_bindings(parent)
        } else {
            visible_bindings(parent)
        },
        name,
        !arrow,
        arrow,
        arrow,
        if arrow {
            parent.super_call_allowed
        } else {
            derived_constructor
        },
        if arrow {
            parent.super_property_allowed
        } else {
            inherit_home_object
        },
        strict,
        generator,
        asynchronous,
        true,
    );
    match name {
        Some(value) => validate_strict_identifier(child, value, span),
        None => (),
    };
    child.source.set(parent.source.get());
    child.source_name.set(parent.source_name.get());
    child.allow_unknown_globals.set(parent.allow_unknown_globals.get());
    set_source_offset(child, span.start);
    if strict_directive && !simple_parameter_list(parameters) {
        compile_error(
            child,
            "use strict directive is not allowed with a non-simple parameter list",
            span,
        )
    } else {};
    if (strict || arrow || !constructable) && simple_parameter_list(parameters) {
        validate_unique_parameter_names(child, parameters)
    } else {};
    if class_constructor && !derived_constructor {
        let _ = emit(child, bytecode::Instruction::InitializeInstanceFields);
    } else {};
    compile_parameter_initializers(child, parameters);
    let separate_body_environment = !simple_parameter_list(parameters);
    if separate_body_environment {
        push_scope(child);
        child.var_scope_index.set(child.scopes.len() - 1);
        let _ = emit(child, bytecode::Instruction::EnterEvalEnvironment);
    } else {};
    collect_var_body(child, body);
    declare_lexical_body(child, body);
    initialize_var_bindings(child);
    compile_body(child, body);
    let _ = emit(child, bytecode::Instruction::ReturnUndef);
    if separate_body_environment {
        pop_scope(child)
    } else {};
    let eval_bindings = current_eval_bindings(child);
    let sources: Vec[bytecode::UpvalueSource] = Vec::new();
    for upvalue in child.upvalues {
        sources.push(upvalue.source)
    }
    let mapped_arguments = mapped_argument_locals(child, parameters, strict, arrow);
    let function = bytecode::Function::new_with_parameters_upvalues_handlers_and_function_semantics(
        child.constants,
        child.code,
        child.parameter_count,
        child.function_length,
        child.next_local.get(),
        sources,
        child.exception_handlers,
        constructable,
        class_constructor,
        derived_constructor,
        function_inherit_home_object,
        arrow,
    );
    function.set_arguments_semantics(strict, mapped_arguments);
    function.set_generator(generator);
    function.set_asynchronous(asynchronous);
    function.set_generator_return_handlers(child.generator_return_handlers);
    function.set_eval_bindings(eval_bindings);
    function.set_eval_sites(child.eval_sites);
    function.set_source_locations(child.source_locations);
    function.set_definition_location(source_location(child.source.get(), span.start));
    function.set_source_name(js_string(child.source_name.get()));
    set_function_source(function, child.source.get(), span);
    match name {
        Some(value) => function.set_name(js_string(value)),
        None => (),
    };
    append_verifier_errors(child, function, span);
    for error in child.errors {
        parent.errors.push(error)
    }
    function
}

fn compile_function_expression(
    compiler: Compiler,
    name: Option[string],
    parameters: Vec[ast::FunctionParameter],
    body: Vec[ast::Stmt],
    generator: bool,
    asynchronous: bool,
    span: ast::Span,
) -> unit {
    let function = compile_nested_function(
        compiler,
        name,
        parameters,
        body,
        span,
        false,
        !generator && !asynchronous,
        false,
        false,
        false,
        false,
        generator,
        asynchronous,
    );
    let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(function)));
    let _ = emit(compiler, bytecode::Instruction::PushConst(index));
}

fn compile_expression_with_inferred_name(compiler: Compiler, expression: ast::Expr, name: string) -> unit {
    match expression {
        ast::Expr::Function { name: None, parameters, body, generator, asynchronous, span } => {
            let function = compile_nested_function(
                compiler,
                Option::None,
                parameters,
                body,
                span,
                false,
                !generator && !asynchronous,
                false,
                false,
                false,
                false,
                generator,
                asynchronous,
            );
            function.set_name(js_string(name));
            let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(function)));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
        },
        ast::Expr::Arrow { parameters, body, asynchronous, span, .. } => {
            let function = compile_nested_function(
                compiler,
                Option::None,
                parameters,
                body,
                span,
                true,
                false,
                false,
                false,
                false,
                false,
                false,
                asynchronous,
            );
            function.set_name(js_string(name));
            let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(function)));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
        },
        ast::Expr::Class { name: None, heritage, elements, span } => {
            compile_class_expression(compiler, Option::Some(name), heritage, elements, span)
        },
        value => compile_expression(compiler, value),
    }
}

fn object_property_name(compiler: Compiler, key: ast::ObjectPropertyKey, span: ast::Span) -> string {
    match key {
        ast::ObjectPropertyKey::Identifier(value) | ast::ObjectPropertyKey::String(value) => value,
        ast::ObjectPropertyKey::Number(raw) => match parse_number(raw) {
            Ok((integer, int_value, float_value)) => if integer {
                int_value.to_string()
            } else {
                dtoa::number_to_string(float_value)
            },
            Err(message) => {
                compile_error(compiler, "invalid numeric property name: " + message, span);
                raw
            },
        },
        ast::ObjectPropertyKey::Computed(_) => {
            compile_error(compiler, "computed property reached static property compiler", span);
            ""
        },
        ast::ObjectPropertyKey::Spread => {
            compile_error(compiler, "spread property reached static property compiler", span);
            ""
        },
    }
}

fn compile_object_property_value(
    compiler: Compiler,
    expression: ast::Expr,
    kind: ast::ObjectPropertyKind,
    name: Option[string],
) -> unit {
    if kind == ast::ObjectPropertyKind::Data {
        match name {
            Some(value) => compile_expression_with_inferred_name(compiler, expression, value),
            None => compile_expression(compiler, expression),
        };
        return
    } else {};
    match expression {
        ast::Expr::Function { parameters, body, generator, asynchronous, span, .. } => {
            let function = compile_nested_function(
                compiler,
                Option::None,
                parameters,
                body,
                span,
                false,
                false,
                false,
                false,
                true,
                false,
                generator,
                asynchronous,
            );
            match name {
                Some(value) => function.set_name(js_string(value)),
                None => (),
            };
            let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(function)));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
            let _ = emit(compiler, bytecode::Instruction::SetFunctionHomeObject);
        },
        value => compile_expression(compiler, value),
    }
}

fn compile_object_literal(compiler: Compiler, properties: Vec[ast::ObjectProperty]) -> unit {
    let _ = emit(compiler, bytecode::Instruction::NewObject);
    for property in properties {
        match property.key {
            ast::ObjectPropertyKey::Spread => {
                compile_expression(compiler, property.value.get());
                let _ = emit(compiler, bytecode::Instruction::CopyDataProperties);
            },
            ast::ObjectPropertyKey::Computed(key) => {
                if property.kind == ast::ObjectPropertyKind::Data {
                    let _ = emit(compiler, bytecode::Instruction::Dup);
                    compile_expression(compiler, key.get());
                    compile_object_property_value(
                        compiler,
                        property.value.get(),
                        property.kind,
                        Option::None,
                    )
                } else {
                    let object = new_local(compiler);
                    let property_key = new_local(compiler);
                    let _ = emit(compiler, bytecode::Instruction::Dup);
                    let _ = emit(compiler, bytecode::Instruction::PutLoc(object));
                    compile_expression(compiler, key.get());
                    let _ = emit(compiler, bytecode::Instruction::PutLoc(property_key));
                    let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
                    let _ = emit(compiler, bytecode::Instruction::GetLoc(property_key));
                    let _ = emit(compiler, bytecode::Instruction::GetLoc(object));
                    compile_object_property_value(
                        compiler,
                        property.value.get(),
                        property.kind,
                        Option::None,
                    )
                };
                let instruction = match property.kind {
                    ast::ObjectPropertyKind::Data | ast::ObjectPropertyKind::Method => {
                        bytecode::Instruction::PutArrayEl
                    },
                    ast::ObjectPropertyKind::Getter => bytecode::Instruction::DefineGetterComputed,
                    ast::ObjectPropertyKind::Setter => bytecode::Instruction::DefineSetterComputed,
                };
                let _ = emit(compiler, instruction);
            },
            key => {
                let name = object_property_name(compiler, key, property.span);
                let index = string_constant(compiler, name);
                let _ = emit(compiler, bytecode::Instruction::Dup);
                if property.kind != ast::ObjectPropertyKind::Data {
                    let _ = emit(compiler, bytecode::Instruction::Dup);
                } else {};
                compile_object_property_value(
                    compiler,
                    property.value.get(),
                    property.kind,
                    Option::Some(
                        match property.kind {
                            ast::ObjectPropertyKind::Getter => "get " + name,
                            ast::ObjectPropertyKind::Setter => "set " + name,
                            ast::ObjectPropertyKind::Data | ast::ObjectPropertyKind::Method => name,
                        },
                    ),
                );
                let instruction = match property.kind {
                    ast::ObjectPropertyKind::Data | ast::ObjectPropertyKind::Method => {
                        bytecode::Instruction::PutField(index)
                    },
                    ast::ObjectPropertyKind::Getter => bytecode::Instruction::DefineGetter(index),
                    ast::ObjectPropertyKind::Setter => bytecode::Instruction::DefineSetter(index),
                };
                let _ = emit(compiler, instruction);
            },
        }
    }
}

fn compile_array_literal(compiler: Compiler, elements: Vec[ast::ArrayElement]) -> unit {
    let _ = emit(compiler, bytecode::Instruction::NewArray(0));
    for element in elements {
        match element {
            ast::ArrayElement::Hole => {
                let _ = emit(compiler, bytecode::Instruction::ArrayAppendHole);
            },
            ast::ArrayElement::Value(value) => {
                compile_expression(compiler, value.get());
                let _ = emit(compiler, bytecode::Instruction::ArrayAppend);
            },
            ast::ArrayElement::Spread(value) => {
                compile_expression(compiler, value.get());
                let _ = emit(compiler, bytecode::Instruction::ArrayAppendSpread);
            },
        }
    }
}

fn compile_conditional(
    compiler: Compiler,
    test: ast::Expr,
    consequent: ast::Expr,
    alternate: ast::Expr,
) -> unit {
    compile_expression(compiler, test);
    let alternate_jump = emit(compiler, bytecode::Instruction::IfFalse(-1));
    compile_expression(compiler, consequent);
    let end_jump = emit(compiler, bytecode::Instruction::Goto(-1));
    let _ = patch_jump(compiler, alternate_jump, current_offset(compiler));
    compile_expression(compiler, alternate);
    let _ = patch_jump(compiler, end_jump, current_offset(compiler));
}

fn compile_sequence(compiler: Compiler, expressions: Vec[Ref[ast::Expr]]) -> unit {
    if expressions.is_empty() {
        let _ = emit(compiler, bytecode::Instruction::Undefined);
        return
    } else {};
    let mut index = 0;
    while index < expressions.len() {
        compile_expression(compiler, expressions[index].get());
        if index + 1 < expressions.len() {
            let _ = emit(compiler, bytecode::Instruction::Drop);
        } else {};
        index += 1;
    }
}

fn compile_expression(compiler: Compiler, expression: ast::Expr) -> unit {
    set_source_offset(compiler, ast::expr_span(expression).start);
    match expression {
        ast::Expr::This { .. } => {
            compile_this_value(compiler)
        },
        ast::Expr::Super { span } => {
            compile_error(compiler, "super is only valid in calls and property access", span);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
        ast::Expr::NewTarget { .. } => {
            let _ = emit(compiler, bytecode::Instruction::PushNewTarget);
        },
        ast::Expr::ImportMeta { span } => if lookup_binding(compiler, IMPORT_META_BINDING).is_some()
            || lookup_outer_binding(compiler, IMPORT_META_BINDING).is_some() {
            compile_plain_identifier(compiler, IMPORT_META_BINDING, span)
        } else {
            compile_error(compiler, "import.meta is only valid in module code", span);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
        ast::Expr::Identifier { name, span } => compile_identifier(compiler, name, span),
        ast::Expr::PrivateIdentifier { name, span } => {
            compile_error(
                compiler,
                "private name `#" + name + "` is only valid in member access or `in`",
                span,
            );
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
        ast::Expr::Number { raw, span } => compile_number(compiler, raw, span),
        ast::Expr::BigInt { raw, span } => compile_bigint(compiler, raw, span),
        ast::Expr::String { raw, .. } => {
            let index = add_constant(compiler, bytecode::Constant::String(string_literal(raw)));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
        },
        ast::Expr::RegExp { pattern, flags, span } => {
            compile_regexp_literal(compiler, pattern, flags, span)
        },
        ast::Expr::TaggedTemplate { tag, cooked, raw, substitutions, .. } => {
            compile_tagged_template(compiler, tag.get(), cooked, raw, substitutions)
        },
        ast::Expr::Bool { value, .. } => if value {
            let _ = emit(compiler, bytecode::Instruction::PushTrue);
        } else {
            let _ = emit(compiler, bytecode::Instruction::PushFalse);
        },
        ast::Expr::Null { .. } => {
            let _ = emit(compiler, bytecode::Instruction::Null);
        },
        ast::Expr::Parenthesized { expression, .. } => {
            compile_expression(compiler, expression.get())
        },
        ast::Expr::Unary { operator, argument, span } => {
            compile_unary(compiler, operator, argument.get(), span)
        },
        ast::Expr::Binary { operator, left, right, span } => {
            compile_binary(compiler, operator, left.get(), right.get(), span)
        },
        ast::Expr::Conditional { test, consequent, alternate, .. } => {
            compile_conditional(compiler, test.get(), consequent.get(), alternate.get())
        },
        ast::Expr::Assignment { operator, left, right, span } => {
            compile_assignment(compiler, operator, left.get(), right.get(), span)
        },
        ast::Expr::DestructuringAssignment { pattern, right, .. } => {
            compile_destructuring_assignment(compiler, pattern.get(), right.get())
        },
        ast::Expr::Update { operator, argument, prefix, span } => {
            compile_update(compiler, operator, argument.get(), prefix, span)
        },
        ast::Expr::Sequence { expressions, .. } => compile_sequence(compiler, expressions),
        ast::Expr::Spread { argument, span } => {
            compile_error(compiler, "spread expression is only valid in calls", span);
            compile_expression(compiler, argument.get());
        },
        ast::Expr::Member { object, property, computed, optional, span } => {
            if optional || has_optional_chain(object.get()) {
                compile_optional_chain_expression(
                    compiler,
                    ast::Expr::Member { object, property, computed, optional, span },
                )
            } else {
                compile_member(
                    compiler,
                    ast::Expr::Member { object, property, computed, optional, span },
                )
            }
        },
        ast::Expr::Call { callee, arguments, optional, span } => {
            if optional || has_optional_chain(callee.get()) {
                compile_optional_chain_expression(
                    compiler,
                    ast::Expr::Call { callee, arguments, optional, span },
                )
            } else {
                compile_call(compiler, callee.get(), arguments, span)
            }
        },
        ast::Expr::DynamicImport { specifier, options, .. } => {
            compile_expression(compiler, specifier.get());
            match options {
                Some(value) => compile_expression(compiler, value.get()),
                None => {
                    let _ = emit(compiler, bytecode::Instruction::Undefined);
                },
            };
            if lookup_binding(compiler, IMPORT_REFERRER_BINDING).is_some()
                || lookup_outer_binding(compiler, IMPORT_REFERRER_BINDING).is_some() {
                compile_plain_identifier(
                    compiler,
                    IMPORT_REFERRER_BINDING,
                    ast::expr_span(specifier.get()),
                )
            } else {
                let _ = emit(compiler, bytecode::Instruction::Undefined);
            };
            let _ = emit(compiler, bytecode::Instruction::DynamicImport);
        },
        ast::Expr::New { callee, arguments, .. } => {
            compile_construct(compiler, callee.get(), arguments)
        },
        ast::Expr::Function { name, parameters, body, generator, asynchronous, span } => {
            compile_function_expression(
                compiler,
                name,
                parameters,
                body,
                generator,
                asynchronous,
                span,
            )
        },
        ast::Expr::Await { argument, span } => {
            compile_expression(compiler, argument.get());
            if compiler.asynchronous {
                compiler.used_await.set(true);
                emit_suspension(compiler, true);
            } else {
                compile_error(compiler, "await is only valid in async functions", span)
            }
        },
        ast::Expr::Yield { argument, delegate, span } => {
            compile_yield(compiler, argument, delegate, span)
        },
        ast::Expr::Class { name, heritage, elements, span } => {
            compile_class_expression(compiler, name, heritage, elements, span)
        },
        ast::Expr::Arrow { parameters, body, asynchronous, span, .. } => {
            let function = compile_nested_function(
                compiler,
                Option::None,
                parameters,
                body,
                span,
                true,
                false,
                false,
                false,
                false,
                false,
                false,
                asynchronous,
            );
            let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(function)));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
        },
        ast::Expr::Object { properties, .. } => compile_object_literal(compiler, properties),
        ast::Expr::Array { elements, .. } => compile_array_literal(compiler, elements),
        ast::Expr::Error { span } => {
            compile_error(compiler, "cannot compile erroneous expression", span);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
    }
}

fn compile_function_declaration(
    compiler: Compiler,
    name: string,
    parameters: Vec[ast::FunctionParameter],
    body: Vec[ast::Stmt],
    generator: bool,
    asynchronous: bool,
    span: ast::Span,
) -> unit {
    if name == "" {
        return
    } else {};
    let scope = compiler.scopes[compiler.scopes.len() - 1];
    let binding = match scope.bindings.get(name) {
        Some(value) => Option::Some(value),
        None => if is_script_global_var(compiler, name) || has_dynamic_eval_var(compiler, name)
            || compiler.direct_eval.get() && !compiler_is_strict(compiler)
                && match lookup_outer_binding(compiler, name) {
                    Some(value) => value.declaration_target && value.kind == BindingKind::Var,
                    None => false,
                } {
            Option::None
        } else {
            declare_current(compiler, name, BindingKind::Var, span)
        },
    };
    let function = compile_nested_function(
        compiler,
        Option::None,
        parameters,
        body,
        span,
        false,
        !generator && !asynchronous,
        false,
        false,
        false,
        false,
        generator,
        asynchronous,
    );
    function.set_name(js_string(name));
    let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(function)));
    let _ = emit(compiler, bytecode::Instruction::PushConst(index));
    match binding {
        Some(value) => {
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value.index));
        },
        None => if is_script_global_var(compiler, name) || has_dynamic_eval_var(compiler, name) {
            let name_index = string_constant(compiler, name);
            let _ = emit(compiler, bytecode::Instruction::SetEval(name_index));
            let _ = emit(compiler, bytecode::Instruction::Drop);
        } else {
            match resolve_upvalue(compiler, name) {
                Some((index, BindingKind::Var)) => {
                    let _ = emit(compiler, bytecode::Instruction::PutUpvalue(index));
                },
                _ => {
                    let _ = emit(compiler, bytecode::Instruction::Drop);
                },
            }
        },
    }
}

fn class_constructor_element(elements: Vec[ast::ClassElement]) -> Option[ast::ClassElement] {
    for element in elements {
        if !element.static_member && element.kind == ast::ClassElementKind::Method
            && !element.private_member
            && element.name == "constructor" {
            return Option::Some(element)
        } else {}
    }
    Option::None
}

fn compile_default_derived_constructor(parent: Compiler, name: Option[string], span: ast::Span) -> bytecode::Function {
    let child = compiler_new(
        Vec::new(),
        visible_bindings(parent),
        name,
        true,
        false,
        false,
        true,
        true,
        true,
        false,
        false,
        true,
    );
    child.source.set(parent.source.get());
    child.source_name.set(parent.source_name.get());
    let _ = emit(child, bytecode::Instruction::PushRest(0));
    let _ = emit(child, bytecode::Instruction::CallSuperArray);
    let _ = emit(child, bytecode::Instruction::Return);
    let sources: Vec[bytecode::UpvalueSource] = Vec::new();
    for upvalue in child.upvalues {
        sources.push(upvalue.source)
    }
    let function = bytecode::Function::new_with_parameters_upvalues_handlers_and_function_semantics(
        child.constants,
        child.code,
        0,
        0,
        child.next_local.get(),
        sources,
        child.exception_handlers,
        true,
        true,
        true,
        true,
        false,
    );
    function.set_eval_sites(child.eval_sites);
    append_verifier_errors(child, function, span);
    for error in child.errors {
        parent.errors.push(error)
    }
    function
}

fn compile_class_field_initializer(
    parent: Compiler,
    elements: Vec[ast::ClassElement],
    computed_key_locals: Vec[isize],
    private_key_locals: Vec[isize],
    private_method_locals: Vec[isize],
    static_member: bool,
    span: ast::Span,
) -> Option[bytecode::Function] {
    let child = compiler_new(
        Vec::new(),
        visible_bindings(parent),
        Option::None,
        false,
        false,
        false,
        false,
        true,
        true,
        false,
        false,
        true,
    );
    child.source.set(parent.source.get());
    child.source_name.set(parent.source_name.get());
    let mut count = 0;
    let mut element_index = 0;
    for element in elements {
        if element.private_member && element.static_member == static_member
            && (element.kind == ast::ClassElementKind::Method
                || element.kind == ast::ClassElementKind::Getter
                || element.kind == ast::ClassElementKind::Setter) {
            let name = upvalue_index(
                child,
                "$class_private_name_" + element_index.to_string(),
                bytecode::UpvalueSource::Local(private_key_locals[element_index]),
                BindingKind::Const,
            );
            let method = upvalue_index(
                child,
                "$class_private_method_" + element_index.to_string(),
                bytecode::UpvalueSource::Local(private_method_locals[element_index]),
                BindingKind::Const,
            );
            let _ = emit(child, bytecode::Instruction::GetUpvalue(name));
            let _ = emit(child, bytecode::Instruction::GetUpvalue(method));
            let instruction = match element.kind {
                ast::ClassElementKind::Method => {
                    bytecode::Instruction::DefineThisPrivateMethod
                },
                ast::ClassElementKind::Getter => {
                    bytecode::Instruction::DefineThisPrivateGetter
                },
                ast::ClassElementKind::Setter => {
                    bytecode::Instruction::DefineThisPrivateSetter
                },
                _ => bytecode::Instruction::DefineThisPrivateMethod,
            };
            let _ = emit(child, instruction);
            count += 1;
        } else {};
        element_index += 1;
    }
    element_index = 0;
    for element in elements {
        if element.kind == ast::ClassElementKind::Field && element.static_member == static_member {
            if element.private_member {
                let upvalue = upvalue_index(
                    child,
                    "$class_private_field_" + element_index.to_string(),
                    bytecode::UpvalueSource::Local(private_key_locals[element_index]),
                    BindingKind::Const,
                );
                let _ = emit(child, bytecode::Instruction::GetUpvalue(upvalue));
            } else if element.computed_name.is_some() {
                let upvalue = upvalue_index(
                    child,
                    "$class_key_" + element_index.to_string(),
                    bytecode::UpvalueSource::Local(computed_key_locals[element_index]),
                    BindingKind::Const,
                );
                let _ = emit(child, bytecode::Instruction::GetUpvalue(upvalue));
            } else {};
            match element.initializer {
                Some(value) => compile_expression(child, value.get()),
                None => {
                    let _ = emit(child, bytecode::Instruction::Undefined);
                },
            };
            if element.private_member {
                let _ = emit(child, bytecode::Instruction::DefineThisPrivateField);
            } else if element.computed_name.is_some() {
                let _ = emit(child, bytecode::Instruction::DefineThisFieldComputed);
            } else {
                let name = string_constant(child, element.name);
                let _ = emit(child, bytecode::Instruction::DefineThisField(name));
            };
            count += 1;
        } else {}
        element_index += 1;
    }
    if count == 0 {
        Option::None
    } else {
        let _ = emit(child, bytecode::Instruction::ReturnUndef);
        let sources: Vec[bytecode::UpvalueSource] = Vec::new();
        for upvalue in child.upvalues {
            sources.push(upvalue.source)
        }
        let function = bytecode::Function::new_with_parameters_upvalues_handlers_and_function_semantics(
            child.constants,
            child.code,
            0,
            0,
            child.next_local.get(),
            sources,
            child.exception_handlers,
            false,
            false,
            false,
            true,
            false,
        );
        function.set_eval_sites(child.eval_sites);
        append_verifier_errors(child, function, span);
        for error in child.errors {
            parent.errors.push(error)
        }
        Option::Some(function)
    }
}

fn compile_class_static_initializer(
    parent: Compiler,
    element: ast::ClassElement,
    computed_key_local: isize,
    private_key_local: isize,
) -> bytecode::Function {
    let child = compiler_new(
        Vec::new(),
        visible_bindings(parent),
        Option::None,
        false,
        false,
        false,
        false,
        true,
        true,
        false,
        false,
        true,
    );
    child.source.set(parent.source.get());
    child.source_name.set(parent.source_name.get());
    if element.kind == ast::ClassElementKind::Field {
        if element.private_member {
            let upvalue = upvalue_index(
                child,
                "$class_static_private_name",
                bytecode::UpvalueSource::Local(private_key_local),
                BindingKind::Const,
            );
            let _ = emit(child, bytecode::Instruction::GetUpvalue(upvalue));
        } else if element.computed_name.is_some() {
            let upvalue = upvalue_index(
                child,
                "$class_static_key",
                bytecode::UpvalueSource::Local(computed_key_local),
                BindingKind::Const,
            );
            let _ = emit(child, bytecode::Instruction::GetUpvalue(upvalue));
        } else {};
        match element.initializer {
            Some(value) => compile_expression(child, value.get()),
            None => {
                let _ = emit(child, bytecode::Instruction::Undefined);
            },
        };
        if element.private_member {
            let _ = emit(child, bytecode::Instruction::DefineThisPrivateField);
        } else if element.computed_name.is_some() {
            let _ = emit(child, bytecode::Instruction::DefineThisFieldComputed);
        } else {
            let name = string_constant(child, element.name);
            let _ = emit(child, bytecode::Instruction::DefineThisField(name));
        }
    } else {
        collect_var_body(child, element.body);
        declare_lexical_body(child, element.body);
        initialize_var_bindings(child);
        compile_body(child, element.body)
    };
    let _ = emit(child, bytecode::Instruction::ReturnUndef);
    let sources: Vec[bytecode::UpvalueSource] = Vec::new();
    for upvalue in child.upvalues {
        sources.push(upvalue.source)
    }
    let function = bytecode::Function::new_with_parameters_upvalues_handlers_and_function_semantics(
        child.constants,
        child.code,
        0,
        0,
        child.next_local.get(),
        sources,
        child.exception_handlers,
        false,
        false,
        false,
        true,
        false,
    );
    function.set_eval_sites(child.eval_sites);
    append_verifier_errors(child, function, element.span);
    for error in child.errors {
        parent.errors.push(error)
    }
    function
}

fn compile_class_private_method_initializer(
    parent: Compiler,
    elements: Vec[ast::ClassElement],
    private_key_locals: Vec[isize],
    private_method_locals: Vec[isize],
    static_member: bool,
    span: ast::Span,
) -> Option[bytecode::Function] {
    let child = compiler_new(
        Vec::new(),
        visible_bindings(parent),
        Option::None,
        false,
        false,
        false,
        false,
        true,
        true,
        false,
        false,
        true,
    );
    child.source.set(parent.source.get());
    child.source_name.set(parent.source_name.get());
    let mut count = 0;
    let mut element_index = 0;
    for element in elements {
        if element.private_member && element.static_member == static_member
            && (element.kind == ast::ClassElementKind::Method
                || element.kind == ast::ClassElementKind::Getter
                || element.kind == ast::ClassElementKind::Setter) {
            let name = upvalue_index(
                child,
                "$class_private_static_name_" + element_index.to_string(),
                bytecode::UpvalueSource::Local(private_key_locals[element_index]),
                BindingKind::Const,
            );
            let method = upvalue_index(
                child,
                "$class_private_static_method_" + element_index.to_string(),
                bytecode::UpvalueSource::Local(private_method_locals[element_index]),
                BindingKind::Const,
            );
            let _ = emit(child, bytecode::Instruction::GetUpvalue(name));
            let _ = emit(child, bytecode::Instruction::GetUpvalue(method));
            let instruction = match element.kind {
                ast::ClassElementKind::Method => {
                    bytecode::Instruction::DefineThisPrivateMethod
                },
                ast::ClassElementKind::Getter => {
                    bytecode::Instruction::DefineThisPrivateGetter
                },
                ast::ClassElementKind::Setter => {
                    bytecode::Instruction::DefineThisPrivateSetter
                },
                _ => bytecode::Instruction::DefineThisPrivateMethod,
            };
            let _ = emit(child, instruction);
            count += 1;
        } else {};
        element_index += 1;
    }
    if count == 0 {
        Option::None
    } else {
        let _ = emit(child, bytecode::Instruction::ReturnUndef);
        let sources: Vec[bytecode::UpvalueSource] = Vec::new();
        for upvalue in child.upvalues {
            sources.push(upvalue.source)
        }
        let function = bytecode::Function::new_with_parameters_upvalues_handlers_and_function_semantics(
            child.constants,
            child.code,
            0,
            0,
            child.next_local.get(),
            sources,
            child.exception_handlers,
            false,
            false,
            false,
            true,
            false,
        );
        function.set_eval_sites(child.eval_sites);
        append_verifier_errors(child, function, span);
        for error in child.errors {
            parent.errors.push(error)
        }
        Option::Some(function)
    }
}

fn compile_class_strict_expression(compiler: Compiler, expression: ast::Expr) -> unit {
    let previous = compiler.strict_context.get();
    compiler.strict_context.set(true);
    compile_expression(compiler, expression);
    compiler.strict_context.set(previous)
}

fn compile_class_value(
    compiler: Compiler,
    name: Option[string],
    heritage: Option[Ref[ast::Expr]],
    elements: Vec[ast::ClassElement],
    span: ast::Span,
    binding_index: Option[isize],
) -> unit {
    push_scope(compiler);
    for element in elements {
        if element.private_member {
            let binding_name = private_binding_name(element.name);
            if compiler.scopes[compiler.scopes.len() - 1].bindings.get(binding_name).is_none() {
                match declare_current(compiler, binding_name, BindingKind::Const, element.span) {
                    Some(binding) => {
                        let _ = emit(compiler, bytecode::Instruction::NewPrivateName);
                        let _ = emit(compiler, bytecode::Instruction::PutLoc(binding.index));
                    },
                    None => (),
                }
            } else {}
        } else {}
    }
    let class_index = match binding_index {
        Some(value) => value,
        None => new_local(compiler),
    };
    let derived = heritage.is_some();
    let constructor = class_constructor_element(elements);
    let (parameters, body, constructor_span) = match constructor {
        Some(element) => (element.parameters, element.body, element.span),
        None => (Vec::new(), Vec::new(), span),
    };
    let function = if derived && constructor.is_none() {
        compile_default_derived_constructor(compiler, name, constructor_span)
    } else {
        compile_nested_function(
            compiler,
            name,
            parameters,
            body,
            constructor_span,
            false,
            true,
            true,
            derived,
            true,
            true,
            false,
            false,
        )
    };
    function.set_definition_location(source_location(compiler.source.get(), constructor_span.start));
    function.set_source_name(js_string(compiler.source_name.get()));
    set_function_source(function, compiler.source.get(), span);
    let function_index = add_constant(compiler, bytecode::Constant::Function(Ref::new(function)));
    let _ = emit(compiler, bytecode::Instruction::PushConst(function_index));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(class_index));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
    match heritage {
        Some(value) => compile_class_strict_expression(compiler, value.get()),
        None => {
            let _ = emit(compiler, bytecode::Instruction::Undefined);
        },
    };
    let _ = emit(compiler, bytecode::Instruction::SetClassHeritage(derived));
    let prototype = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
    let prototype_name = string_constant(compiler, "prototype");
    let _ = emit(compiler, bytecode::Instruction::GetField(prototype_name));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(prototype));
    let computed_key_locals: Vec[isize] = Vec::new();
    for element in elements {
        match element.computed_name {
            Some(value) => {
                compile_class_strict_expression(compiler, value.get());
                let local = new_local(compiler);
                let _ = emit(compiler, bytecode::Instruction::PutLoc(local));
                computed_key_locals.push(local);
            },
            None => computed_key_locals.push(-1),
        }
    }
    let private_key_locals: Vec[isize] = Vec::new();
    let private_method_locals: Vec[isize] = Vec::new();
    for element in elements {
        if element.private_member {
            match lookup_binding(compiler, private_binding_name(element.name)) {
                Some(binding) => private_key_locals.push(binding.index),
                None => private_key_locals.push(-1),
            }
        } else {
            private_key_locals.push(-1)
        };
        private_method_locals.push(-1)
    }
    let mut element_index = 0;
    for element in elements {
        if element.kind == ast::ClassElementKind::Field
            || element.kind == ast::ClassElementKind::StaticBlock {
            element_index += 1;
            continue
        } else if !element.static_member && element.kind == ast::ClassElementKind::Method
            && !element.private_member
            && element.name == "constructor" {
            element_index += 1;
            continue
        } else {};
        if element.static_member {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
        } else {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(prototype));
        };
        if element.computed_name.is_some() {
            let _ = emit(
                compiler,
                bytecode::Instruction::GetLoc(computed_key_locals[element_index]),
            );
        } else {};
        let method = compile_nested_function(
            compiler,
            Option::None,
            element.parameters,
            element.body,
            element.span,
            false,
            false,
            false,
            false,
            true,
            true,
            element.generator,
            element.asynchronous,
        );
        method.set_definition_location(
            source_location(compiler.source.get(), element.function_start),
        );
        set_function_source(
            method,
            compiler.source.get(),
            ast::span(element.function_start, element.span.end),
        );
        if element.computed_name.is_none() {
            let element_name = if element.private_member {
                "#" + element.name
            } else {
                element.name
            };
            method.set_name(
                js_string(
                    match element.kind {
                        ast::ClassElementKind::Getter => "get " + element_name,
                        ast::ClassElementKind::Setter => "set " + element_name,
                        _ => element_name,
                    },
                ),
            )
        } else {};
        let method_index = add_constant(compiler, bytecode::Constant::Function(Ref::new(method)));
        let _ = emit(compiler, bytecode::Instruction::PushConst(method_index));
        if element.private_member {
            let _ = emit(compiler, bytecode::Instruction::SetFunctionHomeObject);
            let method_local = new_local(compiler);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(method_local));
            private_method_locals.set(element_index, method_local);
            element_index += 1;
            continue
        } else {};
        let instruction = if element.computed_name.is_some() {
            match element.kind {
                ast::ClassElementKind::Method => bytecode::Instruction::DefineClassMethodComputed,
                ast::ClassElementKind::Getter => bytecode::Instruction::DefineClassGetterComputed,
                ast::ClassElementKind::Setter => bytecode::Instruction::DefineClassSetterComputed,
                ast::ClassElementKind::Field => bytecode::Instruction::DefineClassMethodComputed,
                ast::ClassElementKind::StaticBlock => {
                    bytecode::Instruction::DefineClassMethodComputed
                },
            }
        } else {
            let name_index = string_constant(compiler, element.name);
            match element.kind {
                ast::ClassElementKind::Method => bytecode::Instruction::DefineClassMethod(
                    name_index,
                ),
                ast::ClassElementKind::Getter => bytecode::Instruction::DefineClassGetter(
                    name_index,
                ),
                ast::ClassElementKind::Setter => bytecode::Instruction::DefineClassSetter(
                    name_index,
                ),
                ast::ClassElementKind::Field => {
                    bytecode::Instruction::DefineClassMethod(name_index)
                },
                ast::ClassElementKind::StaticBlock => {
                    bytecode::Instruction::DefineClassMethod(name_index)
                },
            }
        };
        let _ = emit(compiler, instruction);
        element_index += 1;
    }
    match compile_class_field_initializer(
        compiler,
        elements,
        computed_key_locals,
        private_key_locals,
        private_method_locals,
        false,
        span,
    ) {
        Some(initializer) => {
            let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(initializer)));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(prototype));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
            let _ = emit(compiler, bytecode::Instruction::SetClassInstanceInitializer);
        },
        None => (),
    };
    match compile_class_private_method_initializer(
        compiler,
        elements,
        private_key_locals,
        private_method_locals,
        true,
        span,
    ) {
        Some(initializer) => {
            let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(initializer)));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
            let _ = emit(compiler, bytecode::Instruction::SetFunctionHomeObject);
            let _ = emit(compiler, bytecode::Instruction::CallMethod(0));
            let _ = emit(compiler, bytecode::Instruction::Drop);
        },
        None => (),
    };
    let mut static_index = 0;
    for element in elements {
        if element.static_member
            && (element.kind == ast::ClassElementKind::Field
                || element.kind == ast::ClassElementKind::StaticBlock) {
            let initializer = compile_class_static_initializer(
                compiler,
                element,
                computed_key_locals[static_index],
                private_key_locals[static_index],
            );
            let index = add_constant(compiler, bytecode::Constant::Function(Ref::new(initializer)));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
            let _ = emit(compiler, bytecode::Instruction::SetFunctionHomeObject);
            let _ = emit(compiler, bytecode::Instruction::CallMethod(0));
            let _ = emit(compiler, bytecode::Instruction::Drop);
        } else {};
        static_index += 1;
    }
    let _ = emit(compiler, bytecode::Instruction::GetLoc(class_index));
    pop_scope(compiler)
}

fn compile_class_declaration(
    compiler: Compiler,
    name: string,
    heritage: Option[Ref[ast::Expr]],
    elements: Vec[ast::ClassElement],
    span: ast::Span,
) -> unit {
    let binding = match compiler.scopes[compiler.scopes.len() - 1].bindings.get(name) {
        Some(value) => value,
        None => {
            compile_error(compiler, "class declaration requires a binding", span);
            return
        },
    };
    if is_global_lexical_binding(compiler, binding) {
        push_scope(compiler);
        let class_binding = declare_current(compiler, name, BindingKind::Const, span);
        compile_class_value(
            compiler,
            Option::Some(name),
            heritage,
            elements,
            span,
            match class_binding {
                Some(value) => Option::Some(value.index),
                None => Option::None,
            },
        );
        pop_scope(compiler);
        let name_index = string_constant(compiler, name);
        let _ = emit(compiler, bytecode::Instruction::InitGlobalLexical(name_index));
        return
    } else {};
    compile_class_value(
        compiler,
        Option::Some(name),
        heritage,
        elements,
        span,
        Option::Some(binding.index),
    );
    let _ = emit(compiler, bytecode::Instruction::Drop);
}

fn compile_class_expression(
    compiler: Compiler,
    name: Option[string],
    heritage: Option[Ref[ast::Expr]],
    elements: Vec[ast::ClassElement],
    span: ast::Span,
) -> unit {
    match name {
        Some(value) => {
            push_scope(compiler);
            let binding = declare_current(compiler, value, BindingKind::Const, span);
            let binding_index = match binding {
                Some(current) => Option::Some(current.index),
                None => Option::None,
            };
            compile_class_value(
                compiler,
                Option::Some(value),
                heritage,
                elements,
                span,
                binding_index,
            );
            pop_scope(compiler)
        },
        None => compile_class_value(compiler, Option::None, heritage, elements, span, Option::None),
    }
}

fn compile_export_default(compiler: Compiler, expression: ast::Expr, local: string, span: ast::Span) -> unit {
    match expression {
        ast::Expr::Function { name: Some(_), parameters, body, generator, asynchronous, span } => if !local.starts_with(
            "$module_default@",
        ) {
            compile_function_declaration(
                compiler,
                local,
                parameters,
                body,
                generator,
                asynchronous,
                span,
            );
            return
        } else {},
        _ => (),
    };
    compile_expression_with_inferred_name(
        compiler,
        expression,
        if local.starts_with("$module_default@") {
            "default"
        } else {
            local
        },
    );
    match lookup_binding(compiler, local) {
        Some(binding) => {
            let _ = emit(compiler, bytecode::Instruction::PutLoc(binding.index));
        },
        None => {
            compile_error(compiler, "missing default export binding", span);
            let _ = emit(compiler, bytecode::Instruction::Drop);
        },
    }
}

fn initialize_function_declarations(compiler: Compiler, body: Vec[ast::Stmt]) -> unit {
    for statement in body {
        match statement {
            ast::Stmt::FunctionDeclaration { name, parameters, body, generator, asynchronous, span } => {
                compile_function_declaration(
                    compiler,
                    name,
                    parameters,
                    body,
                    generator,
                    asynchronous,
                    span,
                )
            },
            ast::Stmt::ExportDeclaration { declaration, .. } => match declaration.get() {
                ast::Stmt::FunctionDeclaration {
                    name,
                    parameters,
                    body,
                    generator,
                    asynchronous,
                    span,
                } => compile_function_declaration(
                    compiler,
                    name,
                    parameters,
                    body,
                    generator,
                    asynchronous,
                    span,
                ),
                _ => (),
            },
            ast::Stmt::ExportDefault { expression, local, hoisted: true, span, .. } => {
                compile_export_default(compiler, expression.get(), local, span)
            },
            _ => (),
        }
    }
}

fn compile_variable_declaration(
    compiler: Compiler,
    kind: ast::VariableKind,
    declarations: Vec[ast::VariableDeclarator],
) -> unit {
    for declaration in declarations {
        match declaration.initializer {
            Some(value) => {
                match declaration.pattern.get() {
                    ast::BindingPattern::Identifier { name, .. } => {
                        compile_expression_with_inferred_name(compiler, value.get(), name)
                    },
                    _ => compile_expression(compiler, value.get()),
                };
                compile_binding_pattern(compiler, declaration.pattern.get())
            },
            None => if kind != ast::VariableKind::Var {
                if kind == ast::VariableKind::Const {
                    compile_error(
                        compiler,
                        "const declaration requires an initializer",
                        declaration.span,
                    )
                } else {};
                let _ = emit(compiler, bytecode::Instruction::Undefined);
                compile_binding_pattern(compiler, declaration.pattern.get())
            } else {},
        }
    }
}

fn compile_block(compiler: Compiler, body: Vec[ast::Stmt]) -> unit {
    push_scope(compiler);
    declare_lexical_body(compiler, body);
    compile_body(compiler, body);
    pop_scope(compiler)
}

fn compile_if(
    compiler: Compiler,
    test: ast::Expr,
    consequent: ast::Stmt,
    alternate: Option[Ref[ast::Stmt]],
) -> unit {
    compile_expression(compiler, test);
    let false_branch = emit(compiler, bytecode::Instruction::IfFalse(-1));
    compile_statement(compiler, consequent);
    match alternate {
        Some(value) => {
            let end_branch = emit(compiler, bytecode::Instruction::Goto(-1));
            let _ = patch_jump(compiler, false_branch, current_offset(compiler));
            compile_statement(compiler, value.get());
            let _ = patch_jump(compiler, end_branch, current_offset(compiler));
        },
        None => {
            let _ = patch_jump(compiler, false_branch, current_offset(compiler));
        },
    }
}

fn compile_while(compiler: Compiler, test: ast::Expr, body: ast::Stmt) -> unit {
    let start = current_offset(compiler);
    compile_expression(compiler, test);
    let exit = emit(compiler, bytecode::Instruction::IfFalse(-1));
    push_loop(compiler);
    compile_statement(compiler, body);
    let loop_context = pop_loop(compiler);
    let break_context = pop_breakable(compiler);
    let _ = emit(compiler, bytecode::Instruction::Goto(start));
    let exit_target = current_offset(compiler);
    let _ = patch_jump(compiler, exit, exit_target);
    patch_loop_jumps(compiler, break_context, loop_context, exit_target, start)
}

fn compile_for(
    compiler: Compiler,
    initializer: Option[Ref[ast::Stmt]],
    test: Option[Ref[ast::Expr]],
    update: Option[Ref[ast::Expr]],
    body: ast::Stmt,
) -> unit {
    push_scope(compiler);
    let iteration_bindings: Vec[isize] = Vec::new();
    match initializer {
        Some(value) => {
            declare_lexical_statement(compiler, value.get());
            for index in lexical_statement_binding_indices(compiler, value.get()) {
                iteration_bindings.push(index)
            }
            compile_statement(compiler, value.get())
        },
        None => (),
    };
    let test_target = current_offset(compiler);
    let exit_jump = match test {
        Some(value) => {
            compile_expression(compiler, value.get());
            Option::Some(emit(compiler, bytecode::Instruction::IfFalse(-1)))
        },
        None => Option::None,
    };
    push_loop(compiler);
    compile_statement(compiler, body);
    let update_target = current_offset(compiler);
    let loop_context = pop_loop(compiler);
    let break_context = pop_breakable(compiler);
    clone_local_bindings(compiler, iteration_bindings);
    match update {
        Some(value) => {
            compile_expression(compiler, value.get());
            let _ = emit(compiler, bytecode::Instruction::Drop);
        },
        None => (),
    };
    let _ = emit(compiler, bytecode::Instruction::Goto(test_target));
    let exit_target = current_offset(compiler);
    match exit_jump {
        Some(offset) => {
            let _ = patch_jump(compiler, offset, exit_target);
        },
        None => (),
    };
    patch_loop_jumps(compiler, break_context, loop_context, exit_target, update_target);
    pop_scope(compiler)
}

fn compile_for_iteration(
    compiler: Compiler,
    kind: ast::VariableKind,
    pattern: ast::BindingPattern,
    initializer: Option[Ref[ast::Expr]],
    target: Option[Ref[ast::Expr]],
    assignment_pattern: Option[Ref[ast::AssignmentPattern]],
    source: ast::Expr,
    body: ast::Stmt,
    span: ast::Span,
    enumerate: bool,
    asynchronous: bool,
) -> unit {
    if asynchronous {
        if compiler.asynchronous {
            compiler.used_await.set(true)
        } else {
            compile_error(compiler, "await is only valid in async functions", span)
        }
    } else {};
    push_scope(compiler);
    if kind != ast::VariableKind::Var {
        declare_pattern_bindings(compiler, pattern, binding_kind(kind))
    } else {};
    match initializer {
        Some(value) => {
            compile_expression(compiler, value.get());
            compile_binding_pattern(compiler, pattern)
        },
        None => (),
    };
    compile_expression(compiler, source);
    let enumeration_source = if enumerate {
        let local = new_local(compiler);
        let _ = emit(compiler, bytecode::Instruction::Dup);
        let _ = emit(compiler, bytecode::Instruction::PutLoc(local));
        let _ = emit(compiler, bytecode::Instruction::Enumerate);
        Option::Some(local)
    } else {
        Option::None
    };
    let _ = emit(
        compiler,
        if asynchronous {
            bytecode::Instruction::AsyncIteratorStart
        } else {
            bytecode::Instruction::IteratorStart
        },
    );
    let next_local = new_local(compiler);
    let iterator_local = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(next_local));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(iterator_local));
    let iterator_finalizer_depth = compiler.finalizers.len();
    if !enumerate {
        compiler.finalizers.push(
            FinallyContext {
                kind: if asynchronous {
                    FinalizerKind::AsyncIterator(iterator_local)
                } else {
                    FinalizerKind::Iterator(iterator_local)
                },
                active: true,
            },
        )
    } else {};
    let loop_target = current_offset(compiler);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator_local));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(next_local));
    if asynchronous {
        let _ = emit(compiler, bytecode::Instruction::IteratorCallNext);
        emit_suspension(compiler, true);
        let _ = emit(compiler, bytecode::Instruction::IteratorResult);
    } else {
        let _ = emit(compiler, bytecode::Instruction::IteratorNext);
    };
    let done_jump = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let value_index = string_constant(compiler, "value");
    let _ = emit(compiler, bytecode::Instruction::GetField(value_index));
    let non_enumerable = match enumeration_source {
        Some(source) => {
            let _ = emit(compiler, bytecode::Instruction::Dup);
            let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
            let _ = emit(compiler, bytecode::Instruction::EnumerableProperty);
            Option::Some(emit(compiler, bytecode::Instruction::IfFalse(-1)))
        },
        None => Option::None,
    };
    if !enumerate {
        begin_protected_region(compiler)
    } else {};
    if kind != ast::VariableKind::Var {
        clone_local_bindings(compiler, pattern_binding_indices(compiler, pattern))
    } else {};
    match assignment_pattern {
        Some(value) => compile_assignment_pattern(compiler, value.get()),
        None => match target {
            Some(value) => compile_assignment_pattern_target(compiler, value.get(), span),
            None => compile_binding_pattern(compiler, pattern),
        },
    };
    if enumerate {
        push_loop(compiler)
    } else {
        compiler.loops.push(
            LoopContext {
                continue_jumps: Vec::new(),
                finalizer_depth: compiler.finalizers.len(),
                label: compiler.pending_loop_label.get(),
            },
        );
        compiler.pending_loop_label.set(Option::None);
        compiler.breakables.push(
            BreakContext {
                break_jumps: Vec::new(),
                finalizer_depth: iterator_finalizer_depth,
                label: Option::None,
            },
        )
    };
    compile_statement(compiler, body);
    let protected_segments = if enumerate {
        Vec::new()
    } else {
        finish_protected_region(compiler)
    };
    let loop_context = pop_loop(compiler);
    let break_context = pop_breakable(compiler);
    let _ = emit(compiler, bytecode::Instruction::Goto(loop_target));
    match non_enumerable {
        Some(offset) => {
            let target = current_offset(compiler);
            let _ = patch_jump(compiler, offset, target);
            let _ = emit(compiler, bytecode::Instruction::Drop);
            let _ = emit(compiler, bytecode::Instruction::Goto(loop_target));
        },
        None => (),
    };
    let done_target = current_offset(compiler);
    let _ = patch_jump(compiler, done_jump, done_target);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let skip_handler = if enumerate {
        Option::None
    } else {
        Option::Some(emit(compiler, bytecode::Instruction::Goto(-1)))
    };
    if !enumerate {
        let handler_target = current_offset(compiler);
        let exception_local = new_local(compiler);
        let _ = emit(compiler, bytecode::Instruction::PutLoc(exception_local));
        if asynchronous {
            let finalizer_index = compiler.finalizers.len() - 1;
            compiler.finalizers[finalizer_index].active = false;
            compile_async_iterator_close_throw(compiler, iterator_local, exception_local);
            compiler.finalizers[finalizer_index].active = true;
        } else {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator_local));
            let _ = emit(compiler, bytecode::Instruction::GetLoc(exception_local));
            let _ = emit(compiler, bytecode::Instruction::IteratorCloseThrow);
            let _ = emit(compiler, bytecode::Instruction::Throw);
        };
        for (start, end) in protected_segments {
            add_exception_handler(compiler, start, end, handler_target)
        }
    } else {};
    let exit_target = current_offset(compiler);
    match skip_handler {
        Some(offset) => {
            let _ = patch_jump(compiler, offset, exit_target);
        },
        None => (),
    };
    patch_loop_jumps(compiler, break_context, loop_context, exit_target, loop_target);
    if !enumerate {
        let _ = compiler.finalizers.pop();
    } else {};
    pop_scope(compiler)
}

fn compile_do_while(compiler: Compiler, body: ast::Stmt, test: ast::Expr) -> unit {
    let body_target = current_offset(compiler);
    push_loop(compiler);
    compile_statement(compiler, body);
    let test_target = current_offset(compiler);
    let loop_context = pop_loop(compiler);
    let break_context = pop_breakable(compiler);
    compile_expression(compiler, test);
    let _ = emit(compiler, bytecode::Instruction::IfTrue(body_target));
    let exit_target = current_offset(compiler);
    patch_loop_jumps(compiler, break_context, loop_context, exit_target, test_target)
}

fn declare_switch_lexicals(compiler: Compiler, cases: Vec[ast::SwitchCase]) -> unit {
    for clause in cases {
        declare_lexical_body(compiler, clause.consequent)
    }
}

fn compile_switch(compiler: Compiler, discriminant: ast::Expr, cases: Vec[ast::SwitchCase]) -> unit {
    push_scope(compiler);
    declare_switch_lexicals(compiler, cases);
    let discriminant_local = new_local(compiler);
    compile_expression(compiler, discriminant);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(discriminant_local));
    let dispatches: Vec[SwitchJump] = Vec::new();
    let mut default_index: Option[isize] = Option::None;
    let mut case_index = 0;
    while case_index < cases.len() {
        match cases[case_index].test {
            Some(test) => {
                let _ = emit(compiler, bytecode::Instruction::GetLoc(discriminant_local));
                compile_expression(compiler, test.get());
                let _ = emit(compiler, bytecode::Instruction::StrictEq);
                let offset = emit(compiler, bytecode::Instruction::IfTrue(-1));
                dispatches.push(SwitchJump { case_index, offset });
            },
            None => {
                default_index = Option::Some(case_index);
            },
        };
        case_index += 1;
    }
    let no_match = emit(compiler, bytecode::Instruction::Goto(-1));
    let case_targets: Vec[isize] = Vec::new();
    push_breakable(compiler);
    for clause in cases {
        case_targets.push(current_offset(compiler));
        compile_body(compiler, clause.consequent)
    }
    let break_context = pop_breakable(compiler);
    let exit_target = current_offset(compiler);
    for dispatch in dispatches {
        let _ = patch_jump(compiler, dispatch.offset, case_targets[dispatch.case_index]);
    }
    match default_index {
        Some(index) => {
            let _ = patch_jump(compiler, no_match, case_targets[index]);
        },
        None => {
            let _ = patch_jump(compiler, no_match, exit_target);
        },
    };
    for offset in break_context.break_jumps {
        let _ = patch_jump(compiler, offset, exit_target);
    }
    pop_scope(compiler)
}

fn add_exception_handler(compiler: Compiler, start: isize, end: isize, target: isize) -> unit {
    if start < end {
        compiler.exception_handlers.push(bytecode::ExceptionHandler { start, end, target })
    } else {}
}

fn compile_catch(compiler: Compiler, clause: ast::CatchClause) -> unit {
    push_scope(compiler);
    match clause.pattern {
        Some(pattern) => {
            declare_pattern_bindings(compiler, pattern.get(), BindingKind::Let);
            compile_binding_pattern(compiler, pattern.get())
        },
        None => {
            let _ = emit(compiler, bytecode::Instruction::Drop);
        },
    };
    declare_lexical_body(compiler, clause.body);
    compile_body(compiler, clause.body);
    pop_scope(compiler)
}

fn compile_try_without_finally(compiler: Compiler, block: Vec[ast::Stmt], handler: ast::CatchClause) -> unit {
    begin_protected_region(compiler);
    compile_block(compiler, block);
    let segments = finish_protected_region(compiler);
    let skip = emit(compiler, bytecode::Instruction::Goto(-1));
    let target = current_offset(compiler);
    compile_catch(compiler, handler);
    for (start, end) in segments {
        add_exception_handler(compiler, start, end, target)
    }
    let _ = patch_jump(compiler, skip, current_offset(compiler));
}

fn compile_finally_body(compiler: Compiler, finalizer_index: isize) -> unit {
    compiler.finalizers[finalizer_index].active = false;
    compile_finalizer_kind(compiler, compiler.finalizers[finalizer_index].kind);
    compiler.finalizers[finalizer_index].active = true;
}

fn compile_try_finally(
    compiler: Compiler,
    block: Vec[ast::Stmt],
    handler: Option[ast::CatchClause],
    finalizer: Vec[ast::Stmt],
) -> unit {
    let finalizer_index = compiler.finalizers.len();
    compiler.finalizers.push(
        FinallyContext { kind: FinalizerKind::Statements(finalizer), active: true },
    );
    begin_protected_region(compiler);
    match handler {
        Some(value) => compile_try_without_finally(compiler, block, value),
        None => compile_block(compiler, block),
    };
    let segments = finish_protected_region(compiler);
    compile_finally_body(compiler, finalizer_index);
    let skip = emit(compiler, bytecode::Instruction::Goto(-1));
    let target = current_offset(compiler);
    let exception_local = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(exception_local));
    compile_finally_body(compiler, finalizer_index);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(exception_local));
    let _ = emit(compiler, bytecode::Instruction::Throw);
    for (start, end) in segments {
        add_exception_handler(compiler, start, end, target)
    }
    let _ = patch_jump(compiler, skip, current_offset(compiler));
    let _ = compiler.finalizers.pop();
}

fn compile_try(
    compiler: Compiler,
    block: Vec[ast::Stmt],
    handler: Option[ast::CatchClause],
    finalizer: Option[Vec[ast::Stmt]],
) -> unit {
    match finalizer {
        Some(value) => compile_try_finally(compiler, block, handler, value),
        None => match handler {
            Some(value) => compile_try_without_finally(compiler, block, value),
            None => compile_block(compiler, block),
        },
    }
}

fn iteration_statement(statement: ast::Stmt) -> bool {
    match statement {
        ast::Stmt::While { .. } | ast::Stmt::For { .. } | ast::Stmt::ForOf { .. } | ast::Stmt::ForIn {
            ..,
        } | ast::Stmt::DoWhile { .. } => true,
        _ => false,
    }
}

fn compile_labelled_statement(compiler: Compiler, label: string, body: ast::Stmt, span: ast::Span) -> unit {
    validate_strict_identifier(compiler, label, span);
    push_label_breakable(compiler, label);
    if iteration_statement(body) {
        compiler.pending_loop_label.set(Option::Some(label))
    } else {};
    compile_statement(compiler, body);
    compiler.pending_loop_label.set(Option::None);
    let context = pop_breakable(compiler);
    let target = current_offset(compiler);
    for offset in context.break_jumps {
        let _ = patch_jump(compiler, offset, target);
    }
}

fn compile_with_statement(compiler: Compiler, object: ast::Expr, body: ast::Stmt, span: ast::Span) -> unit {
    if compiler_is_strict(compiler) {
        compile_error(compiler, "with statement is not allowed in strict mode", span)
    } else {};
    compile_expression(compiler, object);
    let _ = emit(compiler, bytecode::Instruction::RequireObjectCoercible);
    push_scope(compiler);
    let with_scope_index = compiler.scopes.len() - 1;
    let mut name = "$with_environment_" + compiler.next_with_binding.get().to_string();
    while lookup_binding(compiler, name).is_some() || lookup_outer_binding(compiler, name).is_some() {
        compiler.next_with_binding.set(compiler.next_with_binding.get() + 1);
        name = "$with_environment_" + compiler.next_with_binding.get().to_string();
    }
    compiler.next_with_binding.set(compiler.next_with_binding.get() + 1);
    let binding = declare_current(compiler, name, BindingKind::Const, span);
    match binding {
        Some(value) => {
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value.index));
        },
        None => {
            let _ = emit(compiler, bytecode::Instruction::Drop);
        },
    };
    compiler.with_bindings.insert(0, WithBinding { name, scope_index: with_scope_index });
    compile_statement(compiler, body);
    let _ = compiler.with_bindings.remove(0);
    pop_scope(compiler)
}

fn compile_statement(compiler: Compiler, statement: ast::Stmt) -> unit {
    set_source_offset(compiler, ast::stmt_span(statement).start);
    match statement {
        ast::Stmt::Empty { .. } | ast::Stmt::Debugger { .. } => (),
        ast::Stmt::Expression { expression, .. } => {
            compile_expression(compiler, expression.get());
            match compiler.completion_local.get() {
                Some(local) => {
                    let _ = emit(compiler, bytecode::Instruction::PutLoc(local));
                },
                None => {
                    let _ = emit(compiler, bytecode::Instruction::Drop);
                },
            }
        },
        ast::Stmt::Block { body, .. } => compile_block(compiler, body),
        ast::Stmt::VariableDeclaration { kind, declarations, .. } => {
            compile_variable_declaration(compiler, kind, declarations)
        },
        ast::Stmt::ImportNamespace { default_specifier, local, source, span, .. } => {
            if !compiler.module_mode.get() {
                if default_specifier.is_some() {
                    compile_error(
                        compiler,
                        "module import is only supported by module compilation",
                        span,
                    )
                } else {};
                if source == "std" || source == "os" {
                    let source_index = string_constant(compiler, source);
                    let _ = emit(compiler, bytecode::Instruction::GetGlobal(source_index));
                } else {
                    compile_error(compiler, "unsupported import module `" + source + "`", span);
                    let _ = emit(compiler, bytecode::Instruction::Undefined);
                };
                match compiler.scopes[compiler.scopes.len() - 1].bindings.get(local) {
                    Some(binding) => {
                        let _ = emit(compiler, bytecode::Instruction::PutLoc(binding.index));
                    },
                    None => {
                        let _ = emit(compiler, bytecode::Instruction::Drop);
                    },
                }
            } else {}
        },
        ast::Stmt::ImportNamed { span, .. } | ast::Stmt::ImportSideEffect { span, .. } => {
            if !compiler.module_mode.get() {
                compile_error(
                    compiler,
                    "module import is only supported by module compilation",
                    span,
                )
            } else {}
        },
        ast::Stmt::ExportNamed { span, .. } => if !compiler.module_mode.get() {
            compile_error(compiler, "export is only supported by module compilation", span)
        } else {},
        ast::Stmt::ExportDefault { expression, local, hoisted, span, .. } => if compiler.module_mode.get() {
            if !hoisted {
                compile_export_default(compiler, expression.get(), local, span)
            } else {}
        } else {
            compile_error(compiler, "export is only supported by module compilation", span)
        },
        ast::Stmt::ExportAll { span, .. } | ast::Stmt::ExportNamespace { span, .. } => if !compiler.module_mode.get() {
            compile_error(compiler, "export is only supported by module compilation", span)
        } else {},
        ast::Stmt::ExportDeclaration { declaration, span } => if compiler.module_mode.get() {
            match declaration.get() {
                ast::Stmt::FunctionDeclaration { .. } => (),
                value => compile_statement(compiler, value),
            }
        } else {
            compile_error(compiler, "export is only supported by module compilation", span)
        },
        ast::Stmt::FunctionDeclaration { name, parameters, body, generator, asynchronous, span } => {
            compile_function_declaration(
                compiler,
                name,
                parameters,
                body,
                generator,
                asynchronous,
                span,
            )
        },
        ast::Stmt::ClassDeclaration { name, heritage, elements, span } => {
            compile_class_declaration(compiler, name, heritage, elements, span)
        },
        ast::Stmt::If { test, consequent, alternate, .. } => {
            compile_if(compiler, test.get(), consequent.get(), alternate)
        },
        ast::Stmt::While { test, body, .. } => {
            compile_while(compiler, test.get(), body.get())
        },
        ast::Stmt::With { object, body, span } => {
            compile_with_statement(compiler, object.get(), body.get(), span)
        },
        ast::Stmt::For { initializer, test, update, body, .. } => {
            compile_for(compiler, initializer, test, update, body.get())
        },
        ast::Stmt::ForOf {
            kind,
            pattern,
            target,
            assignment_pattern,
            iterable,
            body,
            asynchronous,
            span,
            ..,
        } => {
            compile_for_iteration(
                compiler,
                kind,
                pattern.get(),
                Option::None,
                target,
                assignment_pattern,
                iterable.get(),
                body.get(),
                span,
                false,
                asynchronous,
            )
        },
        ast::Stmt::ForIn { kind, pattern, initializer, target, object, body, span, .. } => {
            compile_for_iteration(
                compiler,
                kind,
                pattern.get(),
                initializer,
                target,
                Option::None,
                object.get(),
                body.get(),
                span,
                true,
                false,
            )
        },
        ast::Stmt::DoWhile { body, test, .. } => {
            compile_do_while(compiler, body.get(), test.get())
        },
        ast::Stmt::Switch { discriminant, cases, .. } => {
            compile_switch(compiler, discriminant.get(), cases)
        },
        ast::Stmt::Break { label, span } => {
            compile_loop_jump(compiler, false, label, span)
        },
        ast::Stmt::Continue { label, span } => {
            compile_loop_jump(compiler, true, label, span)
        },
        ast::Stmt::Labelled { label, body, span } => {
            compile_labelled_statement(compiler, label, body.get(), span)
        },
        ast::Stmt::Return { argument, .. } => match argument {
            Some(value) => {
                compile_expression(compiler, value.get());
                if !compiler.finalizers.is_empty() {
                    let local = new_local(compiler);
                    let _ = emit(compiler, bytecode::Instruction::PutLoc(local));
                    compile_return_finalizers(compiler);
                    let _ = emit(compiler, bytecode::Instruction::GetLoc(local));
                } else {};
                let _ = emit(compiler, bytecode::Instruction::Return);
            },
            None => {
                if compiler.finalizers.is_empty() {
                    let _ = emit(compiler, bytecode::Instruction::ReturnUndef);
                } else {
                    compile_return_finalizers(compiler);
                    let _ = emit(compiler, bytecode::Instruction::ReturnUndef);
                }
            },
        },
        ast::Stmt::Throw { argument, .. } => {
            compile_expression(compiler, argument.get());
            let _ = emit(compiler, bytecode::Instruction::Throw);
        },
        ast::Stmt::Try { block, handler, finalizer, .. } => {
            compile_try(compiler, block, handler, finalizer)
        },
    }
}

fn compile_body(compiler: Compiler, body: Vec[ast::Stmt]) -> unit {
    initialize_function_declarations(compiler, body);
    for statement in body {
        match statement {
            ast::Stmt::FunctionDeclaration { .. } => (),
            _ => compile_statement(compiler, statement),
        }
    }
}

fn parameter_pattern_is_identifier(pattern: ast::BindingPattern) -> bool {
    match pattern {
        ast::BindingPattern::Identifier { .. } => true,
        _ => false,
    }
}

fn simple_parameter_list(parameters: Vec[ast::FunctionParameter]) -> bool {
    for parameter in parameters {
        if parameter.rest || parameter.initializer.is_some()
            || !parameter_pattern_is_identifier(parameter.pattern.get()) {
            return false
        } else {}
    }
    true
}

fn function_body_is_strict(body: Vec[ast::Stmt]) -> bool {
    for statement in body {
        match statement {
            ast::Stmt::Expression { expression, .. } => match expression.get() {
                ast::Expr::String { value, raw, .. } => if value == "use strict"
                    && (raw == "\"use strict\"" || raw == "'use strict'") {
                    return true
                } else {},
                _ => return false,
            },
            _ => return false,
        }
    }
    false
}

fn collect_parameter_names(pattern: ast::BindingPattern, names: Vec[(string, ast::Span)]) -> unit {
    match pattern {
        ast::BindingPattern::Identifier { name, span } => {
            if name != "" {
                names.push((name, span))
            } else {}
        },
        ast::BindingPattern::Array { elements, .. } => {
            for element in elements {
                match element {
                    ast::ArrayBindingElement::Hole => (),
                    ast::ArrayBindingElement::Element { pattern, .. } => {
                        collect_parameter_names(pattern.get(), names)
                    },
                }
            }
        },
        ast::BindingPattern::Object { properties, .. } => {
            for property in properties {
                match property {
                    ast::ObjectBindingProperty::Property { pattern, .. } | ast::ObjectBindingProperty::Rest {
                        pattern,
                        ..,
                    } => {
                        collect_parameter_names(pattern.get(), names)
                    },
                }
            }
        },
    }
}

fn declare_parameter_bindings(compiler: Compiler, parameters: Vec[ast::FunctionParameter]) -> unit {
    let allow_duplicates = simple_parameter_list(parameters);
    let names: Vec[(string, ast::Span)] = Vec::new();
    for parameter in parameters {
        collect_parameter_names(parameter.pattern.get(), names)
    }
    for (name, span) in names {
        validate_strict_identifier(compiler, name, span);
        match compiler.scopes[0].bindings.get(name) {
            Some(_) => if !allow_duplicates {
                compile_error(compiler, "duplicate parameter `" + name + "`", span)
            } else {},
            None => {
                let index = new_local(compiler);
                compiler.scopes[0].bindings.set(
                    name,
                    Binding { name, index, kind: BindingKind::Var, span },
                )
            },
        }
    }
}

fn validate_unique_parameter_names(compiler: Compiler, parameters: Vec[ast::FunctionParameter]) -> unit {
    let names: Vec[(string, ast::Span)] = Vec::new();
    let seen: HashMap[string, bool] = HashMap::new();
    for parameter in parameters {
        collect_parameter_names(parameter.pattern.get(), names)
    }
    for (name, span) in names {
        if seen.get(name).is_some() {
            compile_error(compiler, "duplicate parameter `" + name + "`", span)
        } else {
            seen[name] = true;
        }
    }
}

fn mapped_argument_locals(
    compiler: Compiler,
    parameters: Vec[ast::FunctionParameter],
    strict: bool,
    arrow: bool,
) -> Vec[isize] {
    if strict || arrow || !simple_parameter_list(parameters) {
        return Vec::new()
    } else {};
    let mapped: Vec[isize] = Vec::with_capacity(parameters.len());
    for _ in parameters {
        mapped.push(-1)
    }
    let seen: HashMap[string, bool] = HashMap::new();
    let mut index = parameters.len();
    while index > 0 {
        index -= 1;
        match parameters[index].pattern.get() {
            ast::BindingPattern::Identifier { name, .. } => if seen.get(name).is_none() {
                seen[name] = true;
                match compiler.scopes[0].bindings.get(name) {
                    Some(binding) => {
                        mapped[index] = binding.index;
                    },
                    None => (),
                }
            } else {},
            _ => (),
        }
    }
    mapped
}

fn declare_pattern_bindings(compiler: Compiler, pattern: ast::BindingPattern, kind: BindingKind) -> unit {
    let names: Vec[(string, ast::Span)] = Vec::new();
    collect_parameter_names(pattern, names);
    for (name, span) in names {
        let _ = declare_current(compiler, name, kind, span);
    }
}

fn pattern_binding_indices(compiler: Compiler, pattern: ast::BindingPattern) -> Vec[isize] {
    let indices: Vec[isize] = Vec::new();
    let names: Vec[(string, ast::Span)] = Vec::new();
    collect_parameter_names(pattern, names);
    let scope = compiler.scopes[compiler.scopes.len() - 1];
    for (name, _) in names {
        match scope.bindings.get(name) {
            Some(binding) => indices.push(binding.index),
            None => (),
        }
    }
    indices
}

fn lexical_statement_binding_indices(compiler: Compiler, statement: ast::Stmt) -> Vec[isize] {
    let indices: Vec[isize] = Vec::new();
    match statement {
        ast::Stmt::VariableDeclaration { kind, declarations, .. } => {
            if kind != ast::VariableKind::Var {
                for declaration in declarations {
                    for index in pattern_binding_indices(compiler, declaration.pattern.get()) {
                        indices.push(index)
                    }
                }
            } else {}
        },
        _ => (),
    };
    indices
}

fn clone_local_bindings(compiler: Compiler, indices: Vec[isize]) -> unit {
    for index in indices {
        let _ = emit(compiler, bytecode::Instruction::CloneLoc(index));
    }
}

fn binding_inferred_name(pattern: ast::BindingPattern) -> Option[string] {
    match pattern {
        ast::BindingPattern::Identifier { name, .. } => Option::Some(name),
        _ => Option::None,
    }
}

fn compile_binding_initializer(
    compiler: Compiler,
    initializer: Option[Ref[ast::Expr]],
    pattern: ast::BindingPattern,
) -> unit {
    match initializer {
        None => (),
        Some(value) => {
            let _ = emit(compiler, bytecode::Instruction::Dup);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
            let _ = emit(compiler, bytecode::Instruction::StrictEq);
            let initialized = emit(compiler, bytecode::Instruction::IfFalse(-1));
            let _ = emit(compiler, bytecode::Instruction::Drop);
            match binding_inferred_name(pattern) {
                Some(name) => {
                    compile_expression_with_inferred_name(compiler, value.get(), name)
                },
                None => compile_expression(compiler, value.get()),
            };
            let _ = patch_jump(compiler, initialized, current_offset(compiler));
        },
    }
}

fn bind_identifier(compiler: Compiler, name: string, span: ast::Span) -> unit {
    match lookup_binding(compiler, name) {
        Some(binding) => if is_global_lexical_binding(compiler, binding) {
            let index = string_constant(compiler, name);
            let _ = emit(compiler, bytecode::Instruction::InitGlobalLexical(index));
        } else {
            let _ = emit(compiler, bytecode::Instruction::PutLoc(binding.index));
        },
        None => if is_script_global_var(compiler, name) || has_dynamic_eval_var(compiler, name) {
            let index = string_constant(compiler, name);
            let _ = emit(compiler, bytecode::Instruction::SetEval(index));
            let _ = emit(compiler, bytecode::Instruction::Drop);
        } else {
            match resolve_upvalue(compiler, name) {
                Some((index, _)) => {
                    let _ = emit(compiler, bytecode::Instruction::PutUpvalue(index));
                },
                None => {
                    compile_error(compiler, "binding has no allocated storage", span);
                    let _ = emit(compiler, bytecode::Instruction::Drop);
                },
            }
        },
    }
}

fn compile_iterator_binding_value(compiler: Compiler, iterator: isize, next: isize, done: isize) -> unit {
    let _ = emit(compiler, bytecode::Instruction::GetLoc(done));
    let already_done = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(next));
    let _ = emit(compiler, bytecode::Instruction::IteratorNext);
    let finished = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let value = string_constant(compiler, "value");
    let _ = emit(compiler, bytecode::Instruction::GetField(value));
    let available = emit(compiler, bytecode::Instruction::Goto(-1));
    let finished_target = current_offset(compiler);
    let _ = patch_jump(compiler, finished, finished_target);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let _ = emit(compiler, bytecode::Instruction::PushTrue);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(done));
    let undefined_target = current_offset(compiler);
    let _ = patch_jump(compiler, already_done, undefined_target);
    let _ = emit(compiler, bytecode::Instruction::Undefined);
    let _ = patch_jump(compiler, available, current_offset(compiler));
}

fn compile_array_rest_binding(
    compiler: Compiler,
    pattern: ast::BindingPattern,
    iterator: isize,
    next: isize,
    done: isize,
) -> unit {
    let array = new_local(compiler);
    let value = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::NewArray(0));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(array));
    let loop_target = current_offset(compiler);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(done));
    let already_done = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(next));
    let _ = emit(compiler, bytecode::Instruction::IteratorNext);
    let finished = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let value_key = string_constant(compiler, "value");
    let _ = emit(compiler, bytecode::Instruction::GetField(value_key));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(array));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
    let _ = emit(compiler, bytecode::Instruction::ArrayAppend);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(array));
    let _ = emit(compiler, bytecode::Instruction::Goto(loop_target));
    let finished_target = current_offset(compiler);
    let _ = patch_jump(compiler, finished, finished_target);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let _ = emit(compiler, bytecode::Instruction::PushTrue);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(done));
    let exit_target = current_offset(compiler);
    let _ = patch_jump(compiler, already_done, exit_target);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(array));
    compile_binding_pattern(compiler, pattern)
}

fn compile_array_binding_pattern(compiler: Compiler, elements: Vec[ast::ArrayBindingElement]) -> unit {
    let _ = emit(compiler, bytecode::Instruction::IteratorStart);
    let next = new_local(compiler);
    let iterator = new_local(compiler);
    let done = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(next));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::PushFalse);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(done));
    compiler.finalizers.push(
        FinallyContext { kind: FinalizerKind::Iterator(iterator), active: true },
    );
    begin_protected_region(compiler);
    for element in elements {
        match element {
            ast::ArrayBindingElement::Hole => {
                compile_iterator_binding_value(compiler, iterator, next, done);
                let _ = emit(compiler, bytecode::Instruction::Drop);
            },
            ast::ArrayBindingElement::Element { pattern, initializer, rest, .. } => if rest {
                compile_array_rest_binding(compiler, pattern.get(), iterator, next, done)
            } else {
                compile_iterator_binding_value(compiler, iterator, next, done);
                compile_binding_initializer(compiler, initializer, pattern.get());
                compile_binding_pattern(compiler, pattern.get())
            },
        }
    }
    let protected_segments = finish_protected_region(compiler);
    let _ = compiler.finalizers.pop();
    let _ = emit(compiler, bytecode::Instruction::GetLoc(done));
    let skip_close = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::IteratorClose);
    let _ = patch_jump(compiler, skip_close, current_offset(compiler));
    let skip_handler = emit(compiler, bytecode::Instruction::Goto(-1));
    let handler_target = current_offset(compiler);
    let exception = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(exception));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(exception));
    let _ = emit(compiler, bytecode::Instruction::IteratorCloseThrow);
    let _ = emit(compiler, bytecode::Instruction::Throw);
    for (start, end) in protected_segments {
        add_exception_handler(compiler, start, end, handler_target)
    }
    let _ = patch_jump(compiler, skip_handler, current_offset(compiler));
}

fn emit_excluded_binding_key(compiler: Compiler, key: ExcludedBindingKey) -> unit {
    match key {
        ExcludedBindingKey::Constant(index) => {
            let _ = emit(compiler, bytecode::Instruction::PushConst(index));
        },
        ExcludedBindingKey::Local(index) => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(index));
        },
    }
}

fn compile_object_binding_pattern(compiler: Compiler, properties: Vec[ast::ObjectBindingProperty]) -> unit {
    let _ = emit(compiler, bytecode::Instruction::RequireObjectCoercible);
    let source = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(source));
    let excluded: Vec[ExcludedBindingKey] = Vec::new();
    for property in properties {
        match property {
            ast::ObjectBindingProperty::Property { key, pattern, initializer, span } => {
                match key {
                    ast::ObjectPropertyKey::Computed(expression) => {
                        compile_expression(compiler, expression.get());
                        let _ = emit(compiler, bytecode::Instruction::ToPropertyKey);
                        let key_local = new_local(compiler);
                        let _ = emit(compiler, bytecode::Instruction::PutLoc(key_local));
                        excluded.push(ExcludedBindingKey::Local(key_local));
                        let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
                        let _ = emit(compiler, bytecode::Instruction::GetLoc(key_local));
                        let _ = emit(compiler, bytecode::Instruction::GetArrayEl);
                    },
                    value => {
                        let name = object_property_name(compiler, value, span);
                        let key_index = string_constant(compiler, name);
                        excluded.push(ExcludedBindingKey::Constant(key_index));
                        let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
                        let _ = emit(compiler, bytecode::Instruction::GetField(key_index));
                    },
                };
                compile_binding_initializer(compiler, initializer, pattern.get());
                compile_binding_pattern(compiler, pattern.get())
            },
            ast::ObjectBindingProperty::Rest { pattern, .. } => {
                let _ = emit(compiler, bytecode::Instruction::NewObject);
                let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
                for key in excluded {
                    emit_excluded_binding_key(compiler, key)
                }
                let _ = emit(
                    compiler,
                    bytecode::Instruction::CopyDataPropertiesExcluded(excluded.len()),
                );
                compile_binding_pattern(compiler, pattern.get())
            },
        }
    }
}

fn compile_binding_pattern(compiler: Compiler, pattern: ast::BindingPattern) -> unit {
    match pattern {
        ast::BindingPattern::Identifier { name, span } => bind_identifier(compiler, name, span),
        ast::BindingPattern::Array { elements, .. } => {
            compile_array_binding_pattern(compiler, elements)
        },
        ast::BindingPattern::Object { properties, .. } => {
            compile_object_binding_pattern(compiler, properties)
        },
    }
}

fn assignment_pattern_inferred_name(pattern: ast::AssignmentPattern) -> Option[string] {
    match pattern {
        ast::AssignmentPattern::Target { target, .. } => assignment_inferred_name(target.get()),
        _ => Option::None,
    }
}

fn compile_assignment_pattern_initializer(
    compiler: Compiler,
    initializer: Option[Ref[ast::Expr]],
    pattern: ast::AssignmentPattern,
) -> unit {
    match initializer {
        None => (),
        Some(value) => {
            let _ = emit(compiler, bytecode::Instruction::Dup);
            let _ = emit(compiler, bytecode::Instruction::Undefined);
            let _ = emit(compiler, bytecode::Instruction::StrictEq);
            let initialized = emit(compiler, bytecode::Instruction::IfFalse(-1));
            let _ = emit(compiler, bytecode::Instruction::Drop);
            match assignment_pattern_inferred_name(pattern) {
                Some(name) => {
                    compile_expression_with_inferred_name(compiler, value.get(), name)
                },
                None => compile_expression(compiler, value.get()),
            };
            let _ = patch_jump(compiler, initialized, current_offset(compiler));
        },
    }
}

fn compile_assignment_pattern_target(compiler: Compiler, target: ast::Expr, span: ast::Span) -> unit {
    let assignment = prepare_assignment_target(compiler, target, span);
    store_assignment_target(compiler, assignment);
    let _ = emit(compiler, bytecode::Instruction::Drop);
}

fn compile_array_rest_assignment(
    compiler: Compiler,
    pattern: ast::AssignmentPattern,
    iterator: isize,
    next: isize,
    done: isize,
) -> unit {
    let array = new_local(compiler);
    let value = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::NewArray(0));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(array));
    let loop_target = current_offset(compiler);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(done));
    let already_done = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(next));
    let _ = emit(compiler, bytecode::Instruction::IteratorNext);
    let finished = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let value_key = string_constant(compiler, "value");
    let _ = emit(compiler, bytecode::Instruction::GetField(value_key));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(array));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
    let _ = emit(compiler, bytecode::Instruction::ArrayAppend);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(array));
    let _ = emit(compiler, bytecode::Instruction::Goto(loop_target));
    let finished_target = current_offset(compiler);
    let _ = patch_jump(compiler, finished, finished_target);
    let _ = emit(compiler, bytecode::Instruction::Drop);
    let _ = emit(compiler, bytecode::Instruction::PushTrue);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(done));
    let exit_target = current_offset(compiler);
    let _ = patch_jump(compiler, already_done, exit_target);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(array));
    compile_assignment_pattern(compiler, pattern)
}

fn compile_array_assignment_pattern(compiler: Compiler, elements: Vec[ast::ArrayAssignmentElement]) -> unit {
    let _ = emit(compiler, bytecode::Instruction::IteratorStart);
    let next = new_local(compiler);
    let iterator = new_local(compiler);
    let done = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(next));
    let _ = emit(compiler, bytecode::Instruction::PutLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::PushFalse);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(done));
    compiler.finalizers.push(
        FinallyContext { kind: FinalizerKind::Iterator(iterator), active: true },
    );
    begin_protected_region(compiler);
    for element in elements {
        match element {
            ast::ArrayAssignmentElement::Hole => {
                compile_iterator_binding_value(compiler, iterator, next, done);
                let _ = emit(compiler, bytecode::Instruction::Drop);
            },
            ast::ArrayAssignmentElement::Element { pattern, initializer, rest, .. } => if rest {
                compile_array_rest_assignment(compiler, pattern.get(), iterator, next, done)
            } else {
                compile_iterator_binding_value(compiler, iterator, next, done);
                compile_assignment_pattern_initializer(compiler, initializer, pattern.get());
                compile_assignment_pattern(compiler, pattern.get())
            },
        }
    }
    let protected_segments = finish_protected_region(compiler);
    let _ = compiler.finalizers.pop();
    let _ = emit(compiler, bytecode::Instruction::GetLoc(done));
    let skip_close = emit(compiler, bytecode::Instruction::IfTrue(-1));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::IteratorClose);
    let _ = patch_jump(compiler, skip_close, current_offset(compiler));
    let skip_handler = emit(compiler, bytecode::Instruction::Goto(-1));
    let handler_target = current_offset(compiler);
    let exception = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(exception));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(iterator));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(exception));
    let _ = emit(compiler, bytecode::Instruction::IteratorCloseThrow);
    let _ = emit(compiler, bytecode::Instruction::Throw);
    for (start, end) in protected_segments {
        add_exception_handler(compiler, start, end, handler_target)
    }
    let _ = patch_jump(compiler, skip_handler, current_offset(compiler));
}

fn compile_object_assignment_pattern(
    compiler: Compiler,
    properties: Vec[ast::ObjectAssignmentProperty],
) -> unit {
    let _ = emit(compiler, bytecode::Instruction::RequireObjectCoercible);
    let source = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(source));
    let excluded: Vec[ExcludedBindingKey] = Vec::new();
    for property in properties {
        match property {
            ast::ObjectAssignmentProperty::Property { key, pattern, initializer, span } => {
                match key {
                    ast::ObjectPropertyKey::Computed(expression) => {
                        compile_expression(compiler, expression.get());
                        let _ = emit(compiler, bytecode::Instruction::ToPropertyKey);
                        let key_local = new_local(compiler);
                        let _ = emit(compiler, bytecode::Instruction::PutLoc(key_local));
                        excluded.push(ExcludedBindingKey::Local(key_local));
                        let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
                        let _ = emit(compiler, bytecode::Instruction::GetLoc(key_local));
                        let _ = emit(compiler, bytecode::Instruction::GetArrayEl);
                    },
                    value => {
                        let name = object_property_name(compiler, value, span);
                        let key_index = string_constant(compiler, name);
                        excluded.push(ExcludedBindingKey::Constant(key_index));
                        let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
                        let _ = emit(compiler, bytecode::Instruction::GetField(key_index));
                    },
                };
                compile_assignment_pattern_initializer(compiler, initializer, pattern.get());
                compile_assignment_pattern(compiler, pattern.get())
            },
            ast::ObjectAssignmentProperty::Rest { pattern, .. } => {
                let _ = emit(compiler, bytecode::Instruction::NewObject);
                let _ = emit(compiler, bytecode::Instruction::GetLoc(source));
                for key in excluded {
                    emit_excluded_binding_key(compiler, key)
                }
                let _ = emit(
                    compiler,
                    bytecode::Instruction::CopyDataPropertiesExcluded(excluded.len()),
                );
                compile_assignment_pattern(compiler, pattern.get())
            },
        }
    }
}

fn compile_assignment_pattern(compiler: Compiler, pattern: ast::AssignmentPattern) -> unit {
    match pattern {
        ast::AssignmentPattern::Target { target, span } => {
            compile_assignment_pattern_target(compiler, target.get(), span)
        },
        ast::AssignmentPattern::Array { elements, .. } => {
            compile_array_assignment_pattern(compiler, elements)
        },
        ast::AssignmentPattern::Object { properties, .. } => {
            compile_object_assignment_pattern(compiler, properties)
        },
    }
}

fn compile_destructuring_assignment(
    compiler: Compiler,
    pattern: ast::AssignmentPattern,
    right: ast::Expr,
) -> unit {
    compile_expression(compiler, right);
    let result = new_local(compiler);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(result));
    let _ = emit(compiler, bytecode::Instruction::GetLoc(result));
    compile_assignment_pattern(compiler, pattern);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(result));
}

fn compiler_new(
    parameters: Vec[ast::FunctionParameter],
    outer_bindings: Vec[OuterBinding],
    recursive_name: Option[string],
    arguments_available: bool,
    lexical_this: bool,
    lexical_arguments: bool,
    super_call_allowed: bool,
    super_property_allowed: bool,
    strict: bool,
    generator: bool,
    asynchronous: bool,
    runtime_eval_environment: bool,
) -> Compiler {
    let parameter_count = parameters.len();
    let mut function_length = 0;
    let mut count_length = true;
    for parameter in parameters {
        let identifier_rest = parameter.rest
            && parameter_pattern_is_identifier(parameter.pattern.get());
        if count_length && !identifier_rest && parameter.initializer.is_none() {
            function_length += 1;
        } else {
            count_length = false;
        }
    }
    let compiler = Compiler {
        constants: Vec::new(),
        code: Vec::new(),
        eval_sites: Vec::new(),
        scopes: Vec::from_array([Scope { bindings: HashMap::new() }]),
        var_indices: Vec::new(),
        var_scope_index: Ref::new(0),
        next_local: Ref::new(0),
        loops: Vec::new(),
        breakables: Vec::new(),
        outer_bindings,
        upvalues: Vec::new(),
        parameter_count,
        function_length,
        strict,
        strict_context: Ref::new(false),
        arguments_available,
        lexical_this,
        lexical_arguments,
        super_call_allowed,
        super_property_allowed,
        generator,
        asynchronous,
        used_await: Ref::new(false),
        completion_local: Ref::new(Option::None),
        errors: Vec::new(),
        exception_handlers: Vec::new(),
        generator_return_handlers: Vec::new(),
        finalizers: Vec::new(),
        protected_regions: Vec::new(),
        source: Ref::new(""),
        source_name: Ref::new("<input>"),
        source_locations: Vec::new(),
        current_source_offset: Ref::new(0),
        allow_unknown_globals: Ref::new(false),
        pending_loop_label: Ref::new(Option::None),
        direct_eval: Ref::new(false),
        dynamic_eval_vars: Vec::new(),
        dynamic_eval_declarations: Vec::new(),
        with_bindings: Vec::new(),
        next_with_binding: Ref::new(0),
        module_mode: Ref::new(false),
        script_mode: Ref::new(false),
        global_lexical_indices: HashMap::new(),
        global_var_kinds: HashMap::new(),
        global_declaration_offsets: HashMap::new(),
        runtime_eval_environment,
    };
    for binding in compiler.outer_bindings {
        if binding.name.starts_with("$with_environment_") {
            compiler.with_bindings.push(WithBinding { name: binding.name, scope_index: -1 })
        } else {}
    }
    match recursive_name {
        Some(name) => {
            compiler.outer_bindings.insert(
                0,
                OuterBinding {
                    name,
                    source: bytecode::UpvalueSource::Closure,
                    kind: BindingKind::NamedFunction,
                    declaration_target: false,
                    environment_depth: 0,
                },
            );
        },
        None => (),
    };
    for _ in 0..parameter_count {
        let _ = new_local(compiler);
    }
    declare_parameter_bindings(compiler, parameters);
    compiler
}

fn compile_parameter_initializers(compiler: Compiler, parameters: Vec[ast::FunctionParameter]) -> unit {
    let mut index = 0;
    for parameter in parameters {
        if parameter.rest {
            let _ = emit(compiler, bytecode::Instruction::PushRest(index));
        } else {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(index));
        };
        compile_binding_initializer(compiler, parameter.initializer, parameter.pattern.get());
        compile_binding_pattern(compiler, parameter.pattern.get());
        index += 1;
    }
}

fn append_verifier_errors(compiler: Compiler, function: bytecode::Function, span: ast::Span) -> unit {
    let result = bytecode::verify(function);
    for error in result.errors {
        compile_error(compiler, "invalid generated bytecode: " + error.debug(), span)
    }
}

fn module_binding_index(compiler: Compiler, name: string, span: ast::Span) -> isize {
    match lookup_binding(compiler, name) {
        Some(binding) => binding.index,
        None => {
            compile_error(compiler, "undefined module binding `" + name + "`", span);
            -1
        },
    }
}

fn push_module_export(compiler: Compiler, exports: Vec[ModuleExport], value: ModuleExport) -> unit {
    for current in exports {
        if value.exported != "*" && current.exported == value.exported {
            compile_error(compiler, "duplicate module export `" + value.exported + "`", value.span);
            return
        } else {}
    }
    exports.push(value)
}

fn collect_module_declaration_exports(
    compiler: Compiler,
    exports: Vec[ModuleExport],
    declaration: ast::Stmt,
) -> unit {
    match declaration {
        ast::Stmt::VariableDeclaration { declarations, .. } => {
            for declaration in declarations {
                let names: Vec[(string, ast::Span)] = Vec::new();
                collect_parameter_names(declaration.pattern.get(), names);
                for (name, span) in names {
                    push_module_export(
                        compiler,
                        exports,
                        ModuleExport {
                            exported: name,
                            source: Option::None,
                            imported: name,
                            local_index: module_binding_index(compiler, name, span),
                            attributes: Vec::new(),
                            span,
                        },
                    )
                }
            }
        },
        ast::Stmt::FunctionDeclaration { name, span, .. } | ast::Stmt::ClassDeclaration {
            name,
            span,
            ..,
        } => push_module_export(
            compiler,
            exports,
            ModuleExport {
                exported: name,
                source: Option::None,
                imported: name,
                local_index: module_binding_index(compiler, name, span),
                attributes: Vec::new(),
                span,
            },
        ),
        _ => (),
    }
}

fn collect_module_metadata(compiler: Compiler, body: Vec[ast::Stmt]) -> (
    Vec[ModuleImport],
    Vec[ModuleExport],
) {
    let imports: Vec[ModuleImport] = Vec::new();
    let exports: Vec[ModuleExport] = Vec::new();
    let convert_attributes = |values: Vec[ast::ImportAttribute]| {
        let result: Vec[ModuleAttribute] = Vec::new();
        for value in values {
            result.push(ModuleAttribute { key: value.key, value: value.value })
        }
        result
    };
    for statement in body {
        match statement {
            ast::Stmt::ImportNamespace { default_specifier, local, source, attributes, span } => {
                match default_specifier {
                    Some(specifier) => imports.push(
                        ModuleImport {
                            kind: ModuleImportKind::Named,
                            source,
                            imported: "default",
                            local: specifier.local,
                            local_index: module_binding_index(
                                compiler,
                                specifier.local,
                                specifier.span,
                            ),
                            attributes: convert_attributes(attributes),
                            span: specifier.span,
                        },
                    ),
                    None => (),
                };
                imports.push(
                    ModuleImport {
                        kind: ModuleImportKind::Namespace,
                        source,
                        imported: "*",
                        local,
                        local_index: module_binding_index(compiler, local, span),
                        attributes: convert_attributes(attributes),
                        span,
                    },
                )
            },
            ast::Stmt::ImportNamed { specifiers, source, attributes, .. } => {
                for specifier in specifiers {
                    imports.push(
                        ModuleImport {
                            kind: ModuleImportKind::Named,
                            source,
                            imported: specifier.imported,
                            local: specifier.local,
                            local_index: module_binding_index(
                                compiler,
                                specifier.local,
                                specifier.span,
                            ),
                            attributes: convert_attributes(attributes),
                            span: specifier.span,
                        },
                    )
                }
            },
            ast::Stmt::ImportSideEffect { source, attributes, span } => imports.push(
                ModuleImport {
                    kind: ModuleImportKind::SideEffect,
                    source,
                    imported: "",
                    local: "",
                    local_index: -1,
                    attributes: convert_attributes(attributes),
                    span,
                },
            ),
            ast::Stmt::ExportNamed { specifiers, source, attributes, .. } => {
                for specifier in specifiers {
                    push_module_export(
                        compiler,
                        exports,
                        ModuleExport {
                            exported: specifier.exported,
                            source,
                            imported: specifier.local,
                            local_index: match source {
                                Some(_) => -1,
                                None => module_binding_index(
                                    compiler,
                                    specifier.local,
                                    specifier.span,
                                ),
                            },
                            attributes: convert_attributes(attributes),
                            span: specifier.span,
                        },
                    )
                }
            },
            ast::Stmt::ExportDeclaration { declaration, .. } => {
                collect_module_declaration_exports(compiler, exports, declaration.get())
            },
            ast::Stmt::ExportDefault { local, span, .. } => push_module_export(
                compiler,
                exports,
                ModuleExport {
                    exported: "default",
                    source: Option::None,
                    imported: local,
                    local_index: module_binding_index(compiler, local, span),
                    attributes: Vec::new(),
                    span,
                },
            ),
            ast::Stmt::ExportAll { source, attributes, span } => push_module_export(
                compiler,
                exports,
                ModuleExport {
                    exported: "*",
                    source: Option::Some(source),
                    imported: "*",
                    local_index: -1,
                    attributes: convert_attributes(attributes),
                    span,
                },
            ),
            ast::Stmt::ExportNamespace { exported, local, source, attributes, span } => {
                imports.push(
                    ModuleImport {
                        kind: ModuleImportKind::Namespace,
                        source,
                        imported: "*",
                        local,
                        local_index: module_binding_index(compiler, local, span),
                        attributes: convert_attributes(attributes),
                        span,
                    },
                );
                push_module_export(
                    compiler,
                    exports,
                    ModuleExport {
                        exported,
                        source: Option::None,
                        imported: local,
                        local_index: module_binding_index(compiler, local, span),
                        attributes: Vec::new(),
                        span,
                    },
                )
            },
            _ => (),
        }
    };
    (imports, exports)
}

fn compile_module_program_with_source(program: ast::Program, source: string, source_name: string) -> Result[
    CompiledModule,
    Vec[CompileError],
] {
    let compiler = compiler_new(
        Vec::new(),
        Vec::new(),
        Option::None,
        false,
        false,
        false,
        false,
        false,
        true,
        false,
        true,
        false,
    );
    compiler.module_mode.set(true);
    compiler.source.set(source);
    compiler.source_name.set(source_name);
    compiler.allow_unknown_globals.set(true);
    set_source_offset(compiler, program.span.start);
    let import_meta_index = match declare_current(
        compiler,
        IMPORT_META_BINDING,
        BindingKind::Const,
        program.span,
    ) {
        Some(value) => value.index,
        None => -1,
    };
    let dynamic_import_referrer_index = match declare_current(
        compiler,
        IMPORT_REFERRER_BINDING,
        BindingKind::Const,
        program.span,
    ) {
        Some(value) => value.index,
        None => -1,
    };
    collect_var_body(compiler, program.body);
    declare_lexical_body(compiler, program.body);
    let (imports, exports) = collect_module_metadata(compiler, program.body);
    initialize_var_bindings(compiler);
    compile_body(compiler, program.body);
    let _ = emit(compiler, bytecode::Instruction::ReturnUndef);
    let function = bytecode::Function::new_with_parameters_upvalues_and_handlers(
        compiler.constants,
        compiler.code,
        0,
        compiler.next_local.get(),
        Vec::new(),
        compiler.exception_handlers,
    );
    let mapped_arguments: Vec[isize] = Vec::new();
    function.set_arguments_semantics(true, mapped_arguments);
    function.set_asynchronous(compiler.used_await.get());
    function.set_eval_bindings(current_eval_bindings(compiler));
    function.set_eval_sites(compiler.eval_sites);
    function.set_source_locations(compiler.source_locations);
    function.set_source_name(js_string(compiler.source_name.get()));
    append_verifier_errors(compiler, function, program.span);
    if compiler.errors.is_empty() {
        Result::Ok(
            CompiledModule {
                function,
                imports,
                exports,
                import_meta_index,
                dynamic_import_referrer_index,
            },
        )
    } else {
        Result::Err(compiler.errors)
    }
}

fn push_script_binding(
    compiler: Compiler,
    bindings: Vec[bytecode::ScriptBinding],
    binding: bytecode::ScriptBinding,
) -> unit {
    let offset = compiler.global_declaration_offsets.get(binding.name).unwrap_or(-1);
    let mut index = 0;
    while index < bindings.len()
        && compiler.global_declaration_offsets.get(bindings[index].name).unwrap_or(-1) <= offset {
        index += 1;
    }
    bindings.insert(index, binding)
}

fn script_bindings(compiler: Compiler) -> Vec[bytecode::ScriptBinding] {
    let bindings: Vec[bytecode::ScriptBinding] = Vec::new();
    for (name, _) in compiler.global_lexical_indices.entries() {
        match compiler.scopes[0].bindings.get(name) {
            Some(binding) => push_script_binding(
                compiler,
                bindings,
                bytecode::ScriptBinding {
                    name,
                    kind: if binding.kind == BindingKind::Const {
                        bytecode::ScriptBindingKind::Const
                    } else {
                        bytecode::ScriptBindingKind::Let
                    },
                },
            ),
            None => (),
        }
    }
    for (name, kind) in compiler.global_var_kinds.entries() {
        push_script_binding(compiler, bindings, bytecode::ScriptBinding { name, kind })
    }
    bindings
}

fn compile_program_with_source(
    program: ast::Program,
    source: string,
    source_name: string,
    script_mode: bool,
) -> Result[bytecode::Function, Vec[CompileError]] {
    let strict = function_body_is_strict(program.body);
    let compiler = compiler_new(
        Vec::new(),
        Vec::new(),
        Option::None,
        false,
        false,
        false,
        false,
        false,
        strict,
        false,
        false,
        false,
    );
    compiler.script_mode.set(script_mode);
    compiler.source.set(source);
    compiler.source_name.set(source_name);
    compiler.allow_unknown_globals.set(true);
    set_source_offset(compiler, program.span.start);
    let completion = if script_mode {
        let value = new_local(compiler);
        compiler.completion_local.set(Option::Some(value));
        Option::Some(value)
    } else {
        Option::None
    };
    collect_var_body(compiler, program.body);
    declare_lexical_body(compiler, program.body);
    initialize_var_bindings(compiler);
    match completion {
        Some(value) => {
            let _ = emit(compiler, bytecode::Instruction::Undefined);
            let _ = emit(compiler, bytecode::Instruction::PutLoc(value));
        },
        None => (),
    };
    compile_body(compiler, program.body);
    match completion {
        Some(value) => {
            let _ = emit(compiler, bytecode::Instruction::GetLoc(value));
            let _ = emit(compiler, bytecode::Instruction::Return);
        },
        None => {
            let _ = emit(compiler, bytecode::Instruction::ReturnUndef);
        },
    };
    let eval_bindings = current_eval_bindings(compiler);
    let function = bytecode::Function::new_with_parameters_upvalues_and_handlers(
        compiler.constants,
        compiler.code,
        0,
        compiler.next_local.get(),
        Vec::new(),
        compiler.exception_handlers,
    );
    let mapped_arguments: Vec[isize] = Vec::new();
    function.set_arguments_semantics(strict, mapped_arguments);
    function.set_eval_bindings(eval_bindings);
    if script_mode {
        function.set_script_bindings(script_bindings(compiler))
    } else {};
    function.set_eval_sites(compiler.eval_sites);
    function.set_source_locations(compiler.source_locations);
    function.set_source_name(js_string(compiler.source_name.get()));
    append_verifier_errors(compiler, function, program.span);
    if compiler.errors.is_empty() {
        Result::Ok(function)
    } else {
        Result::Err(compiler.errors)
    }
}

pub fn compile_program(program: ast::Program) -> Result[bytecode::Function, Vec[CompileError]] {
    compile_program_with_source(program, "", "<input>", false)
}

pub fn compile(source: string) -> Result[bytecode::Function, Vec[CompileError]] {
    compile_with_source_name(source, "<input>")
}

pub fn compile_with_source_name(source: string, source_name: string) -> Result[
    bytecode::Function,
    Vec[CompileError],
] {
    let parsed = parser::parse(source);
    let errors: Vec[CompileError] = Vec::new();
    for error in parsed.errors {
        errors.push(CompileError { message: error.message, span: error.span })
    }
    match compile_program_with_source(parsed.program, source, source_name, false) {
        Ok(function) => if errors.is_empty() {
            Result::Ok(function)
        } else {
            Result::Err(errors)
        },
        Err(compile_errors) => {
            for error in compile_errors {
                errors.push(error)
            }
            Result::Err(errors)
        },
    }
}

pub fn compile_script(source: string) -> Result[bytecode::Function, Vec[CompileError]] {
    compile_script_with_source_name(source, "<input>")
}

pub fn compile_script_with_source_name(source: string, source_name: string) -> Result[
    bytecode::Function,
    Vec[CompileError],
] {
    let parsed = parser::parse(source);
    let errors: Vec[CompileError] = Vec::new();
    for error in parsed.errors {
        errors.push(CompileError { message: error.message, span: error.span })
    }
    match compile_program_with_source(parsed.program, source, source_name, true) {
        Ok(function) => if errors.is_empty() {
            Result::Ok(function)
        } else {
            Result::Err(errors)
        },
        Err(compile_errors) => {
            for error in compile_errors {
                errors.push(error)
            }
            Result::Err(errors)
        },
    }
}

pub fn compile_module(source: string) -> Result[CompiledModule, Vec[CompileError]] {
    compile_module_with_source_name(source, "<input>")
}

pub fn compile_module_with_source_name(source: string, source_name: string) -> Result[
    CompiledModule,
    Vec[CompileError],
] {
    let parsed = parser::parse_module(source);
    let errors: Vec[CompileError] = Vec::new();
    for error in parsed.errors {
        errors.push(CompileError { message: error.message, span: error.span })
    }
    match compile_module_program_with_source(parsed.program, source, source_name) {
        Ok(value) => if errors.is_empty() {
            Result::Ok(value)
        } else {
            Result::Err(errors)
        },
        Err(compile_errors) => {
            for error in compile_errors {
                errors.push(error)
            }
            Result::Err(errors)
        },
    }
}

pub fn source_is_module(source: string) -> bool {
    let parsed = parser::parse(source);
    for statement in parsed.program.body {
        match statement {
            ast::Stmt::ImportNamespace { .. } | ast::Stmt::ImportNamed { .. } | ast::Stmt::ImportSideEffect {
                ..,
            } | ast::Stmt::ExportNamed { .. } | ast::Stmt::ExportDeclaration { .. } | ast::Stmt::ExportDefault {
                ..,
            } | ast::Stmt::ExportAll { .. } | ast::Stmt::ExportNamespace { .. } => return true,
            _ => (),
        }
    }
    false
}

fn dynamic_parse_errors(value: parser::ParseResult) -> Vec[CompileError] {
    let errors: Vec[CompileError] = Vec::new();
    for error in value.errors {
        errors.push(CompileError { message: error.message, span: error.span })
    }
    errors
}

fn dynamic_function_prefix(kind: vm::FunctionKind) -> string {
    match kind {
        vm::FunctionKind::Ordinary => "function",
        vm::FunctionKind::Generator => "function*",
        vm::FunctionKind::Async => "async function",
        vm::FunctionKind::AsyncGenerator => "async function*",
    }
}

fn dynamic_parameters(kind: vm::FunctionKind, source: string) -> Result[
    Vec[ast::FunctionParameter],
    Vec[CompileError],
] {
    let parsed = parser::parse(dynamic_function_prefix(kind) + " anonymous(\n" + source + "\n) {}");
    let errors = dynamic_parse_errors(parsed);
    if !errors.is_empty() {
        return Result::Err(errors)
    } else {};
    if parsed.program.body.len() != 1 {
        return Result::Err(
            Vec::from_array(
                [
                    CompileError {
                        message: "invalid dynamic function parameters",
                        span: parsed.program.span,
                    },
                ],
            ),
        )
    } else {};
    match parsed.program.body[0] {
        ast::Stmt::FunctionDeclaration { name, parameters, body, generator, asynchronous, span } => if name
            == "anonymous"
            && body.is_empty()
            && generator
                == (kind == vm::FunctionKind::Generator || kind == vm::FunctionKind::AsyncGenerator)
            && asynchronous
                == (kind == vm::FunctionKind::Async || kind == vm::FunctionKind::AsyncGenerator) {
            Result::Ok(parameters)
        } else {
            Result::Err(
                Vec::from_array(
                    [CompileError { message: "invalid dynamic function parameters", span }],
                ),
            )
        },
        _ => Result::Err(
            Vec::from_array(
                [
                    CompileError {
                        message: "invalid dynamic function parameters",
                        span: parsed.program.span,
                    },
                ],
            ),
        ),
    }
}

fn dynamic_body(kind: vm::FunctionKind, source: string) -> Result[
    (Vec[ast::Stmt], ast::Span),
    Vec[CompileError],
] {
    let parsed = parser::parse(dynamic_function_prefix(kind) + " anonymous() {\n" + source + "\n}");
    let errors = dynamic_parse_errors(parsed);
    if !errors.is_empty() {
        return Result::Err(errors)
    } else {};
    if parsed.program.body.len() != 1 {
        return Result::Err(
            Vec::from_array(
                [
                    CompileError {
                        message: "invalid dynamic function body",
                        span: parsed.program.span,
                    },
                ],
            ),
        )
    } else {};
    match parsed.program.body[0] {
        ast::Stmt::FunctionDeclaration { name, parameters, body, generator, asynchronous, span } => if name
            == "anonymous"
            && parameters.is_empty()
            && generator
                == (kind == vm::FunctionKind::Generator || kind == vm::FunctionKind::AsyncGenerator)
            && asynchronous
                == (kind == vm::FunctionKind::Async || kind == vm::FunctionKind::AsyncGenerator) {
            Result::Ok((body, span))
        } else {
            Result::Err(
                Vec::from_array([CompileError { message: "invalid dynamic function body", span }]),
            )
        },
        _ => Result::Err(
            Vec::from_array(
                [
                    CompileError {
                        message: "invalid dynamic function body",
                        span: parsed.program.span,
                    },
                ],
            ),
        ),
    }
}

pub fn compile_dynamic_function(
    kind: vm::FunctionKind,
    parameter_source: string,
    body_source: string,
) -> Result[bytecode::Function, Vec[CompileError]] {
    let parameters = dynamic_parameters(kind, parameter_source)?;
    let (body, span) = dynamic_body(kind, body_source)?;
    let generator = kind == vm::FunctionKind::Generator || kind == vm::FunctionKind::AsyncGenerator;
    let asynchronous = kind == vm::FunctionKind::Async || kind == vm::FunctionKind::AsyncGenerator;
    let parent = compiler_new(
        Vec::new(),
        Vec::new(),
        Option::None,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
    );
    let function = compile_nested_function(
        parent,
        Option::Some("anonymous"),
        parameters,
        body,
        span,
        false,
        kind == vm::FunctionKind::Ordinary,
        false,
        false,
        false,
        false,
        generator,
        asynchronous,
    );
    function.set_definition_location(bytecode::SourceLocation { line: 1, column: 2 });
    function.set_source_text(
        js_string(
            dynamic_function_prefix(kind) + " anonymous(" + parameter_source + "\n) {\n"
                + body_source
                + "\n}",
        ),
    );
    if !parent.errors.is_empty() {
        Result::Err(parent.errors)
    } else {
        Result::Ok(
            bytecode::Function::new(
                Vec::from_array([bytecode::Constant::Function(Ref::new(function))]),
                Vec::from_array(
                    [bytecode::Instruction::PushConst(0), bytecode::Instruction::Return],
                ),
                0,
            ),
        )
    }
}

fn dynamic_function_compiler(kind: vm::FunctionKind, parameter_source: string, body_source: string) -> Result[
    bytecode::Function,
    string,
] {
    match compile_dynamic_function(kind, parameter_source, body_source) {
        Ok(value) => Result::Ok(value),
        Err(errors) => Result::Err(
            if errors.is_empty() {
                "invalid dynamic function source"
            } else {
                errors[0].message
            },
        ),
    }
}

fn compile_dynamic_eval(source: string, bindings: Vec[bytecode::EvalBinding]) -> Result[
    bytecode::Function,
    Vec[CompileError],
] {
    let parsed = parser::parse(source);
    let errors = dynamic_parse_errors(parsed);
    if !errors.is_empty() {
        return Result::Err(errors)
    } else {};
    let outer: Vec[OuterBinding] = Vec::new();
    let mut lexical_this = false;
    let mut lexical_arguments = false;
    let mut inherited_strict = false;
    let mut super_call_allowed = false;
    let mut super_property_allowed = false;
    for binding in bindings {
        if binding.name == "$this" {
            lexical_this = true;
        } else if binding.name == "$arguments" {
            lexical_arguments = true;
        } else if binding.name == "$strict" {
            inherited_strict = true;
        } else if binding.name == "$super_call" {
            super_call_allowed = true;
        } else if binding.name == "$super_property" {
            super_property_allowed = true;
        } else {};
        if binding.name == "$strict" || binding.name == "$super_call"
            || binding.name == "$super_property" {
            continue
        } else {};
        outer.push(
            OuterBinding {
                name: binding.name,
                source: binding.source,
                kind: if binding.named_function {
                    BindingKind::NamedFunction
                } else if binding.variable {
                    BindingKind::Var
                } else if binding.writable {
                    BindingKind::Let
                } else {
                    BindingKind::Const
                },
                declaration_target: binding.declaration_target,
                environment_depth: binding.environment_depth,
            },
        )
    }
    let strict = inherited_strict || function_body_is_strict(parsed.program.body);
    let compiler = compiler_new(
        Vec::new(),
        outer,
        Option::None,
        false,
        lexical_this,
        lexical_arguments,
        super_call_allowed,
        super_property_allowed,
        strict,
        false,
        false,
        false,
    );
    compiler.direct_eval.set(true);
    compiler.source.set(source);
    compiler.allow_unknown_globals.set(true);
    set_source_offset(compiler, parsed.program.span.start);
    let completion = new_local(compiler);
    compiler.completion_local.set(Option::Some(completion));
    collect_var_body(compiler, parsed.program.body);
    declare_lexical_body(compiler, parsed.program.body);
    initialize_var_bindings(compiler);
    let _ = emit(compiler, bytecode::Instruction::Undefined);
    let _ = emit(compiler, bytecode::Instruction::PutLoc(completion));
    compile_body(compiler, parsed.program.body);
    let _ = emit(compiler, bytecode::Instruction::GetLoc(completion));
    let _ = emit(compiler, bytecode::Instruction::Return);
    let nested_eval_bindings = current_eval_bindings(compiler);
    let eval_declarations = dynamic_eval_declarations(compiler);
    let sources: Vec[bytecode::UpvalueSource] = Vec::new();
    for upvalue in compiler.upvalues {
        sources.push(upvalue.source)
    }
    let function = bytecode::Function::new_with_parameters_upvalues_handlers_and_function_semantics(
        compiler.constants,
        compiler.code,
        0,
        0,
        compiler.next_local.get(),
        sources,
        compiler.exception_handlers,
        false,
        false,
        false,
        false,
        lexical_this,
    );
    let mapped_arguments: Vec[isize] = Vec::new();
    function.set_arguments_semantics(strict, mapped_arguments);
    function.set_eval_bindings(nested_eval_bindings);
    function.set_eval_declarations(eval_declarations);
    function.set_eval_sites(compiler.eval_sites);
    function.set_source_locations(compiler.source_locations);
    function.set_source_name(js_string(compiler.source_name.get()));
    append_verifier_errors(compiler, function, parsed.program.span);
    if compiler.errors.is_empty() {
        Result::Ok(function)
    } else {
        Result::Err(compiler.errors)
    }
}

fn dynamic_eval_compiler(source: string, bindings: Vec[bytecode::EvalBinding]) -> Result[
    bytecode::Function,
    bytecode::SourceError,
] {
    match compile_dynamic_eval(source, bindings) {
        Ok(value) => Result::Ok(value),
        Err(errors) => if errors.is_empty() {
            Result::Err(
                bytecode::SourceError {
                    message: "invalid eval source",
                    location: bytecode::SourceLocation { line: 1, column: 1 },
                },
            )
        } else {
            Result::Err(
                bytecode::SourceError {
                    message: errors[0].message,
                    location: source_location(source, errors[0].span.start),
                },
            )
        },
    }
}

fn dynamic_script_compiler(source: string, source_name: string) -> Result[
    bytecode::Function,
    bytecode::SourceError,
] {
    match compile_script_with_source_name(source, source_name) {
        Ok(value) => Result::Ok(value),
        Err(errors) => if errors.is_empty() {
            Result::Err(
                bytecode::SourceError {
                    message: "invalid Script source",
                    location: bytecode::SourceLocation { line: 1, column: 1 },
                },
            )
        } else {
            Result::Err(
                bytecode::SourceError {
                    message: errors[0].message,
                    location: source_location(source, errors[0].span.start),
                },
            )
        },
    }
}

pub fn install_dynamic_function_compiler(context: vm::Context) -> unit {
    context.set_dynamic_function_compiler(dynamic_function_compiler);
    context.set_dynamic_eval_compiler(dynamic_eval_compiler);
    context.set_dynamic_script_compiler(dynamic_script_compiler)
}
