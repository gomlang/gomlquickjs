        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected prototype operator result"),
    }
    match execute_source_with_builtins(
        "try { return 'x' in 1; } catch (error) { return error instanceof TypeError; }",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected in operand TypeError"),
    }
    match execute_source_with_builtins(
        "try { return {} instanceof {}; } catch (error) { return error instanceof TypeError; }",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected instanceof operand TypeError"),
    }
}

#[test]
fn inherits_object_prototype_and_preserves_null_prototypes() -> () {
    match execute_source_with_builtins(
        "let object = {own: 1}; let child = Object.create(object); child.visible = 2; let empty = Object.create(null); function callable() {} return Object.getPrototypeOf(object) === Object.prototype && object instanceof Object && callable instanceof Object && [] instanceof Object && Object.prototype.isPrototypeOf(child) && child.hasOwnProperty('visible') && !child.hasOwnProperty('own') && child.propertyIsEnumerable('visible') && object.toString() === '[object Object]' && empty.toString === undefined;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Object prototype result"),
    }
}

#[test]
fn distinguishes_native_constructors_from_plain_native_functions() -> () {
    match execute_source_with_builtins(
        "let map = new Map(); map.set('answer', 42); let error = new TypeError('broken'); return map.get('answer') === 42 && error.name === 'TypeError';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected native construction result"),
    }
    match execute_source_with_builtins(
        "try { new Symbol('x'); } catch (error) { return error instanceof TypeError; } return false;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected non-constructor TypeError"),
    }
}

#[test]
fn bigint_source_errors_remain_recoverable() -> () {
    for source in Vec::from_array(["return 1n + 1;", "return 1n / 0n;", "return 2n ** -1n;"]) {
        let function = expect_function(compile(source));
        match vm::execute(function, runtime::Heap::new()) {
            Err(vm::VmError { kind: vm::VmErrorKind::TypeError(_), .. }) => {
                testing::assert_eq(source, "return 1n + 1;")
            },
            Err(vm::VmError { kind: vm::VmErrorKind::RangeError(_), .. }) => {
                testing::assert(source != "return 1n + 1;")
            },
            _ => testing::fail("expected recoverable BigInt execution error"),
        }
    }
}

#[test]
fn reports_scope_and_assignment_errors_without_panicking() -> () {
    match compile("let value = 1; let value = 2; missing; const fixed = 3; fixed = 4;") {
        Err(errors) => {
            testing::assert(has_message(errors, "duplicate declaration"));
            for error in errors {
                testing::assert(error.span.start >= 0);
                testing::assert(error.span.end >= error.span.start)
            }
        },
        Ok(_) => testing::fail("expected compile diagnostics"),
    }
}

#[test]
fn source_locations_follow_utf16_columns_for_nested_functions_and_operators() -> () {
    let function = expect_function(
        compile("\nfunction f(poisoned) { return 1 + \"café\" * poisoned; }\nf;"),
    );
    let nested = match function.constant(0) {
        Some(bytecode::Constant::Function(value)) => value.get(),
        _ => {
            testing::fail("expected nested function constant");
            bytecode::Function::new(
                Vec::new(),
                Vec::from_array([bytecode::Instruction::ReturnUndef]),
                0,
            )
        },
    };
    match nested.definition_location() {
        Some(location) => {
            testing::assert_eq(location.line, 2);
            testing::assert_eq(location.column, 1)
        },
        None => testing::fail("expected function definition location"),
    }
    let mut found = false;
    let mut offset = 0;
    while offset < nested.code_len() {
        match nested.instruction(offset) {
            Some(bytecode::Instruction::Mul) => match nested.source_location(offset) {
                Some(location) => {
                    testing::assert_eq(location.line, 2);
                    testing::assert_eq(location.column, 42);
                    found = true;
                },
                None => testing::fail("expected multiplication source location"),
            },
            _ => (),
        }
        offset += 1;
    }
    testing::assert(found)
}

#[test]
fn source_locations_handle_crlf_and_utf16_columns() -> () {
    let second_line = source_location("😀x\r\néy", 7);
    testing::assert_eq(second_line.line, 2);
    testing::assert_eq(second_line.column, 1);
    let after_wide = source_location("😀x\r\néy", 9);
    testing::assert_eq(after_wide.line, 2);
    testing::assert_eq(after_wide.column, 2);
    let after_cr = source_location("a\rb", 2);
    testing::assert_eq(after_cr.line, 2);
    testing::assert_eq(after_cr.column, 1)
}

#[test]
fn eval_errors_expose_runtime_and_parse_source_positions() -> () {
    let runtime_stack = execute_source_with_builtins(
        "try { eval(\"\\n  null.x\"); } catch (error) { return error.stack; }",
    );
    match runtime_stack {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert(text::starts_with_at(value, 0, "    at <input>:2:7")),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected runtime error stack"),
    }
    let syntax_stack = execute_source_with_builtins(
        "try { eval(\"\\n  123 a\"); } catch (error) { return error.stack; }",
    );
    expect_string(syntax_stack, "    at <input>:2:7")
}

#[test]
fn nested_error_stacks_preserve_call_site_locations() -> () {
    let stack = execute_source_with_builtins(
        "function inner() {\n  return null.value;\n}\nfunction outer() {\n  return inner();\n}\ntry {\n  outer();\n} catch (error) {\n  return error.stack;\n}",
    );
    expect_string(stack, "    at <input>:2:14\n    at <input>:5:15\n    at <input>:8:8")
}

#[test]
fn eval_accepts_unpaired_surrogates_inside_comments() -> () {
    match execute_source_with_builtins(
        "let value = 0; eval('//comment' + String.fromCharCode(0xd800) + '\\nvalue = 1'); eval('/*comment' + String.fromCharCode(0xdc00) + '*/'); return value;",
    ) {
        runtime::Value::Int(value) => testing::assert_eq(value, 1),
        _ => testing::fail("expected eval comment result"),
    }
}

#[test]
fn direct_eval_accepts_spread_arguments_and_with_calls_preserve_the_base_object() -> () {
    match execute_source_with_builtins(
        "function direct() { var value = 'local'; eval(...['value = 1']); return value; } let receiver; let object = { eval: function() { receiver = this; return 9; }, method: function() { receiver = this; } }; let result; with (object) { result = eval(...[]); method(); } return direct() === 1 && result === 9 && receiver === object;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected eval spread and with call result"),
    }
}

#[test]
fn assignment_and_computed_property_names_follow_named_evaluation() -> () {
    match execute_source_with_builtins(
        "let identifier; identifier ??= function() {}; let member = {}; member.value = function() {}; let described = Symbol('named'); let anonymousClass = Symbol(); let anonymousAccessor = Symbol(); let object = {[described]: function() {}, [anonymousClass]: class {}, *[described]() {}, get [anonymousAccessor]() { return 1; }}; let descriptor = Object.getOwnPropertyDescriptor(object, anonymousAccessor); return identifier.name === 'identifier' && member.value.name === '' && object[described].name === '[named]' && object[anonymousClass].name === '' && descriptor.get.name === 'get ';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected named evaluation result"),
    }
}

#[test]
fn assignments_preserve_the_reference_selected_before_direct_eval() -> () {
    match execute_source_with_builtins(
        "function run() { var value = 3; var inner = (function() { value *= (eval('var value = 2;'), 4); return value; })(); return inner === 2 && value === 12; } function assign() { var value = 0; var inner = (function() { value = (eval('var value;'), 1); return value; })(); return inner === undefined && value === 1; } return run() && assign();",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected captured assignment references"),
    }
}

#[test]
fn simple_computed_assignment_defers_reference_validation_until_after_the_rhs() -> () {
    match execute_source_with_builtins(
        "let token = {}; let first = false; let second = false; try { let base = null; base[(() => { throw token; })()] = (() => { throw 1; })(); } catch (error) { first = error === token; } try { let base = null; let key = {toString() { throw 1; }}; base[key] = (() => { throw token; })(); } catch (error) { second = error === token; } return first && second;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected deferred computed assignment validation"),
    }
}

#[test]
fn super_references_capture_the_base_and_respect_write_strictness() -> () {
    match execute_source_with_builtins(
        "let result = ''; let first = {set value(_) { result = 'first'; }}; let second = {set value(_) { result = 'second'; }}; let object = {__proto__: first, method() { super[key] = 1; }}; let key = {toString() { Object.setPrototypeOf(object, second); return 'value'; }}; object.method(); let sloppy = {method() { super.blocked = 1; }}; Object.freeze(sloppy); sloppy.method(); let nullError = false; let empty = {method() { try { super.missing; } catch (error) { nullError = error instanceof TypeError; } }}; Object.setPrototypeOf(empty, null); empty.method(); return result === 'first' && !Object.hasOwn(sloppy, 'blocked') && nullError;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected captured super reference result"),
    }
}

#[test]
fn super_assignment_validates_a_null_base_after_evaluating_the_rhs() -> () {
    match execute_source_with_builtins(
        "let count = 0; class C { static identifier() { try { super.value = count += 1; } catch (error) { if (!(error instanceof TypeError)) throw error; } } static computed() { try { super[0] = count += 1; } catch (error) { if (!(error instanceof TypeError)) throw error; } } } Object.setPrototypeOf(C, null); C.identifier(); C.computed(); return count === 2;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected deferred null super assignment validation"),
    }
}

#[test]
fn const_compound_assignment_and_update_throw_at_runtime() -> () {
    expect_int(
        execute_source_with_builtins(
            "const fixed = 1; let caught = 0; try { fixed += 2; } catch (error) { if (error instanceof TypeError) caught++; } try { fixed++; } catch (error) { if (error instanceof TypeError) caught++; } return caught;",
        ),
        2,
    )
}

#[test]
fn reports_parser_and_invalid_target_errors_together() -> () {
    match compile("const = ; (1 + 2) = 3; tail;") {
        Err(errors) => {
            testing::assert(errors.len() >= 3);
            testing::assert(has_message(errors, "expected variable name"));
            testing::assert(
                has_message(errors, "invalid assignment target")
                    || has_message(errors, "invalid assignment left-hand side"),
            )
        },
        Ok(_) => testing::fail("expected recoverable diagnostics"),
    }
}

#[test]
fn compiles_for_continue_and_break_end_to_end() -> () {
    expect_int(
        execute_source(
            "let total = 0; for (let i = 0; i < 10; i = i + 1) { if (i == 2) continue; if (i == 5) break; total = total + i; } return total;",
        ),
        8,
    )
}

#[test]
fn compiles_labelled_break_and_continue_targets() -> () {
    expect_int(
        execute_source(
            "let count = 0; outer: for (let i = 0; i < 4; i++) { for (let j = 0; j < 4; j++) { count++; if (j === 0) continue outer; } } return count;",
        ),
        4,
    );
    expect_int(
        execute_source(
            "let count = 0; outer: while (true) { while (true) { count++; break outer; } } return count;",
        ),
        1,
    );
    expect_int(
        execute_source("let value = 1; block: { value = 2; break block; value = 3; } return value;"),
        2,
    );
    expect_int(
        execute_source(
            "let i = 0; while (i < 3) label: { i++; if (i > 0) break; } for (;;) label: break; return i;",
        ),
        1,
    )
}

#[test]
fn direct_eval_inherits_new_target_and_super_context() -> () {
    match execute_source_with_builtins(
        "function F() { return (() => eval('new.target'))(); } let newTarget = new F() === F && F() === undefined; let base = { f() { return this; } }; let derived = { f() { return (() => eval('super.f()'))(); } }; derived.__proto__ = base; return newTarget && derived.f() === derived;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected eval lexical context result"),
    }
}

#[test]
fn dynamic_eval_declarations_preserve_source_order_and_kind() -> () {
    let function = match compile_dynamic_eval(
        js_string(
            "function first() {} if (true) { var second; } var repeated; function repeated() {}",
        ),
        Vec::new(),
    ) {
        Ok(value) => value,
        Err(errors) => {
            if errors.is_empty() {
                testing::fail("dynamic eval compilation failed")
            } else {
                testing::fail(errors[0].message)
            }
            return
        },
    };
    let declarations = function.eval_declarations();
    testing::assert_eq(declarations.len(), 4);
    testing::assert_eq(declarations[0].name, "first");
    testing::assert_eq(declarations[0].kind, bytecode::EvalDeclarationKind::Function);
    testing::assert_eq(declarations[1].name, "second");
    testing::assert_eq(declarations[1].kind, bytecode::EvalDeclarationKind::Var);
    testing::assert_eq(declarations[2].name, "repeated");
    testing::assert_eq(declarations[2].kind, bytecode::EvalDeclarationKind::Var);
    testing::assert_eq(declarations[3].name, "repeated");
    testing::assert_eq(declarations[3].kind, bytecode::EvalDeclarationKind::Function);
    let strict = match compile_dynamic_eval(
        js_string("'use strict'; var local; function localFunction() {}"),
        Vec::new(),
    ) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("strict dynamic eval compilation failed");
            return
        },
    };
    testing::assert(strict.eval_declarations().is_empty())
}

#[test]
fn global_dynamic_eval_instantiation_follows_property_descriptor_rules_atomically() -> () {
    match execute_source_with_builtins(
        "let setterCalls = 0; Object.defineProperty(globalThis, 'evalFunction', {set: function(value) { setterCalls += 1; }, enumerable: false, configurable: true}); eval('function evalFunction() { return 42; }'); let functionDescriptor = Object.getOwnPropertyDescriptor(globalThis, 'evalFunction'); let replacedAccessor = setterCalls === 0 && evalFunction() === 42 && functionDescriptor.value === evalFunction && functionDescriptor.writable && functionDescriptor.enumerable && functionDescriptor.configurable; Object.defineProperty(globalThis, 'allowedData', {value: 1, writable: true, enumerable: true, configurable: false}); eval('function allowedData() { return 7; }'); let allowedDescriptor = Object.getOwnPropertyDescriptor(globalThis, 'allowedData'); let allowedDataResult = allowedData() === 7 && allowedDescriptor.writable && allowedDescriptor.enumerable && !allowedDescriptor.configurable; Object.defineProperty(globalThis, 'hiddenData', {value: 1, writable: true, enumerable: false, configurable: false}); Object.defineProperty(globalThis, 'readonlyData', {value: 1, writable: false, enumerable: true, configurable: false}); let hiddenRejected = false; let readonlyRejected = false; try { eval('function hiddenData() {}'); } catch (error) { hiddenRejected = error instanceof TypeError; } try { eval('function readonlyData() {}'); } catch (error) { readonlyRejected = error instanceof TypeError; } let accessorVarSets = 0; Object.defineProperty(globalThis, 'accessorVar', {set: function(value) { accessorVarSets += 1; }, configurable: false}); eval('var accessorVar;'); let varPreserved = accessorVarSets === 0 && Object.getOwnPropertyDescriptor(globalThis, 'accessorVar').set !== undefined; Object.defineProperty(globalThis, 'blockedFunction', {get: function() { return 1; }, configurable: false}); let accessorRejected = false; try { eval('function blockedFunction() {}'); } catch (error) { accessorRejected = error instanceof TypeError; } let stagedGetter = function() { return 9; }; Object.defineProperty(globalThis, 'stagedFunction', {get: stagedGetter, configurable: true}); Object.preventExtensions(globalThis); let atomicRejected = false; try { eval('function stagedFunction() {}; var missingEvalVariable;'); } catch (error) { atomicRejected = error instanceof TypeError; } let stagedDescriptor = Object.getOwnPropertyDescriptor(globalThis, 'stagedFunction'); return replacedAccessor && allowedDataResult && hiddenRejected && readonlyRejected && varPreserved && accessorRejected && atomicRejected && stagedDescriptor.get === stagedGetter && !Object.hasOwn(globalThis, 'missingEvalVariable');",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected global eval declaration instantiation result"),
    }
}

#[test]
fn indirect_global_eval_uses_atomic_declaration_instantiation() -> () {
    match execute_source_with_builtins(
        "let indirectEval = eval; let setterCalls = 0; Object.defineProperty(globalThis, 'indirectFunction', {set: function(value) { setterCalls += 1; }, configurable: true}); indirectEval('function indirectFunction() { return 8; }'); let replaced = setterCalls === 0 && indirectFunction() === 8 && Object.getOwnPropertyDescriptor(globalThis, 'indirectFunction').configurable; let stagedGetter = function() { return 1; }; Object.defineProperty(globalThis, 'indirectStaged', {get: stagedGetter, configurable: true}); Object.preventExtensions(globalThis); let rejected = false; try { indirectEval('function indirectStaged() {}; var indirectMissing;'); } catch (error) { rejected = error instanceof TypeError; } let descriptor = Object.getOwnPropertyDescriptor(globalThis, 'indirectStaged'); return replaced && rejected && descriptor.get === stagedGetter && !Object.hasOwn(globalThis, 'indirectMissing');",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected indirect global eval instantiation result"),
    }
}

#[test]
fn direct_function_eval_instantiates_bindings_without_global_property_checks() -> () {
    match execute_source_with_builtins(
