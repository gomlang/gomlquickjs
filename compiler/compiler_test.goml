    }
}

#[test]
fn creates_per_iteration_bindings_for_loop_closures_and_direct_eval() -> () {
    match execute_source_with_builtins(
        "let classic = []; for (let i = 0; i < 3; i++) { classic.push(function() { return i; }); } let iterated = []; for (const value of [10, 20, 30]) { iterated.push(() => value); } let evaluated = []; for (let i = 0; i < 3; i++) { eval('evaluated.push(function() { return i; })'); } let continued = []; for (let i = 0; i < 3; i++) { if (i === 1) continue; continued.push(() => i); } return classic[0]() === 0 && classic[1]() === 1 && classic[2]() === 2 && iterated[0]() === 10 && iterated[1]() === 20 && iterated[2]() === 30 && evaluated[0]() === 0 && evaluated[1]() === 1 && evaluated[2]() === 2 && continued[0]() === 0 && continued[1]() === 2;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected per-iteration closure bindings"),
    }
}

