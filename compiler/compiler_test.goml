#[test]
fn promise_static_capabilities_use_the_receiver_constructor() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let calls = []; function Custom(executor) { calls.push('construct'); executor(value => calls.push('resolve:' + value), value => calls.push('reject:' + value)); } let resolved = Promise.resolve.call(Custom, 7); let rejected = Promise.reject.call(Custom, 8); let tried = Promise.try.call(Custom, (a, b) => a + b, 4, 5); let record = Promise.withResolvers.call(Custom); record.resolve(10); record.reject(11); let marker = {}; function Throwing(executor) { executor(() => { throw marker; }, function() {}); } let propagated = false; try { Promise.resolve.call(Throwing, 1); } catch (error) { propagated = error === marker; } return resolved instanceof Custom && rejected instanceof Custom && tried instanceof Custom && record.promise instanceof Custom && calls.join(',') === 'construct,resolve:7,construct,reject:8,construct,resolve:9,construct,resolve:10,reject:11' && propagated;",
        ),
        true,
    )
}

#[test]
fn promise_prototype_methods_use_then_and_species_protocols() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let marker = {}; let rejected = function() {}; let catchArgs; let generic = {then(first, second) { catchArgs = [this, first, second]; return marker; }}; let caught = Promise.prototype.catch.call(generic, rejected); let finallyArgs; let finalized = Promise.prototype.finally.call({constructor: Promise, then(first, second) { finallyArgs = [first, second]; return marker; }}, 7); let resolve; let source = new Promise(value => resolve = value); let calls = []; function Custom(executor) { executor(value => calls.push('resolve:' + value), value => calls.push('reject:' + value)); } Object.defineProperty(source, 'constructor', {value: {[Symbol.species]: Custom}}); let child = source.then(value => value + 1); resolve(4); Promise.drainJobs(); return caught === marker && catchArgs[0] === generic && catchArgs[1] === undefined && catchArgs[2] === rejected && finalized === marker && finallyArgs[0] === 7 && finallyArgs[1] === 7 && child instanceof Custom && calls.join(',') === 'resolve:5';",
        ),
        true,
    )
}

#[test]
fn promise_resolution_observes_overridden_then_methods() -> () {
