    match execute_source_with_builtins(
        "let numeric = Float64Array.of(NaN, 10, -0, 2, 0, -5); let identity = numeric.sort() === numeric; let numericOrder = numeric[0] === -5 && 1 / numeric[1] === -Infinity && 1 / numeric[2] === Infinity && numeric[3] === 2 && numeric[4] === 10 && Number.isNaN(numeric[5]); let descending = Int16Array.of(2, 10, 1).sort((left, right) => right - left); let big = BigInt64Array.of(10n, -2n, 3n).sort(); class Derived extends Uint8Array {} Object.defineProperty(Derived, Symbol.species, {value: Uint16Array}); let source = new Derived([3, 1, 2]); let reversed = source.toReversed(); let sorted = source.toSorted(); let changed = source.with(-1, 9); let intrinsic = reversed.constructor === Uint8Array && sorted.constructor === Uint8Array && changed.constructor === Uint8Array && !(reversed instanceof Derived) && !(reversed instanceof Uint16Array); let rangeFailed = false; let typeFailed = false; try { source.with(3, 0); } catch (error) { rangeFailed = error instanceof RangeError; } try { BigInt64Array.of(1n).with(0, 1); } catch (error) { typeFailed = error instanceof TypeError; } return identity && numericOrder && Array.from(descending).join(',') === '10,2,1' && Array.from(big).join(',') === '-2,3,10' && intrinsic && Array.from(source).join(',') === '3,1,2' && Array.from(reversed).join(',') === '2,1,3' && Array.from(sorted).join(',') === '1,2,3' && Array.from(changed).join(',') === '3,1,9' && rangeFailed && typeFailed && source.sort.length === 1 && source.toSorted.length === 1 && source.toReversed.length === 0 && source.with.length === 2;",
