#[test]
fn rejects_invalid_regexp_literals_as_early_errors() -> () {
    for source in Vec::from_array(
        [
            "return /a/gg;",
            "return /(/;",
            "return /(?<present>a)\\k/;",
            "return /\\k(?<present>a)/;",
            "return /[\\d-a]/u;",
            "return /[\\s-\\d]/u;",
        ],
    ) {
        match compile(source) {
            Err(errors) => {
                testing::assert(!errors.is_empty());
                testing::assert(errors[0].message.contains("invalid regular expression"))
            },
            Ok(_) => testing::fail("expected invalid RegExp literal diagnostic"),
        }
    }
}

#[test]
fn compiles_function_expressions_and_higher_order_calls() -> () {
    expect_int(
        execute_source(
            "let apply = function(callback, value) { return callback(value); }; let identity = function(value) { return value; }; return apply(identity, 17);",
        ),
        17,
    )
}

#[test]
fn compiles_nested_non_capturing_functions_and_local_bindings() -> () {
    expect_int(
        execute_source(
            "function outer(value) { function twice(input) { let result = input * 2; return result; } return twice(value); } return outer(9);",
        ),
        18,
    )
}

#[test]
fn captures_outer_parameters_and_mutable_lexical_bindings() -> () {
    expect_int(
        execute_source(
            "function make(start) { let value = start; function next() { value = value + 1; return value; } function read() { return value; } return function(advance) { if (advance) return next(); return read(); }; } let first = make(10); let second = make(20); return first(true) * 1000000 + first(false) * 10000 + second(true) * 100 + second(false);",
        ),
        11112121,
    )
}

#[test]
fn transfers_captures_across_nested_functions() -> () {
    expect_int(
        execute_source(
            "function outer(value) { return function() { return function() { value = value + 1; return value; }; }; } let middle = outer(5); let inner = middle(); return inner() + inner() * 10;",
        ),
        76,
    )
}

#[test]
fn captures_var_and_block_lexical_bindings_after_scope_exit() -> () {
    expect_int(
        execute_source(
            "function make() { var closure; { let value = 8; closure = function() { value = value + 1; return value; }; } return closure; } let next = make(); return next() * 10 + next();",
        ),
        100,
    )
}

#[test]
fn compiles_recursive_declarations_and_named_function_expressions() -> () {
    expect_int(
        execute_source(
            "function factorial(value) { if (value < 2) return 1; return value * factorial(value - 1); } let fibonacci = function recur(value) { if (value < 2) return value; return recur(value - 1) + recur(value - 2); }; return factorial(5) + fibonacci(8);",
        ),
        141,
    );
    expect_int(
        execute_source(
            "function original(value) { if (value < 1) return 0; return original(value - 1) + 1; } let saved = original; original = function() { return 100; }; return saved(2);",
        ),
        101,
    )
}

