#[test]
fn named_source_functions_expose_names_and_bind_prefixes() -> () {
    match execute_source_with_builtins(
        "function declared(first, second) {} function defaults(callback = function() {}) { return callback.name; } let expression = function internal() {}; let inferred = function() {}; let arrow = () => 1; let Box = class {}; let assigned; assigned = function() {}; let holder = {}; holder.task = () => 1; let object = {method() {}, get value() { return 1; }, set value(input) {}}; class Methods { method() {} get value() { return 1; } set value(input) {} static make() {} } let objectValue = Object.getOwnPropertyDescriptor(object, 'value'); let classValue = Object.getOwnPropertyDescriptor(Methods.prototype, 'value'); let bound = declared.bind(null, 1); let descriptor = Object.getOwnPropertyDescriptor(declared, 'name'); return declared.name === 'declared' && expression.name === 'internal' && inferred.name === 'inferred' && arrow.name === 'arrow' && Box.name === 'Box' && assigned.name === 'assigned' && holder.task.name === '' && defaults() === 'callback' && object.method.name === 'method' && objectValue.get.name === 'get value' && objectValue.set.name === 'set value' && Methods.name === 'Methods' && Methods.prototype.method.name === 'method' && classValue.get.name === 'get value' && classValue.set.name === 'set value' && Methods.make.name === 'make' && bound.name === 'bound declared' && bound.length === 1 && descriptor.value === 'declared' && !descriptor.writable && !descriptor.enumerable && descriptor.configurable;",
