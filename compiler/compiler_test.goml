        execute_source_with_builtins(
            "let object = new Proxy({}, {ownKeys() { return ['a', 'b']; }, getOwnPropertyDescriptor() { return {enumerable: true, configurable: true}; }, get(target, key) { return key === 'a' ? 1 : 2; }}); let number = new Number(1); number.valueOf = function() { return 3; }; let string = new String('x'); string.toString = function() { return 'y'; }; let token = {}; let arrayAbrupt = false; let array = new Proxy([], {get(target, key) { if (key === 'length') throw token; return target[key]; }}); try { JSON.stringify(array); } catch (error) { arrayAbrupt = error === token; } let reviveAbrupt = false; let bad = new Proxy({a: 1}, {ownKeys() { throw token; }}); try { JSON.parse('[0,0]', function(key, value) { if (key === '0') this[1] = bad; return value; }); } catch (error) { reviveAbrupt = error === token; } return JSON.stringify(object) === '{\"a\":1,\"b\":2}' && JSON.stringify(number) === '3' && JSON.stringify(string) === '\"y\"' && arrayAbrupt && reviveAbrupt;",
        ),
        true,
    )
}

