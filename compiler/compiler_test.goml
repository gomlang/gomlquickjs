#[test]
fn import_meta_requires_module_compilation() -> () {
    match compile("return import.meta;") {
        Ok(_) => testing::fail("expected import.meta module diagnostic"),
        Err(errors) => {
            testing::assert(has_message(errors, "import.meta is only valid in module code"))
        },
    }
    match compile_module("export const meta = import.meta;") {
        Ok(value) => {
            testing::assert(value.import_meta_index >= 0);
            testing::assert(!value.function.asynchronous())
        },
        Err(_) => testing::fail("expected import.meta module compilation"),
    }
    match compile_module("export const value = await Promise.resolve(42);") {
        Ok(value) => testing::assert(value.function.asynchronous()),
        Err(_) => testing::fail("expected top-level await module compilation"),
    }
}

#[test]
fn script_global_lexicals_persist_with_tdz_const_closures_and_context_isolation() -> () {
    let context = script_test_context();
    match execute_script_source(
        context,
        "let hidden = 40; const fixed = 2; function read() { return hidden + fixed; } class Box { value() { return hidden; } }",
    ) {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    expect_int(execute_script_source(context, "read();").unwrap_or(runtime::Value::Undefined), 42);
    expect_int(
        execute_script_source(context, "hidden = 41; read();").unwrap_or(runtime::Value::Undefined),
        43,
    );
    expect_int(
        execute_script_source(context, "new Box().value();").unwrap_or(runtime::Value::Undefined),
        41,
    );
    match context.global_object() {
        Some(global) => match context.heap().get(global) {
            Some(value) => testing::assert(
                value.own_property(runtime::string_property_key("hidden")).is_none(),
            ),
            None => testing::fail("missing global object"),
        },
        None => testing::fail("missing global object"),
    }
    match execute_script_source(context, "fixed = 3;") {
        Err(vm::VmError { kind: vm::VmErrorKind::TypeError(_), .. }) => (),
        _ => testing::fail("expected const assignment TypeError"),
    }
    match execute_script_source(context, "delete hidden;") {
        Ok(runtime::Value::Bool(value)) => testing::assert(!value),
        _ => testing::fail("expected nondeletable lexical binding"),
    }
    match execute_script_source(context, "before; let before = 1;") {
        Err(vm::VmError { kind: vm::VmErrorKind::ReferenceError(_), .. }) => (),
        _ => testing::fail("expected global lexical TDZ ReferenceError"),
    }
    match execute_script_source(context, "let pending = missingInitializer();") {
        Err(vm::VmError { kind: vm::VmErrorKind::ReferenceError(_), .. }) => (),
        _ => testing::fail("expected failing lexical initializer"),
    }
    match execute_script_source(context, "typeof pending;") {
        Err(vm::VmError { kind: vm::VmErrorKind::ReferenceError(_), .. }) => (),
        _ => testing::fail("expected persistent uninitialized lexical binding"),
    }
    match execute_script_source(context, "var earlier; let hidden;") {
        Err(vm::VmError { kind: vm::VmErrorKind::SyntaxError(_), .. }) => (),
        _ => testing::fail("expected cross-Script declaration conflict"),
    }
    match context.global_object() {
        Some(global) => match context.heap().get(global) {
            Some(value) => testing::assert(
                value.own_property(runtime::string_property_key("earlier")).is_none(),
            ),
            None => testing::fail("missing global object"),
        },
        None => testing::fail("missing global object"),
    }
    match execute_script_source(
        context,
        "let rooted = {value: 9}; function rootedValue() { return rooted.value; }",
    ) {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    let _ = context.collect_garbage();
    expect_int(
        execute_script_source(context, "rootedValue();").unwrap_or(runtime::Value::Undefined),
        9,
    );
    let isolated = script_test_context();
    expect_string(
        execute_script_source(isolated, "typeof hidden;").unwrap_or(runtime::Value::Undefined),
        "undefined",
    )
}

#[test]
fn eval_script_persists_lexicals_while_indirect_and_shadowed_eval_do_not() -> () {
    let context = script_test_context();
    match execute_script_source(context, "std.evalScript('let persisted = 40; persisted + 2');") {
        Ok(value) => expect_int(value, 42),
        Err(value) => testing::fail(value.kind.debug()),
    }
    expect_int(
        execute_script_source(context, "std.evalScript('persisted');").unwrap_or(
            runtime::Value::Undefined,
        ),
        40,
    );
    expect_int(
        execute_script_source(context, "std.evalScript({toString() { return '6 * 7'; }});").unwrap_or(
            runtime::Value::Undefined,
        ),
        42,
    );
    expect_string(
        execute_script_source(
            context,
            "(0, eval)('let transient = 1; transient'); (0, eval)('typeof transient');",
        ).unwrap_or(runtime::Value::Undefined),
        "undefined",
    );
    match execute_script_source(context, "let eval = function() { return 7; };") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    expect_int(
        execute_script_source(context, "eval('var leaked = 1');").unwrap_or(
            runtime::Value::Undefined,
        ),
        7,
    );
    expect_string(
        execute_script_source(context, "typeof leaked;").unwrap_or(runtime::Value::Undefined),
        "undefined",
    );
    let skipped = script_test_context();
    expect_string(
        execute_script_source(skipped, "if (false) eval('var ghost'); typeof ghost;").unwrap_or(
            runtime::Value::Undefined,
        ),
        "undefined",
    );
    match skipped.global_object() {
        Some(global) => match skipped.heap().get(global) {
            Some(value) => testing::assert(
                value.own_property(runtime::string_property_key("ghost")).is_none(),
            ),
            None => testing::fail("missing global object"),
        },
        None => testing::fail("missing global object"),
    }
    let replaced = script_test_context();
    expect_int(
        execute_script_source(
            replaced,
            "globalThis.eval = function() { return 8; }; eval('var replacedLeak = 1');",
        ).unwrap_or(runtime::Value::Undefined),
        8,
    );
    expect_string(
        execute_script_source(replaced, "typeof replacedLeak;").unwrap_or(runtime::Value::Undefined),
        "undefined",
    );
    let with_shadow = script_test_context();
    expect_int(
        execute_script_source(
            with_shadow,
            "let withResult = 0; with ({eval: function() { return 9; }}) { withResult = eval('var withLeak = 1'); } withResult;",
        ).unwrap_or(runtime::Value::Undefined),
        9,
    );
    expect_string(
        execute_script_source(with_shadow, "typeof withLeak;").unwrap_or(runtime::Value::Undefined),
        "undefined",
    );
    let nested_shadow = script_test_context();
    expect_int(
        execute_script_source(
            nested_shadow,
            "let eval = function() { return 0; }; function write() { eval('var phantom'); phantom = 1; return phantom; } write();",
        ).unwrap_or(runtime::Value::Undefined),
        1,
    );
    expect_int(
        execute_script_source(nested_shadow, "globalThis.phantom;").unwrap_or(
            runtime::Value::Undefined,
        ),
        1,
    )
}

#[test]
fn script_var_and_function_descriptors_follow_global_instantiation_rules() -> () {
    let context = script_test_context();
    match execute_script_source(context, "var createdVar; function createdFunction() {}") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    let global = match context.global_object() {
        Some(value) => value,
        None => {
            testing::fail("missing global object");
            return
        },
    };
    match context.heap().get(global) {
        Some(value) => for name in Vec::from_array(["createdVar", "createdFunction"]) {
            match value.own_property(runtime::string_property_key(name)) {
                Some(descriptor) => {
                    testing::assert(runtime::descriptor_is_data(descriptor));
                    testing::assert(runtime::descriptor_writable(descriptor));
                    testing::assert(runtime::descriptor_enumerable(descriptor));
                    testing::assert(!runtime::descriptor_configurable(descriptor))
                },
                None => testing::fail("missing Script global property"),
            }
        },
        None => testing::fail("missing global object"),
    }
    match execute_script_source(context, "delete createdVar;") {
        Ok(runtime::Value::Bool(value)) => testing::assert(!value),
        _ => testing::fail("expected nondeletable Script var"),
    }
    match execute_script_source(
        context,
        "Object.defineProperty(globalThis, 'reusable', {value: 1, writable: true, enumerable: false, configurable: true});",
    ) {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match execute_script_source(context, "var reusable;") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match context.heap().get(global).and_then(
        |value| value.own_property(runtime::string_property_key("reusable")),
    ) {
        Some(descriptor) => {
            testing::assert(runtime::descriptor_configurable(descriptor));
            testing::assert(!runtime::descriptor_enumerable(descriptor));
            match runtime::descriptor_value(descriptor) {
                Some(value) => expect_int(value, 1),
                None => testing::fail("expected reusable data property"),
            }
        },
        None => testing::fail("missing reusable property"),
    }
    match execute_script_source(context, "let reusable = 2; reusable;") {
        Ok(value) => expect_int(value, 2),
        Err(value) => testing::fail(value.kind.debug()),
    }
    expect_int(
        execute_script_source(context, "globalThis.reusable;").unwrap_or(runtime::Value::Undefined),
        1,
    )
}

#[test]
fn script_instantiation_checks_conflicts_in_source_declaration_order() -> () {
    let function_first = script_test_context();
    match execute_script_source(function_first, "let existing = 1;") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match execute_script_source(function_first, "Object.preventExtensions(globalThis);") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match execute_script_source(function_first, "function missing() {} let existing;") {
        Err(vm::VmError { kind: vm::VmErrorKind::TypeError(_), .. }) => (),
        _ => testing::fail("expected earlier function declaration TypeError"),
    }
    let lexical_first = script_test_context();
    match execute_script_source(lexical_first, "let existing = 1;") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match execute_script_source(lexical_first, "Object.preventExtensions(globalThis);") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match execute_script_source(lexical_first, "let existing; function missing() {}") {
        Err(vm::VmError { kind: vm::VmErrorKind::SyntaxError(_), .. }) => (),
        _ => testing::fail("expected earlier lexical declaration SyntaxError"),
    }
    let nested_var_first = script_test_context();
    match execute_script_source(nested_var_first, "let existing = 1;") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match execute_script_source(nested_var_first, "Object.preventExtensions(globalThis);") {
        Ok(_) => (),
        Err(value) => testing::fail(value.kind.debug()),
    }
    match execute_script_source(nested_var_first, "if (true) { var nestedMissing; } let existing;") {
        Err(vm::VmError { kind: vm::VmErrorKind::TypeError(_), .. }) => (),
        _ => testing::fail("expected nested var source-order TypeError"),
    }
}

#[test]
fn strict_unresolvable_assignment_preserves_the_pre_rhs_reference() -> () {
    let context = script_test_context();
    match execute_script_source(context, "'use strict'; undeclared = (globalThis.undeclared = 5);") {
        Err(vm::VmError { kind: vm::VmErrorKind::ReferenceError(_), .. }) => (),
        _ => testing::fail("expected unresolved strict assignment ReferenceError"),
    }
    expect_int(
        execute_script_source(context, "globalThis.undeclared;").unwrap_or(
            runtime::Value::Undefined,
        ),
        5,
    )
}

