        "let evalRejected = false; try { class EvalProbe { [eval(\"with ({}) {}\")]() {} } } catch (error) { evalRejected = error instanceof SyntaxError; } let assignmentRejected = false; try { class AssignmentProbe { [strictClassMissing = 1]() {} } } catch (error) { assignmentRejected = error instanceof ReferenceError; } return evalRejected && assignmentRejected && typeof strictClassMissing === 'undefined';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected strict class expression semantics"),
    }
}

#[test]
fn enforces_contextual_await_yield_early_errors() -> () {
    match compile("'use strict'; var yield = 1;") {
        Ok(_) => testing::fail("expected strict yield binding error"),
        Err(errors) => if has_message(errors, "yield") {} else {
            testing::fail("expected strict yield diagnostic")
        },
    }
    match compile("'use strict'; var \\u0079ield = 1;") {
        Ok(_) => testing::fail("expected escaped strict yield binding error"),
        Err(errors) => if has_message(errors, "yield") {} else {
            testing::fail("expected escaped strict yield diagnostic")
        },
    }
    match compile_module("var await = 1;") {
        Ok(_) => testing::fail("expected module await binding error"),
        Err(errors) => if has_message(errors, "reserved word") {} else {
            testing::fail("expected module await reserved word diagnostic")
        },
    }
    match compile_module("function nested() { var await = 1; return await; }") {
        Ok(_) => testing::fail("expected nested module await error"),
        Err(errors) => if has_message(errors, "reserved word") {} else {
            testing::fail("expected nested module await reserved word diagnostic")
        },
    }
    match compile("async function invalid(value = await 1) {}") {
        Ok(_) => testing::fail("expected await parameter initializer error"),
        Err(errors) => if has_message(errors, "parameter initializer") {} else {
            testing::fail("expected await parameter initializer diagnostic")
        },
    }
    match compile("function* invalid(value = yield 1) {}") {
        Ok(_) => testing::fail("expected yield parameter initializer error"),
        Err(errors) => if has_message(errors, "parameter initializer") {} else {
            testing::fail("expected yield parameter initializer diagnostic")
        },
    }
    match compile("async function invalid() { return await 2 ** 3; }") {
        Ok(_) => testing::fail("expected await exponentiation error"),
        Err(errors) => if has_message(errors, "left operand") {} else {
            testing::fail("expected await exponentiation left operand diagnostic")
        },
    }
    match compile(
        "async function validAwait(value = () => await) { return (await 2) ** 3 + await (2 ** 3); } function* validYield(value = () => yield) { return value; } async function await() {} function* yield() {}",
    ) {
        Ok(_) => (),
        Err(_) => testing::fail("expected nested contextual identifier forms"),
    }
}

