#[test]
fn finalization_registry_uses_active_vm_roots_and_runs_after_gc() -> () {
    let function = expect_function(
        compile(
            "let actual = 0; let live = {}; let liveReference = new WeakRef(live); let registry = new FinalizationRegistry(value => { actual += value; }); registry.register({}, 40); let token = {}; registry.register({}, 2, token); let removed = registry.unregister(token); std.gc(); let invalidTarget = false; let sameHeld = false; let invalidToken = false; try { registry.register(1, 2); } catch (error) { invalidTarget = error instanceof TypeError; } try { registry.register(live, live); } catch (error) { sameHeld = error instanceof TypeError; } try { registry.register({}, 1, 2); } catch (error) { invalidToken = error instanceof TypeError; } return () => actual === 40 && removed && liveReference.deref() === live && invalidTarget && sameHeld && invalidToken && Object.prototype.toString.call(registry) === '[object FinalizationRegistry]';",
        ),
    );
    let context = vm::Context::new(runtime::Heap::new());
    install_dynamic_function_compiler(context);
    match builtins::install(context) {
        Ok(_) => (),
        Err(value) => testing::fail(value.message),
    }
    let verify = match context.execute(function) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    };
    let jobs: Result[isize, vm::VmError] = context.run_pending_jobs();
    match jobs {
        Ok(count) => testing::assert_eq(count, 1),
        Err(error) => testing::fail(error.kind.debug()),
    }
    let arguments: Vec[runtime::Value] = Vec::new();
    let verification: Result[runtime::Value, vm::VmError] = context.invoke_with_this_at_depth(
        verify,
        arguments,
        runtime::Value::Undefined,
        0,
    );
    match verification {
        Ok(runtime::Value::Bool(value)) => testing::assert(value),
        Ok(_) => testing::fail("expected finalization registry result"),
        Err(error) => testing::fail(error.kind.debug()),
    }
}

