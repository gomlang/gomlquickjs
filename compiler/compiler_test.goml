#[test]
fn class_strict_context_rejects_yield_and_static_block_await() -> () {
    let invalid = Vec::from_array(
        [
            "var yield = Object; class Invalid extends yield {}",
            "var subject; class Invalid extends (delete subject) {}",
            "var yield = 'name'; class Invalid { [yield]() {} }",
            "var subject; class Invalid { [delete subject]() {} }",
            "var yield = 1; class Invalid { value = yield; }",
            "var yield = 1; class Invalid { static { yield; } }",
            "var await = 1; class Invalid { static { await; } }",
            "var yield = 1; class Invalid { [(() => yield)()]() {} }",
        ],
    );
    for source in invalid {
