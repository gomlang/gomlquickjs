#[test]
fn quickjs_os_file_descriptors_and_path_operations_execute() -> () {
    match execute_source_with_builtins(
        "let directory = '__gomlquickjs_os_fs_35f644__'; let name = 'file.bin'; let path = directory + '/' + name; let link = directory + '/link'; os.remove(link); os.remove(path); os.remove(directory); let made = os.mkdir(directory, 0o755) === 0; let descriptor = os.open(path, os.O_RDWR | os.O_CREAT | os.O_TRUNC); let source = new Uint8Array(10); for (let index = 0; index < source.length; index++) source[index] = index; let wrote = os.write(descriptor, source.buffer, 0, source.length) === 10; let seeked = os.seek(descriptor, 0, std.SEEK_SET) === 0; let target = new Uint8Array(10); let read = os.read(descriptor, target.buffer, 0, target.length) === 10; let same = true; for (let index = 0; index < source.length; index++) same = same && source[index] === target[index]; let bigSeek = os.seek(descriptor, 6n, std.SEEK_SET) === 6n; let one = new Uint8Array(1); let oneRead = os.read(descriptor, one.buffer, 0, 1) === 1 && one[0] === 6; let closed = os.close(descriptor) === 0; let [files, readError] = os.readdir(directory); let touched = os.utimes(path, 10000, 10000) === 0; let [metadata, statError] = os.stat(path); let linked = os.symlink(name, link) === 0; let [linkMetadata, linkStatError] = os.lstat(link); let [linkTarget, linkError] = os.readlink(link); let [cwd, cwdError] = os.getcwd(); let [absolute, realError] = os.realpath('.'); let cleaned = os.remove(link) === 0 && os.remove(path) === 0 && os.remove(directory) === 0; return made && descriptor >= 3 && wrote && seeked && read && same && bigSeek && oneRead && closed && readError === 0 && files.indexOf(name) >= 0 && touched && statError === 0 && (metadata.mode & os.S_IFMT) === os.S_IFREG && metadata.mtime === 10000 && linked && linkStatError === 0 && (linkMetadata.mode & os.S_IFMT) === os.S_IFLNK && linkError === 0 && linkTarget === name && cwdError === 0 && realError === 0 && cwd === absolute && cleaned;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected os file descriptor and path result"),
    }
}

#[test]
fn quickjs_os_append_exclusive_dup_rename_and_clock_execute() -> () {
    match execute_source_with_builtins(
        "let sourcePath = '__gomlquickjs_os_dup_4d4b__.txt'; let targetPath = '__gomlquickjs_os_dup_4d4b_moved__.txt'; os.remove(sourcePath); os.remove(targetPath); let descriptor = os.open(sourcePath, os.O_RDWR | os.O_CREAT | os.O_EXCL); let bytes = new Uint8Array([65, 66, 67, 68]); let wroteA = os.write(descriptor, bytes.buffer, 0, 1) === 1; let duplicate = os.dup(descriptor); let wroteB = os.write(duplicate, bytes.buffer, 1, 1) === 1; let fixed = os.dup2(descriptor, 77); let wroteC = os.write(fixed, bytes.buffer, 2, 1) === 1; let closed = os.close(descriptor) === 0 && os.close(duplicate) === 0 && os.close(fixed) === 0; let exclusive = os.open(sourcePath, os.O_WRONLY | os.O_CREAT | os.O_EXCL) === -std.Error.EEXIST; let appended = os.open(sourcePath, os.O_WRONLY | os.O_APPEND); os.seek(appended, 0, std.SEEK_SET); let wroteD = os.write(appended, bytes.buffer, 3, 1) === 1 && os.close(appended) === 0; let renamed = os.rename(sourcePath, targetPath) === 0; let contents = std.loadFile(targetPath); let before = os.now(); let slept = os.sleep(0); let after = os.now(); let removed = os.remove(targetPath) === 0; return wroteA && duplicate >= 3 && wroteB && fixed === 77 && wroteC && closed && exclusive && wroteD && renamed && contents === 'ABCD' && typeof before === 'number' && after >= before && slept === 0 && os.getpid() > 0 && os.O_APPEND === 1024 && os.O_EXCL === 128 && os.WNOHANG === 1 && os.S_IFSOCK === 0o140000 && os.ttyGetWinSize(-1) === null && os.ttySetRaw(-1) === undefined && removed;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected os descriptor and clock compatibility result"),
    }
}

