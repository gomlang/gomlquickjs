    )
}

#[test]
fn promise_all_uses_receiver_capabilities_and_idempotent_elements() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let calls = []; function Custom(executor) { executor(values => calls.push(values.join(',')), reason => calls.push('reject:' + reason)); } Custom.resolve = value => value; let first = {then(resolve, reject) { resolve(1); resolve(9); reject(8); }}; let second = {then(resolve) { resolve(2); }}; let result = Promise.all.call(Custom, [first, second]); return result instanceof Custom && calls.join('|') === 'reject:8|1,2';",
        ),
        true,
    )
}

#[test]
fn promise_combinators_use_capabilities_and_preserve_ordered_results() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let calls = []; function Custom(executor) { executor(value => calls.push('resolve:' + value), reason => calls.push('reject:' + reason)); } Custom.resolve = value => ({then(resolve) { resolve(value); }}); let raced = Promise.race.call(Custom, [3]); let settled; Promise.allSettled([1, Promise.reject(2)]).then(values => settled = values); let aggregate; Promise.any([Promise.reject(3), Promise.reject(4)]).catch(error => aggregate = error); Promise.drainJobs(); return raced instanceof Custom && calls.join(',') === 'resolve:3' && settled[0].status === 'fulfilled' && settled[0].value === 1 && settled[1].status === 'rejected' && settled[1].reason === 2 && aggregate instanceof AggregateError && aggregate.errors.join(',') === '3,4';",
        ),
        true,
    )
}

#[test]
fn aggregate_error_collects_iterables_and_accepts_proxy_new_targets() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let order = ''; let errors = {[Symbol.iterator]() { order += 'iterator,'; let index = 0; return {next() { order += 'next,'; index += 1; return index <= 2 ? {value: index, done: false} : {done: true}; }}; }}; let message = {toString() { order += 'message,'; return 'many'; }}; let custom = {}; let NewTarget = new Proxy(function() {}, {get(target, key) { return key === 'prototype' ? custom : target[key]; }}); let result = Reflect.construct(AggregateError, [errors, message], NewTarget); let revoked = Proxy.revocable(function() {}, {}); revoked.revoke(); let revokedFailed = false; try { Reflect.construct(Error, [], revoked.proxy); } catch (error) { revokedFailed = error instanceof TypeError; } return Object.getPrototypeOf(result) === custom && result.message === 'many' && result.errors.join(',') === '1,2' && order === 'message,iterator,next,next,next,' && revokedFailed;",
        ),
        true,
    )
}

#[test]
fn proxy_internal_methods_forward_through_prototypes_and_nested_targets() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let getReceiver; let setReceiver; let hasCalls = 0; let target = {get value() { getReceiver = this; return 7; }, set value(value) { setReceiver = this; }}; let proxy = new Proxy(target, {has(target, key) { hasCalls += 1; return false; }}); let heir = Object.create(proxy); let read = heir.value; heir.value = 9; let nestedKeys = new Proxy(new Proxy([], {ownKeys() { return ['length', 'x']; }}), {}); let getInvariant = false; let getProxy = new Proxy({}, {getOwnPropertyDescriptor(target, key) { Object.defineProperty(target, key, {configurable: false, writable: true}); return {configurable: false, writable: false}; }}); try { Object.getOwnPropertyDescriptor(getProxy, 'x'); } catch (error) { getInvariant = error instanceof TypeError; } let defineInvariant = false; let defineProxy = new Proxy({}, {defineProperty(target, key) { Object.defineProperty(target, key, {configurable: false, writable: true}); return true; }}); try { Reflect.defineProperty(defineProxy, 'x', {writable: false}); } catch (error) { defineInvariant = error instanceof TypeError; } let defineCalls = 0; let nestedDefine = new Proxy(new Proxy({}, {defineProperty() { defineCalls += 1; return true; }}), {}); let nestedDefined = Reflect.defineProperty(nestedDefine, 'ok', {}); return read === 7 && getReceiver === heir && setReceiver === heir && !('anything' in heir) && hasCalls === 1 && Reflect.ownKeys(nestedKeys).join(',') === 'length,x' && getInvariant && defineInvariant && nestedDefined && defineCalls === 1;",
        ),
        true,
    )
}

#[test]
fn global_identifier_access_preserves_the_global_receiver_through_proxy_prototypes() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let global = globalThis; let original = Object.getPrototypeOf(global); let gets = 0; let sets = 0; Object.setPrototypeOf(global, new Proxy(original, {has(target, key) { return key === 'proxyGlobalBinding' || Reflect.has(target, key); }, get(target, key, receiver) { gets += 1; if (receiver !== global) throw 'receiver'; return Reflect.get(target, key, receiver); }, set(target, key, value, receiver) { sets += 1; if (receiver !== global) throw 'receiver'; return Reflect.set(target, key, value, receiver); }})); let before = proxyGlobalBinding; proxyGlobalBinding = 12; Object.setPrototypeOf(global, original); delete global.proxyGlobalBinding; return before === undefined && gets === 1 && sets === 1;",
        ),
        true,
    )
}

