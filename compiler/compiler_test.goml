#[test]
fn quickjs_os_chdir_coordinates_relative_io_processes_and_signals() -> () {
    expect_string(
        execute_source_with_builtins_jobs_property(
            "let directory = '/tmp/gomlquickjs-chdir-signal-61f74c'; let dataPath = directory + '/data'; let scriptPath = directory + '/script.js'; os.remove(dataPath); os.remove(scriptPath); os.remove(directory); let original = os.getcwd()[0]; let made = os.mkdir(directory) === 0; let missing = os.chdir(directory + '/missing') === -std.Error.ENOENT; let changed = os.chdir(directory) === 0 && os.getcwd()[0] === os.realpath('.')[0]; let file = std.open('data', 'w'); file.puts('data'); file.close(); let loaded = std.loadFile('data') === 'data'; let descriptor = os.open('data', os.O_RDONLY); let buffer = new Uint8Array(4); let read = os.read(descriptor, buffer.buffer, 0, 4) === 4 && Array.from(buffer).join(',') === '100,97,116,97'; os.close(descriptor); let notDirectory = os.chdir('data') === -20; let script = std.open('script.js', 'w'); script.puts('globalThis.__relativeLoadScript = 17;'); script.close(); std.loadScript('script.js'); let loadedScript = globalThis.__relativeLoadScript === 17; let pipe = std.popen('printf %s \"$PWD\"', 'r'); let pipeDirectory = pipe.readAsString(); pipe.close(); let processDirectory = os.exec(['sh', '-c', 'test \"$(cat data)\" = data']) === 0; let state = {valid: made && missing && changed && loaded && read && notDirectory && loadedScript && pipeDirectory === directory && processDirectory, result: 'pending'}; os.signal(os.SIGUSR1, function() { state.result = state.valid ? 'passed' : 'failed'; }); std.gc(); let sent = os.kill(os.getpid(), os.SIGUSR1) === 0; state.valid = state.valid && sent && os.signal.length === 2 && os.chdir.length === 0; os.signal(os.SIGUSR1, undefined); let restored = os.chdir(original) === 0; state.valid = state.valid && restored && os.remove(dataPath) === 0 && os.remove(scriptPath) === 0 && os.remove(directory) === 0; return state;",
            "result",
        ),
        "passed",
    )
}

