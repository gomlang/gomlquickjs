            "target?.tag`value`;",
            "target.tag?.`value`;",
        ],
    );
    for source in sources {
        match compile(source) {
            Err(errors) => testing::assert(!errors.is_empty()),
            Ok(_) => testing::fail("expected optional chain compile error"),
        }
    }
}

#[test]
fn with_statement_evaluates_object_and_executes_body() -> () {
    match execute_source_with_builtins(
        "let order = ''; with ({value: (order += 'o')}) label: { order += 'b'; break label; order += 'x'; } return order;",
    ) {
        runtime::Value::String(value) => {
            testing::assert(value == runtime::JsString::from_code_units(Vec::from_array([111, 98])))
        },
        _ => testing::fail("expected with statement result"),
    }
    match execute_source_with_builtins(
        "let outer = {x: 'outer', y: 'outer'}; let x = 'local'; eval(\"var z = 'eval-var'\"); let result = ''; with (outer) { result += x + ':' + eval('x'); let nested = function() { let inner = {x: 'inner'}; with (inner) { return x + ':' + y + ':' + z + ':' + eval('x') + ':' + eval('y') + ':' + eval('z') + ':' + eval('eval(\\\"x\\\")'); } }; result += ':' + nested(); } return result;",
    ) {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(
                value,
                "outer:outer:inner:outer:eval-var:inner:outer:eval-var:inner",
            ),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected nested with environment result"),
    }
    match execute_source_with_builtins(
        "let result; with ({eval, value: -1000}) { result = function() { var value = 1; return eval('value + 1'); }; } return result() === 2;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected direct eval local binding result"),
    }
    match compile("'use strict'; with ({}) {}") {
        Err(errors) => testing::assert(errors.len() > 0),
        Ok(_) => testing::fail("expected strict with error"),
    }
}

