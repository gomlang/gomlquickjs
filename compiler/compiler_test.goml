        "let descriptors = os.pipe(); let process = os.exec(['sh', '-c', 'echo $FOO'], {stdout: descriptors[1], block: false, env: {FOO: 'hello'}}); let writeClosed = os.close(descriptors[1]) === 0; let file = std.fdopen(descriptors[0], 'r'); let first = file.getline(); let second = file.getline(); file.close(); let [waited, status] = os.waitpid(process, 0); let sleeping = os.exec(['cat'], {block: false}); let killed = os.kill(sleeping, os.SIGTERM) === 0; let [killedProcess, killedStatus] = os.waitpid(sleeping, 0); return process >= 1000 && writeClosed && first === 'hello' && second === null && waited === process && (status & 0x7f) === 0 && (status >> 8) === 0 && killed && killedProcess === sleeping && (killedStatus & 0x7f) === os.SIGTERM;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected os process compatibility result"),
    }
}

