        "return '  A😀 '.trim().codePointAt(1) === 128512 && 'abc'.at(-1) === 'c' && (255).toString(16) === 'ff' && true.toString() === 'true' && 255n.toString(16) === 'ff' && Symbol('x').description === 'x';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected primitive prototype result"),
    }
}

#[test]
fn executes_sparse_array_prototype_algorithms_from_source() -> () {
    match execute_source_with_builtins(
        "let values = [1, , 3]; values.push(4); let removed = values.splice(1, 1, 2); return values.join('-') === '1-2-3-4' && removed.length === 1 && [NaN].includes(NaN) && values.slice(1, 3).join(',') === '2,3';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Array prototype result"),
    }
}

#[test]
fn executes_array_callback_iteration_methods_from_source() -> () {
    match execute_source_with_builtins(
        "let values = [1, , 3, 4]; let receiver = {factor: 2}; let calls = 0; let mapped = values.map(function(value, index, array) { calls += 1; return this.factor * (value + index) + (array === values ? 0 : 100); }, receiver); let filtered = values.filter(function(value) { return value >= 3; }); let total = 0; values.forEach(function(value) { total += value; }); let everyCalls = 0; let every = values.every(function(value) { everyCalls += 1; return value < 4; }); let someCalls = 0; let some = values.some(function(value) { someCalls += 1; return value === 3; }); let found = values.find(function(value) { return value === undefined; }); let foundIndex = values.findIndex(function(value) { return value === 3; }); let reduced = values.reduce(function(accumulator, value) { return accumulator + value; }, 0); let reducedWithoutInitial = values.reduce(function(accumulator, value) { return accumulator + value; }); let token = {}; let caught = false; try { values.map(function() { throw token; }); } catch (error) { caught = error === token; } let emptyError = false; try { [].reduce(function(left, right) { return left + right; }); } catch (error) { emptyError = error instanceof TypeError; } return calls === 3 && Object.keys(mapped).join(',') === '0,2,3' && mapped.join(',') === '2,,10,14' && filtered.join(',') === '3,4' && total === 8 && !every && everyCalls === 3 && some && someCalls === 2 && found === undefined && foundIndex === 2 && reduced === 8 && reducedWithoutInitial === 8 && caught && emptyError;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Array callback method result"),
    }
}

#[test]
fn executes_extended_math_functions_from_source() -> () {
    match execute_source_with_builtins(
        "return Math.clz32(1) === 31 && Math.imul(4294967295, 5) === -5 && Math.hypot(3, 4) === 5 && Math.cbrt(27) === 3;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected extended Math result"),
    }
}

#[test]
fn invokes_accessor_getters_setters_and_propagates_thrown_values() -> () {
    match execute_source_with_builtins(
        "let state = 1; let prototype = {}; Object.defineProperty(prototype, 'value', { get: function() { return state + this.offset; }, set: function(next) { state = next; } }); let object = Object.create(prototype); object.offset = 2; object.value = 40; return object.value === 42 && !Object.hasOwn(object, 'value');",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected accessor result"),
    }
    match execute_source_with_builtins(
        "let object = {}; Object.defineProperty(object, 'value', { get: function() { throw 77; } }); try { return object.value; } catch (error) { return error; }",
    ) {
        runtime::Value::Int(value) => testing::assert_eq(value, 77),
        _ => testing::fail("expected accessor exception"),
    }
}

#[test]
fn constructs_source_functions_with_prototypes_and_return_override() -> () {
    match execute_source_with_builtins(
        "function Point(value) { this.value = value; } Point.prototype.double = function() { return this.value * 2; }; let point = new Point(21); function Override() { return {value: 7}; } let other = new Override(); return point.double() === 42 && point.constructor === Point && other.value === 7;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected source construction result"),
    }
}

#[test]
fn executes_in_and_instanceof_through_prototype_chains() -> () {
    match execute_source_with_builtins(
        "function Point(value) { this.value = value; } Point.prototype.kind = 'point'; let point = new Point(3); let map = new Map(); return point instanceof Point && map instanceof Map && 'value' in point && 'kind' in point && !('missing' in point) && !(1 instanceof Point);",
