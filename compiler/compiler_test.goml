package compiler;

use gomlang::quickjs::builtins;
use gomlang::quickjs::bytecode;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::num;
use std::testing;
use std::text;

fn expect_function(value: Result[bytecode::Function, Vec[CompileError]]) -> bytecode::Function {
    match value {
        Ok(function) => function,
        Err(errors) => {
            if errors.is_empty() {
                testing::fail("compilation failed without diagnostics")
            } else {
                testing::fail(errors[0].message)
            }
            bytecode::Function::new(
                Vec::new(),
                Vec::from_array([bytecode::Instruction::ReturnUndef]),
                0,
            )
        },
    }
}

fn execute_source(source: string) -> runtime::Value {
    let function = expect_function(compile(source));
    match vm::execute(function, runtime::Heap::new()) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn execute_source_with_builtins(source: string) -> runtime::Value {
    execute_source_with_builtins_named(source, "<input>")
}

fn script_test_context() -> vm::Context {
    let context = vm::Context::new(runtime::Heap::new());
    install_dynamic_function_compiler(context);
    match builtins::install(context) {
        Ok(_) => (),
        Err(value) => testing::fail(value.message),
    }
    context
}

fn execute_script_source(context: vm::Context, source: string) -> Result[
    runtime::Value,
    vm::VmError,
] {
    context.execute_script(expect_function(compile_script(source)))
}

fn execute_source_with_builtins_named(source: string, source_name: string) -> runtime::Value {
    let function = expect_function(compile_with_source_name(source, source_name));
    let context = vm::Context::new(runtime::Heap::new());
    install_dynamic_function_compiler(context);
    match builtins::install(context) {
        Ok(_) => (),
        Err(value) => testing::fail(value.message),
    }
    match context.execute(function) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn execute_source_with_builtins_jobs_property(source: string, name: string) -> runtime::Value {
    let function = expect_function(compile(source));
    let context = vm::Context::new(runtime::Heap::new());
    install_dynamic_function_compiler(context);
    match builtins::install(context) {
        Ok(_) => (),
        Err(value) => testing::fail(value.message),
    }
    let result = match context.execute(function) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    };
    match context.run_pending_jobs() {
        Ok(_) => (),
        Err(error) => testing::fail(error.kind.debug()),
    }
    let name_bytes = name.to_bytes();
    match context.read_property_at_depth(
        result,
        runtime::Value::String(runtime::JsString::from_utf8(name_bytes.slice(0, name_bytes.len()))),
        0,
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn expect_string(value: runtime::Value, expected: string) -> () {
    match value {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, expected),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected string"),
    }
}

fn expect_int(value: runtime::Value, expected: i32) -> () {
    match value {
        runtime::Value::Int(actual) => testing::assert_eq(actual, expected),
        runtime::Value::Float(actual) => {
            testing::assert_eq(
                actual,
                num::parse_float64_structured(expected.to_string()).unwrap_or(0.0),
            )
        },
        _ => testing::fail("expected number"),
    }
}

fn expect_bool(value: runtime::Value, expected: bool) -> () {
    match value {
        runtime::Value::Bool(actual) => testing::assert_eq(actual, expected),
        _ => testing::fail("expected boolean"),
    }
}

fn has_message(errors: Vec[CompileError], expected: string) -> bool {
    for error in errors {
        if text::find(error.message, expected).is_some() {
            return true
        }
    }
    false
}

#[test]
fn compiles_arithmetic_precedence_end_to_end() -> () {
    expect_int(execute_source("return 2 + 3 * 4;"), 14)
}

#[test]
fn compiles_locals_assignment_and_loop_end_to_end() -> () {
    expect_int(
        execute_source(
            "let total = 0; let index = 0; while (index < 4) { total = total + index; index = index + 1; } return total;",
        ),
        6,
    )
}

#[test]
fn compiles_short_circuit_control_flow() -> () {
    expect_int(
        execute_source(
            "let value = 0; false && (value = 1); true || (value = 2); null ?? (value = 3); return value;",
        ),
        3,
    );
    let function = expect_function(compile("let x = 1; return x && 2;"));
    let mut found_branch = false;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::IfFalse(_) => {
                found_branch = true;
            },
            _ => (),
        };
    }
    testing::assert(found_branch)
}

#[test]
fn compiles_conditional_and_sequence_expressions() -> () {
    expect_int(
        execute_source(
            "let hits = 0; let value = (hits += 1, true ? (hits += 10, 7) : (hits += 100, 9)); let other = false ? (hits += 1000) : (hits += 2); return value * 100 + other;",
        ),
        713,
    )
}

#[test]
fn compiles_numeric_and_bitwise_compound_assignments() -> () {
    expect_int(
        execute_source(
            "let value = 3; value += 5; value *= 2; value -= 4; value /= 3; value **= 3; value %= 10; value <<= 2; value >>= 1; value >>>= 1; value |= 8; value ^= 3; value &= 14; return value;",
        ),
        14,
    )
}

#[test]
fn call_buffers_preserve_escaped_arguments_closures_and_suspension() -> () {
    match execute_source_with_builtins(
        "function keep(x) { return [arguments, () => arguments[0], () => x, v => { x = v; }]; } let a = keep(11); let b = keep(22); a[3](33); let captured = a[0][0] === 33 && a[1]() === 33 && a[2]() === 33 && b[0][0] === 22 && b[1]() === 22; function recursive(n) { let saved = arguments; if (n > 0) recursive(n - 1); return saved[0] === n; } function fromEval(x) { return eval('() => x'); } let e = fromEval(44); fromEval(55); function* generate(x) { yield arguments[0]; yield x; } let g = generate(66); generate(77); let asyncValue = 0; async function delayed(x) { await 0; asyncValue += arguments[0] + x; } delayed(3); delayed(5); Promise.drainJobs(); let loops = []; for (let i = 0; i < 3; i++) loops.push(() => i); return captured && recursive(8) && e() === 44 && g.next().value === 66 && g.next().value === 66 && asyncValue === 16 && loops[0]() === 0 && loops[1]() === 1 && loops[2]() === 2;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected independent call storage"),
    }
}

#[test]
fn string_field_caches_preserve_virtual_properties_and_prototype_changes() -> () {
    match execute_source_with_builtins(
        "function method(value) { return value.indexOf; } function first(value) { return value[0]; } function length(value) { return value.length; } let original = String.prototype.indexOf; let initial = method('abc') === original; String.prototype.indexOf = 42; let replaced = method('def') === 42; delete String.prototype.indexOf; let deleted = method('ghi') === undefined; let hits = 0; Object.defineProperty(String.prototype, 'indexOf', {get() { hits++; return this.length; }, configurable: true}); let accessor = method('abcd') === 4 && method('xy') === 2 && hits === 2; Object.defineProperty(String.prototype, 'indexOf', {value: original, writable: true, configurable: true}); String.prototype[0] = 'prototype'; let virtual = first('') === 'prototype' && first('x') === 'x' && first('') === 'prototype' && length('abcd') === 4 && length('') === 0; delete String.prototype[0]; return initial && replaced && deleted && accessor && virtual;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected string property cache semantics"),
    }
}

#[test]
fn call_sites_switch_between_source_native_bound_and_proxy_functions() -> () {
    match execute_source_with_builtins(
        "function invoke(f, x) { return f(x); } function twice(x) { return x * 2; } let native = invoke(Math.abs, -3); let source = invoke(twice, 4); let nativeAgain = invoke(Math.abs, -5); let bound = invoke(twice.bind(null), 6); let proxy = invoke(new Proxy(twice, {apply(target, receiver, args) { return target(args[0]) + 1; }}), 7); let delayed = 0; async function later(x) { await 0; return x; } invoke(later, 8).then(value => { delayed = value; }); invoke(twice, 9); Promise.drainJobs(); return native === 3 && source === 8 && nativeAgain === 5 && bound === 12 && proxy === 15 && delayed === 8;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected polymorphic call site result"),
    }
}

#[test]
fn fused_local_operations_preserve_coercion_and_exception_handlers() -> () {
    match execute_source_with_builtins(
        "function add(a, b) { return a + b; } function sub(a, b) { try { return a - b; } catch (error) { return error; } } let order = ''; let left = {valueOf() { order += 'l'; return 4; }}; let right = {valueOf() { order += 'r'; return 2; }}; let value = add(left, right); let marker = {}; let bad = {valueOf() { throw marker; }}; return value === 6 && order === 'lr' && add('a', 'b') === 'ab' && add(2147483647, 1) === 2147483648 && sub(bad, 1) === marker && sub(7, 2) === 5;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected fused operation semantics"),
    }
}

#[test]
fn remainder_indices_preserve_array_property_semantics() -> () {
    match execute_source_with_builtins(
        "function index(value) { return value % 3; } let array = [10, 20, 30]; let sum = 0; for (let i = 0; i < 9; i++) { array[index(i)] = i; sum += array[index(i)]; } let hits = 0; Object.defineProperty(array, '1', {get() { hits++; return 42; }, set(value) { hits += value; }}); array[index(4)] = 2; let accessor = array[index(7)] === 42 && hits === 3; let proto = Object.create(Array.prototype); proto[2] = 55; Object.setPrototypeOf(array, proto); delete array[2]; let inherited = array[index(5)] === 55; array[index(-4)] = 77; let negative = array['-1'] === 77 && array.length === 3; let keys = ''; let proxy = new Proxy(array, {get(target, key) { keys += key; return target[key]; }, set(target, key, value) { keys += key; target[key] = value; return true; }}); proxy[index(6)] = 99; let proxied = proxy[index(3)] === 99 && keys === '00'; let frozen = Object.freeze([1, 2, 3]); frozen[index(4)] = 8; let strictFailed = false; function strictWrite() { 'use strict'; frozen[index(4)] = 8; } try { strictWrite(); } catch (error) { strictFailed = error instanceof TypeError; } return sum === 36 && accessor && inherited && negative && proxied && frozen[1] === 2 && strictFailed && Object.is(index(-3), -0) && array[index(-3)] === 99;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected remainder index semantics result"),
    }
}

#[test]
fn cached_string_numeric_conversion_tracks_changing_values() -> () {
    match execute_source_with_builtins(
        "function bitwise(value) { return value | 0; } function subtract(value) { return 100 - value; } return bitwise('12') === 12 && bitwise('27') === 27 && bitwise('bad') === 0 && subtract('1.5') === 98.5 && subtract('2.5') === 97.5 && Number.isNaN(subtract('bad')) && subtract({valueOf() { return 7; }}) === 93;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected cached numeric conversion result"),
    }
}

#[test]
fn compiles_local_addition_assignment_to_specialized_instruction() -> () {
    let function = expect_function(compile("let value = 1; value += 2; return value;"));
    let mut found = false;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::AddLoc(_) => {
                found = true;
            },
            _ => (),
        }
    }
    testing::assert(found)
}

#[test]
fn specialized_local_addition_preserves_general_addition() -> () {
    match execute_source(
        "let text = 'a'; text += 'b'; let object = {valueOf() { return 4; }}; object += 3; let high = 2147483647; high += 1; return text === 'ab' && object === 7 && high === 2147483648;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected specialized local addition result"),
    }
}

#[test]
fn inherited_property_caches_track_mutations_and_shadowing() -> () {
    match execute_source_with_builtins(
        "let prototype = {}; Object.defineProperty(prototype, 'value', {value: 1, writable: true, configurable: true}); let object = Object.create(prototype); function read() { return object.value; } let initial = read(); prototype.value = 2; let updated = read(); object.value = 3; let shadowed = read(); delete object.value; let restored = read(); Object.defineProperty(prototype, 'value', {get() { return 4; }, configurable: true}); let accessor = read(); Object.setPrototypeOf(object, {value: 5}); let changed = read(); return initial === 1 && updated === 2 && shadowed === 3 && restored === 2 && accessor === 4 && changed === 5;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected inherited property cache result"),
    }
}

#[test]
fn native_call_caches_fall_back_for_polymorphic_targets() -> () {
    match execute_source_with_builtins(
        "function invoke(callback, value) { return callback(value); } function addOne(value) { return value + 1; } return invoke(Math.abs, -2) === 2 && invoke(addOne, 2) === 3 && invoke(parseInt, '4') === 4 && invoke(Math.abs, -5) === 5;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected polymorphic native call result"),
    }
}

#[test]
fn numeric_literals_use_ecmascript_binary64_rounding() -> () {
    match execute_source(
        "return 1.797693134862315708145274237317e+308 < 1.797693134862315808e+308 && 1.797693134862315808e+308 === 1e309 && 4.9406564584124654417656879286822e-324 !== 0 && 2e-324 === 0;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected numeric literal result"),
    }
}

#[test]
fn typeof_parenthesized_unresolved_reference_is_undefined() -> () {
    match execute_source_with_builtins(
        "return typeof missing === 'undefined' && typeof(missing) === 'undefined' && typeof(((missing))) === 'undefined';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected typeof result"),
    }
}

#[test]
fn logical_compound_assignments_short_circuit_writes() -> () {
    expect_int(
        execute_source(
            "let hits = 0; let a = 0; a &&= (hits += 1); let b = 1; b ||= (hits += 2); let c = null; c ??= (hits += 4); let d = 5; d ??= (hits += 8); let e = 1; e &&= (hits += 16); let f = 0; f ||= (hits += 32); return hits + c + e + f;",
        ),
        128,
    )
}

#[test]
fn prefix_and_postfix_updates_convert_numbers_and_preserve_bigints() -> () {
    match execute_source(
        "let number = '4'; let old_number = number++; let new_number = ++number; let bigint = 1n; let old_bigint = bigint++; let new_bigint = --bigint; return old_number === 4 && new_number === 6 && number === 6 && old_bigint === 1n && new_bigint === 1n && bigint === 1n;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected update result"),
    }
}

#[test]
fn compiles_updates_to_specialized_instructions() -> () {
    let function = expect_function(
        compile(
            "let a = 0; let b = 0; let c = 0; let d = 0; ++a; b++; --c; d--; return a + b + c + d;",
        ),
    );
    let mut pre_increment = false;
    let mut post_increment = false;
    let mut pre_decrement = false;
    let mut post_decrement = false;
    for instruction in function.code() {
        match instruction {
            bytecode::Instruction::PreIncrement => {
                pre_increment = true;
            },
            bytecode::Instruction::PostIncrement => {
                post_increment = true;
            },
            bytecode::Instruction::PreDecrement => {
                pre_decrement = true;
            },
            bytecode::Instruction::PostDecrement => {
                post_decrement = true;
            },
            _ => (),
        }
    }
    testing::assert(pre_increment);
    testing::assert(post_increment);
    testing::assert(pre_decrement);
    testing::assert(post_decrement)
}

#[test]
fn specialized_updates_preserve_integer_boundaries() -> () {
    match execute_source_with_builtins(
        "let high = 2147483647; let old_high = high++; let low = -2147483648; let old_low = low--; let zero = -1; let old_zero = zero++; return old_high === 2147483647 && high === 2147483648 && old_low === -2147483648 && low === -2147483649 && old_zero === -1 && zero === 0 && 1 / zero === Infinity;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected bounded update result"),
    }
}

#[test]
fn member_assignments_evaluate_receiver_and_key_once() -> () {
    expect_int(
        execute_source(
            "let object = { value: 1 }; let receiver_calls = 0; let key_calls = 0; function receiver() { receiver_calls += 1; return object; } function key() { key_calls += 1; return 'value'; } let assigned = receiver()[key()] += 4; let previous = receiver()[key()]++; let current = ++receiver()[key()]; return assigned * 10000 + previous * 1000 + current * 100 + receiver_calls * 10 + key_calls;",
        ),
        55733,
    )
}

#[test]
fn computed_object_keys_evaluate_before_values_once() -> () {
    match execute_source(
        "let order = 0; function key() { order = order * 10 + 1; return 'value'; } function value() { order = order * 10 + 2; return 40; } let object = {[key()]: value() + 2}; return object.value === 42 && order === 12;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected computed object property result"),
    }
}

#[test]
fn object_methods_compile_as_receiver_aware_functions() -> () {
    match execute_source(
        "let object = {base: 21, double(value) { return this.base * value; }, ['read']() { return this.base; }}; return object.double(2) === 42 && object.read() === 21;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected object method result"),
    }
}

#[test]
fn object_literal_getters_and_setters_share_accessor_descriptors() -> () {
    match execute_source_with_builtins(
        "let stored = 1; let object = {get value() { return stored; }, set value(next) { stored = next; }, get doubled() { return this.value * 2; }}; object.value = 21; let descriptor = Object.getOwnPropertyDescriptor(object, 'value'); return object.value === 21 && object.doubled === 42 && typeof descriptor.get === 'function' && typeof descriptor.set === 'function' && Object.keys(object).join(',') === 'value,doubled';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected object accessor result"),
    }
}

#[test]
fn executes_object_literals_on_assignment_right_hand_sides() -> () {
    match execute_source_with_builtins(
        "let value; value = {}; value = {get item() { return 4; }, set item(input) { this.saved = input; }}; let read = value.item; value.item = 7; if (read === 4) value = {id: value.saved}; else value = {}; return value.id === 7;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected object assignment result"),
    }
}

#[test]
fn preserves_surrogate_code_units_in_string_literals() -> () {
    match execute_source_with_builtins(
        "let maximum = '\\u{10ffff}'; return '\\ud800'.charCodeAt(0) === 55296 && '\\udc00'.charCodeAt(0) === 56320 && '\\ud83d\\udc31'.length === 2 && '\\u{1f431}'.length === 2 && maximum.length === 2 && maximum === '\\u{dbff}\\u{dfff}';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected surrogate string result"),
    }
}

#[test]
fn computed_object_accessors_evaluate_keys_once_and_merge_descriptors() -> () {
    match execute_source_with_builtins(
        "let keyHits = 0; let stored = 1; function key() { keyHits += 1; return 'value'; } let object = {get [key()]() { return stored; }, set [key()](next) { stored = next; }}; object.value = 42; let descriptor = Object.getOwnPropertyDescriptor(object, 'value'); return keyHits === 2 && object.value === 42 && typeof descriptor.get === 'function' && typeof descriptor.set === 'function';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected computed accessor result"),
    }
}

#[test]
fn function_prototype_call_apply_and_bind_preserve_this_arguments_and_throws() -> () {
    match execute_source_with_builtins(
        "function sum(left, right) { return this.base + left + right; } let receiver = {base: 10}; let bound = sum.bind(receiver, 15); let token = {}; let caught = false; function fail() { throw token; } try { fail.call(null); } catch (error) { caught = error === token; } return sum.call(receiver, 15, 17) === 42 && sum.apply(receiver, [15, 17]) === 42 && bound(17) === 42 && sum instanceof Function && bound instanceof Function && Function.prototype instanceof Object && caught;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Function prototype result"),
    }
}

#[test]
fn bound_functions_forward_construction_new_target_and_instanceof() -> () {
    match execute_source_with_builtins(
        "function Point(x, y) { this.x = x; this.y = y; } let receiver = {x: 99}; let Bound = Point.bind(receiver, 4); let point = new Bound(5); let Second = Bound.bind({x: 88}, 6); let second = new Second(); function Replacement(value) { this.ignored = value; return {value: value}; } let BoundReplacement = Replacement.bind(null, 7); let replacement = new BoundReplacement(); class Box { constructor(value) { this.value = value; } } let BoundBox = Box.bind(null, 9); let box = new BoundBox(); let classCallThrows = false; try { BoundBox(); } catch (error) { classCallThrows = error instanceof TypeError; } let BoundArray = Array.bind(null, 2); let array = new BoundArray(); let arrow = () => 1; let BoundArrow = arrow.bind(null); let arrowConstructThrows = false; try { new BoundArrow(); } catch (error) { arrowConstructThrows = error instanceof TypeError; } return point.x === 4 && point.y === 5 && receiver.x === 99 && point instanceof Point && point instanceof Bound && second.x === 4 && second.y === 6 && second instanceof Point && second instanceof Bound && second instanceof Second && replacement.value === 7 && replacement.ignored === undefined && box.value === 9 && box instanceof Box && box instanceof BoundBox && classCallThrows && array.length === 2 && array instanceof Array && Bound.length === 1 && Bound.prototype === undefined && arrowConstructThrows;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected bound constructor result"),
    }
}

#[test]
fn function_bind_reads_length_getters_and_preserves_abrupt_completion() -> () {
    match execute_source_with_builtins(
        "let hits = 0; function target(first, second, third) {} Object.defineProperty(target, 'length', {configurable: true, get() { hits += 1; return 3.9; }}); let bound = target.bind(null, 1); function infinite() {} Object.defineProperty(infinite, 'length', {configurable: true, get() { return Infinity; }}); let infiniteBound = infinite.bind(null, 1); let token = {}; function fail() {} Object.defineProperty(fail, 'length', {configurable: true, get() { throw token; }}); let preserved = false; try { fail.bind(null); } catch (error) { preserved = error === token; } function inherited() {} delete inherited.length; Object.setPrototypeOf(inherited, {length: 42}); function nonNumber() {} Object.defineProperty(nonNumber, 'length', {value: '3'}); return bound.length === 2 && hits === 1 && infiniteBound.length === Infinity && preserved && Function.prototype.bind.call(inherited, null, 1).length === 0 && nonNumber.bind(null, 1).length === 0;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected Function.bind length result"),
    }
}

#[test]
fn function_to_string_preserves_source_and_formats_native_callables() -> () {
    expect_string(
        execute_source_with_builtins(
