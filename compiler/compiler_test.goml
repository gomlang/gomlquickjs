fn primitive_string_fast_paths_preserve_conversion_semantics() -> () {
    expect_bool(
        execute_source_with_builtins(
            "let values = [0, 1, 9, 10, 99, 100, 1023, 1024, -1, -2147483648, 2147483647]; let expected = '0|1|9|10|99|100|1023|1024|-1|-2147483648|2147483647'; let calls = []; let object = {[Symbol.toPrimitive](hint) { calls.push(hint); return 7; }}; let symbolFailed = false; try { 'x' + Symbol('s'); } catch (error) { symbolFailed = error instanceof TypeError; } return values.map(value => value.toString()).join('|') === expected && [0, 1023, 1024, -1].map(value => value + '').join('|') === '0|1023|1024|-1' && (255).toString(16) === 'ff' && 'x' + object === 'x7' && calls.join(',') === 'default' && symbolFailed;",
        ),
        true,
    )
}
