#[test]
fn rejects_duplicate_and_strict_non_simple_parameters() -> () {
    match compile("function duplicate(a, a) { 'use strict'; }") {
        Err(errors) => testing::assert(has_message(errors, "duplicate parameter")),
        Ok(_) => testing::fail("expected strict duplicate parameter diagnostic"),
    }
    match compile("function defaulted(a = 1) { 'use strict'; }") {
        Err(errors) => testing::assert(has_message(errors, "non-simple parameter list")),
        Ok(_) => testing::fail("expected strict non-simple parameter diagnostic"),
    }
    match compile("let arrow = (a, a) => a;") {
        Err(errors) => testing::assert(has_message(errors, "duplicate parameter")),
        Ok(_) => testing::fail("expected arrow duplicate parameter diagnostic"),
    }
    match compile("let object = {method(a, a) { return a; }};") {
        Err(errors) => testing::assert(has_message(errors, "duplicate parameter")),
        Ok(_) => testing::fail("expected method duplicate parameter diagnostic"),
    }
    match compile("function conflict(a = 0) { let a; }") {
        Err(errors) => testing::assert(has_message(errors, "duplicate declaration")),
        Ok(_) => testing::fail("expected parameter and body lexical conflict"),
    }
    match compile("function allowed(a = 0) { var a; }") {
        Ok(_) => (),
        Err(_) => testing::fail("expected parameter and var redeclaration"),
    }
}

