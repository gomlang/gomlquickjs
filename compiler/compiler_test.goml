        "var probeBefore, probeTest, probeIncr, probeBody; var run = true; for (let x = 'outside', _ = probeBefore = function() { return x; }; run && (x = 'inside', probeTest = function() { return x; }); probeIncr = function() { return x; }) probeBody = function() { return x; }, run = false; let direct = false; try { let x = 1; for (let x in {x}) {} } catch (error) { direct = error instanceof ReferenceError; } let probeExpr; for (let x in {i: probeExpr = function() { typeof x; }}) {} let captured = false; try { probeExpr(); } catch (error) { captured = error instanceof ReferenceError; } let probeDecl, probeLoop; for (let [x, _ = probeDecl = function() { return x; }] in {i: 0}) probeLoop = function() { return x; }; return probeBefore() === 'outside' && probeTest() === 'inside' && probeBody() === 'inside' && probeIncr() === 'inside' && direct && captured && probeDecl() === 'i' && probeLoop() === 'i';",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected loop lexical environment result"),
    }
}

#[test]
fn assignment_to_captured_const_throws_at_runtime() -> () {
    match execute_source_with_builtins(
        "const fixed = 1; let change = function() { fixed = 2; }; try { change(); } catch (error) { return error instanceof TypeError && fixed === 1; } return false;",
    ) {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected captured const assignment error"),
    }
