#[test]
fn await_context_and_async_constructors_report_compile_errors() -> () {
    match compile("await 1;") {
        Ok(_) => testing::fail("expected await context error"),
        Err(_) => (),
    }
    match compile("for await (let value of []) {}") {
        Ok(_) => testing::fail("expected for-await context error"),
        Err(errors) => testing::assert(
            has_message(errors, "await is only valid in async functions"),
        ),
    }
    match compile_module("for await (let value of []) {}") {
        Ok(_) => (),
        Err(_) => testing::fail("expected module top-level for-await"),
    }
    match compile("class Invalid { async constructor() {} }") {
        Ok(_) => testing::fail("expected async constructor error"),
        Err(errors) => testing::assert(has_message(errors, "class constructor cannot be async")),
    }
}

#[test]
fn module_top_level_functions_conflict_with_var_declarations() -> () {
    let invalid = Vec::from_array(
        [
            "var smoosh; function smoosh() {}",
            "function smoosh() {} var smoosh;",
            "function smoosh() {} function smoosh() {}",
            "var smoosh; export function smoosh() {}",
        ],
    );
    for source in invalid {
        match compile_module(source) {
            Ok(_) => testing::fail("expected module declaration conflict"),
