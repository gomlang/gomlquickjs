package regexp;

#[derive(PartialEq, Eq, Debug)]
pub struct RegexFlags {
    pub has_indices: bool,
    pub global: bool,
    pub ignore_case: bool,
    pub multiline: bool,
    pub dot_all: bool,
    pub unicode: bool,
    pub unicode_sets: bool,
    pub sticky: bool,
}

impl RegexFlags {
    pub fn new() -> RegexFlags {
        RegexFlags {
            has_indices: false,
            global: false,
            ignore_case: false,
            multiline: false,
            dot_all: false,
            unicode: false,
            unicode_sets: false,
            sticky: false,
        }
    }
}

pub fn parse_flags(value: string) -> Result[RegexFlags, RegexError] {
    let mut has_indices = false;
    let mut global = false;
    let mut ignore_case = false;
    let mut multiline = false;
    let mut dot_all = false;
    let mut unicode = false;
    let mut unicode_sets = false;
    let mut sticky = false;
    let mut index = 0;
    while index < value.byte_len() {
        let current = value.byte_get(index);
        let duplicate = match current {
            b'd' => has_indices,
            b'g' => global,
            b'i' => ignore_case,
            b'm' => multiline,
            b's' => dot_all,
            b'u' => unicode,
            b'v' => unicode_sets,
            b'y' => sticky,
            _ => return Result::Err(regex_error("invalid regular expression flag", index)),
        };
        if duplicate {
            return Result::Err(regex_error("duplicate regular expression flag", index))
        }
        match current {
            b'd' => {
                has_indices = true;
            },
            b'g' => {
                global = true;
            },
            b'i' => {
                ignore_case = true;
            },
            b'm' => {
                multiline = true;
            },
            b's' => {
                dot_all = true;
            },
            b'u' => {
                unicode = true;
            },
            b'v' => {
                unicode_sets = true;
            },
            b'y' => {
                sticky = true;
            },
            _ => (),
        }
        index += 1;
    }
    if unicode && unicode_sets {
        Result::Err(regex_error("regular expression flags `u` and `v` are mutually exclusive", 0))
    } else {
        Result::Ok(
            RegexFlags {
                has_indices,
                global,
                ignore_case,
                multiline,
                dot_all,
                unicode,
                unicode_sets,
                sticky,
            },
        )
    }
}
