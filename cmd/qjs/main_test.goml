package main;

use gomlang::quickjs::runtime;
use std::fs;
use std::testing;
use std::text;

#[test]
fn parses_eval_file_help_and_stdin_commands() -> () {
    match parse_command(Vec::from_array(["qjs"])) {
        Ok(Command::Stdin(_)) => (),
        _ => testing::fail("expected stdin command"),
    }
    match parse_command(Vec::from_array(["qjs", "-e", "return 1;"])) {
        Ok(Command::Evaluate(source, arguments, _)) => {
            testing::assert_eq(source, "return 1;");
            testing::assert(arguments.is_empty())
        },
        _ => testing::fail("expected eval command"),
    }
    match parse_command(Vec::from_array(["qjs", "input.js"])) {
        Ok(Command::File(path, arguments, _)) => {
            testing::assert_eq(path, "input.js");
            testing::assert_eq(arguments.len(), 1);
            testing::assert_eq(arguments[0], "input.js")
        },
        _ => testing::fail("expected file command"),
    }
    match parse_command(Vec::from_array(["qjs", "--help"])) {
        Ok(Command::Help) => (),
        _ => testing::fail("expected help command"),
    }
}

#[test]
fn rejects_invalid_command_lines() -> () {
    testing::assert(parse_command(Vec::from_array(["qjs", "--missing"])).is_err());
    testing::assert(parse_command(Vec::from_array(["qjs", "-e"])).is_err());
    testing::assert(parse_command(Vec::from_array(["qjs", "-I"])).is_err());
    match parse_command(Vec::from_array(["qjs", "one.js", "two.js"])) {
        Ok(Command::File(_, arguments, _)) => {
            testing::assert_eq(arguments.len(), 2);
            testing::assert_eq(arguments[1], "two.js")
        },
        _ => testing::fail("expected file arguments"),
    }
}

#[test]
fn parses_module_script_strict_include_std_and_quit_options() -> () {
    match parse_command(
        Vec::from_array(
            ["qjs", "--strict", "-I", "setup.js", "--std", "-m", "input.js", "argument"],
        ),
    ) {
        Ok(Command::File(path, arguments, options)) => {
            testing::assert_eq(path, "input.js");
            testing::assert_eq(arguments.len(), 2);
            testing::assert_eq(arguments[0], "input.js");
            testing::assert_eq(arguments[1], "argument");
            testing::assert(options.mode == SourceMode::Module);
            testing::assert(options.strict);
            testing::assert_eq(options.includes.len(), 1);
            testing::assert_eq(options.includes[0], "setup.js");
            testing::assert(options.report_unhandled_rejections)
        },
        _ => testing::fail("expected configured file command"),
    }
    match parse_command(Vec::from_array(["qjs", "-m", "--script", "-e", "return 1;"])) {
        Ok(Command::Evaluate(_, _, options)) => {
            testing::assert(options.mode == SourceMode::Script)
        },
        _ => testing::fail("expected forced script command"),
    }
    match parse_command(Vec::from_array(["qjs", "--", "-input.js", "argument"])) {
        Ok(Command::File(path, arguments, _)) => {
            testing::assert_eq(path, "-input.js");
            testing::assert_eq(arguments.len(), 2);
            testing::assert_eq(arguments[0], "-input.js");
            testing::assert_eq(arguments[1], "argument")
        },
        _ => testing::fail("expected option-terminated file command"),
    }
    match parse_command(Vec::from_array(["qjs", "-q"])) {
        Ok(Command::Quit) => (),
        _ => testing::fail("expected quit command"),
    }
    match parse_command(
        Vec::from_array(["qjs", "--no-unhandled-rejection", "-e", "Promise.reject(1)"]),
    ) {
        Ok(Command::Evaluate(_, _, options)) => {
            testing::assert(!options.report_unhandled_rejections)
        },
        _ => testing::fail("expected unhandled rejection option"),
    }
}

#[test]
fn executes_includes_before_strict_main_and_defers_jobs_until_main() -> () {
    let path = "__gomlquickjs_qjs_include_780d__.js";
    match fs::write_file_structured(
        path,
        "let includeValue = 40; Promise.resolve().then(function() { includeValue += 1; });",
    ) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
    let options = ExecutionOptions {
        mode: SourceMode::Script,
        strict: true,
        includes: Vec::from_array([path]),
        report_unhandled_rejections: true,
    };
    let result = run(
        Command::Evaluate(
            "if (includeValue !== 40) throw 'include jobs ran early'; if ((function() { return this; })() !== undefined) throw 'script is not strict'; Promise.resolve().then(function() { if (includeValue !== 41) throw 'include job did not run'; });",
            Vec::new(),
            options,
        ),
    );
    let _ = fs::remove_file(path);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn forced_module_eval_supports_await_and_forced_script_rejects_it() -> () {
    match run(
        Command::Evaluate(
            "let value = await Promise.resolve(42); if (value !== 42) throw value;",
            Vec::new(),
            ExecutionOptions {
                mode: SourceMode::Module,
                strict: false,
                includes: Vec::new(),
                report_unhandled_rejections: true,
            },
        ),
    ) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
    match run(
        Command::Evaluate(
            "export let value = await Promise.resolve(42);",
            Vec::new(),
            default_execution_options(),
        ),
    ) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
    testing::assert(
        run(
            Command::Evaluate(
                "await Promise.resolve(42);",
                Vec::new(),
                ExecutionOptions {
                    mode: SourceMode::Script,
                    strict: false,
                    includes: Vec::new(),
                    report_unhandled_rejections: true,
                },
            ),
        ).is_err(),
    );
    match run(Command::Quit) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn executes_source_through_compiler_and_vm() -> () {
    match execute_source("6 * 7;") {
        Ok(runtime::Value::Float(value)) => testing::assert_eq(value, 42.0),
        Ok(runtime::Value::Int(value)) => testing::assert_eq(value, 42),
        _ => testing::fail("expected numeric result"),
    }
}

#[test]
fn eval_source_functions_expose_cmdline_metadata() -> () {
    match execute_source("function f(){} f.fileName + '|' + f.lineNumber + '|' + f.columnNumber;") {
        Ok(value) => expect_host_string(value, "<cmdline>|1|1"),
        Err(value) => testing::fail(value),
    }
    match execute_source_with_arguments_at_path(
        "function f(){} f.fileName;",
        Vec::new(),
        Option::Some("named.js"),
    ) {
        Ok(value) => expect_host_string(value, "named.js"),
        Err(value) => testing::fail(value),
    }
}

#[test]
fn renders_recoverable_compile_diagnostics() -> () {
    match execute_source("missing; const = ;") {
        Err(message) => {
            testing::assert(text::find(message, "expected variable name").is_some())
        },
        Ok(_) => testing::fail("expected compile diagnostics"),
    }
}

#[test]
fn renders_uncaught_error_stack_diagnostics() -> () {
    match execute_source("function fail() { throw new TypeError('broken'); } fail();") {
        Err(message) => {
            testing::assert(text::find(message, "Thrown(").is_some());
            testing::assert(text::find(message, "at <cmdline>").is_some())
        },
        Ok(_) => testing::fail("expected uncaught runtime diagnostics"),
    }
}

#[test]
fn executes_math_builtins_from_source() -> () {
    match execute_source("Math.max(6, 7) * Math.sqrt(36);") {
        Ok(runtime::Value::Float(value)) => testing::assert_eq(value, 42.0),
        Ok(runtime::Value::Int(value)) => testing::assert_eq(value, 42),
        _ => testing::fail("expected builtin numeric result"),
    }
}

#[test]
fn exposes_eval_and_file_script_arguments() -> () {
    match execute_source_with_arguments("scriptArgs.join('|');", Vec::from_array(["alpha", "beta"])) {
        Ok(value) => expect_host_string(value, "alpha|beta"),
        Err(value) => testing::fail(value),
    }
    match parse_command(Vec::from_array(["qjs", "-e", "return 1;", "left", "right"])) {
        Ok(Command::Evaluate(_, arguments, _)) => {
            testing::assert_eq(arguments.len(), 2);
            testing::assert_eq(arguments[0], "left");
            testing::assert_eq(arguments[1], "right")
        },
        _ => testing::fail("expected eval script arguments"),
    }
}

#[test]
fn executes_json_builtins_from_source() -> () {
    match execute_source("JSON.stringify(JSON.parse('{\"value\":42}'));") {
        Ok(runtime::Value::String(value)) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, "{\"value\":42}"),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected JSON source result"),
    }
}

fn expect_host_string(value: runtime::Value, expected: string) -> () {
    match value {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, expected),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected string result"),
    }
}

#[test]
fn executes_bigint_regexp_uri_and_date_builtins_from_source() -> () {
    match execute_source("String(2n ** 100n);") {
        Ok(value) => expect_host_string(value, "1267650600228229401496703205376"),
        Err(value) => testing::fail(value),
    }
    match execute_source("RegExp('a+', 'g').test('caa');") {
        Ok(runtime::Value::Bool(value)) => testing::assert(value),
        Ok(_) => testing::fail("expected RegExp result"),
        Err(value) => testing::fail(value),
    }
    match execute_source("decodeURIComponent(encodeURIComponent('a/😀'));") {
        Ok(value) => expect_host_string(value, "a/😀"),
        Err(value) => testing::fail(value),
    }
    match execute_source("Date.toISOString(Date.UTC(2000, 1, 30));") {
        Ok(value) => expect_host_string(value, "2000-03-01T00:00:00.000Z"),
        Err(value) => testing::fail(value),
    }
}

#[test]
fn executes_symbol_buffer_error_and_promise_builtins_from_source() -> () {
    match execute_source("Symbol.keyFor(Symbol.for('shared'));") {
        Ok(value) => expect_host_string(value, "shared"),
        Err(value) => testing::fail(value),
    }
    match execute_source(
        "let buffer = new ArrayBuffer(4); let view = new DataView(buffer); view.setUint32(0, 305419896); view.getUint32(0);",
    ) {
        Ok(runtime::Value::Float(value)) => testing::assert_eq(value, 305419896.0),
        Ok(runtime::Value::Int(value)) => testing::assert_eq(value, 305419896),
        Err(value) => testing::fail(value),
        _ => testing::fail("expected DataView result"),
    }
    match execute_source(
        "try { throw TypeError('broken'); } catch (error) { error.name + ': ' + error.message; }",
    ) {
        Ok(value) => expect_host_string(value, "TypeError: broken"),
        Err(value) => testing::fail(value),
    }
    match execute_source(
        "let result = 0; Promise.resolve(41).then(function(value) { result = value + 1; }); Promise.drainJobs(); result;",
    ) {
        Ok(runtime::Value::Float(value)) => testing::assert_eq(value, 42.0),
        Ok(runtime::Value::Int(value)) => testing::assert_eq(value, 42),
        Err(value) => testing::fail(value),
        _ => testing::fail("expected Promise result"),
    }
}

#[test]
fn drains_host_jobs_after_top_level_execution() -> () {
    match execute_source(
        "os.setTimeout(function(value) { if (value !== 42) throw TypeError('wrong timer value'); }, 0, 42); os.platform;",
    ) {
        Ok(value) => expect_host_string(value, "linux"),
        Err(value) => testing::fail(value),
    }
    match execute_source("os.setTimeout(function() { throw TypeError('timer ran'); }, 0);") {
        Ok(_) => testing::fail("expected queued timer failure"),
        Err(_) => (),
    }
    match execute_source(
        "let timer = os.setTimeout(function() { throw TypeError('cancelled timer ran'); }, 0); os.clearTimeout(timer);",
    ) {
        Ok(_) => (),
        Err(value) => testing::fail(value),
    }
}

#[test]
fn drains_promise_jobs_before_timer_jobs() -> () {
    match execute_source(
        "let count = 0; Promise.resolve().then(function() { std.gc(); }); Promise.reject().catch(function() { count += 1; }); Promise.reject().catch(function() { count += 1; }); Promise.resolve().then(function() { count += 1; }); os.setTimeout(function() { if (count !== 3) throw TypeError('timer ran before promise jobs'); }, 0);",
    ) {
        Ok(_) => (),
        Err(value) => testing::fail(value),
    }
}

#[test]
fn reports_unhandled_promise_rejections_after_draining_jobs() -> () {
    match run(Command::Evaluate("Promise.reject(7);", Vec::new(), default_execution_options())) {
        Err(message) => testing::assert_eq(message, "Possibly unhandled promise rejection: 7"),
        Ok(()) => testing::fail("expected unhandled rejection"),
    }
    match run(
        Command::Evaluate(
            "let error = new Error('broken'); Promise.reject(error); error = null; std.gc();",
            Vec::new(),
            default_execution_options(),
        ),
    ) {
        Err(message) => {
            testing::assert(message.contains("Possibly unhandled promise rejection: Error: broken"));
            testing::assert(message.contains("at <cmdline>"))
        },
        Ok(()) => testing::fail("expected error rejection"),
    }
    for (source, expected) in Vec::from_array(
        [
            ("Promise.reject('bad');", "Possibly unhandled promise rejection: \"bad\""),
            ("Promise.reject(12n);", "Possibly unhandled promise rejection: 12n"),
            (
                "Promise.reject(Symbol('token'));",
                "Possibly unhandled promise rejection: Symbol(token)",
            ),
        ],
    ) {
        match run(Command::Evaluate(source, Vec::new(), default_execution_options())) {
            Err(message) => testing::assert_eq(message, expected),
            Ok(()) => testing::fail("expected primitive rejection"),
        }
    }
}

#[test]
fn rejection_reporting_is_side_effect_free_and_stops_before_host_jobs() -> () {
    match run(
        Command::Evaluate(
            "Promise.reject({ a: 1, toString() { throw new Error('called'); } });",
            Vec::new(),
            default_execution_options(),
        ),
    ) {
        Err(message) => testing::assert_eq(
            message,
            "Possibly unhandled promise rejection: { a: 1, toString: [Function toString] }",
        ),
        Ok(()) => testing::fail("expected object rejection"),
    }
    match run(
        Command::Evaluate(
            "let pending = Promise.reject(13); os.setTimeout(function() { pending.catch(function() {}); }, 0);",
            Vec::new(),
            default_execution_options(),
        ),
    ) {
        Err(message) => testing::assert_eq(message, "Possibly unhandled promise rejection: 13"),
        Ok(()) => testing::fail("expected rejection before timer job"),
    }
}

#[test]
fn rejection_tracking_roots_only_reportable_promises() -> () {
    match run(
        Command::Evaluate(
            "let weak = (() => { let promise = Promise.reject(14); let result = new WeakRef(promise); promise = null; return result; })(); std.gc(); if (weak.deref() === undefined) throw new Error('unhandled promise was collected');",
            Vec::new(),
            default_execution_options(),
        ),
    ) {
        Err(message) => testing::assert_eq(message, "Possibly unhandled promise rejection: 14"),
        Ok(()) => testing::fail("expected rooted rejection"),
    }
    match run(
        Command::Evaluate(
            "let refs = (() => { let reason = { value: 15 }; let promise = Promise.reject(reason); let result = [new WeakRef(promise), new WeakRef(reason)]; promise.catch(function() {}); promise = null; reason = null; return result; })(); Promise.drainJobs(); std.gc(); if (refs[0].deref() !== undefined || refs[1].deref() !== undefined) throw new Error('handled rejection remained rooted');",
            Vec::new(),
            default_execution_options(),
        ),
    ) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn pending_promises_root_reaction_handlers() -> () {
    match execute_source(
        "let resolve; let source = new Promise(function(callback) { resolve = callback; }); let result = 0; let handler = function(value) { result = value; }; let weak = new WeakRef(handler); source.then(handler); handler = null; std.gc(); if (weak.deref() === undefined) throw new Error('reaction handler was collected'); resolve(42); Promise.drainJobs(); if (result !== 42) throw new Error('reaction handler did not run');",
    ) {
        Ok(_) => (),
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn handled_and_suppressed_promise_rejections_do_not_fail() -> () {
    for source in Vec::from_array(
        [
            "Promise.reject(7).catch(function() {});",
            "let pending = Promise.reject(8); Promise.resolve().then(function() { pending.catch(function() {}); });",
        ],
    ) {
        match run(Command::Evaluate(source, Vec::new(), default_execution_options())) {
            Ok(()) => (),
            Err(message) => testing::fail(message.to_string()),
        }
    }
    let options = ExecutionOptions {
        mode: SourceMode::Auto,
        strict: false,
        includes: Vec::new(),
        report_unhandled_rejections: false,
    };
    match run(
        Command::Evaluate(
            "let error = new Error('hidden'); let pending = Promise.reject(error); error = null; std.gc(); pending.catch(function(reason) { if (reason.message !== 'hidden') throw reason; });",
            Vec::new(),
            options,
        ),
    ) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
    match run(
        Command::Evaluate(
            "let refs = (() => { let reason = { value: 9 }; let pending = Promise.reject(reason); return [new WeakRef(pending), new WeakRef(reason)]; })(); std.gc(); if (refs[0].deref() !== undefined || refs[1].deref() !== undefined) throw new Error('suppressed rejection remained rooted');",
            Vec::new(),
            options,
        ),
    ) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn rejection_propagation_and_modules_track_the_terminal_promise() -> () {
    match run(
        Command::Evaluate("Promise.reject(10).then();", Vec::new(), default_execution_options()),
    ) {
        Err(message) => testing::assert_eq(message, "Possibly unhandled promise rejection: 10"),
        Ok(()) => testing::fail("expected propagated rejection"),
    }
    let options = ExecutionOptions {
        mode: SourceMode::Module,
        strict: false,
        includes: Vec::new(),
        report_unhandled_rejections: true,
    };
    match run(Command::Evaluate("Promise.reject(11); export {};", Vec::new(), options)) {
        Err(message) => testing::assert_eq(message, "Possibly unhandled promise rejection: 11"),
        Ok(()) => testing::fail("expected module rejection"),
    }
    match run(
        Command::Evaluate(
            "Promise.reject(12); await new Promise(function(resolve) { os.setTimeout(resolve, 0); }); export {};",
            Vec::new(),
            options,
        ),
    ) {
        Err(message) => testing::assert_eq(message, "Possibly unhandled promise rejection: 12"),
        Ok(()) => testing::fail("expected module rejection before timer job"),
    }
    match run(
        Command::Evaluate(
            "Promise.reject('unhandled'); await Promise.reject('module'); export {};",
            Vec::new(),
            options,
        ),
    ) {
        Err(message) => {
            testing::assert(message.contains("module"));
            testing::assert(!message.contains("Possibly unhandled promise rejection"))
        },
        Ok(()) => testing::fail("expected top-level await rejection"),
    }
}

#[test]
fn dynamic_import_jobs_run_before_rejection_checkpoints() -> () {
    let path = "__gomlquickjs_qjs_dynamic_checkpoint_7b32__.mjs";
    match fs::write_file_structured(path, "export const value = 1;") {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
    let options = ExecutionOptions {
        mode: SourceMode::Module,
        strict: false,
        includes: Vec::new(),
        report_unhandled_rejections: true,
    };
    let result = run(
        Command::Evaluate(
            "let pending = Promise.reject(16); import('./__gomlquickjs_qjs_dynamic_checkpoint_7b32__.mjs').then(function() { pending.catch(function() {}); }); export {};",
            Vec::new(),
            options,
        ),
    );
    let _ = fs::remove_file(path);
    match result {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn mjs_files_execute_as_modules_with_top_level_await() -> () {
    let path = "__gomlquickjs_qjs_tla_8c41__.mjs";
    match fs::write_file_structured(path, "await Promise.resolve(42);") {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
    match run(Command::File(path, Vec::from_array([path]), default_execution_options())) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
    let _ = fs::remove_file(path);
}

#[test]
fn dispatches_pipe_read_and_write_handlers() -> () {
    match execute_source(
        "let completed = 0; let pairs = []; function readHandler(descriptor, index) { let buffer = new Uint32Array(1); let count = os.read(descriptor, buffer.buffer, 0, 4); if (count !== 4 || buffer[0] !== index) throw 'wrong pipe value: ' + index + '/' + count + '/' + buffer[0]; os.setReadHandler(descriptor, null); completed += 1; } function writeHandler(descriptor, index) { let buffer = new Uint32Array(1); buffer[0] = index; os.write(descriptor, buffer.buffer, 0, 4); os.setWriteHandler(descriptor, null); if (index === 0) os.setTimeout(function() { if (completed !== 8) throw 'pipe handlers did not finish: ' + completed; }, 0); } for (let i = 0; i < 8; i++) { let pair = os.pipe(); pairs.push(pair); os.setReadHandler(pair[0], readHandler.bind(null, pair[0], i)); } for (let i = 7; i >= 0; i--) { let pair = pairs[i]; os.setWriteHandler(pair[1], writeHandler.bind(null, pair[1], i)); }",
    ) {
        Ok(_) => (),
        Err(value) => testing::fail(value),
    }
}
