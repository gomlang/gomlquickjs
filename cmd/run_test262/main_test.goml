package main;

use std::testing;

fn expect_command(value: Result[Command, string]) -> Command {
    match value {
        Ok(value) => value,
        Err(value) => {
            testing::fail(value);
            expect_command(parse_command(Vec::from_array(["run-test262", "sample.js"])))
        },
    }
}

#[test]
fn parses_harness_directory_and_multiple_files() -> () {
    let command = expect_command(
        parse_command(
            Vec::from_array(["run-test262", "--harness", "suite/harness", "one.js", "two.js"]),
        ),
    );
    testing::assert_eq(command.harness_directory, "suite/harness");
    testing::assert(command.files == Vec::from_array(["one.js", "two.js"]));
    testing::assert(!command.help)
}

#[test]
fn accepts_help_and_rejects_incomplete_commands() -> () {
    testing::assert(expect_command(parse_command(Vec::from_array(["run-test262", "--help"]))).help);
    testing::assert(parse_command(Vec::from_array(["run-test262"])).is_err());
    testing::assert(parse_command(Vec::from_array(["run-test262", "--harness"])).is_err());
    testing::assert(
        parse_command(Vec::from_array(["run-test262", "--unknown", "file.js"])).is_err(),
    )
}
