package modules;

use gomlang::quickjs::builtins;
use gomlang::quickjs::compiler;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::fs;
use std::num;
use std::testing;

fn module_test_context() -> (vm::Context, runtime::ObjectId) {
    let context = vm::Context::new(runtime::Heap::new());
    compiler::install_dynamic_function_compiler(context);
    let fallback = match runtime::new_ordinary_object(context.heap(), Option::None) {
        Ok(value) => value,
        Err(_) => return module_test_context(),
    };
    match builtins::install(context) {
        Ok(realm) => (context, realm.global_object()),
        Err(error) => {
            testing::fail(error.message);
            (context, fallback)
        },
    }
}

fn module_write(path: string, source: string) -> () {
    match fs::write_file_structured(path, source) {
        Ok(()) => (),
        Err(error) => testing::fail(error.to_string()),
    }
}

fn module_read(context: vm::Context, namespace: runtime::Value, name: string) -> runtime::Value {
    match context.read_property_at_depth(
        namespace,
        runtime::Value::String(
            runtime::JsString::from_utf8(name.to_bytes().slice(0, name.byte_len())),
        ),
        0,
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn module_expect_number(value: runtime::Value, expected: i32) -> () {
    match value {
        runtime::Value::Int(value) => testing::assert_eq(value, expected),
        runtime::Value::Float(value) => {
            testing::assert_eq(
                value,
                num::parse_float64_structured(expected.to_string()).unwrap_or(0.0),
            )
        },
        _ => testing::fail("expected number"),
    }
}

fn module_expect_string(value: runtime::Value, expected: string) -> () {
    match value {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, expected),
            Err(_) => testing::fail("expected host string"),
        },
        _ => testing::fail("expected string"),
    }
}

#[test]
fn in_memory_modules_preserve_separate_source_display_names() -> () {
    let (context, global) = module_test_context();
    let namespace = match execute_source_with_source_name(
        context,
        global,
        "__gomlquickjs_source_name_b0a1__.mjs",
        "export function f(){}; export const metadata = f.fileName + '|' + f.lineNumber + '|' + f.columnNumber;",
        "<cmdline>",
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    match module_read(context, namespace, "metadata") {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, "<cmdline>|1|8"),
            Err(value) => testing::fail(value.debug()),
        },
        _ => testing::fail("expected module source metadata"),
    }
}

#[test]
fn modules_resolve_script_global_lexicals_without_leaking_module_bindings() -> () {
    let (context, global) = module_test_context();
    let harness = match compiler::compile_script("let harnessLexical = 40;") {
        Ok(value) => value,
        Err(errors) => {
            if !errors.is_empty() {
                testing::fail(errors[0].message)
            } else {
                testing::fail("cannot compile harness Script")
            }
            return
        },
    };
    match context.execute_script(harness) {
        Ok(_) => (),
        Err(error) => {
            testing::fail(error.kind.debug());
            return
        },
    }
    let namespace = match execute_source(
        context,
        global,
        "__gomlquickjs_global_lexical_module__.mjs",
        "const moduleLocal = 2; export const result = harnessLexical + moduleLocal;",
    ) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "result"), 42);
    let probe = match compiler::compile_script("typeof moduleLocal;") {
        Ok(value) => value,
        Err(_) => {
            testing::fail("cannot compile Script probe");
            return
        },
    };
    match context.execute_script(probe) {
        Ok(value) => module_expect_string(value, "undefined"),
        Err(error) => testing::fail(error.kind.debug()),
    }
}

#[test]
fn named_imports_aliases_and_live_bindings_execute() -> () {
    let directory = "__gomlquickjs_modules_named_7d31__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/dependency.js",
        "export let counter = 1; export function increment() { counter += 1; }",
    );
    module_write(
        directory + "/entry.js",
        "import {counter, increment as bump} from './dependency.js'; bump(); export const result = counter;",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "result"), 2);
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn cyclic_namespace_imports_observe_initialized_exports() -> () {
    let directory = "__gomlquickjs_modules_cycle_62ac__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/entry.js",
        "import * as dependency from './dependency.js'; export let value = 1; export function read() { return dependency.read(); } value = 3; export const result = read();",
    );
    module_write(
        directory + "/dependency.js",
        "import * as entry from './entry.js'; export function read() { return entry.value; }",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "result"), 3);
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn cyclic_dependencies_can_call_instantiated_function_exports() -> () {
    let directory = "__gomlquickjs_modules_cycle_function_74b3__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/entry.js",
        "import './dependency.js'; export function mark() { globalThis.cycleFunction = 'ready'; } export const result = globalThis.cycleFunction;",
    );
    module_write(directory + "/dependency.js", "import {mark} from './entry.js'; mark();");
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_string(module_read(context, namespace, "result"), "ready");
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn self_imports_and_namespaces_observe_uninitialized_exports() -> () {
    let directory = "__gomlquickjs_modules_tdz_7f2a__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/entry.js",
        "import {value as imported} from './entry.js'; import * as self from './entry.js'; let direct = false; try { imported; } catch (error) { direct = error.name === 'ReferenceError'; } let reflected = false; try { Object.keys(self); } catch (error) { reflected = error.name === 'ReferenceError'; } export let value = 1; export const result = direct && reflected;",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    match module_read(context, namespace, "result") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected TDZ checks to succeed"),
    }
    let _ = fs::remove_dir_all(directory);
}

