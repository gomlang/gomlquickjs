#[test]
fn namespace_resolution_omits_ambiguity_and_preserves_shared_namespaces() -> () {
    let directory = "__gomlquickjs_modules_ambiguous_namespace_3bc7__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/left.js", "export const value = 1;");
    module_write(directory + "/right.js", "export const value = 2;");
    module_write(
        directory + "/ambiguous.js",
        "export * from './left.js'; export * from './right.js';",
    );
    module_write(
        directory + "/omitted.js",
        "import * as namespace from './ambiguous.js'; export const result = !('value' in namespace);",
    );
    module_write(directory + "/source.js", "export const item = 42;");
    module_write(directory + "/first.js", "export * as shared from './source.js';");
    module_write(directory + "/second.js", "export * as shared from './source.js';");
    module_write(
        directory + "/combined.js",
        "export * from './first.js'; export * from './second.js';",
    );
    module_write(
        directory + "/shared.js",
        "import {shared} from './combined.js'; export const result = shared.item;",
    );
    let (context, global) = module_test_context();
    let omitted = match execute_file(context, global, directory + "/omitted.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    match module_read(context, omitted, "result") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected ambiguous export omission"),
    }
    let shared = match execute_file(context, global, directory + "/shared.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, shared, "result"), 42);
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn worker_modules_use_isolated_realms_and_share_shared_array_buffers() -> () {
    let directory = "__gomlquickjs_modules_worker_9a4e__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/child.js",
        "import * as os from 'os'; let parent = os.Worker.parent; parent.onmessage = function(e) { e.data.buf[2] = 10; parent.postMessage({buf: e.data.buf}); }; parent.postMessage({ready: true});",
    );
    module_write(
        directory + "/entry.js",
        "import * as os from 'os'; export let result = 0; let worker = new os.Worker('./child.js'); worker.onmessage = function(e) { if (e.data.ready) { let shared = new SharedArrayBuffer(8); worker.postMessage({buf: new Uint8Array(shared)}); } else { result = e.data.buf[2]; worker.onmessage = null; } };",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "result"), 10);
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn dynamic_import_resolves_cached_namespaces_and_rejects_failures() -> () {
    let directory = "__gomlquickjs_modules_dynamic_4d17__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/dependency.js", "export const answer = 42;");
    module_write(directory + "/throws.js", "throw globalThis.dynamicImportMarker;");
    module_write(
        directory + "/entry.js",
        "export let result = 0; export let converted = 0; export let lateResult = 0; export let rejected = false; export let invalidOptions = false; export let invalidAttributes = false; export let thrownSame = false; export let evaluationThrownSame = false; export function loadLater() { import('./dependency.js').then(function(namespace) { lateResult = namespace.answer; }); } let first = import('./dependency.js'); let second = import('./dependency.js', {with: {type: 'javascript'}}); Promise.all([first, second]).then(function(values) { result = values[0] === values[1] && values[0].answer === 42 ? 42 : -1; }); import({toString() { return './dependency.js'; }}).then(function(namespace) { converted = namespace.answer; }); import('./missing.js').catch(function(error) { rejected = error instanceof ReferenceError; }); import('./dependency.js', 1).catch(function(error) { invalidOptions = error instanceof TypeError; }); import('./dependency.js', {with: {type: 1}}).catch(function(error) { invalidAttributes = error instanceof TypeError; }); let marker = {}; globalThis.dynamicImportMarker = marker; import({toString() { throw marker; }}).catch(function(error) { thrownSame = error === marker; }); import('./throws.js').catch(function(error) { evaluationThrownSame = error === marker; });",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "result"), 42);
    module_expect_number(module_read(context, namespace, "converted"), 42);
    let load_later = module_read(context, namespace, "loadLater");
    let arguments: Vec[runtime::Value] = Vec::new();
    match context.invoke_with_this_at_depth(load_later, arguments, runtime::Value::Undefined, 0) {
        Ok(_) => (),
        Err(error) => testing::fail(error.kind.debug()),
    }
    match context.run_pending_jobs() {
        Ok(_) => (),
        Err(error) => testing::fail(error.kind.debug()),
    }
    module_expect_number(module_read(context, namespace, "lateResult"), 42);
    for name in Vec::from_array(
        ["rejected", "invalidOptions", "invalidAttributes", "thrownSame", "evaluationThrownSame"],
    ) {
        match module_read(context, namespace, name) {
            runtime::Value::Bool(value) => testing::assert(value),
            _ => testing::fail("expected dynamic import rejection status"),
        }
    }
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn static_and_dynamic_json_modules_share_default_exports() -> () {
    let directory = "__gomlquickjs_modules_json_71be__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/data.json", "{\"answer\":42,\"items\":[1,2,3]}");
    module_write(directory + "/other.json", "{\"name\":\"other\"}");
    module_write(
        directory + "/entry.js",
        "import data from './data.json' with {type: 'json'}; export {default as other} from './other.json' with {type: 'json'}; export const answer = data.answer; export let dynamicAnswer = 0; export let proxyAnswer = 0; export let proxyReads = 0; export let proxyRejected = false; export let same = false; export let wrongTypeRejected = false; export let unknownRejected = false; import('./data.json', {with: {type: 'json'}}).then(function(namespace) { dynamicAnswer = namespace.default.answer; same = namespace.default === data; }); let attributes = new Proxy({}, {ownKeys() { return ['type']; }, getOwnPropertyDescriptor() { return {configurable: true, enumerable: true}; }, get() { proxyReads += 1; return 'json'; }}); import('./data.json', {with: attributes}).then(function(namespace) { proxyAnswer = namespace.default.answer; }); let marker = {}; import('./data.json', {with: new Proxy({}, {ownKeys() { throw marker; }})}).catch(function(error) { proxyRejected = error === marker; }); import('./data.json').catch(function(error) { wrongTypeRejected = error instanceof TypeError; }); import('./data.json', {with: {unknown: 'x'}}).catch(function(error) { unknownRejected = error instanceof TypeError; });",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "answer"), 42);
    module_expect_number(module_read(context, namespace, "dynamicAnswer"), 42);
    module_expect_number(module_read(context, namespace, "proxyAnswer"), 42);
    module_expect_number(module_read(context, namespace, "proxyReads"), 1);
    for name in Vec::from_array(["same", "proxyRejected", "wrongTypeRejected", "unknownRejected"]) {
        match module_read(context, namespace, name) {
            runtime::Value::Bool(value) => testing::assert(value),
            _ => testing::fail("expected JSON module status"),
        }
    }
    let other = module_read(context, namespace, "other");
    match module_read(context, other, "name") {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, "other"),
            Err(_) => testing::fail("expected JSON string"),
        },
        _ => testing::fail("expected JSON re-export"),
    }
    module_write(
        directory + "/invalid.js",
        "import data from './data.json' with {unknown: 'x'}; export default data;",
    );
    match execute_file(context, global, directory + "/invalid.js") {
        Err(error) => {
            testing::assert(error.kind == ModuleErrorKind::Syntax);
            testing::assert(error.message.contains("not supported"))
        },
        Ok(_) => testing::fail("expected unsupported static import attribute"),
    }
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn import_meta_is_stable_null_prototype_and_module_specific() -> () {
    let directory = "__gomlquickjs_modules_meta_2c81__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/dependency.js",
        "export const meta = import.meta; export function readMeta() { return import.meta; }",
    );
    module_write(
        directory + "/entry.js",
        "import {meta as dependencyMeta, readMeta} from './dependency.js'; import * as dependencyNamespace from './dependency.js'; export {readMeta}; export const meta = import.meta; export const dependency = dependencyMeta; export const dependencyStable = dependencyMeta === readMeta(); export const namespaceTag = Object.prototype.toString.call(dependencyNamespace); export const namespaceExtensible = Object.isExtensible(dependencyNamespace); let descriptor = Object.getOwnPropertyDescriptor(dependencyNamespace, 'meta'); export const namespaceDescriptor = descriptor.value === dependencyMeta && descriptor.writable && descriptor.enumerable && !descriptor.configurable; export const namespaceDefine = Reflect.defineProperty(dependencyNamespace, 'meta', {}) && !Reflect.defineProperty(dependencyNamespace, 'meta', {value: null}); export const namespaceSet = !Reflect.set(dependencyNamespace, 'meta', dependencyMeta); export let evalRejected = false; try { eval('import.meta'); } catch (error) { evalRejected = error instanceof SyntaxError; }",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    let entry_meta = module_read(context, namespace, "meta");
    let dependency_meta = module_read(context, namespace, "dependency");
    testing::assert(!runtime::same_value(entry_meta, dependency_meta));
    match module_read(context, namespace, "dependencyStable") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected stable dependency import.meta"),
    }
    match module_read(context, namespace, "evalRejected") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected direct eval import.meta rejection"),
    }
    match module_read(context, namespace, "namespaceTag") {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, "[object Module]"),
            Err(_) => testing::fail("expected module namespace tag string"),
        },
        _ => testing::fail("expected module namespace tag"),
    }
    match module_read(context, namespace, "namespaceExtensible") {
        runtime::Value::Bool(value) => testing::assert(!value),
        _ => testing::fail("expected non-extensible module namespace"),
    }
    for name in Vec::from_array(["namespaceDescriptor", "namespaceDefine", "namespaceSet"]) {
        match module_read(context, namespace, name) {
            runtime::Value::Bool(value) => testing::assert(value),
            _ => testing::fail("expected module namespace property semantics"),
        }
    }
    let read_meta = module_read(context, namespace, "readMeta");
    let arguments: Vec[runtime::Value] = Vec::new();
    match context.invoke_with_this_at_depth(read_meta, arguments, runtime::Value::Undefined, 0) {
        Ok(value) => testing::assert(runtime::same_value(value, dependency_meta)),
        Err(error) => testing::fail(error.kind.debug()),
    }
    match module_read(context, entry_meta, "main") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected entry import.meta.main"),
    }
    match module_read(context, dependency_meta, "main") {
        runtime::Value::Bool(value) => testing::assert(!value),
        _ => testing::fail("expected dependency import.meta.main"),
    }
    match module_read(context, entry_meta, "url") {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert(value.ends_with("/entry.js")),
            Err(_) => testing::fail("expected import.meta.url string"),
        },
        _ => testing::fail("expected entry import.meta.url"),
    }
    match context.get_prototype_of_at_depth(entry_meta, 0) {
        Ok(runtime::Value::Null) => (),
        Ok(_) => testing::fail("expected null import.meta prototype"),
        Err(error) => testing::fail(error.kind.debug()),
    }
    let _ = fs::remove_dir_all(directory);
}
