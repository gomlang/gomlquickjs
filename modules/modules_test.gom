#[test]
fn missing_named_exports_fail_during_instantiation() -> () {
    let directory = "__gomlquickjs_modules_missing_171e__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/source.js", "export const present = 1;");
    module_write(directory + "/entry.js", "import {missing} from './source.js'; export {missing};");
    let (context, global) = module_test_context();
    match execute_file(context, global, directory + "/entry.js") {
        Err(error) => {
            testing::assert(error.kind == ModuleErrorKind::Syntax);
            testing::assert(error.runtime_type.is_none());
            testing::assert(error.message.contains("no export named `missing`"))
        },
        Ok(_) => testing::fail("expected module instantiation error"),
    }
    let _ = fs::remove_dir_all(directory);
}

