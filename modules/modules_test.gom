#[test]
fn combined_imports_namespace_reexports_and_default_declarations_link() -> () {
    let directory = "__gomlquickjs_modules_combined_89c4__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/source.js",
        "export let named = 20; export const extra = 2; const stringValue = 5; export {stringValue as 'string-name'}; export const before = call(19); export default function call(value) { return value + 1; } export const after = call(20); export const regularBefore = regular(); export function regular() { return 3; }",
    );
    module_write(
        directory + "/middle.js",
        "import {'string-name' as importedString} from './source.js'; export * as source from './source.js' with {type: 'javascript'}; export {default} from './source.js'; export {importedString as renamed};",
    );
    module_write(
        directory + "/function.js",
        "export default function mutable() { return mutable; } export const old = mutable; mutable = 1; export const rebound = old() === 1;",
    );
    module_write(
        directory + "/class.js",
        "export default class Mutable {} Mutable = 7; export const rebound = Mutable;",
    );
    module_write(
        directory + "/entry.js",
        "import call, {named, extra, before, after, regularBefore, regular, 'string-name' as stringName} from './source.js'; import fallback, * as source from './source.js' with {type: 'javascript'}; import middleDefault, * as middle from './middle.js'; import functionValue, {rebound as functionRebound} from './function.js'; import classValue, {rebound as classRebound} from './class.js'; export const result = call(named) + extra + fallback(0) + middleDefault(1) + stringName + middle.renamed + before + after; export const identity = source === middle.source && source.default === call && source['string-name'] === stringName; export const names = call.name + '|' + fallback.name + '|' + middleDefault.name; export const hoisted = regularBefore === 3 && regular() === 3; export const declarations = functionValue === 1 && functionRebound && classValue === 7 && classRebound === 7;",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "result"), 77);
    match module_read(context, namespace, "identity") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected namespace identity result"),
    }
    match module_read(context, namespace, "hoisted") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected exported function hoisting result"),
    }
    match module_read(context, namespace, "declarations") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected default declaration binding result"),
    }
    module_expect_string(module_read(context, namespace, "names"), "call|call|call");
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn exported_async_functions_resume_in_their_module_realm() -> () {
    let directory = "__gomlquickjs_modules_async_5f29__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/dependency.js",
        "export async function increment(value) { return await Promise.resolve(value) + 1; } export default async function double(value) { return await value * 2; }",
    );
    module_write(
        directory + "/entry.js",
        "import double from './dependency.js'; import {increment} from './dependency.js'; export let result = 0; Promise.all([increment(20), double(10)]).then(values => result = values[0] + values[1] + 1);",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "result"), 42);
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn top_level_await_blocks_dependents_and_dynamic_imports() -> () {
    let directory = "__gomlquickjs_modules_tla_4ac2__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/dependency.js",
        "export let order = 'd'; let value = await Promise.resolve(40); order += 'x'; export const answer = value + 2;",
    );
    module_write(
        directory + "/dynamic.js",
        "let value = await Promise.resolve(21); export const answer = value * 2;",
    );
    module_write(
        directory + "/entry.js",
        "import {answer, order} from './dependency.js'; export const staticAnswer = answer; export const dependencyOrder = order; export let dynamicAnswer = 0; import('./dynamic.js').then(namespace => dynamicAnswer = namespace.answer);",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "staticAnswer"), 42);
    module_expect_number(module_read(context, namespace, "dynamicAnswer"), 42);
    match module_read(context, namespace, "dependencyOrder") {
        runtime::Value::String(value) => match value.to_host_string() {
            Ok(value) => testing::assert_eq(value, "dx"),
            Err(_) => testing::fail("expected dependency order string"),
        },
        _ => testing::fail("expected dependency order"),
    }
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn repeated_dynamic_imports_wait_and_settle_in_request_order() -> () {
    let directory = "__gomlquickjs_modules_dynamic_wait_5e29__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/empty.js", "");
    module_write(
        directory + "/waiting.js",
        "globalThis.dynamicStarted(); await globalThis.dynamicGate; export const value = 42;",
    );
    module_write(
        directory + "/entry.js",
        "let start; let release; globalThis.dynamicStart = new Promise(resolve => start = resolve); globalThis.dynamicStarted = start; globalThis.dynamicGate = new Promise(resolve => release = resolve); export let order = ''; export let done = false; let first = import('./waiting.js'); globalThis.dynamicStart.then(() => { let second = import('./waiting.js'); first.then(() => order += '1'); second.then(() => order += '2'); import('./empty.js').then(release); Promise.all([first, second]).then(() => done = true); });",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_string(module_read(context, namespace, "order"), "12");
    match module_read(context, namespace, "done") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected repeated imports to settle"),
    }
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn top_level_await_rejection_propagates_from_dependencies() -> () {
    let directory = "__gomlquickjs_modules_tla_reject_913b__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/dependency.js",
        "await Promise.reject(new TypeError('top-level boom')); export const answer = 42;",
    );
    module_write(
        directory + "/entry.js",
        "import {answer} from './dependency.js'; export const result = answer;",
    );
    let (context, global) = module_test_context();
    match execute_file(context, global, directory + "/entry.js") {
        Err(error) => {
            if !error.path.ends_with("/dependency.js") {
                testing::fail("unexpected rejection path: " + error.path)
            }
            if !error.message.contains("top-level boom") {
                testing::fail("unexpected rejection message: " + error.message)
            }
            testing::assert(error.runtime_type == Option::Some("TypeError"))
        },
        Ok(_) => testing::fail("expected top-level await rejection"),
    }
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn sibling_top_level_await_modules_start_before_jobs_resume() -> () {
    let directory = "__gomlquickjs_modules_tla_siblings_a187__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/a.js",
        "globalThis.tlaLog = (globalThis.tlaLog || '') + 'a0,'; await Promise.resolve(); globalThis.tlaLog += 'a1,';",
    );
    module_write(
        directory + "/b.js",
        "globalThis.tlaLog = (globalThis.tlaLog || '') + 'b0,'; await Promise.resolve(); globalThis.tlaLog += 'b1,';",
    );
    module_write(
        directory + "/entry.js",
        "import './a.js'; import './b.js'; export const order = globalThis.tlaLog + 'entry';",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_string(module_read(context, namespace, "order"), "a0,b0,a1,b1,entry");
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn cyclic_top_level_await_components_resume_in_dependency_order() -> () {
    let directory = "__gomlquickjs_modules_tla_cycle_c941__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(
        directory + "/a.js",
        "import './b.js'; globalThis.tlaLog = (globalThis.tlaLog || '') + 'a0,'; await Promise.resolve(); globalThis.tlaLog += 'a1,';",
    );
    module_write(
        directory + "/b.js",
        "import './a.js'; globalThis.tlaLog = (globalThis.tlaLog || '') + 'b0,'; await Promise.resolve(); globalThis.tlaLog += 'b1,';",
    );
    module_write(
        directory + "/entry.js",
        "import './a.js'; export const order = globalThis.tlaLog + 'entry';",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_string(module_read(context, namespace, "order"), "b0,b1,a0,a1,entry");
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn cyclic_top_level_await_rejection_preserves_value_and_skips_ancestors() -> () {
    let directory = "__gomlquickjs_modules_tla_cycle_reject_851e__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/a.js", "import './b.js'; globalThis.tlaLog += 'a';");
    module_write(
        directory + "/b.js",
        "import './a.js'; globalThis.tlaLog = 'b'; globalThis.tlaMarker = {}; await Promise.reject(globalThis.tlaMarker);",
    );
    module_write(
        directory + "/entry.js",
        "export let same = false; export let order = ''; import('./a.js').catch(error => { same = error === globalThis.tlaMarker; order = globalThis.tlaLog; });",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    match module_read(context, namespace, "same") {
        runtime::Value::Bool(value) => testing::assert(value),
        _ => testing::fail("expected rejection identity status"),
    }
    module_expect_string(module_read(context, namespace, "order"), "b");
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn bare_module_specifiers_load_from_the_process_working_directory() -> () {
    let directory = "__gomlquickjs_modules_bare_entry_f39b__";
    let dependency = "__gomlquickjs_bare_dependency_49da__.js";
    let dynamic = "__gomlquickjs_bare_dynamic_682c__.js";
    let data = "__gomlquickjs_bare_data_318f__.json";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::remove_file(dependency);
    let _ = fs::remove_file(dynamic);
    let _ = fs::remove_file(data);
    let _ = fs::create_dir_all(directory);
    module_write(dependency, "export default 39;");
    module_write(dynamic, "export default 1;");
    module_write(data, "{\"value\":2}");
    module_write(
        directory + "/entry.js",
        "import base from '__gomlquickjs_bare_dependency_49da__.js'; import data from '__gomlquickjs_bare_data_318f__.json' with {type: 'json'}; export const staticTotal = base + data.value; export let dynamicTotal = 0; import('__gomlquickjs_bare_dynamic_682c__.js').then(namespace => dynamicTotal = staticTotal + namespace.default);",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_number(module_read(context, namespace, "staticTotal"), 41);
    module_expect_number(module_read(context, namespace, "dynamicTotal"), 42);
    let _ = fs::remove_dir_all(directory);
    let _ = fs::remove_file(dependency);
    let _ = fs::remove_file(dynamic);
    let _ = fs::remove_file(data);
}

#[test]
fn ambiguous_star_exports_fail_resolution() -> () {
    let directory = "__gomlquickjs_modules_ambiguous_e621__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/left.js", "export const value = 1;");
    module_write(directory + "/right.js", "export const value = 2;");
    module_write(directory + "/middle.js", "export * from './left.js'; export * from './right.js';");
    module_write(directory + "/entry.js", "import {value} from './middle.js'; export {value};");
    let (context, global) = module_test_context();
    match execute_file(context, global, directory + "/entry.js") {
        Err(error) => {
            testing::assert(error.kind == ModuleErrorKind::Syntax);
            testing::assert(error.runtime_type.is_none());
            testing::assert(error.message.contains("ambiguous star export `value`"))
        },
        Ok(_) => testing::fail("expected ambiguous star export error"),
    }
    let _ = fs::remove_dir_all(directory);
}

