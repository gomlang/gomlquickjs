#[test]
fn empty_imports_and_reexports_still_instantiate_dependencies() -> () {
    let directory = "__gomlquickjs_modules_empty_request_0f39__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/dependency.js", "export {");
    let (context, global) = module_test_context();
    for statement in Vec::from_array(
        ["import {} from './dependency.js';", "export {} from './dependency.js';"],
    ) {
        module_write(directory + "/entry.js", statement + " export const result = 1;");
        match execute_file(context, global, directory + "/entry.js") {
            Err(error) => testing::assert(error.kind == ModuleErrorKind::Syntax),
            Ok(_) => testing::fail("expected dependency instantiation error"),
        }
    }
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn requested_dependencies_evaluate_in_source_order() -> () {
    let directory = "__gomlquickjs_modules_request_order_4d81__";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(directory);
    module_write(directory + "/first.js", "globalThis.moduleOrder = '1';");
    module_write(directory + "/second.js", "globalThis.moduleOrder += '2';");
    module_write(directory + "/third.js", "globalThis.moduleOrder += '3';");
    module_write(directory + "/fourth.js", "globalThis.moduleOrder += '4';");
    module_write(
        directory + "/entry.js",
        "import {} from './first.js'; export {} from './second.js'; import * as third from './third.js'; export * as fourth from './fourth.js'; export const result = globalThis.moduleOrder;",
    );
    let (context, global) = module_test_context();
    let namespace = match execute_file(context, global, directory + "/entry.js") {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.path + ": " + error.message);
            runtime::Value::Undefined
        },
    };
    module_expect_string(module_read(context, namespace, "result"), "1234");
    let _ = fs::remove_dir_all(directory);
}

