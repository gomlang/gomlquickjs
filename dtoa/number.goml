package dtoa;

use gomlang::quickjs::bigint;
use std::math;
use std::text;

#[derive(PartialEq, Eq, Debug)]
pub enum DtoaError {
    InvalidRadix(isize),
}

struct BigUInt {
    limbs: Vec[u32],
}

struct BinaryParts {
    mantissa: u64,
    exponent: isize,
}

struct DecimalInput {
    negative: bool,
    coefficient: BigUInt,
    exponent: isize,
    digits: isize,
}

struct DecimalParts {
    negative: bool,
    digits: string,
    exponent: isize,
}

fn positive_infinity() -> f64 {
    let zero = 0.0;
    1.0 / zero
}

fn not_a_number() -> f64 {
    let zero = 0.0;
    zero / zero
}

fn digit_byte(value: u64) -> byte {
    if value < 10 {
        (value + 48).to_u8()
    } else {
        (value + 87).to_u8()
    }
}

pub fn u64_to_string_radix(value: u64, radix: isize) -> Result[string, DtoaError] {
    if radix < 2 || radix > 36 {
        return Result::Err(DtoaError::InvalidRadix(radix))
    }
    if value == 0 {
        return Result::Ok("0")
    }
    let base = radix.to_u64();
    let reversed: Vec[byte] = Vec::new();
    let mut remaining = value;
    while remaining != 0 {
        reversed.push(digit_byte(remaining % base));
        remaining /= base;
    }
    let builder = text::StringBuilder::with_capacity(reversed.len());
    let mut index = reversed.len();
    while index > 0 {
        builder.values.push(reversed[index - 1]);
        index -= 1;
    }
    Result::Ok(builder.finish())
}

pub fn i64_to_string_radix(value: i64, radix: isize) -> Result[string, DtoaError] {
    let negative = value < 0;
    let magnitude = if negative {
        (-(value + 1)).to_u64() + 1
    } else {
        value.to_u64()
    };
    let digits = u64_to_string_radix(magnitude, radix)?;
    Result::Ok(
        if negative {
            "-" + digits
        } else {
            digits
        },
    )
}

fn decimal_u64(value: u64) -> string {
    match u64_to_string_radix(value, 10) {
        Ok(result) => result,
        Err(_) => "",
    }
}

fn big_zero() -> BigUInt {
    BigUInt { limbs: Vec::from_array([0.to_u32()]) }
}

fn big_one() -> BigUInt {
    BigUInt { limbs: Vec::from_array([1.to_u32()]) }
}

fn big_from_u64(value: u64) -> BigUInt {
    let limbs = Vec::from_array([(value & 0xffffffff).to_u32()]);
    let high = (value >> 32).to_u32();
    if high != 0 {
        limbs.push(high)
    }
    BigUInt { limbs }
}

fn big_from_integer(value: bigint::BigInteger) -> BigUInt {
    BigUInt { limbs: value.limbs() }
}

fn big_clone(value: BigUInt) -> BigUInt {
    let limbs = Vec::with_capacity(value.limbs.len());
    for limb in value.limbs {
        limbs.push(limb)
    }
    BigUInt { limbs }
}

fn big_normalize(value: BigUInt) -> () {
    let mut length = value.limbs.len();
    while length > 1 && value.limbs[length - 1] == 0 {
        length -= 1;
    }
    value.limbs.truncate(length)
}

fn big_is_zero(value: BigUInt) -> bool {
    value.limbs.len() == 1 && value.limbs[0] == 0
}

fn big_mul_small(value: BigUInt, factor: u32) -> () {
    let mut carry = 0.to_u64();
    let mut index = 0;
    while index < value.limbs.len() {
        let product = value.limbs[index].to_u64() * factor.to_u64() + carry;
        value.limbs[index] = (product & 0xffffffff).to_u32();
        carry = product >> 32;
        index += 1;
    }
    if carry != 0 {
        value.limbs.push(carry.to_u32())
    }
}

fn big_add_small(value: BigUInt, addend: u32) -> () {
    let mut carry = addend.to_u64();
    let mut index = 0;
    while carry != 0 {
        if index == value.limbs.len() {
            value.limbs.push(carry.to_u32());
            carry = 0;
        } else {
            let sum = value.limbs[index].to_u64() + carry;
            value.limbs[index] = (sum & 0xffffffff).to_u32();
            carry = sum >> 32;
            index += 1;
        }
    }
}

fn big_pow5(exponent: isize) -> BigUInt {
    let result = big_one();
    let mut index = 0;
    while index < exponent {
        big_mul_small(result, 5.to_u32());
        index += 1;
    }
    result
}

fn big_shift_left(value: BigUInt, shift: isize) -> BigUInt {
    if shift == 0 {
        return big_clone(value)
    }
    let word_shift = shift / 32;
    let bit_shift = shift % 32;
    let limbs = Vec::with_capacity(value.limbs.len() + word_shift + 1);
    let mut index = 0;
    while index < word_shift {
        limbs.push(0.to_u32());
        index += 1;
    }
    let mut carry = 0.to_u64();
    for limb in value.limbs {
        let shifted = (limb.to_u64() << bit_shift) | carry;
        limbs.push((shifted & 0xffffffff).to_u32());
        carry = shifted >> 32;
    }
    if carry != 0 {
        limbs.push(carry.to_u32())
    }
    BigUInt { limbs }
}

fn big_compare(left: BigUInt, right: BigUInt) -> isize {
    if left.limbs.len() < right.limbs.len() {
        return -1
    } else if left.limbs.len() > right.limbs.len() {
        return 1
    }
    let mut index = left.limbs.len();
    while index > 0 {
        let offset = index - 1;
        if left.limbs[offset] < right.limbs[offset] {
            return -1
        } else if left.limbs[offset] > right.limbs[offset] {
            return 1
        }
        index -= 1;
    }
    0
}

fn big_scaled_compare(left: BigUInt, left_exponent: isize, right: BigUInt, right_exponent: isize) -> isize {
    if left_exponent > right_exponent {
        big_compare(big_shift_left(left, left_exponent - right_exponent), right)
    } else if right_exponent > left_exponent {
        big_compare(left, big_shift_left(right, right_exponent - left_exponent))
    } else {
        big_compare(left, right)
    }
}

fn big_subtract(left: BigUInt, right: BigUInt) -> () {
    let base = 1.to_u64() << 32;
    let mut borrow = 0.to_u64();
    let mut index = 0;
    while index < left.limbs.len() {
        let right_limb = if index < right.limbs.len() {
            right.limbs[index].to_u64()
        } else {
            0.to_u64()
        };
        let left_limb = left.limbs[index].to_u64();
        let subtrahend = right_limb + borrow;
        if left_limb >= subtrahend {
            left.limbs[index] = (left_limb - subtrahend).to_u32();
            borrow = 0;
        } else {
            left.limbs[index] = (base + left_limb - subtrahend).to_u32();
            borrow = 1;
        }
        index += 1;
    }
    big_normalize(left)
}

fn uint32_bit_length(value: u32) -> isize {
    let mut remaining = value;
    let mut length = 0;
    while remaining != 0 {
        remaining >>= 1;
        length += 1;
    }
    length
}

fn big_bit_length(value: BigUInt) -> isize {
    if big_is_zero(value) {
        0
    } else {
        (value.limbs.len() - 1) * 32 + uint32_bit_length(value.limbs[value.limbs.len() - 1])
    }
}

fn big_round_ratio_with_ties(numerator: BigUInt, denominator: BigUInt, ties_to_even: bool) -> u64 {
    let remainder = big_clone(numerator);
    let mut quotient = 0.to_u64();
    let mut shift = big_bit_length(remainder) - big_bit_length(denominator);
    while shift >= 0 {
        let shifted = big_shift_left(denominator, shift);
        if big_compare(remainder, shifted) >= 0 {
            big_subtract(remainder, shifted);
            quotient |= 1.to_u64() << shift;
        }
        shift -= 1;
    }
    let doubled = big_shift_left(remainder, 1);
    let rounding = big_compare(doubled, denominator);
    if rounding > 0 || rounding == 0 && (!ties_to_even || quotient & 1 == 1) {
        quotient + 1
    } else {
        quotient
    }
}

fn big_round_ratio(numerator: BigUInt, denominator: BigUInt) -> u64 {
    big_round_ratio_with_ties(numerator, denominator, true)
}

fn round_scaled_ratio(numerator: BigUInt, denominator: BigUInt, shift: isize) -> u64 {
    if shift >= 0 {
        big_round_ratio(big_shift_left(numerator, shift), denominator)
    } else {
        big_round_ratio(numerator, big_shift_left(denominator, -shift))
    }
}

fn round_scaled_ratio_half_up(numerator: BigUInt, denominator: BigUInt, shift: isize) -> u64 {
    if shift >= 0 {
        big_round_ratio_with_ties(big_shift_left(numerator, shift), denominator, false)
    } else {
        big_round_ratio_with_ties(numerator, big_shift_left(denominator, -shift), false)
    }
}

fn uint64_to_float_exact(value: u64) -> f64 {
    let mut result = 0.0;
    let mut index = 64;
    while index > 0 {
        result *= 2.0;
        if value & (1.to_u64() << (index - 1)) != 0 {
            result += 1.0;
        }
        index -= 1;
    }
    result
}

fn scale_power_of_two(value: f64, exponent: isize) -> f64 {
    let mut result = value;
    let mut remaining = exponent;
    while remaining > 0 {
        result *= 2.0;
        remaining -= 1;
    }
    while remaining < 0 {
        result *= 0.5;
        remaining += 1;
    }
    result
}

fn signed_zero(negative: bool) -> f64 {
    let zero = 0.0;
    if negative {
        -zero
    } else {
        zero
    }
}

fn rational_to_float(
    numerator: BigUInt,
    denominator: BigUInt,
    binary_exponent: isize,
    negative: bool,
) -> f64 {
    if big_is_zero(numerator) {
        return signed_zero(negative)
    }
    let mut ratio_exponent = big_bit_length(numerator) - big_bit_length(denominator);
    if big_scaled_compare(numerator, 0, denominator, ratio_exponent) < 0 {
        ratio_exponent -= 1;
    }
    let mut exponent = ratio_exponent + binary_exponent;
    if exponent > 1023 {
        return if negative {
            -positive_infinity()
        } else {
            positive_infinity()
        }
    } else if exponent < -1075 {
        return signed_zero(negative)
    }
    let mut significand = if exponent >= -1022 {
        round_scaled_ratio(numerator, denominator, binary_exponent + 52 - exponent)
    } else {
        round_scaled_ratio(numerator, denominator, binary_exponent + 1074)
    };
    let result = if exponent >= -1022 {
        if significand >= (1.to_u64() << 53) {
            significand >>= 1;
            exponent += 1;
        }
        if exponent > 1023 {
            positive_infinity()
        } else {
            scale_power_of_two(uint64_to_float_exact(significand), exponent - 52)
        }
    } else {
        scale_power_of_two(uint64_to_float_exact(significand), -1074)
    };
    if negative {
        -result
    } else {
        result
    }
}

fn decimal_coefficient_to_float(coefficient: BigUInt, exponent: isize, negative: bool) -> f64 {
    if exponent >= 0 {
        let numerator = big_clone(coefficient);
        let mut remaining = exponent;
        while remaining > 0 {
            big_mul_small(numerator, 5.to_u32());
            remaining -= 1;
        }
        rational_to_float(numerator, big_one(), exponent, negative)
    } else {
        rational_to_float(coefficient, big_pow5(-exponent), exponent, negative)
    }
}

fn radix_digit(value: byte) -> Option[isize] {
    if value >= b'0' && value <= b'9' {
        Option::Some((value - b'0').to_isize())
    } else if value >= b'a' && value <= b'z' {
        Option::Some((value - b'a' + 10).to_isize())
    } else if value >= b'A' && value <= b'Z' {
        Option::Some((value - b'A' + 10).to_isize())
    } else {
        Option::None
    }
}

fn parse_radix_number(value: string, radix: isize) -> Option[f64] {
    if value.byte_len() <= 2 {
        return Option::None
    }
    let integer = big_zero();
    let mut index = 2;
    while index < value.byte_len() {
        let digit = match radix_digit(value.byte_get(index)) {
            Some(digit) => digit,
            None => return Option::None,
        };
        if digit >= radix {
            return Option::None
        }
        big_mul_small(integer, radix.to_u32());
        big_add_small(integer, digit.to_u32());
        index += 1;
    }
    Option::Some(rational_to_float(integer, big_one(), 0, false))
}

fn parse_decimal_input(value: string) -> Option[DecimalInput] {
    let mut index = 0;
    let mut negative = false;
    if index < value.byte_len() && (value.byte_get(index) == b'+' || value.byte_get(index) == b'-') {
        negative = value.byte_get(index) == b'-';
        index += 1;
    }
    let digits: Vec[byte] = Vec::new();
    while index < value.byte_len() && value.byte_get(index) >= b'0' && value.byte_get(index) <= b'9' {
        digits.push(value.byte_get(index));
        index += 1;
    }
    let mut fractional_digits = 0;
    if index < value.byte_len() && value.byte_get(index) == b'.' {
        index += 1;
        while index < value.byte_len() && value.byte_get(index) >= b'0'
            && value.byte_get(index) <= b'9' {
            digits.push(value.byte_get(index));
            fractional_digits += 1;
            index += 1;
        }
    }
    if digits.len() == 0 {
        return Option::None
    }
    let mut explicit_exponent = 0;
    if index < value.byte_len() && (value.byte_get(index) == b'e' || value.byte_get(index) == b'E') {
        index += 1;
        let mut exponent_negative = false;
        if index < value.byte_len()
            && (value.byte_get(index) == b'+' || value.byte_get(index) == b'-') {
            exponent_negative = value.byte_get(index) == b'-';
            index += 1;
        }
        let exponent_start = index;
        let exponent_limit = value.byte_len() + 10000;
        while index < value.byte_len() && value.byte_get(index) >= b'0'
            && value.byte_get(index) <= b'9' {
            let digit = (value.byte_get(index) - b'0').to_isize();
            if explicit_exponent <= (exponent_limit - digit) / 10 {
                explicit_exponent = explicit_exponent * 10 + digit;
            } else {
                explicit_exponent = exponent_limit;
            }
            index += 1;
        }
        if index == exponent_start {
            return Option::None
        }
        if exponent_negative {
            explicit_exponent = -explicit_exponent;
        }
    }
    if index != value.byte_len() {
        return Option::None
    }
    let mut leading = 0;
    while leading < digits.len() && digits[leading] == b'0' {
        leading += 1;
    }
    if leading == digits.len() {
        return Option::Some(
            DecimalInput { negative, coefficient: big_zero(), exponent: 0, digits: 1 },
        )
    }
    let mut trailing = digits.len();
    while trailing > leading && digits[trailing - 1] == b'0' {
        trailing -= 1;
    }
    let coefficient = big_zero();
    let mut digit_index = leading;
    while digit_index < trailing {
        big_mul_small(coefficient, 10.to_u32());
        big_add_small(coefficient, (digits[digit_index] - b'0').to_u32());
        digit_index += 1;
    }
    Option::Some(
        DecimalInput {
            negative,
            coefficient,
            exponent: explicit_exponent - fractional_digits + digits.len() - trailing,
            digits: trailing - leading,
        },
    )
}

fn parse_decimal_number(value: string) -> Option[f64] {
    let parsed = parse_decimal_input(value)?;
    if big_is_zero(parsed.coefficient) {
        return Option::Some(signed_zero(parsed.negative))
    }
    let decimal_order = parsed.digits + parsed.exponent - 1;
    if decimal_order >= 309 {
        Option::Some(
            if parsed.negative {
                -positive_infinity()
            } else {
                positive_infinity()
            },
        )
    } else if decimal_order <= -325 {
        Option::Some(signed_zero(parsed.negative))
    } else {
        Option::Some(
            decimal_coefficient_to_float(parsed.coefficient, parsed.exponent, parsed.negative),
        )
    }
}

fn is_ecmascript_whitespace(value: char) -> bool {
    value == '\u0009' || value == '\u000b' || value == '\u000c' || value == '\u0020'
        || value == '\u00a0'
        || value == '\u1680'
        || (value >= '\u2000' && value <= '\u200a')
        || value == '\u2028'
        || value == '\u2029'
        || value == '\u202f'
        || value == '\u205f'
        || value == '\u3000'
        || value == '\ufeff'
        || value == '\n'
        || value == '\r'
}

fn trim_numeric_string(value: string) -> string {
    let mut first = -1;
    let mut last = 0;
    let mut index = 0;
    while index < value.byte_len() {
        match value.decode_at(index) {
            Some((character, width)) => {
                if !is_ecmascript_whitespace(character) {
                    if first < 0 {
                        first = index;
                    }
                    last = index + width;
                }
                index += width;
            },
            None => return value,
        }
    }
    if first < 0 {
        ""
    } else {
        value.byte_slice(first, last)
    }
}

pub fn try_parse_number(value: string) -> Option[f64] {
    let trimmed = trim_numeric_string(value);
    if trimmed == "" {
        Option::Some(0.0)
    } else if trimmed == "Infinity" || trimmed == "+Infinity" {
        Option::Some(positive_infinity())
    } else if trimmed == "-Infinity" {
        Option::Some(-positive_infinity())
    } else if trimmed.byte_len() > 2 && trimmed.byte_get(0) == b'0' {
        match trimmed.byte_get(1) {
            b'b' | b'B' => parse_radix_number(trimmed, 2),
            b'o' | b'O' => parse_radix_number(trimmed, 8),
            b'x' | b'X' => parse_radix_number(trimmed, 16),
            _ => parse_decimal_number(trimmed),
        }
    } else {
        parse_decimal_number(trimmed)
    }
}

pub fn parse_number(value: string) -> f64 {
    match try_parse_number(value) {
        Some(result) => result,
        None => not_a_number(),
    }
}

fn binary_parts(value: f64) -> BinaryParts {
    let bits = value.to_bits();
    let encoded_exponent = ((bits >> 52) & 0x7ff).to_isize();
    let fraction = bits & 0x000fffffffffffff;
    if encoded_exponent != 0 {
        BinaryParts {
            mantissa: fraction | (1.to_u64() << 52),
            exponent: encoded_exponent - 1023 - 52,
        }
    } else {
        let mut mantissa = fraction;
        let mut exponent = -1074;
        while mantissa < 1.to_u64() << 52 {
            mantissa <<= 1;
            exponent -= 1;
        }
        BinaryParts { mantissa, exponent }
    }
}

fn compare_binary_to_power10(parts: BinaryParts, exponent: isize) -> isize {
    if exponent >= 0 {
        big_scaled_compare(
            big_from_u64(parts.mantissa),
            parts.exponent,
            big_pow5(exponent),
            exponent,
        )
    } else {
        let left = big_from_u64(parts.mantissa);
        let mut remaining = -exponent;
        while remaining > 0 {
            big_mul_small(left, 5.to_u32());
            remaining -= 1;
        }
        big_scaled_compare(left, parts.exponent - exponent, big_one(), 0)
    }
}

fn decimal_order(parts: BinaryParts) -> isize {
    let binary_order = parts.exponent + 52;
    let mut order = binary_order * 301 / 1000;
    while compare_binary_to_power10(parts, order + 1) >= 0 {
        order += 1;
    }
    while compare_binary_to_power10(parts, order) < 0 {
        order -= 1;
    }
    order
}

fn fast_decimal_order(value: f64) -> Option[isize] {
    if value < 1.0 || value >= 1000000000000000.0 {
        return Option::None
    }
    let mut order = 0;
    let mut threshold = 10.0;
    while value >= threshold {
        threshold *= 10.0;
        order += 1;
    }
    Option::Some(order)
}

fn exact_binary_ratio(parts: BinaryParts) -> (bigint::BigInteger, bigint::BigInteger) {
    let numerator = bigint::BigInteger::from_uint64(parts.mantissa);
    if parts.exponent >= 0 {
        let numerator = match numerator.shift_left(parts.exponent) {
            Ok(value) => value,
            Err(_) => bigint::BigInteger::zero(),
        };
        (numerator, bigint::BigInteger::one())
    } else {
        let denominator = match bigint::BigInteger::one().shift_left(-parts.exponent) {
            Ok(value) => value,
            Err(_) => bigint::BigInteger::one(),
        };
        (numerator, denominator)
    }
}

fn decimal_power(exponent: isize) -> bigint::BigInteger {
    let ten = bigint::BigInteger::from_uint64(10);
    let mut value = bigint::BigInteger::one();
    let mut index = 0;
    while index < exponent {
        value = value.multiply(ten);
        index += 1;
    }
    value
}

fn small_decimal_factor(exponent: isize) -> Option[f64] {
    match exponent {
        0 => Option::Some(1.0),
        1 => Option::Some(10.0),
        2 => Option::Some(100.0),
        3 => Option::Some(1000.0),
        4 => Option::Some(10000.0),
        5 => Option::Some(100000.0),
        6 => Option::Some(1000000.0),
        7 => Option::Some(10000000.0),
        8 => Option::Some(100000000.0),
        9 => Option::Some(1000000000.0),
        10 => Option::Some(10000000000.0),
        11 => Option::Some(100000000000.0),
        12 => Option::Some(1000000000000.0),
        13 => Option::Some(10000000000000.0),
        14 => Option::Some(100000000000000.0),
        15 => Option::Some(1000000000000000.0),
        _ => Option::None,
    }
}

fn positive_integral_float_to_u64(value: f64) -> u64 {
    if value == 0.0 {
        return 0
    }
    let bits = value.to_bits();
    let exponent = ((bits >> 52) & 0x7ff).to_isize() - 1023;
    let mantissa = bits & 0x000fffffffffffff | 1.to_u64() << 52;
    if exponent >= 52 {
        mantissa << (exponent - 52)
    } else {
        mantissa >> (52 - exponent)
    }
}

fn fast_rounded_decimal_integer(value: f64, scale: isize) -> Option[u64] {
    let factor = small_decimal_factor(
        if scale < 0 {
            -scale
        } else {
            scale
        },
    )?;
    let scaled = if scale < 0 {
        value * factor
    } else {
        value / factor
    };
    if scaled >= 4503599627370496.0 {
        return Option::None
    }
    let lower = math::floor(scaled);
    let fraction = scaled - lower;
    let distance = if fraction >= 0.5 {
        fraction - 0.5
    } else {
        0.5 - fraction
    };
    if distance <= scaled * 0.0000000000000002220446049250313 + 0.000000000001 {
        Option::None
    } else {
        Option::Some(positive_integral_float_to_u64(math::floor(scaled + 0.5)))
    }
}

fn rounded_scaled_integer(parts: BinaryParts, decimal_scale: isize) -> bigint::BigInteger {
    let (mut numerator, mut denominator) = exact_binary_ratio(parts);
    if decimal_scale >= 0 {
        numerator = numerator.multiply(decimal_power(decimal_scale));
    } else {
        denominator = denominator.multiply(decimal_power(-decimal_scale));
    }
    let (mut quotient, remainder) = match numerator.div_rem(denominator) {
        Ok(value) => value,
        Err(_) => return bigint::BigInteger::zero(),
    };
    if remainder.add(remainder).compare(denominator) >= 0 {
        quotient = quotient.add(bigint::BigInteger::one());
    }
    quotient
}

fn exact_precision_parts(value: f64, negative: bool, precision: isize) -> DecimalParts {
    let parts = binary_parts(value);
    let mut order = match fast_decimal_order(value) {
        Some(value) => value,
        None => decimal_order(parts),
    };
    let mut digits = if precision <= 19 {
        let scale = order - precision + 1;
        decimal_u64(
            fast_rounded_decimal_integer(value, scale).unwrap_or_else(
                || {
                    rounded_decimal_integer(parts, scale, false)
                },
            ),
        )
    } else {
        rounded_scaled_integer(parts, precision - 1 - order).to_string_radix(10).unwrap_or("0")
    };
    if digits.byte_len() > precision {
        digits = digits.byte_slice(0, precision);
        order += 1;
    } else if digits.byte_len() < precision {
        let builder = text::StringBuilder::with_capacity(precision);
        write_zeros(builder, precision - digits.byte_len());
        builder.write_string(digits);
        digits = builder.finish();
    }
    DecimalParts { negative, digits, exponent: order + 1 }
}

fn scaled_digits_text(digits: string, fractional_digits: isize, negative: bool) -> string {
    let builder = text::StringBuilder::with_capacity(digits.byte_len() + fractional_digits + 3);
    if negative {
        builder.values.push(b'-')
    }
    if fractional_digits == 0 {
        builder.write_string(digits)
    } else if digits.byte_len() <= fractional_digits {
        builder.write_string("0.");
        write_zeros(builder, fractional_digits - digits.byte_len());
        builder.write_string(digits)
    } else {
        let point = digits.byte_len() - fractional_digits;
        builder.write_string(digits.byte_slice(0, point));
        builder.values.push(b'.');
        builder.write_string(digits.byte_slice(point, digits.byte_len()))
    }
    builder.finish()
}

fn scaled_radix_text(
    coefficient: bigint::BigInteger,
    radix: isize,
    fractional_digits: isize,
    negative: bool,
) -> string {
    scaled_digits_text(
        coefficient.to_string_radix(radix).unwrap_or("0"),
        fractional_digits,
        negative,
    )
}

fn bigint_ratio_to_float(numerator: bigint::BigInteger, denominator: bigint::BigInteger) -> f64 {
    rational_to_float(big_from_integer(numerator), big_from_integer(denominator), 0, false)
}

fn selected_radix_coefficient(
    coefficient: bigint::BigInteger,
    remainder: bigint::BigInteger,
    denominator: bigint::BigInteger,
    truncated_matches: bool,
    rounded_matches: bool,
) -> bigint::BigInteger {
    if !truncated_matches {
        coefficient.add(bigint::BigInteger::one())
    } else if !rounded_matches {
        coefficient
    } else {
        let comparison = remainder.add(remainder).compare(denominator);
        if comparison > 0 {
            coefficient.add(bigint::BigInteger::one())
        } else if comparison < 0 {
            coefficient
        } else {
            let limbs = coefficient.limbs();
            if limbs[0] & 1 == 0 {
                coefficient
            } else {
                coefficient.add(bigint::BigInteger::one())
            }
        }
    }
}

fn shortest_radix_integer(integer: bigint::BigInteger, magnitude: f64, radix: isize) -> bigint::BigInteger {
    let base = bigint::BigInteger::from_uint64(radix.to_u64());
    let mut scale = bigint::BigInteger::one();
    let mut selected = integer;
    let mut discarded = 0;
    while discarded < 2048 {
        scale = scale.multiply(base);
        let (prefix, remainder) = match integer.div_rem(scale) {
            Ok(value) => value,
            Err(_) => return selected,
        };
        let truncated = prefix.multiply(scale);
        let rounded = prefix.add(bigint::BigInteger::one()).multiply(scale);
        let truncated_matches = bigint_ratio_to_float(truncated, bigint::BigInteger::one())
            == magnitude;
        let rounded_matches = bigint_ratio_to_float(rounded, bigint::BigInteger::one()) == magnitude;
        if truncated_matches || rounded_matches {
            selected = if !truncated_matches {
                rounded
            } else if !rounded_matches {
                truncated
            } else {
                let comparison = remainder.add(remainder).compare(scale);
                if comparison > 0 {
                    rounded
                } else if comparison < 0 {
                    truncated
                } else {
                    let limbs = prefix.limbs();
                    if limbs[0] & 1 == 0 {
                        truncated
                    } else {
                        rounded
                    }
                }
            };
            discarded += 1;
        } else {
            return selected
        }
    }
    selected
}

fn rounded_decimal_integer(parts: BinaryParts, scale: isize, ties_to_even: bool) -> u64 {
    let numerator = big_from_u64(parts.mantissa);
    let denominator = big_one();
    let mut binary_exponent = parts.exponent;
    if scale >= 0 {
        let mut remaining = scale;
        while remaining > 0 {
            big_mul_small(denominator, 5.to_u32());
            remaining -= 1;
        }
        binary_exponent -= scale;
    } else {
        let mut remaining = -scale;
        while remaining > 0 {
            big_mul_small(numerator, 5.to_u32());
            remaining -= 1;
        }
        binary_exponent -= scale;
    }
    if ties_to_even {
        round_scaled_ratio(numerator, denominator, binary_exponent)
    } else {
        round_scaled_ratio_half_up(numerator, denominator, binary_exponent)
    }
}

fn rounded_decimal_significand(parts: BinaryParts, scale: isize) -> u64 {
    rounded_decimal_integer(parts, scale, true)
}

fn shortest_decimal_parts(value: f64, negative: bool) -> DecimalParts {
    let parts = binary_parts(value);
    let order = decimal_order(parts);
    let mut precision = 1;
    let mut selected = 0.to_u64();
    let mut selected_scale = order;
    while precision <= 17 && selected == 0 {
        let scale = order - precision + 1;
        let candidate = rounded_decimal_significand(parts, scale);
        let round_trip = decimal_coefficient_to_float(big_from_u64(candidate), scale, false);
        if round_trip == value {
            selected = candidate;
            selected_scale = scale;
        }
        precision += 1;
    }
    if selected == 0 {
        selected_scale = order - 16;
        selected = rounded_decimal_significand(parts, selected_scale);
    }
    while selected % 10 == 0 {
        selected /= 10;
        selected_scale += 1;
    }
    let digits = decimal_u64(selected);
    DecimalParts { negative, exponent: digits.byte_len() + selected_scale, digits }
}

fn write_zeros(builder: text::StringBuilder, count: isize) -> () {
    let mut index = 0;
    while index < count {
        builder.values.push(b'0');
        index += 1;
    }
}

fn write_exponent(builder: text::StringBuilder, value: isize) -> () {
    builder.values.push(b'e');
    if value >= 0 {
        builder.values.push(b'+');
        builder.write_string(decimal_u64(value.to_u64()))
    } else {
        builder.values.push(b'-');
        builder.write_string(decimal_u64((-(value + 1)).to_u64() + 1))
    }
}

fn format_decimal_parts(parts: DecimalParts) -> string {
    let builder = text::StringBuilder::with_capacity(parts.digits.byte_len() + 24);
    if parts.negative {
        builder.values.push(b'-')
    }
    if parts.exponent <= -6 || parts.exponent > 21 {
        builder.values.push(parts.digits.byte_get(0));
        if parts.digits.byte_len() > 1 {
            builder.values.push(b'.');
            builder.write_string(parts.digits.byte_slice(1, parts.digits.byte_len()))
        }
        write_exponent(builder, parts.exponent - 1)
    } else if parts.exponent <= 0 {
        builder.write_string("0.");
        write_zeros(builder, -parts.exponent);
        builder.write_string(parts.digits)
    } else if parts.exponent >= parts.digits.byte_len() {
        builder.write_string(parts.digits);
        write_zeros(builder, parts.exponent - parts.digits.byte_len())
    } else {
        builder.write_string(parts.digits.byte_slice(0, parts.exponent));
        builder.values.push(b'.');
        builder.write_string(parts.digits.byte_slice(parts.exponent, parts.digits.byte_len()))
    }
    builder.finish()
}

fn fast_single_decimal(value: f64) -> Option[string] {
    if value < 0.1 || value >= 1000000000000.0 {
        return Option::None
    }
    let integer = math::floor(value);
    if value != integer + 0.1 {
        return Option::None
    }
    let builder = text::StringBuilder::with_capacity(24);
    builder.write_string(decimal_u64(positive_integral_float_to_u64(integer)));
    builder.write_string(".1");
    Option::Some(builder.finish())
}

pub fn number_to_string(value: f64) -> string {
    if value != value {
        "NaN"
    } else if value == positive_infinity() {
        "Infinity"
    } else if value == -positive_infinity() {
        "-Infinity"
    } else if value == 0.0 {
        "0"
    } else if value >= 0.000001 && value < 1.0e21 || value <= -0.000001 && value > -1.0e21 {
        match fast_single_decimal(value) {
            Some(value) => value,
            None => value.to_string(),
        }
    } else if value < 0.0 {
        format_decimal_parts(shortest_decimal_parts(-value, true))
    } else {
        format_decimal_parts(shortest_decimal_parts(value, false))
    }
}

fn format_exponential_parts(parts: DecimalParts) -> string {
    let builder = text::StringBuilder::with_capacity(parts.digits.byte_len() + 24);
    if parts.negative {
        builder.values.push(b'-')
    }
    builder.values.push(parts.digits.byte_get(0));
    if parts.digits.byte_len() > 1 {
        builder.values.push(b'.');
        builder.write_string(parts.digits.byte_slice(1, parts.digits.byte_len()))
    }
    write_exponent(builder, parts.exponent - 1);
    builder.finish()
}

fn format_precision_parts(parts: DecimalParts) -> string {
    if parts.exponent - 1 < -6 || parts.exponent > parts.digits.byte_len() {
        return format_exponential_parts(parts)
    }
    let builder = text::StringBuilder::with_capacity(parts.digits.byte_len() + 24);
    if parts.negative {
        builder.values.push(b'-')
    }
    if parts.exponent <= 0 {
        builder.write_string("0.");
        write_zeros(builder, -parts.exponent);
        builder.write_string(parts.digits)
    } else if parts.exponent == parts.digits.byte_len() {
        builder.write_string(parts.digits)
    } else {
        builder.write_string(parts.digits.byte_slice(0, parts.exponent));
        builder.values.push(b'.');
        builder.write_string(parts.digits.byte_slice(parts.exponent, parts.digits.byte_len()))
    }
    builder.finish()
}

pub fn number_to_fixed(value: f64, fractional_digits: isize) -> string {
    if value != value || value == positive_infinity() || value == -positive_infinity() {
        return number_to_string(value)
    }
    let negative = value < 0.0;
    let magnitude = if negative {
        -value
    } else {
        value
    };
    if magnitude >= 1.0e21 {
        return number_to_string(value)
    }
    if magnitude == 0.0 {
        return scaled_digits_text("0", fractional_digits, negative)
    }
    let parts = binary_parts(magnitude);
    let order = match fast_decimal_order(magnitude) {
        Some(value) => value,
        None => decimal_order(parts),
    };
    if order + fractional_digits <= 18 {
        let scale = -fractional_digits;
        scaled_digits_text(
            decimal_u64(
                fast_rounded_decimal_integer(magnitude, scale).unwrap_or_else(
                    || {
                        rounded_decimal_integer(parts, scale, false)
                    },
                ),
            ),
            fractional_digits,
            negative,
        )
    } else {
        scaled_radix_text(
            rounded_scaled_integer(parts, fractional_digits),
            10,
            fractional_digits,
            negative,
        )
    }
}

pub fn number_to_exponential(value: f64, fractional_digits: Option[isize]) -> string {
    if value != value || value == positive_infinity() || value == -positive_infinity() {
        return number_to_string(value)
    }
    let negative = value < 0.0;
    let magnitude = if negative {
        -value
    } else {
        value
    };
    let parts = if magnitude == 0.0 {
        let precision = match fractional_digits {
            Some(value) => value + 1,
            None => 1,
        };
        let builder = text::StringBuilder::with_capacity(precision);
        builder.values.push(b'0');
        write_zeros(builder, precision - 1);
        DecimalParts { negative: false, digits: builder.finish(), exponent: 1 }
    } else {
        match fractional_digits {
            Some(value) => exact_precision_parts(magnitude, negative, value + 1),
            None => shortest_decimal_parts(magnitude, negative),
        }
    };
    format_exponential_parts(parts)
}

pub fn number_to_precision(value: f64, precision: Option[isize]) -> string {
    let precision = match precision {
        Some(value) => value,
        None => return number_to_string(value),
    };
    if value != value || value == positive_infinity() || value == -positive_infinity() {
        return number_to_string(value)
    }
    let negative = value < 0.0;
    let magnitude = if negative {
        -value
    } else {
        value
    };
    let parts = if magnitude == 0.0 {
        let builder = text::StringBuilder::with_capacity(precision);
        builder.values.push(b'0');
        write_zeros(builder, precision - 1);
        DecimalParts { negative: false, digits: builder.finish(), exponent: 1 }
    } else {
        exact_precision_parts(magnitude, negative, precision)
    };
    format_precision_parts(parts)
}

pub fn number_to_string_radix(value: f64, radix: isize) -> Result[string, DtoaError] {
    if radix < 2 || radix > 36 {
        return Result::Err(DtoaError::InvalidRadix(radix))
    } else if radix == 10 || value != value || value == positive_infinity()
        || value == -positive_infinity()
        || value == 0.0 {
        return Result::Ok(number_to_string(value))
    }
    let negative = value < 0.0;
    let magnitude = if negative {
        -value
    } else {
        value
    };
    let (numerator, denominator) = exact_binary_ratio(binary_parts(magnitude));
    let (integer, mut remainder) = match numerator.div_rem(denominator) {
        Ok(value) => value,
        Err(_) => return Result::Ok(number_to_string(value)),
    };
    if remainder.is_zero() {
        let selected = shortest_radix_integer(integer, magnitude, radix);
        let digits = selected.to_string_radix(radix).unwrap_or("0");
        return Result::Ok(
            if negative {
                "-" + digits
            } else {
                digits
            },
        )
    }
    let base = bigint::BigInteger::from_uint64(radix.to_u64());
    let mut coefficient = integer;
    let mut scale = bigint::BigInteger::one();
    let mut fractional_digits = 0;
    while fractional_digits < 2048 {
        coefficient = coefficient.multiply(base);
        scale = scale.multiply(base);
        remainder = remainder.multiply(base);
        let (digit, next_remainder) = match remainder.div_rem(denominator) {
            Ok(value) => value,
            Err(_) => return Result::Ok(number_to_string(value)),
        };
        coefficient = coefficient.add(digit);
        remainder = next_remainder;
        fractional_digits += 1;
        let truncated_matches = bigint_ratio_to_float(coefficient, scale) == magnitude;
        let rounded = coefficient.add(bigint::BigInteger::one());
        let rounded_matches = bigint_ratio_to_float(rounded, scale) == magnitude;
        if truncated_matches || rounded_matches {
            let selected = selected_radix_coefficient(
                coefficient,
                remainder,
                denominator,
                truncated_matches,
                rounded_matches,
            );
            return Result::Ok(scaled_radix_text(selected, radix, fractional_digits, negative))
        }
    }
    Result::Ok(number_to_string(value))
}
