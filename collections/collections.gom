package collections;

use gomlang::quickjs::runtime;
use std::math;

#[derive(Hash, PartialEq, Eq)]
enum CollectionKey {
    Undefined,
    Null,
    Bool(bool),
    Number(u64),
    String(runtime::JsString),
    Symbol(runtime::Symbol),
    BigInt(runtime::BigInt),
    Object(runtime::ObjectId),
}

fn collection_number_key(value: f64) -> u64 {
    if value == 0.0 {
        0
    } else if math::is_nan(value) {
        0x7ff8000000000000
    } else {
        value.to_bits()
    }
}

fn collection_key(value: runtime::Value) -> CollectionKey {
    match value {
        runtime::Value::Undefined => CollectionKey::Undefined,
        runtime::Value::Null => CollectionKey::Null,
        runtime::Value::Bool(value) => CollectionKey::Bool(value),
        runtime::Value::Int(value) => {
            CollectionKey::Number(collection_number_key(runtime::int_to_number(value)))
        },
        runtime::Value::Float(value) => CollectionKey::Number(collection_number_key(value)),
        runtime::Value::String(value) => CollectionKey::String(value),
        runtime::Value::Symbol(value) => CollectionKey::Symbol(value),
        runtime::Value::BigInt(value) => CollectionKey::BigInt(value),
        runtime::Value::Object(value) => CollectionKey::Object(value),
    }
}

pub struct MapEntry {
    pub key: runtime::Value,
    pub value: runtime::Value,
}

pub struct JsMap {
    entries_value: Vec[Option[MapEntry]],
    indices_value: HashMap[CollectionKey, isize],
}

pub fn canonical_key(value: runtime::Value) -> runtime::Value {
    match value {
        runtime::Value::Float(number) => if number == 0.0 {
            runtime::Value::Float(0.0)
        } else {
            value
        },
        _ => value,
    }
}

impl JsMap {
    pub fn new() -> JsMap {
        JsMap { entries_value: Vec::new(), indices_value: HashMap::new() }
    }

    pub fn size(self: JsMap) -> isize {
        self.indices_value.len()
    }

    pub fn set(self: JsMap, key: runtime::Value, value: runtime::Value) -> () {
        let key = canonical_key(key);
        let index_key = collection_key(key);
        match self.indices_value.get(index_key) {
            Some(index) => {
                match self.entries_value[index] {
                    Some(entry) => {
                        self.entries_value[index] = Option::Some(MapEntry { key: entry.key, value });
                    },
                    None => (),
                }
            },
            None => {
                let index = self.entries_value.len();
                self.entries_value.push(Option::Some(MapEntry { key, value }));
                self.indices_value[index_key] = index;
            },
        }
    }

    pub fn get(self: JsMap, key: runtime::Value) -> Option[runtime::Value] {
        match self.indices_value.get(collection_key(key)) {
            Some(index) => match self.entries_value[index] {
                Some(entry) => Option::Some(entry.value),
                None => Option::None,
            },
            None => Option::None,
        }
    }

    pub fn has(self: JsMap, key: runtime::Value) -> bool {
        self.indices_value.contains(collection_key(key))
    }

    pub fn delete(self: JsMap, key: runtime::Value) -> bool {
        match self.indices_value.remove_value(collection_key(key)) {
            Some(index) => {
                self.entries_value[index] = Option::None;
                true
            },
            None => false,
        }
    }

    pub fn clear(self: JsMap) -> () {
        let mut index = 0;
        while index < self.entries_value.len() {
            match self.entries_value[index] {
                Some(entry) => {
                    let _ = self.indices_value.remove_value(collection_key(entry.key));
                },
                None => (),
            }
            self.entries_value[index] = Option::None;
            index += 1;
        }
    }

    pub fn slot_len(self: JsMap) -> isize {
        self.entries_value.len()
    }

    pub fn entry_at(self: JsMap, index: isize) -> Option[MapEntry] {
        if index < 0 || index >= self.entries_value.len() {
            Option::None
        } else {
            self.entries_value[index]
        }
    }

    pub fn entries(self: JsMap) -> Vec[MapEntry] {
        let output: Vec[MapEntry] = Vec::with_capacity(self.entries_value.len());
        let mut index = 0;
        while index < self.entries_value.len() {
            match self.entries_value[index] {
                Some(entry) => output.push(MapEntry { key: entry.key, value: entry.value }),
                None => (),
            }
            index += 1;
        }
        output
    }

    pub fn keys(self: JsMap) -> Vec[runtime::Value] {
        let output: Vec[runtime::Value] = Vec::with_capacity(self.entries_value.len());
        let mut index = 0;
        while index < self.entries_value.len() {
            match self.entries_value[index] {
                Some(entry) => output.push(entry.key),
                None => (),
            }
            index += 1;
        }
        output
    }

    pub fn values(self: JsMap) -> Vec[runtime::Value] {
        let output: Vec[runtime::Value] = Vec::with_capacity(self.entries_value.len());
        let mut index = 0;
        while index < self.entries_value.len() {
            match self.entries_value[index] {
                Some(entry) => output.push(entry.value),
                None => (),
            }
            index += 1;
        }
        output
    }
}

pub struct JsSet {
    values_value: Vec[Option[runtime::Value]],
    indices_value: HashMap[CollectionKey, isize],
}

impl JsSet {
    pub fn new() -> JsSet {
        JsSet { values_value: Vec::new(), indices_value: HashMap::new() }
    }

    pub fn size(self: JsSet) -> isize {
        self.indices_value.len()
    }

    pub fn add(self: JsSet, value: runtime::Value) -> () {
        let value = canonical_key(value);
        let index_key = collection_key(value);
        if self.indices_value.contains(index_key) {
            return
        }
        let index = self.values_value.len();
        self.values_value.push(Option::Some(value));
        self.indices_value[index_key] = index;
    }

    pub fn has(self: JsSet, value: runtime::Value) -> bool {
        self.indices_value.contains(collection_key(value))
    }

    pub fn delete(self: JsSet, value: runtime::Value) -> bool {
        match self.indices_value.remove_value(collection_key(value)) {
            Some(index) => {
                self.values_value[index] = Option::None;
                true
            },
            None => false,
        }
    }

    pub fn clear(self: JsSet) -> () {
        let mut index = 0;
        while index < self.values_value.len() {
            match self.values_value[index] {
                Some(value) => {
                    let _ = self.indices_value.remove_value(collection_key(value));
                },
                None => (),
            }
            self.values_value[index] = Option::None;
            index += 1;
        }
    }

    pub fn slot_len(self: JsSet) -> isize {
        self.values_value.len()
    }

    pub fn value_at(self: JsSet, index: isize) -> Option[runtime::Value] {
        if index < 0 || index >= self.values_value.len() {
            Option::None
        } else {
            self.values_value[index]
        }
    }

    pub fn values(self: JsSet) -> Vec[runtime::Value] {
        let output: Vec[runtime::Value] = Vec::with_capacity(self.values_value.len());
        let mut index = 0;
        while index < self.values_value.len() {
            match self.values_value[index] {
                Some(value) => output.push(value),
                None => (),
            }
            index += 1;
        }
        output
    }
}
