package cutils;

use std::testing;

fn require_unit(result: Result[(), ByteBufferError]) -> () {
    match result {
        Result::Ok(()) => (),
        Result::Err(error) => testing::fail(error.to_string()),
    }
}

fn require_u16(result: Result[u16, ByteBufferError]) -> u16 {
    match result {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0.to_u16()
        },
    }
}

fn require_u32(result: Result[u32, ByteBufferError]) -> u32 {
    match result {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0.to_u32()
        },
    }
}

fn require_u64(result: Result[u64, ByteBufferError]) -> u64 {
    match result {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0.to_u64()
        },
    }
}

#[test]
fn cutils_appends_little_endian_fixed_width_values() -> () {
    let buffer = ByteBuffer::new();
    buffer.append_u16_le(0x1234);
    buffer.append_u32_le(0x89abcdef);
    buffer.append_u64_le(0x0123456789abcdef);
    testing::assert(
        buffer.bytes()
            == Vec::from_array(
                [0x34, 0x12, 0xef, 0xcd, 0xab, 0x89, 0xef, 0xcd, 0xab, 0x89, 0x67, 0x45, 0x23, 0x01],
            ),
    );
    testing::assert_eq(require_u16(buffer.read_u16_le(0)), 0x1234.to_u16());
    testing::assert_eq(require_u32(buffer.read_u32_le(2)), 0x89abcdef.to_u32());
    testing::assert_eq(require_u64(buffer.read_u64_le(6)), 0x0123456789abcdef.to_u64())
}

#[test]
fn cutils_writes_little_endian_values_at_offsets() -> () {
    let values: Vec[byte] = Vec::from_array([0, 0, 0, 0, 0, 0, 0, 0]);
    require_unit(write_u16_le(values, 0, 0x1234));
    testing::assert(values.slice(0, 2) == Vec::from_array([0x34, 0x12]).slice(0, 2));
    require_unit(write_u32_le(values, 2, 0x89abcdef));
    testing::assert(values.slice(2, 6) == Vec::from_array([0xef, 0xcd, 0xab, 0x89]).slice(0, 4));
    require_unit(write_u64_le(values, 0, 0x0123456789abcdef));
    testing::assert(values == Vec::from_array([0xef, 0xcd, 0xab, 0x89, 0x67, 0x45, 0x23, 0x01]))
}

#[test]
fn cutils_rejects_out_of_bounds_ranges() -> () {
    let buffer = ByteBuffer::new();
    buffer.append_bytes(Vec::from_array([1, 2, 3]).slice(0, 3));
    testing::assert(buffer.read_u16_le(-1).is_err());
    testing::assert(buffer.read_u16_le(2).is_err());
    testing::assert(buffer.read_u32_le(0).is_err());
    testing::assert(buffer.read_u64_le(0).is_err());
    testing::assert(buffer.write_u16_le(2, 1).is_err());
    testing::assert(buffer.insert(4, Vec::from_array([9]).slice(0, 1)).is_err());
    testing::assert(buffer.append_self(1, 3).is_err());
    testing::assert(buffer.copy_within(0, 2, 2).is_err())
}

#[test]
fn cutils_inserts_bytes_and_clears_the_buffer() -> () {
    let buffer = ByteBuffer::with_capacity(1);
    buffer.append_byte(1);
    buffer.append_byte(4);
    require_unit(buffer.insert(1, Vec::from_array([2, 3]).slice(0, 2)));
    require_unit(buffer.insert(0, Vec::from_array([0]).slice(0, 1)));
    require_unit(buffer.insert(buffer.len(), Vec::from_array([5]).slice(0, 1)));
    testing::assert(buffer.bytes() == Vec::from_array([0, 1, 2, 3, 4, 5]));
    testing::assert_eq(buffer.len(), 6);
    buffer.clear();
    testing::assert(buffer.is_empty());
    let empty: Vec[byte] = Vec::new();
    testing::assert(buffer.bytes() == empty)
}

#[test]
fn cutils_self_copy_is_overlap_safe() -> () {
    let forward = ByteBuffer::from_bytes(Vec::from_array([1, 2, 3, 4, 5]).slice(0, 5));
    require_unit(forward.copy_within(0, 1, 4));
    testing::assert(forward.bytes() == Vec::from_array([1, 1, 2, 3, 4]));
    let backward = ByteBuffer::from_bytes(Vec::from_array([1, 2, 3, 4, 5]).slice(0, 5));
    require_unit(backward.copy_within(1, 0, 4));
    testing::assert(backward.bytes() == Vec::from_array([2, 3, 4, 5, 5]));
    require_unit(backward.append_self(1, 3));
    testing::assert(backward.bytes() == Vec::from_array([2, 3, 4, 5, 5, 3, 4, 5]))
}
