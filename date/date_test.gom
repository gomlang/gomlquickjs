package date;

use std::math;
use std::testing;

fn expect_int64(value: Result[i64, DateError]) -> i64 {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0.to_i64()
        },
    }
}

fn expect_int(value: Result[isize, DateError]) -> isize {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            0
        },
    }
}

fn expect_string(value: Result[string, DateError]) -> string {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            ""
        },
    }
}

fn expect_civil(value: Result[CivilFields, DateError]) -> CivilFields {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            CivilFields {
                year: 1970,
                month: 1,
                day: 1,
                hour: 0,
                minute: 0,
                second: 0,
                millisecond: 0,
                weekday: 4,
                yearday: 0,
            }
        },
    }
}

fn expect_parsed(value: Result[ParsedIsoDate, DateError]) -> ParsedIsoDate {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            ParsedIsoDate {
                components: DateComponents {
                    year: 1970,
                    month: 1,
                    day: 1,
                    hour: 0,
                    minute: 0,
                    second: 0,
                    millisecond: 0,
                },
                time_zone: IsoTimeZone::Utc,
                date_only: true,
            }
        },
    }
}

fn expect_error[T](value: Result[T, DateError], kind: DateErrorKind) -> DateError {
    match value {
        Result::Err(error) => {
            testing::assert(error.kind == kind);
            error
        },
        Result::Ok(_) => {
            testing::fail("expected date error");
            DateError { kind, offset: -1 }
        },
    }
}

fn components(
    year: i64,
    month: isize,
    day: isize,
    hour: isize,
    minute: isize,
    second: isize,
    millisecond: isize,
) -> DateComponents {
    DateComponents { year, month, day, hour, minute, second, millisecond }
}

#[test]
fn leap_year_and_month_rules_cover_centuries_and_astronomical_years() -> () {
    testing::assert(is_leap_year(2000));
    testing::assert(!is_leap_year(1900));
    testing::assert(is_leap_year(2004));
    testing::assert(!is_leap_year(2001));
    testing::assert(is_leap_year(0));
    testing::assert(is_leap_year(-400));
    testing::assert_eq(expect_int(days_in_month(2000, 2)), 29);
    testing::assert_eq(expect_int(days_in_month(1900, 2)), 28);
    let _ = expect_error(days_in_month(2020, 13), DateErrorKind::InvalidDate);
}

#[test]
fn civil_day_conversion_is_epoch_based_and_symmetric_across_zero() -> () {
    testing::assert_eq(expect_int64(days_from_civil(1970, 1, 1)), 0);
    testing::assert_eq(expect_int64(days_from_civil(1969, 12, 31)), -1);
    testing::assert_eq(expect_int64(days_from_civil(2000, 1, 1)), 10957);
    match civil_from_days(-1) {
        Result::Ok(value) => testing::assert(value == CivilDate { year: 1969, month: 12, day: 31 }),
        Result::Err(error) => testing::fail(error.to_string()),
    };
    match civil_from_days(11016) {
        Result::Ok(value) => testing::assert(value == CivilDate { year: 2000, month: 2, day: 29 }),
        Result::Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn time_clip_truncates_and_enforces_the_ecmascript_boundary() -> () {
    testing::assert_eq(expect_int64(time_clip(123.875)), 123);
    testing::assert_eq(expect_int64(time_clip(-123.875)), -123);
    testing::assert_eq(expect_int64(time_clip(8640000000000000.0)), MAX_TIME_MILLISECONDS);
    testing::assert_eq(expect_int64(time_clip(-8640000000000000.0)), -MAX_TIME_MILLISECONDS);
    let zero = 0.0;
    let _ = expect_error(time_clip(zero / zero), DateErrorKind::NonFiniteTime);
    let _ = expect_error(time_clip(1.0 / zero), DateErrorKind::NonFiniteTime);
    let _ = expect_error(time_clip(8640000000000001.0), DateErrorKind::TimeOutOfRange);
    let _ = expect_error(time_clip(-8640000000000001.0), DateErrorKind::TimeOutOfRange);
}

#[test]
fn make_time_day_and_date_normalize_like_ecmascript() -> () {
    testing::assert_eq(expect_int64(make_time(1, 2, 3, 4)), 3723004);
    testing::assert_eq(expect_int64(make_time(-1, 0, 0, 0)), -3600000);
    testing::assert_eq(expect_int64(make_day(1970, 0, 1)), 0);
    testing::assert_eq(
        expect_int64(make_day(2020, -1, 1)),
        expect_int64(days_from_civil(2019, 12, 1)),
    );
    testing::assert_eq(
        expect_int64(make_day(2020, 12, 1)),
        expect_int64(days_from_civil(2021, 1, 1)),
    );
    testing::assert_eq(
        expect_int64(make_day(1000001, -12, 1)),
        expect_int64(days_from_civil(1000000, 1, 1)),
    );
    testing::assert_eq(expect_int64(make_day(2020, 1, 31)), 18323);
    testing::assert_eq(expect_int64(make_date(1, -1)), 86399999)
}

#[test]
fn checked_date_arithmetic_reports_overflow() -> () {
    let maximum: i64 = 9223372036854775807;
    let _ = expect_error(make_time(maximum, 0, 0, 0), DateErrorKind::ArithmeticOverflow);
    let _ = expect_error(make_date(maximum, 0), DateErrorKind::ArithmeticOverflow);
    let _ = expect_error(make_day(maximum, 0, 1), DateErrorKind::TimeOutOfRange);
}

#[test]
fn utc_components_and_fields_handle_negative_milliseconds() -> () {
    testing::assert_eq(expect_int64(utc_from_components(components(1970, 1, 1, 0, 0, 0, 0))), 0);
    let epoch = expect_civil(civil_from_utc(0));
    testing::assert(
        epoch
            == CivilFields {
                year: 1970,
                month: 1,
                day: 1,
                hour: 0,
                minute: 0,
                second: 0,
                millisecond: 0,
                weekday: 4,
                yearday: 0,
            },
    );
    let before = expect_civil(civil_from_utc(-1));
    testing::assert(
        before
            == CivilFields {
                year: 1969,
                month: 12,
                day: 31,
                hour: 23,
                minute: 59,
                second: 59,
                millisecond: 999,
                weekday: 3,
                yearday: 364,
            },
    );
}

#[test]
fn strict_civil_construction_rejects_invalid_fields() -> () {
    let _ = expect_error(
        utc_from_components(components(2021, 2, 29, 0, 0, 0, 0)),
        DateErrorKind::InvalidDate,
    );
    let _ = expect_error(
        utc_from_components(components(2020, 2, 29, 24, 0, 0, 0)),
        DateErrorKind::InvalidDate,
    );
    let _ = expect_error(
        utc_from_components(components(2020, 1, 1, 0, 0, 0, 1000)),
        DateErrorKind::InvalidDate,
    );
}

#[test]
fn iso_parser_accepts_z_offsets_fraction_truncation_and_end_of_day() -> () {
    testing::assert_eq(expect_int64(parse_iso_timestamp("1970-01-01T00:00:00.000Z")), 0);
    testing::assert_eq(
        expect_int64(parse_iso_timestamp("2020-01-01T00:00:00+01:30")),
        1577831400000,
    );
    testing::assert_eq(expect_int64(parse_iso_timestamp("2020-01-01T00:00:00-0545")), 1577857500000);
    testing::assert_eq(
        expect_int64(parse_iso_timestamp("2020-01-01T00:00:00.123456789Z")),
        1577836800123,
    );
    testing::assert_eq(expect_int64(parse_iso_timestamp("2020-01-01T24:00:00.000Z")), 1577923200000)
}

#[test]
fn iso_parser_matches_ecmascript_date_only_defaults_and_normalization() -> () {
    testing::assert_eq(expect_int64(parse_iso_timestamp("2020")), 1577836800000);
    testing::assert_eq(expect_int64(parse_iso_timestamp("2020-02")), 1580515200000);
    testing::assert_eq(expect_int64(parse_iso_timestamp("2020-02-31")), 1583107200000);
    testing::assert_eq(expect_int64(parse_iso_timestamp("2021-02-29")), 1614556800000);
    testing::assert_eq(
        expect_int64(parse_iso_timestamp("1900-02-29T00:00:00.000Z")),
        -2203891200000,
    );
    testing::assert_eq(expect_int64(parse_iso_timestamp("2020-02-30T00:00:00.000Z")), 1583020800000)
}

#[test]
fn iso_parser_preserves_local_time_without_using_a_host_timezone() -> () {
    let parsed = expect_parsed(parse_iso("2020-01-02T03:04:05.006"));
    testing::assert(parsed.time_zone == IsoTimeZone::Local);
    testing::assert(!parsed.date_only);
    let _ = expect_error(parsed_iso_to_utc(parsed), DateErrorKind::LocalTimeRequiresOffset);
}

#[test]
fn iso_parser_supports_expanded_years_and_rejects_negative_zero_year() -> () {
    testing::assert_eq(
        expect_int64(parse_iso_timestamp("+010000-01-01T00:00:00.000Z")),
        253402300800000,
    );
    testing::assert_eq(
        expect_int64(parse_iso_timestamp("0000-01-01T00:00:00.000Z")),
        -62167219200000,
    );
    testing::assert_eq(
        expect_int64(parse_iso_timestamp("+000000-01-01T00:00:00.000Z")),
        -62167219200000,
    );
    testing::assert_eq(
        expect_int64(parse_iso_timestamp("-000001-01-01T00:00:00.000Z")),
        -62198755200000,
    );
    let error = expect_error(
        parse_iso("-000000-01-01T00:00:00.000Z"),
        DateErrorKind::InvalidIsoSyntax,
    );
    testing::assert_eq(error.offset, 0)
}

#[test]
fn iso_parser_reports_ascii_and_grammar_failures_with_offsets() -> () {
    let ascii = expect_error(parse_iso("２０２０-01-01"), DateErrorKind::NonAsciiInput);
    testing::assert_eq(ascii.offset, 0);
    let cases = Vec::from_array(
        [
            "",
            "20-01-01",
            "2020-13-01",
            "2020-01-32",
            "2020-01-01T24:00:00.001Z",
            "2020-01-01T23:59:60Z",
            "2020-01-01T00:00:00+24:00",
            "2020-01-01T00:00:00+01",
            "2020-01-01T00:00:00.1234567890Z",
            "2020-01-01t00:00:00z",
            "2020-01-01Z",
        ],
    );
    for value in cases {
        let _ = expect_error(parse_iso(value), DateErrorKind::InvalidIsoSyntax);
    }
}

#[test]
fn iso_formatting_covers_epoch_bounds_and_expanded_years() -> () {
    testing::assert_eq(expect_string(to_iso_string(0)), "1970-01-01T00:00:00.000Z");
    testing::assert_eq(expect_string(to_iso_string(-1)), "1969-12-31T23:59:59.999Z");
    testing::assert_eq(
        expect_string(to_iso_string(MAX_TIME_MILLISECONDS)),
        "+275760-09-13T00:00:00.000Z",
    );
    testing::assert_eq(
        expect_string(to_iso_string(-MAX_TIME_MILLISECONDS)),
        "-271821-04-20T00:00:00.000Z",
    );
    testing::assert_eq(expect_string(to_iso_string(253402300800000)), "+010000-01-01T00:00:00.000Z");
    let _ = expect_error(to_iso_string(MAX_TIME_MILLISECONDS + 1), DateErrorKind::TimeOutOfRange);
}

#[test]
fn utc_and_iso_roundtrip_across_representative_range() -> () {
    let values: Vec[i64] = Vec::from_array(
        [
            -MAX_TIME_MILLISECONDS,
            -62167219200000,
            -2208988800000,
            -1,
            0,
            1,
            951782400000,
            1582934400123,
            253402300800000,
            MAX_TIME_MILLISECONDS,
        ],
    );
    for value in values {
        let encoded = expect_string(to_iso_string(value));
        testing::assert_eq(expect_int64(parse_iso_timestamp(encoded)), value);
        let fields = expect_civil(civil_from_utc(value));
        testing::assert_eq(
            expect_int64(
                utc_from_components(
                    components(
                        fields.year,
                        fields.month,
                        fields.day,
                        fields.hour,
                        fields.minute,
                        fields.second,
                        fields.millisecond,
                    ),
                ),
            ),
            value,
        );
    }
}

#[test]
fn non_finite_detection_is_not_confused_by_signed_zero() -> () {
    testing::assert_eq(expect_int64(time_clip(-0.0)), 0);
    testing::assert(!math::is_nan(-0.0))
}

#[test]
fn timestamp_parser_accepts_quickjs_legacy_month_and_gmt_forms() -> () {
    testing::assert_eq(expect_int64(parse_timestamp("Jan 1 2000")), 946684800000);
    testing::assert_eq(expect_int64(parse_timestamp("Sat Jan 1 2000 00:00")), 946684800000);
    testing::assert_eq(expect_int64(parse_timestamp("Jan 1 2000 00:00:00 GMT+0100")), 946681200000);
    testing::assert_eq(
        expect_int64(parse_timestamp("Sat Jan 1 2000 00:00:00 GMT-0230")),
        946693800000,
    );
    testing::assert_eq(expect_int64(parse_timestamp("Thu, 01 Jan 1970 00:00:00 GMT")), 0);
    testing::assert_eq(expect_int64(parse_timestamp("2000T00:00")), 946684800000)
}

#[test]
fn float_component_date_construction_preserves_ecmascript_evaluation_order() -> () {
    testing::assert_eq(
        make_date_from_float_components(
            Vec::from_array([1970.0, 0.0, 1.0, 80063993375.0, 29.0, 1.0, -288230376151711740.0]),
        ),
        29312.0,
    );
    testing::assert_eq(
        make_date_from_float_components(
            Vec::from_array([1970.0, 0.0, 213503982336.0, 0.0, 0.0, 0.0, -18446744073709552000.0]),
        ),
        34447360.0,
    )
}
