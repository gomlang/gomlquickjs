package date;

use std::testing;

fn expect_time_zone(value: Option[TimeZone]) -> TimeZone {
    match value {
        Some(value) => value,
        None => {
            testing::fail("expected system time zone data");
            TimeZone::utc()
        },
    }
}

#[test]
fn timezone_parser_reads_utc_and_seasonal_offsets() -> () {
    let utc = expect_time_zone(load_time_zone("/usr/share/zoneinfo/UTC"));
    let new_york = expect_time_zone(load_time_zone("/usr/share/zoneinfo/America/New_York"));
    let berlin = expect_time_zone(load_time_zone("/usr/share/zoneinfo/Europe/Berlin"));
    testing::assert_eq(utc.offset_minutes_at(0), 0);
    testing::assert_eq(new_york.offset_minutes_at(1610712000000), -300);
    testing::assert_eq(new_york.offset_minutes_at(1626350400000), -240);
    testing::assert_eq(new_york.offset_minutes_at(2210241600000), -300);
    testing::assert_eq(new_york.offset_minutes_at(2225966400000), -240);
    testing::assert_eq(berlin.offset_minutes_at(1610712000000), 60);
    testing::assert_eq(berlin.offset_minutes_at(1626350400000), 120);
    testing::assert_eq(berlin.offset_minutes_at(2210241600000), 60);
    testing::assert_eq(berlin.offset_minutes_at(2225966400000), 120)
}

#[test]
fn timezone_parser_uses_transition_boundaries_and_minute_offsets() -> () {
    let new_york = expect_time_zone(load_time_zone("/usr/share/zoneinfo/America/New_York"));
    let monrovia = expect_time_zone(load_time_zone("/usr/share/zoneinfo/Africa/Monrovia"));
    let lord_howe = expect_time_zone(load_time_zone("/usr/share/zoneinfo/Australia/Lord_Howe"));
    testing::assert_eq(new_york.offset_minutes_at(1615705199999), -300);
    testing::assert_eq(new_york.offset_minutes_at(1615705200000), -240);
    testing::assert_eq(new_york.offset_minutes_at(1636264799999), -240);
    testing::assert_eq(new_york.offset_minutes_at(1636264800000), -300);
    testing::assert_eq(monrovia.offset_minutes_at(-2208988800000), -43);
    testing::assert_eq(lord_howe.offset_minutes_at(2210241600000), 660);
    testing::assert_eq(lord_howe.offset_minutes_at(2225966400000), 630)
}
