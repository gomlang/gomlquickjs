package uri;

use gomlang::quickjs::runtime;

#[derive(PartialEq, Eq, Debug)]
pub enum UriErrorKind {
    UnpairedSurrogate,
    MalformedPercentEscape,
    InvalidUtf8,
}

#[derive(PartialEq, Eq, Debug)]
pub struct UriError {
    pub kind: UriErrorKind,
    pub offset: isize,
}

impl ToString for UriError {
    fn to_string(self: UriError) -> string {
        let message = match self.kind {
            UriErrorKind::UnpairedSurrogate => "unpaired surrogate",
            UriErrorKind::MalformedPercentEscape => "malformed percent escape",
            UriErrorKind::InvalidUtf8 => "malformed UTF-8",
        };
        message + " at UTF-16 offset " + self.offset.to_string()
    }
}

fn uri_error(kind: UriErrorKind, offset: isize) -> UriError {
    UriError { kind, offset }
}

fn is_ascii_letter(value: u16) -> bool {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

fn is_ascii_digit(value: u16) -> bool {
    value >= 48 && value <= 57
}

fn is_uri_reserved(value: u16) -> bool {
    value == 59 || value == 47 || value == 63 || value == 58 || value == 64 || value == 38
        || value == 61
        || value == 43
        || value == 36
        || value == 44
        || value == 35
}

fn is_component_unescaped(value: u16) -> bool {
    is_ascii_letter(value) || is_ascii_digit(value) || value == 45 || value == 95 || value == 46
        || value == 33
        || value == 126
        || value == 42
        || value == 39
        || value == 40
        || value == 41
}

fn is_uri_unescaped(value: u16, component: bool) -> bool {
    is_component_unescaped(value) || (!component && is_uri_reserved(value))
}

fn uppercase_hex(value: byte) -> u16 {
    if value < 10 {
        48 + value.to_u16()
    } else {
        65 + (value - 10).to_u16()
    }
}

fn append_percent_byte(output: Vec[u16], value: byte) -> unit {
    output.push(37);
    output.push(uppercase_hex(value >> 4));
    output.push(uppercase_hex(value & 15))
}

fn append_percent_code_point(output: Vec[u16], code_point: u32) -> unit {
    if code_point < 0x80 {
        append_percent_byte(output, code_point.to_u8())
    } else if code_point < 0x800 {
        append_percent_byte(output, ((code_point >> 6) | 0xc0).to_u8());
        append_percent_byte(output, ((code_point & 0x3f) | 0x80).to_u8())
    } else if code_point < 0x10000 {
        append_percent_byte(output, ((code_point >> 12) | 0xe0).to_u8());
        append_percent_byte(output, (((code_point >> 6) & 0x3f) | 0x80).to_u8());
        append_percent_byte(output, ((code_point & 0x3f) | 0x80).to_u8())
    } else {
        append_percent_byte(output, ((code_point >> 18) | 0xf0).to_u8());
        append_percent_byte(output, (((code_point >> 12) & 0x3f) | 0x80).to_u8());
        append_percent_byte(output, (((code_point >> 6) & 0x3f) | 0x80).to_u8());
        append_percent_byte(output, ((code_point & 0x3f) | 0x80).to_u8())
    }
}

fn encode(value: runtime::JsString, component: bool) -> Result[runtime::JsString, UriError] {
    let output: Vec[u16] = Vec::with_capacity(value.len() * 3);
    let mut index = 0;
    while index < value.len() {
        let first = value.get(index);
        if is_uri_unescaped(first, component) {
            output.push(first);
            index += 1;
        } else if runtime::is_low_surrogate(first) {
            return Result::Err(uri_error(UriErrorKind::UnpairedSurrogate, index))
        } else if runtime::is_high_surrogate(first) {
            if index + 1 >= value.len() || !runtime::is_low_surrogate(value.get(index + 1)) {
                return Result::Err(uri_error(UriErrorKind::UnpairedSurrogate, index))
            } else {};
            let code_point = match runtime::combine_surrogates(first, value.get(index + 1)) {
                Some(code_point) => code_point,
                None => return Result::Err(uri_error(UriErrorKind::UnpairedSurrogate, index)),
            };
            append_percent_code_point(output, code_point);
            index += 2;
        } else {
            append_percent_code_point(output, first.to_u32());
            index += 1;
        }
    }
    Result::Ok(runtime::JsString::from_code_units(output))
}

pub fn encode_uri(value: runtime::JsString) -> Result[runtime::JsString, UriError] {
    encode(value, false)
}

pub fn encode_uri_component(value: runtime::JsString) -> Result[runtime::JsString, UriError] {
    encode(value, true)
}

fn hex_value(value: u16) -> Option[byte] {
    if value >= 48 && value <= 57 {
        Option::Some((value - 48).to_u8())
    } else if value >= 65 && value <= 70 {
        Option::Some((value - 55).to_u8())
    } else if value >= 97 && value <= 102 {
        Option::Some((value - 87).to_u8())
    } else {
        Option::None
    }
}

fn decode_percent_byte(value: runtime::JsString, offset: isize) -> Result[byte, UriError] {
    if offset < 0 || offset + 2 >= value.len() || value.get(offset) != 37 {
        return Result::Err(uri_error(UriErrorKind::MalformedPercentEscape, offset))
    } else {};
    let high = match hex_value(value.get(offset + 1)) {
        Some(value) => value,
        None => return Result::Err(uri_error(UriErrorKind::MalformedPercentEscape, offset)),
    };
    let low = match hex_value(value.get(offset + 2)) {
        Some(value) => value,
        None => return Result::Err(uri_error(UriErrorKind::MalformedPercentEscape, offset)),
    };
    Result::Ok((high << 4) | low)
}

fn append_code_point(output: Vec[u16], code_point: u32, offset: isize) -> Result[unit, UriError] {
    if code_point <= 0xffff {
        output.push(code_point.to_u16());
        Result::Ok(())
    } else {
        match runtime::split_code_point(code_point) {
            Some((high, low)) => {
                output.push(high);
                output.push(low);
                Result::Ok(())
            },
            None => Result::Err(uri_error(UriErrorKind::InvalidUtf8, offset)),
        }
    }
}

fn utf8_shape(first: byte, offset: isize) -> Result[(isize, u32, u32), UriError] {
    let value = first.to_u32();
    if first >= 0xc0 && first <= 0xdf {
        Result::Ok((2, value & 0x1f, 0x80))
    } else if first >= 0xe0 && first <= 0xef {
        Result::Ok((3, value & 0x0f, 0x800))
    } else if first >= 0xf0 && first <= 0xf7 {
        Result::Ok((4, value & 0x07, 0x10000))
    } else {
        Result::Err(uri_error(UriErrorKind::InvalidUtf8, offset))
    }
}

fn decode(value: runtime::JsString, component: bool) -> Result[runtime::JsString, UriError] {
    let output: Vec[u16] = Vec::with_capacity(value.len());
    let mut index = 0;
    while index < value.len() {
        let current = value.get(index);
        if current != 37 {
            output.push(current);
            index += 1;
        } else {
            let first = decode_percent_byte(value, index)?;
            if first < 0x80 {
                if !component && is_uri_reserved(first.to_u16()) {
                    output.push(value.get(index));
                    output.push(value.get(index + 1));
                    output.push(value.get(index + 2));
                } else {
                    output.push(first.to_u16());
                };
                index += 3;
            } else {
                let (length, mut code_point, minimum) = utf8_shape(first, index)?;
                let mut byte_index = 1;
                while byte_index < length {
                    let escape_offset = index + byte_index * 3;
                    let next = decode_percent_byte(value, escape_offset)?;
                    if next < 0x80 || next >= 0xc0 {
                        return Result::Err(uri_error(UriErrorKind::InvalidUtf8, escape_offset))
                    } else {};
                    code_point = (code_point << 6) | (next.to_u32() & 0x3f);
                    byte_index += 1;
                }
                if code_point < minimum || code_point > 0x10ffff
                    || (code_point >= 0xd800 && code_point <= 0xdfff) {
                    return Result::Err(uri_error(UriErrorKind::InvalidUtf8, index))
                } else {};
                append_code_point(output, code_point, index)?;
                index += length * 3;
            }
        }
    }
    Result::Ok(runtime::JsString::from_code_units(output))
}

pub fn decode_uri(value: runtime::JsString) -> Result[runtime::JsString, UriError] {
    decode(value, false)
}

pub fn decode_uri_component(value: runtime::JsString) -> Result[runtime::JsString, UriError] {
    decode(value, true)
}
