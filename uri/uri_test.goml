package uri;

use gomlang::quickjs::runtime;
use std::testing;

fn js_string(value: string) -> runtime::JsString {
    let bytes = value.to_bytes();
    runtime::JsString::from_utf8(bytes.slice(0, bytes.len()))
}

fn expect_value(value: Result[runtime::JsString, UriError]) -> runtime::JsString {
    match value {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            runtime::JsString::from_code_units(Vec::new())
        },
    }
}

fn expect_error(value: Result[runtime::JsString, UriError], kind: UriErrorKind, offset: isize) -> () {
    match value {
        Result::Err(error) => {
            testing::assert(error.kind == kind);
            testing::assert_eq(error.offset, offset)
        },
        Result::Ok(_) => testing::fail("expected URI error"),
    }
}

#[test]
fn encode_uri_and_component_use_ecmascript_unescaped_sets() -> () {
    let source = js_string("https://example.com/a b?x=1#frag");
    testing::assert(
        expect_value(encode_uri(source)) == js_string("https://example.com/a%20b?x=1#frag"),
    );
    testing::assert(
        expect_value(encode_uri_component(source))
            == js_string("https%3A%2F%2Fexample.com%2Fa%20b%3Fx%3D1%23frag"),
    );
    let unescaped = js_string("AZaz09-_.!~*'()");
    testing::assert(expect_value(encode_uri(unescaped)) == unescaped);
    testing::assert(expect_value(encode_uri_component(unescaped)) == unescaped);
    let reserved = js_string(";/?:@&=+$,#");
    testing::assert(expect_value(encode_uri(reserved)) == reserved);
    testing::assert(
        expect_value(encode_uri_component(reserved))
            == js_string("%3B%2F%3F%3A%40%26%3D%2B%24%2C%23"),
    )
}

#[test]
fn encode_uses_uppercase_utf8_percent_escapes() -> () {
    let encoded = expect_value(encode_uri_component(js_string("A©😀中")));
    testing::assert(encoded == js_string("A%C2%A9%F0%9F%98%80%E4%B8%AD"));
    testing::assert(expect_value(decode_uri_component(encoded)) == js_string("A©😀中"))
}

#[test]
fn encode_rejects_unpaired_surrogates_at_their_utf16_offset() -> () {
    expect_error(
        encode_uri(runtime::JsString::from_code_units(Vec::from_array([65, 0xd800]))),
        UriErrorKind::UnpairedSurrogate,
        1,
    );
    expect_error(
        encode_uri_component(runtime::JsString::from_code_units(Vec::from_array([0xdc00, 65]))),
        UriErrorKind::UnpairedSurrogate,
        0,
    );
    expect_error(
        encode_uri(runtime::JsString::from_code_units(Vec::from_array([0xd800, 65]))),
        UriErrorKind::UnpairedSurrogate,
        0,
    )
}

#[test]
fn decode_uri_preserves_reserved_escape_spelling() -> () {
    let source = js_string("%3B%2f%3f%3A%40%26%3d%2B%24%2c%23%41%25");
    testing::assert(
        expect_value(decode_uri(source)) == js_string("%3B%2f%3f%3A%40%26%3d%2B%24%2c%23A%"),
    );
    testing::assert(expect_value(decode_uri_component(source)) == js_string(";/?:@&=+$,#A%"))
}

#[test]
fn decode_accepts_scalar_utf8_and_preserves_raw_utf16() -> () {
    let encoded = js_string("%00%C2%A9%E4%B8%AD%F0%9F%98%80%F4%8F%BF%BF");
    let expected = runtime::JsString::from_code_units(
        Vec::from_array([0, 0x00a9, 0x4e2d, 0xd83d, 0xde00, 0xdbff, 0xdfff]),
    );
    testing::assert(expect_value(decode_uri_component(encoded)) == expected);
    let raw = runtime::JsString::from_code_units(Vec::from_array([0xd800, 37, 52, 49, 0xdc00]));
    testing::assert(
        expect_value(decode_uri_component(raw))
            == runtime::JsString::from_code_units(Vec::from_array([0xd800, 65, 0xdc00])),
    )
}

#[test]
fn decode_reports_malformed_percent_escape_offsets() -> () {
    expect_error(decode_uri_component(js_string("a%")), UriErrorKind::MalformedPercentEscape, 1);
    expect_error(decode_uri_component(js_string("a%2G")), UriErrorKind::MalformedPercentEscape, 1);
    expect_error(decode_uri_component(js_string("%C2A0")), UriErrorKind::MalformedPercentEscape, 3);
    expect_error(decode_uri_component(js_string("%E2%82")), UriErrorKind::MalformedPercentEscape, 6)
}

#[test]
fn decode_rejects_non_shortest_and_non_scalar_utf8() -> () {
    expect_error(decode_uri(js_string("x%80")), UriErrorKind::InvalidUtf8, 1);
    expect_error(decode_uri(js_string("%C0%80")), UriErrorKind::InvalidUtf8, 0);
    expect_error(decode_uri(js_string("%E0%80%80")), UriErrorKind::InvalidUtf8, 0);
    expect_error(decode_uri(js_string("%ED%A0%80")), UriErrorKind::InvalidUtf8, 0);
    expect_error(decode_uri(js_string("%F4%90%80%80")), UriErrorKind::InvalidUtf8, 0);
    expect_error(decode_uri(js_string("%F5%80%80%80")), UriErrorKind::InvalidUtf8, 0)
}

#[test]
fn decode_reports_the_invalid_continuation_escape_offset() -> () {
    expect_error(decode_uri_component(js_string("%F0%28%8C%BC")), UriErrorKind::InvalidUtf8, 3);
    expect_error(decode_uri_component(js_string("x%E2%82%41")), UriErrorKind::InvalidUtf8, 7)
}
