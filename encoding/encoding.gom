package encoding;

#[derive(PartialEq, Eq, Debug)]
pub enum Base64Alphabet {
    Base64,
    Base64Url,
}

#[derive(PartialEq, Eq, Debug)]
pub enum LastChunkHandling {
    Loose,
    Strict,
    StopBeforePartial,
}

#[derive(PartialEq, Eq, Debug)]
pub enum DecodeError {
    InvalidBase64,
    InvalidHex,
}

pub struct DecodeResult {
    pub bytes: Vec[byte],
    pub read: isize,
}

pub struct DecodeFailure {
    pub kind: DecodeError,
    pub bytes: Vec[byte],
    pub read: isize,
}

fn base64_failure(bytes: Vec[byte], read: isize) -> DecodeFailure {
    DecodeFailure { kind: DecodeError::InvalidBase64, bytes, read }
}

fn hex_failure(bytes: Vec[byte], read: isize) -> DecodeFailure {
    DecodeFailure { kind: DecodeError::InvalidHex, bytes, read }
}

fn base64_digit(value: u16, alphabet: Base64Alphabet) -> isize {
    if value >= 65 && value <= 90 {
        (value - 65).to_isize()
    } else if value >= 97 && value <= 122 {
        (value - 97).to_isize() + 26
    } else if value >= 48 && value <= 57 {
        (value - 48).to_isize() + 52
    } else {
        match alphabet {
            Base64Alphabet::Base64 => if value == 43 {
                62
            } else if value == 47 {
                63
            } else {
                -1
            },
            Base64Alphabet::Base64Url => if value == 45 {
                62
            } else if value == 95 {
                63
            } else {
                -1
            },
        }
    }
}

fn base64_character(value: isize, alphabet: Base64Alphabet) -> byte {
    if value < 26 {
        (65 + value).to_u8()
    } else if value < 52 {
        (97 + value - 26).to_u8()
    } else if value < 62 {
        (48 + value - 52).to_u8()
    } else if value == 62 {
        match alphabet {
            Base64Alphabet::Base64 => 43,
            Base64Alphabet::Base64Url => 45,
        }
    } else {
        match alphabet {
            Base64Alphabet::Base64 => 47,
            Base64Alphabet::Base64Url => 95,
        }
    }
}

fn base64_whitespace(value: u16) -> bool {
    value == 9 || value == 10 || value == 12 || value == 13 || value == 32
}

fn decode_capacity(capacity: Option[isize]) -> isize {
    match capacity {
        Some(value) => if value < 0 {
            0
        } else {
            value
        },
        None => 2147483647,
    }
}

pub fn encode_base64(input: Slice[byte], alphabet: Base64Alphabet, omit_padding: bool) -> Vec[byte] {
    let output: Vec[byte] = Vec::new();
    let mut index = 0;
    while index + 3 <= input.len() {
        let first = input[index].to_isize();
        let second = input[index + 1].to_isize();
        let third = input[index + 2].to_isize();
        output.push(base64_character(first >> 2, alphabet));
        output.push(base64_character(((first & 3) << 4) | (second >> 4), alphabet));
        output.push(base64_character(((second & 15) << 2) | (third >> 6), alphabet));
        output.push(base64_character(third & 63, alphabet));
        index += 3;
    }
    let remaining = input.len() - index;
    if remaining == 1 {
        let first = input[index].to_isize();
        output.push(base64_character(first >> 2, alphabet));
        output.push(base64_character((first & 3) << 4, alphabet));
        if !omit_padding {
            output.push(61);
            output.push(61);
        } else {}
    } else if remaining == 2 {
        let first = input[index].to_isize();
        let second = input[index + 1].to_isize();
        output.push(base64_character(first >> 2, alphabet));
        output.push(base64_character(((first & 3) << 4) | (second >> 4), alphabet));
        output.push(base64_character((second & 15) << 2, alphabet));
        if !omit_padding {
            output.push(61);
        } else {}
    } else {};
    output
}

fn base64_emit(output: Vec[byte], digits: Vec[isize], count: isize, strict_mode: bool) -> Result[
    isize,
    DecodeError,
] {
    if count < 2 || count > 4 || digits[0] < 0 || digits[1] < 0 {
        return Result::Err(DecodeError::InvalidBase64)
    } else {};
    if count == 2 {
        output.push(((digits[0] << 2) | (digits[1] >> 4)).to_u8());
        Result::Ok(1)
    } else if count == 3 {
        if digits[2] < 0 {
            return Result::Err(DecodeError::InvalidBase64)
        } else {};
        output.push(((digits[0] << 2) | (digits[1] >> 4)).to_u8());
        output.push((((digits[1] & 15) << 4) | (digits[2] >> 2)).to_u8());
        Result::Ok(2)
    } else if digits[2] == -2 && digits[3] == -2 {
        if strict_mode && digits[1] & 15 != 0 {
            Result::Err(DecodeError::InvalidBase64)
        } else {
            output.push(((digits[0] << 2) | (digits[1] >> 4)).to_u8());
            Result::Ok(1)
        }
    } else if digits[2] >= 0 && digits[3] == -2 {
        if strict_mode && digits[2] & 3 != 0 {
            Result::Err(DecodeError::InvalidBase64)
        } else {
            output.push(((digits[0] << 2) | (digits[1] >> 4)).to_u8());
            output.push((((digits[1] & 15) << 4) | (digits[2] >> 2)).to_u8());
            Result::Ok(2)
        }
    } else if digits[2] >= 0 && digits[3] >= 0 {
        output.push(((digits[0] << 2) | (digits[1] >> 4)).to_u8());
        output.push((((digits[1] & 15) << 4) | (digits[2] >> 2)).to_u8());
        output.push((((digits[2] & 3) << 6) | digits[3]).to_u8());
        Result::Ok(3)
    } else {
        Result::Err(DecodeError::InvalidBase64)
    }
}

pub fn decode_base64(
    input: Slice[u16],
    alphabet: Base64Alphabet,
    handling: LastChunkHandling,
    capacity: Option[isize],
) -> Result[DecodeResult, DecodeFailure] {
    let output: Vec[byte] = Vec::new();
    let limit = decode_capacity(capacity);
    let mut cursor = 0;
    let mut read = 0;
    let mut terminal = false;
    while cursor < input.len() {
        if output.len() >= limit {
            break
        } else {};
        let group_start = cursor;
        while cursor < input.len() && base64_whitespace(input[cursor]) {
            cursor += 1;
        }
        if cursor >= input.len() {
            read = cursor;
            break
        } else if terminal {
            return Result::Err(base64_failure(output, read))
        } else {};
        let digits: Vec[isize] = Vec::new();
        while cursor < input.len() && digits.len() < 4 {
            let code_unit = input[cursor];
            cursor += 1;
            if base64_whitespace(code_unit) {} else if code_unit == 61 {
                digits.push(-2)
            } else {
                let digit = base64_digit(code_unit, alphabet);
                if digit < 0 {
                    return Result::Err(base64_failure(output, read))
                } else {
                    digits.push(digit)
                }
            }
        }
        let count = digits.len();
        let padded = count == 4 && (digits[2] == -2 || digits[3] == -2);
        let required = if count == 4 {
            if digits[2] == -2 {
                1
            } else if digits[3] == -2 {
                2
            } else {
                3
            }
        } else {
            count - 1
        };
        if count < 4 {
            match handling {
                LastChunkHandling::StopBeforePartial => {
                    let allowed_padding = count == 3 && digits[0] >= 0 && digits[1] >= 0
                        && digits[2] == -2;
                    let mut valid = true;
                    let mut index = 0;
                    while index < count {
                        if digits[index] == -2 && !allowed_padding {
                            valid = false;
                        } else {};
                        index += 1;
                    }
                    if !valid {
                        return Result::Err(base64_failure(output, read))
                    } else {};
                    read = group_start;
                    break
                },
                LastChunkHandling::Strict => {
                    return Result::Err(base64_failure(output, read))
                },
                LastChunkHandling::Loose => (),
            }
        } else {};
        if required < 0 || output.len() + required > limit {
            read = group_start;
            break
        } else {};
        let strict_mode = match handling {
            LastChunkHandling::Strict => true,
            _ => false,
        };
        match base64_emit(output, digits, count, strict_mode) {
            Ok(_) => (),
            Err(_) => return Result::Err(base64_failure(output, read)),
        };
        read = cursor;
        if padded {
            terminal = true;
            while cursor < input.len() && base64_whitespace(input[cursor]) {
                cursor += 1;
            }
            if cursor < input.len() {
                return Result::Err(base64_failure(output, read))
            } else {
                read = cursor;
            }
        } else {}
    }
    Result::Ok(DecodeResult { bytes: output, read })
}

fn hex_digit(value: u16) -> isize {
    if value >= 48 && value <= 57 {
        (value - 48).to_isize()
    } else if value >= 65 && value <= 70 {
        (value - 65).to_isize() + 10
    } else if value >= 97 && value <= 102 {
        (value - 97).to_isize() + 10
    } else {
        -1
    }
}

fn hex_character(value: isize) -> byte {
    if value < 10 {
        (48 + value).to_u8()
    } else {
        (97 + value - 10).to_u8()
    }
}

pub fn encode_hex(input: Slice[byte]) -> Vec[byte] {
    let output: Vec[byte] = Vec::with_capacity(input.len() * 2);
    for value in input {
        output.push(hex_character(value.to_isize() >> 4));
        output.push(hex_character(value.to_isize() & 15));
    }
    output
}

pub fn decode_hex(input: Slice[u16], capacity: Option[isize]) -> Result[DecodeResult, DecodeFailure] {
    let output: Vec[byte] = Vec::new();
    if input.len() % 2 != 0 {
        return Result::Err(hex_failure(output, 0))
    } else {};
    let limit = decode_capacity(capacity);
    let count = if input.len() / 2 < limit {
        input.len() / 2
    } else {
        limit
    };
    output.reserve(count);
    let mut index = 0;
    while index < count {
        let high = hex_digit(input[index * 2]);
        let low = hex_digit(input[index * 2 + 1]);
        if high < 0 || low < 0 {
            return Result::Err(hex_failure(output, index * 2))
        } else {
            output.push(((high << 4) | low).to_u8())
        };
        index += 1;
    }
    Result::Ok(DecodeResult { bytes: output, read: count * 2 })
}
