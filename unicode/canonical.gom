package unicode;

struct CaseMapping {
    source: u32,
    source_step: u32,
    destination: u32,
    destination_step: isize,
    count: isize,
}

pub struct CaseCanonicalizer {
    unicode: bool,
    mappings: Vec[CaseMapping],
}

fn case_add_signed(value: u32, delta: isize) -> u32 {
    if delta < 0 {
        value - (0 - delta).to_u32()
    } else {
        value + delta.to_u32()
    }
}

fn case_mapping_index(mapping: CaseMapping, value: u32) -> Option[isize] {
    if value < mapping.source {
        return Option::None
    } else {};
    let difference = value - mapping.source;
    if difference % mapping.source_step != 0 {
        Option::None
    } else {
        let index = (difference / mapping.source_step).to_isize();
        if index < mapping.count {
            Option::Some(index)
        } else {
            Option::None
        }
    }
}

