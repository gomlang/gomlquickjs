impl CaseCanonicalizer {
    pub fn new(unicode: bool) -> CaseCanonicalizer {
        CaseCanonicalizer {
            unicode,
            mappings: if unicode {
                unicode_case_mappings()
            } else {
                legacy_case_mappings()
            },
        }
    }

    pub fn canonicalize(self: CaseCanonicalizer, value: u32) -> u32 {
        if value < 128 {
            if self.unicode && value >= 65 && value <= 90 {
                return value + 32
            } else if !self.unicode && value >= 97 && value <= 122 {
                return value - 32
            } else {
                return value
            }
        } else {};
        let mut first = 0;
        let mut last = self.mappings.len() - 1;
        while first <= last {
            let mapping_index = first + (last - first) / 2;
            let mapping = self.mappings[mapping_index];
            let mapping_end = mapping.source + mapping.source_step * (mapping.count - 1).to_u32();
            if value < mapping.source {
                last = mapping_index - 1;
            } else if value > mapping_end {
                first = mapping_index + 1;
            } else {
                return match case_mapping_index(mapping, value) {
                    Some(index) => case_add_signed(
                        mapping.destination,
                        mapping.destination_step * index,
                    ),
                    None => value,
                }
            }
        }
        value
    }

    pub fn equivalent_in_range(self: CaseCanonicalizer, range: CharRange, value: u32) -> bool {
        let canonical = self.canonicalize(value);
        if range.contains(canonical) {
            return true
        } else {};
        let mut mapping_index = 0;
        while mapping_index < self.mappings.len() {
            let mapping = self.mappings[mapping_index];
            let mut index = 0;
            while index < mapping.count {
                let source = mapping.source + mapping.source_step * index.to_u32();
                let destination = case_add_signed(
                    mapping.destination,
                    mapping.destination_step * index,
                );
                if destination == canonical && range.contains(source) {
                    return true
                } else {
                    index += 1;
                }
            }
            mapping_index += 1;
        }
        false
    }

    pub fn canonicalized_range(self: CaseCanonicalizer, range: CharRange) -> CharRange {
        let original = range.union(CharRange::new());
        let expanded = range.union(CharRange::new());
        let mut mapping_index = 0;
        while mapping_index < self.mappings.len() {
            let mapping = self.mappings[mapping_index];
            let mut index = 0;
            while index < mapping.count {
                let source = mapping.source + mapping.source_step * index.to_u32();
                if original.contains(source) {
                    let destination = case_add_signed(
                        mapping.destination,
                        mapping.destination_step * index,
                    );
                    match expanded.add_char(destination) {
                        Ok(()) => (),
                        Err(_) => (),
                    }
                } else {};
                index += 1;
            }
            mapping_index += 1;
        }
        let represented = expanded.union(CharRange::new());
        mapping_index = 0;
        while mapping_index < self.mappings.len() {
            let mapping = self.mappings[mapping_index];
            let mut index = 0;
            while index < mapping.count {
                let destination = case_add_signed(
                    mapping.destination,
                    mapping.destination_step * index,
                );
                if represented.contains(destination) {
                    let source = mapping.source + mapping.source_step * index.to_u32();
                    match expanded.add_char(source) {
                        Ok(()) => (),
                        Err(_) => (),
                    }
                } else {};
                index += 1;
            }
            mapping_index += 1;
        }
        expanded
    }
}
