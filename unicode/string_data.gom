package unicode;

fn string_hex_nibble(value: byte) -> u32 {
    if value >= b'0' && value <= b'9' {
        (value - b'0').to_u32()
    } else {
        (value - b'a' + 10).to_u32()
    }
}

fn string_decode_uint16(input: string) -> Vec[u16] {
    let output: Vec[u16] = Vec::with_capacity(input.byte_len() / 4);
    let mut index = 0;
    while index < input.byte_len() {
        let mut value: u32 = 0;
        let end = index + 4;
        while index < end {
            value = (value << 4) | string_hex_nibble(input.byte_get(index));
            index += 1;
        }
        output.push(value.to_u16());
    }
    output
}

fn string_decode_uint32(input: string) -> Vec[u32] {
    let output: Vec[u32] = Vec::with_capacity(input.byte_len() / 8);
    let mut index = 0;
    while index < input.byte_len() {
        let mut value: u32 = 0;
        let end = index + 8;
        while index < end {
            value = (value << 4) | string_hex_nibble(input.byte_get(index));
            index += 1;
        }
        output.push(value);
    }
    output
}

