package unicode;

fn string_hex_nibble(value: byte) -> uint32 {
    if value >= b'0' && value <= b'9' {
        (value - b'0').to_uint32()
    } else {
        (value - b'a' + 10).to_uint32()
    }
}

fn string_decode_uint8(input: string) -> Vec[uint8] {
    let output: Vec[uint8] = Vec::with_capacity(input.byte_len() / 2);
    let mut index = 0;
    while index < input.byte_len() {
        let mut value: uint32 = 0;
        let end = index + 2;
        while index < end {
            value = (value << 4) | string_hex_nibble(input.byte_get(index));
            index += 1;
        }
        output.push(value.to_uint8());
    }
    output
}

fn string_decode_uint16(input: string) -> Vec[uint16] {
    let output: Vec[uint16] = Vec::with_capacity(input.byte_len() / 4);
    let mut index = 0;
    while index < input.byte_len() {
        let mut value: uint32 = 0;
        let end = index + 4;
        while index < end {
            value = (value << 4) | string_hex_nibble(input.byte_get(index));
            index += 1;
        }
        output.push(value.to_uint16());
    }
    output
}

fn string_decode_uint32(input: string) -> Vec[uint32] {
    let output: Vec[uint32] = Vec::with_capacity(input.byte_len() / 8);
    let mut index = 0;
    while index < input.byte_len() {
        let mut value: uint32 = 0;
        let end = index + 8;
        while index < end {
            value = (value << 4) | string_hex_nibble(input.byte_get(index));
            index += 1;
        }
        output.push(value);
    }
    output
}

fn string_case_table1() -> Vec[uint32] {
    string_decode_uint32(
        "",
    )
}

fn string_case_table2() -> Vec[uint8] {
    string_decode_uint8(
        "",
    )
}

fn string_case_extension() -> Vec[uint16] {
    string_decode_uint16(
        "03990308030103a50313030003420391039703a900460049004c00530069030702bc004e004a030c053505520048033100540057030a0059004102be1f081f801f281f901f681fa01fba03861fb31fca03891fc303a11ffa038f1ff305440546053b054e053d03b80462a64a1e6003c9006b00e5",
    )
}

fn string_cased_table() -> Vec[uint8] {
    string_decode_uint8(
        "",
    )
}

fn string_cased_index() -> Vec[uint8] {
    string_decode_uint8("b90280a01e409ea64055d42115d7218af101")
}

fn string_case_ignorable_table() -> Vec[uint8] {
    string_decode_uint8(
        "",
    )
}

fn string_case_ignorable_index() -> Vec[uint8] {
    string_decode_uint8(
        "be0500fe0700520aa0c10b00820d003f1080d41740de1a20e91c0072200016a040c6a840c2aaa030fe00b10741510f01d011015f1401441961a81c012a6161ffaf0119e06100e701f0010e",
    )
}

fn string_combining_class_table() -> Vec[uint8] {
    string_decode_uint8(
        "",
    )
}

fn string_combining_class_index() -> Vec[uint8] {
    string_decode_uint8(
        "4d0300970520c60500e706004507009c08004d09003c0b003d0d00360f003810203a1900cb1a20f21b00c31d20d02000002e002ca800beaa00760301fa0e01801021e91201c314013f1901981d2167d1018fe021f6e6014be901",
    )
}

fn string_decomposition_table1() -> Vec[uint32] {
    string_decode_uint32(
        "",
    )
}

fn string_decomposition_table2() -> Vec[uint16] {
    string_decode_uint16(
        "",
    )
}

fn string_decomposition_data() -> Vec[uint8] {
    string_decode_uint8(
        "",
    )
}

fn string_composition_table() -> Vec[uint16] {
    string_decode_uint16(
        "",
    )
}

fn string_unicode_data() -> StringUnicodeData {
    StringUnicodeData {
        case_table1: string_case_table1(),
        case_table2: string_case_table2(),
        case_extension: string_case_extension(),
        cased_table: string_cased_table(),
        cased_index: string_cased_index(),
        case_ignorable_table: string_case_ignorable_table(),
        case_ignorable_index: string_case_ignorable_index(),
        combining_class_table: string_combining_class_table(),
        combining_class_index: string_combining_class_index(),
        decomposition_table1: string_decomposition_table1(),
        decomposition_table2: string_decomposition_table2(),
        decomposition_data: string_decomposition_data(),
        composition_table: string_composition_table(),
    }
}
