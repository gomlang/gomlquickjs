            3774383254.to_u32(),
            3644297029.to_u32(),
            2291741381.to_u32(),
            3639840657.to_u32(),
            1942432399.to_u32(),
            4065463795.to_u32(),
            3544826144.to_u32(),
            1159565171.to_u32(),
            2794470240.to_u32(),
            4186759157.to_u32(),
            3944960616.to_u32(),
            1605896120.to_u32(),
            3891222129.to_u32(),
            2551459612.to_u32(),
            4262009680.to_u32(),
            2798867591.to_u32(),
            1696450360.to_u32(),
            976412871.to_u32(),
            884987643.to_u32(),
            0.to_u32(),
            0.to_u32(),
            0.to_u32(),
            3525813898.to_u32(),
            799572635.to_u32(),
            3862322217.to_u32(),
            2363399422.to_u32(),
            799526600.to_u32(),
        ],
    );
    let mut hash: u32 = 2166136261;
    let mut total = 0;
    for name in names {
        let ranges = regexp_property_range(name).unwrap_or(CharRange::new()).ranges();
        for (first, last) in ranges {
            hash = regexp_property_mix(hash, first);
            hash = regexp_property_mix(hash, last);
        }
        hash = regexp_property_mix(hash, ranges.len().to_u32());
        total += ranges.len();
    }
    testing::assert_eq(total, 6635);
    testing::assert(hash == 3109717071.to_u32());
    testing::assert(
        regexp_property_range("General_Category=Uppercase_Letter").unwrap_or(CharRange::new()).ranges()
            == regexp_property_range("gc=Lu").unwrap_or(CharRange::new()).ranges(),
    );
    testing::assert(
        regexp_property_range("General_Category=Separator").unwrap_or(CharRange::new()).ranges()
            == regexp_property_range("Z").unwrap_or(CharRange::new()).ranges(),
    )
}

#[test]
fn regexp_scripts_and_extensions_match_quickjs_unicode_oracles() -> unit {
    let names = Vec::from_array(
        [
            "Unknown",
            "Common",
            "Inherited",
            "Latin",
            "Greek",
            "Han",
            "Bengali",
            "Deseret",
            "SignWriting",
            "Kirat_Rai",
            "Beria_Erfe",
            "Tulu_Tigalari",
        ],
    );
    let mut hash: u32 = 2166136261;
    let mut total = 0;
    for prefix in Vec::from_array(["Script=", "Script_Extensions="]) {
        for name in names {
            let ranges = regexp_property_range(prefix + name).unwrap_or(CharRange::new()).ranges();
            for (first, last) in ranges {
                hash = regexp_property_mix(hash, first);
                hash = regexp_property_mix(hash, last);
            }
            hash = regexp_property_mix(hash, ranges.len().to_u32());
            total += ranges.len();
        }
    }
    testing::assert_eq(total, 2182);
    testing::assert(hash == 3351902210.to_u32());
    testing::assert(
        regexp_property_range("sc=Latn").unwrap_or(CharRange::new()).ranges()
            == regexp_property_range("Script=Latin").unwrap_or(CharRange::new()).ranges(),
    );
    testing::assert(
        regexp_property_range("scx=Qaai").unwrap_or(CharRange::new()).ranges()
            == regexp_property_range("Script_Extensions=Inherited").unwrap_or(CharRange::new()).ranges(),
    )
}

#[test]
fn regexp_binary_properties_match_the_complete_quickjs_unicode_oracle() -> unit {
    let names = Vec::from_array(
        [
            "ASCII_Hex_Digit",
            "Bidi_Control",
            "Dash",
            "Deprecated",
            "Diacritic",
            "Extender",
            "Hex_Digit",
            "IDS_Unary_Operator",
            "IDS_Binary_Operator",
            "IDS_Trinary_Operator",
            "Ideographic",
            "Join_Control",
            "Logical_Order_Exception",
            "Modifier_Combining_Mark",
            "Noncharacter_Code_Point",
            "Pattern_Syntax",
            "Pattern_White_Space",
            "Quotation_Mark",
            "Radical",
            "Regional_Indicator",
            "Sentence_Terminal",
            "Soft_Dotted",
            "Terminal_Punctuation",
            "Unified_Ideograph",
            "Variation_Selector",
            "White_Space",
            "Bidi_Mirrored",
            "Emoji",
            "Emoji_Component",
            "Emoji_Modifier",
            "Emoji_Modifier_Base",
            "Emoji_Presentation",
            "Extended_Pictographic",
            "Default_Ignorable_Code_Point",
            "ID_Start",
            "Case_Ignorable",
            "ASCII",
            "Alphabetic",
            "Any",
            "Assigned",
            "Cased",
            "Changes_When_Casefolded",
            "Changes_When_Casemapped",
            "Changes_When_Lowercased",
            "Changes_When_NFKC_Casefolded",
            "Changes_When_Titlecased",
            "Changes_When_Uppercased",
            "Grapheme_Base",
            "Grapheme_Extend",
            "ID_Continue",
            "ID_Compat_Math_Start",
            "ID_Compat_Math_Continue",
            "InCB",
            "Lowercase",
            "Math",
            "Uppercase",
            "XID_Continue",
            "XID_Start",
        ],
    );
    let counts = Vec::from_array(
        [
            3,
            4,
            24,
            8,
            220,
            43,
            6,
            1,
            3,
            1,
            21,
            1,
            7,
            9,
            18,
            28,
            5,
            13,
            3,
            1,
            88,
            34,
            116,
            16,
            4,
            10,
            114,
            151,
            10,
            1,
            40,
            81,
            156,
            17,
            684,
            464,
            1,
            761,
            1,
            736,
            158,
            630,
            131,
            618,
            848,
            633,
            634,
            905,
            383,
            799,
            0,
            0,
            0,
            677,
            141,
            660,
            806,
            691,
        ],
    );
    let mut hash: u32 = 2166136261;
    let mut total = 0;
    for index in 0..names.len() {
        let property = regexp_property_range(names[index]);
        if index >= 50 && index <= 52 {
            testing::assert(property.is_none())
        } else {
            let ranges = property.unwrap_or(CharRange::new()).ranges();
            if ranges.len() != counts[index] {
                testing::fail("binary property count " + index.to_string())
            } else {};
            for (first, last) in ranges {
                hash = regexp_property_mix(hash, first);
                hash = regexp_property_mix(hash, last);
            }
            hash = regexp_property_mix(hash, ranges.len().to_u32());
            total += ranges.len();
        }
    }
    if total != 12618 {
        testing::fail("binary property total " + total.to_string())
    } else {};
    if hash != 3192467049.to_u32() {
        testing::fail("binary property hash " + hash.to_string())
    } else {};
    for (alias, index) in binary_property_aliases() {
        if index >= 50 && index <= 52 {
            testing::assert(regexp_property_range(alias).is_none())
        } else {
            if regexp_property_range(alias).unwrap_or(CharRange::new()).ranges()
                != regexp_property_range(names[index]).unwrap_or(CharRange::new()).ranges() {
                testing::fail("binary property alias " + alias)
            } else {}
        }
    }
}

fn regexp_string_property_oracle(name: string) -> (isize, isize, u32) {
    let strings = match regexp_property(name) {
        Some(RegExpProperty::Strings(values)) => values,
        _ => {
            testing::fail("expected Unicode string property");
            Vec::new()
        },
    };
    let mut units = 0;
    let mut hash: u32 = 2166136261;
    let mut string_index = 0;
    while string_index < strings.len() {
        let value = strings[string_index];
        let mut unit_index = 0;
        while unit_index < value.len() {
            hash = regexp_property_mix(hash, value[unit_index].to_u32());
            units += 1;
            unit_index += 1;
        }
        hash = regexp_property_mix(hash, value.len().to_u32());
        string_index += 1;
    };
    (strings.len(), units, hash)
}

#[test]
fn regexp_string_properties_match_the_complete_quickjs_unicode_oracle() -> unit {
    let names = Vec::from_array(
        [
            "Basic_Emoji",
            "Emoji_Keycap_Sequence",
            "RGI_Emoji_Modifier_Sequence",
            "RGI_Emoji_Flag_Sequence",
            "RGI_Emoji_Tag_Sequence",
            "RGI_Emoji_ZWJ_Sequence",
            "RGI_Emoji",
        ],
    );
    let expected = Vec::from_array(
        [
            (1400, 2837, 3040311922.to_u32()),
            (12, 36, 144128853.to_u32()),
            (670, 2650, 3696415675.to_u32()),
            (259, 1036, 734647809.to_u32()),
            (3, 42, 1922508027.to_u32()),
            (1614, 13501, 2220826088.to_u32()),
            (3958, 20102, 3232849213.to_u32()),
        ],
    );
    for index in 0..names.len() {
        testing::assert(regexp_string_property_oracle(names[index]) == expected[index])
    }
}
