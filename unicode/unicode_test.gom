package unicode;

use std::testing;

fn unwrap_encoded(result: Result[Vec[byte], Utf8Error]) -> Vec[byte] {
    match result {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            Vec::new()
        },
    }
}

fn unwrap_decoded(result: Result[Utf8Decoded, Utf8Error]) -> Utf8Decoded {
    match result {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            Utf8Decoded { code_point_value: 0.to_u32(), length_value: 0 }
        },
    }
}

fn unwrap_range(result: Result[CharRange, CharRangeError]) -> CharRange {
    match result {
        Result::Ok(value) => value,
        Result::Err(error) => {
            testing::fail(error.to_string());
            CharRange::new()
        },
    }
}

fn require_ok(result: Result[unit, CharRangeError]) -> unit {
    match result {
        Result::Ok(()) => (),
        Result::Err(error) => testing::fail(error.to_string()),
    }
}

fn check_round_trip(code_point: u32, expected: Vec[byte]) -> unit {
    let encoded = unwrap_encoded(unicode_to_utf8(code_point));
    testing::assert(encoded == expected);
    let decoded = unwrap_decoded(unicode_from_utf8(encoded.slice(0, encoded.len())));
    testing::assert_eq(decoded.code_point(), code_point);
    testing::assert_eq(decoded.length(), expected.len())
}

#[test]
fn quickjs_utf8_boundary_vectors_round_trip() -> unit {
    check_round_trip(0.to_u32(), Vec::from_array([0]));
    check_round_trip(0x7f.to_u32(), Vec::from_array([0x7f]));
    check_round_trip(0x80.to_u32(), Vec::from_array([0xc2, 0x80]));
    check_round_trip(0x7ff.to_u32(), Vec::from_array([0xdf, 0xbf]));
    check_round_trip(0x800.to_u32(), Vec::from_array([0xe0, 0xa0, 0x80]));
    check_round_trip(0xffff.to_u32(), Vec::from_array([0xef, 0xbf, 0xbf]));
    check_round_trip(0x10000.to_u32(), Vec::from_array([0xf0, 0x90, 0x80, 0x80]));
    check_round_trip(0x1fffff.to_u32(), Vec::from_array([0xf7, 0xbf, 0xbf, 0xbf]));
    check_round_trip(0x200000.to_u32(), Vec::from_array([0xf8, 0x88, 0x80, 0x80, 0x80]));
    check_round_trip(0x3ffffff.to_u32(), Vec::from_array([0xfb, 0xbf, 0xbf, 0xbf, 0xbf]));
    check_round_trip(0x4000000.to_u32(), Vec::from_array([0xfc, 0x84, 0x80, 0x80, 0x80, 0x80]));
    check_round_trip(QUICKJS_UTF8_MAX, Vec::from_array([0xfd, 0xbf, 0xbf, 0xbf, 0xbf, 0xbf]))
}

#[test]
fn quickjs_utf8_accepts_non_scalar_31_bit_values() -> unit {
    check_round_trip(0xd800.to_u32(), Vec::from_array([0xed, 0xa0, 0x80]));
    check_round_trip(0x110000.to_u32(), Vec::from_array([0xf4, 0x90, 0x80, 0x80]));
    testing::assert(unicode_to_utf8(CHAR_RANGE_LIMIT).is_err());
    testing::assert(try_unicode_to_utf8(CHAR_RANGE_LIMIT).is_none())
}

#[test]
fn quickjs_utf8_decoder_rejects_malformed_sequences() -> unit {
    let empty: Vec[byte] = Vec::new();
    let overlong_two = Vec::from_array([0xc0, 0x80]);
    let overlong_three = Vec::from_array([0xe0, 0x80, 0x80]);
    let truncated = Vec::from_array([0xf8, 0x88, 0x80]);
    let bad_continuation = Vec::from_array([0xf0, 0x90, 0x40, 0x80]);
    let invalid_leading = Vec::from_array([0xfe, 0x80, 0x80, 0x80, 0x80, 0x80]);
    testing::assert(unicode_from_utf8(empty.slice(0, 0)).is_err());
    testing::assert(unicode_from_utf8(overlong_two.slice(0, overlong_two.len())).is_err());
    testing::assert(unicode_from_utf8(overlong_three.slice(0, overlong_three.len())).is_err());
    testing::assert(unicode_from_utf8(truncated.slice(0, truncated.len())).is_err());
    testing::assert(unicode_from_utf8(bad_continuation.slice(0, bad_continuation.len())).is_err());
    testing::assert(unicode_from_utf8(invalid_leading.slice(0, invalid_leading.len())).is_err());
    testing::assert(try_unicode_from_utf8(overlong_two.slice(0, overlong_two.len())).is_none())
}

#[test]
fn quickjs_utf8_decoder_reports_consumed_length_at_offset() -> unit {
    let input = Vec::from_array([0x41, 0xf8, 0x88, 0x80, 0x80, 0x80, 0x42]);
    let decoded = unwrap_decoded(unicode_from_utf8_at(input.slice(0, input.len()), 1));
    testing::assert_eq(decoded.code_point(), 0x200000.to_u32());
    testing::assert_eq(decoded.length(), 5);
    testing::assert(unicode_from_utf8_at(input.slice(0, input.len()), -1).is_err());
    testing::assert(unicode_from_utf8_at(input.slice(0, input.len()), input.len()).is_err())
}

#[test]
fn character_ranges_merge_adjacent_and_overlapping_ranges() -> unit {
    let range = CharRange::new();
    require_ok(range.add_range(10.to_u32(), 20.to_u32()));
    require_ok(range.add_range(30.to_u32(), 40.to_u32()));
    require_ok(range.add_range(21.to_u32(), 29.to_u32()));
    require_ok(range.add_char(9.to_u32()));
    testing::assert_eq(range.range_count(), 1);
    testing::assert(range.range_at(0).unwrap_or((0.to_u32(), 0.to_u32())) == (9, 40));
    testing::assert(range.contains(9.to_u32()));
    testing::assert(range.contains(25.to_u32()));
    testing::assert(range.contains(40.to_u32()));
    testing::assert(!range.contains(8.to_u32()));
    testing::assert(!range.contains(41.to_u32()))
}

#[test]
fn character_range_union_and_intersection_obey_set_algebra() -> unit {
    let left = unwrap_range(CharRange::from_range(1.to_u32(), 5.to_u32()));
    require_ok(left.add_range(10.to_u32(), 15.to_u32()));
    let right = unwrap_range(CharRange::from_range(4.to_u32(), 12.to_u32()));
    let union = left.union(right);
    let intersection = left.intersection(right);
    testing::assert(union.ranges() == Vec::from_array([(1.to_u32(), 15.to_u32())]));
    testing::assert(
        intersection.ranges()
            == Vec::from_array([(4.to_u32(), 5.to_u32()), (10.to_u32(), 12.to_u32())]),
    );
    testing::assert(left.union(right).ranges() == right.union(left).ranges());
    testing::assert(left.intersection(right).ranges() == right.intersection(left).ranges());
    testing::assert(left.union(left).ranges() == left.ranges());
    testing::assert(left.intersection(left).ranges() == left.ranges())
}

#[test]
fn character_range_operations_match_pointwise_sets() -> unit {
    let left = CharRange::new();
    require_ok(left.add_range(1.to_u32(), 4.to_u32()));
    require_ok(left.add_range(8.to_u32(), 10.to_u32()));
    let right = CharRange::new();
    require_ok(right.add_range(3.to_u32(), 7.to_u32()));
    require_ok(right.add_range(10.to_u32(), 12.to_u32()));
    let union = left.union(right);
    let intersection = left.intersection(right);
    let difference = left.difference(right);
    let symmetric_difference = left.symmetric_difference(right);
    for value in 0..16 {
        let point = value.to_u32();
        let in_left = left.contains(point);
        let in_right = right.contains(point);
        testing::assert(union.contains(point) == (in_left || in_right));
        testing::assert(intersection.contains(point) == (in_left && in_right));
        testing::assert(difference.contains(point) == (in_left && !in_right));
        testing::assert(symmetric_difference.contains(point) == (in_left != in_right))
    }
}

#[test]
fn character_range_complement_and_invert_cover_the_31_bit_domain() -> unit {
    let range = unwrap_range(CharRange::from_range(10.to_u32(), 20.to_u32()));
    let complement = range.complement();
    testing::assert(complement.contains(0.to_u32()));
    testing::assert(complement.contains(9.to_u32()));
    testing::assert(!complement.contains(10.to_u32()));
    testing::assert(!complement.contains(20.to_u32()));
    testing::assert(complement.contains(21.to_u32()));
    testing::assert(complement.contains(QUICKJS_UTF8_MAX));
    testing::assert(range.intersection(complement).is_empty());
    testing::assert(range.union(complement).ranges() == CharRange::full().ranges());
    range.invert();
    testing::assert(range.ranges() == complement.ranges());
    range.invert();
    testing::assert(range.ranges() == Vec::from_array([(10.to_u32(), 20.to_u32())]))
}

#[test]
fn character_range_validates_boundaries() -> unit {
    let range = CharRange::new();
    testing::assert(range.add_range(4.to_u32(), 3.to_u32()).is_err());
    testing::assert(range.add_char(CHAR_RANGE_LIMIT).is_err());
    require_ok(range.add_char(QUICKJS_UTF8_MAX));
    testing::assert(range.contains(QUICKJS_UTF8_MAX));
    testing::assert(!range.contains(CHAR_RANGE_LIMIT))
}

#[test]
fn unicode_17_identifier_tables_match_ecmascript_boundaries() -> unit {
    let tables = IdentifierTables::new();
    testing::assert(tables.is_start('A'.to_u32()));
    testing::assert(tables.is_start('变'.to_u32()));
    testing::assert(tables.is_start(0x10400.to_u32()));
    testing::assert(!tables.is_start('0'.to_u32()));
    testing::assert(!tables.is_start(0x0300.to_u32()));
    testing::assert(!tables.is_start(0x200c.to_u32()));
    testing::assert(tables.is_continue('0'.to_u32()));
    testing::assert(tables.is_continue('_'.to_u32()));
    testing::assert(tables.is_continue(0x0300.to_u32()));
    testing::assert(tables.is_continue(0x200c.to_u32()));
    testing::assert(!tables.is_continue(0x1f600.to_u32()))
}

#[test]
fn regexp_case_canonicalizers_follow_legacy_and_unicode_rules() -> unit {
    let legacy = CaseCanonicalizer::new(false);
    testing::assert_eq(legacy.canonicalize(0x61), 0x41);
    testing::assert_eq(legacy.canonicalize(0x212a), 0x212a);
    testing::assert_eq(legacy.canonicalize(0x3c2), 0x3a3);
    let unicode = CaseCanonicalizer::new(true);
    testing::assert_eq(unicode.canonicalize(0x41), 0x61);
    testing::assert_eq(unicode.canonicalize(0x212a), 0x6b);
    testing::assert_eq(unicode.canonicalize(0x17f), 0x73);
    testing::assert_eq(unicode.canonicalize(0x10400), 0x10428)
}

#[test]
fn regexp_case_canonicalizer_finds_equivalent_range_members() -> unit {
    let range = CharRange::new();
    match range.add_char(0x6b) {
        Ok(()) => (),
        Err(_) => testing::fail("expected valid range member"),
    };
    let unicode = CaseCanonicalizer::new(true);
    testing::assert(unicode.equivalent_in_range(range, 0x212a));
    let legacy = CaseCanonicalizer::new(false);
    testing::assert(!legacy.equivalent_in_range(range, 0x212a))
}

fn canonicalizer_checksum(value: CaseCanonicalizer) -> (u64, u64, u64, u64) {
    let mut count: u64 = 0;
    let mut source_sum: u64 = 0;
    let mut destination_sum: u64 = 0;
    let mut pair_sum: u64 = 0;
    let mut source_value = 0;
    while source_value < 0x110000 {
        let source = source_value.to_u32();
        let destination = value.canonicalize(source);
        if destination != source {
            count += 1;
            source_sum += source.to_u64();
            destination_sum += destination.to_u64();
            pair_sum += (source.to_u64() + 1) * (destination.to_u64() + 3);
        } else {};
        source_value += 1;
    };
    (count, source_sum, destination_sum, pair_sum)
}

#[test]
fn regexp_case_canonicalization_tables_match_quickjs_oracle() -> unit {
    testing::assert(
        canonicalizer_checksum(CaseCanonicalizer::new(false))
            == (1476, 38871962, 36209787, 2417526739500),
    );
    testing::assert(
        canonicalizer_checksum(CaseCanonicalizer::new(true))
            == (1512, 39674458, 36028939, 2423458550366),
    )
}

#[test]
fn string_case_conversion_matches_quickjs_full_mappings_and_surrogates() -> unit {
    let unicode = StringUnicode::new();
    let input = Vec::from_array(
        [
            0x53,
            0x74,
            0x72,
            0x61,
            0xdf,
            0x65,
            0x20,
            0x130,
            0x20,
            0xfb03,
            0x20,
            0xd801,
            0xdc00,
            0xd800,
        ],
    );
    testing::assert(
        unicode.lowercase(input.slice(0, input.len()))
            == Vec::from_array(
                [
                    0x73,
                    0x74,
                    0x72,
                    0x61,
                    0xdf,
                    0x65,
                    0x20,
                    0x69,
                    0x307,
                    0x20,
                    0xfb03,
                    0x20,
                    0xd801,
                    0xdc28,
                    0xd800,
                ],
            ),
    );
    testing::assert(
        unicode.uppercase(input.slice(0, input.len()))
            == Vec::from_array(
                [
                    0x53,
                    0x54,
                    0x52,
                    0x41,
                    0x53,
                    0x53,
                    0x45,
                    0x20,
                    0x130,
                    0x20,
                    0x46,
                    0x46,
                    0x49,
                    0x20,
                    0xd801,
                    0xdc00,
                    0xd800,
                ],
            ),
    )
}

#[test]
fn string_lowercase_applies_the_final_sigma_context_rule() -> unit {
    let unicode = StringUnicode::new();
    let final_sigma = Vec::from_array([0x39f, 0x3a3, 0x301]);
    let medial_sigma = Vec::from_array([0x39f, 0x3a3, 0x391]);
    let no_leading_cased = Vec::from_array([0x3a3, 0x301]);
    testing::assert(
        unicode.lowercase(final_sigma.slice(0, final_sigma.len()))
            == Vec::from_array([0x3bf, 0x3c2, 0x301]),
    );
    testing::assert(
        unicode.lowercase(medial_sigma.slice(0, medial_sigma.len()))
            == Vec::from_array([0x3bf, 0x3c3, 0x3b1]),
    );
    testing::assert(
        unicode.lowercase(no_leading_cased.slice(0, no_leading_cased.len()))
            == Vec::from_array([0x3c3, 0x301]),
    )
}

#[test]
fn string_normalization_and_locale_compare_match_quickjs_oracles() -> unit {
    let unicode = StringUnicode::new();
    let composed = Vec::from_array([0xe9]);
    let decomposed = Vec::from_array([0x65, 0x301]);
    testing::assert(
        unicode.normalize(composed.slice(0, composed.len()), NormalizationForm::Nfd) == decomposed,
    );
    testing::assert(
        unicode.normalize(decomposed.slice(0, decomposed.len()), NormalizationForm::Nfc) == composed,
    );
    let compatibility = Vec::from_array([0xfb03, 0xff21]);
    testing::assert(
        unicode.normalize(compatibility.slice(0, compatibility.len()), NormalizationForm::Nfkc)
            == Vec::from_array([0x66, 0x66, 0x69, 0x41]),
    );
    let reordered = Vec::from_array([0x61, 0x315, 0x300]);
    testing::assert(
        unicode.normalize(reordered.slice(0, reordered.len()), NormalizationForm::Nfd)
            == Vec::from_array([0x61, 0x300, 0x315]),
    );
    let hangul = Vec::from_array([0xac00, 0xac01]);
    testing::assert(
        unicode.normalize(hangul.slice(0, hangul.len()), NormalizationForm::Nfd)
            == Vec::from_array([0x1100, 0x1161, 0x1100, 0x1161, 0x11a8]),
    );
    let hangul_components = Vec::from_array([0x1100, 0x1161, 0x11a8]);
    testing::assert(
        unicode.normalize(
            hangul_components.slice(0, hangul_components.len()),
            NormalizationForm::Nfc,
        )
            == Vec::from_array([0xac01]),
    );
    let exclusion = Vec::from_array([0x344]);
    testing::assert(
        unicode.normalize(exclusion.slice(0, exclusion.len()), NormalizationForm::Nfc)
            == Vec::from_array([0x308, 0x301]),
    );
    let surrogate = Vec::from_array([0xd800]);
    testing::assert(
        unicode.normalize(surrogate.slice(0, surrogate.len()), NormalizationForm::Nfkd) == surrogate,
    );
    testing::assert_eq(
        unicode.locale_compare(
            composed.slice(0, composed.len()),
            decomposed.slice(0, decomposed.len()),
        ),
        0,
    );
    let supplementary = Vec::from_array([0xd83d, 0xde00]);
    let basic = Vec::from_array([0xffff]);
    testing::assert_eq(
        unicode.locale_compare(
            supplementary.slice(0, supplementary.len()),
            basic.slice(0, basic.len()),
        ),
        62977,
    )
}

enum StringOracleOperation {
    Lower,
    Upper,
    Normalize(NormalizationForm),
}

fn string_oracle_mix(hash: u64, value: u64) -> u64 {
    (hash ^ value) * 1099511628211
}

fn string_oracle_checksum(strings: StringUnicode, operation: StringOracleOperation) -> (
    u64,
    u64,
    u64,
) {
    let mut hash: u64 = 14695981039346656037;
    let mut changed: u64 = 0;
    let mut total: u64 = 0;
    let mut code_point = 0;
    while code_point < 0x110000 {
        let input: Vec[u16] = Vec::with_capacity(2);
        if code_point <= 0xffff {
            input.push(code_point.to_u16())
        } else {
            let value = code_point.to_u32() - 0x10000;
            input.push((0xd800 + (value >> 10)).to_u16());
            input.push((0xdc00 + (value & 0x3ff)).to_u16());
        };
        let output = match operation {
            StringOracleOperation::Lower => strings.lowercase(input.slice(0, input.len())),
            StringOracleOperation::Upper => strings.uppercase(input.slice(0, input.len())),
            StringOracleOperation::Normalize(form) => strings.normalize(
                input.slice(0, input.len()),
                form,
            ),
        };
        if output != input {
            changed += 1;
        } else {};
        total += output.len().to_u64();
        hash = string_oracle_mix(hash, code_point.to_u64());
        hash = string_oracle_mix(hash, output.len().to_u64());
        for code_unit in output {
            hash = string_oracle_mix(hash, code_unit.to_u64());
        }
        code_point += 1;
    };
    (changed, total, hash)
}

#[test]
fn string_case_conversion_matches_the_complete_quickjs_unicode_oracle() -> unit {
    let strings = StringUnicode::new();
    testing::assert(
        string_oracle_checksum(strings, StringOracleOperation::Lower)
            == (1488, 2162689, 9895733012189813002),
    );
    testing::assert(
        string_oracle_checksum(strings, StringOracleOperation::Upper)
            == (1580, 2162806, 14268502886764206167),
    )
}

#[test]
fn string_normalization_matches_the_complete_quickjs_unicode_oracle() -> unit {
    let strings = StringUnicode::new();
    testing::assert(
        string_oracle_checksum(strings, StringOracleOperation::Normalize(NormalizationForm::Nfc))
            == (1120, 2162376, 9395736026486750030),
    );
    testing::assert(
        string_oracle_checksum(strings, StringOracleOperation::Normalize(NormalizationForm::Nfd))
            == (13253, 2185629, 13839240408634540075),
    );
    testing::assert(
        string_oracle_checksum(strings, StringOracleOperation::Normalize(NormalizationForm::Nfkc))
            == (4965, 2162717, 15599644114896141080),
    );
    testing::assert(
        string_oracle_checksum(strings, StringOracleOperation::Normalize(NormalizationForm::Nfkd))
            == (17086, 2186108, 8891651552957291414),
    )
}

#[test]
fn regexp_properties_cover_identifier_binary_and_general_category_aliases() -> unit {
    let id_start = regexp_property_range("ID_Start").unwrap_or(CharRange::new());
    testing::assert(id_start.contains(0x41));
    testing::assert(id_start.contains(0x10400));
    testing::assert(!id_start.contains(0x30));
    let id_continue = regexp_property_range("IDC").unwrap_or(CharRange::new());
    testing::assert(id_continue.contains(0x30));
    testing::assert(id_continue.contains(0x301));
    let ignorable = regexp_property_range("CI").unwrap_or(CharRange::new());
    testing::assert(ignorable.contains(0x27));
    testing::assert(ignorable.contains(0x301));
    testing::assert(!ignorable.contains(0x41));
    let deprecated = regexp_property_range("Deprecated").unwrap_or(CharRange::new());
    testing::assert(deprecated.contains(0x149));
    testing::assert(deprecated.contains(0xe0001));
    testing::assert(!deprecated.contains(0x14a));
    let separator = regexp_property_range("General_Category=Space_Separator").unwrap_or(
        CharRange::new(),
    );
    testing::assert(separator.contains(0x20));
    testing::assert(separator.contains(0x2007));
    testing::assert(!separator.contains(0x2028));
    testing::assert(regexp_property_range("ASCII").unwrap_or(CharRange::new()).contains(0x7f));
    testing::assert(!regexp_property_range("ASCII").unwrap_or(CharRange::new()).contains(0x80));
    testing::assert(regexp_property_range("Any").unwrap_or(CharRange::new()).contains(0x10ffff))
}

fn regexp_property_mix(hash: u32, value: u32) -> u32 {
    (hash ^ value) * 16777619
}

