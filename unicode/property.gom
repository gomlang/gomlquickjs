fn script_index(name: string) -> Option[isize] {
    for (alias, index) in script_aliases() {
        if alias == name {
            return Option::Some(index)
        }
    }
    Option::None
}

fn script_range(index: isize, extensions: bool) -> CharRange {
    let data = script_data();
    let points: Vec[u32] = Vec::new();
    let mut position = 0;
    let mut code_point: u32 = 0;
    while position < data.len() {
        let initial = data[position].to_u32();
        position += 1;
        let populated = initial >> 7 != 0;
        let mut length = initial & 0x7f;
        if length >= 96 && length < 112 {
            length = ((length - 96) << 8) | data[position].to_u32();
            position += 1;
            length += 96;
        } else if length >= 112 {
            length = ((length - 112) << 16) | (data[position].to_u32() << 8)
                | data[position + 1].to_u32();
            position += 2;
            length += 4192;
        }
        let end = code_point + length + 1;
        if populated {
            let current = data[position].to_isize();
            position += 1;
            if current == index || index == 0 {
                general_category_append(points, code_point, end)
            }
        }
        code_point = end;
    }
    let primary = CharRange { points };
    let primary = if index == 0 {
        any_property_range().difference(primary)
    } else {
        primary
    };
    if !extensions {
        return primary
    }
    let extension_data = script_extensions_data();
    let extension_points: Vec[u32] = Vec::new();
    let mut extension_position = 0;
    let mut extension_code_point: u32 = 0;
    let common = index == 26 || index == 59;
    while extension_position < extension_data.len() {
        let mut length = extension_data[extension_position].to_u32();
        extension_position += 1;
        if length >= 128 && length < 192 {
            length = ((length - 128) << 8) | extension_data[extension_position].to_u32();
            extension_position += 1;
            length += 128;
        } else if length >= 192 {
            length = ((length - 192) << 16) | (extension_data[extension_position].to_u32() << 8)
                | extension_data[extension_position + 1].to_u32();
            extension_position += 2;
            length += 16512;
        }
        let end = extension_code_point + length + 1;
        let count = extension_data[extension_position].to_isize();
        extension_position += 1;
        let mut matches = common && count != 0;
        let list_end = extension_position + count;
        while extension_position < list_end {
            if extension_data[extension_position].to_isize() == index {
                matches = true;
            }
            extension_position += 1;
        }
        if matches {
            general_category_append(extension_points, extension_code_point, end)
        }
        extension_code_point = end;
    }
    let extension_range = CharRange { points: extension_points };
    if common {
        primary.difference(extension_range)
    } else {
        primary.union(extension_range)
    }
}

fn regexp_script_range(name: string) -> Option[CharRange] {
    let (value, extensions) = if name.starts_with("Script_Extensions=") {
        (name.byte_slice(18, name.byte_len()), true)
    } else if name.starts_with("scx=") {
        (name.byte_slice(4, name.byte_len()), true)
    } else if name.starts_with("Script=") {
        (name.byte_slice(7, name.byte_len()), false)
    } else if name.starts_with("sc=") {
        (name.byte_slice(3, name.byte_len()), false)
    } else {
        return Option::None
    };
    match script_index(value) {
        Some(index) => Option::Some(script_range(index, extensions)),
        None => Option::None,
    }
}

fn general_category_mask(name: string) -> Option[u64] {
    let value = if name.starts_with("General_Category=") {
        name.byte_slice(17, name.byte_len())
    } else if name.starts_with("gc=") {
        name.byte_slice(3, name.byte_len())
    } else {
        name
    };
    let mask = match value {
        "Cn" | "Unassigned" => general_category_bit(0),
        "Lu" | "Uppercase_Letter" => general_category_bit(1),
        "Ll" | "Lowercase_Letter" => general_category_bit(2),
        "Lt" | "Titlecase_Letter" => general_category_bit(3),
        "Lm" | "Modifier_Letter" => general_category_bit(4),
        "Lo" | "Other_Letter" => general_category_bit(5),
        "Mn" | "Nonspacing_Mark" => general_category_bit(6),
        "Mc" | "Spacing_Mark" => general_category_bit(7),
        "Me" | "Enclosing_Mark" => general_category_bit(8),
        "Nd" | "Decimal_Number" | "digit" => general_category_bit(9),
        "Nl" | "Letter_Number" => general_category_bit(10),
        "No" | "Other_Number" => general_category_bit(11),
        "Sm" | "Math_Symbol" => general_category_bit(12),
        "Sc" | "Currency_Symbol" => general_category_bit(13),
        "Sk" | "Modifier_Symbol" => general_category_bit(14),
        "So" | "Other_Symbol" => general_category_bit(15),
        "Pc" | "Connector_Punctuation" => general_category_bit(16),
        "Pd" | "Dash_Punctuation" => general_category_bit(17),
        "Ps" | "Open_Punctuation" => general_category_bit(18),
        "Pe" | "Close_Punctuation" => general_category_bit(19),
        "Pi" | "Initial_Punctuation" => general_category_bit(20),
        "Pf" | "Final_Punctuation" => general_category_bit(21),
        "Po" | "Other_Punctuation" => general_category_bit(22),
        "Zs" | "Space_Separator" => general_category_bit(23),
        "Zl" | "Line_Separator" => general_category_bit(24),
        "Zp" | "Paragraph_Separator" => general_category_bit(25),
        "Cc" | "Control" | "cntrl" => general_category_bit(26),
        "Cf" | "Format" => general_category_bit(27),
        "Cs" | "Surrogate" => general_category_bit(28),
        "Co" | "Private_Use" => general_category_bit(29),
        "LC" | "Cased_Letter" => general_category_bit(1) | general_category_bit(2)
            | general_category_bit(3),
        "L" | "Letter" => general_category_bit(1) | general_category_bit(2)
            | general_category_bit(3)
            | general_category_bit(4)
            | general_category_bit(5),
        "M" | "Mark" | "Combining_Mark" => general_category_bit(6) | general_category_bit(7)
            | general_category_bit(8),
        "N" | "Number" => general_category_bit(9) | general_category_bit(10)
            | general_category_bit(11),
        "S" | "Symbol" => general_category_bit(12) | general_category_bit(13)
            | general_category_bit(14)
            | general_category_bit(15),
        "P" | "Punctuation" | "punct" => general_category_bit(16) | general_category_bit(17)
            | general_category_bit(18)
            | general_category_bit(19)
            | general_category_bit(20)
            | general_category_bit(21)
            | general_category_bit(22),
        "Z" | "Separator" => general_category_bit(23) | general_category_bit(24)
            | general_category_bit(25),
        "C" | "Other" => general_category_bit(0) | general_category_bit(26)
            | general_category_bit(27)
            | general_category_bit(28)
            | general_category_bit(29),
        _ => return Option::None,
    };
    Option::Some(mask)
}

fn general_category_append(points: Vec[u32], first: u32, end: u32) -> () {
    if first >= end {} else if points.len() > 0 && points[points.len() - 1] == first {
        points[points.len() - 1] = end;
    } else {
        points.push(first);
        points.push(end)
    }
}

fn general_category_range(mask: u64) -> CharRange {
    let data = general_category_data();
    let points: Vec[u32] = Vec::new();
    let mut position = 0;
    let mut code_point: u32 = 0;
    while position < data.len() {
        let initial = data[position].to_u32();
        position += 1;
        let category = (initial & 0x1f).to_isize();
        let mut length = initial >> 5;
        if length == 7 {
            length = data[position].to_u32();
            position += 1;
            if length < 128 {
                length += 7;
            } else if length < 192 {
                length = ((length - 128) << 8) | data[position].to_u32();
                position += 1;
                length += 135;
            } else {
                length = ((length - 192) << 16) | (data[position].to_u32() << 8)
                    | data[position + 1].to_u32();
                position += 2;
                length += 16519;
            }
        }
        let end = code_point + length + 1;
        if category == 31 {
            let upper = mask & general_category_bit(1) != 0;
            let lower = mask & general_category_bit(2) != 0;
            if upper && lower {
                general_category_append(points, code_point, end)
            } else if upper || lower {
                let mut value = code_point
                    + if lower {
                        1
                    } else {
                        0
                    };
                while value < end {
                    general_category_append(points, value, value + 1);
                    value += 2;
                }
            }
        } else if mask & general_category_bit(category) != 0 {
            general_category_append(points, code_point, end)
        }
        code_point = end;
    }
    CharRange { points }
}

fn ascii_property_range() -> CharRange {
    property_range_from_ranges(Vec::from_array([(0, 0x7f)]))
}

fn any_property_range() -> CharRange {
    property_range_from_ranges(Vec::from_array([(0, 0x10ffff)]))
}

