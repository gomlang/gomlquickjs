package unicode;

fn property_range_from_ranges(ranges: Vec[(u32, u32)]) -> CharRange {
    let result = CharRange::new();
    for (first, last) in ranges {
        match result.add_range(first, last) {
            Ok(()) => (),
            Err(_) => (),
        }
    }
    result
}

fn general_category_bit(index: isize) -> u64 {
    1.to_u64() << index
}

