fn property_range_from_ranges(ranges: Vec[(uint32, uint32)]) -> CharRange {
    let result = CharRange::new();
    for (first, last) in ranges {
        match result.add_range(first, last) {
            Ok(()) => (),
            Err(_) => (),
        }
    }
    result
}

fn general_category_bit(index: int) -> uint64 {
    1.to_uint64() << index
}

