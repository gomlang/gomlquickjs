fn binary_property_index(name: string) -> Option[isize] {
    for (alias, index) in binary_property_aliases() {
        if alias == name {
            return Option::Some(index)
        }
    }
    Option::None
}

fn binary_property_direct(index: isize) -> CharRange {
    let data = binary_property_data();
    let (start, length) = binary_property_offsets()[index];
    let end = start + length;
    let points: Vec[u32] = Vec::new();
    let mut position = start;
    let mut code_point: u32 = 0;
    let mut included = false;
    while position < end {
        let mut first = code_point;
        let byte = data[position].to_u32();
        position += 1;
        if byte < 64 {
            code_point += (byte >> 3) + 1;
            if included {
                general_category_append(points, first, code_point)
            }
            included = !included;
            first = code_point;
            code_point += (byte & 7) + 1;
        } else if byte >= 0x80 {
            code_point += byte - 0x80 + 1;
        } else if byte < 0x60 {
            code_point += (((byte - 0x40) << 8) | data[position].to_u32()) + 1;
            position += 1;
        } else {
            code_point += (((byte - 0x60) << 16) | (data[position].to_u32() << 8)
                | data[position + 1].to_u32())
                + 1;
            position += 2;
        }
        if included {
            general_category_append(points, first, code_point)
        }
        included = !included;
    }
    CharRange { points }
}

fn property_decode_points(input: string) -> CharRange {
    let points: Vec[u32] = Vec::with_capacity(input.byte_len() / 6);
    let mut index = 0;
    while index < input.byte_len() {
        let mut value: u32 = 0;
        let end = index + 6;
        while index < end {
            value = (value << 4) | string_hex_nibble(input.byte_get(index));
            index += 1;
        }
        points.push(value)
    }
    CharRange { points }
}

fn binary_property_category(indices: Vec[isize]) -> CharRange {
    let mut mask: u64 = 0;
    for index in indices {
        mask = mask | general_category_bit(index);
    }
    general_category_range(mask)
}

fn binary_property_alphabetic() -> CharRange {
    binary_property_category(Vec::from_array([1, 2, 3, 4, 5, 10])).union(binary_property_direct(4)).union(
        binary_property_direct(3),
    ).union(binary_property_direct(2))
}

fn binary_property_cased() -> CharRange {
    binary_property_category(Vec::from_array([1, 2, 3])).union(binary_property_direct(4)).union(
        binary_property_direct(3),
    )
}

fn binary_property_grapheme_base() -> CharRange {
    binary_property_category(Vec::from_array([26, 27, 28, 29, 0, 24, 25, 8, 6])).union(
        binary_property_direct(5),
    ).complement()
}

fn binary_property_grapheme_extend() -> CharRange {
    binary_property_category(Vec::from_array([8, 6])).union(binary_property_direct(5))
}

fn binary_property_xid_start() -> CharRange {
    let included = binary_property_category(Vec::from_array([1, 2, 3, 4, 5, 10])).union(
        binary_property_direct(7),
    );
    let excluded = binary_property_direct(36).union(binary_property_direct(37)).union(
        binary_property_direct(11),
    );
    included.difference(excluded)
}

fn binary_property_xid_continue() -> CharRange {
    let included = binary_property_category(Vec::from_array([1, 2, 3, 4, 5, 10, 6, 7, 9, 16])).union(
        binary_property_direct(7),
    ).union(binary_property_direct(8));
    let excluded = binary_property_direct(36).union(binary_property_direct(37)).union(
        binary_property_direct(12),
    );
    included.difference(excluded)
}

fn binary_property_range(index: isize) -> Option[CharRange] {
    if index >= 0 && index <= 35 {
        return Option::Some(binary_property_direct(index + 21))
    }
    let range = match index {
        36 => ascii_property_range(),
        37 => binary_property_alphabetic(),
        38 => any_property_range(),
        39 => general_category_range(general_category_bit(0)).complement(),
        40 => binary_property_cased(),
        41 => property_decode_points(changes_when_casefolded_points()),
        42 => property_decode_points(changes_when_uppercased_points()).union(
            property_decode_points(changes_when_lowercased_points()),
        ).union(property_decode_points(changes_when_casefolded_points())),
        43 => property_decode_points(changes_when_lowercased_points()),
        44 => property_decode_points(changes_when_nfkc_casefolded_points()),
        45 => property_decode_points(changes_when_uppercased_points()).symmetric_difference(
            binary_property_direct(13),
        ),
        46 => property_decode_points(changes_when_uppercased_points()),
        47 => binary_property_grapheme_base(),
        48 => binary_property_grapheme_extend(),
        49 => property_range_from_ranges(id_continue_ranges()),
        53 => binary_property_category(Vec::from_array([2])).union(binary_property_direct(3)),
        54 => binary_property_category(Vec::from_array([12])).union(binary_property_direct(1)),
        55 => binary_property_category(Vec::from_array([1])).union(binary_property_direct(4)),
        56 => binary_property_xid_continue(),
        57 => binary_property_xid_start(),
        _ => return Option::None,
    };
    Option::Some(range)
}

pub fn regexp_property_range(name: string) -> Option[CharRange] {
    match regexp_script_range(name) {
        Some(range) => return Option::Some(range),
        None => (),
    }
    match general_category_mask(name) {
        Some(mask) => return Option::Some(general_category_range(mask)),
        None => (),
    }
    match binary_property_index(name) {
        Some(index) => binary_property_range(index),
        None => Option::None,
    }
}

pub enum RegExpProperty {
    Scalar(CharRange),
    Strings(Vec[Vec[u16]]),
}

fn regexp_property_append_code_point(output: Vec[u16], value: u32) -> () {
    if value <= 0xffff {
        output.push(value.to_u16())
    } else {
        let adjusted = value - 0x10000;
        output.push((0xd800 + (adjusted >> 10)).to_u16());
        output.push((0xdc00 + (adjusted & 0x3ff)).to_u16())
    }
}

fn regexp_property_sequence(code_points: Vec[u32]) -> Vec[u16] {
    let output: Vec[u16] = Vec::new();
    for value in code_points {
        regexp_property_append_code_point(output, value)
    }
    output
}

fn regexp_property_copy_sequence(input: Vec[u32]) -> Vec[u32] {
    let output: Vec[u32] = Vec::with_capacity(input.len());
    for value in input {
        output.push(value)
    }
    output
}

fn regexp_property_add_sequence(values: Vec[Vec[u16]], code_points: Vec[u32]) -> () {
    values.push(regexp_property_sequence(code_points))
}

fn regexp_property_add_sequences(values: Vec[Vec[u16]], additions: Vec[Vec[u16]]) -> () {
    for value in additions {
        values.push(value)
    }
}

fn regexp_property_add_range_sequences(values: Vec[Vec[u16]], range: CharRange, suffix: Vec[u32]) -> () {
    for (first, last) in range.ranges() {
        let mut value = first;
        while value <= last {
            let sequence: Vec[u32] = Vec::from_array([value]);
            for code_point in suffix {
                sequence.push(code_point)
            }
            regexp_property_add_sequence(values, sequence);
            value += 1;
        }
    }
}

fn basic_emoji_sequences() -> Vec[Vec[u16]] {
    let values: Vec[Vec[u16]] = Vec::new();
    regexp_property_add_range_sequences(values, binary_property_direct(16), Vec::new());
    regexp_property_add_range_sequences(
        values,
        binary_property_direct(17),
        Vec::from_array([0xfe0f]),
    );
    values
}

fn emoji_keycap_sequences() -> Vec[Vec[u16]] {
    let values: Vec[Vec[u16]] = Vec::new();
    regexp_property_add_range_sequences(
        values,
        binary_property_direct(20),
        Vec::from_array([0xfe0f, 0x20e3]),
    );
    values
}

fn rgi_emoji_modifier_sequences() -> Vec[Vec[u16]] {
    let values: Vec[Vec[u16]] = Vec::new();
    for (first, last) in binary_property_direct(51).ranges() {
        let mut base = first;
        while base <= last {
            for modifier in 0..5 {
                regexp_property_add_sequence(
                    values,
                    Vec::from_array([base, 0x1f3fb + modifier.to_u32()]),
                )
            }
            base += 1;
        }
    }
    values
}

fn rgi_emoji_flag_sequences() -> Vec[Vec[u16]] {
    let values: Vec[Vec[u16]] = Vec::new();
    for (first, last) in binary_property_direct(19).ranges() {
        let mut value = first;
        while value <= last {
            regexp_property_add_sequence(
                values,
                Vec::from_array([0x1f1e6 + value / 26, 0x1f1e6 + value % 26]),
            );
            value += 1;
        }
    }
    values
}

fn rgi_emoji_tag_sequences() -> Vec[Vec[u16]] {
    let values: Vec[Vec[u16]] = Vec::new();
    let data = rgi_emoji_tag_sequence_data();
    let mut index = 0;
    while index < data.len() {
        let sequence: Vec[u32] = Vec::from_array([0x1f3f4]);
        while data[index] != 0 {
            sequence.push(0xe0000 + data[index].to_u32());
            index += 1;
        }
        index += 1;
        sequence.push(0xe007f);
        regexp_property_add_sequence(values, sequence);
    }
    values
}

fn rgi_emoji_zwj_sequences() -> Vec[Vec[u16]] {
    let values: Vec[Vec[u16]] = Vec::new();
    let data = rgi_emoji_zwj_sequence_data();
    let mut index = 0;
    while index < data.len() {
        let length = data[index].to_isize();
        index += 1;
        let sequence: Vec[u32] = Vec::new();
        let modifier_positions: Vec[isize] = Vec::new();
        let mut modifier_kind = 0;
        let mut hair_position = 0 - 1;
        for item_index in 0..length {
            let encoded = data[index].to_u32() | (data[index + 1].to_u32() << 8);
            index += 2;
            let presentation = encoded >> 15;
            let current_modifier_kind = ((encoded >> 13) & 3).to_isize();
            let compact = encoded & 0x1fff;
            let code_point = if compact < 0x1000 {
                compact + 0x2000
            } else {
                compact - 0x1000 + 0x1f000
            };
            if code_point == 0x1f9b0 {
                hair_position = sequence.len();
            }
            sequence.push(code_point);
            if current_modifier_kind != 0 {
                modifier_kind = current_modifier_kind;
                modifier_positions.push(sequence.len());
                sequence.push(0)
            }
            if presentation != 0 {
                sequence.push(0xfe0f)
            }
            if item_index < length - 1 {
                sequence.push(0x200d)
            }
        }
        let modifier_count = if modifier_kind == 1 {
            5
        } else if modifier_kind == 2 {
            25
        } else if modifier_kind == 3 {
            20
        } else {
            1
        };
        let hair_count = if hair_position >= 0 {
            4
        } else {
            1
        };
        for hair_index in 0..hair_count {
            for modifier_index in 0..modifier_count {
                let candidate = regexp_property_copy_sequence(sequence);
                if hair_position >= 0 {
                    candidate.set(hair_position, 0x1f9b0 + hair_index.to_u32())
                }
                if modifier_kind == 1 {
                    candidate.set(modifier_positions[0], 0x1f3fb + modifier_index.to_u32())
                } else if modifier_kind == 2 || modifier_kind == 3 {
                    let mut first = modifier_index / 5;
                    let second = modifier_index % 5;
                    if modifier_kind == 3 && first >= second {
                        first += 1;
                    }
                    candidate.set(modifier_positions[0], 0x1f3fb + first.to_u32());
                    candidate.set(modifier_positions[1], 0x1f3fb + second.to_u32())
                }
                regexp_property_add_sequence(values, candidate)
            }
        }
    }
    values
}

fn regexp_string_property(name: string) -> Option[Vec[Vec[u16]]] {
    let values: Vec[Vec[u16]] = match name {
        "Basic_Emoji" => basic_emoji_sequences(),
        "Emoji_Keycap_Sequence" => emoji_keycap_sequences(),
        "RGI_Emoji_Modifier_Sequence" => rgi_emoji_modifier_sequences(),
        "RGI_Emoji_Flag_Sequence" => rgi_emoji_flag_sequences(),
        "RGI_Emoji_Tag_Sequence" => rgi_emoji_tag_sequences(),
        "RGI_Emoji_ZWJ_Sequence" => rgi_emoji_zwj_sequences(),
        "RGI_Emoji" => {
            let output = basic_emoji_sequences();
            regexp_property_add_sequences(output, emoji_keycap_sequences());
            regexp_property_add_sequences(output, rgi_emoji_modifier_sequences());
            regexp_property_add_sequences(output, rgi_emoji_flag_sequences());
            regexp_property_add_sequences(output, rgi_emoji_tag_sequences());
            regexp_property_add_sequences(output, rgi_emoji_zwj_sequences());
            output
        },
        _ => return Option::None,
    };
    Option::Some(values)
}

pub fn regexp_property(name: string) -> Option[RegExpProperty] {
    match regexp_property_range(name) {
        Some(range) => Option::Some(RegExpProperty::Scalar(range)),
        None => match regexp_string_property(name) {
            Some(strings) => Option::Some(RegExpProperty::Strings(strings)),
            None => Option::None,
        },
    }
}
