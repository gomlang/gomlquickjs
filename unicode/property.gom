fn binary_property_index(name: string) -> Option[int] {
    for (alias, index) in binary_property_aliases() {
        if alias == name {
            return Option::Some(index)
        } else {}
    }
    Option::None
}

fn binary_property_direct(index: int) -> CharRange {
    let data = binary_property_data();
    let (start, length) = binary_property_offsets()[index];
    let end = start + length;
    let points: Vec[uint32] = Vec::[];
    let mut position = start;
    let mut code_point: uint32 = 0;
    let mut included = false;
    while position < end {
        let mut first = code_point;
        let byte = data[position].to_uint32();
        position += 1;
        if byte < 64 {
            code_point += (byte >> 3) + 1;
            if included {
                general_category_append(points, first, code_point)
            } else {};
            included = !included;
            first = code_point;
            code_point += (byte & 7) + 1;
        } else if byte >= 0x80 {
            code_point += byte - 0x80 + 1;
        } else if byte < 0x60 {
            code_point += (((byte - 0x40) << 8) | data[position].to_uint32()) + 1;
            position += 1;
        } else {
            code_point += (((byte - 0x60) << 16) | (data[position].to_uint32() << 8)
                | data[position + 1].to_uint32())
                + 1;
            position += 2;
        };
        if included {
            general_category_append(points, first, code_point)
        } else {};
        included = !included;
    }
    CharRange { points }
}

fn property_decode_points(input: string) -> CharRange {
    let points: Vec[uint32] = Vec::with_capacity(input.byte_len() / 6);
    let mut index = 0;
    while index < input.byte_len() {
        let mut value: uint32 = 0;
        let end = index + 6;
        while index < end {
            value = (value << 4) | string_hex_nibble(input.byte_get(index));
            index += 1;
        }
        points.push(value)
    }
    CharRange { points }
}

fn binary_property_category(indices: Vec[int]) -> CharRange {
    let mut mask: uint64 = 0;
    for index in indices {
        mask = mask | general_category_bit(index);
    }
    general_category_range(mask)
}

fn binary_property_alphabetic() -> CharRange {
    binary_property_category(Vec::[1, 2, 3, 4, 5, 10]).union(binary_property_direct(4)).union(
        binary_property_direct(3),
    ).union(binary_property_direct(2))
}

fn binary_property_cased() -> CharRange {
    binary_property_category(Vec::[1, 2, 3]).union(binary_property_direct(4)).union(
        binary_property_direct(3),
    )
}

fn binary_property_grapheme_base() -> CharRange {
    binary_property_category(Vec::[26, 27, 28, 29, 0, 24, 25, 8, 6]).union(
        binary_property_direct(5),
    ).complement()
}

fn binary_property_grapheme_extend() -> CharRange {
    binary_property_category(Vec::[8, 6]).union(binary_property_direct(5))
}

fn binary_property_xid_start() -> CharRange {
    let included = binary_property_category(Vec::[1, 2, 3, 4, 5, 10]).union(
        binary_property_direct(7),
    );
    let excluded = binary_property_direct(36).union(binary_property_direct(37)).union(
        binary_property_direct(11),
    );
    included.difference(excluded)
}

fn binary_property_xid_continue() -> CharRange {
    let included = binary_property_category(Vec::[1, 2, 3, 4, 5, 10, 6, 7, 9, 16]).union(
        binary_property_direct(7),
    ).union(binary_property_direct(8));
    let excluded = binary_property_direct(36).union(binary_property_direct(37)).union(
        binary_property_direct(12),
    );
    included.difference(excluded)
}

fn binary_property_range(index: int) -> Option[CharRange] {
    if index >= 0 && index <= 35 {
        return Option::Some(binary_property_direct(index + 21))
    } else {};
    let range = match index {
        36 => ascii_property_range(),
        37 => binary_property_alphabetic(),
        38 => any_property_range(),
        39 => general_category_range(general_category_bit(0)).complement(),
        40 => binary_property_cased(),
        41 => property_decode_points(changes_when_casefolded_points()),
        42 => property_decode_points(changes_when_uppercased_points()).union(
            property_decode_points(changes_when_lowercased_points()),
        ).union(property_decode_points(changes_when_casefolded_points())),
        43 => property_decode_points(changes_when_lowercased_points()),
        44 => property_decode_points(changes_when_nfkc_casefolded_points()),
        45 => property_decode_points(changes_when_uppercased_points()).symmetric_difference(
            binary_property_direct(13),
        ),
        46 => property_decode_points(changes_when_uppercased_points()),
        47 => binary_property_grapheme_base(),
        48 => binary_property_grapheme_extend(),
        49 => property_range_from_ranges(id_continue_ranges()),
        53 => binary_property_category(Vec::[2]).union(binary_property_direct(3)),
        54 => binary_property_category(Vec::[12]).union(binary_property_direct(1)),
        55 => binary_property_category(Vec::[1]).union(binary_property_direct(4)),
        56 => binary_property_xid_continue(),
        57 => binary_property_xid_start(),
        _ => return Option::None,
    };
    Option::Some(range)
}

pub fn regexp_property_range(name: string) -> Option[CharRange] {
    match regexp_script_range(name) {
        Some(range) => return Option::Some(range),
        None => (),
    };
    match general_category_mask(name) {
        Some(mask) => return Option::Some(general_category_range(mask)),
        None => (),
    };
    match binary_property_index(name) {
        Some(index) => binary_property_range(index),
        None => Option::None,
    }
}
