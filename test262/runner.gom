package test262;

use gomlang::quickjs::builtins;
use gomlang::quickjs::compiler;
use gomlang::quickjs::modules;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::fs;
use std::path;
use std::text;

pub type HarnessLoader = (string) -> Result[string, string];

#[derive(PartialEq, Eq, Debug)]
pub enum RunStatus {
    Passed,
    Failed,
    Skipped,
}

#[derive(PartialEq, Eq, Debug)]
pub struct RunResult {
    pub variant: SourceVariant,
    pub status: RunStatus,
    pub message: string,
}

enum AsyncCompletion {
    Pending,
    Passed,
    Failed(runtime::Value),
    Duplicate,
}

fn result(variant: SourceVariant, status: RunStatus, message: string) -> RunResult {
    RunResult { variant, status, message }
}

fn append_source(builder: text::StringBuilder, source: string) -> unit {
    builder.write_string(source);
    if source.byte_len() == 0 || source.byte_get(source.byte_len() - 1) != b'\n' {
        builder.write_char('\n')
    } else {}
}

fn harness_names(metadata: Metadata, variant: SourceVariant) -> Vec[string] {
    let names: Vec[string] = Vec::new();
    if variant == SourceVariant::Raw {
        return names
    } else {};
    push_unique(names, "assert.js");
    push_unique(names, "sta.js");
    for name in metadata.includes {
        push_unique(names, name)
    }
    names
}

pub fn prepare_source(case: TestCase, variant: SourceVariant, loader: HarnessLoader) -> Result[
    string,
    string,
] {
    let _ = loader;
    Result::Ok(variant_source(case, variant))
}

fn prepare_harness(metadata: Metadata, variant: SourceVariant, loader: HarnessLoader) -> Result[
    string,
    string,
] {
    let builder = text::StringBuilder::new();
    for name in harness_names(metadata, variant) {
        match loader(name) {
            Ok(source) => append_source(builder, source),
            Err(message) => return Result::Err("cannot load harness `" + name + "`: " + message),
        }
    }
    Result::Ok(builder.finish())
}

fn variant_source(case: TestCase, variant: SourceVariant) -> string {
    if variant == SourceVariant::Raw {
        return case.source
    } else {};
    let builder = text::StringBuilder::new();
    if variant == SourceVariant::Strict {
        append_source(builder, "\"use strict\";")
    } else {};
    append_source(builder, case.source);
    builder.finish()
}

fn unsupported_feature(feature: string) -> bool {
    feature == "Array.fromAsync" || feature == "Atomics.waitAsync" || feature == "IsHTMLDDA"
        || feature == "ShadowRealm"
        || feature == "WebAssembly"
        || feature == "await-dictionary"
        || feature == "cross-realm"
        || feature == "decorators"
        || feature == "decorator-metadata"
        || feature == "error-stack-accessor"
        || feature == "explicit-resource-management"
        || feature == "export-defer"
        || feature == "host-gc-required"
        || feature == "immutable-arraybuffer"
        || feature == "import-bytes"
        || feature == "import-defer"
        || feature == "import-text"
        || feature == "nonextensible-applies-to-private"
        || feature == "source-phase-imports"
        || feature == "source-phase-imports-module-source"
        || feature == "tail-call-optimization"
        || feature == "intl-normative-optional"
        || feature.starts_with("Intl")
        || feature.starts_with("Temporal")
}

fn skip_reason(metadata: Metadata) -> Option[string] {
    if has_flag(metadata, "CanBlockIsTrue") {
        return Option::Some("host cannot block")
    } else {};
    for feature in metadata.features {
        if unsupported_feature(feature) {
            return Option::Some("unsupported feature `" + feature + "`")
        } else {}
    }
    Option::None
}

fn compile_messages(errors: Vec[compiler::CompileError]) -> string {
    let builder = text::StringBuilder::new();
    let mut first = true;
    for compile_error in errors {
        if !first {
            builder.write_string("; ")
        } else {};
        builder.write_string(compile_error.span.start.to_string());
        builder.write_char(':');
        builder.write_string(compile_error.span.end.to_string());
        builder.write_string(": ");
        builder.write_string(compile_error.message);
        first = false;
    }
    builder.finish()
}

fn thrown_type(context: vm::Context, value: runtime::Value) -> string {
    match value {
        runtime::Value::Object(object) => match context.error_object_type(object) {
            Some(value) => value.to_host_string().unwrap_or("Thrown"),
            None => "Thrown",
        },
        _ => "Thrown",
    }
}

fn runtime_type(context: vm::Context, error: vm::VmErrorKind) -> string {
    match error {
        vm::VmErrorKind::TypeError(_) => "TypeError",
        vm::VmErrorKind::RangeError(_) => "RangeError",
        vm::VmErrorKind::ReferenceError(_) => "ReferenceError",
        vm::VmErrorKind::SyntaxError(_) | vm::VmErrorKind::SyntaxErrorAt(_, _) => "SyntaxError",
        vm::VmErrorKind::UriError(_) => "URIError",
        vm::VmErrorKind::Thrown(value) => thrown_type(context, value),
        vm::VmErrorKind::CallDepthExceeded => "InternalError",
        _ => "RuntimeError",
    }
}

fn compile_failure(variant: SourceVariant, metadata: Metadata, errors: Vec[compiler::CompileError]) -> RunResult {
    let message = compile_messages(errors);
    match metadata.negative {
        Some(NegativeExpectation { phase: NegativePhase::Parse, type_name }) => if type_name
            == "SyntaxError" {
            result(variant, RunStatus::Passed, message)
        } else {
            result(
                variant,
                RunStatus::Failed,
                "expected parse " + type_name + " but got parse SyntaxError: " + message,
            )
        },
        Some(NegativeExpectation { phase, type_name }) => result(
            variant,
            RunStatus::Failed,
            "expected "
                + match phase {
                    NegativePhase::Parse => "parse",
                    NegativePhase::Resolution => "resolution",
                    NegativePhase::Runtime => "runtime",
                }
                + " "
                + type_name
                + " but got parse SyntaxError: "
                + message,
        ),
        None => result(variant, RunStatus::Failed, "unexpected compile failure: " + message),
    }
}

fn runtime_success(variant: SourceVariant, metadata: Metadata) -> RunResult {
    match metadata.negative {
        Some(NegativeExpectation { phase, type_name }) => result(
            variant,
            RunStatus::Failed,
            "expected "
                + match phase {
                    NegativePhase::Parse => "parse",
                    NegativePhase::Resolution => "resolution",
                    NegativePhase::Runtime => "runtime",
                }
                + " "
                + type_name
                + " failure",
        ),
        None => result(variant, RunStatus::Passed, ""),
    }
}

fn runtime_failure(
    context: vm::Context,
    variant: SourceVariant,
    metadata: Metadata,
    offset: isize,
    kind: vm::VmErrorKind,
) -> RunResult {
    let actual_type = runtime_type(context, kind);
    let detail = "runtime " + actual_type + " at bytecode " + offset.to_string();
    match metadata.negative {
        Some(NegativeExpectation { phase: NegativePhase::Runtime, type_name }) => if type_name
            == actual_type {
            result(variant, RunStatus::Passed, detail)
        } else {
            result(
                variant,
                RunStatus::Failed,
                "expected runtime " + type_name + " but got " + actual_type,
            )
        },
        Some(NegativeExpectation { phase, type_name }) => result(
            variant,
            RunStatus::Failed,
            "expected "
                + match phase {
                    NegativePhase::Parse => "parse",
                    NegativePhase::Resolution => "resolution",
                    NegativePhase::Runtime => "runtime",
                }
                + " "
                + type_name
                + " but got "
                + detail,
        ),
        None => result(variant, RunStatus::Failed, "unexpected " + detail),
    }
}

fn harness_runtime_failure(
    context: vm::Context,
    variant: SourceVariant,
    offset: isize,
    kind: vm::VmErrorKind,
) -> RunResult {
    result(
        variant,
        RunStatus::Failed,
        "unexpected harness runtime " + runtime_type(context, kind) + " at bytecode "
            + offset.to_string(),
    )
}

fn async_argument(arguments: Vec[runtime::Value]) -> runtime::Value {
    if arguments.is_empty() {
        runtime::Value::Undefined
    } else {
        arguments[0]
    }
}

fn install_async_done(
    context: vm::Context,
    global: runtime::ObjectId,
    completion: Ref[AsyncCompletion],
) -> Result[unit, string] {
    let callback = match context.new_vm_function(
        |_, arguments, _| {
            completion.set(
                match completion.get() {
                    AsyncCompletion::Pending => {
                        let value = async_argument(arguments);
                        if runtime::to_boolean(value) {
                            AsyncCompletion::Failed(value)
                        } else {
                            AsyncCompletion::Passed
                        }
                    },
                    _ => AsyncCompletion::Duplicate,
                },
            );
            Result::Ok(runtime::Value::Undefined)
        },
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(error.kind.debug()),
    };
    if runtime::define_own_property(
        context.heap(),
        global,
        runtime::string_property_key("$DONE"),
        runtime::data_descriptor(callback, false, false, false),
    ) {
        Result::Ok(())
    } else {
        Result::Err("cannot install async $DONE callback")
    }
}

fn async_failure_message(context: vm::Context, value: runtime::Value) -> string {
    match context.value_to_string_at_depth(value, 0) {
        Ok(value) => match value.to_host_string() {
            Ok(value) => value,
            Err(_) => "unprintable async failure",
        },
        Err(_) => "unprintable async failure",
    }
}

fn async_success(
    context: vm::Context,
    variant: SourceVariant,
    metadata: Metadata,
    completion: Ref[AsyncCompletion],
) -> RunResult {
    match context.run_pending_jobs() {
        Ok(_) => (),
        Err(error) => return runtime_failure(context, variant, metadata, error.offset, error.kind),
    };
    match completion.get() {
        AsyncCompletion::Passed => runtime_success(variant, metadata),
        AsyncCompletion::Failed(value) => result(
            variant,
            RunStatus::Failed,
            "$DONE reported " + async_failure_message(context, value),
        ),
        AsyncCompletion::Duplicate => result(
            variant,
            RunStatus::Failed,
            "$DONE was called more than once",
        ),
        AsyncCompletion::Pending => result(
            variant,
            RunStatus::Failed,
            "async test completed without calling $DONE",
        ),
    }
}

pub fn run_variant(case: TestCase, variant: SourceVariant, loader: HarnessLoader) -> RunResult {
    match skip_reason(case.metadata) {
        Some(message) => return result(variant, RunStatus::Skipped, message),
        None => (),
    };
    if variant == SourceVariant::Module {
        return result(variant, RunStatus::Skipped, "modules are not implemented")
    } else {};
    let harness = match prepare_harness(case.metadata, variant, loader) {
        Ok(value) => value,
        Err(message) => return result(variant, RunStatus::Failed, message),
    };
    let source = variant_source(case, variant);
    let function = match compiler::compile(source) {
        Ok(value) => value,
        Err(errors) => return compile_failure(variant, case.metadata, errors),
    };
    let context = vm::Context::new(runtime::Heap::new());
    compiler::install_dynamic_function_compiler(context);
    match builtins::install(context) {
        Err(error) => result(
            variant,
            RunStatus::Failed,
            "cannot initialize realm: " + error.message,
        ),
        Ok(realm) => {
            let completion = Ref::new(AsyncCompletion::Pending);
            if case.metadata.asynchronous {
                match install_async_done(context, realm.global_object(), completion) {
                    Ok(()) => (),
                    Err(message) => return result(variant, RunStatus::Failed, message),
                }
            } else {};
            if harness.byte_len() > 0 {
                let harness_function = match context.compile_dynamic_eval_source(
                    harness,
                    Vec::new(),
                ) {
                    Ok(value) => value,
                    Err(error) => return harness_runtime_failure(
                        context,
                        variant,
                        error.offset,
                        error.kind,
                    ),
                };
                match context.execute(harness_function) {
                    Ok(_) => (),
                    Err(error) => return harness_runtime_failure(
                        context,
                        variant,
                        error.offset,
                        error.kind,
                    ),
                }
            } else {};
            match context.execute(function) {
                Ok(_) => if case.metadata.asynchronous {
                    async_success(context, variant, case.metadata, completion)
                } else {
                    runtime_success(variant, case.metadata)
                },
                Err(error) => runtime_failure(
                    context,
                    variant,
                    case.metadata,
                    error.offset,
                    error.kind,
                ),
            }
        },
    }
}

pub fn run(case: TestCase, loader: HarnessLoader) -> Vec[RunResult] {
    let results: Vec[RunResult] = Vec::new();
    for variant in source_variants(case.metadata) {
        results.push(run_variant(case, variant, loader))
    }
    results
}

fn prepare_module_harness(metadata: Metadata, loader: HarnessLoader) -> Result[string, string] {
    prepare_harness(metadata, SourceVariant::Module, loader)
}

fn module_error_phase(error: modules::ModuleError) -> NegativePhase {
    match error.runtime_type {
        Some(_) => NegativePhase::Runtime,
        None => NegativePhase::Resolution,
    }
}

fn module_error_type(error: modules::ModuleError) -> string {
    match error.runtime_type {
        Some(value) => return value,
        None => (),
    };
    match error.kind {
        modules::ModuleErrorKind::Reference => "ReferenceError",
        modules::ModuleErrorKind::Syntax => "SyntaxError",
        modules::ModuleErrorKind::Type => "TypeError",
    }
}

fn module_failure(metadata: Metadata, error: modules::ModuleError) -> RunResult {
    let actual_phase = module_error_phase(error);
    let actual_type = module_error_type(error);
    let detail = error.path + ": " + error.message;
    match metadata.negative {
        Some(NegativeExpectation { phase, type_name }) => if phase == actual_phase
            && type_name == actual_type {
            result(SourceVariant::Module, RunStatus::Passed, detail)
        } else {
            result(
                SourceVariant::Module,
                RunStatus::Failed,
                "expected "
                    + match phase {
                        NegativePhase::Parse => "parse",
                        NegativePhase::Resolution => "resolution",
                        NegativePhase::Runtime => "runtime",
                    }
                    + " "
                    + type_name
                    + " but got "
                    + match actual_phase {
                        NegativePhase::Parse => "parse",
                        NegativePhase::Resolution => "resolution",
                        NegativePhase::Runtime => "runtime",
                    }
                    + " "
                    + actual_type
                    + ": "
                    + detail,
            )
        },
        None => result(SourceVariant::Module, RunStatus::Failed, "unexpected " + detail),
    }
}

fn run_module_file(case: TestCase, file: string, loader: HarnessLoader) -> RunResult {
    match skip_reason(case.metadata) {
        Some(message) => return result(SourceVariant::Module, RunStatus::Skipped, message),
        None => (),
    };
    match compiler::compile_module(case.source) {
        Err(errors) => return compile_failure(SourceVariant::Module, case.metadata, errors),
        Ok(_) => (),
    };
    let harness = match prepare_module_harness(case.metadata, loader) {
        Ok(value) => value,
        Err(message) => return result(SourceVariant::Module, RunStatus::Failed, message),
    };
    let context = vm::Context::new(runtime::Heap::new());
    compiler::install_dynamic_function_compiler(context);
    let realm = match builtins::install(context) {
        Ok(value) => value,
        Err(error) => return result(
            SourceVariant::Module,
            RunStatus::Failed,
            "cannot initialize realm: " + error.message,
        ),
    };
    let completion = Ref::new(AsyncCompletion::Pending);
    if case.metadata.asynchronous {
        match install_async_done(context, realm.global_object(), completion) {
            Ok(()) => (),
            Err(message) => return result(SourceVariant::Module, RunStatus::Failed, message),
        }
    } else {};
    if harness.byte_len() > 0 {
        let harness_function = match context.compile_dynamic_eval_source(harness, Vec::new()) {
            Ok(value) => value,
            Err(error) => return harness_runtime_failure(
                context,
                SourceVariant::Module,
                error.offset,
                error.kind,
            ),
        };
        match context.execute(harness_function) {
            Err(error) => return harness_runtime_failure(
                context,
                SourceVariant::Module,
                error.offset,
                error.kind,
            ),
            Ok(_) => (),
        }
    } else {};
    match modules::execute_source(context, realm.global_object(), file, case.source) {
        Ok(_) => if case.metadata.asynchronous {
            async_success(context, SourceVariant::Module, case.metadata, completion)
        } else {
            runtime_success(SourceVariant::Module, case.metadata)
        },
        Err(error) => module_failure(case.metadata, error),
    }
}

pub fn run_file(file: string, harness_directory: string) -> Result[Vec[RunResult], string] {
    if file.starts_with("test/intl402/") || file.starts_with("test/staging/intl402/")
        || file.contains("/test/intl402/")
        || file.contains("/test/staging/intl402/") {
        return Result::Ok(
            Vec::from_array(
                [result(SourceVariant::Raw, RunStatus::Skipped, "Intl402 tests are not supported")],
            ),
        )
    } else {};
    if path::file_name(file).unwrap_or(file).contains("_FIXTURE") {
        return Result::Ok(
            Vec::from_array(
                [
                    result(
                        SourceVariant::Raw,
                        RunStatus::Skipped,
                        "fixture files are dependencies, not standalone tests",
                    ),
                ],
            ),
        )
    } else {};
    let source = match fs::read_file(file) {
        Ok(value) => value,
        Err(message) => return Result::Err("cannot read test `" + file + "`: " + message),
    };
    let case = match parse(source) {
        Ok(value) => value,
        Err(metadata_error) => return Result::Err(metadata_error.to_string()),
    };
    let loader: HarnessLoader = |name| {
        fs::read_file(path::join(harness_directory, name))
    };
    let results: Vec[RunResult] = Vec::new();
    for variant in source_variants(case.metadata) {
        if variant == SourceVariant::Module {
            results.push(run_module_file(case, file, loader))
        } else {
            results.push(run_variant(case, variant, loader))
        }
    }
    Result::Ok(results)
}
