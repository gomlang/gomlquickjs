package test262;

use std::fs;
use std::testing;

fn empty_harness(name: string) -> Result[string, string] {
    if name == "sta.js" || name == "assert.js" {
        Result::Ok("")
    } else {
        Result::Err("missing")
    }
}

fn sample_harness(name: string) -> Result[string, string] {
    if name == "assert.js" {
        Result::Ok("var harness_order = 'assert';")
    } else if name == "sta.js" {
        Result::Ok("harness_order += ',sta';")
    } else if name == "extra.js" {
        Result::Ok("harness_order += ',extra';")
    } else {
        Result::Err("missing")
    }
}

fn sloppy_harness(name: string) -> Result[string, string] {
    if name == "assert.js" {
        Result::Ok("var harness_sloppy = (function() { return this; })() !== undefined;")
    } else if name == "sta.js" {
        Result::Ok("")
    } else {
        Result::Err("missing")
    }
}

fn throwing_harness(name: string) -> Result[string, string] {
    if name == "assert.js" {
        Result::Ok("throw new TypeError('harness failure');")
    } else if name == "sta.js" {
        Result::Ok("")
    } else {
        Result::Err("missing")
    }
}

fn test262_error_harness(name: string) -> Result[string, string] {
    if name == "assert.js" {
        Result::Ok("")
    } else if name == "sta.js" {
        Result::Ok("function Test262Error() {}")
    } else {
        Result::Err("missing")
    }
}

fn lexical_harness(name: string) -> Result[string, string] {
    if name == "assert.js" {
        Result::Ok("let harness_lexical = 40; const harness_constant = 2;")
    } else if name == "sta.js" {
        Result::Ok("")
    } else {
        Result::Err("missing")
    }
}

fn case_from(source: string) -> TestCase {
    match parse(source) {
        Ok(value) => value,
        Err(value) => {
            testing::fail(value.to_string());
            case_from("/*---\nflags: [raw]\n---*/")
        },
    }
}

#[test]
fn prepares_strict_test_source_and_runs_harnesses_in_test262_order() -> () {
    let case = case_from(
        "/*---\nincludes: [extra.js, assert.js]\nflags: [onlyStrict]\n---*/\nif (harness_order !== 'assert,sta,extra') throw new Error('harness order');",
    );
    match prepare_source(case, SourceVariant::Strict, sample_harness) {
        Ok(value) => testing::assert(
            value
                == "\"use strict\";\n/*---\nincludes: [extra.js, assert.js]\nflags: [onlyStrict]\n---*/\nif (harness_order !== 'assert,sta,extra') throw new Error('harness order');\n",
        ),
        Err(value) => testing::fail(value),
    }
    let results = run(case, sample_harness);
    testing::assert_eq(results[0].status, RunStatus::Passed)
}

#[test]
fn preserves_raw_source_exactly() -> () {
    let source = "/*---\nflags: [raw]\n---*/\n0;";
    match prepare_source(case_from(source), SourceVariant::Raw, throwing_harness) {
        Ok(value) => testing::assert(value == source),
        Err(value) => testing::fail(value),
    }
}

#[test]
fn executes_harness_separately_and_never_uses_it_as_a_negative_result() -> () {
    let strict = run(
        case_from(
            "/*---\nflags: [onlyStrict]\n---*/\nif (!harness_sloppy) throw new Error('strict harness');",
        ),
        sloppy_harness,
    );
    testing::assert_eq(strict[0].status, RunStatus::Passed);
    let negative = run(
        case_from(
            "/*---\nflags: [noStrict]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow new TypeError('test failure');",
        ),
        throwing_harness,
    );
    testing::assert_eq(negative[0].status, RunStatus::Failed);
    testing::assert(negative[0].message.contains("harness runtime"))
}

#[test]
fn exposes_harness_global_lexicals_to_a_separately_compiled_test_script() -> () {
    let results = run(
        case_from(
            "/*---\nflags: [noStrict]\n---*/\nif (harness_lexical + harness_constant !== 42) throw new Error('missing lexical');",
        ),
        lexical_harness,
    );
    if results[0].status == RunStatus::Failed {
        testing::fail(results[0].message)
    }
    testing::assert_eq(results[0].status, RunStatus::Passed)
}

#[test]
fn passes_positive_and_parse_negative_cases() -> () {
    let positive = run(case_from("/*---\nflags: [raw]\n---*/\nlet value = 6 * 7;"), empty_harness);
    testing::assert_eq(positive.len(), 1);
    testing::assert_eq(positive[0].status, RunStatus::Passed);
    let negative = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: parse\n  type: SyntaxError\n---*/\nlet = ;",
        ),
        empty_harness,
    );
    testing::assert_eq(negative[0].status, RunStatus::Passed)
}

#[test]
fn rejects_negative_phase_and_type_mismatches() -> () {
    let wrong_type = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: parse\n  type: ReferenceError\n---*/\nlet = ;",
        ),
        empty_harness,
    );
    testing::assert_eq(wrong_type[0].status, RunStatus::Failed);
    testing::assert(wrong_type[0].message.contains("parse SyntaxError"));
    let wrong_phase = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: resolution\n  type: SyntaxError\n---*/\nlet = ;",
        ),
        empty_harness,
    );
    testing::assert_eq(wrong_phase[0].status, RunStatus::Failed);
    testing::assert(wrong_phase[0].message.contains("parse SyntaxError"))
}

#[test]
fn skips_unsupported_features_and_blocking_hosts() -> () {
    let unsupported = run(
        case_from("/*---\nflags: [raw]\nfeatures: [ShadowRealm]\n---*/\n0;"),
        empty_harness,
    );
    testing::assert_eq(unsupported[0].status, RunStatus::Skipped);
    testing::assert(unsupported[0].message.contains("ShadowRealm"));
    let cannot_block = run(
        case_from("/*---\nflags: [raw, CanBlockIsTrue]\n---*/\n0;"),
        empty_harness,
    );
    testing::assert_eq(cannot_block[0].status, RunStatus::Skipped);
    let agents = run(case_from("/*---\nincludes: [atomicsHelper.js]\n---*/\n0;"), empty_harness);
    testing::assert_eq(agents[0].status, RunStatus::Skipped);
    let realms = run(case_from("/*---\nflags: [raw]\n---*/\n$262.createRealm();"), empty_harness);
    testing::assert_eq(realms[0].status, RunStatus::Skipped);
    let supported = run(
        case_from("/*---\nflags: [raw, CanBlockIsFalse]\nfeatures: [BigInt]\n---*/\n1n;"),
        empty_harness,
    );
    testing::assert_eq(supported[0].status, RunStatus::Passed);
    for feature in Vec::from_array(
        [
            "export-defer",
            "import-text",
            "immutable-arraybuffer",
            "host-gc-required",
            "cross-realm",
            "intl-normative-optional",
            "tail-call-optimization",
        ],
    ) {
        let skipped = run(
            case_from("/*---\nflags: [raw]\nfeatures: [" + feature + "]\n---*/\n0;"),
            empty_harness,
        );
        testing::assert_eq(skipped[0].status, RunStatus::Skipped)
    }
    match run_file("test/intl402/missing.js", "harness") {
        Ok(results) => testing::assert_eq(results[0].status, RunStatus::Skipped),
        Err(message) => testing::fail(message.to_string()),
    }
}

#[test]
fn matches_runtime_type_errors_and_rejects_wrong_types() -> () {
    let matching = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\n({ value: 1 }).missing();",
        ),
        empty_harness,
    );
    testing::assert_eq(matching[0].status, RunStatus::Passed);
    let wrong = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: RangeError\n---*/\n({ value: 1 }).missing();",
        ),
        empty_harness,
    );
    testing::assert_eq(wrong[0].status, RunStatus::Failed);
    testing::assert(wrong[0].message.contains("TypeError"));
    let reference = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: ReferenceError\n---*/\nclass Base {} class Derived extends Base { constructor() {} } new Derived();",
        ),
        empty_harness,
    );
    testing::assert_eq(reference[0].status, RunStatus::Passed);
    let thrown = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow new TypeError('expected');",
        ),
        empty_harness,
    );
    testing::assert_eq(thrown[0].status, RunStatus::Passed);
    let thrown_wrong = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: RangeError\n---*/\nthrow new TypeError('expected');",
        ),
        empty_harness,
    );
    testing::assert_eq(thrown_wrong[0].status, RunStatus::Failed);
    testing::assert(thrown_wrong[0].message.contains("TypeError"));
    let spoofed = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow {name: 'TypeError', constructor: null};",
        ),
        empty_harness,
    );
    testing::assert_eq(spoofed[0].status, RunStatus::Failed);
    let constructor_spoofed = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow {constructor: {name: 'TypeError'}};",
        ),
        empty_harness,
    );
    testing::assert_eq(constructor_spoofed[0].status, RunStatus::Failed);
    let renamed = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nlet error = new TypeError('expected'); error.name = 'RangeError'; throw error;",
        ),
        empty_harness,
    );
    testing::assert_eq(renamed[0].status, RunStatus::Passed);
    let constructor_renamed = run(
        case_from(
            "/*---\nflags: [raw]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nlet error = new TypeError('expected'); error.constructor = RangeError; throw error;",
        ),
        empty_harness,
    );
    testing::assert_eq(constructor_renamed[0].status, RunStatus::Passed)
}

#[test]
fn recognizes_harness_test262_error_runtime_negatives() -> () {
    let results = run(
        case_from(
            "/*---\nflags: [noStrict]\nnegative:\n  phase: runtime\n  type: Test262Error\n---*/\nthrow new Test262Error();",
        ),
        test262_error_harness,
    );
    testing::assert_eq(results[0].status, RunStatus::Passed)
}

#[test]
fn installs_test262_eval_script_in_the_current_realm() -> () {
    let results = run(
        case_from(
            "/*---\nflags: [noStrict]\n---*/\n$262.evalScript('function introduced() { return 42; }'); if ($262.global !== globalThis || introduced() !== 42) throw 'wrong realm';",
        ),
        empty_harness,
    );
    testing::assert_eq(results[0].status, RunStatus::Passed)
}

#[test]
fn installs_test262_array_buffer_detachment() -> () {
    let results = run(
        case_from(
            "/*---\nflags: [noStrict]\n---*/\nlet buffer = new ArrayBuffer(4); $262.detachArrayBuffer(buffer); if (!buffer.detached || buffer.byteLength !== 0) throw 'not detached';",
        ),
        empty_harness,
    );
    testing::assert_eq(results[0].status, RunStatus::Passed)
}

#[test]
fn installs_test262_code_point_range_builder() -> () {
    let results = run(
        case_from(
            "/*---\nflags: [noStrict]\n---*/\nlet bmp = $262.codePointRange(0xD7FF, 0xE001); let astral = $262.codePointRange(0x1F600, 0x1F602); if (bmp.length !== 2050 || bmp.charCodeAt(0) !== 0xD7FF || bmp.charCodeAt(1) !== 0xD800 || bmp.charCodeAt(2048) !== 0xDFFF || bmp.charCodeAt(2049) !== 0xE000 || astral.length !== 4 || astral.codePointAt(0) !== 0x1F600 || astral.codePointAt(2) !== 0x1F601) throw 'wrong range';",
        ),
        empty_harness,
    );
    testing::assert_eq(results[0].status, RunStatus::Passed)
}

#[test]
fn skips_in_memory_modules_and_executes_async_variants() -> () {
    let module = run(case_from("/*---\nflags: [module]\n---*/\nexport {};"), empty_harness);
    testing::assert_eq(module[0].status, RunStatus::Skipped);
    let asynchronous = run(
        case_from(
            "/*---\nflags: [async, noStrict]\n---*/\nasync function test() { let value = await Promise.resolve(42); if (value !== 42) throw 'wrong'; } test().then($DONE, $DONE);",
        ),
        empty_harness,
    );
    testing::assert_eq(asynchronous[0].status, RunStatus::Passed);
    let failure = run(
        case_from("/*---\nflags: [async, noStrict]\n---*/\n$DONE('failure');"),
        empty_harness,
    );
    testing::assert_eq(failure[0].status, RunStatus::Failed);
    testing::assert(failure[0].message.contains("failure"));
    let missing = run(
        case_from("/*---\nflags: [async, noStrict]\n---*/\nPromise.resolve(1);"),
        empty_harness,
    );
    testing::assert_eq(missing[0].status, RunStatus::Failed);
    let duplicate = run(
        case_from("/*---\nflags: [async, noStrict]\n---*/\n$DONE(); $DONE();"),
        empty_harness,
    );
    testing::assert_eq(duplicate[0].status, RunStatus::Failed)
}

fn runner_write(path: string, source: string) -> () {
    match fs::write_file_structured(path, source) {
        Ok(()) => (),
        Err(message) => testing::fail(message.to_string()),
    }
}

fn runner_expect_status(results: Vec[RunResult], expected: RunStatus) -> () {
    testing::assert_eq(results.len(), 1);
    if results[0].status != expected {
        testing::fail(results[0].message)
    }
}

#[test]
fn run_file_executes_module_graphs_and_resolution_negatives() -> () {
    let directory = "__gomlquickjs_test262_modules_94c2__";
    let harness = directory + "/harness";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(harness);
    runner_write(harness + "/sta.js", "");
    runner_write(harness + "/assert.js", "let harnessVisible = 42;");
    runner_write(directory + "/dependency.js", "export default 42;");
    runner_write(
        directory + "/positive.js",
        "/*---\nflags: [module]\n---*/\nimport answer from './dependency.js'; if (answer !== 42 || harnessVisible !== 42) throw new Error('wrong answer');",
    );
    match run_file(directory + "/positive.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/negative.js",
        "/*---\nflags: [module]\nnegative:\n  phase: resolution\n  type: SyntaxError\n---*/\nimport {missing} from './dependency.js';",
    );
    match run_file(directory + "/negative.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/wrong_type.js",
        "/*---\nflags: [module]\nnegative:\n  phase: resolution\n  type: ReferenceError\n---*/\nimport {missing} from './dependency.js';",
    );
    match run_file(directory + "/wrong_type.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Failed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/wrong_phase.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: SyntaxError\n---*/\nimport {missing} from './dependency.js';",
    );
    match run_file(directory + "/wrong_phase.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Failed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow new TypeError('expected');",
    );
    match run_file(directory + "/runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/native_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nnull.value;",
    );
    match run_file(directory + "/native_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/spoofed_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow 'TypeError: fake';",
    );
    match run_file(directory + "/spoofed_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Failed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/object_spoofed_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow {constructor: {name: 'TypeError'}};",
    );
    match run_file(directory + "/object_spoofed_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Failed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/renamed_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nlet error = new TypeError('expected'); error.name = 'RangeError'; throw error;",
    );
    match run_file(directory + "/renamed_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/constructor_renamed_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nlet error = new TypeError('expected'); error.constructor = RangeError; throw error;",
    );
    match run_file(directory + "/constructor_renamed_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/async_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: RangeError\n---*/\nawait Promise.reject(new RangeError('expected'));",
    );
    match run_file(directory + "/async_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/spoofed_async_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: RangeError\n---*/\nawait Promise.reject('RangeError: fake');",
    );
    match run_file(directory + "/spoofed_async_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Failed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/pending_async_runtime.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: RuntimeError\n---*/\nawait new Promise(function() {});",
    );
    match run_file(directory + "/pending_async_runtime.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(
        directory + "/async.js",
        "/*---\nflags: [module, async]\n---*/\nimport answer from './dependency.js'; async function check() { if (await answer !== 42) throw 'wrong'; } check().then($DONE, $DONE);",
    );
    match run_file(directory + "/async.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(directory + "/helper_FIXTURE.js", "not standalone metadata");
    match run_file(directory + "/helper_FIXTURE.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Skipped),
        Err(message) => testing::fail(message.to_string()),
    }
    runner_write(harness + "/assert.js", "throw new TypeError('harness failure');");
    runner_write(
        directory + "/harness_negative.js",
        "/*---\nflags: [module]\nnegative:\n  phase: runtime\n  type: TypeError\n---*/\nthrow new TypeError('test failure');",
    );
    match run_file(directory + "/harness_negative.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Failed),
        Err(message) => testing::fail(message.to_string()),
    }
    let _ = fs::remove_dir_all(directory);
}

#[test]
fn run_file_resolves_dynamic_imports_from_script_files() -> () {
    let directory = "__gomlquickjs_test262_dynamic_import_271e__";
    let harness = directory + "/harness";
    let _ = fs::remove_dir_all(directory);
    let _ = fs::create_dir_all(harness);
    runner_write(harness + "/sta.js", "");
    runner_write(harness + "/assert.js", "");
    runner_write(directory + "/dependency.js", "export default 42;");
    runner_write(
        directory + "/dynamic.js",
        "/*---\nflags: [async, noStrict]\n---*/\nimport('./dependency.js').then(function(namespace) { $DONE(namespace.default === 42 ? undefined : 'wrong value'); }, $DONE);",
    );
    match run_file(directory + "/dynamic.js", harness) {
        Ok(results) => runner_expect_status(results, RunStatus::Passed),
        Err(message) => testing::fail(message.to_string()),
    }
    let _ = fs::remove_dir_all(directory);
}
