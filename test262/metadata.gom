package test262;

use std::text;

#[derive(PartialEq, Eq, Debug)]
pub enum NegativePhase {
    Parse,
    Resolution,
    Runtime,
}

#[derive(PartialEq, Eq, Debug)]
pub struct NegativeExpectation {
    pub phase: NegativePhase,
    pub type_name: string,
}

#[derive(PartialEq, Eq, Debug)]
pub enum SourceVariant {
    Sloppy,
    Strict,
    Module,
    Raw,
}

#[derive(PartialEq, Eq)]
pub struct Metadata {
    pub includes: Vec[string],
    pub flags: Vec[string],
    pub features: Vec[string],
    pub negative: Option[NegativeExpectation],
    pub asynchronous: bool,
}

#[derive(PartialEq, Eq)]
pub struct TestCase {
    pub source: string,
    pub metadata: Metadata,
}

#[derive(PartialEq, Eq, Debug)]
pub struct MetadataError {
    pub line: isize,
    pub message: string,
}

impl ToString for MetadataError {
    fn to_string(self: MetadataError) -> string {
        if self.line <= 0 {
            self.message
        } else {
            "metadata line " + self.line.to_string() + ": " + self.message
        }
    }
}

enum ListField {
    None,
    Includes,
    Flags,
    Features,
}

fn error(line: isize, message: string) -> MetadataError {
    MetadataError { line, message }
}

fn push_unique(values: Vec[string], value: string) -> () {
    if value == "" {} else {
        for current in values {
            if current == value {
                return ()
            } else {}
        }
        values.push(value)
    }
}

fn strip_quotes(value: string) -> string {
    if value.byte_len() >= 2 {
        let first = value.byte_get(0);
        let last = value.byte_get(value.byte_len() - 1);
        if (first == b'\'' && last == b'\'') || (first == b'"' && last == b'"') {
            value.byte_slice(1, value.byte_len() - 1)
        } else {
            value
        }
    } else {
        value
    }
}

fn parse_list_item(value: string) -> string {
    let trimmed = text::trim(value);
    let without_comma = if trimmed.ends_with(",") {
        text::trim_end(trimmed.byte_slice(0, trimmed.byte_len() - 1))
    } else {
        trimmed
    };
    strip_quotes(without_comma)
}

fn parse_inline_list(value: string, line: isize) -> Result[Vec[string], MetadataError] {
    let trimmed = text::trim(value);
    if trimmed.byte_len() < 2 || trimmed.byte_get(0) != b'['
        || trimmed.byte_get(trimmed.byte_len() - 1) != b']' {
        return Result::Err(error(line, "expected an inline list"))
    } else {};
    let body = trimmed.byte_slice(1, trimmed.byte_len() - 1);
    let result: Vec[string] = Vec::new();
    if text::trim(body) == "" {
        return Result::Ok(result)
    } else {};
    for item in text::split(body, ",") {
        let parsed = parse_list_item(item);
        if parsed == "" {
            return Result::Err(error(line, "empty list item"))
        } else {};
        push_unique(result, parsed)
    }
    Result::Ok(result)
}

fn append_values(target: Vec[string], values: Vec[string]) -> () {
    for value in values {
        push_unique(target, value)
    }
}

fn list_target(field: ListField, includes: Vec[string], flags: Vec[string], features: Vec[string]) -> Vec[
    string,
] {
    match field {
        ListField::Includes => includes,
        ListField::Flags => flags,
        ListField::Features => features,
        ListField::None => Vec::new(),
    }
}

fn parse_phase(value: string, line: isize) -> Result[NegativePhase, MetadataError] {
    match strip_quotes(text::trim(value)) {
        "parse" => Result::Ok(NegativePhase::Parse),
        "resolution" => Result::Ok(NegativePhase::Resolution),
        "runtime" => Result::Ok(NegativePhase::Runtime),
        value => Result::Err(error(line, "unknown negative phase `" + value + "`")),
    }
}

fn line_indent(value: string) -> isize {
    let mut index = 0;
    while index < value.byte_len()
        && (value.byte_get(index) == b' ' || value.byte_get(index) == b'\t') {
        index += 1;
    }
    index
}

fn has_flag(metadata: Metadata, expected: string) -> bool {
    for value in metadata.flags {
        if value == expected {
            return true
        } else {}
    }
    false
}

pub fn source_variants(metadata: Metadata) -> Vec[SourceVariant] {
    if has_flag(metadata, "module") {
        Vec::from_array([SourceVariant::Module])
    } else if has_flag(metadata, "raw") {
        Vec::from_array([SourceVariant::Raw])
    } else if has_flag(metadata, "onlyStrict") {
        Vec::from_array([SourceVariant::Strict])
    } else if has_flag(metadata, "noStrict") {
        Vec::from_array([SourceVariant::Sloppy])
    } else {
        Vec::from_array([SourceVariant::Sloppy, SourceVariant::Strict])
    }
}

fn parse_metadata(value: string) -> Result[Metadata, MetadataError] {
    let includes: Vec[string] = Vec::new();
    let flags: Vec[string] = Vec::new();
    let features: Vec[string] = Vec::new();
    let mut list_field = ListField::None;
    let mut in_negative = false;
    let mut negative_phase: Option[NegativePhase] = Option::None;
    let mut negative_type: Option[string] = Option::None;
    let normalized = text::replace(text::replace(value, "\r\n", "\n"), "\r", "\n");
    let lines = text::lines(normalized);
    for index in 0..lines.len() {
        let raw = lines[index];
        let line_number = index + 1;
        let indent = line_indent(raw);
        let line = text::trim(raw);
        if line == "" {
            continue
        } else {};
        if indent > 0 && line.starts_with("-") {
            if match list_field {
                ListField::None => true,
                _ => false,
            } {
                continue
            } else {};
            let item = parse_list_item(line.byte_slice(1, line.byte_len()));
            if item == "" {
                return Result::Err(error(line_number, "empty list item"))
            } else {};
            push_unique(list_target(list_field, includes, flags, features), item);
            continue
        } else {};
        let pair = match text::split_once(line, ":") {
            Some(value) => value,
            None => {
                if indent > 0 {
                    continue
                } else {
                    return Result::Err(error(line_number, "expected a metadata field"))
                }
            },
        };
        let name = text::trim(pair.0);
        let field_value = text::trim(pair.1);
        if indent > 0 && in_negative {
            if name == "phase" {
                negative_phase = Option::Some(parse_phase(field_value, line_number)?);
            } else if name == "type" {
                let type_name = strip_quotes(field_value);
                if type_name == "" {
                    return Result::Err(error(line_number, "negative type is empty"))
                } else {};
                negative_type = Option::Some(type_name);
            } else {};
            continue
        } else {};
        list_field = ListField::None;
        in_negative = false;
        if name == "includes" || name == "flags" || name == "features" {
            let selected = if name == "includes" {
                ListField::Includes
            } else if name == "flags" {
                ListField::Flags
            } else {
                ListField::Features
            };
            if field_value == "" {
                list_field = selected;
            } else {
                let values = parse_inline_list(field_value, line_number)?;
                append_values(list_target(selected, includes, flags, features), values)
            }
        } else if name == "negative" {
            if field_value != "" {
                return Result::Err(error(line_number, "negative metadata must be a mapping"))
            } else {};
            in_negative = true;
        } else {}
    }
    let negative = match (negative_phase, negative_type) {
        (None, None) => Option::None,
        (Some(phase), Some(type_name)) => Option::Some(NegativeExpectation { phase, type_name }),
        (None, Some(_)) => return Result::Err(error(0, "negative metadata is missing phase")),
        (Some(_), None) => return Result::Err(error(0, "negative metadata is missing type")),
    };
    let provisional = Metadata { includes, flags, features, negative, asynchronous: false };
    Result::Ok(Metadata { asynchronous: has_flag(provisional, "async"), ..provisional })
}

pub fn parse(source: string) -> Result[TestCase, MetadataError] {
    let header_start = match text::find(source, "/*---") {
        Some(value) => value,
        None => return Result::Err(error(0, "missing test262 metadata header")),
    };
    let metadata_start = header_start + 5;
    let suffix = source.byte_slice(metadata_start, source.byte_len());
    let relative_end = match text::find(suffix, "---*/") {
        Some(value) => value,
        None => return Result::Err(error(0, "unterminated test262 metadata header")),
    };
    let metadata_source = suffix.byte_slice(0, relative_end);
    Result::Ok(TestCase { source, metadata: parse_metadata(metadata_source)? })
}
