package builtins;

use gomlang::quickjs::arraybuffer;
use gomlang::quickjs::dtoa;
use gomlang::quickjs::encoding;
use gomlang::quickjs::mathx;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::math;
use std::num;

pub struct ArrayBufferInstall {
    pub array_buffer: runtime::Value,
    pub shared_array_buffer: runtime::Value,
    pub atomics: runtime::Value,
    pub data_view: runtime::Value,
    pub uint8_array: runtime::Value,
    pub int32_array: runtime::Value,
    pub float64_array: runtime::Value,
    pub uint8_clamped_array: runtime::Value,
    pub int8_array: runtime::Value,
    pub int16_array: runtime::Value,
    pub uint16_array: runtime::Value,
    pub uint32_array: runtime::Value,
    pub float16_array: runtime::Value,
    pub float32_array: runtime::Value,
    pub bigint64_array: runtime::Value,
    pub biguint64_array: runtime::Value,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    uint8_array_prototype: runtime::ObjectId,
    int32_array_prototype: runtime::ObjectId,
    float64_array_prototype: runtime::ObjectId,
    uint8_clamped_array_prototype: runtime::ObjectId,
    int8_array_prototype: runtime::ObjectId,
    int16_array_prototype: runtime::ObjectId,
    uint16_array_prototype: runtime::ObjectId,
    uint32_array_prototype: runtime::ObjectId,
    float16_array_prototype: runtime::ObjectId,
    float32_array_prototype: runtime::ObjectId,
    bigint64_array_prototype: runtime::ObjectId,
    biguint64_array_prototype: runtime::ObjectId,
}

impl ArrayBufferInstall {
    pub fn detach_array_buffer(self: ArrayBufferInstall, value: runtime::Value) -> Result[
        (),
        string,
    ] {
        let object = match value {
            runtime::Value::Object(value) => value,
            _ => return Result::Err("value is not an ArrayBuffer"),
        };
        let buffer = match self.buffer_states.get(object) {
            Some(value) => value,
            None => return Result::Err("value is not an ArrayBuffer"),
        };
        if buffer.is_detached() {
            return Result::Ok(())
        }
        match buffer.detach() {
            Ok(()) => Result::Ok(()),
            Err(value) => Result::Err(value.to_string()),
        }
    }
}

struct TypedArrayConstructors {
    uint8_array: runtime::Value,
    int32_array: runtime::Value,
    float64_array: runtime::Value,
    uint8_clamped_array: runtime::Value,
    int8_array: runtime::Value,
    int16_array: runtime::Value,
    uint16_array: runtime::Value,
    uint32_array: runtime::Value,
    float16_array: runtime::Value,
    float32_array: runtime::Value,
    bigint64_array: runtime::Value,
    biguint64_array: runtime::Value,
}

struct DataViewInstance {
    value: arraybuffer::DataView,
    buffer_object: runtime::ObjectId,
}

struct Uint8ArrayInstance {
    value: arraybuffer::Uint8Array,
    buffer_object: runtime::ObjectId,
}

struct Int32ArrayInstance {
    value: arraybuffer::Int32Array,
    buffer_object: runtime::ObjectId,
}

struct Float64ArrayInstance {
    value: arraybuffer::Float64Array,
    buffer_object: runtime::ObjectId,
}

struct NumericArrayInstance {
    value: arraybuffer::NumericArray,
    buffer_object: runtime::ObjectId,
    name: string,
}

struct BigIntArrayInstance {
    value: arraybuffer::BigIntArray,
    buffer_object: runtime::ObjectId,
    name: string,
}

fn define_arraybuffer_getter(
    heap: runtime::Heap,
    object: runtime::ObjectId,
    name: string,
    getter: runtime::Value,
) -> Result[(), BuiltinError] {
    if runtime::define_own_property(
        heap,
        object,
        runtime::string_property_key(name),
        runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
    ) {
        Result::Ok(())
    } else {
        Result::Err(BuiltinError { message: "cannot define builtin getter " + name })
    }
}

fn arraybuffer_constructor_prototype(heap: runtime::Heap, constructor: runtime::Value, name: string) -> Result[
    runtime::ObjectId,
    BuiltinError,
] {
    let object = function_object(constructor, name)?;
    match heap.get(object) {
        Some(value) => match value.own_property(runtime::string_property_key("prototype")) {
            Some(descriptor) => match runtime::descriptor_value(descriptor) {
                Some(runtime::Value::Object(value)) => Result::Ok(value),
                _ => Result::Err(BuiltinError { message: name + " prototype is invalid" }),
            },
            None => Result::Err(BuiltinError { message: name + " prototype is missing" }),
        },
        None => Result::Err(BuiltinError { message: name + " constructor is invalid" }),
    }
}

fn arraybuffer_native_error(value: arraybuffer::BufferError) -> vm::NativeError {
    native_error(value.to_string())
}

fn arraybuffer_receiver(value: runtime::Value, name: string) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    match value {
        runtime::Value::Object(value) => Result::Ok(value),
        _ => Result::Err(native_error(name + " method called on incompatible receiver")),
    }
}

fn arraybuffer_number(value: runtime::Value) -> Result[f64, vm::NativeError] {
    match runtime::primitive_to_number(value) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(native_error(value.message)),
    }
}

fn arraybuffer_integer(value: runtime::Value) -> Result[isize, vm::NativeError] {
    let number = arraybuffer_number(value)?;
    if math::is_nan(number) || number == 0.0 {
        return Result::Ok(0)
    } else if math::is_infinite(number) {
        return Result::Err(native_error("RangeError: integer argument is out of range"))
    }
    let integer = math::trunc(number);
    if integer < -2147483648.0 || integer > 2147483647.0 {
        Result::Err(native_error("RangeError: integer argument is out of range"))
    } else {
        Result::Ok(num::parse_int_structured(dtoa::number_to_string(integer)).unwrap_or(0))
    }
}

fn arraybuffer_index(value: runtime::Value) -> Result[isize, vm::NativeError] {
    let index = arraybuffer_integer(value)?;
    if index < 0 {
        Result::Err(native_error("RangeError: index must not be negative"))
    } else {
        Result::Ok(index)
    }
}

fn arraybuffer_index_number_at_depth(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    f64,
    vm::VmError,
] {
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    let number = match runtime::primitive_to_number(primitive) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    if math::is_nan(number) || number == 0.0 {
        Result::Ok(0.0)
    } else if !math::is_finite(number) {
        Result::Err(function_range_error("index is out of range"))
    } else {
        let integer = math::trunc(number);
        if integer < 0.0 || integer > 9007199254740991.0 {
            Result::Err(function_range_error("index is out of range"))
        } else {
            Result::Ok(integer)
        }
    }
}

fn arraybuffer_index_at_depth(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let number = arraybuffer_index_number_at_depth(context, value, depth)?;
    if number > 2147483647.0 {
        Result::Err(function_range_error("index is out of range"))
    } else {
        Result::Ok(num::parse_int_structured(dtoa::number_to_string(number)).unwrap_or(0))
    }
}

fn optional_index_at_depth(
    context: vm::Context,
    arguments: Vec[runtime::Value],
    index: isize,
    depth: isize,
) -> Result[Option[isize], vm::VmError] {
    if index >= arguments.len() {
        Result::Ok(Option::None)
    } else {
        match arguments[index] {
            runtime::Value::Undefined => Result::Ok(Option::None),
            value => Result::Ok(Option::Some(arraybuffer_index_at_depth(context, value, depth)?)),
        }
    }
}

fn optional_index(arguments: Vec[runtime::Value], index: isize) -> Result[
    Option[isize],
    vm::NativeError,
] {
    if index >= arguments.len() {
        Result::Ok(Option::None)
    } else {
        match arguments[index] {
            runtime::Value::Undefined => Result::Ok(Option::None),
            value => Result::Ok(Option::Some(arraybuffer_index(value)?)),
        }
    }
}

fn relative_index(arguments: Vec[runtime::Value], index: isize, default: isize) -> Result[
    isize,
    vm::NativeError,
] {
    if index >= arguments.len() {
        Result::Ok(default)
    } else {
        match arguments[index] {
            runtime::Value::Undefined => Result::Ok(default),
            value => arraybuffer_integer(value),
        }
    }
}

fn length_value(value: isize) -> runtime::Value {
    runtime::Value::Int(value.to_i32())
}

fn uint32_value(value: u32) -> runtime::Value {
    if value <= 2147483647 {
        runtime::Value::Int(value.to_i32())
    } else {
        runtime::Value::Float(num::parse_float64_structured(value.to_string()).unwrap_or(0.0))
    }
}

fn float32_value(value: f32) -> runtime::Value {
    runtime::Value::Float(arraybuffer::widen_float32(value))
}

fn array_buffer_state(
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    value: runtime::Value,
) -> Result[(runtime::ObjectId, arraybuffer::ArrayBuffer), vm::NativeError] {
    let object = arraybuffer_receiver(value, "ArrayBuffer")?;
    match states.get(object) {
        Some(value) => Result::Ok((object, value)),
        None => Result::Err(native_error("ArrayBuffer method called on incompatible receiver")),
    }
}

fn array_buffer_state_kind(
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    value: runtime::Value,
    shared: bool,
) -> Result[(runtime::ObjectId, arraybuffer::ArrayBuffer), vm::NativeError] {
    let state = array_buffer_state(states, value)?;
    if state.1.is_shared() == shared {
        Result::Ok(state)
    } else {
        Result::Err(native_error("ArrayBuffer method called on incompatible receiver"))
    }
}

fn constructor_receiver_prototype(
    heap: runtime::Heap,
    receiver: runtime::ObjectId,
    selected: Option[runtime::ObjectId],
    prototype: runtime::ObjectId,
) -> Result[(), vm::VmError] {
    match selected {
        Some(_) => Result::Ok(()),
        None => if runtime::set_prototype_of(heap, receiver, Option::Some(prototype)) {
            Result::Ok(())
        } else {
            Result::Err(function_vm_error("cannot initialize ArrayBuffer prototype"))
        },
    }
}

fn data_view_state(states: HashMap[runtime::ObjectId, DataViewInstance], value: runtime::Value) -> Result[
    DataViewInstance,
    vm::NativeError,
] {
    let object = arraybuffer_receiver(value, "DataView")?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error("DataView method called on incompatible receiver")),
    }
}

fn uint8_array_state(states: HashMap[runtime::ObjectId, Uint8ArrayInstance], value: runtime::Value) -> Result[
    Uint8ArrayInstance,
    vm::NativeError,
] {
    let object = arraybuffer_receiver(value, "Uint8Array")?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error("Uint8Array method called on incompatible receiver")),
    }
}

fn int32_array_state(states: HashMap[runtime::ObjectId, Int32ArrayInstance], value: runtime::Value) -> Result[
    Int32ArrayInstance,
    vm::NativeError,
] {
    let object = arraybuffer_receiver(value, "Int32Array")?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error("Int32Array method called on incompatible receiver")),
    }
}

fn float64_array_state(
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    value: runtime::Value,
) -> Result[Float64ArrayInstance, vm::NativeError] {
    let object = arraybuffer_receiver(value, "Float64Array")?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error("Float64Array method called on incompatible receiver")),
    }
}

fn materialize_array_buffer(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    prototype: runtime::ObjectId,
    value: arraybuffer::ArrayBuffer,
) -> Result[runtime::ObjectId, vm::NativeError] {
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    states[object] = value;
    Result::Ok(object)
}

fn array_buffer_construct_vm(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    prototype: runtime::ObjectId,
    receiver: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    selected_prototype: Option[runtime::ObjectId],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = depth;
    let length = match arguments[0] {
        runtime::Value::Float(value) => if value > 2147483647.0 {
            return Result::Err(function_range_error("ArrayBuffer length is out of range"))
        } else {
            num::parse_int_structured(dtoa::number_to_string(value)).unwrap_or(0)
        },
        _ => return Result::Err(function_vm_error("invalid prepared ArrayBuffer length")),
    };
    let max_byte_length = match arguments[1] {
        runtime::Value::Undefined => Option::None,
        runtime::Value::Float(value) => if value > 2147483647.0 {
            return Result::Err(function_range_error("ArrayBuffer maximum is out of range"))
        } else {
            Option::Some(num::parse_int_structured(dtoa::number_to_string(value)).unwrap_or(0))
        },
        _ => return Result::Err(function_vm_error("invalid prepared ArrayBuffer maximum")),
    };
    let value = match max_byte_length {
        Some(maximum) => arraybuffer::ArrayBuffer::new_resizable(length, maximum),
        None => arraybuffer::ArrayBuffer::new(length),
    };
    let value = match value {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
    };
    constructor_receiver_prototype(context.heap(), receiver, selected_prototype, prototype)?;
    states[receiver] = value;
    Result::Ok(runtime::Value::Object(receiver))
}

fn array_buffer_prepare_arguments(
    context: vm::Context,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let length = if arguments.is_empty() {
        0.0
    } else {
        arraybuffer_index_number_at_depth(context, arguments[0], depth)?
    };
    let options = if arguments.len() < 2 {
        Option::None
    } else {
        match arguments[1] {
            runtime::Value::Undefined => Option::None,
            runtime::Value::Object(value) => Option::Some(value),
            _ => Option::None,
        }
    };
    let max_byte_length = match options {
        None => Option::None,
        Some(options) => {
            let value = context.read_property_at_depth(
                runtime::Value::Object(options),
                runtime::Value::String(js_string("maxByteLength")),
                depth,
            )?;
            match value {
                runtime::Value::Undefined => Option::None,
                value => Option::Some(arraybuffer_index_number_at_depth(context, value, depth)?),
            }
        },
    };
    let maximum = match max_byte_length {
        Some(maximum) => {
            if length > maximum {
                return Result::Err(function_range_error("maxByteLength is smaller than byteLength"))
            }
            runtime::Value::Float(maximum)
        },
        None => runtime::Value::Undefined,
    };
    Result::Ok(Vec::from_array([runtime::Value::Float(length), maximum]))
}

fn shared_array_buffer_construct_vm(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    prototype: runtime::ObjectId,
    receiver: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    selected_prototype: Option[runtime::ObjectId],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = depth;
    let length = match arguments[0] {
        runtime::Value::Float(value) => if value > 2147483647.0 {
            return Result::Err(function_range_error("SharedArrayBuffer length is out of range"))
        } else {
            num::parse_int_structured(dtoa::number_to_string(value)).unwrap_or(0)
        },
        _ => return Result::Err(function_vm_error("invalid prepared SharedArrayBuffer length")),
    };
    let max_byte_length = match arguments[1] {
        runtime::Value::Undefined => Option::None,
        runtime::Value::Float(value) => if value > 2147483647.0 {
            return Result::Err(function_range_error("SharedArrayBuffer maximum is out of range"))
        } else {
            Option::Some(num::parse_int_structured(dtoa::number_to_string(value)).unwrap_or(0))
        },
        _ => return Result::Err(function_vm_error("invalid prepared SharedArrayBuffer maximum")),
    };
    let value = match max_byte_length {
        Some(maximum) => arraybuffer::ArrayBuffer::new_growable_shared(length, maximum),
        None => arraybuffer::ArrayBuffer::new_shared(length),
    };
    let value = match value {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
    };
    constructor_receiver_prototype(context.heap(), receiver, selected_prototype, prototype)?;
    states[receiver] = value;
    Result::Ok(runtime::Value::Object(receiver))
}

fn array_buffer_byte_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    shared: bool,
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(array_buffer_state_kind(states, this_value, shared)?.1.byte_length()))
}

fn array_buffer_max_byte_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    shared: bool,
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(
        length_value(array_buffer_state_kind(states, this_value, shared)?.1.max_byte_length()),
    )
}

fn array_buffer_resizable(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(
        runtime::Value::Bool(array_buffer_state_kind(states, this_value, false)?.1.is_resizable()),
    )
}

fn array_buffer_detached(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(
        runtime::Value::Bool(array_buffer_state_kind(states, this_value, false)?.1.is_detached()),
    )
}

fn shared_array_buffer_growable(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(
        runtime::Value::Bool(array_buffer_state_kind(states, this_value, true)?.1.is_growable()),
    )
}

fn array_buffer_resize(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let value = match array_buffer_state_kind(states, this_value, false) {
        Ok(value) => value.1,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let length = arraybuffer_index_at_depth(context, argument(arguments, 0), depth)?;
    match value.resize(length) {
        Ok(()) => Result::Ok(runtime::Value::Undefined),
        Err(value) => Result::Err(function_native_error(arraybuffer_native_error(value))),
    }
}

fn array_buffer_slice_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    default_constructor: runtime::Value,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    shared: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (source_object, source) = match array_buffer_state_kind(states, this_value, shared) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    if source.is_detached() {
        return Result::Err(function_vm_error("ArrayBuffer is detached"))
    }
    let source_length = source.byte_length();
    let begin = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        source_length,
    );
    let end = array_copy_start(
        array_copy_integer(context, argument(arguments, 1), source_length, depth)?,
        source_length,
    );
    let count = if end > begin {
        end - begin
    } else {
        0
    };
    let constructor = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("constructor")),
        depth,
    )?;
    let selected = match constructor {
        runtime::Value::Undefined => default_constructor,
        runtime::Value::Object(_) => {
            let species = match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
                Some(symbol) => context.read_property_at_depth(
                    constructor,
                    runtime::Value::Symbol(symbol),
                    depth,
                )?,
                None => runtime::Value::Undefined,
            };
            match species {
                runtime::Value::Null | runtime::Value::Undefined => default_constructor,
                value => value,
            }
        },
        _ => return Result::Err(function_vm_error("ArrayBuffer constructor is not an object")),
    };
    let target_value = context.construct_with_new_target_at_depth(
        selected,
        Vec::from_array([runtime::Value::Int(count.to_i32())]),
        selected,
        depth,
    )?;
    let target_object = match target_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("ArrayBuffer species returned a primitive")),
    };
    if target_object == source_object {
        return Result::Err(function_vm_error("ArrayBuffer species returned the source buffer"))
    }
    let target = match states.get(target_object) {
        Some(value) => value,
        None => return Result::Err(
            function_vm_error("ArrayBuffer species returned an incompatible object"),
        ),
    };
    if target.is_shared() != shared {
        return Result::Err(function_vm_error("ArrayBuffer species returned the wrong buffer kind"))
    } else if target.is_detached() || target.byte_length() < count {
        return Result::Err(function_vm_error("ArrayBuffer species returned a short buffer"))
    } else if source.is_detached() || begin > source.byte_length()
        || count > source.byte_length() - begin {
        return Result::Err(function_vm_error("ArrayBuffer source changed during slice"))
    }
    let source_bytes = match source.to_bytes() {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
    };
    match target.write_bytes(0, source_bytes.slice(begin, begin + count)) {
        Ok(()) => Result::Ok(target_value),
        Err(value) => Result::Err(function_native_error(arraybuffer_native_error(value))),
    }
}

fn array_buffer_transfer_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    fixed_length: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let value = match array_buffer_state_kind(states, this_value, false) {
        Ok(value) => value.1,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let length = optional_index_at_depth(context, arguments, 0, depth)?;
    let transferred = match if fixed_length {
        value.transfer_to_fixed_length(length)
    } else {
        value.transfer(length)
    } {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
    };
    match materialize_array_buffer(context.heap(), states, prototype, transferred) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(value) => Result::Err(function_native_error(value)),
    }
}

fn shared_array_buffer_grow_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let value = match array_buffer_state_kind(states, this_value, true) {
        Ok(value) => value.1,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let length = arraybuffer_index_at_depth(context, argument(arguments, 0), depth)?;
    match value.grow(length) {
        Ok(()) => Result::Ok(runtime::Value::Undefined),
        Err(value) => Result::Err(function_native_error(arraybuffer_native_error(value))),
    }
}

fn install_array_buffer_constructor(context: vm::Context) -> Result[
    (runtime::Value, runtime::ObjectId, HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer]),
    BuiltinError,
] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer] = HashMap::new();
    let constructor = allocate_vm_function(
        context,
        "ArrayBuffer",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("ArrayBuffer constructor requires new"))
        },
    )?;
    define_to_string_tag(context, prototype, "ArrayBuffer")?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteLength",
        allocate_function(
            context,
            "get ArrayBuffer.prototype.byteLength",
            |heap, this_value, arguments| {
                array_buffer_byte_length(heap, states, this_value, arguments, false)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "maxByteLength",
        allocate_function(
            context,
            "get ArrayBuffer.prototype.maxByteLength",
            |heap, this_value, arguments| {
                array_buffer_max_byte_length(heap, states, this_value, arguments, false)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "resizable",
        allocate_function(
            context,
            "get ArrayBuffer.prototype.resizable",
            |heap, this_value, arguments| {
                array_buffer_resizable(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "detached",
        allocate_function(
            context,
            "get ArrayBuffer.prototype.detached",
            |heap, this_value, arguments| {
                array_buffer_detached(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_value(
        heap,
        prototype,
        "resize",
        allocate_vm_function(
            context,
            "ArrayBuffer.prototype.resize",
            |this_value, arguments, depth| {
                array_buffer_resize(context, states, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "slice",
        allocate_vm_function(
            context,
            "ArrayBuffer.prototype.slice",
            |this_value, arguments, depth| {
                array_buffer_slice_at_depth(
                    context,
                    states,
                    constructor,
                    this_value,
                    arguments,
                    false,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "transfer",
        allocate_vm_function(
            context,
            "ArrayBuffer.prototype.transfer",
            |this_value, arguments, depth| {
                array_buffer_transfer_at_depth(
                    context,
                    states,
                    prototype,
                    this_value,
                    arguments,
                    false,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "transferToFixedLength",
        allocate_vm_function(
            context,
            "ArrayBuffer.prototype.transferToFixedLength",
            |this_value, arguments, depth| {
                array_buffer_transfer_at_depth(
                    context,
                    states,
                    prototype,
                    this_value,
                    arguments,
                    true,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            array_buffer_construct_vm(
                context,
                states,
                prototype,
                receiver,
                arguments,
                selected_prototype,
                depth,
            )
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register ArrayBuffer constructor" },
        ),
    }
    match context.set_vm_constructor_prepare_callback(
        constructor,
        |arguments, depth| array_buffer_prepare_arguments(context, arguments, depth),
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register ArrayBuffer constructor preparation" },
        ),
    }
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    Result::Ok((constructor, prototype, states))
}

fn install_shared_array_buffer_constructor(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
) -> Result[(runtime::Value, runtime::ObjectId), BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let constructor = allocate_vm_function(
        context,
        "SharedArrayBuffer",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("SharedArrayBuffer constructor requires new"))
        },
    )?;
    define_to_string_tag(context, prototype, "SharedArrayBuffer")?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteLength",
        allocate_function(
            context,
            "get SharedArrayBuffer.prototype.byteLength",
            |heap, this_value, arguments| {
                array_buffer_byte_length(heap, states, this_value, arguments, true)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "maxByteLength",
        allocate_function(
            context,
            "get SharedArrayBuffer.prototype.maxByteLength",
            |heap, this_value, arguments| {
                array_buffer_max_byte_length(heap, states, this_value, arguments, true)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "growable",
        allocate_function(
            context,
            "get SharedArrayBuffer.prototype.growable",
            |heap, this_value, arguments| {
                shared_array_buffer_growable(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_value(
        heap,
        prototype,
        "grow",
        allocate_vm_function(
            context,
            "SharedArrayBuffer.prototype.grow",
            |this_value, arguments, depth| {
                shared_array_buffer_grow_at_depth(context, states, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "slice",
        allocate_vm_function(
            context,
            "SharedArrayBuffer.prototype.slice",
            |this_value, arguments, depth| {
                array_buffer_slice_at_depth(
                    context,
                    states,
                    constructor,
                    this_value,
                    arguments,
                    true,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            shared_array_buffer_construct_vm(
                context,
                states,
                prototype,
                receiver,
                arguments,
                selected_prototype,
                depth,
            )
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register SharedArrayBuffer constructor" },
        ),
    }
    match context.set_vm_constructor_prepare_callback(
        constructor,
        |arguments, depth| array_buffer_prepare_arguments(context, arguments, depth),
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register SharedArrayBuffer constructor preparation" },
        ),
    }
    let object = function_object(constructor, "SharedArrayBuffer")?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(species) => if runtime::define_own_property(
            heap,
            object,
            runtime::PropertyKey::Symbol(species),
            runtime::accessor_descriptor(
                Option::Some(
                    allocate_function_with_length(
                        context,
                        "get [Symbol.species]",
                        0,
                        array_species_getter,
                    )?,
                ),
                Option::None,
                false,
                true,
            ),
        ) {} else {
            return Result::Err(BuiltinError { message: "cannot define SharedArrayBuffer species" })
        },
        None => (),
    }
    Result::Ok((constructor, prototype))
}

fn data_view_construct_vm(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    states: HashMap[runtime::ObjectId, DataViewInstance],
    receiver: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (buffer_object, buffer) = match array_buffer_state(buffer_states, argument(arguments, 0)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let byte_offset = if arguments.len() > 1 {
        arraybuffer_index_at_depth(context, arguments[1], depth)?
    } else {
        0
    };
    let value = match arraybuffer::DataView::new(
        buffer,
        byte_offset,
        optional_index_at_depth(context, arguments, 2, depth)?,
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
    };
    states[receiver] = DataViewInstance { value, buffer_object };
    Result::Ok(runtime::Value::Object(receiver))
}

fn data_view_prepare_arguments(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let buffer_value = argument(arguments, 0);
    let buffer = match array_buffer_state(buffer_states, buffer_value) {
        Ok(value) => value.1,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let byte_offset = if arguments.len() > 1 {
        arraybuffer_index_at_depth(context, arguments[1], depth)?
    } else {
        0
    };
    if buffer.is_detached() {
        return Result::Err(function_vm_error("DataView buffer is detached"))
    }
    let buffer_length = buffer.byte_length();
    if byte_offset > buffer_length {
        return Result::Err(function_range_error("DataView byteOffset is out of range"))
    }
    let byte_length = optional_index_at_depth(context, arguments, 2, depth)?;
    let prepared_length = match byte_length {
        Some(value) => {
            if value > buffer_length - byte_offset {
                return Result::Err(function_range_error("DataView byteLength is out of range"))
            }
            runtime::Value::Int(value.to_i32())
        },
        None => runtime::Value::Undefined,
    };
    Result::Ok(
        Vec::from_array([buffer_value, runtime::Value::Int(byte_offset.to_i32()), prepared_length]),
    )
}

fn data_view_buffer(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, DataViewInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(runtime::Value::Object(data_view_state(states, this_value)?.buffer_object))
}

fn data_view_byte_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, DataViewInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    match data_view_state(states, this_value)?.value.byte_length() {
        Ok(value) => Result::Ok(length_value(value)),
        Err(value) => Result::Err(arraybuffer_native_error(value)),
    }
}

fn data_view_byte_offset(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, DataViewInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    match data_view_state(states, this_value)?.value.byte_offset() {
        Ok(value) => Result::Ok(length_value(value)),
        Err(value) => Result::Err(arraybuffer_native_error(value)),
    }
}

fn data_view_get_number_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, DataViewInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    kind: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match data_view_state(states, this_value) {
        Ok(value) => value.value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let index = arraybuffer_index_at_depth(context, argument(arguments, 0), depth)?;
    let endian = Option::Some(runtime::to_boolean(argument(arguments, 1)));
    let result = match kind {
        0 => match state.get_int8(index) {
            Ok(value) => Result::Ok(runtime::Value::Int(value.to_i32())),
            Err(value) => Result::Err(value),
        },
        1 => match state.get_uint8(index) {
            Ok(value) => Result::Ok(runtime::Value::Int(value.to_i32())),
            Err(value) => Result::Err(value),
        },
        2 => match state.get_int16(index, endian) {
            Ok(value) => Result::Ok(runtime::Value::Int(value.to_i32())),
            Err(value) => Result::Err(value),
        },
        3 => match state.get_uint16(index, endian) {
            Ok(value) => Result::Ok(runtime::Value::Int(value.to_i32())),
            Err(value) => Result::Err(value),
        },
        4 => match state.get_int32(index, endian) {
            Ok(value) => Result::Ok(runtime::Value::Int(value)),
            Err(value) => Result::Err(value),
        },
        5 => match state.get_uint32(index, endian) {
            Ok(value) => Result::Ok(uint32_value(value)),
            Err(value) => Result::Err(value),
        },
        6 => match state.get_float16(index, endian) {
            Ok(value) => Result::Ok(runtime::Value::Float(value)),
            Err(value) => Result::Err(value),
        },
        7 => match state.get_float32(index, endian) {
            Ok(value) => Result::Ok(float32_value(value)),
            Err(value) => Result::Err(value),
        },
        _ => match state.get_float64(index, endian) {
            Ok(value) => Result::Ok(runtime::Value::Float(value)),
            Err(value) => Result::Err(value),
        },
    };
    match result {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(function_native_error(arraybuffer_native_error(value))),
    }
}

fn data_view_get_bigint_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, DataViewInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    signed: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match data_view_state(states, this_value) {
        Ok(value) => value.value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let index = arraybuffer_index_at_depth(context, argument(arguments, 0), depth)?;
    let value = if signed {
        state.get_big_int64(index, Option::Some(runtime::to_boolean(argument(arguments, 1))))
    } else {
        state.get_big_uint64(index, Option::Some(runtime::to_boolean(argument(arguments, 1))))
    };
    match value {
        Ok(value) => Result::Ok(runtime::Value::BigInt(runtime::BigInt::from_integer(value))),
        Err(value) => Result::Err(function_native_error(arraybuffer_native_error(value))),
    }
}

fn data_view_set_number_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, DataViewInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    kind: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match data_view_state(states, this_value) {
        Ok(value) => value.value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let index = arraybuffer_index_at_depth(context, argument(arguments, 0), depth)?;
    let number = typed_array_number(context, argument(arguments, 1), depth)?;
    let endian = Option::Some(runtime::to_boolean(argument(arguments, 2)));
    let result = match kind {
        0 => state.set_int8(index, number),
        1 => state.set_uint8(index, number),
        2 => state.set_int16(index, number, endian),
        3 => state.set_uint16(index, number, endian),
        4 => state.set_int32(index, number, endian),
        5 => state.set_uint32(index, number, endian),
        6 => {
            let source = if number == 0.0 && 1.0 / number < 0.0 {
                "-0"
            } else {
                dtoa::number_to_string(number)
            };
            let value = match num::parse_float32_structured(source) {
                Ok(value) => value,
                Err(_) => return Result::Err(function_vm_error("cannot convert value to Float32")),
            };
            state.set_float32(index, value, endian)
        },
        7 => state.set_float16(index, number, endian),
        _ => state.set_float64(index, number, endian),
    };
    match result {
        Ok(()) => Result::Ok(runtime::Value::Undefined),
        Err(value) => Result::Err(function_native_error(arraybuffer_native_error(value))),
    }
}

fn data_view_set_bigint_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, DataViewInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    signed: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match data_view_state(states, this_value) {
        Ok(value) => value.value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let index = arraybuffer_index_at_depth(context, argument(arguments, 0), depth)?;
    let value = match bigint_value_at_depth(context, argument(arguments, 1), depth)? {
        runtime::Value::BigInt(value) => value.integer(),
        _ => return Result::Err(function_vm_error("cannot convert value to BigInt")),
    };
    let endian = Option::Some(runtime::to_boolean(argument(arguments, 2)));
    let result = if signed {
        state.set_big_int64(index, value, endian)
    } else {
        state.set_big_uint64(index, value, endian)
    };
    match result {
        Ok(()) => Result::Ok(runtime::Value::Undefined),
        Err(value) => Result::Err(function_native_error(arraybuffer_native_error(value))),
    }
}

fn install_data_view_constructor(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
) -> Result[(runtime::Value, HashMap[runtime::ObjectId, DataViewInstance]), BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, DataViewInstance] = HashMap::new();
    define_to_string_tag(context, prototype, "DataView")?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "buffer",
        allocate_function(
            context,
            "get DataView.prototype.buffer",
            |heap, this_value, arguments| {
                data_view_buffer(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteLength",
        allocate_function(
            context,
            "get DataView.prototype.byteLength",
            |heap, this_value, arguments| {
                data_view_byte_length(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteOffset",
        allocate_function(
            context,
            "get DataView.prototype.byteOffset",
            |heap, this_value, arguments| {
                data_view_byte_offset(heap, states, this_value, arguments)
            },
        )?,
    )?;
    for (name, operation) in Vec::from_array(
        [
            ("getInt8", 0),
            ("getUint8", 1),
            ("getInt16", 2),
            ("getUint16", 3),
            ("getInt32", 4),
            ("getUint32", 5),
        ],
    ) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function(
                context,
                "DataView.prototype." + name,
                |this_value, arguments, depth| {
                    data_view_get_number_at_depth(
                        context,
                        states,
                        this_value,
                        arguments,
                        operation,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    for (name, signed) in Vec::from_array([("getBigInt64", true), ("getBigUint64", false)]) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function(
                context,
                "DataView.prototype." + name,
                |this_value, arguments, depth| {
                    data_view_get_bigint_at_depth(
                        context,
                        states,
                        this_value,
                        arguments,
                        signed,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    for (name, operation) in Vec::from_array(
        [("getFloat16", 6), ("getFloat32", 7), ("getFloat64", 8)],
    ) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function(
                context,
                "DataView.prototype." + name,
                |this_value, arguments, depth| {
                    data_view_get_number_at_depth(
                        context,
                        states,
                        this_value,
                        arguments,
                        operation,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    for (name, operation) in Vec::from_array(
        [
            ("setInt8", 0),
            ("setUint8", 1),
            ("setInt16", 2),
            ("setUint16", 3),
            ("setInt32", 4),
            ("setUint32", 5),
        ],
    ) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function(
                context,
                "DataView.prototype." + name,
                |this_value, arguments, depth| {
                    data_view_set_number_at_depth(
                        context,
                        states,
                        this_value,
                        arguments,
                        operation,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    for (name, signed) in Vec::from_array([("setBigInt64", true), ("setBigUint64", false)]) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function(
                context,
                "DataView.prototype." + name,
                |this_value, arguments, depth| {
                    data_view_set_bigint_at_depth(
                        context,
                        states,
                        this_value,
                        arguments,
                        signed,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    for (name, operation) in Vec::from_array(
        [("setFloat16", 7), ("setFloat32", 6), ("setFloat64", 8)],
    ) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function(
                context,
                "DataView.prototype." + name,
                |this_value, arguments, depth| {
                    data_view_set_number_at_depth(
                        context,
                        states,
                        this_value,
                        arguments,
                        operation,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    let constructor = allocate_vm_function(
        context,
        "DataView",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("DataView constructor requires new"))
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            constructor_receiver_prototype(context.heap(), receiver, selected_prototype, prototype)?;
            data_view_construct_vm(context, buffer_states, states, receiver, arguments, depth)
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register DataView constructor" },
        ),
    }
    match context.set_vm_constructor_prepare_callback(
        constructor,
        |arguments, depth| {
            data_view_prepare_arguments(context, buffer_states, arguments, depth)
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register DataView constructor preparation" },
        ),
    }
    let object = function_object(constructor, "DataView")?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    Result::Ok((constructor, states))
}

fn typed_constructor_length(arguments: Vec[runtime::Value]) -> Result[isize, vm::NativeError] {
    if arguments.is_empty() {
        Result::Ok(0)
    } else {
        match arguments[0] {
            runtime::Value::Undefined => Result::Ok(0),
            value => arraybuffer_index(value),
        }
    }
}

fn typed_array_collect_values(context: vm::Context, source: runtime::Value, depth: isize) -> Result[
    Vec[runtime::Value],
    vm::VmError,
] {
    typed_array_collect_mapped_values(
        context,
        source,
        runtime::Value::Undefined,
        runtime::Value::Undefined,
        depth,
    )
}

fn typed_array_collect_mapped_values(
    context: vm::Context,
    source: runtime::Value,
    mapper: runtime::Value,
    this_argument: runtime::Value,
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let global = match context.global_object() {
        Some(value) => runtime::Value::Object(value),
        None => return Result::Err(function_vm_error("global object is not installed")),
    };
    let constructor = context.read_property_at_depth(
        global,
        runtime::Value::String(js_string("Array")),
        depth,
    )?;
    let from = context.read_property_at_depth(
        constructor,
        runtime::Value::String(js_string("from")),
        depth,
    )?;
    let array = context.invoke_with_this_at_depth(
        from,
        Vec::from_array([source, mapper, this_argument]),
        constructor,
        depth,
    )?;
    let length_value = context.read_property_at_depth(
        array,
        runtime::Value::String(js_string("length")),
        depth,
    )?;
    let length = match length_value {
        runtime::Value::Int(value) => value.to_isize(),
        runtime::Value::Float(value) => if math::is_finite(value) && value >= 0.0
            && value <= 2147483647.0 {
            num::parse_int_structured(dtoa::number_to_string(math::trunc(value))).unwrap_or(0)
        } else {
            return Result::Err(function_range_error("typed array source is too large"))
        },
        _ => return Result::Err(function_vm_error("Array.from returned an invalid length")),
    };
    let values: Vec[runtime::Value] = Vec::with_capacity(length);
    let mut index = 0;
    while index < length {
        values.push(
            context.read_property_at_depth(array, runtime::Value::Int(index.to_i32()), depth)?,
        );
        index += 1;
    }
    Result::Ok(values)
}

fn typed_array_number(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    f64,
    vm::VmError,
] {
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    match runtime::primitive_to_number(primitive) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn typed_array_offset(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let integer = array_copy_integer(context, value, 0, depth)?;
    if integer < 0 {
        Result::Err(function_range_error("typed array offset is out of range"))
    } else {
        Result::Ok(integer)
    }
}

fn typed_array_prepare_arguments(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    arguments: Vec[runtime::Value],
    element_size: isize,
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    if arguments.is_empty() {
        return Result::Ok(arguments)
    }
    let first = arguments[0];
    let buffer = match first {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(value) => value,
            None => return Result::Ok(arguments),
        },
        _ => {
            let length = arraybuffer_index_at_depth(context, first, depth)?;
            return Result::Ok(Vec::from_array([runtime::Value::Int(length.to_i32())]))
        },
    };
    let offset = if arguments.len() > 1 {
        arraybuffer_index_at_depth(context, arguments[1], depth)?
    } else {
        0
    };
    if offset % element_size != 0 {
        return Result::Err(function_range_error("typed array offset is not aligned"))
    } else if buffer.is_detached() {
        return Result::Err(function_vm_error("typed array buffer is detached"))
    } else if offset > buffer.byte_length() {
        return Result::Err(function_range_error("typed array offset is out of range"))
    }
    let prepared: Vec[runtime::Value] = Vec::from_array(
        [first, runtime::Value::Int(offset.to_i32())],
    );
    if arguments.len() > 2 {
        match arguments[2] {
            runtime::Value::Undefined => prepared.push(runtime::Value::Undefined),
            value => {
                let length = arraybuffer_index_at_depth(context, value, depth)?;
                if buffer.is_detached() {
                    return Result::Err(function_vm_error("typed array buffer is detached"))
                } else if length > (buffer.byte_length() - offset) / element_size {
                    return Result::Err(function_range_error("typed array length is out of range"))
                }
                prepared.push(runtime::Value::Int(length.to_i32()))
            },
        }
    } else if !buffer.is_resizable() && !buffer.is_growable()
        && (buffer.byte_length() - offset) % element_size != 0 {
        return Result::Err(function_range_error("typed array buffer length is not aligned"))
    }
    Result::Ok(prepared)
}

fn install_typed_array_constructor_prepare(
    context: vm::Context,
    constructor: runtime::Value,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    element_size: isize,
    name: string,
) -> Result[(), BuiltinError] {
    match context.set_vm_constructor_prepare_callback(
        constructor,
        |arguments, depth| {
            typed_array_prepare_arguments(context, buffer_states, arguments, element_size, depth)
        },
    ) {
        Ok(()) => Result::Ok(()),
        Err(_) => Result::Err(BuiltinError { message: "cannot prepare " + name + " constructor" }),
    }
}

fn typed_array_view_length(view: runtime::TypedArrayView) -> isize {
    match view {
        runtime::TypedArrayView::Uint8(value) => value.length(),
        runtime::TypedArrayView::Int32(value) => value.length(),
        runtime::TypedArrayView::Float64(value) => value.length(),
        runtime::TypedArrayView::Numeric(value) => value.length(),
        runtime::TypedArrayView::BigInt(value) => value.length(),
    }
}

fn typed_array_view_detached(view: runtime::TypedArrayView) -> bool {
    match view {
        runtime::TypedArrayView::Uint8(value) => value.buffer().is_detached(),
        runtime::TypedArrayView::Int32(value) => value.buffer().is_detached(),
        runtime::TypedArrayView::Float64(value) => value.buffer().is_detached(),
        runtime::TypedArrayView::Numeric(value) => value.buffer().is_detached(),
        runtime::TypedArrayView::BigInt(value) => value.buffer().is_detached(),
    }
}

fn typed_array_view_set(view: runtime::TypedArrayView, index: isize, value: f64) -> Result[
    (),
    vm::VmError,
] {
    let result = match view {
        runtime::TypedArrayView::Uint8(target) => target.set(index, value),
        runtime::TypedArrayView::Int32(target) => target.set(index, value),
        runtime::TypedArrayView::Float64(target) => target.set(index, value),
        runtime::TypedArrayView::Numeric(target) => target.set(index, value),
        runtime::TypedArrayView::BigInt(_) => Result::Err(
            arraybuffer::BufferError {
                class: arraybuffer::BufferErrorClass::TypeError,
                reason: arraybuffer::BufferErrorReason::CodecFailure,
                value: 0,
                limit: 0,
            },
        ),
    };
    match result {
        Ok(()) => Result::Ok(()),
        Err(value) => Result::Err(function_vm_error(value.to_string())),
    }
}

fn typed_array_set_values(
    context: vm::Context,
    view: runtime::TypedArrayView,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    if typed_array_view_detached(view) {
        return Result::Err(function_vm_error("typed array buffer is detached"))
    }
    let offset = if arguments.len() > 1 {
        typed_array_offset(context, arguments[1], depth)?
    } else {
        0
    };
    let values = typed_array_collect_values(context, argument(arguments, 0), depth)?;
    let length = typed_array_view_length(view);
    if offset > length || values.len() > length - offset {
        return Result::Err(function_range_error("typed array source exceeds target length"))
    }
    let mut index = 0;
    while index < values.len() {
        typed_array_view_set(
            view,
            offset + index,
            typed_array_number(context, values[index], depth)?,
        )?;
        index += 1;
    }
    Result::Ok(runtime::Value::Undefined)
}

fn typed_array_receiver_prototype(selected: Option[runtime::ObjectId], fallback: runtime::ObjectId) -> runtime::ObjectId {
    match selected {
        Some(value) => value,
        None => fallback,
    }
}

fn define_typed_array_bytes(
    heap: runtime::Heap,
    constructor: runtime::ObjectId,
    prototype: runtime::ObjectId,
    size: isize,
) -> Result[(), BuiltinError] {
    let value = runtime::Value::Int(size.to_i32());
    define_value(heap, constructor, "BYTES_PER_ELEMENT", value, false, false)?;
    define_value(heap, prototype, "BYTES_PER_ELEMENT", value, false, false)
}

fn register_typed_array_tag(
    context: vm::Context,
    result: Result[runtime::Value, vm::NativeError],
    tag: string,
) -> Result[runtime::Value, vm::NativeError] {
    let value = result?;
    match value {
        runtime::Value::Object(object) => if context.set_object_builtin_tag(object, js_string(tag)) {
            Result::Ok(value)
        } else {
            Result::Err(native_error("cannot register typed array instance"))
        },
        _ => Result::Ok(value),
    }
}

fn uint8_array_construct(
    heap: runtime::Heap,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    let (value, buffer_object) = match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(buffer) => {
                let offset = if arguments.len() > 1 {
                    arraybuffer_index(arguments[1])?
                } else {
                    0
                };
                let value = match arraybuffer::Uint8Array::from_buffer(
                    buffer,
                    offset,
                    optional_index(arguments, 2)?,
                ) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(arraybuffer_native_error(value)),
                };
                (value, object)
            },
            None => return Result::Err(native_error("Uint8Array expects a length or ArrayBuffer")),
        },
        _ => {
            let value = match arraybuffer::Uint8Array::new(typed_constructor_length(arguments)?) {
                Ok(value) => value,
                Err(value) => return Result::Err(arraybuffer_native_error(value)),
            };
            let object = materialize_array_buffer(
                heap,
                buffer_states,
                buffer_prototype,
                value.buffer(),
            )?;
            (value, object)
        },
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Uint8(value),
        buffer_object,
    ) {
        return Result::Err(native_error("cannot register Uint8Array instance"))
    }
    states[object] = Uint8ArrayInstance { value, buffer_object };
    Result::Ok(runtime::Value::Object(object))
}

fn uint8_array_from_values(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    prototype: runtime::ObjectId,
    values: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = match uint8_array_construct(
        context.heap(),
        buffer_states,
        buffer_prototype,
        states,
        prototype,
        runtime::Value::Undefined,
        Vec::from_array([runtime::Value::Int(values.len().to_i32())]),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let state = match uint8_array_state(states, result) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let mut index = 0;
    while index < values.len() {
        match state.value.set(index, typed_array_number(context, values[index], depth)?) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_vm_error(value.to_string())),
        }
        index += 1;
    }
    register_typed_array_tag(context, Result::Ok(result), "Uint8Array").map_err(
        function_native_error,
    )
}

fn uint8_array_construct_vm(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(_) => match uint8_array_construct(
                context.heap(),
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                this_value,
                arguments,
            ) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(function_native_error(value)),
            },
            None => uint8_array_from_values(
                context,
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                typed_array_collect_values(context, runtime::Value::Object(object), depth)?,
                depth,
            ),
        },
        _ => match uint8_array_construct(
            context.heap(),
            buffer_states,
            buffer_prototype,
            states,
            prototype,
            this_value,
            arguments,
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
    }
}

fn uint8_array_buffer(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(runtime::Value::Object(uint8_array_state(states, this_value)?.buffer_object))
}

fn uint8_array_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(uint8_array_state(states, this_value)?.value.length()))
}

fn uint8_array_byte_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(uint8_array_state(states, this_value)?.value.byte_length()))
}

fn uint8_array_byte_offset(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(uint8_array_state(states, this_value)?.value.byte_offset()))
}

fn uint8_array_get(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    match uint8_array_state(states, this_value)?.value.get(
        arraybuffer_index(argument(arguments, 0))?,
    ) {
        Ok(value) => Result::Ok(runtime::Value::Int(value.to_i32())),
        Err(value) => Result::Err(arraybuffer_native_error(value)),
    }
}

fn uint8_array_subarray(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let state = uint8_array_state(states, this_value)?;
    let begin = relative_index(arguments, 0, 0)?;
    let end = relative_index(arguments, 1, state.value.length())?;
    let value = match state.value.subarray(begin, end) {
        Ok(value) => value,
        Err(value) => return Result::Err(arraybuffer_native_error(value)),
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Uint8(value),
        state.buffer_object,
    ) {
        return Result::Err(native_error("cannot register Uint8Array instance"))
    }
    states[object] = Uint8ArrayInstance { value, buffer_object: state.buffer_object };
    Result::Ok(runtime::Value::Object(object))
}

struct Uint8CodecOptions {
    alphabet: encoding::Base64Alphabet,
    handling: encoding::LastChunkHandling,
    omit_padding: bool,
}

fn uint8_codec_string_option(
    context: vm::Context,
    options: runtime::Value,
    name: string,
    depth: isize,
) -> Result[Option[runtime::JsString], vm::VmError] {
    let value = context.read_property_at_depth(
        options,
        runtime::Value::String(js_string(name)),
        depth,
    )?;
    match value {
        runtime::Value::Undefined => Result::Ok(Option::None),
        runtime::Value::String(value) => Result::Ok(Option::Some(value)),
        _ => Result::Err(function_vm_error("expected string for " + name)),
    }
}

fn uint8_codec_options(
    context: vm::Context,
    value: runtime::Value,
    depth: isize,
    read_handling: bool,
    read_omit_padding: bool,
) -> Result[Uint8CodecOptions, vm::VmError] {
    match value {
        runtime::Value::Undefined => return Result::Ok(
            Uint8CodecOptions {
                alphabet: encoding::Base64Alphabet::Base64,
                handling: encoding::LastChunkHandling::Loose,
                omit_padding: false,
            },
        ),
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("options must be an object")),
    }
    let alphabet = match uint8_codec_string_option(context, value, "alphabet", depth)? {
        None => encoding::Base64Alphabet::Base64,
        Some(value) => if value == js_string("base64") {
            encoding::Base64Alphabet::Base64
        } else if value == js_string("base64url") {
            encoding::Base64Alphabet::Base64Url
        } else {
            return Result::Err(function_vm_error("invalid alphabet"))
        },
    };
    let handling = if read_handling {
        match uint8_codec_string_option(context, value, "lastChunkHandling", depth)? {
            None => encoding::LastChunkHandling::Loose,
            Some(value) => if value == js_string("loose") {
                encoding::LastChunkHandling::Loose
            } else if value == js_string("strict") {
                encoding::LastChunkHandling::Strict
            } else if value == js_string("stop-before-partial") {
                encoding::LastChunkHandling::StopBeforePartial
            } else {
                return Result::Err(function_vm_error("invalid lastChunkHandling option"))
            },
        }
    } else {
        encoding::LastChunkHandling::Loose
    };
    let omit_padding = if read_omit_padding {
        runtime::to_boolean(
            context.read_property_at_depth(
                value,
                runtime::Value::String(js_string("omitPadding")),
                depth,
            )?,
        )
    } else {
        false
    };
    Result::Ok(Uint8CodecOptions { alphabet, handling, omit_padding })
}

fn uint8_codec_input(arguments: Vec[runtime::Value]) -> Result[runtime::JsString, vm::VmError] {
    match argument(arguments, 0) {
        runtime::Value::String(value) => Result::Ok(value),
        _ => Result::Err(function_vm_error("expected string")),
    }
}

fn uint8_codec_decode_error(value: encoding::DecodeError) -> vm::VmError {
    match value {
        encoding::DecodeError::InvalidBase64 => function_syntax_error("invalid base64 string"),
        encoding::DecodeError::InvalidHex => function_syntax_error("invalid hex string"),
    }
}

fn uint8_array_from_codec(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Uint8ArrayInstance],
    prototype: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    depth: isize,
    base64: bool,
) -> Result[runtime::Value, vm::VmError] {
    let input = uint8_codec_input(arguments)?;
    let units = input.code_units();
    let decoded = if base64 {
        let options = uint8_codec_options(context, argument(arguments, 1), depth, true, false)?;
        match encoding::decode_base64(
            units.slice(0, units.len()),
            options.alphabet,
            options.handling,
            Option::None,
        ) {
            Ok(value) => value,
            Err(value) => return Result::Err(uint8_codec_decode_error(value.kind)),
        }
    } else {
        match encoding::decode_hex(units.slice(0, units.len()), Option::None) {
            Ok(value) => value,
            Err(value) => return Result::Err(uint8_codec_decode_error(value.kind)),
        }
    };
    let values: Vec[runtime::Value] = Vec::with_capacity(decoded.bytes.len());
    for value in decoded.bytes {
        values.push(runtime::Value::Int(value.to_i32()))
    }
    uint8_array_from_values(
        context,
        buffer_states,
        buffer_prototype,
        states,
        prototype,
        values,
        depth,
    )
}

fn uint8_array_codec_view(context: vm::Context, this_value: runtime::Value) -> Result[
    arraybuffer::Uint8Array,
    vm::VmError,
] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("not a Uint8Array")),
    };
    match runtime::typed_array_view(context.heap(), object) {
        Some(runtime::TypedArrayView::Uint8(value)) => Result::Ok(value),
        _ => Result::Err(function_vm_error("not a Uint8Array")),
    }
}

fn uint8_array_codec_encode(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    base64: bool,
) -> Result[runtime::Value, vm::VmError] {
    let view = uint8_array_codec_view(context, this_value)?;
    let options = uint8_codec_options(
        context,
        if base64 {
            argument(arguments, 0)
        } else {
            runtime::Value::Undefined
        },
        depth,
        false,
        base64,
    )?;
    if view.is_out_of_bounds() {
        return Result::Err(function_vm_error("Uint8Array is out of bounds"))
    }
    let length = view.length();
    let bytes: Vec[byte] = Vec::with_capacity(length);
    let mut index = 0;
    while index < length {
        match view.get(index) {
            Ok(value) => bytes.push(value),
            Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
        }
        index += 1;
    }
    let output = if base64 {
        encoding::encode_base64(bytes.slice(0, bytes.len()), options.alphabet, options.omit_padding)
    } else {
        encoding::encode_hex(bytes.slice(0, bytes.len()))
    };
    Result::Ok(runtime::Value::String(runtime::JsString::from_utf8(output.slice(0, output.len()))))
}

fn uint8_codec_result(heap: runtime::Heap, read: isize, written: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let object = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    for (name, value) in Vec::from_array([("read", read), ("written", written)]) {
        if !runtime::define_own_property(
            heap,
            object,
            runtime::string_property_key(name),
            runtime::data_descriptor(runtime::Value::Int(value.to_i32()), true, true, true),
        ) {
            return Result::Err(function_vm_error("cannot create codec result"))
        }
    }
    Result::Ok(runtime::Value::Object(object))
}

fn uint8_array_set_from_codec(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    base64: bool,
) -> Result[runtime::Value, vm::VmError] {
    let view = uint8_array_codec_view(context, this_value)?;
    let input = uint8_codec_input(arguments)?;
    let units = input.code_units();
    let options = uint8_codec_options(
        context,
        if base64 {
            argument(arguments, 1)
        } else {
            runtime::Value::Undefined
        },
        depth,
        base64,
        false,
    )?;
    if view.is_out_of_bounds() {
        return Result::Err(function_vm_error("Uint8Array is out of bounds"))
    }
    let length = view.length();
    let result = if base64 {
        encoding::decode_base64(
            units.slice(0, units.len()),
            options.alphabet,
            options.handling,
            Option::Some(length),
        )
    } else {
        encoding::decode_hex(units.slice(0, units.len()), Option::Some(length))
    };
    let (decoded, failure) = match result {
        Ok(value) => (value, Option::None),
        Err(value) => (
            encoding::DecodeResult { bytes: value.bytes, read: value.read },
            Option::Some(value.kind),
        ),
    };
    let mut index = 0;
    while index < decoded.bytes.len() {
        match view.set(index, int_float(decoded.bytes[index].to_isize())) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
        }
        index += 1;
    }
    match failure {
        Some(value) => Result::Err(uint8_codec_decode_error(value)),
        None => uint8_codec_result(context.heap(), decoded.read, decoded.bytes.len()),
    }
}

fn install_uint8_array_constructor(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, Uint8ArrayInstance] = HashMap::new();
    define_arraybuffer_getter(
        heap,
        prototype,
        "buffer",
        allocate_function(
            context,
            "get Uint8Array.prototype.buffer",
            |heap, this_value, arguments| {
                uint8_array_buffer(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "length",
        allocate_function(
            context,
            "get Uint8Array.prototype.length",
            |heap, this_value, arguments| {
                uint8_array_length(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteLength",
        allocate_function(
            context,
            "get Uint8Array.prototype.byteLength",
            |heap, this_value, arguments| {
                uint8_array_byte_length(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteOffset",
        allocate_function(
            context,
            "get Uint8Array.prototype.byteOffset",
            |heap, this_value, arguments| {
                uint8_array_byte_offset(heap, states, this_value, arguments)
            },
        )?,
    )?;
    for (name, function) in Vec::from_array(
        [
            (
                "get",
                allocate_function(
                    context,
                    "Uint8Array.prototype.get",
                    |heap, this_value, arguments| {
                        uint8_array_get(heap, states, this_value, arguments)
                    },
                )?,
            ),
            (
                "subarray",
                allocate_function(
                    context,
                    "Uint8Array.prototype.subarray",
                    |heap, this_value, arguments| {
                        register_typed_array_tag(
                            context,
                            uint8_array_subarray(heap, states, prototype, this_value, arguments),
                            "Uint8Array",
                        )
                    },
                )?,
            ),
        ],
    ) {
        define_value(heap, prototype, name, function, true, true)?
    }
    define_value(
        heap,
        prototype,
        "set",
        allocate_vm_function(
            context,
            "Uint8Array.prototype.set",
            |this_value, arguments, depth| {
                let state = match uint8_array_state(states, this_value) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_native_error(value)),
                };
                typed_array_set_values(
                    context,
                    runtime::TypedArrayView::Uint8(state.value),
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        "Uint8Array",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("Uint8Array constructor requires new"))
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            let _ = selected_prototype;
            register_typed_array_tag(
                context,
                match uint8_array_construct_vm(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    typed_array_receiver_prototype(selected_prototype, prototype),
                    runtime::Value::Undefined,
                    arguments,
                    depth,
                ) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => return Result::Err(value),
                },
                "Uint8Array",
            ).map_err(function_native_error)
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register Uint8Array constructor" },
        ),
    }
    install_typed_array_constructor_prepare(context, constructor, buffer_states, 1, "Uint8Array")?;
    let object = function_object(constructor, "Uint8Array")?;
    define_typed_array_bytes(heap, object, prototype, 1)?;
    for (name, base64) in Vec::from_array([("fromBase64", true), ("fromHex", false)]) {
        define_value(
            heap,
            object,
            name,
            allocate_vm_function_with_length(
                context,
                "Uint8Array." + name,
                1,
                |this_value, arguments, depth| {
                    let _ = this_value;
                    uint8_array_from_codec(
                        context,
                        buffer_states,
                        buffer_prototype,
                        states,
                        prototype,
                        arguments,
                        depth,
                        base64,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    for (name, operation) in Vec::from_array(
        [("toBase64", 0), ("toHex", 1), ("setFromBase64", 2), ("setFromHex", 3)],
    ) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function_with_length(
                context,
                "Uint8Array.prototype." + name,
                if operation >= 2 {
                    1
                } else {
                    0
                },
                |this_value, arguments, depth| {
                    if operation >= 2 {
                        uint8_array_set_from_codec(
                            context,
                            this_value,
                            arguments,
                            depth,
                            operation == 2,
                        )
                    } else {
                        uint8_array_codec_encode(
                            context,
                            this_value,
                            arguments,
                            depth,
                            operation == 0,
                        )
                    }
                },
            )?,
            true,
            true,
        )?
    }
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_value(
        heap,
        object,
        "from",
        allocate_vm_function(
            context,
            "Uint8Array.from",
            |this_value, arguments, depth| {
                let _ = this_value;
                uint8_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    typed_array_collect_mapped_values(
                        context,
                        argument(arguments, 0),
                        argument(arguments, 1),
                        argument(arguments, 2),
                        depth,
                    )?,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        object,
        "of",
        allocate_vm_function(
            context,
            "Uint8Array.of",
            |this_value, arguments, depth| {
                let _ = this_value;
                uint8_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    Result::Ok(constructor)
}

fn int32_array_construct(
    heap: runtime::Heap,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    let (value, buffer_object) = match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(buffer) => {
                let offset = if arguments.len() > 1 {
                    arraybuffer_index(arguments[1])?
                } else {
                    0
                };
                let value = match arraybuffer::Int32Array::from_buffer(
                    buffer,
                    offset,
                    optional_index(arguments, 2)?,
                ) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(arraybuffer_native_error(value)),
                };
                (value, object)
            },
            None => return Result::Err(native_error("Int32Array expects a length or ArrayBuffer")),
        },
        _ => {
            let value = match arraybuffer::Int32Array::new(typed_constructor_length(arguments)?) {
                Ok(value) => value,
                Err(value) => return Result::Err(arraybuffer_native_error(value)),
            };
            let object = materialize_array_buffer(
                heap,
                buffer_states,
                buffer_prototype,
                value.buffer(),
            )?;
            (value, object)
        },
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Int32(value),
        buffer_object,
    ) {
        return Result::Err(native_error("cannot register Int32Array instance"))
    }
    states[object] = Int32ArrayInstance { value, buffer_object };
    Result::Ok(runtime::Value::Object(object))
}

fn int32_array_from_values(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    prototype: runtime::ObjectId,
    values: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = match int32_array_construct(
        context.heap(),
        buffer_states,
        buffer_prototype,
        states,
        prototype,
        runtime::Value::Undefined,
        Vec::from_array([runtime::Value::Int(values.len().to_i32())]),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let state = match int32_array_state(states, result) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let mut index = 0;
    while index < values.len() {
        match state.value.set(index, typed_array_number(context, values[index], depth)?) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_vm_error(value.to_string())),
        }
        index += 1;
    }
    register_typed_array_tag(context, Result::Ok(result), "Int32Array").map_err(
        function_native_error,
    )
}

fn int32_array_construct_vm(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(_) => match int32_array_construct(
                context.heap(),
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                this_value,
                arguments,
            ) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(function_native_error(value)),
            },
            None => int32_array_from_values(
                context,
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                typed_array_collect_values(context, runtime::Value::Object(object), depth)?,
                depth,
            ),
        },
        _ => match int32_array_construct(
            context.heap(),
            buffer_states,
            buffer_prototype,
            states,
            prototype,
            this_value,
            arguments,
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
    }
}

fn int32_array_buffer(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(runtime::Value::Object(int32_array_state(states, this_value)?.buffer_object))
}

fn int32_array_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(int32_array_state(states, this_value)?.value.length()))
}

fn int32_array_byte_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(int32_array_state(states, this_value)?.value.byte_length()))
}

fn int32_array_byte_offset(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(int32_array_state(states, this_value)?.value.byte_offset()))
}

fn int32_array_get(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    match int32_array_state(states, this_value)?.value.get(
        arraybuffer_index(argument(arguments, 0))?,
    ) {
        Ok(value) => Result::Ok(runtime::Value::Int(value)),
        Err(value) => Result::Err(arraybuffer_native_error(value)),
    }
}

fn int32_array_subarray(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Int32ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let state = int32_array_state(states, this_value)?;
    let begin = relative_index(arguments, 0, 0)?;
    let end = relative_index(arguments, 1, state.value.length())?;
    let value = match state.value.subarray(begin, end) {
        Ok(value) => value,
        Err(value) => return Result::Err(arraybuffer_native_error(value)),
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Int32(value),
        state.buffer_object,
    ) {
        return Result::Err(native_error("cannot register Int32Array instance"))
    }
    states[object] = Int32ArrayInstance { value, buffer_object: state.buffer_object };
    Result::Ok(runtime::Value::Object(object))
}

fn install_int32_array_constructor(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, Int32ArrayInstance] = HashMap::new();
    define_arraybuffer_getter(
        heap,
        prototype,
        "buffer",
        allocate_function(
            context,
            "get Int32Array.prototype.buffer",
            |heap, this_value, arguments| {
                int32_array_buffer(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "length",
        allocate_function(
            context,
            "get Int32Array.prototype.length",
            |heap, this_value, arguments| {
                int32_array_length(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteLength",
        allocate_function(
            context,
            "get Int32Array.prototype.byteLength",
            |heap, this_value, arguments| {
                int32_array_byte_length(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteOffset",
        allocate_function(
            context,
            "get Int32Array.prototype.byteOffset",
            |heap, this_value, arguments| {
                int32_array_byte_offset(heap, states, this_value, arguments)
            },
        )?,
    )?;
    for (name, function) in Vec::from_array(
        [
            (
                "get",
                allocate_function(
                    context,
                    "Int32Array.prototype.get",
                    |heap, this_value, arguments| {
                        int32_array_get(heap, states, this_value, arguments)
                    },
                )?,
            ),
            (
                "subarray",
                allocate_function(
                    context,
                    "Int32Array.prototype.subarray",
                    |heap, this_value, arguments| {
                        register_typed_array_tag(
                            context,
                            int32_array_subarray(heap, states, prototype, this_value, arguments),
                            "Int32Array",
                        )
                    },
                )?,
            ),
        ],
    ) {
        define_value(heap, prototype, name, function, true, true)?
    }
    define_value(
        heap,
        prototype,
        "set",
        allocate_vm_function(
            context,
            "Int32Array.prototype.set",
            |this_value, arguments, depth| {
                let state = match int32_array_state(states, this_value) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_native_error(value)),
                };
                typed_array_set_values(
                    context,
                    runtime::TypedArrayView::Int32(state.value),
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        "Int32Array",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("Int32Array constructor requires new"))
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            let _ = selected_prototype;
            register_typed_array_tag(
                context,
                match int32_array_construct_vm(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    typed_array_receiver_prototype(selected_prototype, prototype),
                    runtime::Value::Undefined,
                    arguments,
                    depth,
                ) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => return Result::Err(value),
                },
                "Int32Array",
            ).map_err(function_native_error)
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register Int32Array constructor" },
        ),
    }
    install_typed_array_constructor_prepare(context, constructor, buffer_states, 4, "Int32Array")?;
    let object = function_object(constructor, "Int32Array")?;
    define_typed_array_bytes(heap, object, prototype, 4)?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_value(
        heap,
        object,
        "from",
        allocate_vm_function(
            context,
            "Int32Array.from",
            |this_value, arguments, depth| {
                let _ = this_value;
                int32_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    typed_array_collect_mapped_values(
                        context,
                        argument(arguments, 0),
                        argument(arguments, 1),
                        argument(arguments, 2),
                        depth,
                    )?,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        object,
        "of",
        allocate_vm_function(
            context,
            "Int32Array.of",
            |this_value, arguments, depth| {
                let _ = this_value;
                int32_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    Result::Ok(constructor)
}

fn float64_array_construct(
    heap: runtime::Heap,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    let (value, buffer_object) = match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(buffer) => {
                let offset = if arguments.len() > 1 {
                    arraybuffer_index(arguments[1])?
                } else {
                    0
                };
                let value = match arraybuffer::Float64Array::from_buffer(
                    buffer,
                    offset,
                    optional_index(arguments, 2)?,
                ) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(arraybuffer_native_error(value)),
                };
                (value, object)
            },
            None => {
                return Result::Err(native_error("Float64Array expects a length or ArrayBuffer"))
            },
        },
        _ => {
            let value = match arraybuffer::Float64Array::new(typed_constructor_length(arguments)?) {
                Ok(value) => value,
                Err(value) => return Result::Err(arraybuffer_native_error(value)),
            };
            let object = materialize_array_buffer(
                heap,
                buffer_states,
                buffer_prototype,
                value.buffer(),
            )?;
            (value, object)
        },
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Float64(value),
        buffer_object,
    ) {
        return Result::Err(native_error("cannot register Float64Array instance"))
    }
    states[object] = Float64ArrayInstance { value, buffer_object };
    Result::Ok(runtime::Value::Object(object))
}

fn float64_array_from_values(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    prototype: runtime::ObjectId,
    values: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = match float64_array_construct(
        context.heap(),
        buffer_states,
        buffer_prototype,
        states,
        prototype,
        runtime::Value::Undefined,
        Vec::from_array([runtime::Value::Int(values.len().to_i32())]),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let state = match float64_array_state(states, result) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let mut index = 0;
    while index < values.len() {
        match state.value.set(index, typed_array_number(context, values[index], depth)?) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_vm_error(value.to_string())),
        }
        index += 1;
    }
    register_typed_array_tag(context, Result::Ok(result), "Float64Array").map_err(
        function_native_error,
    )
}

fn float64_array_construct_vm(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(_) => match float64_array_construct(
                context.heap(),
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                this_value,
                arguments,
            ) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(function_native_error(value)),
            },
            None => float64_array_from_values(
                context,
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                typed_array_collect_values(context, runtime::Value::Object(object), depth)?,
                depth,
            ),
        },
        _ => match float64_array_construct(
            context.heap(),
            buffer_states,
            buffer_prototype,
            states,
            prototype,
            this_value,
            arguments,
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
    }
}

fn float64_array_buffer(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(runtime::Value::Object(float64_array_state(states, this_value)?.buffer_object))
}

fn float64_array_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(float64_array_state(states, this_value)?.value.length()))
}

fn float64_array_byte_length(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(float64_array_state(states, this_value)?.value.byte_length()))
}

fn float64_array_byte_offset(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(length_value(float64_array_state(states, this_value)?.value.byte_offset()))
}

fn float64_array_get(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    match float64_array_state(states, this_value)?.value.get(
        arraybuffer_index(argument(arguments, 0))?,
    ) {
        Ok(value) => Result::Ok(runtime::Value::Float(value)),
        Err(value) => Result::Err(arraybuffer_native_error(value)),
    }
}

fn float64_array_subarray(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, Float64ArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let state = float64_array_state(states, this_value)?;
    let begin = relative_index(arguments, 0, 0)?;
    let end = relative_index(arguments, 1, state.value.length())?;
    let value = match state.value.subarray(begin, end) {
        Ok(value) => value,
        Err(value) => return Result::Err(arraybuffer_native_error(value)),
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Float64(value),
        state.buffer_object,
    ) {
        return Result::Err(native_error("cannot register Float64Array instance"))
    }
    states[object] = Float64ArrayInstance { value, buffer_object: state.buffer_object };
    Result::Ok(runtime::Value::Object(object))
}

fn install_float64_array_constructor(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, Float64ArrayInstance] = HashMap::new();
    define_arraybuffer_getter(
        heap,
        prototype,
        "buffer",
        allocate_function(
            context,
            "get Float64Array.prototype.buffer",
            |heap, this_value, arguments| {
                float64_array_buffer(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "length",
        allocate_function(
            context,
            "get Float64Array.prototype.length",
            |heap, this_value, arguments| {
                float64_array_length(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteLength",
        allocate_function(
            context,
            "get Float64Array.prototype.byteLength",
            |heap, this_value, arguments| {
                float64_array_byte_length(heap, states, this_value, arguments)
            },
        )?,
    )?;
    define_arraybuffer_getter(
        heap,
        prototype,
        "byteOffset",
        allocate_function(
            context,
            "get Float64Array.prototype.byteOffset",
            |heap, this_value, arguments| {
                float64_array_byte_offset(heap, states, this_value, arguments)
            },
        )?,
    )?;
    for (name, function) in Vec::from_array(
        [
            (
                "get",
                allocate_function(
                    context,
                    "Float64Array.prototype.get",
                    |heap, this_value, arguments| {
                        float64_array_get(heap, states, this_value, arguments)
                    },
                )?,
            ),
            (
                "subarray",
                allocate_function(
                    context,
                    "Float64Array.prototype.subarray",
                    |heap, this_value, arguments| {
                        register_typed_array_tag(
                            context,
                            float64_array_subarray(heap, states, prototype, this_value, arguments),
                            "Float64Array",
                        )
                    },
                )?,
            ),
        ],
    ) {
        define_value(heap, prototype, name, function, true, true)?
    }
    define_value(
        heap,
        prototype,
        "set",
        allocate_vm_function(
            context,
            "Float64Array.prototype.set",
            |this_value, arguments, depth| {
                let state = match float64_array_state(states, this_value) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_native_error(value)),
                };
                typed_array_set_values(
                    context,
                    runtime::TypedArrayView::Float64(state.value),
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        "Float64Array",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("Float64Array constructor requires new"))
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            let _ = selected_prototype;
            register_typed_array_tag(
                context,
                match float64_array_construct_vm(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    typed_array_receiver_prototype(selected_prototype, prototype),
                    runtime::Value::Undefined,
                    arguments,
                    depth,
                ) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => return Result::Err(value),
                },
                "Float64Array",
            ).map_err(function_native_error)
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(
            BuiltinError { message: "cannot register Float64Array constructor" },
        ),
    }
    install_typed_array_constructor_prepare(context, constructor, buffer_states, 8, "Float64Array")?;
    let object = function_object(constructor, "Float64Array")?;
    define_typed_array_bytes(heap, object, prototype, 8)?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_value(
        heap,
        object,
        "from",
        allocate_vm_function(
            context,
            "Float64Array.from",
            |this_value, arguments, depth| {
                let _ = this_value;
                float64_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    typed_array_collect_mapped_values(
                        context,
                        argument(arguments, 0),
                        argument(arguments, 1),
                        argument(arguments, 2),
                        depth,
                    )?,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        object,
        "of",
        allocate_vm_function(
            context,
            "Float64Array.of",
            |this_value, arguments, depth| {
                let _ = this_value;
                float64_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    Result::Ok(constructor)
}

fn numeric_array_state(
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    value: runtime::Value,
    name: string,
) -> Result[NumericArrayInstance, vm::NativeError] {
    let object = arraybuffer_receiver(value, name)?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error(name + " method called on incompatible receiver")),
    }
}

fn numeric_array_construct(
    heap: runtime::Heap,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    prototype: runtime::ObjectId,
    kind: arraybuffer::NumericArrayKind,
    name: string,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let (value, buffer_object) = match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(buffer) => {
                let offset = if arguments.len() > 1 {
                    arraybuffer_index(arguments[1])?
                } else {
                    0
                };
                let value = match arraybuffer::NumericArray::from_buffer(
                    kind,
                    buffer,
                    offset,
                    optional_index(arguments, 2)?,
                ) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(arraybuffer_native_error(value)),
                };
                (value, object)
            },
            None => return Result::Err(native_error(name + " expects a length or ArrayBuffer")),
        },
        _ => {
            let value = match arraybuffer::NumericArray::new(
                kind,
                typed_constructor_length(arguments)?,
            ) {
                Ok(value) => value,
                Err(value) => return Result::Err(arraybuffer_native_error(value)),
            };
            let object = materialize_array_buffer(
                heap,
                buffer_states,
                buffer_prototype,
                value.buffer(),
            )?;
            (value, object)
        },
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Numeric(value),
        buffer_object,
    ) {
        return Result::Err(native_error("cannot register " + name + " instance"))
    }
    states[object] = NumericArrayInstance { value, buffer_object, name };
    Result::Ok(runtime::Value::Object(object))
}

fn numeric_array_from_values(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    prototype: runtime::ObjectId,
    kind: arraybuffer::NumericArrayKind,
    name: string,
    values: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = match numeric_array_construct(
        context.heap(),
        buffer_states,
        buffer_prototype,
        states,
        prototype,
        kind,
        name,
        Vec::from_array([runtime::Value::Int(values.len().to_i32())]),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let state = match numeric_array_state(states, result, name) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let mut index = 0;
    while index < values.len() {
        match state.value.set(index, typed_array_number(context, values[index], depth)?) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_vm_error(value.to_string())),
        }
        index += 1;
    }
    register_typed_array_tag(context, Result::Ok(result), name).map_err(function_native_error)
}

fn numeric_array_construct_vm(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    prototype: runtime::ObjectId,
    kind: arraybuffer::NumericArrayKind,
    name: string,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(_) => match numeric_array_construct(
                context.heap(),
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                kind,
                name,
                arguments,
            ) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(function_native_error(value)),
            },
            None => numeric_array_from_values(
                context,
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                kind,
                name,
                typed_array_collect_values(context, runtime::Value::Object(object), depth)?,
                depth,
            ),
        },
        _ => match numeric_array_construct(
            context.heap(),
            buffer_states,
            buffer_prototype,
            states,
            prototype,
            kind,
            name,
            arguments,
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
    }
}

fn numeric_array_property(
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    this_value: runtime::Value,
    name: string,
    property: isize,
) -> Result[runtime::Value, vm::NativeError] {
    let state = numeric_array_state(states, this_value, name)?;
    match property {
        0 => Result::Ok(runtime::Value::Object(state.buffer_object)),
        1 => Result::Ok(length_value(state.value.length())),
        2 => Result::Ok(length_value(state.value.byte_length())),
        _ => Result::Ok(length_value(state.value.byte_offset())),
    }
}

fn numeric_array_get(
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    name: string,
) -> Result[runtime::Value, vm::NativeError] {
    match numeric_array_state(states, this_value, name)?.value.get(
        arraybuffer_index(argument(arguments, 0))?,
    ) {
        Ok(value) => Result::Ok(runtime::Value::Float(value)),
        Err(value) => Result::Err(arraybuffer_native_error(value)),
    }
}

fn numeric_array_subarray(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    name: string,
) -> Result[runtime::Value, vm::NativeError] {
    let state = numeric_array_state(states, this_value, name)?;
    let begin = relative_index(arguments, 0, 0)?;
    let end = relative_index(arguments, 1, state.value.length())?;
    let value = match state.value.subarray(begin, end) {
        Ok(value) => value,
        Err(value) => return Result::Err(arraybuffer_native_error(value)),
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::Numeric(value),
        state.buffer_object,
    ) {
        return Result::Err(native_error("cannot register " + name + " instance"))
    }
    states[object] = NumericArrayInstance { value, buffer_object: state.buffer_object, name };
    Result::Ok(runtime::Value::Object(object))
}

fn install_numeric_array_constructor(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, NumericArrayInstance],
    kind: arraybuffer::NumericArrayKind,
    name: string,
) -> Result[(runtime::Value, runtime::ObjectId), BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    for (property_name, property) in Vec::from_array(
        [("buffer", 0), ("length", 1), ("byteLength", 2), ("byteOffset", 3)],
    ) {
        define_arraybuffer_getter(
            heap,
            prototype,
            property_name,
            allocate_function(
                context,
                "get " + name + ".prototype." + property_name,
                |heap, this_value, arguments| {
                    let _ = heap;
                    let _ = arguments;
                    numeric_array_property(states, this_value, name, property)
                },
            )?,
        )?
    }
    define_value(
        heap,
        prototype,
        "get",
        allocate_function(
            context,
            name + ".prototype.get",
            |heap, this_value, arguments| {
                let _ = heap;
                numeric_array_get(states, this_value, arguments, name)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "subarray",
        allocate_function(
            context,
            name + ".prototype.subarray",
            |heap, this_value, arguments| {
                register_typed_array_tag(
                    context,
                    numeric_array_subarray(heap, states, prototype, this_value, arguments, name),
                    name,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "set",
        allocate_vm_function(
            context,
            name + ".prototype.set",
            |this_value, arguments, depth| {
                let state = match numeric_array_state(states, this_value, name) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_native_error(value)),
                };
                typed_array_set_values(
                    context,
                    runtime::TypedArrayView::Numeric(state.value),
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        name,
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error(name + " constructor requires new"))
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            let _ = selected_prototype;
            register_typed_array_tag(
                context,
                match numeric_array_construct_vm(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    typed_array_receiver_prototype(selected_prototype, prototype),
                    kind,
                    name,
                    arguments,
                    depth,
                ) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => return Result::Err(value),
                },
                name,
            ).map_err(function_native_error)
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(BuiltinError { message: "cannot register " + name }),
    }
    let element_size = match kind {
        arraybuffer::NumericArrayKind::Uint8Clamped | arraybuffer::NumericArrayKind::Int8 => 1,
        arraybuffer::NumericArrayKind::Int16 | arraybuffer::NumericArrayKind::Uint16 | arraybuffer::NumericArrayKind::Float16 => 2,
        arraybuffer::NumericArrayKind::Uint32 | arraybuffer::NumericArrayKind::Float32 => 4,
    };
    install_typed_array_constructor_prepare(context, constructor, buffer_states, element_size, name)?;
    let object = function_object(constructor, name)?;
    define_typed_array_bytes(heap, object, prototype, element_size)?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_value(
        heap,
        object,
        "from",
        allocate_vm_function(
            context,
            name + ".from",
            |this_value, arguments, depth| {
                let _ = this_value;
                numeric_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    kind,
                    name,
                    typed_array_collect_mapped_values(
                        context,
                        argument(arguments, 0),
                        argument(arguments, 1),
                        argument(arguments, 2),
                        depth,
                    )?,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        object,
        "of",
        allocate_vm_function(
            context,
            name + ".of",
            |this_value, arguments, depth| {
                let _ = this_value;
                numeric_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    kind,
                    name,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    Result::Ok((constructor, prototype))
}

fn bigint_array_state(
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    value: runtime::Value,
    name: string,
) -> Result[BigIntArrayInstance, vm::NativeError] {
    let object = arraybuffer_receiver(value, name)?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error(name + " method called on incompatible receiver")),
    }
}

fn bigint_array_construct(
    heap: runtime::Heap,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    prototype: runtime::ObjectId,
    kind: arraybuffer::BigIntArrayKind,
    name: string,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let (value, buffer_object) = match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(buffer) => {
                let offset = if arguments.len() > 1 {
                    arraybuffer_index(arguments[1])?
                } else {
                    0
                };
                let value = match arraybuffer::BigIntArray::from_buffer(
                    kind,
                    buffer,
                    offset,
                    optional_index(arguments, 2)?,
                ) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(arraybuffer_native_error(value)),
                };
                (value, object)
            },
            None => return Result::Err(native_error(name + " expects a length or ArrayBuffer")),
        },
        _ => {
            let value = match arraybuffer::BigIntArray::new(
                kind,
                typed_constructor_length(arguments)?,
            ) {
                Ok(value) => value,
                Err(value) => return Result::Err(arraybuffer_native_error(value)),
            };
            let object = materialize_array_buffer(
                heap,
                buffer_states,
                buffer_prototype,
                value.buffer(),
            )?;
            (value, object)
        },
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::BigInt(value),
        buffer_object,
    ) {
        return Result::Err(native_error("cannot register " + name + " instance"))
    }
    states[object] = BigIntArrayInstance { value, buffer_object, name };
    Result::Ok(runtime::Value::Object(object))
}

fn bigint_array_set_values(
    context: vm::Context,
    state: BigIntArrayInstance,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    if state.value.buffer().is_detached() {
        return Result::Err(function_vm_error("typed array buffer is detached"))
    }
    let values = typed_array_collect_values(context, argument(arguments, 0), depth)?;
    let offset = typed_array_offset(context, argument(arguments, 1), depth)?;
    if offset > state.value.length() || values.len() > state.value.length() - offset {
        return Result::Err(function_range_error("typed array source does not fit"))
    }
    let mut index = 0;
    while index < values.len() {
        let converted = bigint_value_at_depth(context, values[index], depth)?;
        let integer = match converted {
            runtime::Value::BigInt(value) => value.integer(),
            _ => return Result::Err(function_vm_error("cannot convert value to BigInt")),
        };
        match state.value.set(offset + index, integer) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
        }
        index += 1;
    }
    Result::Ok(runtime::Value::Undefined)
}

fn bigint_array_from_values(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    prototype: runtime::ObjectId,
    kind: arraybuffer::BigIntArrayKind,
    name: string,
    values: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = match bigint_array_construct(
        context.heap(),
        buffer_states,
        buffer_prototype,
        states,
        prototype,
        kind,
        name,
        Vec::from_array([runtime::Value::Int(values.len().to_i32())]),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let state = match bigint_array_state(states, result, name) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let mut index = 0;
    while index < values.len() {
        let converted = bigint_value_at_depth(context, values[index], depth)?;
        let integer = match converted {
            runtime::Value::BigInt(value) => value.integer(),
            _ => return Result::Err(function_vm_error("cannot convert value to BigInt")),
        };
        match state.value.set(index, integer) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_native_error(arraybuffer_native_error(value))),
        }
        index += 1;
    }
    register_typed_array_tag(context, Result::Ok(result), name).map_err(function_native_error)
}

fn bigint_array_construct_vm(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    prototype: runtime::ObjectId,
    kind: arraybuffer::BigIntArrayKind,
    name: string,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match argument(arguments, 0) {
        runtime::Value::Object(object) => match buffer_states.get(object) {
            Some(_) => match bigint_array_construct(
                context.heap(),
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                kind,
                name,
                arguments,
            ) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(function_native_error(value)),
            },
            None => bigint_array_from_values(
                context,
                buffer_states,
                buffer_prototype,
                states,
                prototype,
                kind,
                name,
                typed_array_collect_values(context, runtime::Value::Object(object), depth)?,
                depth,
            ),
        },
        _ => match bigint_array_construct(
            context.heap(),
            buffer_states,
            buffer_prototype,
            states,
            prototype,
            kind,
            name,
            arguments,
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
    }
}

fn bigint_array_property(
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    this_value: runtime::Value,
    name: string,
    property: isize,
) -> Result[runtime::Value, vm::NativeError] {
    let state = bigint_array_state(states, this_value, name)?;
    match property {
        0 => Result::Ok(runtime::Value::Object(state.buffer_object)),
        1 => Result::Ok(length_value(state.value.length())),
        2 => Result::Ok(length_value(state.value.byte_length())),
        _ => Result::Ok(length_value(state.value.byte_offset())),
    }
}

fn bigint_array_get(
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    name: string,
) -> Result[runtime::Value, vm::NativeError] {
    match bigint_array_state(states, this_value, name)?.value.get(
        arraybuffer_index(argument(arguments, 0))?,
    ) {
        Ok(value) => Result::Ok(runtime::Value::BigInt(runtime::BigInt::from_integer(value))),
        Err(value) => Result::Err(arraybuffer_native_error(value)),
    }
}

fn bigint_array_subarray(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    name: string,
) -> Result[runtime::Value, vm::NativeError] {
    let state = bigint_array_state(states, this_value, name)?;
    let begin = relative_index(arguments, 0, 0)?;
    let end = relative_index(arguments, 1, state.value.length())?;
    let value = match state.value.subarray(begin, end) {
        Ok(value) => value,
        Err(value) => return Result::Err(arraybuffer_native_error(value)),
    };
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    if !runtime::register_typed_array(
        heap,
        object,
        runtime::TypedArrayView::BigInt(value),
        state.buffer_object,
    ) {
        return Result::Err(native_error("cannot register " + name + " instance"))
    }
    states[object] = BigIntArrayInstance { value, buffer_object: state.buffer_object, name };
    Result::Ok(runtime::Value::Object(object))
}

fn install_bigint_array_constructor(
    context: vm::Context,
    buffer_states: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    buffer_prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, BigIntArrayInstance],
    kind: arraybuffer::BigIntArrayKind,
    name: string,
) -> Result[(runtime::Value, runtime::ObjectId), BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    for (property_name, property) in Vec::from_array(
        [("buffer", 0), ("length", 1), ("byteLength", 2), ("byteOffset", 3)],
    ) {
        define_arraybuffer_getter(
            heap,
            prototype,
            property_name,
            allocate_function(
                context,
                "get " + name + ".prototype." + property_name,
                |heap, this_value, arguments| {
                    let _ = heap;
                    let _ = arguments;
                    bigint_array_property(states, this_value, name, property)
                },
            )?,
        )?
    }
    define_value(
        heap,
        prototype,
        "get",
        allocate_function(
            context,
            name + ".prototype.get",
            |heap, this_value, arguments| {
                let _ = heap;
                bigint_array_get(states, this_value, arguments, name)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "subarray",
        allocate_function(
            context,
            name + ".prototype.subarray",
            |heap, this_value, arguments| {
                register_typed_array_tag(
                    context,
                    bigint_array_subarray(heap, states, prototype, this_value, arguments, name),
                    name,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "set",
        allocate_vm_function(
            context,
            name + ".prototype.set",
            |this_value, arguments, depth| {
                let state = match bigint_array_state(states, this_value, name) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_native_error(value)),
                };
                bigint_array_set_values(context, state, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        name,
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error(name + " constructor requires new"))
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            let _ = selected_prototype;
            register_typed_array_tag(
                context,
                match bigint_array_construct_vm(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    typed_array_receiver_prototype(selected_prototype, prototype),
                    kind,
                    name,
                    arguments,
                    depth,
                ) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => return Result::Err(value),
                },
                name,
            ).map_err(function_native_error)
        },
    ) {
        Ok(()) => (),
        Err(_) => return Result::Err(BuiltinError { message: "cannot register " + name }),
    }
    install_typed_array_constructor_prepare(context, constructor, buffer_states, 8, name)?;
    let object = function_object(constructor, name)?;
    define_typed_array_bytes(heap, object, prototype, 8)?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_value(
        heap,
        object,
        "from",
        allocate_vm_function(
            context,
            name + ".from",
            |this_value, arguments, depth| {
                let _ = this_value;
                bigint_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    kind,
                    name,
                    typed_array_collect_mapped_values(
                        context,
                        argument(arguments, 0),
                        argument(arguments, 1),
                        argument(arguments, 2),
                        depth,
                    )?,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        object,
        "of",
        allocate_vm_function(
            context,
            name + ".of",
            |this_value, arguments, depth| {
                let _ = this_value;
                bigint_array_from_values(
                    context,
                    buffer_states,
                    buffer_prototype,
                    states,
                    prototype,
                    kind,
                    name,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    Result::Ok((constructor, prototype))
}

fn typed_array_receiver(context: vm::Context, value: runtime::Value) -> Result[
    (runtime::Value, isize),
    vm::VmError,
] {
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    if !runtime::is_typed_array(context.heap(), object) {
        return Result::Err(function_vm_error("TypedArray method requires a TypedArray"))
    } else if runtime::is_typed_array_detached(context.heap(), object) {
        return Result::Err(function_vm_error("typed array buffer is detached"))
    } else if runtime::is_typed_array_out_of_bounds(context.heap(), object) {
        return Result::Err(function_vm_error("TypedArray is out of bounds"))
    }
    match runtime::typed_array_element_length(context.heap(), object) {
        Some(length) => Result::Ok((value, length)),
        None => Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    }
}

fn typed_array_view_name(view: runtime::TypedArrayView) -> string {
    match view {
        runtime::TypedArrayView::Uint8(_) => "Uint8Array",
        runtime::TypedArrayView::Int32(_) => "Int32Array",
        runtime::TypedArrayView::Float64(_) => "Float64Array",
        runtime::TypedArrayView::Numeric(value) => match value.kind() {
            arraybuffer::NumericArrayKind::Uint8Clamped => "Uint8ClampedArray",
            arraybuffer::NumericArrayKind::Int8 => "Int8Array",
            arraybuffer::NumericArrayKind::Int16 => "Int16Array",
            arraybuffer::NumericArrayKind::Uint16 => "Uint16Array",
            arraybuffer::NumericArrayKind::Uint32 => "Uint32Array",
            arraybuffer::NumericArrayKind::Float16 => "Float16Array",
            arraybuffer::NumericArrayKind::Float32 => "Float32Array",
        },
        runtime::TypedArrayView::BigInt(value) => match value.kind() {
            arraybuffer::BigIntArrayKind::Signed => "BigInt64Array",
            arraybuffer::BigIntArrayKind::Unsigned => "BigUint64Array",
        },
    }
}

fn typed_array_default_constructor(
    context: vm::Context,
    value: runtime::Value,
    constructors: TypedArrayConstructors,
) -> Result[runtime::Value, vm::VmError] {
    let (receiver, _) = typed_array_receiver(context, value)?;
    let object = match receiver {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    match runtime::typed_array_view(context.heap(), object) {
        Some(view) => Result::Ok(typed_array_default_constructor_for_view(view, constructors)),
        None => Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    }
}

fn typed_array_default_constructor_for_view(
    view: runtime::TypedArrayView,
    constructors: TypedArrayConstructors,
) -> runtime::Value {
    match view {
        runtime::TypedArrayView::Uint8(_) => constructors.uint8_array,
        runtime::TypedArrayView::Int32(_) => constructors.int32_array,
        runtime::TypedArrayView::Float64(_) => constructors.float64_array,
        runtime::TypedArrayView::Numeric(value) => match value.kind() {
            arraybuffer::NumericArrayKind::Uint8Clamped => constructors.uint8_clamped_array,
            arraybuffer::NumericArrayKind::Int8 => constructors.int8_array,
            arraybuffer::NumericArrayKind::Int16 => constructors.int16_array,
            arraybuffer::NumericArrayKind::Uint16 => constructors.uint16_array,
            arraybuffer::NumericArrayKind::Uint32 => constructors.uint32_array,
            arraybuffer::NumericArrayKind::Float16 => constructors.float16_array,
            arraybuffer::NumericArrayKind::Float32 => constructors.float32_array,
        },
        runtime::TypedArrayView::BigInt(value) => match value.kind() {
            arraybuffer::BigIntArrayKind::Signed => constructors.bigint64_array,
            arraybuffer::BigIntArrayKind::Unsigned => constructors.biguint64_array,
        },
    }
}

fn typed_array_view_byte_length(view: runtime::TypedArrayView) -> isize {
    match view {
        runtime::TypedArrayView::Uint8(value) => value.byte_length(),
        runtime::TypedArrayView::Int32(value) => value.byte_length(),
        runtime::TypedArrayView::Float64(value) => value.byte_length(),
        runtime::TypedArrayView::Numeric(value) => value.byte_length(),
        runtime::TypedArrayView::BigInt(value) => value.byte_length(),
    }
}

fn typed_array_view_byte_offset(view: runtime::TypedArrayView) -> isize {
    match view {
        runtime::TypedArrayView::Uint8(value) => value.byte_offset(),
        runtime::TypedArrayView::Int32(value) => value.byte_offset(),
        runtime::TypedArrayView::Float64(value) => value.byte_offset(),
        runtime::TypedArrayView::Numeric(value) => value.byte_offset(),
        runtime::TypedArrayView::BigInt(value) => value.byte_offset(),
    }
}

fn typed_array_view_raw_byte_offset(view: runtime::TypedArrayView) -> isize {
    match view {
        runtime::TypedArrayView::Uint8(value) => value.raw_byte_offset(),
        runtime::TypedArrayView::Int32(value) => value.raw_byte_offset(),
        runtime::TypedArrayView::Float64(value) => value.raw_byte_offset(),
        runtime::TypedArrayView::Numeric(value) => value.raw_byte_offset(),
        runtime::TypedArrayView::BigInt(value) => value.raw_byte_offset(),
    }
}

fn typed_array_view_element_size(view: runtime::TypedArrayView) -> isize {
    match view {
        runtime::TypedArrayView::Uint8(_) => 1,
        runtime::TypedArrayView::Int32(_) => 4,
        runtime::TypedArrayView::Float64(_) => 8,
        runtime::TypedArrayView::Numeric(value) => match value.kind() {
            arraybuffer::NumericArrayKind::Uint8Clamped | arraybuffer::NumericArrayKind::Int8 => 1,
            arraybuffer::NumericArrayKind::Int16 | arraybuffer::NumericArrayKind::Uint16 | arraybuffer::NumericArrayKind::Float16 => 2,
            arraybuffer::NumericArrayKind::Uint32 | arraybuffer::NumericArrayKind::Float32 => 4,
        },
        runtime::TypedArrayView::BigInt(_) => 8,
    }
}

fn typed_array_view_buffer(view: runtime::TypedArrayView) -> arraybuffer::ArrayBuffer {
    match view {
        runtime::TypedArrayView::Uint8(value) => value.buffer(),
        runtime::TypedArrayView::Int32(value) => value.buffer(),
        runtime::TypedArrayView::Float64(value) => value.buffer(),
        runtime::TypedArrayView::Numeric(value) => value.buffer(),
        runtime::TypedArrayView::BigInt(value) => value.buffer(),
    }
}

fn typed_array_shared_property(heap: runtime::Heap, this_value: runtime::Value, property: isize) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(native_error("TypedArray getter requires a TypedArray")),
    };
    let view = match runtime::typed_array_view(heap, object) {
        Some(value) => value,
        None => return Result::Err(native_error("TypedArray getter requires a TypedArray")),
    };
    match property {
        0 => match runtime::typed_array_buffer_object(heap, object) {
            Some(value) => Result::Ok(runtime::Value::Object(value)),
            None => Result::Err(native_error("TypedArray buffer is missing")),
        },
        1 => Result::Ok(length_value(typed_array_view_length(view))),
        2 => Result::Ok(length_value(typed_array_view_byte_length(view))),
        _ => Result::Ok(length_value(typed_array_view_byte_offset(view))),
    }
}

fn typed_array_shared_tag(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = arguments;
    match this_value {
        runtime::Value::Object(object) => match runtime::typed_array_view(heap, object) {
            Some(value) => Result::Ok(
                runtime::Value::String(js_string(typed_array_view_name(value))),
            ),
            None => Result::Ok(runtime::Value::Undefined),
        },
        _ => Result::Ok(runtime::Value::Undefined),
    }
}

fn typed_array_write_value(
    context: vm::Context,
    target: runtime::Value,
    index: isize,
    value: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    let object = match target {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray target is not an object")),
    };
    match runtime::typed_array_view(context.heap(), object) {
        Some(view) => typed_array_set_element(context, view, index, value, depth),
        None => Result::Err(function_vm_error("TypedArray target is not a TypedArray")),
    }
}

fn typed_array_view_is_bigint(view: runtime::TypedArrayView) -> bool {
    match view {
        runtime::TypedArrayView::BigInt(_) => true,
        _ => false,
    }
}

fn typed_array_view_same_element_type(left: runtime::TypedArrayView, right: runtime::TypedArrayView) -> bool {
    match (left, right) {
        (runtime::TypedArrayView::Uint8(_), runtime::TypedArrayView::Uint8(_)) => true,
        (runtime::TypedArrayView::Int32(_), runtime::TypedArrayView::Int32(_)) => true,
        (runtime::TypedArrayView::Float64(_), runtime::TypedArrayView::Float64(_)) => true,
        (runtime::TypedArrayView::Numeric(left), runtime::TypedArrayView::Numeric(right)) => {
            left.kind() == right.kind()
        },
        (runtime::TypedArrayView::BigInt(left), runtime::TypedArrayView::BigInt(right)) => {
            left.kind() == right.kind()
        },
        _ => false,
    }
}

fn typed_array_set_element(
    context: vm::Context,
    target: runtime::TypedArrayView,
    index: isize,
    value: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    match target {
        runtime::TypedArrayView::BigInt(view) => {
            let converted = match bigint_value_at_depth(context, value, depth)? {
                runtime::Value::BigInt(value) => value.integer(),
                _ => return Result::Err(function_vm_error("cannot convert value to BigInt")),
            };
            let _ = view.set(index, converted);
            Result::Ok(())
        },
        _ => {
            let converted = typed_array_number(context, value, depth)?;
            let _ = typed_array_view_set(target, index, converted);
            Result::Ok(())
        },
    }
}

fn typed_array_set_from_typed_array(
    context: vm::Context,
    target: runtime::TypedArrayView,
    target_length: isize,
    source: runtime::Value,
    offset: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (_, source_length) = typed_array_receiver(context, source)?;
    let source_object = match source {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray source is not an object")),
    };
    let source_view = match runtime::typed_array_view(context.heap(), source_object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray source is not a TypedArray")),
    };
    if typed_array_view_is_bigint(target) != typed_array_view_is_bigint(source_view) {
        return Result::Err(function_vm_error("TypedArray content types do not match"))
    } else if offset > target_length || source_length > target_length - offset {
        return Result::Err(function_range_error("typed array source exceeds target length"))
    }
    if typed_array_view_same_element_type(target, source_view) {
        let element_size = typed_array_view_element_size(target);
        let target_buffer = typed_array_view_buffer(target);
        let source_buffer = typed_array_view_buffer(source_view);
        let target_offset = typed_array_view_byte_offset(target) + offset * element_size;
        let source_offset = typed_array_view_byte_offset(source_view);
        match target_buffer.copy_bytes_from(
            target_offset,
            source_buffer,
            source_offset,
            source_length * element_size,
        ) {
            Ok(()) => Result::Ok(runtime::Value::Undefined),
            Err(value) => Result::Err(function_vm_error(value.to_string())),
        }
    } else {
        let values: Vec[runtime::Value] = Vec::with_capacity(source_length);
        let mut index = 0;
        while index < source_length {
            values.push(array_copy_read(context, source, index, depth)?);
            index += 1;
        }
        index = 0;
        while index < source_length {
            typed_array_set_element(context, target, offset + index, values[index], depth)?;
            index += 1;
        }
        Result::Ok(runtime::Value::Undefined)
    }
}

fn typed_array_set_from_array_like(
    context: vm::Context,
    target: runtime::TypedArrayView,
    target_length: isize,
    source: runtime::Value,
    offset: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source_object = array_object_value(context, source)?;
    let source_length = array_iterator_length(context, source_object, depth)?;
    if offset > target_length || source_length > target_length - offset {
        return Result::Err(function_range_error("typed array source exceeds target length"))
    }
    let mut index = 0;
    while index < source_length {
        let value = array_copy_read(context, source_object, index, depth)?;
        typed_array_set_element(context, target, offset + index, value, depth)?;
        index += 1;
    }
    Result::Ok(runtime::Value::Undefined)
}

fn typed_array_set_shared(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (target_value, _) = typed_array_receiver(context, this_value)?;
    let offset = if arguments.len() > 1 {
        typed_array_offset(context, arguments[1], depth)?
    } else {
        0
    };
    let (_, target_length) = typed_array_receiver(context, target_value)?;
    let target_object = match target_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    let target = match runtime::typed_array_view(context.heap(), target_object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    let source = argument(arguments, 0);
    match source {
        runtime::Value::Object(object) => match runtime::typed_array_view(context.heap(), object) {
            Some(_) => typed_array_set_from_typed_array(
                context,
                target,
                target_length,
                source,
                offset,
                depth,
            ),
            None => typed_array_set_from_array_like(
                context,
                target,
                target_length,
                source,
                offset,
                depth,
            ),
        },
        _ => typed_array_set_from_array_like(context, target, target_length, source, offset, depth),
    }
}

fn typed_array_validate_mapper(mapper: runtime::Value) -> Result[(), vm::VmError] {
    match mapper {
        runtime::Value::Undefined => Result::Ok(()),
        runtime::Value::Object(object) => if object.is_callable() {
            Result::Ok(())
        } else {
            Result::Err(function_vm_error("TypedArray.from mapper is not callable"))
        },
        _ => Result::Err(function_vm_error("TypedArray.from mapper is not callable")),
    }
}

fn typed_array_from_values_shared(
    context: vm::Context,
    constructor: runtime::Value,
    values: Vec[runtime::Value],
    mapper: runtime::Value,
    this_argument: runtime::Value,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    typed_array_validate_mapper(mapper)?;
    let target = typed_array_intrinsic_create(context, constructor, values.len(), depth)?;
    let mut index = 0;
    while index < values.len() {
        let value = match mapper {
            runtime::Value::Undefined => values[index],
            _ => context.invoke_with_this_at_depth(
                mapper,
                Vec::from_array([values[index], runtime::Value::Int(index.to_i32())]),
                this_argument,
                depth,
            )?,
        };
        typed_array_write_value(context, target, index, value, depth)?;
        index += 1;
    }
    Result::Ok(target)
}

fn typed_array_at(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    let relative = array_copy_integer(context, argument(arguments, 0), 0, depth)?;
    let index = if relative < 0 {
        length + relative
    } else {
        relative
    };
    if index < 0 || index >= length {
        Result::Ok(runtime::Value::Undefined)
    } else {
        array_copy_read(context, object, index, depth)
    }
}

fn typed_array_join(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    let separator = match argument(arguments, 0) {
        runtime::Value::Undefined => js_string(","),
        value => match string_value_at_depth(context, value, depth)? {
            runtime::Value::String(value) => value,
            _ => return Result::Err(
                function_vm_error("separator conversion did not produce a string"),
            ),
        },
    };
    let mut output = js_string("");
    let mut index = 0;
    while index < length {
        if index > 0 {
            output = output.concat(separator);
        }
        let value = array_copy_read(context, object, index, depth)?;
        match value {
            runtime::Value::Undefined | runtime::Value::Null => (),
            value => match string_value_at_depth(context, value, depth)? {
                runtime::Value::String(value) => {
                    output = output.concat(value);
                },
                _ => return Result::Err(
                    function_vm_error("element conversion did not produce a string"),
                ),
            },
        }
        index += 1;
    }
    Result::Ok(runtime::Value::String(output))
}

fn typed_array_to_locale_string(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    let mut output = js_string("");
    let mut index = 0;
    while index < length {
        if index > 0 {
            output = output.concat(js_string(","));
        }
        let value = array_copy_read(context, object, index, depth)?;
        match value {
            runtime::Value::Undefined | runtime::Value::Null => (),
            _ => {
                let method = context.read_property_at_depth(
                    value,
                    runtime::Value::String(js_string("toLocaleString")),
                    depth,
                )?;
                let localized = context.invoke_with_this_at_depth(method, arguments, value, depth)?;
                let text = match string_value_at_depth(context, localized, depth)? {
                    runtime::Value::String(value) => value,
                    _ => return Result::Err(function_vm_error("localized value is not a string")),
                };
                if output.len() > STRING_LENGTH_LIMIT - text.len() {
                    return Result::Err(
                        function_range_error(
                            "localized TypedArray string exceeds implementation limit",
                        ),
                    )
                }
                output = output.concat(text);
            },
        }
        index += 1;
    }
    Result::Ok(runtime::Value::String(output))
}

fn typed_array_search(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    operation: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    let needle = argument(arguments, 0);
    let includes = operation == 2;
    let reverse = operation == 1;
    if length == 0 {
        return if includes {
            Result::Ok(runtime::Value::Bool(false))
        } else {
            Result::Ok(runtime::Value::Int(-1))
        }
    }
    let mut index = if reverse {
        if arguments.len() < 2 {
            length - 1
        } else {
            let relative = array_copy_integer(context, arguments[1], 0, depth)?;
            if relative < 0 {
                length + relative
            } else if relative >= length {
                length - 1
            } else {
                relative
            }
        }
    } else {
        let relative = array_copy_integer(context, argument(arguments, 1), 0, depth)?;
        if relative < 0 {
            let adjusted = length + relative;
            if adjusted < 0 {
                0
            } else {
                adjusted
            }
        } else {
            relative
        }
    };
    while index >= 0 && index < length {
        let equal = if includes {
            runtime::same_value_zero(array_copy_read(context, object, index, depth)?, needle)
        } else {
            array_property_present(context, object, index, depth)?
                && runtime::strict_equal(array_copy_read(context, object, index, depth)?, needle)
        };
        if equal {
            if includes {
                return Result::Ok(runtime::Value::Bool(true))
            } else {
                return Result::Ok(runtime::Value::Int(index.to_i32()))
            }
        }
        if reverse {
            index -= 1;
        } else {
            index += 1;
        }
    }
    if includes {
        Result::Ok(runtime::Value::Bool(false))
    } else {
        Result::Ok(runtime::Value::Int(-1))
    }
}

fn typed_array_reverse(context: vm::Context, this_value: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    let mut lower = 0;
    while lower < length / 2 {
        let upper = length - lower - 1;
        let lower_value = array_copy_read(context, object, lower, depth)?;
        let upper_value = array_copy_read(context, object, upper, depth)?;
        array_set_value(context, object, lower, upper_value, depth)?;
        array_set_value(context, object, upper, lower_value, depth)?;
        lower += 1;
    }
    Result::Ok(object)
}

fn typed_array_mutation(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    copy: bool,
) -> Result[runtime::Value, vm::VmError] {
    if copy {
        typed_array_copy_within(context, this_value, arguments, depth)
    } else {
        typed_array_fill(context, this_value, arguments, depth)
    }
}

fn typed_array_copy_within(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    let mut target = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        length,
    );
    let mut source = array_copy_start(
        array_copy_integer(context, argument(arguments, 1), 0, depth)?,
        length,
    );
    let end = if arguments.len() < 3 {
        length
    } else {
        array_copy_start(array_copy_integer(context, arguments[2], length, depth)?, length)
    };
    let available = end - source;
    let room = length - target;
    let mut count = if available < room {
        available
    } else {
        room
    };
    if count <= 0 {
        return Result::Ok(object)
    }
    let (_, current_length) = typed_array_receiver(context, object)?;
    let source_room = current_length - source;
    let target_room = current_length - target;
    if source_room <= 0 || target_room <= 0 {
        return Result::Ok(object)
    }
    if count > source_room {
        count = source_room;
    }
    if count > target_room {
        count = target_room;
    }
    let object_id = match object {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    let view = match runtime::typed_array_view(context.heap(), object_id) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    let element_size = typed_array_view_element_size(view);
    let view_offset = typed_array_view_byte_offset(view);
    source = view_offset + source * element_size;
    target = view_offset + target * element_size;
    let byte_count = count * element_size;
    let buffer = typed_array_view_buffer(view);
    match buffer.copy_bytes_within(target, source, byte_count) {
        Ok(()) => Result::Ok(object),
        Err(value) => Result::Err(function_vm_error(value.to_string())),
    }
}

fn typed_array_fill_bounds(
    context: vm::Context,
    arguments: Vec[runtime::Value],
    length: isize,
    depth: isize,
) -> Result[(isize, isize), vm::VmError] {
    let start = array_copy_start(
        array_copy_integer(context, argument(arguments, 1), 0, depth)?,
        length,
    );
    let end = if arguments.len() < 3 {
        length
    } else {
        array_copy_start(array_copy_integer(context, arguments[2], length, depth)?, length)
    };
    Result::Ok((start, end))
}

fn typed_array_fill(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    let object_id = match object {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    let view = match runtime::typed_array_view(context.heap(), object_id) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    match view {
        runtime::TypedArrayView::BigInt(target) => {
            let converted = match bigint_value_at_depth(context, argument(arguments, 0), depth)? {
                runtime::Value::BigInt(value) => value.integer(),
                _ => return Result::Err(function_vm_error("cannot convert value to BigInt")),
            };
            let (start, end) = typed_array_fill_bounds(context, arguments, length, depth)?;
            let (_, current_length) = typed_array_receiver(context, object)?;
            let limit = if end < current_length {
                end
            } else {
                current_length
            };
            let mut index = start;
            while index < limit {
                match target.set(index, converted) {
                    Ok(()) => (),
                    Err(value) => return Result::Err(function_vm_error(value.to_string())),
                }
                index += 1;
            }
        },
        _ => {
            let converted = typed_array_number(context, argument(arguments, 0), depth)?;
            let (start, end) = typed_array_fill_bounds(context, arguments, length, depth)?;
            let (_, current_length) = typed_array_receiver(context, object)?;
            let limit = if end < current_length {
                end
            } else {
                current_length
            };
            let mut index = start;
            while index < limit {
                typed_array_view_set(view, index, converted)?;
                index += 1;
            }
        },
    }
    Result::Ok(object)
}

fn typed_array_iteration(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    mode: ArrayIterationMode,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    array_iterate_with_length(context, mode, object, length, arguments, depth, true)
}

fn typed_array_reduce(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    reverse: bool,
) -> Result[runtime::Value, vm::VmError] {
    let (object, length) = typed_array_receiver(context, this_value)?;
    array_reduce_with_length(context, object, length, arguments, reverse, depth, true)
}

fn typed_array_species_constructor(
    context: vm::Context,
    original: runtime::Value,
    default_constructor: runtime::Value,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let constructor = context.read_property_at_depth(
        original,
        runtime::Value::String(js_string("constructor")),
        depth,
    )?;
    let constructor = match constructor {
        runtime::Value::Undefined => return Result::Ok(default_constructor),
        runtime::Value::Object(_) => constructor,
        _ => return Result::Err(function_vm_error("TypedArray constructor is not an object")),
    };
    let selected = match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => match context.read_property_at_depth(
            constructor,
            runtime::Value::Symbol(symbol),
            depth,
        )? {
            runtime::Value::Undefined | runtime::Value::Null => default_constructor,
            value => value,
        },
        None => default_constructor,
    };
    Result::Ok(selected)
}

fn typed_array_validate_species_result(
    context: vm::Context,
    original: runtime::Value,
    result: runtime::Value,
) -> Result[runtime::Value, vm::VmError] {
    let original_object = match original {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray source is not an object")),
    };
    let original_view = match runtime::typed_array_view(context.heap(), original_object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray source is invalid")),
    };
    let (result, _) = typed_array_receiver(context, result)?;
    let result_object = match result {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray result is not an object")),
    };
    let result_view = match runtime::typed_array_view(context.heap(), result_object) {
        Some(value) => value,
        None => return Result::Err(
            function_vm_error("TypedArray constructor returned a non-TypedArray"),
        ),
    };
    if typed_array_view_is_bigint(original_view) != typed_array_view_is_bigint(result_view) {
        Result::Err(function_vm_error("TypedArray content types do not match"))
    } else {
        Result::Ok(result)
    }
}

fn typed_array_species_create(
    context: vm::Context,
    original: runtime::Value,
    default_constructor: runtime::Value,
    length: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let selected = typed_array_species_constructor(context, original, default_constructor, depth)?;
    let result = context.construct_with_new_target_at_depth(
        selected,
        Vec::from_array([runtime::Value::Int(length.to_i32())]),
        selected,
        depth,
    )?;
    let result = typed_array_validate_species_result(context, original, result)?;
    let object = match result {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray constructor returned a primitive")),
    };
    let actual = match runtime::typed_array_element_length(context.heap(), object) {
        Some(value) => value,
        None => return Result::Err(
            function_vm_error("TypedArray constructor returned a non-TypedArray"),
        ),
    };
    if actual < length {
        Result::Err(function_vm_error("TypedArray constructor returned a short result"))
    } else {
        Result::Ok(result)
    }
}

fn typed_array_subarray_shared(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    constructors: TypedArrayConstructors,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray receiver is not an object")),
    };
    let view = match runtime::typed_array_view(context.heap(), object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray receiver is invalid")),
    };
    let source = this_value;
    let length = typed_array_view_length(view);
    let start = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        length,
    );
    let end_omitted = arguments.len() < 2
        || match arguments[1] {
            runtime::Value::Undefined => true,
            _ => false,
        };
    let end = if end_omitted {
        length
    } else {
        array_copy_start(array_copy_integer(context, arguments[1], length, depth)?, length)
    };
    let count = if end > start {
        end - start
    } else {
        0
    };
    let buffer = match runtime::typed_array_buffer_object(context.heap(), object) {
        Some(value) => runtime::Value::Object(value),
        None => return Result::Err(function_vm_error("TypedArray buffer is missing")),
    };
    let default_constructor = typed_array_default_constructor_for_view(view, constructors);
    let selected = typed_array_species_constructor(context, source, default_constructor, depth)?;
    let byte_offset = typed_array_view_raw_byte_offset(view)
        + start * typed_array_view_element_size(view);
    let result = if end_omitted && runtime::is_typed_array_length_tracking(context.heap(), object) {
        context.construct_with_new_target_at_depth(
            selected,
            Vec::from_array([buffer, runtime::Value::Int(byte_offset.to_i32())]),
            selected,
            depth,
        )
    } else {
        context.construct_with_new_target_at_depth(
            selected,
            Vec::from_array(
                [
                    buffer,
                    runtime::Value::Int(byte_offset.to_i32()),
                    runtime::Value::Int(count.to_i32()),
                ],
            ),
            selected,
            depth,
        )
    }?;
    typed_array_validate_species_result(context, source, result)
}

fn typed_array_map_filter(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    constructor: runtime::Value,
    filter: bool,
) -> Result[runtime::Value, vm::VmError] {
    let (source, length) = typed_array_receiver(context, this_value)?;
    let callback = array_iteration_callback(arguments)?;
    let callback_this = argument(arguments, 1);
    let values: Vec[runtime::Value] = Vec::with_capacity(length);
    let target = if filter {
        runtime::Value::Undefined
    } else {
        typed_array_species_create(context, source, constructor, length, depth)?
    };
    let mut index = 0;
    while index < length {
        let value = array_copy_read(context, source, index, depth)?;
        let mapped = context.invoke_with_this_at_depth(
            callback,
            Vec::from_array([value, runtime::Value::Int(index.to_i32()), source]),
            callback_this,
            depth,
        )?;
        if filter {
            if runtime::to_boolean(mapped) {
                values.push(value)
            }
        } else {
            array_set_value(context, target, index, mapped, depth)?
        }
        index += 1;
    }
    if filter {
        let result = typed_array_species_create(context, source, constructor, values.len(), depth)?;
        index = 0;
        while index < values.len() {
            array_set_value(context, result, index, values[index], depth)?;
            index += 1;
        }
        Result::Ok(result)
    } else {
        Result::Ok(target)
    }
}

fn typed_array_slice(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    constructor: runtime::Value,
) -> Result[runtime::Value, vm::VmError] {
    let (source, length) = typed_array_receiver(context, this_value)?;
    let source_object = match source {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray source is not an object")),
    };
    let source_view = match runtime::typed_array_view(context.heap(), source_object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray source is invalid")),
    };
    let start = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        length,
    );
    let end = if arguments.len() < 2
        || match arguments[1] {
            runtime::Value::Undefined => true,
            _ => false,
        } {
        length
    } else {
        array_copy_start(array_copy_integer(context, arguments[1], length, depth)?, length)
    };
    let count = if end > start {
        end - start
    } else {
        0
    };
    let result = typed_array_species_create(context, source, constructor, count, depth)?;
    if count == 0 {
        return Result::Ok(result)
    } else if runtime::is_typed_array_detached(context.heap(), source_object)
        || runtime::is_typed_array_out_of_bounds(context.heap(), source_object) {
        return Result::Err(function_vm_error("TypedArray source is out of bounds"))
    }
    let current_length = match runtime::typed_array_element_length(context.heap(), source_object) {
        Some(value) => value,
        None => 0,
    };
    let copy_end = if end < current_length {
        end
    } else {
        current_length
    };
    let copy_count = if copy_end > start {
        copy_end - start
    } else {
        0
    };
    if copy_count == 0 {
        return Result::Ok(result)
    }
    let result_object = match result {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray result is not an object")),
    };
    let result_view = match runtime::typed_array_view(context.heap(), result_object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray result is invalid")),
    };
    if typed_array_view_same_element_type(source_view, result_view) {
        let element_size = typed_array_view_element_size(source_view);
        let source_offset = typed_array_view_byte_offset(source_view) + start * element_size;
        let result_offset = typed_array_view_byte_offset(result_view);
        match typed_array_view_buffer(result_view).copy_bytes_forward_from(
            result_offset,
            typed_array_view_buffer(source_view),
            source_offset,
            copy_count * element_size,
        ) {
            Ok(()) => return Result::Ok(result),
            Err(value) => return Result::Err(function_vm_error(value.to_string())),
        }
    }
    let mut index = 0;
    while index < copy_count {
        array_set_value(
            context,
            result,
            index,
            array_copy_read(context, source, start + index, depth)?,
            depth,
        )?;
        index += 1;
    }
    Result::Ok(result)
}

fn typed_array_intrinsic_create(
    context: vm::Context,
    constructor: runtime::Value,
    length: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = context.construct_with_new_target_at_depth(
        constructor,
        Vec::from_array([runtime::Value::Int(length.to_i32())]),
        constructor,
        depth,
    )?;
    let object = match result {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray constructor returned a primitive")),
    };
    match runtime::typed_array_element_length(context.heap(), object) {
        Some(actual) => if actual >= length {
            Result::Ok(result)
        } else {
            Result::Err(function_vm_error("TypedArray constructor returned a short result"))
        },
        None => Result::Err(function_vm_error("TypedArray constructor returned a non-TypedArray")),
    }
}

fn typed_array_number_compare(left: runtime::Value, right: runtime::Value) -> isize {
    match (left, right) {
        (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => left.compare(right),
        _ => {
            let left = runtime::primitive_to_number(left).unwrap_or(0.0);
            let right = runtime::primitive_to_number(right).unwrap_or(0.0);
            if math::is_nan(left) {
                if math::is_nan(right) {
                    0
                } else {
                    1
                }
            } else if math::is_nan(right) {
                -1
            } else if left < right {
                -1
            } else if left > right {
                1
            } else if left == 0.0 && right == 0.0 {
                let left_sign = 1.0 / left;
                let right_sign = 1.0 / right;
                if left_sign < right_sign {
                    -1
                } else if left_sign > right_sign {
                    1
                } else {
                    0
                }
            } else {
                0
            }
        },
    }
}

fn typed_array_compare(
    context: vm::Context,
    callback: runtime::Value,
    left: runtime::Value,
    right: runtime::Value,
    depth: isize,
) -> Result[isize, vm::VmError] {
    match callback {
        runtime::Value::Undefined => Result::Ok(typed_array_number_compare(left, right)),
        _ => array_sort_compare_slots(
            context,
            callback,
            ArraySortSlot { value: left, string_value: Ref::new(Option::None) },
            ArraySortSlot { value: right, string_value: Ref::new(Option::None) },
            depth,
        ),
    }
}

fn typed_array_sort_values(
    context: vm::Context,
    values: Vec[runtime::Value],
    callback: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    if values.len() < 2 {
        return Result::Ok(())
    }
    match callback {
        runtime::Value::Undefined => typed_array_sort_numbers(context, values, depth)?,
        _ => typed_array_sort_with_callback(context, values, callback, depth)?,
    }
    Result::Ok(())
}

fn typed_array_number_value(number: f64) -> runtime::Value {
    let negative_zero = number == 0.0 && 1.0 / number < 0.0;
    if !negative_zero && number == math::trunc(number) && number >= -2147483648.0
        && number <= 2147483647.0 {
        runtime::Value::Int(
            num::parse_int_structured(dtoa::number_to_string(number)).unwrap_or(0).to_i32(),
        )
    } else {
        runtime::Value::Float(number)
    }
}

fn typed_array_sort_numbers(context: vm::Context, values: Vec[runtime::Value], depth: isize) -> Result[
    (),
    vm::VmError,
] {
    let mut bigint = false;
    let mut numbers: Vec[f64] = Vec::new();
    for value in values {
        match value {
            runtime::Value::BigInt(_) => {
                bigint = true;
            },
            _ => {
                let number = runtime::primitive_to_number(value).unwrap_or(0.0);
                numbers.push(number)
            },
        }
    }
    if bigint {
        return typed_array_sort_with_callback(context, values, runtime::Value::Undefined, depth)
    }
    typed_array_merge_sort_numbers(numbers);
    let mut index = 0;
    for number in numbers {
        values[index] = typed_array_number_value(number);
        index += 1;
    }
    Result::Ok(())
}

fn typed_array_number_less(left: f64, right: f64) -> bool {
    if math::is_nan(left) {
        if math::is_nan(right) {
            false
        } else {
            false
        }
    } else if math::is_nan(right) {
        true
    } else if left < right {
        true
    } else if left > right {
        false
    } else if left == 0.0 && right == 0.0 {
        let left_sign = 1.0 / left;
        let right_sign = 1.0 / right;
        left_sign < right_sign
    } else {
        false
    }
}

fn typed_array_merge_sort_numbers(values: Vec[f64]) -> () {
    if values.len() < 2 {
        return
    }
    let aux: Vec[f64] = Vec::new();
    let mut width = 1;
    while width < values.len() {
        let mut start = 0;
        while start < values.len() {
            let mid = if start + width < values.len() {
                start + width
            } else {
                values.len()
            };
            let end = if start + width * 2 < values.len() {
                start + width * 2
            } else {
                values.len()
            };
            if mid < end {
                let mut index = 0;
                while index < end - start {
                    aux.push(values[start + index]);
                    index += 1;
                }
                let mut left = 0;
                let mut right = mid - start;
                let mut position = start;
                while left < mid - start && right < end - start {
                    if !typed_array_number_less(aux[right], aux[left]) {
                        values[position] = aux[left];
                        left += 1;
                    } else {
                        values[position] = aux[right];
                        right += 1;
                    }
                    position += 1;
                }
                while left < mid - start {
                    values[position] = aux[left];
                    left += 1;
                    position += 1;
                }
                while right < end - start {
                    values[position] = aux[right];
                    right += 1;
                    position += 1;
                }
                let mut clear = 0;
                while clear < end - start {
                    let _ = aux.pop();
                    clear += 1;
                }
            }
            start = end;
        }
        width *= 2;
    }
}

fn typed_array_sort_with_callback(
    context: vm::Context,
    values: Vec[runtime::Value],
    callback: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    if values.len() < 2 {
        return Result::Ok(())
    }
    let aux: Vec[runtime::Value] = Vec::new();
    let mut width = 1;
    while width < values.len() {
        let mut start = 0;
        while start < values.len() {
            let mid = if start + width < values.len() {
                start + width
            } else {
                values.len()
            };
            let end = if start + width * 2 < values.len() {
                start + width * 2
            } else {
                values.len()
            };
            if mid < end {
                let mut index = 0;
                while index < end - start {
                    aux.push(values[start + index]);
                    index += 1;
                }
                let mut left = 0;
                let mut right = mid - start;
                let mut position = start;
                while left < mid - start && right < end - start {
                    if typed_array_compare(context, callback, aux[left], aux[right], depth)? <= 0 {
                        values[position] = aux[left];
                        left += 1;
                    } else {
                        values[position] = aux[right];
                        right += 1;
                    }
                    position += 1;
                }
                while left < mid - start {
                    values[position] = aux[left];
                    left += 1;
                    position += 1;
                }
                while right < end - start {
                    values[position] = aux[right];
                    right += 1;
                    position += 1;
                }
                let mut clear = 0;
                while clear < end - start {
                    let _ = aux.pop();
                    clear += 1;
                }
            }
            start = end;
        }
        width *= 2;
    }
    Result::Ok(())
}

fn typed_array_sort(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    constructor: runtime::Value,
    copy: bool,
) -> Result[runtime::Value, vm::VmError] {
    let (source, length) = typed_array_receiver(context, this_value)?;
    let callback = argument(arguments, 0);
    match callback {
        runtime::Value::Undefined => (),
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("TypedArray comparator is not callable"))
        },
        _ => return Result::Err(function_vm_error("TypedArray comparator is not callable")),
    }
    let target = if copy {
        typed_array_intrinsic_create(context, constructor, length, depth)?
    } else {
        source
    };
    let source_object = match source {
        runtime::Value::Object(object) => object,
        _ => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    let target_object = match target {
        runtime::Value::Object(object) => object,
        _ => return Result::Err(function_vm_error("TypedArray method requires a TypedArray")),
    };
    let numeric_fast = match callback {
        runtime::Value::Undefined => match runtime::typed_array_view(context.heap(), source_object) {
            Some(runtime::TypedArrayView::Numeric(view)) => Option::Some(view),
            _ => Option::None,
        },
        _ => Option::None,
    };
    let float_fast = match callback {
        runtime::Value::Undefined => match runtime::typed_array_view(context.heap(), source_object) {
            Some(runtime::TypedArrayView::Float64(view)) => Option::Some(view),
            _ => Option::None,
        },
        _ => Option::None,
    };
    let numeric_target = match numeric_fast {
        Some(_) => match runtime::typed_array_view(context.heap(), target_object) {
            Some(runtime::TypedArrayView::Numeric(view)) => Option::Some(view),
            _ => Option::None,
        },
        None => Option::None,
    };
    let float_target = match float_fast {
        Some(_) => match runtime::typed_array_view(context.heap(), target_object) {
            Some(runtime::TypedArrayView::Float64(view)) => Option::Some(view),
            _ => Option::None,
        },
        None => Option::None,
    };
    match numeric_fast {
        Some(view) => {
            let mut numbers: Vec[f64] = Vec::with_capacity(length);
            let mut index = 0;
            while index < length {
                match view.get(index) {
                    Ok(value) => numbers.push(value),
                    Err(_) => return Result::Err(function_vm_error("typed array read failed")),
                }
                index += 1;
            }
            typed_array_merge_sort_numbers(numbers);
            let target_view = match numeric_target {
                Some(view) => view,
                None => return Result::Err(function_vm_error("typed array write failed")),
            };
            index = 0;
            for number in numbers {
                match target_view.set(index, number) {
                    Ok(()) => (),
                    Err(_) => return Result::Err(function_vm_error("typed array write failed")),
                }
                index += 1;
            }
            Result::Ok(target)
        },
        None => match float_fast {
            Some(view) => {
                let mut numbers: Vec[f64] = Vec::with_capacity(length);
                let mut index = 0;
                while index < length {
                    match view.get(index) {
                        Ok(value) => numbers.push(value),
                        Err(_) => return Result::Err(function_vm_error("typed array read failed")),
                    }
                    index += 1;
                }
                typed_array_merge_sort_numbers(numbers);
                let target_view = match float_target {
                    Some(view) => view,
                    None => return Result::Err(function_vm_error("typed array write failed")),
                };
                index = 0;
                for number in numbers {
                    match target_view.set(index, number) {
                        Ok(()) => (),
                        Err(_) => return Result::Err(function_vm_error("typed array write failed")),
                    }
                    index += 1;
                }
                Result::Ok(target)
            },
            None => {
                let values: Vec[runtime::Value] = Vec::with_capacity(length);
                let mut index = 0;
                while index < length {
                    values.push(array_copy_read(context, source, index, depth)?);
                    index += 1;
                }
                typed_array_sort_values(context, values, callback, depth)?;
                index = 0;
                while index < length {
                    typed_array_write_value(context, target, index, values[index], depth)?;
                    index += 1;
                }
                Result::Ok(target)
            },
        },
    }
}

fn typed_array_copy_change(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    constructor: runtime::Value,
    replace: bool,
) -> Result[runtime::Value, vm::VmError] {
    let (source, length) = typed_array_receiver(context, this_value)?;
    let source_object = match source {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("TypedArray source is not an object")),
    };
    let source_view = match runtime::typed_array_view(context.heap(), source_object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("TypedArray source is invalid")),
    };
    let relative = if replace {
        array_copy_integer(context, argument(arguments, 0), 0, depth)?
    } else {
        0
    };
    let replacement_index = if relative < 0 {
        length + relative
    } else {
        relative
    };
    let replacement = if replace {
        if typed_array_view_is_bigint(source_view) {
            match bigint_value_at_depth(context, argument(arguments, 1), depth)? {
                runtime::Value::BigInt(value) => runtime::Value::BigInt(value),
                _ => return Result::Err(function_vm_error("cannot convert value to BigInt")),
            }
        } else {
            runtime::Value::Float(typed_array_number(context, argument(arguments, 1), depth)?)
        }
    } else {
        runtime::Value::Undefined
    };
    let current_length = match runtime::typed_array_element_length(context.heap(), source_object) {
        Some(value) => value,
        None => 0,
    };
    if replace && (replacement_index < 0 || replacement_index >= current_length) {
        return Result::Err(function_range_error("TypedArray index is out of range"))
    }
    let target = typed_array_intrinsic_create(context, constructor, length, depth)?;
    let mut index = 0;
    while index < length {
        let source_index = if replace {
            index
        } else {
            length - index - 1
        };
        let value = if replace && index == replacement_index {
            replacement
        } else {
            array_copy_read(context, source, source_index, depth)?
        };
        array_set_value(context, target, index, value, depth)?;
        index += 1;
    }
    Result::Ok(target)
}

fn define_shared_typed_array_method(
    context: vm::Context,
    prototype: runtime::ObjectId,
    name: string,
    callback: (runtime::Value, Vec[runtime::Value], isize) -> Result[runtime::Value, vm::VmError],
) -> Result[runtime::Value, BuiltinError] {
    let function = allocate_vm_function(context, "TypedArray.prototype." + name, callback)?;
    define_value(context.heap(), prototype, name, function, true, true)?;
    Result::Ok(function)
}

fn typed_array_keep_concrete_prototype_key(key: runtime::PropertyKey) -> bool {
    match key {
        runtime::PropertyKey::String(value) => {
            value == js_string("BYTES_PER_ELEMENT") || value == js_string("toBase64")
                || value == js_string("toHex")
                || value == js_string("setFromBase64")
                || value == js_string("setFromHex")
                || value == js_string("constructor")
        },
        runtime::PropertyKey::Symbol(_) => false,
    }
}

fn normalize_concrete_typed_array(
    context: vm::Context,
    constructor: runtime::Value,
    prototype: runtime::ObjectId,
    shared_constructor: runtime::ObjectId,
    shared_prototype: runtime::ObjectId,
) -> Result[(), BuiltinError] {
    let heap = context.heap();
    let constructor_object = function_object(constructor, "TypedArray constructor")?;
    if !runtime::set_prototype_of(heap, constructor_object, Option::Some(shared_constructor)) {
        return Result::Err(BuiltinError { message: "cannot inherit TypedArray constructor" })
    } else if !runtime::set_prototype_of(heap, prototype, Option::Some(shared_prototype)) {
        return Result::Err(BuiltinError { message: "cannot inherit TypedArray prototype" })
    }
    for name in Vec::from_array(["from", "of"]) {
        if !runtime::delete_property(heap, constructor_object, runtime::string_property_key(name)) {
            return Result::Err(BuiltinError { message: "cannot remove concrete TypedArray static" })
        }
    }
    for key in runtime::own_property_keys(heap, constructor_object) {
        match key {
            runtime::PropertyKey::Symbol(_) => if !runtime::delete_property(
                heap,
                constructor_object,
                key,
            ) {
                return Result::Err(
                    BuiltinError { message: "cannot remove concrete TypedArray symbol" },
                )
            },
            runtime::PropertyKey::String(_) => (),
        }
    }
    for key in runtime::own_property_keys(heap, prototype) {
        if typed_array_keep_concrete_prototype_key(key) {} else if !runtime::delete_property(
            heap,
            prototype,
            key,
        ) {
            return Result::Err(BuiltinError { message: "cannot normalize TypedArray prototype" })
        }
    }
    Result::Ok(())
}

fn install_shared_typed_array(context: vm::Context, install: ArrayBufferInstall) -> Result[
    (),
    BuiltinError,
] {
    let heap = context.heap();
    let constructors = TypedArrayConstructors {
        uint8_array: install.uint8_array,
        int32_array: install.int32_array,
        float64_array: install.float64_array,
        uint8_clamped_array: install.uint8_clamped_array,
        int8_array: install.int8_array,
        int16_array: install.int16_array,
        uint16_array: install.uint16_array,
        uint32_array: install.uint32_array,
        float16_array: install.float16_array,
        float32_array: install.float32_array,
        bigint64_array: install.bigint64_array,
        biguint64_array: install.biguint64_array,
    };
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let constructor = allocate_vm_function_with_length(
        context,
        "TypedArray",
        0,
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("cannot be called"))
        },
    )?;
    let constructor_object = function_object(constructor, "TypedArray")?;
    define_value(
        heap,
        constructor_object,
        "from",
        allocate_vm_function_with_length(
            context,
            "TypedArray.from",
            1,
            |this_value, arguments, depth| {
                let mapper = argument(arguments, 1);
                typed_array_validate_mapper(mapper)?;
                typed_array_from_values_shared(
                    context,
                    this_value,
                    typed_array_collect_values(context, argument(arguments, 0), depth)?,
                    mapper,
                    argument(arguments, 2),
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "of",
        allocate_vm_function_with_length(
            context,
            "TypedArray.of",
            0,
            |this_value, arguments, depth| {
                typed_array_from_values_shared(
                    context,
                    this_value,
                    arguments,
                    runtime::Value::Undefined,
                    runtime::Value::Undefined,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.species]",
                0,
                array_species_getter,
            )?;
            if !runtime::define_own_property(
                heap,
                constructor_object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define TypedArray species" })
            }
        },
        None => (),
    }
    define_arraybuffer_getter(
        heap,
        prototype,
        "length",
        allocate_function(
            context,
            "get TypedArray.prototype.length",
            |heap, this_value, arguments| {
                let _ = arguments;
                typed_array_shared_property(heap, this_value, 1)
            },
        )?,
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "at",
        |this_value, arguments, depth| {
            typed_array_at(context, this_value, arguments, depth)
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "with",
        |this_value, arguments, depth| {
            let default_constructor = typed_array_default_constructor(
                context,
                this_value,
                constructors,
            )?;
            typed_array_copy_change(
                context,
                this_value,
                arguments,
                depth,
                default_constructor,
                true,
            )
        },
    )?;
    for (name, property) in Vec::from_array([("buffer", 0), ("byteLength", 2), ("byteOffset", 3)]) {
        define_arraybuffer_getter(
            heap,
            prototype,
            name,
            allocate_function(
                context,
                "get TypedArray.prototype." + name,
                |heap, this_value, arguments| {
                    let _ = arguments;
                    typed_array_shared_property(heap, this_value, property)
                },
            )?,
        )?
    }
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "set",
        |this_value, arguments, depth| {
            typed_array_set_shared(context, this_value, arguments, depth)
        },
    )?;
    let values = define_shared_typed_array_method(
        context,
        prototype,
        "values",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            array_create_iterator(context, ArrayIteratorKind::Values, this_value, true)
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "keys",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            array_create_iterator(context, ArrayIteratorKind::Keys, this_value, true)
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "entries",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            array_create_iterator(context, ArrayIteratorKind::Entries, this_value, true)
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "copyWithin",
        |this_value, arguments, depth| {
            typed_array_mutation(context, this_value, arguments, depth, true)
        },
    )?;
    for (name, mode) in Vec::from_array(
        [
            ("every", ArrayIterationMode::Every),
            ("some", ArrayIterationMode::Some),
            ("forEach", ArrayIterationMode::ForEach),
        ],
    ) {
        let _ = define_shared_typed_array_method(
            context,
            prototype,
            name,
            |this_value, arguments, depth| {
                typed_array_iteration(context, this_value, arguments, depth, mode)
            },
        )?;
    }
    for (name, filter) in Vec::from_array([("map", false), ("filter", true)]) {
        let _ = define_shared_typed_array_method(
            context,
            prototype,
            name,
            |this_value, arguments, depth| {
                let default_constructor = typed_array_default_constructor(
                    context,
                    this_value,
                    constructors,
                )?;
                typed_array_map_filter(
                    context,
                    this_value,
                    arguments,
                    depth,
                    default_constructor,
                    filter,
                )
            },
        )?;
    }
    for (name, reverse) in Vec::from_array([("reduce", false), ("reduceRight", true)]) {
        let _ = define_shared_typed_array_method(
            context,
            prototype,
            name,
            |this_value, arguments, depth| {
                typed_array_reduce(context, this_value, arguments, depth, reverse)
            },
        )?;
    }
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "fill",
        |this_value, arguments, depth| {
            typed_array_mutation(context, this_value, arguments, depth, false)
        },
    )?;
    for (name, mode) in Vec::from_array(
        [
            ("find", ArrayIterationMode::Find),
            ("findIndex", ArrayIterationMode::FindIndex),
            ("findLast", ArrayIterationMode::FindLast),
            ("findLastIndex", ArrayIterationMode::FindLastIndex),
        ],
    ) {
        let _ = define_shared_typed_array_method(
            context,
            prototype,
            name,
            |this_value, arguments, depth| {
                typed_array_iteration(context, this_value, arguments, depth, mode)
            },
        )?;
    }
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "reverse",
        |this_value, arguments, depth| {
            let _ = arguments;
            typed_array_reverse(context, this_value, depth)
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "toReversed",
        |this_value, arguments, depth| {
            let default_constructor = typed_array_default_constructor(
                context,
                this_value,
                constructors,
            )?;
            typed_array_copy_change(
                context,
                this_value,
                arguments,
                depth,
                default_constructor,
                false,
            )
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "slice",
        |this_value, arguments, depth| {
            let default_constructor = typed_array_default_constructor(
                context,
                this_value,
                constructors,
            )?;
            typed_array_slice(context, this_value, arguments, depth, default_constructor)
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "subarray",
        |this_value, arguments, depth| {
            typed_array_subarray_shared(context, this_value, arguments, depth, constructors)
        },
    )?;
    for (name, copy) in Vec::from_array([("sort", false), ("toSorted", true)]) {
        let _ = define_shared_typed_array_method(
            context,
            prototype,
            name,
            |this_value, arguments, depth| {
                let default_constructor = typed_array_default_constructor(
                    context,
                    this_value,
                    constructors,
                )?;
                typed_array_sort(context, this_value, arguments, depth, default_constructor, copy)
            },
        )?;
    }
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "join",
        |this_value, arguments, depth| {
            typed_array_join(context, this_value, arguments, depth)
        },
    )?;
    let _ = define_shared_typed_array_method(
        context,
        prototype,
        "toLocaleString",
        |this_value, arguments, depth| {
            typed_array_to_locale_string(context, this_value, arguments, depth)
        },
    )?;
    for (name, operation) in Vec::from_array([("indexOf", 0), ("lastIndexOf", 1), ("includes", 2)]) {
        let _ = define_shared_typed_array_method(
            context,
            prototype,
            name,
            |this_value, arguments, depth| {
                typed_array_search(context, this_value, arguments, depth, operation)
            },
        )?;
    }
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    let array_prototype = match heap.array_prototype() {
        Some(value) => value,
        None => return Result::Err(BuiltinError { message: "Array prototype is not installed" }),
    };
    let array_to_string = match runtime::get_property(
        heap,
        array_prototype,
        runtime::string_property_key("toString"),
    ) {
        Ok(Some(value)) => value,
        Ok(None) => return Result::Err(BuiltinError { message: "Array toString is missing" }),
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_value(heap, prototype, "toString", array_to_string, true, true)?;
    match context.iterator_symbol() {
        Some(symbol) => if !runtime::define_own_property(
            heap,
            prototype,
            runtime::PropertyKey::Symbol(symbol),
            runtime::data_descriptor(values, true, false, true),
        ) {
            return Result::Err(BuiltinError { message: "cannot define TypedArray iterator" })
        },
        None => return Result::Err(BuiltinError { message: "iterator symbol is not installed" }),
    }
    match context.well_known_symbol(vm::WellKnownSymbolKind::ToStringTag) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.toStringTag]",
                0,
                typed_array_shared_tag,
            )?;
            if !runtime::define_own_property(
                heap,
                prototype,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define TypedArray tag" })
            }
        },
        None => (),
    }
    mark_constructor(context, constructor, "TypedArray")?;
    for (concrete_constructor, concrete_prototype) in Vec::from_array(
        [
            (install.uint8_array, install.uint8_array_prototype),
            (install.int32_array, install.int32_array_prototype),
            (install.float64_array, install.float64_array_prototype),
            (install.uint8_clamped_array, install.uint8_clamped_array_prototype),
            (install.int8_array, install.int8_array_prototype),
            (install.int16_array, install.int16_array_prototype),
            (install.uint16_array, install.uint16_array_prototype),
            (install.uint32_array, install.uint32_array_prototype),
            (install.float16_array, install.float16_array_prototype),
            (install.float32_array, install.float32_array_prototype),
            (install.bigint64_array, install.bigint64_array_prototype),
            (install.biguint64_array, install.biguint64_array_prototype),
        ],
    ) {
        normalize_concrete_typed_array(
            context,
            concrete_constructor,
            concrete_prototype,
            constructor_object,
            prototype,
        )?
    }
    Result::Ok(())
}

fn install_typed_array_iterators(context: vm::Context, install: ArrayBufferInstall) -> Result[
    (),
    BuiltinError,
] {
    install_shared_typed_array(context, install)
}

fn array_buffer_is_view(
    heap: runtime::Heap,
    data_view_states: HashMap[runtime::ObjectId, DataViewInstance],
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let result = match argument(arguments, 0) {
        runtime::Value::Object(object) => {
            runtime::is_typed_array(heap, object) || data_view_states.get(object).is_some()
        },
        _ => false,
    };
    Result::Ok(runtime::Value::Bool(result))
}

struct AtomicTarget {
    value: runtime::Value,
    view: runtime::TypedArrayView,
    length: isize,
}

#[derive(PartialEq, Eq)]
enum AtomicOperation {
    Add,
    Subtract,
    And,
    Or,
    Xor,
    Exchange,
}

fn atomic_integer_view(view: runtime::TypedArrayView) -> bool {
    match view {
        runtime::TypedArrayView::Uint8(_) | runtime::TypedArrayView::Int32(_) | runtime::TypedArrayView::BigInt(_) => true,
        runtime::TypedArrayView::Numeric(value) => match value.kind() {
            arraybuffer::NumericArrayKind::Int8 | arraybuffer::NumericArrayKind::Int16 | arraybuffer::NumericArrayKind::Uint16 | arraybuffer::NumericArrayKind::Uint32 => true,
            arraybuffer::NumericArrayKind::Uint8Clamped | arraybuffer::NumericArrayKind::Float16 | arraybuffer::NumericArrayKind::Float32 => false,
        },
        runtime::TypedArrayView::Float64(_) => false,
    }
}

fn atomic_target(context: vm::Context, value: runtime::Value) -> Result[AtomicTarget, vm::VmError] {
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Atomics target is not a TypedArray")),
    };
    let view = match runtime::typed_array_view(context.heap(), object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Atomics target is not a TypedArray")),
    };
    if !atomic_integer_view(view) {
        return Result::Err(function_vm_error("Atomics target is not an integer TypedArray"))
    } else if runtime::is_typed_array_detached(context.heap(), object) {
        return Result::Err(function_vm_error("Atomics target buffer is detached"))
    }
    let length = match runtime::typed_array_element_length(context.heap(), object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Atomics target length is invalid")),
    };
    Result::Ok(AtomicTarget { value, view, length })
}

fn atomic_index(context: vm::Context, target: AtomicTarget, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let index = arraybuffer_index_at_depth(context, value, depth)?;
    if index >= target.length {
        Result::Err(function_range_error("Atomics index is out of range"))
    } else {
        Result::Ok(index)
    }
}

fn atomic_number(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    f64,
    vm::VmError,
] {
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    match runtime::primitive_to_number(primitive) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn atomic_bigint(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::BigInt,
    vm::VmError,
] {
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    match runtime::primitive_to_bigint(primitive) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn atomic_bigint64(value: runtime::BigInt, signed: bool) -> Result[runtime::BigInt, vm::VmError] {
    let one = runtime::BigInt::from_int64(1);
    let modulus = match one.shift_left(64) {
        Ok(value) => value,
        Err(_) => return Result::Err(function_range_error("cannot normalize atomic BigInt")),
    };
    let mask = modulus.subtract(one);
    let unsigned = value.bit_and(mask);
    if signed {
        let sign = match one.shift_left(63) {
            Ok(value) => value,
            Err(_) => return Result::Err(function_range_error("cannot normalize atomic BigInt")),
        };
        if unsigned.bit_and(sign).is_zero() {
            Result::Ok(unsigned)
        } else {
            Result::Ok(unsigned.subtract(modulus))
        }
    } else {
        Result::Ok(unsigned)
    }
}

fn atomic_float(value: i64) -> f64 {
    num::parse_float64_structured(value.to_string()).unwrap_or(0.0)
}

fn atomic_normalize_number(view: runtime::TypedArrayView, value: f64) -> runtime::Value {
    let converted = mathx::to_u32(value);
    match view {
        runtime::TypedArrayView::Uint8(_) => {
            runtime::Value::Int((converted & 0xff).to_i32())
        },
        runtime::TypedArrayView::Int32(_) => runtime::Value::Int(converted.to_i32()),
        runtime::TypedArrayView::Numeric(target) => match target.kind() {
            arraybuffer::NumericArrayKind::Int8 => runtime::Value::Float(
                atomic_float((converted & 0xff).to_u8().to_i8().to_i64()),
            ),
            arraybuffer::NumericArrayKind::Int16 => runtime::Value::Float(
                atomic_float((converted & 0xffff).to_u16().to_i16().to_i64()),
            ),
            arraybuffer::NumericArrayKind::Uint16 => {
                runtime::Value::Float(atomic_float((converted & 0xffff).to_i64()))
            },
            arraybuffer::NumericArrayKind::Uint32 => runtime::Value::Float(
                num::parse_float64_structured(converted.to_string()).unwrap_or(0.0),
            ),
            _ => runtime::Value::Float(0.0),
        },
        _ => runtime::Value::Float(0.0),
    }
}

fn atomic_normalize(context: vm::Context, target: AtomicTarget, value: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match target.view {
        runtime::TypedArrayView::BigInt(array) => {
            Result::Ok(
                runtime::Value::BigInt(
                    atomic_bigint64(
                        atomic_bigint(context, value, depth)?,
                        array.kind() == arraybuffer::BigIntArrayKind::Signed,
                    )?,
                ),
            )
        },
        _ => Result::Ok(atomic_normalize_number(target.view, atomic_number(context, value, depth)?)),
    }
}

fn atomic_read(context: vm::Context, target: AtomicTarget, index: isize, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    context.read_property_at_depth(target.value, runtime::Value::Int(index.to_i32()), depth)
}

fn atomic_write(
    context: vm::Context,
    target: AtomicTarget,
    index: isize,
    value: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    if context.reflect_set_at_depth(
        target.value,
        runtime::Value::Int(index.to_i32()),
        value,
        target.value,
        depth,
    )? {
        Result::Ok(())
    } else {
        Result::Err(function_vm_error("cannot write atomic element"))
    }
}

fn atomic_load(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = atomic_target(context, argument(arguments, 0))?;
    let index = atomic_index(context, target, argument(arguments, 1), depth)?;
    atomic_read(context, target, index, depth)
}

fn atomic_store(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = atomic_target(context, argument(arguments, 0))?;
    let index = atomic_index(context, target, argument(arguments, 1), depth)?;
    let values = match target.view {
        runtime::TypedArrayView::BigInt(array) => {
            let value = atomic_bigint(context, argument(arguments, 2), depth)?;
            (
                runtime::Value::BigInt(value),
                runtime::Value::BigInt(
                    atomic_bigint64(value, array.kind() == arraybuffer::BigIntArrayKind::Signed)?,
                ),
            )
        },
        _ => {
            let number = atomic_number(context, argument(arguments, 2), depth)?;
            let value = if math::is_nan(number) || number == 0.0 {
                0.0
            } else if math::is_infinite(number) {
                number
            } else {
                math::trunc(number)
            };
            (runtime::Value::Float(value), atomic_normalize_number(target.view, value))
        },
    };
    atomic_write(context, target, index, values.1, depth)?;
    Result::Ok(values.0)
}

fn atomic_binary_value(current: runtime::Value, input: runtime::Value, operation: AtomicOperation) -> runtime::Value {
    match (current, input) {
        (runtime::Value::BigInt(left), runtime::Value::BigInt(right)) => {
            runtime::Value::BigInt(
                match operation {
                    AtomicOperation::Add => left.add(right),
                    AtomicOperation::Subtract => left.subtract(right),
                    AtomicOperation::And => left.bit_and(right),
                    AtomicOperation::Or => left.bit_or(right),
                    AtomicOperation::Xor => left.bit_xor(right),
                    AtomicOperation::Exchange => right,
                },
            )
        },
        (left, right) => {
            let left_number = runtime::primitive_to_number(left).unwrap_or(0.0);
            let right_number = runtime::primitive_to_number(right).unwrap_or(0.0);
            runtime::Value::Float(
                match operation {
                    AtomicOperation::Add => left_number + right_number,
                    AtomicOperation::Subtract => left_number - right_number,
                    AtomicOperation::And => atomic_float(
                        (mathx::to_u32(left_number) & mathx::to_u32(right_number)).to_i64(),
                    ),
                    AtomicOperation::Or => atomic_float(
                        (mathx::to_u32(left_number) | mathx::to_u32(right_number)).to_i64(),
                    ),
                    AtomicOperation::Xor => atomic_float(
                        (mathx::to_u32(left_number) ^ mathx::to_u32(right_number)).to_i64(),
                    ),
                    AtomicOperation::Exchange => right_number,
                },
            )
        },
    }
}

fn atomic_read_modify_write(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
    operation: AtomicOperation,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = atomic_target(context, argument(arguments, 0))?;
    let index = atomic_index(context, target, argument(arguments, 1), depth)?;
    let input = atomic_normalize(context, target, argument(arguments, 2), depth)?;
    let current = atomic_read(context, target, index, depth)?;
    let next = atomic_binary_value(current, input, operation);
    atomic_write(context, target, index, next, depth)?;
    Result::Ok(current)
}

fn atomic_compare_exchange(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = atomic_target(context, argument(arguments, 0))?;
    let index = atomic_index(context, target, argument(arguments, 1), depth)?;
    let expected = atomic_normalize(context, target, argument(arguments, 2), depth)?;
    let replacement = atomic_normalize(context, target, argument(arguments, 3), depth)?;
    let current = atomic_read(context, target, index, depth)?;
    if runtime::same_value(current, expected) {
        atomic_write(context, target, index, replacement, depth)?
    }
    Result::Ok(current)
}

fn atomic_is_lock_free(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let size = string_truncated_int(atomic_number(context, argument(arguments, 0), depth)?, 0);
    Result::Ok(runtime::Value::Bool(size == 1 || size == 2 || size == 4 || size == 8))
}

fn atomic_wait_target(context: vm::Context, value: runtime::Value, require_shared: bool) -> Result[
    AtomicTarget,
    vm::VmError,
] {
    let target = atomic_target(context, value)?;
    let target = match target.view {
        runtime::TypedArrayView::Int32(_) => Result::Ok(target),
        runtime::TypedArrayView::BigInt(value) => if value.kind()
            == arraybuffer::BigIntArrayKind::Signed {
            Result::Ok(target)
        } else {
            Result::Err(
                function_vm_error("Atomics wait target is not an Int32Array or BigInt64Array"),
            )
        },
        _ => Result::Err(
            function_vm_error("Atomics wait target is not an Int32Array or BigInt64Array"),
        ),
    }?;
    if require_shared {
        match target.value {
            runtime::Value::Object(object) => if !runtime::is_shared_typed_array(
                context.heap(),
                object,
            ) {
                return Result::Err(
                    function_vm_error("Atomics target is not backed by shared memory"),
                )
            },
            _ => return Result::Err(function_vm_error("Atomics target is not a TypedArray")),
        }
    }
    Result::Ok(target)
}

fn atomic_notify(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = atomic_wait_target(context, argument(arguments, 0), false)?;
    let _ = atomic_index(context, target, argument(arguments, 1), depth)?;
    if arguments.len() > 2 {
        let _ = atomic_number(context, argument(arguments, 2), depth)?;
    }
    Result::Ok(runtime::Value::Int(0))
}

fn atomic_wait(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = atomic_wait_target(context, argument(arguments, 0), true)?;
    let _ = atomic_index(context, target, argument(arguments, 1), depth)?;
    let _ = atomic_normalize(context, target, argument(arguments, 2), depth)?;
    if arguments.len() > 3 {
        let _ = atomic_number(context, argument(arguments, 3), depth)?;
    }
    Result::Err(function_vm_error("cannot block in this thread"))
}

fn atomic_pause(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = context;
    let _ = this_value;
    let _ = depth;
    if arguments.len() > 0 {
        match argument(arguments, 0) {
            runtime::Value::Undefined | runtime::Value::Int(_) => (),
            runtime::Value::Float(value) => if !math::is_finite(value)
                || math::trunc(value) != value {
                return Result::Err(function_vm_error("Atomics.pause argument must be an integer"))
            },
            _ => return Result::Err(function_vm_error("Atomics.pause argument must be an integer")),
        }
    }
    Result::Ok(runtime::Value::Undefined)
}

fn install_atomics(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let object = match runtime::new_ordinary_object(
        context.heap(),
        context.heap().object_prototype(),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_to_string_tag(context, object, "Atomics")?;
    for (name, operation) in Vec::from_array(
        [
            ("add", AtomicOperation::Add),
            ("sub", AtomicOperation::Subtract),
            ("and", AtomicOperation::And),
            ("or", AtomicOperation::Or),
            ("xor", AtomicOperation::Xor),
            ("exchange", AtomicOperation::Exchange),
        ],
    ) {
        define_value(
            context.heap(),
            object,
            name,
            allocate_vm_function(
                context,
                "Atomics." + name,
                |this_value, arguments, depth| {
                    atomic_read_modify_write(context, this_value, arguments, depth, operation)
                },
            )?,
            true,
            true,
        )?
    }
    for (name, callback) in Vec::from_array([("load", atomic_load), ("store", atomic_store)]) {
        define_value(
            context.heap(),
            object,
            name,
            allocate_vm_function(
                context,
                "Atomics." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    define_value(
        context.heap(),
        object,
        "compareExchange",
        allocate_vm_function(
            context,
            "Atomics.compareExchange",
            |this_value, arguments, depth| {
                atomic_compare_exchange(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "isLockFree",
        allocate_vm_function(
            context,
            "Atomics.isLockFree",
            |this_value, arguments, depth| {
                atomic_is_lock_free(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, callback) in Vec::from_array(
        [("notify", atomic_notify), ("wait", atomic_wait), ("pause", atomic_pause)],
    ) {
        define_value(
            context.heap(),
            object,
            name,
            allocate_vm_function(
                context,
                "Atomics." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    Result::Ok(runtime::Value::Object(object))
}

pub fn install_arraybuffer(context: vm::Context) -> Result[ArrayBufferInstall, BuiltinError] {
    let (array_buffer, buffer_prototype, buffer_states) = install_array_buffer_constructor(context)?;
    let (shared_array_buffer, _) = install_shared_array_buffer_constructor(context, buffer_states)?;
    let atomics = install_atomics(context)?;
    let (data_view, data_view_states) = install_data_view_constructor(context, buffer_states)?;
    let uint8_array = install_uint8_array_constructor(context, buffer_states, buffer_prototype)?;
    let int32_array = install_int32_array_constructor(context, buffer_states, buffer_prototype)?;
    let float64_array = install_float64_array_constructor(context, buffer_states, buffer_prototype)?;
    let numeric_states: HashMap[runtime::ObjectId, NumericArrayInstance] = HashMap::new();
    let (uint8_clamped_array, uint8_clamped_array_prototype) = install_numeric_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        numeric_states,
        arraybuffer::NumericArrayKind::Uint8Clamped,
        "Uint8ClampedArray",
    )?;
    let (int8_array, int8_array_prototype) = install_numeric_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        numeric_states,
        arraybuffer::NumericArrayKind::Int8,
        "Int8Array",
    )?;
    let (int16_array, int16_array_prototype) = install_numeric_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        numeric_states,
        arraybuffer::NumericArrayKind::Int16,
        "Int16Array",
    )?;
    let (uint16_array, uint16_array_prototype) = install_numeric_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        numeric_states,
        arraybuffer::NumericArrayKind::Uint16,
        "Uint16Array",
    )?;
    let (uint32_array, uint32_array_prototype) = install_numeric_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        numeric_states,
        arraybuffer::NumericArrayKind::Uint32,
        "Uint32Array",
    )?;
    let (float16_array, float16_array_prototype) = install_numeric_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        numeric_states,
        arraybuffer::NumericArrayKind::Float16,
        "Float16Array",
    )?;
    let (float32_array, float32_array_prototype) = install_numeric_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        numeric_states,
        arraybuffer::NumericArrayKind::Float32,
        "Float32Array",
    )?;
    let bigint_states: HashMap[runtime::ObjectId, BigIntArrayInstance] = HashMap::new();
    let (bigint64_array, bigint64_array_prototype) = install_bigint_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        bigint_states,
        arraybuffer::BigIntArrayKind::Signed,
        "BigInt64Array",
    )?;
    let (biguint64_array, biguint64_array_prototype) = install_bigint_array_constructor(
        context,
        buffer_states,
        buffer_prototype,
        bigint_states,
        arraybuffer::BigIntArrayKind::Unsigned,
        "BigUint64Array",
    )?;
    let array_buffer_object = function_object(array_buffer, "ArrayBuffer")?;
    define_value(
        context.heap(),
        array_buffer_object,
        "isView",
        allocate_function(
            context,
            "ArrayBuffer.isView",
            |heap, this_value, arguments| {
                let _ = this_value;
                array_buffer_is_view(heap, data_view_states, arguments)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        array_buffer_object,
        "prototype",
        runtime::Value::Object(buffer_prototype),
        false,
        false,
    )?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(species) => if runtime::define_own_property(
            context.heap(),
            array_buffer_object,
            runtime::PropertyKey::Symbol(species),
            runtime::accessor_descriptor(
                Option::Some(
                    allocate_function_with_length(
                        context,
                        "get [Symbol.species]",
                        0,
                        array_species_getter,
                    )?,
                ),
                Option::None,
                false,
                true,
            ),
        ) {} else {
            return Result::Err(BuiltinError { message: "cannot define ArrayBuffer species" })
        },
        None => (),
    }
    Result::Ok(
        ArrayBufferInstall {
            array_buffer,
            shared_array_buffer,
            atomics,
            data_view,
            uint8_array,
            int32_array,
            float64_array,
            uint8_clamped_array,
            int8_array,
            int16_array,
            uint16_array,
            uint32_array,
            float16_array,
            float32_array,
            bigint64_array,
            biguint64_array,
            buffer_states,
            uint8_array_prototype: arraybuffer_constructor_prototype(
                context.heap(),
                uint8_array,
                "Uint8Array",
            )?,
            int32_array_prototype: arraybuffer_constructor_prototype(
                context.heap(),
                int32_array,
                "Int32Array",
            )?,
            float64_array_prototype: arraybuffer_constructor_prototype(
                context.heap(),
                float64_array,
                "Float64Array",
            )?,
            uint8_clamped_array_prototype,
            int8_array_prototype,
            int16_array_prototype,
            uint16_array_prototype,
            uint32_array_prototype,
            float16_array_prototype,
            float32_array_prototype,
            bigint64_array_prototype,
            biguint64_array_prototype,
        },
    )
}
