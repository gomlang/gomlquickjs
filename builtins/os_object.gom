        "kill",
        allocate_vm_function_with_length(
            context,
            "os.kill",
            2,
            |this_value, arguments, depth| {
                let _ = this_value;
                let process_id = std_file_index(context, argument(arguments, 0), depth)?;
                let signal = std_file_index(context, argument(arguments, 1), depth)?;
                if state.processes.get(process_id).is_some() {
                    state.processes.set(process_id, signal & 0x7f);
                    Result::Ok(runtime::Value::Int(0))
                } else if process_id == state.process_id {
                    match state.signal_handlers.get(signal) {
                        Some(value) => match value.get() {
                            runtime::Value::Undefined => (),
                            runtime::Value::Null => {
                                let status = process::Command::new("kill").args(
                                    Vec::from_array(
                                        ["-" + signal.to_string(), process_id.to_string()],
                                    ),
                                ).status_structured();
                                return Result::Ok(
                                    runtime::Value::Int(
                                        match status {
                                            Ok(value) => if value.success() {
                                                0
                                            } else {
                                                -1
                                            },
                                            Err(_) => -1,
                                        },
                                    ),
                                )
                            },
                            handler => {
                                let arguments: Vec[runtime::Value] = Vec::new();
                                context.enqueue_host_job(handler, arguments)?
                            },
                        },
                        None => {
                            let status = process::Command::new("kill").args(
                                Vec::from_array(["-" + signal.to_string(), process_id.to_string()]),
                            ).status_structured();
                            return Result::Ok(
                                runtime::Value::Int(
                                    match status {
                                        Ok(value) => if value.success() {
                                            0
                                        } else {
                                            -1
                                        },
                                        Err(_) => -1,
                                    },
                                ),
                            )
                        },
                    };
                    Result::Ok(runtime::Value::Int(0))
                } else {
                    let status = process::Command::new("kill").args(
                        Vec::from_array(["-" + signal.to_string(), process_id.to_string()]),
                    ).status_structured();
                    Result::Ok(
                        runtime::Value::Int(
                            match status {
                                Ok(value) => if value.success() {
                                    0
                                } else {
                                    -1
                                },
                                Err(_) => -1,
                            },
                        ),
                    )
                }
            },
        )?,
        true,
        true,
    )?;
