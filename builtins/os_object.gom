    define_value(
        context.heap(),
        object,
        "seek",
        allocate_vm_function_with_length(
            context,
            "os.seek",
            3,
            |this_value, arguments, depth| {
                let _ = this_value;
                let descriptor = os_file_descriptor(context, argument(arguments, 0), depth)?;
                let file = match state.files.get(descriptor) {
                    Some(value) => value,
                    None => return Result::Ok(runtime::Value::Int(-1)),
                };
                let (offset, bigint_value) = os_offset_value(argument(arguments, 1))?;
                let whence = std_file_index(context, argument(arguments, 2), depth)?;
                let base = if whence == 0 {
                    0
                } else if whence == 1 {
                    file.position.get()
                } else if whence == 2 {
                    file.contents.get().len()
                } else {
                    return Result::Ok(os_seek_result(-1, bigint_value))
                };
                if offset < -base {
                    Result::Ok(os_seek_result(-1, bigint_value))
                } else {
                    file.position.set(base + offset);
                    Result::Ok(os_seek_result(base + offset, bigint_value))
                }
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "read",
        allocate_vm_function_with_length(
            context,
            "os.read",
            4,
            |this_value, arguments, depth| {
                let _ = this_value;
                let descriptor = os_file_descriptor(context, argument(arguments, 0), depth)?;
                let file = match state.files.get(descriptor) {
                    Some(value) => value,
                    None => return Result::Ok(runtime::Value::Int(-1)),
                };
                if !file.readable {
                    return Result::Ok(runtime::Value::Int(-1))
                } else {};
                let buffer = std_file_buffer(state.buffers, argument(arguments, 1))?;
                let offset = std_file_index(context, argument(arguments, 2), depth)?;
                let length = std_file_index(context, argument(arguments, 3), depth)?;
                if offset > buffer.byte_length() || length > buffer.byte_length() - offset {
                    return Result::Err(function_range_error("read array buffer overflow"))
                } else {};
                let contents = file.contents.get();
                let position = file.position.get();
                let count = if length < contents.len() - position {
                    length
                } else {
                    contents.len() - position
                };
                match buffer.write_bytes(offset, contents.slice(position, position + count)) {
                    Ok(()) => (),
                    Err(value) => return Result::Err(function_vm_error(value.to_string())),
                };
                file.position.set(position + count);
                Result::Ok(runtime::Value::Int(count.to_i32()))
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "write",
        allocate_vm_function_with_length(
            context,
            "os.write",
            4,
            |this_value, arguments, depth| {
                let _ = this_value;
                let descriptor = os_file_descriptor(context, argument(arguments, 0), depth)?;
                let file = match state.files.get(descriptor) {
                    Some(value) => value,
                    None => return Result::Ok(runtime::Value::Int(-1)),
                };
                if !file.writable {
                    return Result::Ok(runtime::Value::Int(-1))
                } else {};
                let buffer = std_file_buffer(state.buffers, argument(arguments, 1))?;
                let offset = std_file_index(context, argument(arguments, 2), depth)?;
                let length = std_file_index(context, argument(arguments, 3), depth)?;
                let values = match buffer.to_bytes() {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_vm_error(value.to_string())),
                };
                if offset > values.len() || length > values.len() - offset {
                    return Result::Err(function_range_error("write array buffer overflow"))
                } else {};
                let count = os_write_file(file, values.slice(offset, offset + length));
                match state.peers.get(descriptor) {
                    Some(read_descriptor) => {
                        os_schedule_handler(context, state, read_descriptor, true)?
                    },
                    None => (),
                };
                Result::Ok(runtime::Value::Int(count.to_i32()))
            },
        )?,
        true,
        true,
    )?;
