                let _ = this_value;
                let descriptor = os_file_descriptor(context, argument(arguments, 0), depth)?;
                let target = os_file_descriptor(context, argument(arguments, 1), depth)?;
                let file = match state.files.get(descriptor) {
                    Some(value) => value,
                    None => return Result::Ok(runtime::Value::Int(-1)),
                };
                state.files.set(target, file);
                if target >= state.next_file.get() {
