package builtins;

use gomlang::quickjs::arraybuffer;
use gomlang::quickjs::bigint;
use gomlang::quickjs::dtoa;
use gomlang::quickjs::mathx;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::bytes;
use std::env;
use std::fs;
use std::num;
use std::process;
use std::text;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

struct OsFileState {
    contents: Ref[Vec[byte]],
    position: Ref[isize],
    path: Option[string],
    readable: bool,
    writable: bool,
    append: bool,
}

struct OsState {
    files: HashMap[isize, OsFileState],
    next_file: Ref[isize],
    buffers: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer],
    processes: HashMap[isize, isize],
    next_process: Ref[isize],
    peers: HashMap[isize, isize],
    read_handlers: HashMap[isize, runtime::Value],
    write_handlers: HashMap[isize, runtime::Value],
    read_scheduled: HashMap[isize, bool],
    write_scheduled: HashMap[isize, bool],
    environment: HashMap[string, string],
    time_origin: time::Instant,
    directory: Ref[string],
    signal_handlers: HashMap[isize, Ref[runtime::Value]],
    process_id: isize,
}

fn new_os_state(buffers: HashMap[runtime::ObjectId, arraybuffer::ArrayBuffer]) -> OsState {
    let environment: HashMap[string, string] = HashMap::new();
    for (name, value) in env::vars() {
        environment.set(name, value)
    }
    OsState {
        files: HashMap::new(),
        next_file: Ref::new(3),
        buffers,
        processes: HashMap::new(),
        next_process: Ref::new(1000),
        peers: HashMap::new(),
        read_handlers: HashMap::new(),
        write_handlers: HashMap::new(),
        read_scheduled: HashMap::new(),
        write_scheduled: HashMap::new(),
        environment,
        time_origin: time::Instant::now(),
        directory: Ref::new(env::current_dir_structured().unwrap_or(".")),
        signal_handlers: HashMap::new(),
        process_id: os_host_process_id(),
    }
}

fn os_host_process_id() -> isize {
    let output = match process::Command::new("/bin/sh").args(
        Vec::from_array(["-c", "printf %s \"$PPID\""]),
    ).output_structured() {
        Ok(value) => value.stdout(),
        Err(_) => return -1,
    };
    match output.to_string_utf8() {
        Ok(value) => num::parse_int_structured(value).unwrap_or(-1),
        Err(_) => -1,
    }
}

fn os_resolve_path(state: OsState, path: string) -> string {
    if path.byte_len() > 0 && path.byte_get(0) == b'/' {
        path
    } else {
        state.directory.get() + "/" + path
    }
}

fn os_set_signal_handler(
    context: vm::Context,
    state: OsState,
    signal: isize,
    handler: runtime::Value,
) -> () {
    match state.signal_handlers.get(signal) {
        Some(value) => value.set(handler),
        None => {
            let value = Ref::new(handler);
            context.add_external_root(value);
            state.signal_handlers.set(signal, value)
        },
    }
}

fn os_pair(heap: runtime::Heap, value: runtime::Value, error: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match allocate_array(heap, Vec::from_array([value, runtime::Value::Int(error.to_i32())]), 2) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn os_file_descriptor(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    std_file_index(context, value, depth)
}

fn os_file_state(state: OsState, descriptor: isize) -> Result[OsFileState, vm::VmError] {
    match state.files.get(descriptor) {
        Some(value) => Result::Ok(value),
        None => Result::Err(function_vm_error("invalid file descriptor")),
    }
}

fn os_file_flush(file: OsFileState) -> bool {
    if !file.writable {
        true
    } else {
        match file.path {
            Some(path) => match fs::write_bytes_structured(
                path,
                bytes::Bytes::from_vec(file.contents.get()),
            ) {
                Ok(()) => true,
                Err(_) => false,
            },
            None => true,
        }
    }
}

fn os_write_file(file: OsFileState, values: Slice[byte]) -> isize {
    let contents = file.contents.get();
    let mut position = if file.append {
        contents.len()
    } else {
        file.position.get()
    };
    while contents.len() < position {
        contents.push(0)
    }
    for value in values {
        if position < contents.len() {
            contents[position] = value;
        } else {
            contents.push(value);
        };
        position += 1;
    }
    file.position.set(position);
    values.len()
}

fn os_offset_value(value: runtime::Value) -> Result[(isize, bool), vm::VmError] {
    match value {
        runtime::Value::BigInt(value) => {
            let text_value = value.integer().to_string();
            match num::parse_int_structured(text_value) {
                Ok(value) => Result::Ok((value, true)),
                Err(_) => Result::Err(function_range_error("file offset is out of range")),
            }
        },
        runtime::Value::Int(value) => Result::Ok((value.to_isize(), false)),
        runtime::Value::Float(value) => Result::Ok((std_truncated_int(value), false)),
        _ => Result::Err(function_vm_error("invalid file offset")),
    }
}

fn os_seek_result(value: isize, bigint_value: bool) -> runtime::Value {
    if bigint_value {
        runtime::Value::BigInt(runtime::BigInt::from_int64(value.to_i64()))
    } else if value >= -2147483648 && value <= 2147483647 {
        runtime::Value::Int(value.to_i32())
    } else {
        runtime::Value::Float(num::parse_float64_structured(value.to_string()).unwrap_or(0.0))
    }
}

fn os_signed_file_descriptor(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    match number_value_at_depth(context, value, depth)? {
        runtime::Value::Float(value) => Result::Ok(std_truncated_int(value)),
        _ => Result::Ok(0),
    }
}

fn os_tty_window_size(context: vm::Context, descriptor: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let output = match process::Command::new("/bin/sh").args(
        Vec::from_array(["-c", "stty size <&" + descriptor.to_string()]),
    ).output_structured() {
        Ok(value) => if value.status().success() {
            value.stdout()
        } else {
            return Result::Ok(runtime::Value::Null)
        },
        Err(_) => return Result::Ok(runtime::Value::Null),
    };
    let text = match output.to_string_utf8() {
        Ok(value) => text::trim(value),
        Err(_) => return Result::Ok(runtime::Value::Null),
    };
    let values = text::split(text, " ");
    if values.len() != 2 {
        return Result::Ok(runtime::Value::Null)
    } else {};
    let rows = num::parse_int_structured(values[0]).unwrap_or(0);
    let columns = num::parse_int_structured(values[1]).unwrap_or(0);
    if rows < 4 || columns < 4 {
        Result::Ok(runtime::Value::Null)
    } else {
        match allocate_array(
            context.heap(),
            Vec::from_array(
                [runtime::Value::Int(columns.to_i32()), runtime::Value::Int(rows.to_i32())],
            ),
            2,
        ) {
            Ok(value) => Result::Ok(runtime::Value::Object(value)),
            Err(value) => Result::Err(function_vm_error(value.message)),
        }
    }
}

fn os_metadata_object(heap: runtime::Heap, metadata: fs::Metadata, followed: bool) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let object = match runtime::new_ordinary_object(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let file_type = metadata.file_type();
    let type_mode = if !followed && file_type.is_symlink() {
        0o120000
    } else if file_type.is_dir() {
        0o040000
    } else if file_type.is_file() {
        0o100000
    } else {
        0
    };
    let mode = type_mode | metadata.permissions().mode().to_i32().to_isize();
    let milliseconds = metadata.modified_unix_nanoseconds() / 1000000;
    let modified = runtime::Value::Float(
        num::parse_float64_structured(milliseconds.to_string()).unwrap_or(0.0),
    );
    for (name, value) in Vec::from_array(
        [
            ("mode", runtime::Value::Int(mode.to_i32())),
            ("size", os_seek_result(metadata.len().to_isize(), false)),
            ("mtime", modified),
            ("atime", modified),
            ("ctime", modified),
        ],
    ) {
        if !runtime::define_own_property(
            heap,
            object,
            runtime::string_property_key(name),
            runtime::data_descriptor(value, true, true, true),
        ) {
            return Result::Err(function_vm_error("cannot define stat property"))
        } else {}
    }
    Result::Ok(runtime::Value::Object(object))
}

fn os_string_array(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    Vec[string],
    vm::VmError,
] {
    let length_value = context.read_property_at_depth(
        value,
        runtime::Value::String(js_string("length")),
        depth,
    )?;
    let length = match length_value {
        runtime::Value::Int(value) => value.to_isize(),
        runtime::Value::Float(value) => std_truncated_int(value),
        _ => return Result::Err(function_vm_error("os.exec arguments must be an Array")),
    };
    let result: Vec[string] = Vec::with_capacity(length);
    let mut index = 0;
    while index < length {
        result.push(
            std_value_host_string(
                context,
                context.read_property_at_depth(value, runtime::Value::Int(index.to_i32()), depth)?,
                depth,
            )?,
        );
        index += 1;
    }
    Result::Ok(result)
}

fn os_option_block(context: vm::Context, arguments: Vec[runtime::Value], depth: isize) -> Result[
    bool,
    vm::VmError,
] {
    if arguments.len() < 2 {
        return Result::Ok(true)
    } else {};
    match arguments[1] {
        runtime::Value::Undefined => Result::Ok(true),
        value => {
            let block = context.read_property_at_depth(
                value,
                runtime::Value::String(js_string("block")),
                depth,
            )?;
            match block {
                runtime::Value::Undefined => Result::Ok(true),
                _ => Result::Ok(runtime::to_boolean(block)),
            }
        },
    }
}

fn os_option_value(context: vm::Context, arguments: Vec[runtime::Value], name: string, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    if arguments.len() < 2 {
        Result::Ok(runtime::Value::Undefined)
    } else {
        match arguments[1] {
            runtime::Value::Undefined => Result::Ok(runtime::Value::Undefined),
            value => context.read_property_at_depth(
                value,
                runtime::Value::String(js_string(name)),
                depth,
            ),
        }
    }
}

fn os_command_environment(context: vm::Context, arguments: Vec[runtime::Value], depth: isize) -> Result[
    (bool, Vec[(string, string)]),
    vm::VmError,
] {
    let environment = os_option_value(context, arguments, "env", depth)?;
    let object = match environment {
        runtime::Value::Object(value) => value,
        runtime::Value::Undefined => return Result::Ok((false, Vec::new())),
        _ => return Result::Ok((true, Vec::new())),
    };
    let result: Vec[(string, string)] = Vec::new();
    for key in runtime::own_property_keys(context.heap(), object) {
        match key {
            runtime::PropertyKey::String(name) => match name.to_host_string() {
                Ok(host_name) => {
                    let property = context.read_property_at_depth(
                        runtime::Value::Object(object),
                        runtime::Value::String(name),
                        depth,
                    )?;
                    result.push((host_name, std_value_host_string(context, property, depth)?))
                },
                Err(_) => (),
            },
            runtime::PropertyKey::Symbol(_) => (),
        }
    }
    Result::Ok((true, result))
}

fn os_handler(state: OsState, descriptor: isize, read: bool) -> Option[runtime::Value] {
    if read {
        state.read_handlers.get(descriptor)
    } else {
        state.write_handlers.get(descriptor)
    }
}

fn os_handler_scheduled(state: OsState, descriptor: isize, read: bool) -> bool {
    if read {
        state.read_scheduled.get(descriptor).is_some()
    } else {
        state.write_scheduled.get(descriptor).is_some()
    }
}

fn os_set_handler_scheduled(state: OsState, descriptor: isize, read: bool, value: bool) -> () {
    if read {
        if value {
            state.read_scheduled.set(descriptor, true)
        } else {
            let _ = state.read_scheduled.remove(descriptor);
        }
    } else if value {
        state.write_scheduled.set(descriptor, true)
    } else {
        let _ = state.write_scheduled.remove(descriptor);
    }
}

fn os_schedule_handler(context: vm::Context, state: OsState, descriptor: isize, read: bool) -> Result[
    (),
    vm::VmError,
] {
    if os_handler_scheduled(state, descriptor, read) {
        return Result::Ok(())
    } else {};
    let callback = match os_handler(state, descriptor, read) {
        Some(value) => value,
        None => return Result::Ok(()),
    };
    let wrapper = match allocate_vm_function_with_length(
        context,
        "",
        0,
        |this_value, arguments, depth| {
            let _ = this_value;
            os_set_handler_scheduled(state, descriptor, read, false);
            let queued = argument(arguments, 0);
            match os_handler(state, descriptor, read) {
                Some(current) => if runtime::same_value(current, queued) {
                    let callback_arguments: Vec[runtime::Value] = Vec::new();
                    let result = context.invoke_with_this_at_depth(
                        current,
                        callback_arguments,
                        runtime::Value::Undefined,
                        depth,
                    )?;
                    match os_handler(state, descriptor, read) {
                        Some(remaining) => if runtime::same_value(remaining, current) {
                            os_schedule_handler(context, state, descriptor, read)?
                        } else {},
                        None => (),
                    };
                    Result::Ok(result)
                } else {
                    os_schedule_handler(context, state, descriptor, read)?;
                    Result::Ok(runtime::Value::Undefined)
                },
                None => Result::Ok(runtime::Value::Undefined),
            }
        },
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    context.enqueue_host_job(wrapper, Vec::from_array([callback]))?;
    os_set_handler_scheduled(state, descriptor, read, true);
    Result::Ok(())
}

fn os_set_descriptor_handler(
    context: vm::Context,
    state: OsState,
    read: bool,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let descriptor = os_file_descriptor(context, argument(arguments, 0), depth)?;
    let file = os_file_state(state, descriptor)?;
    let callback = argument(arguments, 1);
    match callback {
        runtime::Value::Null => {
            if read {
                let _ = state.read_handlers.remove(descriptor);
            } else {
                let _ = state.write_handlers.remove(descriptor);
            };
            os_set_handler_scheduled(state, descriptor, read, false);
            return Result::Ok(runtime::Value::Undefined)
        },
        _ => (),
    };
    match callback {
        runtime::Value::Object(object) => if !object.is_callable()
            || !context.heap().contains(object) {
            return Result::Err(function_vm_error("descriptor handler is not callable"))
        } else {},
        _ => return Result::Err(function_vm_error("descriptor handler is not callable")),
    };
    if read {
        if !file.readable {
            return Result::Err(function_vm_error("file descriptor is not readable"))
        } else {};
        state.read_handlers.set(descriptor, callback);
        if file.position.get() < file.contents.get().len() {
            os_schedule_handler(context, state, descriptor, true)?
        } else {}
    } else {
        if !file.writable {
            return Result::Err(function_vm_error("file descriptor is not writable"))
        } else {};
        state.write_handlers.set(descriptor, callback);
        os_schedule_handler(context, state, descriptor, false)?
    };
    Result::Ok(runtime::Value::Undefined)
}

pub fn install_os(context: vm::Context, object: runtime::ObjectId, state: OsState) -> Result[
    (),
    BuiltinError,
] {
    for (name, value) in Vec::from_array(
        [
            ("O_RDONLY", 0),
            ("O_WRONLY", 1),
            ("O_RDWR", 2),
            ("O_CREAT", 64),
            ("O_EXCL", 128),
            ("O_TRUNC", 512),
            ("O_APPEND", 1024),
            ("S_IFMT", 0o170000),
            ("S_IFIFO", 0o010000),
            ("S_IFCHR", 0o020000),
            ("S_IFDIR", 0o040000),
            ("S_IFBLK", 0o060000),
            ("S_IFREG", 0o100000),
            ("S_IFLNK", 0o120000),
            ("S_IFSOCK", 0o140000),
            ("S_ISUID", 0o004000),
            ("S_ISGID", 0o002000),
            ("WNOHANG", 1),
            ("SIGINT", 2),
            ("SIGQUIT", 3),
            ("SIGILL", 4),
            ("SIGABRT", 6),
            ("SIGFPE", 8),
            ("SIGUSR1", 10),
            ("SIGSEGV", 11),
            ("SIGUSR2", 12),
            ("SIGPIPE", 13),
            ("SIGALRM", 14),
            ("SIGTERM", 15),
            ("SIGCHLD", 17),
            ("SIGCONT", 18),
            ("SIGSTOP", 19),
            ("SIGTSTP", 20),
            ("SIGTTIN", 21),
            ("SIGTTOU", 22),
        ],
    ) {
        define_value(
            context.heap(),
            object,
            name,
            runtime::Value::Int(value.to_i32()),
            false,
            false,
        )?
    }
    define_value(
        context.heap(),
        object,
        "ttyGetWinSize",
        allocate_vm_function_with_length(
            context,
            "os.ttyGetWinSize",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                let descriptor = os_signed_file_descriptor(context, argument(arguments, 0), depth)?;
                os_tty_window_size(context, descriptor)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "ttySetRaw",
        allocate_vm_function_with_length(
            context,
            "os.ttySetRaw",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                let descriptor = os_signed_file_descriptor(context, argument(arguments, 0), depth)?;
                let _ = process::Command::new("/bin/sh").args(
                    Vec::from_array(["-c", "stty raw <&" + descriptor.to_string()]),
                ).output_structured();
                Result::Ok(runtime::Value::Undefined)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "now",
        allocate_vm_function_with_length(
            context,
            "os.now",
            0,
            |this_value, arguments, depth| {
                let _ = this_value;
                let _ = arguments;
                let _ = depth;
                let nanoseconds = state.time_origin.elapsed().as_nanoseconds();
                let milliseconds = num::parse_float64_structured(nanoseconds.to_string()).unwrap_or(
                    0.0,
                )
                    / 1000000.0;
                Result::Ok(runtime::Value::Float(milliseconds))
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "sleep",
        allocate_vm_function_with_length(
            context,
            "os.sleep",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                let converted = number_value_at_depth(context, argument(arguments, 0), depth)?;
                let milliseconds = match converted {
                    runtime::Value::Float(value) => std_truncated_int64(value),
                    _ => 0,
                };
                if milliseconds > 0 {
                    time::sleep(
                        time::Duration::from_milliseconds(
                            if milliseconds > 9223372036854 {
                                9223372036854
                            } else {
                                milliseconds
                            },
                        ),
                    )
                } else {};
                Result::Ok(runtime::Value::Int(0))
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "getpid",
        allocate_vm_function_with_length(
            context,
            "os.getpid",
            0,
            |this_value, arguments, depth| {
                let _ = this_value;
                let _ = arguments;
                let _ = depth;
                Result::Ok(runtime::Value::Int(state.process_id.to_i32()))
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "mkdir",
        allocate_vm_function_with_length(
            context,
            "os.mkdir",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                let path = os_resolve_path(
                    state,
                    std_value_host_string(context, argument(arguments, 0), depth)?,
                );
                Result::Ok(
                    runtime::Value::Int(
                        if fs::create_dir(path).is_ok() {
                            0
                        } else {
                            -1
                        },
                    ),
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "open",
        allocate_vm_function_with_length(
            context,
            "os.open",
            2,
            |this_value, arguments, depth| {
                let _ = this_value;
                let path = os_resolve_path(
                    state,
                    std_value_host_string(context, argument(arguments, 0), depth)?,
                );
                let flags = std_file_index(context, argument(arguments, 1), depth)?;
                let access = flags & 3;
                let writable = access == 1 || access == 2;
                let readable = access == 0 || access == 2;
                let create = flags & 64 != 0;
                let exclusive = flags & 128 != 0;
                let truncate = flags & 512 != 0;
                let append = flags & 1024 != 0;
                let exists = fs::exists(path);
                if create && exclusive && exists {
                    return Result::Ok(runtime::Value::Int(-17))
                } else {};
                let contents: Vec[byte] = if truncate && writable {
                    Vec::new()
                } else {
                    match fs::read_bytes_structured(path) {
                        Ok(value) => value.to_vec(),
                        Err(_) => if create {
                            Vec::new()
                        } else {
                            return Result::Ok(runtime::Value::Int(-2))
                        },
                    }
                };
                if create && !exists {
                    match fs::write_bytes_structured(path, bytes::Bytes::from_vec(Vec::new())) {
                        Ok(()) => (),
                        Err(_) => return Result::Ok(runtime::Value::Int(-1)),
                    }
                } else {};
                let descriptor = state.next_file.get();
                state.next_file.set(descriptor + 1);
                state.files.set(
                    descriptor,
                    OsFileState {
                        contents: Ref::new(contents),
                        position: Ref::new(
                            if append {
                                contents.len()
                            } else {
                                0
                            },
                        ),
                        path: Option::Some(path),
                        readable,
                        writable,
                        append,
                    },
                );
                Result::Ok(runtime::Value::Int(descriptor.to_i32()))
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "close",
        allocate_vm_function_with_length(
            context,
            "os.close",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                let descriptor = os_file_descriptor(context, argument(arguments, 0), depth)?;
                let file = match state.files.get(descriptor) {
                    Some(value) => value,
                    None => return Result::Ok(runtime::Value::Int(-1)),
                };
                state.files.remove(descriptor);
                Result::Ok(
                    runtime::Value::Int(
                        if os_file_flush(file) {
                            0
                        } else {
                            -1
                        },
                    ),
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "dup",
        allocate_vm_function_with_length(
            context,
            "os.dup",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                let descriptor = os_file_descriptor(context, argument(arguments, 0), depth)?;
                let file = match state.files.get(descriptor) {
                    Some(value) => value,
                    None => return Result::Ok(runtime::Value::Int(-1)),
                };
                let duplicate = state.next_file.get();
                state.next_file.set(duplicate + 1);
                state.files.set(duplicate, file);
                Result::Ok(runtime::Value::Int(duplicate.to_i32()))
            },
        )?,
        true,
        true,
    )?;
