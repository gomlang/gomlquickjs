        allocate_vm_function_with_length(
            context,
            "os.signal",
            2,
            |this_value, arguments, depth| {
                let _ = this_value;
                let number = number_value_at_depth(context, argument(arguments, 0), depth)?;
                let signal = match number {
                    runtime::Value::Float(value) => mathx::to_u32(value).to_i32().to_isize(),
                    _ => 0,
                };
                if signal < 0 || signal >= 64 {
                    return Result::Err(function_range_error("invalid signal number"))
                } else {};
                match argument(arguments, 1) {
                    runtime::Value::Null => {
                        os_set_signal_handler(context, state, signal, runtime::Value::Null)
                    },
                    runtime::Value::Undefined => {
                        os_set_signal_handler(context, state, signal, runtime::Value::Undefined)
                    },
                    runtime::Value::Object(value) => if value.is_callable()
                        && context.heap().contains(value) {
                        os_set_signal_handler(context, state, signal, runtime::Value::Object(value))
                    } else {
                        return Result::Err(function_vm_error("signal handler is not callable"))
                    },
                    _ => return Result::Err(function_vm_error("signal handler is not callable")),
                };
                Result::Ok(runtime::Value::Undefined)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "exec",
        allocate_vm_function_with_length(
            context,
            "os.exec",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                let values = os_string_array(context, argument(arguments, 0), depth)?;
                if values.is_empty() {
                    return Result::Err(function_vm_error("os.exec command must not be empty"))
                } else {};
                let block = os_option_block(context, arguments, depth)?;
                let command_arguments: Vec[string] = Vec::new();
                let mut index = 1;
                while index < values.len() {
                    command_arguments.push(values[index]);
                    index += 1;
                }
                let (explicit_environment, environment) = os_command_environment(
                    context,
                    arguments,
                    depth,
                )?;
                let command = process::Command::new(values[0]).args(command_arguments).current_dir(
                    state.directory.get(),
                ).env_clear().envs(
                    if explicit_environment {
                        environment
                    } else {
                        std_environment_entries(state)
                    },
                );
                if block {
                    let status = match command.status_structured() {
                        Ok(value) => value.code().unwrap_or(-1),
                        Err(_) => -1,
                    };
                    Result::Ok(runtime::Value::Int(status.to_i32()))
                } else {
                    let stdout_value = os_option_value(context, arguments, "stdout", depth)?;
                    let stdout_descriptor = match stdout_value {
                        runtime::Value::Undefined => Option::None,
                        value => Option::Some(os_file_descriptor(context, value, depth)?),
                    };
                    let raw_status = match stdout_descriptor {
                        Some(descriptor) => match command.output_structured() {
                            Ok(value) => {
                                match state.files.get(descriptor) {
                                    Some(file) => {
                                        let output = value.stdout().to_vec();
                                        let _ = os_write_file(file, output.slice(0, output.len()));
                                    },
                                    None => (),
                                };
                                value.status().code().unwrap_or(-1) << 8
                            },
                            Err(_) => -1,
                        },
                        None => 0,
                    };
                    let process_id = state.next_process.get();
                    state.next_process.set(process_id + 1);
                    state.processes.set(process_id, raw_status);
                    Result::Ok(runtime::Value::Int(process_id.to_i32()))
                }
            },
        )?,
        true,
        true,
    )?;
