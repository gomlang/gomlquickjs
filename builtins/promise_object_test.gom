package builtins;

use gomlang::quickjs::bytecode;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::testing;

fn promise_builtin_expect_install(value: Result[runtime::Value, BuiltinError]) -> runtime::Value {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.message);
            runtime::Value::Undefined
        },
    }
}

fn promise_builtin_expect_value(value: Result[runtime::Value, vm::VmError]) -> runtime::Value {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn promise_builtin_expect_object(value: runtime::Value) -> runtime::ObjectId {
    match value {
        runtime::Value::Object(value) => value,
        _ => {
            testing::fail("expected Promise object");
            match runtime::new_ordinary_object(runtime::Heap::new(), Option::None) {
                Ok(value) => value,
                Err(_) => promise_builtin_expect_object(runtime::Value::Undefined),
            }
        },
    }
}

fn promise_builtin_property(heap: runtime::Heap, object: runtime::ObjectId, name: string) -> runtime::Value {
    match runtime::get_property(heap, object, runtime::string_property_key(name)) {
        Ok(Some(value)) => value,
        Ok(None) => {
            testing::fail("missing Promise property " + name);
            runtime::Value::Undefined
        },
        Err(error) => {
            testing::fail(error.message);
            runtime::Value::Undefined
        },
    }
}

fn promise_builtin_invoke(
    context: vm::Context,
    callable: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let code: Vec[bytecode::Instruction] = Vec::from_array([bytecode::Instruction::GetLoc(0)]);
    let mut index = 0;
    while index < arguments.len() {
        code.push(bytecode::Instruction::GetLoc(index + 1));
        index += 1;
    }
    code.push(bytecode::Instruction::Call(arguments.len()));
    code.push(bytecode::Instruction::Return);
    let locals: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 1);
    locals.push(callable);
    for value in arguments {
        locals.push(value)
    }
    context.execute_with_locals(bytecode::Function::new(Vec::new(), code, locals.len()), locals)
}

fn promise_builtin_invoke_method(
    context: vm::Context,
    receiver: runtime::Value,
    callable: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let code: Vec[bytecode::Instruction] = Vec::from_array(
        [bytecode::Instruction::GetLoc(0), bytecode::Instruction::GetLoc(1)],
    );
    let mut index = 0;
    while index < arguments.len() {
        code.push(bytecode::Instruction::GetLoc(index + 2));
        index += 1;
    }
    code.push(bytecode::Instruction::CallMethod(arguments.len()));
    code.push(bytecode::Instruction::Return);
    let locals: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 2);
    locals.push(receiver);
    locals.push(callable);
    for value in arguments {
        locals.push(value)
    }
    context.execute_with_locals(bytecode::Function::new(Vec::new(), code, locals.len()), locals)
}

fn promise_builtin_static(
    context: vm::Context,
    constructor: runtime::Value,
    name: string,
    arguments: Vec[runtime::Value],
) -> runtime::Value {
    let object = promise_builtin_expect_object(constructor);
    promise_builtin_expect_value(
        promise_builtin_invoke(
            context,
            promise_builtin_property(context.heap(), object, name),
            arguments,
        ),
    )
}

fn promise_builtin_method(
    context: vm::Context,
    receiver: runtime::Value,
    name: string,
    arguments: Vec[runtime::Value],
) -> runtime::Value {
    let object = promise_builtin_expect_object(receiver);
    promise_builtin_expect_value(
        promise_builtin_invoke_method(
            context,
            receiver,
            promise_builtin_property(context.heap(), object, name),
            arguments,
        ),
    )
}

fn promise_builtin_native(
    context: vm::Context,
    callback: (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
        runtime::Value,
        vm::NativeError,
    ],
) -> runtime::Value {
    match context.new_native_function(callback) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn promise_builtin_array(heap: runtime::Heap, values: Vec[runtime::Value]) -> runtime::Value {
    match runtime::new_array(heap, values.len()) {
        Ok(object) => {
            let mut index = 0;
            while index < values.len() {
                testing::assert(
                    runtime::define_own_property(
                        heap,
                        object,
                        runtime::string_property_key(index.to_string()),
                        runtime::data_descriptor(values[index], true, true, true),
                    ),
                );
                index += 1;
            }
            runtime::Value::Object(object)
        },
        Err(error) => {
            testing::fail(error.message);
            runtime::Value::Undefined
        },
    }
}

fn promise_builtin_drain(context: vm::Context, constructor: runtime::Value) -> isize {
    match promise_builtin_static(context, constructor, "drainJobs", Vec::new()) {
        runtime::Value::Int(value) => value.to_isize(),
        _ => {
            testing::fail("expected Promise job count");
            0
        },
    }
}

fn promise_builtin_assert_same(actual: runtime::Value, expected: runtime::Value) -> unit {
    testing::assert(runtime::same_value(actual, expected))
}

#[test]
fn promise_constructor_runs_executor_and_then_is_asynchronous() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let executor_called = Ref::new(false);
    let executor = promise_builtin_native(
        context,
        |_, _, arguments| {
            executor_called.set(true);
            let resolve = arguments[0];
            let _ = promise_builtin_invoke(
                context,
                resolve,
                Vec::from_array([runtime::Value::Int(7)]),
            );
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let instance = promise_builtin_expect_value(
        promise_builtin_invoke(context, constructor, Vec::from_array([executor])),
    );
    testing::assert(executor_called.get());
    let observed = Ref::new(runtime::Value::Undefined);
    let handler = promise_builtin_native(
        context,
        |_, _, arguments| {
            observed.set(arguments[0]);
            Result::Ok(runtime::Value::Int(8))
        },
    );
    let child = promise_builtin_method(context, instance, "then", Vec::from_array([handler]));
    match observed.get() {
        runtime::Value::Undefined => (),
        _ => testing::fail("Promise handler ran synchronously"),
    };
    testing::assert(promise_builtin_drain(context, constructor) >= 1);
    promise_builtin_assert_same(observed.get(), runtime::Value::Int(7));
    let child_observed = Ref::new(runtime::Value::Undefined);
    let child_handler = promise_builtin_native(
        context,
        |_, _, arguments| {
            child_observed.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, child, "then", Vec::from_array([child_handler]));
    testing::assert(promise_builtin_drain(context, constructor) >= 1);
    promise_builtin_assert_same(child_observed.get(), runtime::Value::Int(8))
}

#[test]
fn promise_rejection_catch_and_finally_preserve_chain_semantics() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let rejected = promise_builtin_static(
        context,
        constructor,
        "reject",
        Vec::from_array([runtime::Value::Int(11)]),
    );
    let recovered_reason = Ref::new(runtime::Value::Undefined);
    let recover = promise_builtin_native(
        context,
        |_, _, arguments| {
            recovered_reason.set(arguments[0]);
            Result::Ok(runtime::Value::Int(12))
        },
    );
    let recovered = promise_builtin_method(context, rejected, "catch", Vec::from_array([recover]));
    let finally_calls = Ref::new(0);
    let cleanup = promise_builtin_native(
        context,
        |_, _, arguments| {
            testing::assert(arguments.is_empty());
            finally_calls.set(finally_calls.get() + 1);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let preserved = promise_builtin_method(
        context,
        recovered,
        "finally",
        Vec::from_array([cleanup]),
    );
    let result = Ref::new(runtime::Value::Undefined);
    let observer = promise_builtin_native(
        context,
        |_, _, arguments| {
            result.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, preserved, "then", Vec::from_array([observer]));
    testing::assert(promise_builtin_drain(context, constructor) >= 3);
    promise_builtin_assert_same(recovered_reason.get(), runtime::Value::Int(11));
    promise_builtin_assert_same(result.get(), runtime::Value::Int(12));
    testing::assert_eq(finally_calls.get(), 1)
}

#[test]
fn promise_resolve_adopts_promises_and_data_thenables() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let original = promise_builtin_static(
        context,
        constructor,
        "resolve",
        Vec::from_array([runtime::Value::Int(21)]),
    );
    let same = promise_builtin_static(context, constructor, "resolve", Vec::from_array([original]));
    promise_builtin_assert_same(same, original);
    let thenable = match runtime::new_ordinary_object(context.heap(), Option::None) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.message);
            promise_builtin_expect_object(runtime::Value::Undefined)
        },
    };
    let then_function = promise_builtin_native(
        context,
        |_, this_value, arguments| {
            promise_builtin_assert_same(this_value, runtime::Value::Object(thenable));
            let resolve = arguments[0];
            let reject = arguments[1];
            let _ = promise_builtin_invoke(
                context,
                resolve,
                Vec::from_array([runtime::Value::Int(22)]),
            );
            let _ = promise_builtin_invoke(
                context,
                reject,
                Vec::from_array([runtime::Value::Int(23)]),
            );
            Result::Ok(runtime::Value::Undefined)
        },
    );
    testing::assert(
        runtime::define_own_property(
            context.heap(),
            thenable,
            runtime::string_property_key("then"),
            runtime::data_descriptor(then_function, true, true, true),
        ),
    );
    let adopted = promise_builtin_static(
        context,
        constructor,
        "resolve",
        Vec::from_array([runtime::Value::Object(thenable)]),
    );
    let observed = Ref::new(runtime::Value::Undefined);
    let handler = promise_builtin_native(
        context,
        |_, _, arguments| {
            observed.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, adopted, "then", Vec::from_array([handler]));
    testing::assert(promise_builtin_drain(context, constructor) >= 2);
    promise_builtin_assert_same(observed.get(), runtime::Value::Int(22))
}

#[test]
fn promise_handler_throw_becomes_child_rejection() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let source = promise_builtin_static(
        context,
        constructor,
        "resolve",
        Vec::from_array([runtime::Value::Int(30)]),
    );
    let handler = promise_builtin_native(
        context,
        |_, _, _| Result::Err(vm::NativeError { message: "handler failure" }),
    );
    let child = promise_builtin_method(context, source, "then", Vec::from_array([handler]));
    let caught = Ref::new(runtime::Value::Undefined);
    let catcher = promise_builtin_native(
        context,
        |_, _, arguments| {
            caught.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, child, "catch", Vec::from_array([catcher]));
    let _ = promise_builtin_drain(context, constructor);
    promise_builtin_assert_same(
        caught.get(),
        runtime::Value::String(js_string("TypeError: handler failure")),
    )
}

#[test]
fn promise_all_and_all_settled_return_ecmascript_shaped_arrays() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let rejected = promise_builtin_static(
        context,
        constructor,
        "reject",
        Vec::from_array([runtime::Value::Int(42)]),
    );
    let input = promise_builtin_array(
        context.heap(),
        Vec::from_array([runtime::Value::Int(41), rejected]),
    );
    let all_settled = promise_builtin_static(
        context,
        constructor,
        "allSettled",
        Vec::from_array([input]),
    );
    let settled_result = Ref::new(runtime::Value::Undefined);
    let settled_handler = promise_builtin_native(
        context,
        |_, _, arguments| {
            settled_result.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, all_settled, "then", Vec::from_array([settled_handler]));
    let all = promise_builtin_static(
        context,
        constructor,
        "all",
        Vec::from_array(
            [
                promise_builtin_array(
                    context.heap(),
                    Vec::from_array([runtime::Value::Int(43), runtime::Value::Int(44)]),
                ),
            ],
        ),
    );
    let all_result = Ref::new(runtime::Value::Undefined);
    let all_handler = promise_builtin_native(
        context,
        |_, _, arguments| {
            all_result.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, all, "then", Vec::from_array([all_handler]));
    let _ = promise_builtin_drain(context, constructor);
    let settled_array = promise_builtin_expect_object(settled_result.get());
    let first = promise_builtin_expect_object(
        promise_builtin_property(context.heap(), settled_array, "0"),
    );
    let second = promise_builtin_expect_object(
        promise_builtin_property(context.heap(), settled_array, "1"),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), first, "status"),
        runtime::Value::String(js_string("fulfilled")),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), first, "value"),
        runtime::Value::Int(41),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), second, "status"),
        runtime::Value::String(js_string("rejected")),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), second, "reason"),
        runtime::Value::Int(42),
    );
    let all_array = promise_builtin_expect_object(all_result.get());
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), all_array, "0"),
        runtime::Value::Int(43),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), all_array, "1"),
        runtime::Value::Int(44),
    )
}

#[test]
fn promise_race_any_and_aggregate_failure_are_exposed() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let rejected_first = promise_builtin_static(
        context,
        constructor,
        "reject",
        Vec::from_array([runtime::Value::Int(51)]),
    );
    let fulfilled = promise_builtin_static(
        context,
        constructor,
        "resolve",
        Vec::from_array([runtime::Value::Int(52)]),
    );
    let raced = promise_builtin_static(
        context,
        constructor,
        "race",
        Vec::from_array(
            [promise_builtin_array(context.heap(), Vec::from_array([rejected_first, fulfilled]))],
        ),
    );
    let race_reason = Ref::new(runtime::Value::Undefined);
    let race_catcher = promise_builtin_native(
        context,
        |_, _, arguments| {
            race_reason.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, raced, "catch", Vec::from_array([race_catcher]));
    let any = promise_builtin_static(
        context,
        constructor,
        "any",
        Vec::from_array(
            [
                promise_builtin_array(
                    context.heap(),
                    Vec::from_array(
                        [
                            promise_builtin_static(
                                context,
                                constructor,
                                "reject",
                                Vec::from_array([runtime::Value::Int(53)]),
                            ),
                            promise_builtin_static(
                                context,
                                constructor,
                                "reject",
                                Vec::from_array([runtime::Value::Int(54)]),
                            ),
                        ],
                    ),
                ),
            ],
        ),
    );
    let aggregate_value = Ref::new(runtime::Value::Undefined);
    let any_catcher = promise_builtin_native(
        context,
        |_, _, arguments| {
            aggregate_value.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, any, "catch", Vec::from_array([any_catcher]));
    let _ = promise_builtin_drain(context, constructor);
    promise_builtin_assert_same(race_reason.get(), runtime::Value::Int(51));
    let aggregate = promise_builtin_expect_object(aggregate_value.get());
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), aggregate, "name"),
        runtime::Value::String(js_string("AggregateError")),
    );
    let errors = promise_builtin_expect_object(
        promise_builtin_property(context.heap(), aggregate, "errors"),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), errors, "0"),
        runtime::Value::Int(53),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), errors, "1"),
        runtime::Value::Int(54),
    )
}

#[test]
fn promise_combinator_array_limit_rejects_instead_of_throwing() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let result = promise_builtin_static(
        context,
        constructor,
        "all",
        Vec::from_array([runtime::Value::Int(1)]),
    );
    let reason = Ref::new(runtime::Value::Undefined);
    let catcher = promise_builtin_native(
        context,
        |_, _, arguments| {
            reason.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, result, "catch", Vec::from_array([catcher]));
    let _ = promise_builtin_drain(context, constructor);
    let error = promise_builtin_expect_object(reason.get());
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), error, "name"),
        runtime::Value::String(js_string("TypeError")),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), error, "message"),
        runtime::Value::String(js_string("Promise combinators currently require an Array")),
    )
}

#[test]
fn nested_promise_combinators_keep_array_values_scalar() -> unit {
    let context = vm::Context::new(runtime::Heap::new());
    let constructor = promise_builtin_expect_install(install_promise(context));
    let inner = promise_builtin_static(
        context,
        constructor,
        "all",
        Vec::from_array(
            [promise_builtin_array(context.heap(), Vec::from_array([runtime::Value::Int(71)]))],
        ),
    );
    let outer = promise_builtin_static(
        context,
        constructor,
        "all",
        Vec::from_array([promise_builtin_array(context.heap(), Vec::from_array([inner]))]),
    );
    let result = Ref::new(runtime::Value::Undefined);
    let observer = promise_builtin_native(
        context,
        |_, _, arguments| {
            result.set(arguments[0]);
            Result::Ok(runtime::Value::Undefined)
        },
    );
    let _ = promise_builtin_method(context, outer, "then", Vec::from_array([observer]));
    let _ = promise_builtin_drain(context, constructor);
    let outer_array = promise_builtin_expect_object(result.get());
    let inner_array = promise_builtin_expect_object(
        promise_builtin_property(context.heap(), outer_array, "0"),
    );
    promise_builtin_assert_same(
        promise_builtin_property(context.heap(), inner_array, "0"),
        runtime::Value::Int(71),
    )
}
