package builtins;

use gomlang::quickjs::bytecode;
use gomlang::quickjs::promise;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::collections;

fn promise_object_state(states: HashMap[runtime::ObjectId, promise::Promise], value: runtime::Value) -> Result[
    promise::Promise,
    vm::NativeError,
] {
    match value {
        runtime::Value::Object(object) => match states.get(object) {
            Some(value) => Result::Ok(value),
            None => Result::Err(native_error("Promise method called on incompatible receiver")),
        },
        _ => Result::Err(native_error("Promise method called on incompatible receiver")),
    }
}

fn promise_object_callable(value: runtime::Value) -> bool {
    match value {
        runtime::Value::Object(object) => object.is_callable(),
        _ => false,
    }
}

struct PromiseObjectCapability {
    promise: runtime::Value,
    resolve: runtime::Value,
    reject: runtime::Value,
}

fn promise_object_new_capability(context: vm::Context, constructor: runtime::Value, depth: isize) -> Result[
    PromiseObjectCapability,
    vm::VmError,
] {
    if !vm::is_constructor(context, constructor) {
        return Result::Err(function_vm_error("Promise capability constructor is not constructable"))
    }
    let resolve = Ref::new(runtime::Value::Undefined);
    let reject = Ref::new(runtime::Value::Undefined);
    let executor = match allocate_vm_function_with_length(
        context,
        "",
        2,
        |this_value, arguments, executor_depth| {
            let _ = this_value;
            let _ = executor_depth;
            if !runtime::same_value(resolve.get(), runtime::Value::Undefined)
                || !runtime::same_value(reject.get(), runtime::Value::Undefined) {
                Result::Err(function_vm_error("Promise capability executor called more than once"))
            } else {
                resolve.set(argument(arguments, 0));
                reject.set(argument(arguments, 1));
                Result::Ok(runtime::Value::Undefined)
            }
        },
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(function_vm_error(error.message)),
    };
    let result = context.construct_with_new_target_at_depth(
        constructor,
        Vec::from_array([executor]),
        constructor,
        depth,
    )?;
    if !promise_object_callable(resolve.get()) || !promise_object_callable(reject.get()) {
        Result::Err(function_vm_error("Promise capability resolver is not callable"))
    } else {
        Result::Ok(
            PromiseObjectCapability {
                promise: result,
                resolve: resolve.get(),
                reject: reject.get(),
            },
        )
    }
}

fn promise_object_invoke_capability(
    context: vm::Context,
    callable: runtime::Value,
    value: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    let _ = context.invoke_with_this_at_depth(
        callable,
        Vec::from_array([value]),
        runtime::Value::Undefined,
        depth,
    )?;
    Result::Ok(())
}

fn promise_object_invoke(
    context: vm::Context,
    callable: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let code: Vec[bytecode::Instruction] = Vec::from_array([bytecode::Instruction::GetLoc(0)]);
    let mut index = 0;
    while index < arguments.len() {
        code.push(bytecode::Instruction::GetLoc(index + 1));
        index += 1;
    }
    code.push(bytecode::Instruction::Call(arguments.len()));
    code.push(bytecode::Instruction::Return);
    let locals: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 1);
    locals.push(callable);
    for value in arguments {
        locals.push(value)
    }
    context.execute_with_locals(bytecode::Function::new(Vec::new(), code, locals.len()), locals)
}

fn promise_object_invoke_method(
    context: vm::Context,
    receiver: runtime::Value,
    callable: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let code: Vec[bytecode::Instruction] = Vec::from_array(
        [bytecode::Instruction::GetLoc(0), bytecode::Instruction::GetLoc(1)],
    );
    let mut index = 0;
    while index < arguments.len() {
        code.push(bytecode::Instruction::GetLoc(index + 2));
        index += 1;
    }
    code.push(bytecode::Instruction::CallMethod(arguments.len()));
    code.push(bytecode::Instruction::Return);
    let locals: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 2);
    locals.push(receiver);
    locals.push(callable);
    for value in arguments {
        locals.push(value)
    }
    context.execute_with_locals(bytecode::Function::new(Vec::new(), code, locals.len()), locals)
}

fn promise_object_vm_failure(error: vm::VmError) -> promise::PromiseFailure {
    match error.kind {
        vm::VmErrorKind::Thrown(value) => promise::PromiseFailure::Rejection(value),
        vm::VmErrorKind::TypeError(message) => promise::PromiseFailure::Rejection(
            runtime::Value::String(js_string("TypeError: " + message)),
        ),
        vm::VmErrorKind::RangeError(message) => promise::PromiseFailure::Rejection(
            runtime::Value::String(js_string("RangeError: " + message)),
        ),
        vm::VmErrorKind::CallDepthExceeded => promise::PromiseFailure::Rejection(
            runtime::Value::String(js_string("InternalError: call depth exceeded")),
        ),
        value => promise::PromiseFailure::Rejection(
            runtime::Value::String(js_string("RuntimeError: " + value.debug())),
        ),
    }
}

fn promise_object_failure_value(heap: runtime::Heap, failure: promise::PromiseFailure) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    match failure {
        promise::PromiseFailure::Rejection(value) => Result::Ok(value),
        promise::PromiseFailure::TypeError(message) => {
            promise_object_named_error(heap, "TypeError", message)
        },
        promise::PromiseFailure::Aggregate(aggregate) => {
            let errors: Vec[runtime::Value] = Vec::with_capacity(aggregate.errors.len());
            for error in aggregate.errors {
                errors.push(promise_object_failure_value(heap, error)?)
            }
            let errors_object = allocate_array(heap, errors, errors.len())?;
            let object = allocate_ordinary(heap, Option::None)?;
            define_data(
                heap,
                object,
                runtime::string_property_key("name"),
                runtime::Value::String(js_string("AggregateError")),
                true,
                false,
                true,
            )?;
            define_data(
                heap,
                object,
                runtime::string_property_key("message"),
                runtime::Value::String(js_string("All promises were rejected")),
                true,
                false,
                true,
            )?;
            define_data(
                heap,
                object,
                runtime::string_property_key("errors"),
                runtime::Value::Object(errors_object),
                true,
                false,
                true,
            )?;
            Result::Ok(runtime::Value::Object(object))
        },
    }
}

fn promise_object_failure_value_with_context(context: vm::Context, failure: promise::PromiseFailure) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    match failure {
        promise::PromiseFailure::TypeError(message) => {
            Result::Ok(context.rejection_value(function_vm_error(message)))
        },
        _ => promise_object_failure_value(context.heap(), failure),
    }
}

fn promise_object_named_error(heap: runtime::Heap, name: string, message: string) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let object = allocate_ordinary(heap, Option::None)?;
    define_data(
        heap,
        object,
        runtime::string_property_key("name"),
        runtime::Value::String(js_string(name)),
        true,
        false,
        true,
    )?;
    define_data(
        heap,
        object,
        runtime::string_property_key("message"),
        runtime::Value::String(js_string(message)),
        true,
        false,
        true,
    )?;
    Result::Ok(runtime::Value::Object(object))
}

fn promise_object_settlement_value(heap: runtime::Heap, settlement: promise::PromiseSettlement) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let object = allocate_ordinary(heap, Option::None)?;
    match settlement {
        promise::PromiseSettlement::Fulfilled(value) => {
            define_data(
                heap,
                object,
                runtime::string_property_key("status"),
                runtime::Value::String(js_string("fulfilled")),
                true,
                true,
                true,
            )?;
            define_data(
                heap,
                object,
                runtime::string_property_key("value"),
                value,
                true,
                true,
                true,
            )?
        },
        promise::PromiseSettlement::Rejected(error) => {
            define_data(
                heap,
                object,
                runtime::string_property_key("status"),
                runtime::Value::String(js_string("rejected")),
                true,
                true,
                true,
            )?;
            define_data(
                heap,
                object,
                runtime::string_property_key("reason"),
                promise_object_failure_value(heap, error)?,
                true,
                true,
                true,
            )?
        },
    }
    Result::Ok(runtime::Value::Object(object))
}

fn promise_object_fulfillment_value(heap: runtime::Heap, fulfillment: promise::PromiseFulfillment) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    match fulfillment {
        promise::PromiseFulfillment::Value(value) => Result::Ok(value),
        promise::PromiseFulfillment::Values(values) => {
            let object = allocate_array(heap, values, values.len())?;
            Result::Ok(runtime::Value::Object(object))
        },
        promise::PromiseFulfillment::Settlements(settlements) => {
            let values: Vec[runtime::Value] = Vec::with_capacity(settlements.len());
            for settlement in settlements {
                values.push(promise_object_settlement_value(heap, settlement)?)
            }
            let object = allocate_array(heap, values, values.len())?;
            Result::Ok(runtime::Value::Object(object))
        },
    }
}

fn promise_object_wrap(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, promise::Promise],
    prototype: runtime::ObjectId,
    value: promise::Promise,
) -> Result[runtime::Value, vm::NativeError] {
    let object = allocate_ordinary(heap, Option::Some(prototype))?;
    value.bind_host_object(object);
    states[object] = value;
    Result::Ok(runtime::Value::Object(object))
}

fn promise_object_gc_edges(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, promise::Promise],
) -> Vec[runtime::GcEdge] {
    let edges: Vec[runtime::GcEdge] = Vec::new();
    let stale: Vec[runtime::ObjectId] = Vec::new();
    for (object, state) in states.entries() {
        if heap.contains(object) {
            edges.push(runtime::GcEdge { owner: object, values: state.gc_values() })
        } else {
            stale.push(object)
        }
    }
    for object in stale {
        let _ = states.remove(object);
    }
    edges
}

fn promise_object_new_native(
    context: vm::Context,
    callback: (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
        runtime::Value,
        vm::NativeError,
    ],
) -> Result[runtime::Value, vm::NativeError] {
    match context.new_native_function(callback) {
        Ok(value) => match value {
            runtime::Value::Object(object) => if runtime::define_own_property(
                context.heap(),
                object,
                runtime::string_property_key("length"),
                runtime::data_descriptor(runtime::Value::Int(1), false, false, true),
            )
                && runtime::define_own_property(
                    context.heap(),
                    object,
                    runtime::string_property_key("name"),
                    runtime::data_descriptor(
                        runtime::Value::String(js_string("")),
                        false,
                        false,
                        true,
                    ),
                ) {
                Result::Ok(value)
            } else {
                Result::Err(native_error("cannot initialize promise resolving function"))
            },
            _ => Result::Err(native_error("promise resolving function is not an object")),
        },
        Err(error) => Result::Err(native_error(error.kind.debug())),
    }
}

fn promise_object_reject_capability(
    capability: promise::PromiseCapability,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = capability.reject(promise::PromiseFailure::Rejection(argument(arguments, 0)));
    Result::Ok(runtime::Value::Undefined)
}

fn promise_object_resolve_capability(
    context: vm::Context,
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, promise::Promise],
    prototype: runtime::ObjectId,
    capability: promise::PromiseCapability,
    value: runtime::Value,
) -> () {
    if runtime::same_value(value, capability.promise().host_object_root().get()) {
        let _ = capability.reject(
            promise::PromiseFailure::TypeError("promise cannot resolve itself"),
        );
        return
    }
    match promise_object_resolution(context, heap, states, prototype, value) {
        Ok(resolution) => {
            let _ = capability.resolve(resolution);
        },
        Err(error) => {
            let _ = capability.reject(error);
        },
    }
}

fn promise_object_thenable_execute(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    prototype: runtime::ObjectId,
    receiver: runtime::Value,
    then_function: runtime::Value,
    capability: promise::PromiseCapability,
) -> Result[(), promise::PromiseFailure] {
    let resolve = match promise_object_new_native(
        context,
        |heap, _, arguments| {
            promise_object_resolve_capability(
                context,
                heap,
                states,
                prototype,
                capability,
                argument(arguments, 0),
            );
            Result::Ok(runtime::Value::Undefined)
        },
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(promise::PromiseFailure::TypeError(error.message)),
    };
    let reject = match promise_object_new_native(
        context,
        |_, _, arguments| promise_object_reject_capability(capability, arguments),
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(promise::PromiseFailure::TypeError(error.message)),
    };
    match promise_object_invoke_method(
        context,
        receiver,
        then_function,
        Vec::from_array([resolve, reject]),
    ) {
        Ok(_) => Result::Ok(()),
        Err(error) => Result::Err(promise_object_vm_failure(error)),
    }
}

fn promise_object_observed_resolution(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    prototype: runtime::ObjectId,
    object: runtime::ObjectId,
    then_function: runtime::Value,
) -> Result[promise::PromiseResolution, promise::PromiseFailure] {
    if promise_object_callable(then_function) {
        Result::Ok(
            promise::PromiseResolution::Thenable(
                |capability| {
                    promise_object_thenable_execute(
                        context,
                        states,
                        prototype,
                        runtime::Value::Object(object),
                        then_function,
                        capability,
                    )
                },
            ),
        )
    } else {
        Result::Ok(promise::value(runtime::Value::Object(object)))
    }
}

fn promise_object_resolution(
    context: vm::Context,
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, promise::Promise],
    prototype: runtime::ObjectId,
    value: runtime::Value,
) -> Result[promise::PromiseResolution, promise::PromiseFailure] {
    let _ = heap;
    match value {
        runtime::Value::Object(object) => {
            let then_function = match context.read_property_at_depth(
                runtime::Value::Object(object),
                runtime::Value::String(js_string("then")),
                0,
            ) {
                Ok(value) => value,
                Err(error) => return Result::Err(promise_object_vm_failure(error)),
            };
            promise_object_observed_resolution(context, states, prototype, object, then_function)
        },
        _ => Result::Ok(promise::value(value)),
    }
}

fn promise_object_awaited_promise(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    prototype: runtime::ObjectId,
    constructor: Ref[runtime::Value],
    value: runtime::Value,
    depth: isize,
) -> Result[promise::Promise, promise::PromiseFailure] {
    match value {
        runtime::Value::Object(object) => match states.get(object) {
            Some(source) => {
                let observed = match context.read_property_at_depth(
                    value,
                    runtime::Value::String(js_string("constructor")),
                    depth,
                ) {
                    Ok(value) => value,
                    Err(error) => return Result::Err(promise_object_vm_failure(error)),
                };
                if runtime::same_value(observed, constructor.get()) {
                    Result::Ok(source)
                } else {
                    Result::Ok(
                        promise::Promise::resolved(
                            queue,
                            promise::PromiseResolution::Promise(source),
                        ),
                    )
                }
            },
            None => match promise_object_resolution(
                context,
                context.heap(),
                states,
                prototype,
                value,
            ) {
                Ok(resolution) => Result::Ok(promise::Promise::resolved(queue, resolution)),
                Err(error) => Result::Err(error),
            },
        },
        _ => match promise_object_resolution(context, context.heap(), states, prototype, value) {
            Ok(resolution) => Result::Ok(promise::Promise::resolved(queue, resolution)),
            Err(error) => Result::Err(error),
        },
    }
}

fn promise_object_async_resume(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    prototype: runtime::ObjectId,
    constructor: Ref[runtime::Value],
    capability: promise::PromiseCapability,
    generator: runtime::Value,
    input: runtime::Value,
    throwing: bool,
    depth: isize,
) -> () {
    let result = if throwing {
        context.throw_generator_raw_at_depth(generator, input, depth)
    } else {
        context.resume_generator_raw_at_depth(generator, input, depth)
    };
    let value = match result {
        Ok(vm::GeneratorCompletion::Await(value)) => value,
        Ok(vm::GeneratorCompletion::Return(value)) => {
            context.release_async_function(generator);
            match promise_object_resolution(context, context.heap(), states, prototype, value) {
                Ok(resolution) => {
                    let _ = capability.resolve(resolution);
                },
                Err(error) => {
                    let _ = capability.reject(error);
                },
            }
            return
        },
        Ok(vm::GeneratorCompletion::Yield(_)) => {
            context.release_async_function(generator);
            let _ = capability.reject(
                promise::PromiseFailure::TypeError("yield escaped an async function frame"),
            );
            return
        },
        Ok(vm::GeneratorCompletion::YieldRaw(_)) => {
            context.release_async_function(generator);
            let _ = capability.reject(
                promise::PromiseFailure::TypeError("yield escaped an async function frame"),
            );
            return
        },
        Err(error) => {
            context.release_async_function(generator);
            let _ = capability.reject(promise_object_vm_failure(error));
            return
        },
    };
    let awaited = match promise_object_awaited_promise(
        context,
        states,
        queue,
        prototype,
        constructor,
        value,
        depth,
    ) {
        Ok(value) => value,
        Err(error) => promise::Promise::rejected(queue, error),
    };
    let on_fulfilled: Option[
        (promise::PromiseFulfillment) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |fulfillment| {
            match promise_object_fulfillment_value(context.heap(), fulfillment) {
                Ok(value) => {
                    promise_object_async_resume(
                        context,
                        states,
                        queue,
                        prototype,
                        constructor,
                        capability,
                        generator,
                        value,
                        false,
                        depth,
                    )
                },
                Err(error) => {
                    let _ = capability.reject(promise::PromiseFailure::TypeError(error.message));
                },
            }
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let on_rejected: Option[
        (promise::PromiseFailure) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |failure| {
            match promise_object_failure_value_with_context(context, failure) {
                Ok(value) => {
                    promise_object_async_resume(
                        context,
                        states,
                        queue,
                        prototype,
                        constructor,
                        capability,
                        generator,
                        value,
                        true,
                        depth,
                    )
                },
                Err(error) => {
                    let _ = capability.reject(promise::PromiseFailure::TypeError(error.message));
                },
            }
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let _ = awaited.then_with_roots(on_fulfilled, on_rejected, Vec::from_array([generator]));
}

fn promise_object_async_runner(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    prototype: runtime::ObjectId,
    constructor: Ref[runtime::Value],
    generator: runtime::Value,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let capability = promise::PromiseCapability::new(queue);
    let result = match promise_object_wrap(context.heap(), states, prototype, capability.promise()) {
        Ok(value) => value,
        Err(error) => return Result::Err(
            vm::VmError { offset: -1, kind: vm::VmErrorKind::TypeError(error.message) },
        ),
    };
    context.link_async_function(result, generator)?;
    promise_object_async_resume(
        context,
        states,
        queue,
        prototype,
        constructor,
        capability,
        generator,
        runtime::Value::Undefined,
        false,
        depth,
    );
    Result::Ok(result)
}

enum AsyncGeneratorRequestKind {
    Next,
    Throw,
    Return,
}

struct AsyncGeneratorRequest {
    kind: AsyncGeneratorRequestKind,
    value: runtime::Value,
    capability: promise::PromiseCapability,
    promise_value: runtime::Value,
    depth: isize,
}

struct AsyncGeneratorState {
    requests: collections::Deque[AsyncGeneratorRequest],
    running: Ref[bool],
    promise_constructor: Ref[runtime::Value],
}

fn async_generator_awaited_promise(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
    awaited: runtime::Value,
    depth: isize,
) -> promise::Promise {
    let constructor = match generator {
        runtime::Value::Object(object) => match generators.get(object) {
            Some(state) => Option::Some(state.promise_constructor),
            None => Option::None,
        },
        _ => Option::None,
    };
    match constructor {
        Some(value) => match promise_object_awaited_promise(
            context,
            states,
            queue,
            promise_prototype,
            value,
            awaited,
            depth,
        ) {
            Ok(value) => value,
            Err(error) => promise::Promise::rejected(queue, error),
        },
        None => promise::Promise::rejected(
            queue,
            promise::PromiseFailure::TypeError("async generator state is unavailable"),
        ),
    }
}

fn async_generator_update_roots(
    context: vm::Context,
    generator: runtime::Value,
    state: AsyncGeneratorState,
) -> () {
    let roots: Vec[runtime::Value] = Vec::new();
    let mut request_index = 0;
    while request_index < state.requests.len() {
        match state.requests.get(request_index) {
            Some(request) => {
                roots.push(request.value);
                roots.push(request.promise_value)
            },
            None => (),
        }
        request_index += 1;
    }
    context.set_generator_request_roots(generator, roots)
}

fn async_generator_iteration_result(heap: runtime::Heap, value: runtime::Value, done: bool) -> Result[
    runtime::Value,
    promise::PromiseFailure,
] {
    let object = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(error) => return Result::Err(promise::PromiseFailure::TypeError(error.message)),
    };
    match define_data(heap, object, runtime::string_property_key("value"), value, true, true, true) {
        Ok(()) => (),
        Err(error) => return Result::Err(promise::PromiseFailure::TypeError(error.message)),
    }
    match define_data(
        heap,
        object,
        runtime::string_property_key("done"),
        runtime::Value::Bool(done),
        true,
        true,
        true,
    ) {
        Ok(()) => Result::Ok(runtime::Value::Object(object)),
        Err(error) => Result::Err(promise::PromiseFailure::TypeError(error.message)),
    }
}

fn async_generator_process(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
) -> () {
    let object = match generator {
        runtime::Value::Object(value) => value,
        _ => return,
    };
    let state = match generators.get(object) {
        Some(value) => value,
        None => return,
    };
    if state.running.get() || state.requests.is_empty() {
        return
    }
    state.running.set(true);
    let request = match state.requests.front() {
        Some(value) => value,
        None => return,
    };
    match request.kind {
        AsyncGeneratorRequestKind::Return => async_generator_await_resume(
            context,
            promise_states,
            queue,
            promise_prototype,
            generators,
            generator,
            request,
            request.value,
            AsyncGeneratorRequestKind::Return,
        ),
        kind => async_generator_resume(
            context,
            promise_states,
            queue,
            promise_prototype,
            generators,
            generator,
            request,
            kind,
            request.value,
        ),
    }
}

fn async_generator_finish(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
) -> () {
    let object = match generator {
        runtime::Value::Object(value) => value,
        _ => return,
    };
    match generators.get(object) {
        Some(state) => {
            if !state.requests.is_empty() {
                let _ = state.requests.pop_front();
            }
            state.running.set(false);
            async_generator_update_roots(context, generator, state);
            if state.requests.is_empty() {
                context.release_async_function(generator)
            }
            async_generator_process(
                context,
                promise_states,
                queue,
                promise_prototype,
                generators,
                generator,
            )
        },
        None => (),
    }
}

fn async_generator_reject(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
    request: AsyncGeneratorRequest,
    failure: promise::PromiseFailure,
) -> () {
    let _ = request.capability.reject(failure);
    async_generator_finish(context, promise_states, queue, promise_prototype, generators, generator)
}

fn async_generator_resolve(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
    request: AsyncGeneratorRequest,
    value: runtime::Value,
    done: bool,
) -> () {
    match async_generator_iteration_result(context.heap(), value, done) {
        Ok(result) => {
            let _ = request.capability.resolve(promise::value(result));
        },
        Err(error) => {
            let _ = request.capability.reject(error);
        },
    }
    async_generator_finish(context, promise_states, queue, promise_prototype, generators, generator)
}

fn async_generator_await_resume(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
    request: AsyncGeneratorRequest,
    awaited: runtime::Value,
    fulfilled_kind: AsyncGeneratorRequestKind,
) -> () {
    let promise = async_generator_awaited_promise(
        context,
        promise_states,
        queue,
        promise_prototype,
        generators,
        generator,
        awaited,
        request.depth,
    );
    let on_fulfilled: Option[
        (promise::PromiseFulfillment) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |fulfillment| {
            match promise_object_fulfillment_value(context.heap(), fulfillment) {
                Ok(value) => async_generator_resume(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    fulfilled_kind,
                    value,
                ),
                Err(error) => async_generator_reject(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    promise::PromiseFailure::TypeError(error.message),
                ),
            }
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let on_rejected: Option[
        (promise::PromiseFailure) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |failure| {
            match promise_object_failure_value_with_context(context, failure) {
                Ok(value) => async_generator_resume(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    AsyncGeneratorRequestKind::Throw,
                    value,
                ),
                Err(error) => async_generator_reject(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    promise::PromiseFailure::TypeError(error.message),
                ),
            }
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let _ = promise.then_with_roots(
        on_fulfilled,
        on_rejected,
        Vec::from_array([generator, request.value, request.promise_value]),
    );
}

fn async_generator_await_yield(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
    request: AsyncGeneratorRequest,
    yielded: runtime::Value,
) -> () {
    let promise = async_generator_awaited_promise(
        context,
        promise_states,
        queue,
        promise_prototype,
        generators,
        generator,
        yielded,
        request.depth,
    );
    let on_fulfilled: Option[
        (promise::PromiseFulfillment) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |fulfillment| {
            match promise_object_fulfillment_value(context.heap(), fulfillment) {
                Ok(value) => async_generator_resolve(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    value,
                    false,
                ),
                Err(error) => async_generator_reject(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    promise::PromiseFailure::TypeError(error.message),
                ),
            }
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let on_rejected: Option[
        (promise::PromiseFailure) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |failure| {
            match promise_object_failure_value_with_context(context, failure) {
                Ok(value) => async_generator_resume(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    AsyncGeneratorRequestKind::Throw,
                    value,
                ),
                Err(error) => async_generator_reject(
                    context,
                    promise_states,
                    queue,
                    promise_prototype,
                    generators,
                    generator,
                    request,
                    promise::PromiseFailure::TypeError(error.message),
                ),
            }
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let _ = promise.then_with_roots(
        on_fulfilled,
        on_rejected,
        Vec::from_array([generator, request.value, request.promise_value]),
    );
}

fn async_generator_resume(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
    request: AsyncGeneratorRequest,
    kind: AsyncGeneratorRequestKind,
    input: runtime::Value,
) -> () {
    let result = match kind {
        AsyncGeneratorRequestKind::Next => {
            context.resume_generator_raw_at_depth(generator, input, request.depth)
        },
        AsyncGeneratorRequestKind::Throw => {
            context.throw_generator_raw_at_depth(generator, input, request.depth)
        },
        AsyncGeneratorRequestKind::Return => {
            context.return_generator_raw_at_depth(generator, input, request.depth)
        },
    };
    match result {
        Ok(vm::GeneratorCompletion::Await(value)) => async_generator_await_resume(
            context,
            promise_states,
            queue,
            promise_prototype,
            generators,
            generator,
            request,
            value,
            AsyncGeneratorRequestKind::Next,
        ),
        Ok(vm::GeneratorCompletion::Yield(value)) => async_generator_await_yield(
            context,
            promise_states,
            queue,
            promise_prototype,
            generators,
            generator,
            request,
            value,
        ),
        Ok(vm::GeneratorCompletion::YieldRaw(value)) => async_generator_resolve(
            context,
            promise_states,
            queue,
            promise_prototype,
            generators,
            generator,
            request,
            value,
            false,
        ),
        Ok(vm::GeneratorCompletion::Return(value)) => async_generator_resolve(
            context,
            promise_states,
            queue,
            promise_prototype,
            generators,
            generator,
            request,
            value,
            true,
        ),
        Err(error) => async_generator_reject(
            context,
            promise_states,
            queue,
            promise_prototype,
            generators,
            generator,
            request,
            promise_object_vm_failure(error),
        ),
    }
}

fn async_generator_enqueue(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    generator: runtime::Value,
    value: runtime::Value,
    kind: AsyncGeneratorRequestKind,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let capability = promise::PromiseCapability::new(queue);
    let promise_value = match promise_object_wrap(
        context.heap(),
        promise_states,
        promise_prototype,
        capability.promise(),
    ) {
        Ok(value) => value,
        Err(error) => return Result::Err(
            vm::VmError { offset: -1, kind: vm::VmErrorKind::TypeError(error.message) },
        ),
    };
    let object = match generator {
        runtime::Value::Object(value) => value,
        _ => {
            let _ = capability.reject(
                promise::PromiseFailure::TypeError("async generator receiver is incompatible"),
            );
            return Result::Ok(promise_value)
        },
    };
    match generators.get(object) {
        Some(state) => {
            state.requests.push_back(
                AsyncGeneratorRequest { kind, value, capability, promise_value, depth },
            );
            match context.link_async_function(promise_value, generator) {
                Ok(()) => (),
                Err(error) => {
                    let _ = capability.reject(promise_object_vm_failure(error));
                    let _ = state.requests.pop_back();
                    return Result::Ok(promise_value)
                },
            }
            async_generator_update_roots(context, generator, state);
            async_generator_process(
                context,
                promise_states,
                queue,
                promise_prototype,
                generators,
                generator,
            );
        },
        None => {
            let _ = capability.reject(
                promise::PromiseFailure::TypeError("async generator receiver is incompatible"),
            );
        },
    }
    Result::Ok(promise_value)
}

fn async_generator_runner(
    generators: HashMap[runtime::ObjectId, AsyncGeneratorState],
    promise_constructor: Ref[runtime::Value],
    generator: runtime::Value,
) -> Result[runtime::Value, vm::VmError] {
    match generator {
        runtime::Value::Object(value) => {
            generators[value] = AsyncGeneratorState {
                requests: collections::Deque::new(),
                running: Ref::new(false),
                promise_constructor,
            };
            Result::Ok(generator)
        },
        _ => Result::Err(
            vm::VmError {
                offset: -1,
                kind: vm::VmErrorKind::TypeError("async generator frame is not an object"),
            },
        ),
    }
}

fn promise_object_resolvers(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    prototype: runtime::ObjectId,
    capability: promise::PromiseCapability,
) -> Result[(runtime::Value, runtime::Value), vm::NativeError] {
    let resolve = promise_object_new_native(
        context,
        |heap, _, arguments| {
            promise_object_resolve_capability(
                context,
                heap,
                states,
                prototype,
                capability,
                argument(arguments, 0),
            );
            Result::Ok(runtime::Value::Undefined)
        },
    )?;
    let reject = promise_object_new_native(
        context,
        |_, _, arguments| promise_object_reject_capability(capability, arguments),
    )?;
    Result::Ok((resolve, reject))
}

fn promise_object_host_capability(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    prototype: runtime::ObjectId,
) -> Result[vm::HostPromiseCapability, vm::VmError] {
    let capability = promise::PromiseCapability::new(queue);
    let promise = match promise_object_wrap(context.heap(), states, prototype, capability.promise()) {
        Ok(value) => value,
        Err(error) => return Result::Err(
            vm::VmError { offset: -1, kind: vm::VmErrorKind::TypeError(error.message) },
        ),
    };
    let (resolve, reject) = match promise_object_resolvers(context, states, prototype, capability) {
        Ok(value) => value,
        Err(error) => return Result::Err(
            vm::VmError { offset: -1, kind: vm::VmErrorKind::TypeError(error.message) },
        ),
    };
    Result::Ok(vm::HostPromiseCapability::new(promise, resolve, reject))
}

fn promise_object_construct(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    prototype: runtime::ObjectId,
    receiver: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    selected_prototype: Option[runtime::ObjectId],
) -> Result[runtime::Value, vm::VmError] {
    constructor_receiver_prototype(context.heap(), receiver, selected_prototype, prototype)?;
    let capability = promise::PromiseCapability::new(queue);
    let instance = capability.promise();
    instance.bind_host_object(receiver);
    states[receiver] = instance;
    let (resolve, reject) = match promise_object_resolvers(context, states, prototype, capability) {
        Ok(value) => value,
        Err(error) => return Result::Err(function_vm_error(error.message)),
    };
    match promise_object_invoke(context, argument(arguments, 0), Vec::from_array([resolve, reject])) {
        Ok(_) => (),
        Err(error) => {
            let _ = capability.reject(promise_object_vm_failure(error));
        },
    }
    Result::Ok(runtime::Value::Object(receiver))
}

fn promise_object_prepare_constructor(arguments: Vec[runtime::Value], depth: isize) -> Result[
    Vec[runtime::Value],
    vm::VmError,
] {
    let _ = depth;
    if promise_object_callable(argument(arguments, 0)) {
        Result::Ok(arguments)
    } else {
        Result::Err(function_vm_error("Promise executor is not callable"))
    }
}

fn promise_object_species_constructor(
    context: vm::Context,
    value: runtime::Value,
    default_constructor: runtime::Value,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let constructor = context.read_property_at_depth(
        value,
        runtime::Value::String(js_string("constructor")),
        depth,
    )?;
    match constructor {
        runtime::Value::Undefined => return Result::Ok(default_constructor),
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("Promise constructor property is not an object")),
    }
    let symbol = match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(value) => value,
        None => return Result::Ok(default_constructor),
    };
    let species = context.read_property_at_depth(constructor, runtime::Value::Symbol(symbol), depth)?;
    match species {
        runtime::Value::Undefined | runtime::Value::Null => Result::Ok(default_constructor),
        _ => if vm::is_constructor(context, species) {
            Result::Ok(species)
        } else {
            Result::Err(function_vm_error("Promise species is not a constructor"))
        },
    }
}

fn promise_object_reaction_result() -> Result[promise::PromiseResolution, promise::PromiseFailure] {
    Result::Ok(promise::value(runtime::Value::Undefined))
}

fn promise_object_resolve_reaction(
    context: vm::Context,
    capability: PromiseObjectCapability,
    handler: runtime::Value,
    fulfillment: promise::PromiseFulfillment,
) -> Result[promise::PromiseResolution, promise::PromiseFailure] {
    let value = match promise_object_fulfillment_value(context.heap(), fulfillment) {
        Ok(value) => value,
        Err(error) => {
            let _ = promise_object_invoke_capability(
                context,
                capability.reject,
                context.rejection_value(function_vm_error(error.message)),
                0,
            );
            return promise_object_reaction_result()
        },
    };
    if promise_object_callable(handler) {
        match context.invoke_with_this_at_depth(
            handler,
            Vec::from_array([value]),
            runtime::Value::Undefined,
            0,
        ) {
            Ok(result) => {
                let _ = promise_object_invoke_capability(context, capability.resolve, result, 0);
            },
            Err(error) => {
                let _ = promise_object_invoke_capability(
                    context,
                    capability.reject,
                    context.rejection_value(error),
                    0,
                );
            },
        }
    } else {
        let _ = promise_object_invoke_capability(context, capability.resolve, value, 0);
    }
    promise_object_reaction_result()
}

fn promise_object_reject_reaction(
    context: vm::Context,
    capability: PromiseObjectCapability,
    handler: runtime::Value,
    failure: promise::PromiseFailure,
) -> Result[promise::PromiseResolution, promise::PromiseFailure] {
    let value = match promise_object_failure_value_with_context(context, failure) {
        Ok(value) => value,
        Err(error) => context.rejection_value(function_vm_error(error.message)),
    };
    if promise_object_callable(handler) {
        match context.invoke_with_this_at_depth(
            handler,
            Vec::from_array([value]),
            runtime::Value::Undefined,
            0,
        ) {
            Ok(result) => {
                let _ = promise_object_invoke_capability(context, capability.resolve, result, 0);
            },
            Err(error) => {
                let _ = promise_object_invoke_capability(
                    context,
                    capability.reject,
                    context.rejection_value(error),
                    0,
                );
            },
        }
    } else {
        let _ = promise_object_invoke_capability(context, capability.reject, value, 0);
    }
    promise_object_reaction_result()
}

fn promise_object_then(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    constructor: Ref[runtime::Value],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source = match promise_object_state(states, this_value) {
        Ok(value) => value,
        Err(error) => return Result::Err(function_vm_error(error.message)),
    };
    let species = promise_object_species_constructor(context, this_value, constructor.get(), depth)?;
    let capability = promise_object_new_capability(context, species, depth)?;
    let fulfill_value = argument(arguments, 0);
    let reject_value = argument(arguments, 1);
    let on_fulfilled: Option[
        (promise::PromiseFulfillment) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |fulfillment| {
            promise_object_resolve_reaction(context, capability, fulfill_value, fulfillment)
        },
    );
    let on_rejected: Option[
        (promise::PromiseFailure) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |failure| promise_object_reject_reaction(context, capability, reject_value, failure),
    );
    let _ = source.then_with_roots(
        on_fulfilled,
        on_rejected,
        Vec::from_array(
            [fulfill_value, reject_value, capability.promise, capability.resolve, capability.reject],
        ),
    );
    Result::Ok(capability.promise)
}

fn promise_object_catch(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let then = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("then")),
        depth,
    )?;
    context.invoke_with_this_at_depth(
        then,
        Vec::from_array([runtime::Value::Undefined, argument(arguments, 0)]),
        this_value,
        depth,
    )
}

fn promise_object_finally_value_thunk(
    context: vm::Context,
    value: runtime::Value,
    throw_value: bool,
) -> Result[runtime::Value, vm::VmError] {
    match allocate_vm_function_with_length(
        context,
        "",
        0,
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            if throw_value {
                Result::Err(vm::VmError { offset: -1, kind: vm::VmErrorKind::Thrown(value) })
            } else {
                Result::Ok(value)
            }
        },
    ) {
        Ok(value) => Result::Ok(value),
        Err(error) => Result::Err(function_vm_error(error.message)),
    }
}

fn promise_object_finally_callback(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    constructor: runtime::Value,
    on_finally: runtime::Value,
    value: runtime::Value,
    throw_value: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = context.invoke_with_this_at_depth(
        on_finally,
        Vec::new(),
        runtime::Value::Undefined,
        depth,
    )?;
    let resolved = promise_object_static_resolve(
        context,
        states,
        constructor,
        Vec::from_array([result]),
        depth,
    )?;
    let then = context.read_property_at_depth(
        resolved,
        runtime::Value::String(js_string("then")),
        depth,
    )?;
    context.invoke_with_this_at_depth(
        then,
        Vec::from_array([promise_object_finally_value_thunk(context, value, throw_value)?]),
        resolved,
        depth,
    )
}

fn promise_object_finally(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    constructor: Ref[runtime::Value],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match this_value {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("Promise.finally receiver is not an object")),
    }
    let species = promise_object_species_constructor(context, this_value, constructor.get(), depth)?;
    let handler_value = argument(arguments, 0);
    let (then_finally, catch_finally) = if promise_object_callable(handler_value) {
        let fulfilled = match allocate_vm_function_with_length(
            context,
            "",
            1,
            |this_value, callback_arguments, callback_depth| {
                let _ = this_value;
                promise_object_finally_callback(
                    context,
                    states,
                    species,
                    handler_value,
                    argument(callback_arguments, 0),
                    false,
                    callback_depth,
                )
            },
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(function_vm_error(error.message)),
        };
        let rejected = match allocate_vm_function_with_length(
            context,
            "",
            1,
            |this_value, callback_arguments, callback_depth| {
                let _ = this_value;
                promise_object_finally_callback(
                    context,
                    states,
                    species,
                    handler_value,
                    argument(callback_arguments, 0),
                    true,
                    callback_depth,
                )
            },
        ) {
            Ok(value) => value,
            Err(error) => return Result::Err(function_vm_error(error.message)),
        };
        (fulfilled, rejected)
    } else {
        (handler_value, handler_value)
    };
    let then = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("then")),
        depth,
    )?;
    context.invoke_with_this_at_depth(
        then,
        Vec::from_array([then_finally, catch_finally]),
        this_value,
        depth,
    )
}

fn promise_object_static_resolve(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    if !vm::is_constructor(context, this_value) {
        return Result::Err(function_vm_error("Promise.resolve receiver is not a constructor"))
    }
    let input = argument(arguments, 0);
    match input {
        runtime::Value::Object(object) => match states.get(object) {
            Some(_) => {
                let constructor = context.read_property_at_depth(
                    input,
                    runtime::Value::String(js_string("constructor")),
                    depth,
                )?;
                if runtime::same_value(constructor, this_value) {
                    return Result::Ok(input)
                }
            },
            None => (),
        },
        _ => (),
    }
    let capability = promise_object_new_capability(context, this_value, depth)?;
    promise_object_invoke_capability(context, capability.resolve, input, depth)?;
    Result::Ok(capability.promise)
}

fn promise_object_static_reject(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let capability = promise_object_new_capability(context, this_value, depth)?;
    promise_object_invoke_capability(context, capability.reject, argument(arguments, 0), depth)?;
    Result::Ok(capability.promise)
}

fn promise_object_iterator_record(context: vm::Context, input: runtime::Value) -> Result[
    IteratorRecord,
    vm::VmError,
] {
    let symbol = match context.iterator_symbol() {
        Some(value) => value,
        None => return Result::Err(function_vm_error("iterator symbol is not installed")),
    };
    let method = context.read_property_at_depth(input, runtime::Value::Symbol(symbol), 0)?;
    let callable = iterator_callable(method, "Promise combinator input is not iterable")?;
    let arguments: Vec[runtime::Value] = Vec::new();
    let iterator = context.invoke_with_this_at_depth(callable, arguments, input, 0)?;
    match iterator {
        runtime::Value::Object(_) => iterator_record(context, iterator, 0),
        _ => Result::Err(function_vm_error("iterator result is not an object")),
    }
}

fn promise_object_all_array(heap: runtime::Heap, values: Vec[Option[runtime::Value]]) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let output: Vec[runtime::Value] = Vec::with_capacity(values.len());
    for value in values {
        match value {
            Some(value) => output.push(value),
            None => output.push(runtime::Value::Undefined),
        }
    }
    match allocate_array(heap, output, output.len()) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(error) => Result::Err(function_vm_error(error.message)),
    }
}

fn promise_object_combinator_reject(
    context: vm::Context,
    capability: PromiseObjectCapability,
    error: vm::VmError,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    promise_object_invoke_capability(
        context,
        capability.reject,
        context.rejection_value(error),
        depth,
    )?;
    Result::Ok(capability.promise)
}

fn promise_object_static_all(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let capability = promise_object_new_capability(context, this_value, depth)?;
    let promise_resolve = match context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("resolve")),
        depth,
    ) {
        Ok(value) => if promise_object_callable(value) {
            value
        } else {
            return promise_object_combinator_reject(
                context,
                capability,
                function_vm_error("Promise.all resolve is not callable"),
                depth,
            )
        },
        Err(error) => return promise_object_combinator_reject(context, capability, error, depth),
    };
    let iterator = match promise_object_iterator_record(context, argument(arguments, 0)) {
        Ok(value) => value,
        Err(error) => return promise_object_combinator_reject(context, capability, error, depth),
    };
    let values: Vec[Option[runtime::Value]] = Vec::new();
    let remaining = Ref::new(1);
    loop {
        let next_value = match iterator_step(context, iterator, depth) {
            Ok(Some(value)) => value,
            Ok(None) => {
                remaining.set(remaining.get() - 1);
                if remaining.get() == 0 {
                    let result = promise_object_all_array(context.heap(), values)?;
                    match promise_object_invoke_capability(
                        context,
                        capability.resolve,
                        result,
                        depth,
                    ) {
                        Ok(()) => (),
                        Err(error) => {
                            return promise_object_combinator_reject(
                                context,
                                capability,
                                error,
                                depth,
                            )
                        },
                    }
                }
                return Result::Ok(capability.promise)
            },
            Err(error) => {
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        let next_promise = match context.invoke_with_this_at_depth(
            promise_resolve,
            Vec::from_array([next_value]),
            this_value,
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        let index = values.len();
        values.push(Option::None);
        remaining.set(remaining.get() + 1);
        let already_called = Ref::new(false);
        let resolve_element = match allocate_vm_function_with_length(
            context,
            "",
            1,
            |this_value, element_arguments, element_depth| {
                let _ = this_value;
                if already_called.get() {
                    return Result::Ok(runtime::Value::Undefined)
                }
                already_called.set(true);
                values[index] = Option::Some(argument(element_arguments, 0));
                remaining.set(remaining.get() - 1);
                if remaining.get() == 0 {
                    promise_object_invoke_capability(
                        context,
                        capability.resolve,
                        promise_object_all_array(context.heap(), values)?,
                        element_depth,
                    )?
                }
                Result::Ok(runtime::Value::Undefined)
            },
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(
                    context,
                    capability,
                    function_vm_error(error.message),
                    depth,
                )
            },
        };
        let then = match context.read_property_at_depth(
            next_promise,
            runtime::Value::String(js_string("then")),
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        match context.invoke_with_this_at_depth(
            then,
            Vec::from_array([resolve_element, capability.reject]),
            next_promise,
            depth,
        ) {
            Ok(_) => (),
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        }
    }
}

fn promise_object_static_race(
