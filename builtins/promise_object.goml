fn promise_object_settled_result(heap: runtime::Heap, fulfilled: bool, value: runtime::Value) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let object = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(error) => return Result::Err(function_vm_error(error.message)),
    };
    let status = if fulfilled {
        "fulfilled"
    } else {
        "rejected"
    };
    let key = if fulfilled {
        "value"
    } else {
        "reason"
    };
    if !runtime::define_own_property(
        heap,
        object,
        runtime::string_property_key("status"),
        runtime::data_descriptor(runtime::Value::String(js_string(status)), true, true, true),
    )
        || !runtime::define_own_property(
            heap,
            object,
            runtime::string_property_key(key),
            runtime::data_descriptor(value, true, true, true),
        ) {
        Result::Err(function_vm_error("cannot create Promise.allSettled result"))
    } else {
        Result::Ok(runtime::Value::Object(object))
    }
}

fn promise_object_static_all_settled(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let capability = promise_object_new_capability(context, this_value, depth)?;
    let promise_resolve = match context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("resolve")),
