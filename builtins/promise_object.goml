        },
    };
    let values: Vec[Option[runtime::Value]] = Vec::new();
    let remaining = Ref::new(1);
    loop {
        let next_value = match iterator_step(context, iterator, depth) {
            Ok(Some(value)) => value,
            Ok(None) => {
                remaining.set(remaining.get() - 1);
                if remaining.get() == 0 {
                    match promise_object_invoke_capability(
                        context,
                        capability.resolve,
                        promise_object_all_array(context.heap(), values)?,
                        depth,
                    ) {
                        Ok(()) => (),
                        Err(error) => {
                            return promise_object_combinator_reject(
                                context,
                                capability,
                                error,
                                depth,
                            )
                        },
                    }
                }
                return Result::Ok(capability.promise)
            },
            Err(error) => {
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        let next_promise = match context.invoke_with_this_at_depth(
            promise_resolve,
            Vec::from_array([next_value]),
            this_value,
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        let index = values.len();
        values.push(Option::None);
        remaining.set(remaining.get() + 1);
        let already_called = Ref::new(false);
        let on_fulfilled = match allocate_vm_function_with_length(
            context,
            "",
            1,
            |this_value, element_arguments, element_depth| {
                let _ = this_value;
                if already_called.get() {
                    return Result::Ok(runtime::Value::Undefined)
                }
                already_called.set(true);
                values[index] = Option::Some(
                    promise_object_settled_result(
                        context.heap(),
                        true,
                        argument(element_arguments, 0),
                    )?,
                );
                remaining.set(remaining.get() - 1);
                if remaining.get() == 0 {
                    promise_object_invoke_capability(
                        context,
                        capability.resolve,
                        promise_object_all_array(context.heap(), values)?,
                        element_depth,
                    )?
                }
                Result::Ok(runtime::Value::Undefined)
            },
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(
                    context,
                    capability,
                    function_vm_error(error.message),
                    depth,
                )
            },
        };
        let on_rejected = match allocate_vm_function_with_length(
            context,
            "",
            1,
            |this_value, element_arguments, element_depth| {
                let _ = this_value;
                if already_called.get() {
                    return Result::Ok(runtime::Value::Undefined)
                }
                already_called.set(true);
                values[index] = Option::Some(
                    promise_object_settled_result(
                        context.heap(),
                        false,
                        argument(element_arguments, 0),
                    )?,
                );
                remaining.set(remaining.get() - 1);
                if remaining.get() == 0 {
                    promise_object_invoke_capability(
                        context,
                        capability.resolve,
                        promise_object_all_array(context.heap(), values)?,
                        element_depth,
                    )?
                }
                Result::Ok(runtime::Value::Undefined)
            },
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(
                    context,
                    capability,
                    function_vm_error(error.message),
                    depth,
                )
            },
        };
        let then = match context.read_property_at_depth(
            next_promise,
            runtime::Value::String(js_string("then")),
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        match context.invoke_with_this_at_depth(
            then,
            Vec::from_array([on_fulfilled, on_rejected]),
            next_promise,
            depth,
        ) {
            Ok(_) => (),
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        }
    }
}

fn promise_object_any_error(
    context: vm::Context,
    aggregate_error_constructor: Option[runtime::Value],
    values: Vec[Option[runtime::Value]],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let errors = promise_object_all_array(context.heap(), values)?;
    match aggregate_error_constructor {
        Some(constructor) => context.construct_with_new_target_at_depth(
            constructor,
            Vec::from_array([errors]),
            constructor,
            depth,
        ),
        None => {
            let object = match allocate_ordinary(context.heap(), context.heap().object_prototype()) {
                Ok(value) => value,
                Err(error) => return Result::Err(function_vm_error(error.message)),
            };
            if !runtime::define_own_property(
                context.heap(),
                object,
                runtime::string_property_key("name"),
                runtime::data_descriptor(
                    runtime::Value::String(js_string("AggregateError")),
                    true,
                    false,
                    true,
                ),
            )
                || !runtime::define_own_property(
                    context.heap(),
                    object,
                    runtime::string_property_key("message"),
                    runtime::data_descriptor(
                        runtime::Value::String(js_string("All promises were rejected")),
                        true,
                        false,
                        true,
                    ),
                )
                || !runtime::define_own_property(
                    context.heap(),
                    object,
                    runtime::string_property_key("errors"),
                    runtime::data_descriptor(errors, true, false, true),
                ) {
                Result::Err(function_vm_error("cannot create Promise.any AggregateError"))
            } else {
                Result::Ok(runtime::Value::Object(object))
            }
        },
    }
}

fn promise_object_static_any(
    context: vm::Context,
    aggregate_error_constructor: Option[runtime::Value],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let capability = promise_object_new_capability(context, this_value, depth)?;
    let promise_resolve = match context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("resolve")),
        depth,
    ) {
        Ok(value) => if promise_object_callable(value) {
            value
        } else {
            return promise_object_combinator_reject(
                context,
                capability,
                function_vm_error("Promise.any resolve is not callable"),
                depth,
            )
        },
        Err(error) => {
            return promise_object_combinator_reject(context, capability, error, depth)
        },
    };
    let iterator = match promise_object_iterator_record(context, argument(arguments, 0)) {
        Ok(value) => value,
        Err(error) => {
            return promise_object_combinator_reject(context, capability, error, depth)
        },
    };
    let values: Vec[Option[runtime::Value]] = Vec::new();
    let remaining = Ref::new(1);
    loop {
        let next_value = match iterator_step(context, iterator, depth) {
            Ok(Some(value)) => value,
            Ok(None) => {
                remaining.set(remaining.get() - 1);
                if remaining.get() == 0 {
                    match promise_object_invoke_capability(
                        context,
                        capability.reject,
                        promise_object_any_error(
                            context,
                            aggregate_error_constructor,
                            values,
                            depth,
                        )?,
                        depth,
                    ) {
                        Ok(()) => (),
                        Err(error) => {
                            return promise_object_combinator_reject(
                                context,
                                capability,
                                error,
                                depth,
                            )
                        },
                    }
                }
                return Result::Ok(capability.promise)
            },
            Err(error) => {
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        let next_promise = match context.invoke_with_this_at_depth(
            promise_resolve,
            Vec::from_array([next_value]),
            this_value,
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        let index = values.len();
        values.push(Option::None);
        remaining.set(remaining.get() + 1);
        let already_called = Ref::new(false);
        let on_rejected = match allocate_vm_function_with_length(
            context,
            "",
            1,
            |this_value, element_arguments, element_depth| {
                let _ = this_value;
                if already_called.get() {
                    return Result::Ok(runtime::Value::Undefined)
                }
                already_called.set(true);
                values[index] = Option::Some(argument(element_arguments, 0));
                remaining.set(remaining.get() - 1);
                if remaining.get() == 0 {
                    promise_object_invoke_capability(
                        context,
                        capability.reject,
                        promise_object_any_error(
                            context,
                            aggregate_error_constructor,
                            values,
                            element_depth,
                        )?,
                        element_depth,
                    )?
                }
                Result::Ok(runtime::Value::Undefined)
            },
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(
                    context,
                    capability,
                    function_vm_error(error.message),
                    depth,
                )
            },
        };
        let then = match context.read_property_at_depth(
            next_promise,
            runtime::Value::String(js_string("then")),
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        };
        match context.invoke_with_this_at_depth(
            then,
            Vec::from_array([capability.resolve, on_rejected]),
            next_promise,
            depth,
        ) {
            Ok(_) => (),
            Err(error) => {
                iterator_close_after_error(context, iterator, depth);
                return promise_object_combinator_reject(context, capability, error, depth)
            },
        }
    }
}

fn promise_object_static_try(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let capability = promise_object_new_capability(context, this_value, depth)?;
    let callback = argument(arguments, 0);
    let callback_arguments: Vec[runtime::Value] = Vec::new();
    let mut index = 1;
    while index < arguments.len() {
        callback_arguments.push(arguments[index]);
        index += 1;
    }
    match context.invoke_with_this_at_depth(
        callback,
        callback_arguments,
        runtime::Value::Undefined,
        depth,
    ) {
        Ok(value) => {
            promise_object_invoke_capability(context, capability.resolve, value, depth)?
        },
        Err(error) => {
            promise_object_invoke_capability(
                context,
                capability.reject,
                context.rejection_value(error),
                depth,
            )?
        },
    }
    Result::Ok(capability.promise)
}

fn promise_object_with_resolvers(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let capability = promise_object_new_capability(context, this_value, depth)?;
    let result = match allocate_ordinary(context.heap(), Option::None) {
        Ok(value) => value,
        Err(error) => return Result::Err(function_vm_error(error.message)),
    };
    if !runtime::define_own_property(
        context.heap(),
        result,
        runtime::string_property_key("promise"),
        runtime::data_descriptor(capability.promise, true, true, true),
    )
        || !runtime::define_own_property(
            context.heap(),
            result,
            runtime::string_property_key("resolve"),
            runtime::data_descriptor(capability.resolve, true, true, true),
        )
        || !runtime::define_own_property(
            context.heap(),
            result,
            runtime::string_property_key("reject"),
            runtime::data_descriptor(capability.reject, true, true, true),
        ) {
        return Result::Err(function_vm_error("cannot create Promise.withResolvers result"))
    }
    Result::Ok(runtime::Value::Object(result))
}

fn promise_object_drain(
    queue: promise::JobQueue,
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let _ = arguments;
    Result::Ok(array_length_value(queue.run_all()))
}

#[derive(PartialEq, Eq)]
enum AsyncFromSyncOperation {
    Next,
    Throw,
    Return,
}

struct AsyncFromSyncIteratorState {
    iterator: runtime::Value,
    next: runtime::Value,
}

fn async_from_sync_gc_edges(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, AsyncFromSyncIteratorState],
) -> Vec[runtime::GcEdge] {
    let edges: Vec[runtime::GcEdge] = Vec::new();
    let stale: Vec[runtime::ObjectId] = Vec::new();
    for (object, state) in states.entries() {
        if heap.contains(object) {
            edges.push(
                runtime::GcEdge {
                    owner: object,
                    values: Vec::from_array([state.iterator, state.next]),
                },
            )
        } else {
            stale.push(object)
        }
    }
    for object in stale {
        let _ = states.remove(object);
    }
    edges
}

fn async_from_sync_state(
    states: HashMap[runtime::ObjectId, AsyncFromSyncIteratorState],
    value: runtime::Value,
) -> Result[AsyncFromSyncIteratorState, promise::PromiseFailure] {
    match value {
        runtime::Value::Object(object) => match states.get(object) {
            Some(state) => Result::Ok(state),
            None => Result::Err(
                promise::PromiseFailure::TypeError(
                    "Async-from-Sync Iterator method called on incompatible receiver",
                ),
            ),
        },
        _ => Result::Err(
            promise::PromiseFailure::TypeError(
                "Async-from-Sync Iterator method called on incompatible receiver",
            ),
        ),
    }
}

fn async_from_sync_capability(
    heap: runtime::Heap,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
) -> Result[(promise::PromiseCapability, runtime::Value), vm::VmError] {
    let capability = promise::PromiseCapability::new(queue);
    match promise_object_wrap(heap, promise_states, promise_prototype, capability.promise()) {
        Ok(value) => Result::Ok((capability, value)),
        Err(error) => Result::Err(function_vm_error(error.message)),
    }
}

fn async_from_sync_reject(capability: promise::PromiseCapability, failure: promise::PromiseFailure) -> () {
    let _ = capability.reject(failure);
}

fn async_from_sync_reject_vm(
    context: vm::Context,
    capability: promise::PromiseCapability,
    error: vm::VmError,
) -> () {
    async_from_sync_reject(
        capability,
        promise::PromiseFailure::Rejection(context.rejection_value(error)),
    )
}

fn async_from_sync_method_missing(value: runtime::Value) -> bool {
    match value {
        runtime::Value::Undefined | runtime::Value::Null => true,
        _ => false,
    }
}

fn async_from_sync_close(context: vm::Context, iterator: runtime::Value, depth: isize) -> () {
    let method = match context.read_property_at_depth(
        iterator,
        runtime::Value::String(js_string("return")),
        depth,
    ) {
        Ok(value) => value,
        Err(_) => return,
    };
    if async_from_sync_method_missing(method) {
        return
    }
    if !promise_object_callable(method) {
        return
    }
    let _ = match context.invoke_with_this_at_depth(method, Vec::new(), iterator, depth) {
        Ok(value) => value,
        Err(_) => return,
    };
}

fn async_from_sync_resolve_result(
    context: vm::Context,
    capability: promise::PromiseCapability,
    value: runtime::Value,
    done: bool,
) -> () {
    match async_generator_iteration_result(context.heap(), value, done) {
        Ok(result) => {
            let _ = capability.resolve(promise::value(result));
        },
        Err(error) => async_from_sync_reject(capability, error),
    }
}

fn async_from_sync_settle(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    promise_constructor: Ref[runtime::Value],
    capability: promise::PromiseCapability,
    value: runtime::Value,
    done: bool,
    close_on_rejection: bool,
    iterator: runtime::Value,
    depth: isize,
    roots: Vec[runtime::Value],
) -> () {
    let awaited = match promise_object_awaited_promise(
        context,
        promise_states,
        queue,
        promise_prototype,
        promise_constructor,
        value,
        depth,
    ) {
        Ok(value) => value,
        Err(error) => {
            if close_on_rejection {
                async_from_sync_close(context, iterator, depth)
            }
            async_from_sync_reject(capability, error);
            return
        },
    };
    let on_fulfilled: Option[
        (promise::PromiseFulfillment) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |fulfillment| {
            let value = match promise_object_fulfillment_value(context.heap(), fulfillment) {
                Ok(value) => value,
                Err(error) => {
                    async_from_sync_reject(
                        capability,
                        promise::PromiseFailure::TypeError(error.message),
                    );
                    return Result::Ok(promise::value(runtime::Value::Undefined))
                },
            };
            match async_generator_iteration_result(context.heap(), value, done) {
                Ok(result) => {
                    let _ = capability.resolve(promise::value(result));
                },
                Err(error) => async_from_sync_reject(capability, error),
            }
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let on_rejected: Option[
        (promise::PromiseFailure) -> Result[promise::PromiseResolution, promise::PromiseFailure],
    ] = Option::Some(
        |failure| {
            if close_on_rejection {
                async_from_sync_close(context, iterator, depth)
            }
            async_from_sync_reject(capability, failure);
            Result::Ok(promise::value(runtime::Value::Undefined))
        },
    );
    let _ = awaited.then_with_roots(on_fulfilled, on_rejected, roots);
}

fn async_from_sync_result(context: vm::Context, result: runtime::Value, depth: isize) -> Result[
    (runtime::Value, bool),
    vm::VmError,
] {
    match result {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("sync iterator method result is not an object")),
    }
    let done = context.read_property_at_depth(
        result,
        runtime::Value::String(js_string("done")),
        depth,
    )?;
    let value = context.read_property_at_depth(
        result,
        runtime::Value::String(js_string("value")),
        depth,
    )?;
    Result::Ok((value, runtime::to_boolean(done)))
}

fn async_from_sync_arguments(arguments: Vec[runtime::Value]) -> Vec[runtime::Value] {
    if arguments.is_empty() {
        Vec::new()
    } else {
        Vec::from_array([arguments[0]])
    }
}

fn async_from_sync_method(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    promise_constructor: Ref[runtime::Value],
    states: HashMap[runtime::ObjectId, AsyncFromSyncIteratorState],
    operation: AsyncFromSyncOperation,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (capability, promise_value) = async_from_sync_capability(
        context.heap(),
        promise_states,
        queue,
        promise_prototype,
    )?;
    let state = match async_from_sync_state(states, this_value) {
        Ok(value) => value,
        Err(error) => {
            async_from_sync_reject(capability, error);
            return Result::Ok(promise_value)
        },
    };
    let method = match operation {
        AsyncFromSyncOperation::Next => state.next,
        AsyncFromSyncOperation::Throw => match context.read_property_at_depth(
            state.iterator,
            runtime::Value::String(js_string("throw")),
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                async_from_sync_reject_vm(context, capability, error);
                return Result::Ok(promise_value)
            },
        },
        AsyncFromSyncOperation::Return => match context.read_property_at_depth(
            state.iterator,
            runtime::Value::String(js_string("return")),
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                async_from_sync_reject_vm(context, capability, error);
                return Result::Ok(promise_value)
            },
        },
    };
    if operation == AsyncFromSyncOperation::Return && async_from_sync_method_missing(method) {
        async_from_sync_resolve_result(context, capability, argument(arguments, 0), true);
        return Result::Ok(promise_value)
    }
    if operation == AsyncFromSyncOperation::Throw && async_from_sync_method_missing(method) {
        let return_method = match context.read_property_at_depth(
            state.iterator,
            runtime::Value::String(js_string("return")),
            depth,
        ) {
            Ok(value) => value,
            Err(error) => {
                async_from_sync_reject_vm(context, capability, error);
                return Result::Ok(promise_value)
            },
        };
        if !async_from_sync_method_missing(return_method) {
            if !promise_object_callable(return_method) {
                async_from_sync_reject(
                    capability,
                    promise::PromiseFailure::TypeError("sync iterator return is not callable"),
                );
                return Result::Ok(promise_value)
            }
            let returned = match context.invoke_with_this_at_depth(
                return_method,
                Vec::new(),
                state.iterator,
                depth,
            ) {
                Ok(value) => value,
                Err(error) => {
                    async_from_sync_reject_vm(context, capability, error);
                    return Result::Ok(promise_value)
                },
            };
            match returned {
                runtime::Value::Object(_) => (),
                _ => {
                    async_from_sync_reject(
                        capability,
                        promise::PromiseFailure::TypeError(
                            "sync iterator return result is not an object",
                        ),
                    );
                    return Result::Ok(promise_value)
                },
            }
        }
        async_from_sync_reject(
            capability,
            promise::PromiseFailure::TypeError("sync iterator does not provide a throw method"),
        );
        return Result::Ok(promise_value)
    }
    if !promise_object_callable(method) {
        async_from_sync_reject(
            capability,
            promise::PromiseFailure::TypeError(
                if operation == AsyncFromSyncOperation::Next {
                    "sync iterator next is not callable"
                } else if operation == AsyncFromSyncOperation::Throw {
                    "sync iterator throw is not callable"
                } else {
                    "sync iterator return is not callable"
                },
            ),
        );
        return Result::Ok(promise_value)
    }
    let result = match context.invoke_with_this_at_depth(
        method,
        async_from_sync_arguments(arguments),
        state.iterator,
        depth,
    ) {
        Ok(value) => value,
        Err(error) => {
            async_from_sync_reject_vm(context, capability, error);
            return Result::Ok(promise_value)
        },
    };
    let (value, done) = match async_from_sync_result(context, result, depth) {
        Ok(value) => value,
        Err(error) => {
            async_from_sync_reject_vm(context, capability, error);
            return Result::Ok(promise_value)
        },
    };
    async_from_sync_settle(
        context,
        promise_states,
        queue,
        promise_prototype,
        promise_constructor,
        capability,
        value,
        done,
        operation != AsyncFromSyncOperation::Return && !done,
        state.iterator,
        depth,
        Vec::from_array([state.iterator, state.next, result, promise_value]),
    );
    Result::Ok(promise_value)
}

fn async_iterator_identity(this_value: runtime::Value, arguments: Vec[runtime::Value], depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let _ = arguments;
    let _ = depth;
    Result::Ok(this_value)
}

fn install_async_function_kind(
    context: vm::Context,
    function_constructor: Option[runtime::Value],
    name: string,
    kind: vm::FunctionKind,
) -> Result[runtime::ObjectId, BuiltinError] {
    let parent = match context.heap().function_prototype() {
        Some(value) => Option::Some(value),
        None => context.heap().object_prototype(),
    };
    let prototype = match allocate_ordinary(context.heap(), parent) {
        Ok(value) => value,
        Err(error) => return Result::Err(BuiltinError { message: error.message }),
    };
    match function_constructor {
        Some(constructor) => {
            let _ = install_dynamic_function_constructor(
                context,
                constructor,
                name,
                kind,
                prototype,
            )?;
        },
        None => match context.set_function_kind_prototype(kind, prototype) {
            Ok(()) => (),
            Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
        },
    }
    define_to_string_tag(context, prototype, name)?;
    Result::Ok(prototype)
}

fn install_async_iterator(
    context: vm::Context,
    promise_states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    promise_constructor: Ref[runtime::Value],
) -> Result[runtime::ObjectId, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(error) => return Result::Err(BuiltinError { message: error.message }),
    };
    let from_sync_prototype = match allocate_ordinary(heap, Option::Some(prototype)) {
        Ok(value) => value,
        Err(error) => return Result::Err(BuiltinError { message: error.message }),
    };
    let states: HashMap[runtime::ObjectId, AsyncFromSyncIteratorState] = HashMap::new();
    for (name, operation) in Vec::from_array(
        [
            ("next", AsyncFromSyncOperation::Next),
            ("throw", AsyncFromSyncOperation::Throw),
            ("return", AsyncFromSyncOperation::Return),
        ],
    ) {
        define_value(
            heap,
            from_sync_prototype,
            name,
            allocate_vm_function_with_length(
                context,
                name,
                1,
                |this_value, arguments, depth| {
                    async_from_sync_method(
                        context,
                        promise_states,
                        queue,
                        promise_prototype,
                        promise_constructor,
                        states,
                        operation,
                        this_value,
                        arguments,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    match context.well_known_symbol(vm::WellKnownSymbolKind::AsyncIterator) {
        Some(symbol) => {
            let identity = allocate_vm_function_with_length(
                context,
                "[Symbol.asyncIterator]",
                0,
                async_iterator_identity,
            )?;
            if !runtime::define_own_property(
                heap,
                prototype,
                runtime::PropertyKey::Symbol(symbol),
                runtime::data_descriptor(identity, true, false, true),
            ) {
                return Result::Err(
                    BuiltinError { message: "cannot initialize async iterator prototype" },
                )
            }
        },
        None => (),
    }
    match context.set_async_iterator_prototypes(prototype, from_sync_prototype) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    context.add_external_edge_provider(|| async_from_sync_gc_edges(context.heap(), states));
    context.set_async_from_sync_iterator_factory(
        |iterator, next, _| {
            let object = match allocate_ordinary(context.heap(), Option::Some(from_sync_prototype)) {
                Ok(value) => value,
                Err(error) => return Result::Err(function_vm_error(error.message)),
            };
            states[object] = AsyncFromSyncIteratorState { iterator, next };
            Result::Ok(runtime::Value::Object(object))
        },
    );
    Result::Ok(prototype)
}

fn install_async_generator(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, promise::Promise],
    queue: promise::JobQueue,
    promise_prototype: runtime::ObjectId,
    promise_constructor: Ref[runtime::Value],
    async_iterator_prototype: runtime::ObjectId,
    function_constructor: Option[runtime::Value],
) -> Result[(), BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, Option::Some(async_iterator_prototype)) {
        Ok(value) => value,
        Err(error) => return Result::Err(BuiltinError { message: error.message }),
    };
    let generators: HashMap[runtime::ObjectId, AsyncGeneratorState] = HashMap::new();
    for (name, kind) in Vec::from_array(
        [
            ("next", AsyncGeneratorRequestKind::Next),
            ("throw", AsyncGeneratorRequestKind::Throw),
            ("return", AsyncGeneratorRequestKind::Return),
        ],
    ) {
        define_value(
            heap,
            prototype,
            name,
            allocate_vm_function_with_length(
                context,
                name,
                1,
                |this_value, arguments, depth| {
                    async_generator_enqueue(
                        context,
                        states,
                        queue,
                        promise_prototype,
                        generators,
                        this_value,
                        argument(arguments, 0),
                        kind,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    define_to_string_tag(context, prototype, "AsyncGenerator")?;
    let function_kind_prototype = install_async_function_kind(
        context,
        function_constructor,
        "AsyncGeneratorFunction",
        vm::FunctionKind::AsyncGenerator,
    )?;
    define_value(
        heap,
        function_kind_prototype,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "constructor",
        runtime::Value::Object(function_kind_prototype),
        false,
        true,
    )?;
    match context.set_async_generator_prototype(prototype) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    context.set_async_generator_runner(
        |generator, _| async_generator_runner(generators, promise_constructor, generator),
    );
    Result::Ok(())
}

pub fn install_promise_with_queue(
    context: vm::Context,
    queue: promise::JobQueue,
    function_constructor: Option[runtime::Value],
    aggregate_error_constructor: Option[runtime::Value],
) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, Option::None) {
        Ok(value) => value,
        Err(error) => return Result::Err(BuiltinError { message: error.message }),
    };
    let states: HashMap[runtime::ObjectId, promise::Promise] = HashMap::new();
    let constructor_value = Ref::new(runtime::Value::Undefined);
    context.add_external_edge_provider(|| promise_object_gc_edges(context.heap(), states));
    let _ = install_async_function_kind(
        context,
        function_constructor,
        "AsyncFunction",
        vm::FunctionKind::Async,
    )?;
    let async_iterator_prototype = install_async_iterator(
        context,
        states,
        queue,
        prototype,
        constructor_value,
    )?;
    install_async_generator(
        context,
        states,
        queue,
        prototype,
        constructor_value,
        async_iterator_prototype,
        function_constructor,
    )?;
    define_to_string_tag(context, prototype, "Promise")?;
    define_value(
        heap,
        prototype,
        "then",
        allocate_vm_function(
            context,
            "Promise.prototype.then",
            |this_value, arguments, depth| {
                promise_object_then(
                    context,
                    states,
                    constructor_value,
                    this_value,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "catch",
        allocate_vm_function(
            context,
            "Promise.prototype.catch",
            |this_value, arguments, depth| {
                promise_object_catch(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "finally",
        allocate_vm_function(
            context,
            "Promise.prototype.finally",
            |this_value, arguments, depth| {
                promise_object_finally(
                    context,
                    states,
                    constructor_value,
                    this_value,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        "Promise",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("Promise constructor requires new"))
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            let _ = depth;
            promise_object_construct(
                context,
                states,
                queue,
                prototype,
                receiver,
                arguments,
                selected_prototype,
            )
        },
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    match context.set_vm_constructor_prepare_callback(
        constructor,
        |arguments, depth| promise_object_prepare_constructor(arguments, depth),
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    constructor_value.set(constructor);
    let constructor_object = function_object(constructor, "Promise")?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_value(
        heap,
        constructor_object,
        "resolve",
        allocate_vm_function(
            context,
            "Promise.resolve",
            |this_value, arguments, depth| {
                promise_object_static_resolve(context, states, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "reject",
        allocate_vm_function(
            context,
            "Promise.reject",
            |this_value, arguments, depth| {
                promise_object_static_reject(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "all",
        allocate_vm_function(
            context,
            "Promise.all",
            |this_value, arguments, depth| {
                promise_object_static_all(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "allSettled",
        allocate_vm_function(
            context,
            "Promise.allSettled",
            |this_value, arguments, depth| {
                promise_object_static_all_settled(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "any",
        allocate_vm_function(
            context,
            "Promise.any",
            |this_value, arguments, depth| {
                promise_object_static_any(
                    context,
                    aggregate_error_constructor,
                    this_value,
                    arguments,
                    depth,
                )
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "try",
        allocate_vm_function(
            context,
            "Promise.try",
            |this_value, arguments, depth| {
                promise_object_static_try(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "race",
        allocate_vm_function(
            context,
            "Promise.race",
            |this_value, arguments, depth| {
                promise_object_static_race(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "withResolvers",
        allocate_vm_function(
            context,
            "Promise.withResolvers",
            |this_value, arguments, depth| {
                promise_object_with_resolvers(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.species]",
                0,
                array_species_getter,
            )?;
            if !runtime::define_own_property(
                heap,
                constructor_object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define Promise species" })
            }
        },
        None => (),
    }
    define_value(
        heap,
        constructor_object,
        "drainJobs",
        allocate_function(
            context,
            "Promise.drainJobs",
            |heap, this_value, arguments| {
                promise_object_drain(queue, heap, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    context.set_promise_capability_factory(
        || promise_object_host_capability(context, states, queue, prototype),
    );
    context.set_async_function_runner(
        |generator, depth| {
            promise_object_async_runner(
                context,
                states,
                queue,
                prototype,
                constructor_value,
                generator,
                depth,
            )
        },
    );
    Result::Ok(constructor)
}

pub fn install_promise(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    install_promise_with_queue(context, promise::JobQueue::new(), Option::None, Option::None)
}
