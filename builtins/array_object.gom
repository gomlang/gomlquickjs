package builtins;

use gomlang::quickjs::dtoa;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::math;
use std::num;

enum ArrayIterationMode {
    ForEach,
    Map,
    Filter,
    Every,
    Some,
    Find,
    FindIndex,
    FindLast,
    FindLastIndex,
}

enum ArrayIteratorKind {
    Keys,
    Values,
    Entries,
}

struct ArraySortSlot {
    value: runtime::Value,
    string_value: Ref[Option[runtime::JsString]],
}

const ARRAY_FROM_LIMIT: isize = 16777216;

const ARRAY_MAX_SAFE_INTEGER: isize = 9007199254740991;

const ARRAY_FLAT_RECURSION_LIMIT: isize = 256;

fn array_builtin_at(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let relative = array_copy_integer(context, argument(arguments, 0), 0, depth)?;
    let index = if relative >= 0 {
        relative
    } else {
        length + relative
    };
    if index < 0 || index >= length {
        Result::Ok(runtime::Value::Undefined)
    } else {
        context.read_property_at_depth(object, array_length_value(index), depth)
    }
}

fn array_copy_integer(
    context: vm::Context,
    value: runtime::Value,
    default_value: isize,
    depth: isize,
) -> Result[isize, vm::VmError] {
    match value {
        runtime::Value::Undefined => Result::Ok(default_value),
        _ => {
            let primitive = context.to_primitive_number_at_depth(value, depth)?;
            let number = match runtime::primitive_to_number(primitive) {
                Ok(value) => value,
                Err(value) => return Result::Err(function_vm_error(value.message)),
            };
            if math::is_nan(number) || number == 0.0 {
                Result::Ok(0)
            } else if number >= 9007199254740991.0 || number == infinity() {
                Result::Ok(ARRAY_MAX_SAFE_INTEGER)
            } else if number <= -9007199254740991.0 || number == -infinity() {
                Result::Ok(-ARRAY_MAX_SAFE_INTEGER)
            } else {
                Result::Ok(
                    num::parse_int_structured(dtoa::number_to_string(math::trunc(number))).unwrap_or(
                        0,
                    ),
                )
            }
        },
    }
}

fn array_copy_start(index: isize, length: isize) -> isize {
    if index < 0 {
        let value = length + index;
        if value < 0 {
            0
        } else {
            value
        }
    } else if index > length {
        length
    } else {
        index
    }
}

fn array_copy_read(context: vm::Context, object: runtime::Value, index: isize, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    context.read_property_at_depth(object, array_length_value(index), depth)
}

fn array_object_value(context: vm::Context, value: runtime::Value) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match object_coercion(context.heap(), value) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn array_property_present(context: vm::Context, object: runtime::Value, index: isize, depth: isize) -> Result[
    bool,
    vm::VmError,
] {
    context.has_property_at_depth(object, array_length_value(index), depth)
}

fn array_set_value(
    context: vm::Context,
    object: runtime::Value,
    index: isize,
    value: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    if context.reflect_set_at_depth(object, array_length_value(index), value, object, depth)? {
        Result::Ok(())
    } else {
        Result::Err(function_vm_error("Array property is not writable"))
    }
}

fn array_delete_value(context: vm::Context, object: runtime::Value, index: isize, depth: isize) -> Result[
    (),
    vm::VmError,
] {
    if context.delete_property_at_depth(object, array_length_value(index), depth)? {
        Result::Ok(())
    } else {
        Result::Err(function_vm_error("Array property is not configurable"))
    }
}

fn array_copy_result(context: vm::Context, values: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let length = values.len();
    match allocate_array(context.heap(), values, length) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn array_join_append(output: Vec[u16], value: runtime::JsString) -> Result[(), vm::VmError] {
    if value.len() > STRING_LENGTH_LIMIT - output.len() {
        return Result::Err(function_range_error("Array string exceeds implementation limit"))
    } else {};
    let mut index = 0;
    while index < value.len() {
        output.push(value.get(index));
        index += 1;
    }
    Result::Ok(())
}

fn array_join(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, source, depth)?;
    let separator = match argument(arguments, 0) {
        runtime::Value::Undefined => js_string(","),
        value => match string_value_at_depth(context, value, depth)? {
            runtime::Value::String(value) => value,
            _ => return Result::Err(function_vm_error("Array separator is not a string")),
        },
    };
    let output: Vec[u16] = Vec::new();
    let mut index = 0;
    while index < length {
        if index > 0 {
            array_join_append(output, separator)?
        } else {};
        let value = context.read_property_at_depth(source, array_length_value(index), depth)?;
        match value {
            runtime::Value::Undefined | runtime::Value::Null => (),
            _ => match string_value_at_depth(context, value, depth)? {
                runtime::Value::String(value) => array_join_append(output, value)?,
                _ => return Result::Err(function_vm_error("Array value is not a string")),
            },
        };
        index += 1;
    }
    Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(output)))
}

fn array_value_is_array(heap: runtime::Heap, value: runtime::Value) -> bool {
    match value {
        runtime::Value::Object(value) => match heap.get(value) {
            Some(value) => match value.kind() {
                runtime::ObjectKind::Array => true,
                _ => false,
            },
            None => false,
        },
        _ => false,
    }
}

fn array_species_default(context: vm::Context, length: isize) -> Result[runtime::Value, vm::VmError] {
    if length < 0 || length > 4294967295 {
        Result::Err(function_range_error("invalid array length"))
    } else {
        match runtime::new_array(context.heap(), length) {
            Ok(value) => Result::Ok(runtime::Value::Object(value)),
            Err(value) => Result::Err(function_vm_error(value.message)),
        }
    }
}

fn array_is_intrinsic_constructor(context: vm::Context, value: runtime::Value) -> bool {
    match context.global_object() {
        Some(global) => match runtime::get_property(
            context.heap(),
            global,
            runtime::string_property_key("Array"),
        ) {
            Ok(Some(array)) => runtime::same_value(array, value),
            _ => false,
        },
        None => false,
    }
}

fn array_length_descriptor_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
    descriptor: runtime::PropertyDescriptor,
    depth: isize,
) -> Result[runtime::PropertyDescriptor, vm::VmError] {
    let is_array_length = match context.heap().get(object) {
        Some(value) => match value.kind() {
            runtime::ObjectKind::Array => key == runtime::string_property_key("length"),
            _ => false,
        },
        None => false,
    };
    if !is_array_length {
        return Result::Ok(descriptor)
    } else {};
    match descriptor {
        runtime::PropertyDescriptor::Data { value, writable, enumerable, configurable } => {
            let first = context.to_primitive_number_at_depth(value, depth)?;
            let first_number = match runtime::primitive_to_number(first) {
                Ok(value) => value,
                Err(value) => return Result::Err(function_vm_error(value.message)),
            };
            let new_length = to_u32(first_number);
            let second = context.to_primitive_number_at_depth(value, depth)?;
            let second_number = match runtime::primitive_to_number(second) {
                Ok(value) => value,
                Err(value) => return Result::Err(function_vm_error(value.message)),
            };
            let normalized_number = num::parse_float64_structured(new_length.to_string()).unwrap_or(
                0.0,
            );
            if normalized_number != second_number {
                Result::Err(function_range_error("invalid array length"))
            } else {
                Result::Ok(
                    runtime::data_descriptor(
                        if new_length <= 2147483647 {
                            runtime::Value::Int(new_length.to_i32())
                        } else {
                            runtime::Value::Float(normalized_number)
                        },
                        writable,
                        enumerable,
                        configurable,
                    ),
                )
            }
        },
        runtime::PropertyDescriptor::Accessor { .. } => Result::Ok(descriptor),
    }
}

fn array_species_create(context: vm::Context, original: runtime::Value, length: isize, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let is_array = match array_is_array_value(context.heap(), original) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    if !is_array {
        return array_species_default(context, length)
    } else {};
    let constructor = context.read_property_at_depth(
        original,
        runtime::Value::String(js_string("constructor")),
        depth,
    )?;
    let selected = match constructor {
        runtime::Value::Object(_) => {
            let species = match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
                Some(symbol) => context.read_property_at_depth(
                    constructor,
                    runtime::Value::Symbol(symbol),
                    depth,
                )?,
                None => runtime::Value::Undefined,
            };
            match species {
                runtime::Value::Null | runtime::Value::Undefined => {
                    return array_species_default(context, length)
                },
                value => value,
            }
        },
        runtime::Value::Undefined => return array_species_default(context, length),
        value => value,
    };
    if array_is_intrinsic_constructor(context, selected) && length > 4294967295 {
        return Result::Err(function_range_error("invalid array length"))
    } else {};
    let result = context.construct_with_new_target_at_depth(
        selected,
        Vec::from_array([array_length_value(length)]),
        selected,
        depth,
    )?;
    match result {
        runtime::Value::Object(_) => Result::Ok(result),
        _ => Result::Err(function_vm_error("Array species constructor returned a primitive")),
    }
}

fn array_to_reversed(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length > ARRAY_FROM_LIMIT {
        return Result::Err(function_range_error("Array result exceeds implementation limit"))
    } else {};
    let values: Vec[runtime::Value] = Vec::with_capacity(length);
    let mut index = 0;
    while index < length {
        values.push(array_copy_read(context, object, length - index - 1, depth)?);
        index += 1;
    }
    array_copy_result(context, values)
}

fn array_with(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let relative = array_copy_integer(context, argument(arguments, 0), 0, depth)?;
    let actual = if relative < 0 {
        length + relative
    } else {
        relative
    };
    if actual < 0 || actual >= length {
        return Result::Err(function_range_error("Array index is out of range"))
    } else if length > ARRAY_FROM_LIMIT {
        return Result::Err(function_range_error("Array result exceeds implementation limit"))
    } else {};
    let replacement = argument(arguments, 1);
    let values: Vec[runtime::Value] = Vec::with_capacity(length);
    let mut index = 0;
    while index < length {
        if index == actual {
            values.push(replacement)
        } else {
            values.push(array_copy_read(context, object, index, depth)?)
        };
        index += 1;
    }
    array_copy_result(context, values)
}

fn array_to_spliced(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let start = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        length,
    );
    let delete_count = if arguments.len() == 0 {
        0
    } else if arguments.len() == 1 {
        length - start
    } else {
        let requested = array_copy_integer(context, argument(arguments, 1), 0, depth)?;
        if requested < 0 {
            0
        } else if requested > length - start {
            length - start
        } else {
            requested
        }
    };
    let item_count = if arguments.len() > 2 {
        arguments.len() - 2
    } else {
        0
    };
    let retained_count = length - delete_count;
    if item_count > ARRAY_MAX_SAFE_INTEGER - retained_count {
        return Result::Err(function_vm_error("invalid array length"))
    } else {};
    let new_length = retained_count + item_count;
    if new_length > ARRAY_FROM_LIMIT {
        return Result::Err(function_range_error("Array result exceeds implementation limit"))
    } else {};
    let values: Vec[runtime::Value] = Vec::with_capacity(new_length);
    let mut index = 0;
    while index < start {
        values.push(array_copy_read(context, object, index, depth)?);
        index += 1;
    }
    let mut item = 2;
    while item < arguments.len() {
        values.push(arguments[item]);
        item += 1;
    }
    index = start + delete_count;
    while index < length {
        values.push(array_copy_read(context, object, index, depth)?);
        index += 1;
    }
    array_copy_result(context, values)
}

fn array_sort_string_compare(left: runtime::JsString, right: runtime::JsString) -> isize {
    let mut index = 0;
    let length = if left.len() < right.len() {
        left.len()
    } else {
        right.len()
    };
    while index < length {
        if left.get(index) < right.get(index) {
            return -1
        } else if left.get(index) > right.get(index) {
            return 1
        } else {};
        index += 1;
    }
    if left.len() < right.len() {
        -1
    } else if left.len() > right.len() {
        1
    } else {
        0
    }
}

fn array_sort_slot_string(context: vm::Context, slot: ArraySortSlot, depth: isize) -> Result[
    runtime::JsString,
    vm::VmError,
] {
    match slot.string_value.get() {
        Some(value) => Result::Ok(value),
        None => match string_value_at_depth(context, slot.value, depth)? {
            runtime::Value::String(value) => {
                slot.string_value.set(Option::Some(value));
                Result::Ok(value)
            },
            _ => Result::Err(function_vm_error("cannot convert Array value to string")),
        },
    }
}

fn array_sort_compare_slots(
    context: vm::Context,
    callback: runtime::Value,
    left: ArraySortSlot,
    right: ArraySortSlot,
    depth: isize,
) -> Result[isize, vm::VmError] {
    match callback {
        runtime::Value::Undefined => Result::Ok(
            array_sort_string_compare(
                array_sort_slot_string(context, left, depth)?,
                array_sort_slot_string(context, right, depth)?,
            ),
        ),
        _ => {
            let result = context.invoke_with_this_at_depth(
                callback,
                Vec::from_array([left.value, right.value]),
                runtime::Value::Undefined,
                depth,
            )?;
            let primitive = context.to_primitive_number_at_depth(result, depth)?;
            let number = match runtime::primitive_to_number(primitive) {
                Ok(value) => value,
                Err(value) => return Result::Err(function_vm_error(value.message)),
            };
            if math::is_nan(number) || number == 0.0 {
                Result::Ok(0)
            } else if number < 0.0 {
                Result::Ok(-1)
            } else {
                Result::Ok(1)
            }
        },
    }
}

fn array_sort_slots(
    context: vm::Context,
    values: Vec[ArraySortSlot],
    callback: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    if values.len() < 2 {
        return Result::Ok(())
    } else {};
    let aux: Vec[ArraySortSlot] = Vec::new();
    let mut width = 1;
    while width < values.len() {
        let mut start = 0;
        while start < values.len() {
            let mid = if start + width < values.len() {
                start + width
            } else {
                values.len()
            };
            let end = if start + width * 2 < values.len() {
                start + width * 2
            } else {
                values.len()
            };
            if mid < end {
                let mut index = 0;
                while index < end - start {
                    aux.push(values[start + index]);
                    index += 1;
                }
                let mut left = 0;
                let mut right = mid - start;
                let mut position = start;
                while left < mid - start && right < end - start {
                    if array_sort_compare_slots(context, callback, aux[left], aux[right], depth)?
                        <= 0 {
                        values[position] = aux[left];
                        left += 1;
                    } else {
                        values[position] = aux[right];
                        right += 1;
                    };
                    position += 1;
                }
                while left < mid - start {
                    values[position] = aux[left];
                    left += 1;
                    position += 1;
                }
                while right < end - start {
                    values[position] = aux[right];
                    right += 1;
                    position += 1;
                }
                let mut clear = 0;
                while clear < end - start {
                    let _ = aux.pop();
                    clear += 1;
                }
            } else {};
            start = end;
        }
        width *= 2;
    }
    Result::Ok(())
}

fn array_collect_sort_values(
    context: vm::Context,
    object: runtime::Value,
    length: isize,
    dense: bool,
    depth: isize,
) -> Result[(Vec[ArraySortSlot], isize), vm::VmError] {
    let values: Vec[ArraySortSlot] = Vec::new();
    let mut undefined_count = 0;
    let mut index = 0;
    while index < length {
        if dense || array_property_present(context, object, index, depth)? {
            let value = array_copy_read(context, object, index, depth)?;
            match value {
                runtime::Value::Undefined => {
                    undefined_count += 1;
                },
                _ => {
                    values.push(ArraySortSlot { value, string_value: Ref::new(Option::None) });
                },
            }
        } else {};
        index += 1;
    }
    Result::Ok((values, undefined_count))
}

fn array_to_sorted(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let callback = argument(arguments, 0);
    match callback {
        runtime::Value::Undefined => (),
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("Array comparator is not callable"))
        } else {},
        _ => return Result::Err(function_vm_error("Array comparator is not callable")),
    };
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length > ARRAY_FROM_LIMIT {
        return Result::Err(function_range_error("Array result exceeds implementation limit"))
    } else {};
    let (slots, undefined_count) = array_collect_sort_values(context, object, length, true, depth)?;
    array_sort_slots(context, slots, callback, depth)?;
    let values: Vec[runtime::Value] = Vec::with_capacity(length);
    for slot in slots {
        values.push(slot.value)
    }
    for _ in 0..undefined_count {
        values.push(runtime::Value::Undefined)
    }
    array_copy_result(context, values)
}

fn array_fill(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let start = array_copy_start(
        array_copy_integer(context, argument(arguments, 1), 0, depth)?,
        length,
    );
    let end = if arguments.len() < 3 {
        length
    } else {
        array_copy_start(array_copy_integer(context, arguments[2], length, depth)?, length)
    };
    let value = argument(arguments, 0);
    let mut index = start;
    while index < end {
        array_set_value(context, object, index, value, depth)?;
        index += 1;
    }
    Result::Ok(object)
}

fn array_copy_within(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let mut target = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        length,
    );
    let mut source = array_copy_start(
        array_copy_integer(context, argument(arguments, 1), 0, depth)?,
        length,
    );
    let end = if arguments.len() < 3 {
        length
    } else {
        array_copy_start(array_copy_integer(context, arguments[2], length, depth)?, length)
    };
    let available = end - source;
    let room = length - target;
    let count = if available < room {
        available
    } else {
        room
    };
    let direction = if source < target && target < source + count {
        -1
    } else {
        1
    };
    if direction < 0 {
        source += count - 1;
        target += count - 1;
    } else {};
    let mut remaining = count;
    while remaining > 0 {
        if array_property_present(context, object, source, depth)? {
            let value = array_copy_read(context, object, source, depth)?;
            array_set_value(context, object, target, value, depth)?
        } else {
            array_delete_value(context, object, target, depth)?
        };
        source += direction;
        target += direction;
        remaining -= 1;
    }
    Result::Ok(object)
}

fn array_reverse(
    context: vm::Context,
    this_value: runtime::Value,
    _arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let mut lower = 0;
    while lower < length / 2 {
        let upper = length - lower - 1;
        let lower_value = if array_property_present(context, object, lower, depth)? {
            Option::Some(array_copy_read(context, object, lower, depth)?)
        } else {
            Option::None
        };
        let upper_value = if array_property_present(context, object, upper, depth)? {
            Option::Some(array_copy_read(context, object, upper, depth)?)
        } else {
            Option::None
        };
        match (lower_value, upper_value) {
            (Some(lower_value), Some(upper_value)) => {
                array_set_value(context, object, lower, upper_value, depth)?;
                array_set_value(context, object, upper, lower_value, depth)?
            },
            (Some(lower_value), None) => {
                array_delete_value(context, object, lower, depth)?;
                array_set_value(context, object, upper, lower_value, depth)?
            },
            (None, Some(upper_value)) => {
                array_set_value(context, object, lower, upper_value, depth)?;
                array_delete_value(context, object, upper, depth)?
            },
            (None, None) => (),
        };
        lower += 1;
    }
    Result::Ok(object)
}

fn array_index_of(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length == 0 {
        return Result::Ok(runtime::Value::Int(-1))
    } else {};
    let from_index = array_copy_integer(context, argument(arguments, 1), 0, depth)?;
    if from_index >= length {
        return Result::Ok(runtime::Value::Int(-1))
    } else {};
    let mut index = if from_index >= 0 {
        from_index
    } else {
        let relative = length + from_index;
        if relative < 0 {
            0
        } else {
            relative
        }
    };
    let search_element = argument(arguments, 0);
    while index < length {
        if array_property_present(context, object, index, depth)?
            && runtime::strict_equal(
                array_copy_read(context, object, index, depth)?,
                search_element,
            ) {
            return Result::Ok(array_length_value(index))
        } else {};
        index += 1;
    }
    Result::Ok(runtime::Value::Int(-1))
}

fn array_last_index_start(context: vm::Context, value: runtime::Value, length: isize, depth: isize) -> Result[
    Option[isize],
    vm::VmError,
] {
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    let number = match runtime::primitive_to_number(primitive) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let integer = if math::is_nan(number) {
        0.0
    } else {
        math::trunc(number)
    };
    if integer == 0.0 {
        Result::Ok(Option::Some(0))
    } else if integer > 0.0 {
        if integer >= int_float(length - 1) {
            Result::Ok(Option::Some(length - 1))
        } else {
            Result::Ok(
                Option::Some(
                    num::parse_int_structured(dtoa::number_to_string(integer)).unwrap_or(0),
                ),
            )
        }
    } else {
        let relative = int_float(length) + integer;
        if relative < 0.0 {
            Result::Ok(Option::None)
        } else {
            Result::Ok(
                Option::Some(
                    num::parse_int_structured(dtoa::number_to_string(relative)).unwrap_or(0),
                ),
            )
        }
    }
}

fn array_last_index_of(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length == 0 {
        return Result::Ok(runtime::Value::Int(-1))
    } else {};
    let start = if arguments.len() < 2 {
        Option::Some(length - 1)
    } else {
        array_last_index_start(context, arguments[1], length, depth)?
    };
    let mut index = match start {
        Some(value) => value,
        None => return Result::Ok(runtime::Value::Int(-1)),
    };
    let search_element = argument(arguments, 0);
    while index >= 0 {
        if array_property_present(context, object, index, depth)?
            && runtime::strict_equal(
                array_copy_read(context, object, index, depth)?,
                search_element,
            ) {
            return Result::Ok(array_length_value(index))
        } else {};
        index -= 1;
    }
    Result::Ok(runtime::Value::Int(-1))
}

fn array_includes(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length == 0 {
        return Result::Ok(runtime::Value::Bool(false))
    } else {};
    let from_index = array_copy_integer(context, argument(arguments, 1), 0, depth)?;
    if from_index >= length {
        return Result::Ok(runtime::Value::Bool(false))
    } else {};
    let mut index = if from_index >= 0 {
        from_index
    } else {
        let relative = length + from_index;
        if relative < 0 {
            0
        } else {
            relative
        }
    };
    let search_element = argument(arguments, 0);
    while index < length {
        if runtime::same_value_zero(array_copy_read(context, object, index, depth)?, search_element) {
            return Result::Ok(runtime::Value::Bool(true))
        } else {};
        index += 1;
    }
    Result::Ok(runtime::Value::Bool(false))
}

fn array_push(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let mut length = array_iterator_length(context, object, depth)?;
    if arguments.len() > ARRAY_MAX_SAFE_INTEGER - length {
        return Result::Err(function_vm_error("Array push exceeds maximum safe length"))
    } else {};
    for value in arguments {
        array_set_value(context, object, length, value, depth)?;
        length += 1;
    }
    array_set_length(context, object, length, depth)?;
    Result::Ok(array_length_value(length))
}

fn array_pop(
    context: vm::Context,
    this_value: runtime::Value,
    _arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length == 0 {
        array_set_length(context, object, 0, depth)?;
        return Result::Ok(runtime::Value::Undefined)
    } else {};
    let new_length = length - 1;
    let element = array_copy_read(context, object, new_length, depth)?;
    array_delete_value(context, object, new_length, depth)?;
    array_set_length(context, object, new_length, depth)?;
    Result::Ok(element)
}

fn array_shift(
    context: vm::Context,
    this_value: runtime::Value,
    _arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length == 0 {
        array_set_length(context, object, 0, depth)?;
        return Result::Ok(runtime::Value::Undefined)
    } else {};
    let first = array_copy_read(context, object, 0, depth)?;
    let mut index = 1;
    while index < length {
        if array_property_present(context, object, index, depth)? {
            let value = array_copy_read(context, object, index, depth)?;
            array_set_value(context, object, index - 1, value, depth)?
        } else {
            array_delete_value(context, object, index - 1, depth)?
        };
        index += 1;
    }
    array_delete_value(context, object, length - 1, depth)?;
    array_set_length(context, object, length - 1, depth)?;
    Result::Ok(first)
}

fn array_unshift(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let item_count = arguments.len();
    if item_count > ARRAY_MAX_SAFE_INTEGER - length {
        return Result::Err(function_vm_error("Array unshift exceeds maximum safe length"))
    } else {};
    if item_count > 0 {
        let mut index = length;
        while index > 0 {
            let source = index - 1;
            let target = index + item_count - 1;
            if array_property_present(context, object, source, depth)? {
                let value = array_copy_read(context, object, source, depth)?;
                array_set_value(context, object, target, value, depth)?
            } else {
                array_delete_value(context, object, target, depth)?
            };
            index -= 1;
        }
        let mut item_index = 0;
        for value in arguments {
            array_set_value(context, object, item_index, value, depth)?;
            item_index += 1;
        }
    } else {};
    let new_length = length + item_count;
    array_set_length(context, object, new_length, depth)?;
    Result::Ok(array_length_value(new_length))
}

fn array_sort(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let callback = argument(arguments, 0);
    match callback {
        runtime::Value::Undefined => (),
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("Array comparator is not callable"))
        } else {},
        _ => return Result::Err(function_vm_error("Array comparator is not callable")),
    };
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length > ARRAY_FROM_LIMIT {
        return Result::Err(function_range_error("Array sort exceeds implementation limit"))
    } else {};
    let (slots, undefined_count) = array_collect_sort_values(context, object, length, false, depth)?;
    array_sort_slots(context, slots, callback, depth)?;
    let mut index = 0;
    for slot in slots {
        array_set_value(context, object, index, slot.value, depth)?;
        index += 1;
    }
    for _ in 0..undefined_count {
        array_set_value(context, object, index, runtime::Value::Undefined, depth)?;
        index += 1;
    }
    while index < length {
        array_delete_value(context, object, index, depth)?;
        index += 1;
    }
    Result::Ok(object)
}

fn array_flatten_into(
    context: vm::Context,
    target: runtime::Value,
    source: runtime::Value,
    source_length: isize,
    target_index: isize,
    flatten_depth: isize,
    mapper: runtime::Value,
    mapper_this: runtime::Value,
    map_values: bool,
    depth: isize,
    recursion: isize,
) -> Result[isize, vm::VmError] {
    if recursion > ARRAY_FLAT_RECURSION_LIMIT {
        return Result::Err(function_range_error("Array flattening exceeds recursion limit"))
    } else {};
    let mut output_index = target_index;
    let mut source_index = 0;
    while source_index < source_length {
        if array_property_present(context, source, source_index, depth)? {
            let original = array_copy_read(context, source, source_index, depth)?;
            let element = if map_values {
                context.invoke_with_this_at_depth(
                    mapper,
                    Vec::from_array([original, array_length_value(source_index), source]),
                    mapper_this,
                    depth,
                )?
            } else {
                original
            };
            if flatten_depth > 0 && array_value_is_array(context.heap(), element) {
                let element_length = array_iterator_length(context, element, depth)?;
                output_index = array_flatten_into(
                    context,
                    target,
                    element,
                    element_length,
                    output_index,
                    flatten_depth - 1,
                    runtime::Value::Undefined,
                    runtime::Value::Undefined,
                    false,
                    depth,
                    recursion + 1,
                )?;
            } else {
                if output_index >= ARRAY_FROM_LIMIT {
                    return Result::Err(
                        function_range_error("Array flattening exceeds implementation limit"),
                    )
                } else {};
                context.create_data_property_at_depth(
                    target,
                    array_length_value(output_index),
                    element,
                    depth,
                )?;
                output_index += 1;
            }
        } else {};
        source_index += 1;
    }
    Result::Ok(output_index)
}

fn array_flatten(
    context: vm::Context,
    map_values: bool,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    let mapper = if map_values {
        array_iteration_callback(arguments)?
    } else {
        runtime::Value::Undefined
    };
    let mapper_this = if map_values {
        argument(arguments, 1)
    } else {
        runtime::Value::Undefined
    };
    let flatten_depth = if map_values {
        1
    } else {
        let value = array_copy_integer(context, argument(arguments, 0), 1, depth)?;
        if value < 0 {
            0
        } else {
            value
        }
    };
    let target = array_species_create(context, object, 0, depth)?;
    let _ = array_flatten_into(
        context,
        target,
        object,
        length,
        0,
        flatten_depth,
        mapper,
        mapper_this,
        map_values,
        depth,
        0,
    )?;
    Result::Ok(target)
}

fn array_concat_spreadable(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    bool,
    vm::VmError,
] {
    match value {
        runtime::Value::Object(_) => (),
        _ => return Result::Ok(false),
    };
    match context.well_known_symbol(vm::WellKnownSymbolKind::IsConcatSpreadable) {
        Some(symbol) => {
            let spreadable = context.read_property_at_depth(
                value,
                runtime::Value::Symbol(symbol),
                depth,
            )?;
            match spreadable {
                runtime::Value::Undefined => (),
                _ => return Result::Ok(runtime::to_boolean(spreadable)),
            }
        },
        None => (),
    };
    Result::Ok(array_value_is_array(context.heap(), value))
}

fn array_concat(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source = array_object_value(context, this_value)?;
    let target = array_species_create(context, source, 0, depth)?;
    let inputs: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 1);
    inputs.push(source);
    for value in arguments {
        inputs.push(value)
    }
    let mut output_index = 0;
    for value in inputs {
        if array_concat_spreadable(context, value, depth)? {
            let length = array_iterator_length(context, value, depth)?;
            if length > ARRAY_MAX_SAFE_INTEGER - output_index {
                return Result::Err(function_vm_error("Array concat exceeds maximum safe length"))
            } else {};
            let mut index = 0;
            while index < length {
                if array_property_present(context, value, index, depth)? {
                    let element = array_copy_read(context, value, index, depth)?;
                    context.create_data_property_at_depth(
                        target,
                        array_length_value(output_index),
                        element,
                        depth,
                    )?
                } else {};
                output_index += 1;
                index += 1;
            }
        } else {
            if output_index >= ARRAY_MAX_SAFE_INTEGER {
                return Result::Err(function_vm_error("Array concat exceeds maximum safe length"))
            } else {};
            context.create_data_property_at_depth(
                target,
                array_length_value(output_index),
                value,
                depth,
            )?;
            output_index += 1;
        }
    }
    if context.reflect_set_at_depth(
        target,
        runtime::Value::String(js_string("length")),
        array_length_value(output_index),
        target,
        depth,
    )? {
        Result::Ok(target)
    } else {
        Result::Err(function_vm_error("Array concat result length is not writable"))
    }
}

fn array_slice(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, source, depth)?;
    let first = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        length,
    );
    let final_index = match argument(arguments, 1) {
        runtime::Value::Undefined => length,
        value => array_copy_start(array_copy_integer(context, value, 0, depth)?, length),
    };
    let count = if final_index > first {
        final_index - first
    } else {
        0
    };
    let target = array_species_create(context, source, count, depth)?;
    let mut source_index = first;
    let mut target_index = 0;
    while source_index < final_index {
        if array_property_present(context, source, source_index, depth)? {
            let value = array_copy_read(context, source, source_index, depth)?;
            context.create_data_property_at_depth(
                target,
                array_length_value(target_index),
                value,
                depth,
            )?
        } else {};
        source_index += 1;
        target_index += 1;
    }
    if context.reflect_set_at_depth(
        target,
        runtime::Value::String(js_string("length")),
        array_length_value(target_index),
        target,
        depth,
    )? {
        Result::Ok(target)
    } else {
        Result::Err(function_vm_error("Array slice result length is not writable"))
    }
}

fn array_splice(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, source, depth)?;
    let start = array_copy_start(
        array_copy_integer(context, argument(arguments, 0), 0, depth)?,
        length,
    );
    let item_count = if arguments.len() > 2 {
        arguments.len() - 2
    } else {
        0
    };
    let delete_count = if arguments.len() == 0 {
        0
    } else if arguments.len() == 1 {
        length - start
    } else {
        let requested = array_copy_integer(context, argument(arguments, 1), 0, depth)?;
        if requested <= 0 {
            0
        } else if requested > length - start {
            length - start
        } else {
            requested
        }
    };
    if item_count > ARRAY_MAX_SAFE_INTEGER - (length - delete_count) {
        return Result::Err(function_vm_error("Array splice exceeds maximum safe length"))
    } else {};
    let removed = array_species_create(context, source, delete_count, depth)?;
    let mut index = 0;
    while index < delete_count {
        let source_index = start + index;
        if array_property_present(context, source, source_index, depth)? {
            context.create_data_property_at_depth(
                removed,
                array_length_value(index),
                array_copy_read(context, source, source_index, depth)?,
                depth,
            )?
        } else {};
        index += 1;
    }
    array_set_length(context, removed, delete_count, depth)?;
    if item_count < delete_count {
        index = start;
        while index < length - delete_count {
            let from = index + delete_count;
            let to = index + item_count;
            if array_property_present(context, source, from, depth)? {
                array_set_value(
                    context,
                    source,
                    to,
                    array_copy_read(context, source, from, depth)?,
                    depth,
                )?
            } else {
                array_delete_value(context, source, to, depth)?
            };
            index += 1;
        }
        index = length;
        while index > length - delete_count + item_count {
            array_delete_value(context, source, index - 1, depth)?;
            index -= 1;
        }
    } else if item_count > delete_count {
        index = length - delete_count;
        while index > start {
            let from = index + delete_count - 1;
            let to = index + item_count - 1;
            if array_property_present(context, source, from, depth)? {
                array_set_value(
                    context,
                    source,
                    to,
                    array_copy_read(context, source, from, depth)?,
                    depth,
                )?
            } else {
                array_delete_value(context, source, to, depth)?
            };
            index -= 1;
        }
    } else {};
    index = 0;
    while index < item_count {
        array_set_value(context, source, start + index, arguments[index + 2], depth)?;
        index += 1;
    }
    array_set_length(context, source, length - delete_count + item_count, depth)?;
    Result::Ok(removed)
}

fn array_iteration_callback(arguments: Vec[runtime::Value]) -> Result[runtime::Value, vm::VmError] {
    let callback = argument(arguments, 0);
    match callback {
        runtime::Value::Object(value) => if value.is_callable() {
            Result::Ok(callback)
        } else {
            Result::Err(function_vm_error("Array callback is not callable"))
        },
        _ => Result::Err(function_vm_error("Array callback is not callable")),
    }
}

fn array_iteration_result_array(
    context: vm::Context,
    mode: ArrayIterationMode,
    source: runtime::Value,
    length: isize,
    depth: isize,
) -> Result[Option[runtime::Value], vm::VmError] {
    match mode {
        ArrayIterationMode::Map => {
            Result::Ok(Option::Some(array_species_create(context, source, length, depth)?))
        },
        ArrayIterationMode::Filter => {
            Result::Ok(Option::Some(array_species_create(context, source, 0, depth)?))
        },
        _ => Result::Ok(Option::None),
    }
}

fn array_iteration_visits_holes(mode: ArrayIterationMode) -> bool {
    match mode {
        ArrayIterationMode::Find | ArrayIterationMode::FindIndex | ArrayIterationMode::FindLast | ArrayIterationMode::FindLastIndex => true,
        _ => false,
    }
}

fn array_iteration_reverse(mode: ArrayIterationMode) -> bool {
    match mode {
        ArrayIterationMode::FindLast | ArrayIterationMode::FindLastIndex => true,
        _ => false,
    }
}

fn array_iterate(
    context: vm::Context,
    mode: ArrayIterationMode,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    array_iterate_with_length(context, mode, object, length, arguments, depth, false)
}

fn array_iterate_with_length(
    context: vm::Context,
    mode: ArrayIterationMode,
    object: runtime::Value,
    length: isize,
    arguments: Vec[runtime::Value],
    depth: isize,
    dense: bool,
) -> Result[runtime::Value, vm::VmError] {
    let callback = array_iteration_callback(arguments)?;
    let callback_this = argument(arguments, 1);
    let output = array_iteration_result_array(context, mode, object, length, depth)?;
    let reverse = array_iteration_reverse(mode);
    let mut output_index = 0;
    let mut index = if reverse {
        length - 1
    } else {
        0
    };
    while if reverse {
        index >= 0
    } else {
        index < length
    } {
        let present = if dense {
            true
        } else {
            array_property_present(context, object, index, depth)?
        };
        if present || array_iteration_visits_holes(mode) {
            let value = array_copy_read(context, object, index, depth)?;
            let selected = context.invoke_with_this_at_depth(
                callback,
                Vec::from_array([value, array_length_value(index), object]),
                callback_this,
                depth,
            )?;
            match mode {
                ArrayIterationMode::ForEach => (),
                ArrayIterationMode::Map => match output {
                    Some(result) => {
                        context.create_data_property_at_depth(
                            result,
                            array_length_value(index),
                            selected,
                            depth,
                        )?
                    },
                    None => return Result::Err(function_vm_error("mapped Array is unavailable")),
                },
                ArrayIterationMode::Filter => if runtime::to_boolean(selected) {
                    match output {
                        Some(result) => {
                            context.create_data_property_at_depth(
                                result,
                                array_length_value(output_index),
                                value,
                                depth,
                            )?;
                            output_index += 1;
                        },
                        None => return Result::Err(
                            function_vm_error("filtered Array is unavailable"),
                        ),
                    }
                } else {},
                ArrayIterationMode::Every => if !runtime::to_boolean(selected) {
                    return Result::Ok(runtime::Value::Bool(false))
                } else {},
                ArrayIterationMode::Some => if runtime::to_boolean(selected) {
                    return Result::Ok(runtime::Value::Bool(true))
                } else {},
                ArrayIterationMode::Find => if runtime::to_boolean(selected) {
                    return Result::Ok(value)
                } else {},
                ArrayIterationMode::FindIndex => if runtime::to_boolean(selected) {
                    return Result::Ok(array_length_value(index))
                } else {},
                ArrayIterationMode::FindLast => if runtime::to_boolean(selected) {
                    return Result::Ok(value)
                } else {},
                ArrayIterationMode::FindLastIndex => if runtime::to_boolean(selected) {
                    return Result::Ok(array_length_value(index))
                } else {},
            }
        } else {};
        if reverse {
            index -= 1;
        } else {
            index += 1;
        }
    }
    match mode {
        ArrayIterationMode::Map | ArrayIterationMode::Filter => match output {
            Some(value) => Result::Ok(value),
            None => Result::Err(function_vm_error("Array iteration result is unavailable")),
        },
        ArrayIterationMode::Every => Result::Ok(runtime::Value::Bool(true)),
        ArrayIterationMode::Some => Result::Ok(runtime::Value::Bool(false)),
        ArrayIterationMode::Find | ArrayIterationMode::FindLast => {
            Result::Ok(runtime::Value::Undefined)
        },
        ArrayIterationMode::FindIndex | ArrayIterationMode::FindLastIndex => {
            Result::Ok(runtime::Value::Int(-1))
        },
        ArrayIterationMode::ForEach => Result::Ok(runtime::Value::Undefined),
    }
}

fn array_reduce(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    reverse: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    array_reduce_with_length(context, object, length, arguments, reverse, depth, false)
}

fn array_reduce_with_length(
    context: vm::Context,
    object: runtime::Value,
    length: isize,
    arguments: Vec[runtime::Value],
    reverse: bool,
    depth: isize,
    dense: bool,
) -> Result[runtime::Value, vm::VmError] {
    let callback = array_iteration_callback(arguments)?;
    let mut index = if reverse {
        length - 1
    } else {
        0
    };
    let mut accumulator = if arguments.len() > 1 {
        Option::Some(arguments[1])
    } else {
        Option::None
    };
    while accumulator.is_none()
        && if reverse {
            index >= 0
        } else {
            index < length
        } {
        let present = if dense {
            true
        } else {
            array_property_present(context, object, index, depth)?
        };
        if present {
            accumulator = Option::Some(array_copy_read(context, object, index, depth)?);
        } else {};
        if reverse {
            index -= 1;
        } else {
            index += 1;
        }
    }
    let mut result = match accumulator {
        Some(value) => value,
        None => return Result::Err(function_vm_error("reduce of empty Array with no initial value")),
    };
    while if reverse {
        index >= 0
    } else {
        index < length
    } {
        let present = if dense {
            true
        } else {
            array_property_present(context, object, index, depth)?
        };
        if present {
            let value = array_copy_read(context, object, index, depth)?;
            result = context.invoke_with_this_at_depth(
                callback,
                Vec::from_array([result, value, array_length_value(index), object]),
                runtime::Value::Undefined,
                depth,
            )?;
        } else {};
        if reverse {
            index -= 1;
        } else {
            index += 1;
        }
    }
    Result::Ok(result)
}

fn array_iterator_result(context: vm::Context, value: runtime::Value, done: bool) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let object = match runtime::new_ordinary_object(context.heap(), Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    if !runtime::define_own_property(
        context.heap(),
        object,
        runtime::string_property_key("value"),
        runtime::data_descriptor(value, true, true, true),
    )
        || !runtime::define_own_property(
            context.heap(),
            object,
            runtime::string_property_key("done"),
            runtime::data_descriptor(runtime::Value::Bool(done), true, true, true),
        ) {
        Result::Err(function_vm_error("cannot allocate Array iterator result"))
    } else {
        Result::Ok(runtime::Value::Object(object))
    }
}

fn array_iterator_identity(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(this_value)
}

fn array_to_locale_string(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let object = array_object_value(context, this_value)?;
    let length = array_iterator_length(context, object, depth)?;
    if length > STRING_LENGTH_LIMIT {
        return Result::Err(
            function_range_error("localized Array string exceeds implementation limit"),
        )
    } else {};
    let mut output = js_string("");
    let mut index = 0;
    while index < length {
        if index > 0 {
            output = output.concat(js_string(","));
        } else {};
        let value = context.read_property_at_depth(object, array_length_value(index), depth)?;
        match value {
            runtime::Value::Undefined | runtime::Value::Null => (),
            _ => {
                let method = context.read_property_at_depth(
                    value,
                    runtime::Value::String(js_string("toLocaleString")),
                    depth,
                )?;
                let call_arguments: Vec[runtime::Value] = Vec::new();
                let localized = context.invoke_with_this_at_depth(
                    method,
                    call_arguments,
                    value,
                    depth,
                )?;
                let text = match string_value_at_depth(context, localized, depth)? {
                    runtime::Value::String(value) => value,
                    _ => return Result::Err(function_vm_error("localized value is not a string")),
                };
                if output.len() > STRING_LENGTH_LIMIT - text.len() {
                    return Result::Err(
                        function_range_error("localized Array string exceeds implementation limit"),
                    )
                } else {};
                output = output.concat(text);
            },
        };
        index += 1;
    }
    Result::Ok(runtime::Value::String(output))
}

fn array_to_string(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let object = match object_coercion(context.heap(), this_value) {
        Ok(value) => runtime::Value::Object(value),
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let join = context.read_property_at_depth(
        object,
        runtime::Value::String(js_string("join")),
        depth,
    )?;
    let empty: Vec[runtime::Value] = Vec::new();
    match join {
        runtime::Value::Object(value) => if value.is_callable() {
            context.invoke_with_this_at_depth(join, empty, object, depth)
        } else {
            object_prototype_to_string_at_depth(context, object, empty, depth)
        },
        _ => object_prototype_to_string_at_depth(context, object, empty, depth),
    }
}

fn array_iterator_length(context: vm::Context, object: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let value = context.read_property_at_depth(
        object,
        runtime::Value::String(js_string("length")),
        depth,
    )?;
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    let number = match runtime::primitive_to_number(primitive) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    if math::is_nan(number) || number <= 0.0 {
        Result::Ok(0)
    } else if number >= 9007199254740991.0 || number == infinity() {
        Result::Ok(ARRAY_MAX_SAFE_INTEGER)
    } else {
        Result::Ok(
            num::parse_int_structured(dtoa::number_to_string(math::trunc(number))).unwrap_or(0),
        )
    }
}

fn array_from_map(
    context: vm::Context,
    mapper: runtime::Value,
    this_argument: runtime::Value,
    value: runtime::Value,
    index: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match mapper {
        runtime::Value::Undefined => Result::Ok(value),
        runtime::Value::Object(object) => if object.is_callable() {
            context.invoke_with_this_at_depth(
                mapper,
                Vec::from_array([value, array_length_value(index)]),
                this_argument,
                depth,
            )
        } else {
            Result::Err(function_vm_error("Array.from mapper is not callable"))
        },
        _ => Result::Err(function_vm_error("Array.from mapper is not callable")),
    }
}

fn array_from_close(context: vm::Context, iterator: runtime::Value, depth: isize) -> Result[
    (),
    vm::VmError,
] {
    let method = context.read_property_at_depth(
        iterator,
        runtime::Value::String(js_string("return")),
        depth,
    )?;
    match method {
        runtime::Value::Undefined | runtime::Value::Null => Result::Ok(()),
        runtime::Value::Object(object) => if object.is_callable() {
            let arguments: Vec[runtime::Value] = Vec::new();
            let result = context.invoke_with_this_at_depth(method, arguments, iterator, depth)?;
            match result {
                runtime::Value::Object(_) => Result::Ok(()),
                _ => {
                    Result::Err(function_vm_error("iterator return result is not an object"))
                },
            }
        } else {
            Result::Err(function_vm_error("iterator return is not callable"))
        },
        _ => Result::Err(function_vm_error("iterator return is not callable")),
    }
}

fn array_from_with_root[T](
    context: vm::Context,
    value: runtime::Value,
    callback: () -> Result[T, vm::VmError],
) -> Result[T, vm::VmError] {
    let root = Ref::new(value);
    context.add_external_root(root);
    let result = callback();
    let _ = context.remove_external_root(root);
    result
}

fn array_from_result(
    context: vm::Context,
    constructor: runtime::Value,
    length: Option[isize],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    if vm::is_constructor(context, constructor) {
        let arguments = match length {
            Some(value) => Vec::from_array([array_length_value(value)]),
            None => Vec::new(),
        };
        context.construct_with_new_target_at_depth(constructor, arguments, constructor, depth)
    } else {
        match runtime::new_array(context.heap(), length.unwrap_or(0)) {
            Ok(value) => Result::Ok(runtime::Value::Object(value)),
            Err(value) => Result::Err(function_vm_error(value.message)),
        }
    }
}

fn array_set_length(context: vm::Context, result: runtime::Value, length: isize, depth: isize) -> Result[
    (),
    vm::VmError,
] {
    if context.reflect_set_at_depth(
        result,
        runtime::Value::String(js_string("length")),
        array_length_value(length),
        result,
        depth,
    )? {
        Result::Ok(())
    } else {
        Result::Err(function_vm_error("Array length is not writable"))
    }
}

fn array_from_iterator(
    context: vm::Context,
    constructor: runtime::Value,
    source: runtime::Value,
    method: runtime::Value,
    mapper: runtime::Value,
    this_argument: runtime::Value,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let output = array_from_result(context, constructor, Option::None, depth)?;
    array_from_with_root(
        context,
        output,
        || {
            let iterator_arguments: Vec[runtime::Value] = Vec::new();
            let iterator = context.invoke_with_this_at_depth(
                method,
                iterator_arguments,
                source,
                depth,
            )?;
            match iterator {
                runtime::Value::Object(_) => (),
                _ => return Result::Err(function_vm_error("iterator result is not an object")),
            };
            array_from_with_root(
                context,
                iterator,
                || {
                    let next = context.read_property_at_depth(
                        iterator,
                        runtime::Value::String(js_string("next")),
                        depth,
                    )?;
                    match next {
                        runtime::Value::Object(object) => if !object.is_callable() {
                            return Result::Err(function_vm_error("iterator next is not callable"))
                        } else {},
                        _ => return Result::Err(function_vm_error("iterator next is not callable")),
                    };
                    let mut index = 0;
                    while index < ARRAY_FROM_LIMIT {
                        let next_arguments: Vec[runtime::Value] = Vec::new();
                        let result = match context.invoke_with_this_at_depth(
                            next,
                            next_arguments,
                            iterator,
                            depth,
                        ) {
                            Ok(value) => value,
                            Err(value) => {
                                let _ = array_from_close(context, iterator, depth);
                                return Result::Err(value)
                            },
                        };
                        match result {
                            runtime::Value::Object(_) => (),
                            _ => {
                                let _ = array_from_close(context, iterator, depth);
                                return Result::Err(
                                    function_vm_error("iterator next result is not an object"),
                                )
                            },
                        };
                        let done = match context.read_property_at_depth(
                            result,
                            runtime::Value::String(js_string("done")),
                            depth,
                        ) {
                            Ok(value) => value,
                            Err(value) => {
                                let _ = array_from_close(context, iterator, depth);
                                return Result::Err(value)
                            },
                        };
                        if runtime::to_boolean(done) {
                            array_set_length(context, output, index, depth)?;
                            return Result::Ok(output)
                        } else {};
                        let value = match context.read_property_at_depth(
                            result,
                            runtime::Value::String(js_string("value")),
                            depth,
                        ) {
                            Ok(value) => value,
                            Err(value) => {
                                let _ = array_from_close(context, iterator, depth);
                                return Result::Err(value)
                            },
                        };
                        let mapped = match array_from_map(
                            context,
                            mapper,
                            this_argument,
                            value,
                            index,
                            depth,
                        ) {
                            Ok(value) => value,
                            Err(value) => {
                                let _ = array_from_close(context, iterator, depth);
                                return Result::Err(value)
                            },
                        };
                        match context.create_data_property_at_depth(
                            output,
                            array_length_value(index),
                            mapped,
                            depth,
                        ) {
                            Ok(()) => (),
                            Err(value) => {
                                let _ = array_from_close(context, iterator, depth);
                                return Result::Err(value)
                            },
                        };
                        index += 1;
                    }
                    let error = function_range_error(
                        "Array.from input exceeds implementation limit",
                    );
                    let _ = array_from_close(context, iterator, depth);
                    Result::Err(error)
                },
            )
        },
    )
}

fn array_from(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source = argument(arguments, 0);
    match source {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Err(function_vm_error("Array.from requires an input value"))
        },
        _ => (),
    };
    let mapper = argument(arguments, 1);
    match mapper {
        runtime::Value::Undefined => (),
        runtime::Value::Object(object) => if !object.is_callable() {
            return Result::Err(function_vm_error("Array.from mapper is not callable"))
        } else {},
        _ => return Result::Err(function_vm_error("Array.from mapper is not callable")),
    };
    let this_argument = argument(arguments, 2);
    let symbol = match context.iterator_symbol() {
        Some(value) => value,
        None => return Result::Err(function_vm_error("iterator symbol is not installed")),
    };
    let method = context.read_property_at_depth(source, runtime::Value::Symbol(symbol), depth)?;
    match method {
        runtime::Value::Undefined | runtime::Value::Null => (),
        runtime::Value::Object(object) => if object.is_callable() {
            return array_from_iterator(
                context,
                this_value,
                source,
                method,
                mapper,
                this_argument,
                depth,
            )
        } else {
            return Result::Err(function_vm_error("iterator method is not callable"))
        },
        _ => return Result::Err(function_vm_error("iterator method is not callable")),
    };
    let length = array_iterator_length(context, source, depth)?;
    if length > ARRAY_FROM_LIMIT {
        return Result::Err(function_range_error("Array.from input exceeds implementation limit"))
    } else {};
    let output = array_from_result(context, this_value, Option::Some(length), depth)?;
    array_from_with_root(
        context,
        output,
        || {
            let mut index = 0;
            while index < length {
                let value = context.read_property_at_depth(source, array_length_value(index), depth)?;
                let mapped = array_from_map(context, mapper, this_argument, value, index, depth)?;
                context.create_data_property_at_depth(
                    output,
                    array_length_value(index),
                    mapped,
                    depth,
                )?;
                index += 1;
            }
            array_set_length(context, output, length, depth)?;
            Result::Ok(output)
        },
    )
}

fn array_of(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let length = arguments.len();
    let output = array_from_result(context, this_value, Option::Some(length), depth)?;
    array_from_with_root(
        context,
        output,
        || {
            let mut index = 0;
            while index < length {
                context.create_data_property_at_depth(
                    output,
                    array_length_value(index),
                    arguments[index],
                    depth,
                )?;
                index += 1;
            }
            array_set_length(context, output, length, depth)?;
            Result::Ok(output)
        },
    )
}

fn array_iterator_value(
    context: vm::Context,
    kind: ArrayIteratorKind,
    object: runtime::Value,
    index: isize,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let key = array_length_value(index);
    match kind {
        ArrayIteratorKind::Keys => Result::Ok(key),
        ArrayIteratorKind::Values => context.read_property_at_depth(object, key, depth),
        ArrayIteratorKind::Entries => {
            let value = context.read_property_at_depth(object, key, depth)?;
            let values: Vec[runtime::Value] = Vec::from_array([key, value]);
            match allocate_array(context.heap(), values, 2) {
                Ok(value) => Result::Ok(runtime::Value::Object(value)),
                Err(value) => Result::Err(function_vm_error(value.message)),
            }
        },
    }
}

fn array_iterator_kind_value(kind: ArrayIteratorKind) -> isize {
    match kind {
        ArrayIteratorKind::Keys => 0,
        ArrayIteratorKind::Values => 1,
        ArrayIteratorKind::Entries => 2,
    }
}

fn array_iterator_kind(kind: isize) -> ArrayIteratorKind {
    match kind {
        0 => ArrayIteratorKind::Keys,
        1 => ArrayIteratorKind::Values,
        _ => ArrayIteratorKind::Entries,
    }
}

fn array_iterator_next(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let iterator = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Array Iterator receiver is invalid")),
    };
    let state = match context.array_iterator_state(iterator) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Array Iterator receiver is invalid")),
    };
    if state.done.get() {
        return array_iterator_result(context, runtime::Value::Undefined, true)
    } else {};
    match state.iterable {
        runtime::Value::Object(value) => if runtime::is_typed_array_detached(context.heap(), value)
            || runtime::is_typed_array_out_of_bounds(context.heap(), value) {
            return Result::Err(function_vm_error("TypedArray is out of bounds"))
        } else {},
        _ => (),
    };
    let length = array_iterator_length(context, state.iterable, depth)?;
    let current = state.index.get();
    if current >= length {
        state.done.set(true);
        array_iterator_result(context, runtime::Value::Undefined, true)
    } else {
        state.index.set(current + 1);
        let value = array_iterator_value(
            context,
            array_iterator_kind(state.kind),
            state.iterable,
            current,
            depth,
        )?;
        array_iterator_result(context, value, false)
    }
}

fn array_iterator_prototype(context: vm::Context) -> Result[runtime::ObjectId, vm::VmError] {
    match context.array_iterator_prototype() {
        Some(value) => return Result::Ok(value),
        None => (),
    };
    let prototype = match runtime::new_ordinary_object(
        context.heap(),
        iterator_prototype_from_global(context),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let next = match allocate_vm_function(
        context,
        "Array Iterator.prototype.next",
        |this_value, arguments, depth| {
            array_iterator_next(context, this_value, arguments, depth)
        },
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    if !runtime::define_own_property(
        context.heap(),
        prototype,
        runtime::string_property_key("next"),
        runtime::data_descriptor(next, true, false, true),
    ) {
        return Result::Err(function_vm_error("cannot define Array Iterator next"))
    } else {};
    match define_to_string_tag(context, prototype, "Array Iterator") {
        Ok(()) => (),
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    context.set_array_iterator_prototype(prototype);
    Result::Ok(prototype)
}

fn array_create_iterator(
    context: vm::Context,
    kind: ArrayIteratorKind,
    this_value: runtime::Value,
    validate_typed_array: bool,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => if validate_typed_array
            && (!runtime::is_typed_array(context.heap(), value)
                || runtime::is_typed_array_detached(context.heap(), value)
                || runtime::is_typed_array_out_of_bounds(context.heap(), value)) {
            return Result::Err(function_vm_error("TypedArray is out of bounds"))
        } else {
            this_value
        },
        _ => return Result::Err(function_vm_error("Array iterator requires an Array receiver")),
    };
    let iterator = match runtime::new_ordinary_object(
        context.heap(),
        Option::Some(array_iterator_prototype(context)?),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    context.register_array_iterator(
        iterator,
        object,
        array_iterator_kind_value(kind),
        validate_typed_array,
    );
    Result::Ok(runtime::Value::Object(iterator))
}

fn array_species_getter(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(this_value)
}

fn install_array_prototype(context: vm::Context, constructor: runtime::Value) -> Result[
    runtime::ObjectId,
    BuiltinError,
] {
    let object = function_object(constructor, "Array")?;
    let prototype = match runtime::new_object(
        context.heap(),
        runtime::ObjectKind::Array,
        context.heap().object_prototype(),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_value(context.heap(), prototype, "length", runtime::Value::Int(0), true, false)?;
    define_value(
        context.heap(),
        object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    define_value(context.heap(), prototype, "constructor", constructor, true, true)?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.species]",
                0,
                array_species_getter,
            )?;
            if !runtime::define_own_property(
                context.heap(),
                object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define Array species" })
            } else {}
        },
        None => (),
    };
    define_value(
        context.heap(),
        prototype,
        "at",
        allocate_vm_function(
            context,
            "Array.prototype.at",
            |this_value, arguments, depth| {
                array_builtin_at(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        prototype,
        "toString",
        allocate_vm_function(
            context,
            "Array.prototype.toString",
            |this_value, arguments, depth| {
                array_to_string(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        prototype,
        "toLocaleString",
        allocate_vm_function(
            context,
            "Array.prototype.toLocaleString",
            |this_value, arguments, depth| {
                array_to_locale_string(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, mode) in Vec::from_array(
        [
            ("forEach", ArrayIterationMode::ForEach),
            ("map", ArrayIterationMode::Map),
            ("filter", ArrayIterationMode::Filter),
            ("every", ArrayIterationMode::Every),
            ("some", ArrayIterationMode::Some),
            ("find", ArrayIterationMode::Find),
            ("findIndex", ArrayIterationMode::FindIndex),
            ("findLast", ArrayIterationMode::FindLast),
            ("findLastIndex", ArrayIterationMode::FindLastIndex),
        ],
    ) {
        define_value(
            context.heap(),
            prototype,
            name,
            allocate_vm_function(
                context,
                "Array.prototype." + name,
                |this_value, arguments, depth| {
                    array_iterate(context, mode, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    for (name, callback) in Vec::from_array(
        [
            ("toReversed", array_to_reversed),
            ("toSorted", array_to_sorted),
            ("with", array_with),
            ("toSpliced", array_to_spliced),
            ("fill", array_fill),
            ("copyWithin", array_copy_within),
            ("reverse", array_reverse),
            ("indexOf", array_index_of),
            ("lastIndexOf", array_last_index_of),
            ("includes", array_includes),
            ("push", array_push),
            ("pop", array_pop),
            ("shift", array_shift),
            ("unshift", array_unshift),
            ("sort", array_sort),
            ("join", array_join),
            ("concat", array_concat),
            ("slice", array_slice),
            ("splice", array_splice),
        ],
    ) {
        define_value(
            context.heap(),
            prototype,
            name,
            allocate_vm_function(
                context,
                "Array.prototype." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    for (name, reverse) in Vec::from_array([("reduce", false), ("reduceRight", true)]) {
        define_value(
            context.heap(),
            prototype,
            name,
            allocate_vm_function(
                context,
                "Array.prototype." + name,
                |this_value, arguments, depth| {
                    array_reduce(context, this_value, arguments, reverse, depth)
                },
            )?,
            true,
            true,
        )?
    }
    for (name, map_values) in Vec::from_array([("flat", false), ("flatMap", true)]) {
        define_value(
            context.heap(),
            prototype,
            name,
            allocate_vm_function(
                context,
                "Array.prototype." + name,
                |this_value, arguments, depth| {
                    array_flatten(context, map_values, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    let values = allocate_vm_function(
        context,
        "Array.prototype.values",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            array_create_iterator(context, ArrayIteratorKind::Values, this_value, false)
        },
    )?;
    let keys = allocate_vm_function(
        context,
        "Array.prototype.keys",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            array_create_iterator(context, ArrayIteratorKind::Keys, this_value, false)
        },
    )?;
    let entries = allocate_vm_function(
        context,
        "Array.prototype.entries",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            array_create_iterator(context, ArrayIteratorKind::Entries, this_value, false)
        },
    )?;
    define_value(context.heap(), prototype, "values", values, true, true)?;
    define_value(context.heap(), prototype, "keys", keys, true, true)?;
    define_value(context.heap(), prototype, "entries", entries, true, true)?;
    match context.iterator_symbol() {
        Some(symbol) => if !runtime::define_own_property(
            context.heap(),
            prototype,
            runtime::PropertyKey::Symbol(symbol),
            runtime::data_descriptor(values, true, false, true),
        ) {
            return Result::Err(BuiltinError { message: "cannot define Array iterator" })
        } else {},
        None => (),
    };
    match context.well_known_symbol(vm::WellKnownSymbolKind::Unscopables) {
        Some(symbol) => {
            let unscopables = match runtime::new_null_prototype_object(context.heap()) {
                Ok(value) => value,
                Err(value) => return Result::Err(BuiltinError { message: value.message }),
            };
            for name in Vec::from_array(
                [
                    "at",
                    "copyWithin",
                    "entries",
                    "fill",
                    "find",
                    "findIndex",
                    "findLast",
                    "findLastIndex",
                    "flat",
                    "flatMap",
                    "includes",
                    "keys",
                    "toReversed",
                    "toSorted",
                    "toSpliced",
                    "values",
                ],
            ) {
                if !runtime::define_own_property(
                    context.heap(),
                    unscopables,
                    runtime::string_property_key(name),
                    runtime::data_descriptor(runtime::Value::Bool(true), true, true, true),
                ) {
                    return Result::Err(
                        BuiltinError { message: "cannot define Array unscopables entry" },
                    )
                } else {}
            }
            if !runtime::define_own_property(
                context.heap(),
                prototype,
                runtime::PropertyKey::Symbol(symbol),
                runtime::data_descriptor(runtime::Value::Object(unscopables), false, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define Array unscopables" })
            } else {}
        },
        None => (),
    };
    if context.heap().set_array_prototype(prototype) {
        Result::Ok(prototype)
    } else {
        Result::Err(BuiltinError { message: "cannot install Array prototype" })
    }
}
