package builtins;

use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;

struct ErrorInstall {
    error: runtime::Value,
    internal_error: runtime::Value,
    eval_error: runtime::Value,
    range_error: runtime::Value,
    reference_error: runtime::Value,
    syntax_error: runtime::Value,
    type_error: runtime::Value,
    uri_error: runtime::Value,
    aggregate_error: runtime::Value,
}

fn error_property(context: vm::Context, object: runtime::ObjectId, name: string, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    context.read_property_at_depth(
        runtime::Value::Object(object),
        runtime::Value::String(js_string(name)),
        depth,
    )
}

fn error_string(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::JsString,
    vm::VmError,
] {
    context.value_to_string_at_depth(value, depth)
}

fn error_to_string(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Error.prototype.toString requires an object")),
    };
    let name_value = error_property(context, object, "name", depth)?;
    let name = match name_value {
        runtime::Value::Undefined => js_string("Error"),
        value => error_string(context, value, depth)?,
    };
    let message_value = error_property(context, object, "message", depth)?;
    let message = match message_value {
        runtime::Value::Undefined => js_string(""),
        value => error_string(context, value, depth)?,
    };
    if name.len() == 0 {
        Result::Ok(runtime::Value::String(message))
    } else if message.len() == 0 {
        Result::Ok(runtime::Value::String(name))
    } else {
        Result::Ok(runtime::Value::String(name.concat(js_string(": ")).concat(message)))
    }
}

fn error_is_error(
    context: vm::Context,
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let result = match argument(arguments, 0) {
        runtime::Value::Object(object) => context.error_object_type(object).is_some(),
        _ => false,
    };
    Result::Ok(runtime::Value::Bool(result))
}

fn install_error_cause(
    context: vm::Context,
    object: runtime::ObjectId,
    options: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    match options {
        runtime::Value::Object(_) => {
            let key = runtime::Value::String(js_string("cause"));
            if !context.has_property_at_depth(options, key, depth)? {
                return Result::Ok(())
            }
            let cause = context.read_property_at_depth(options, key, depth)?;
            match define_data(
                context.heap(),
                object,
                runtime::string_property_key("cause"),
                cause,
                true,
                false,
                true,
            ) {
                Ok(()) => Result::Ok(()),
                Err(error) => Result::Err(function_native_error(error)),
            }
        },
        _ => Result::Ok(()),
    }
}

fn error_construct(
    context: vm::Context,
    prototype: runtime::ObjectId,
    message_index: isize,
    options_index: isize,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let object = match allocate_ordinary(context.heap(), Option::Some(prototype)) {
        Ok(value) => value,
        Err(error) => return Result::Err(function_native_error(error)),
    };
    finish_error_object(context, object, message_index, options_index, arguments, depth)
}

fn finish_error_object(
    context: vm::Context,
    object: runtime::ObjectId,
    message_index: isize,
    options_index: isize,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let root = Ref::new(runtime::Value::Object(object));
    context.add_external_root(root);
    let result = initialize_error_object(
        context,
        object,
        message_index,
        options_index,
        arguments,
        depth,
    );
    let _ = context.remove_external_root(root);
    match result {
        Ok(()) => Result::Ok(runtime::Value::Object(object)),
        Err(error) => Result::Err(error),
    }
}

fn register_error_object(context: vm::Context, name: string, result: runtime::Value) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match result {
        runtime::Value::Object(object) => if context.set_error_object_type(object, js_string(name)) {
            Result::Ok(result)
        } else {
            Result::Err(function_vm_error("cannot register Error instance"))
        },
        _ => Result::Ok(result),
    }
}

fn initialize_error_object(
    context: vm::Context,
    object: runtime::ObjectId,
    message_index: isize,
    options_index: isize,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[(), vm::VmError] {
    initialize_error_message(context, object, argument(arguments, message_index), depth)?;
    install_error_cause(context, object, argument(arguments, options_index), depth)
}

fn initialize_error_message(
    context: vm::Context,
    object: runtime::ObjectId,
    message: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    match message {
        runtime::Value::Undefined => (),
        value => match define_data(
            context.heap(),
            object,
            runtime::string_property_key("message"),
            runtime::Value::String(error_string(context, value, depth)?),
            true,
            false,
            true,
        ) {
            Ok(()) => (),
            Err(error) => return Result::Err(function_native_error(error)),
        },
    }
    Result::Ok(())
}

fn aggregate_error_values_rooted(
    context: vm::Context,
    source: runtime::Value,
    depth: isize,
    roots: Vec[Ref[runtime::Value]],
) -> Result[runtime::Value, vm::VmError] {
    let started = collection_iterator_start(context, source, depth)?;
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        match collection_iterator_step(context, started.0, started.1, depth)? {
            Some(value) => {
                let root = Ref::new(value);
                context.add_external_root(root);
                roots.push(root)
            },
            None => {
                let values: Vec[runtime::Value] = Vec::with_capacity(roots.len());
                for root in roots {
                    values.push(root.get())
                }
                return match allocate_array(context.heap(), values, values.len()) {
                    Ok(value) => Result::Ok(runtime::Value::Object(value)),
                    Err(error) => Result::Err(function_native_error(error)),
                }
            },
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        started.0,
        depth,
        function_range_error("AggregateError errors iterable exceeds implementation limit"),
    )
}

fn aggregate_error_values(context: vm::Context, source: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let roots: Vec[Ref[runtime::Value]] = Vec::new();
    let result = aggregate_error_values_rooted(context, source, depth, roots);
    for root in roots {
        let _ = context.remove_external_root(root);
    }
    result
}

fn initialize_aggregate_error_object(
    context: vm::Context,
    object: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[(), vm::VmError] {
    initialize_error_message(context, object, argument(arguments, 1), depth)?;
    install_error_cause(context, object, argument(arguments, 2), depth)?;
    let errors = aggregate_error_values(context, argument(arguments, 0), depth)?;
    match define_data(
        context.heap(),
        object,
        runtime::string_property_key("errors"),
        errors,
        true,
        false,
        true,
    ) {
        Ok(()) => Result::Ok(()),
        Err(error) => Result::Err(function_native_error(error)),
    }
}

fn finish_aggregate_error_object(
    context: vm::Context,
    object: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let root = Ref::new(runtime::Value::Object(object));
    context.add_external_root(root);
    let result = initialize_aggregate_error_object(context, object, arguments, depth);
    let _ = context.remove_external_root(root);
    match result {
        Ok(()) => Result::Ok(runtime::Value::Object(object)),
        Err(error) => Result::Err(error),
    }
}

fn aggregate_error_construct(
    context: vm::Context,
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let object = match allocate_ordinary(context.heap(), Option::Some(prototype)) {
        Ok(value) => value,
        Err(error) => return Result::Err(function_native_error(error)),
    };
    finish_aggregate_error_object(context, object, arguments, depth)
}

fn install_error_type(
    context: vm::Context,
    name: string,
    parent_prototype: Option[runtime::ObjectId],
) -> Result[(runtime::Value, runtime::ObjectId), BuiltinError] {
    let prototype = match allocate_ordinary(context.heap(), parent_prototype) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    match parent_prototype {
        Some(_) => (),
        None => define_value(
            context.heap(),
            prototype,
            "toString",
            allocate_vm_function(
                context,
                "Error.prototype.toString",
                |this_value, arguments, depth| {
                    error_to_string(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?,
    }
    define_value(
        context.heap(),
        prototype,
        "name",
        runtime::Value::String(js_string(name)),
        true,
        true,
    )?;
    define_value(
        context.heap(),
        prototype,
        "message",
        runtime::Value::String(js_string("")),
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        name,
        |this_value, arguments, depth| {
            register_error_object(
                context,
                name,
                error_construct(context, prototype, 0, 1, this_value, arguments, depth)?,
            )
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            constructor_receiver_prototype(context.heap(), receiver, selected_prototype, prototype)?;
            register_error_object(
                context,
                name,
                finish_error_object(context, receiver, 0, 1, arguments, depth)?,
            )
        },
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    let constructor_object = function_object(constructor, name)?;
    if name == "Error" {
        define_value(
            context.heap(),
            constructor_object,
            "isError",
            allocate_function(
                context,
                "Error.isError",
                |heap, this_value, arguments| {
                    error_is_error(context, heap, this_value, arguments)
                },
            )?,
            true,
            true,
        )?
    }
    define_value(
        context.heap(),
        constructor_object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    define_value(context.heap(), prototype, "constructor", constructor, true, true)?;
    Result::Ok((constructor, prototype))
}

fn install_aggregate_error(context: vm::Context, parent_prototype: runtime::ObjectId) -> Result[
    runtime::Value,
    BuiltinError,
] {
    let prototype = match allocate_ordinary(context.heap(), Option::Some(parent_prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_value(
        context.heap(),
        prototype,
        "name",
        runtime::Value::String(js_string("AggregateError")),
        true,
        true,
    )?;
    define_value(
        context.heap(),
        prototype,
        "message",
        runtime::Value::String(js_string("")),
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        "AggregateError",
        |this_value, arguments, depth| {
            let result = aggregate_error_construct(context, prototype, this_value, arguments, depth)?;
            match result {
                runtime::Value::Object(object) => if context.set_error_object_type(
                    object,
                    js_string("AggregateError"),
                ) {
                    Result::Ok(result)
                } else {
                    Result::Err(function_vm_error("cannot register AggregateError instance"))
                },
                _ => Result::Ok(result),
            }
        },
    )?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            constructor_receiver_prototype(context.heap(), receiver, selected_prototype, prototype)?;
            register_error_object(
                context,
                "AggregateError",
                finish_aggregate_error_object(context, receiver, arguments, depth)?,
            )
        },
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    let constructor_object = function_object(constructor, "AggregateError")?;
    define_value(
        context.heap(),
        constructor_object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    define_value(context.heap(), prototype, "constructor", constructor, true, true)?;
    Result::Ok(constructor)
}

fn register_error_prototype(
    context: vm::Context,
    kind: vm::ErrorPrototypeKind,
    prototype: runtime::ObjectId,
) -> Result[(), BuiltinError] {
    match context.set_error_prototype(kind, prototype) {
        Ok(_) => Result::Ok(()),
        Err(value) => Result::Err(BuiltinError { message: value.kind.debug() }),
    }
}

fn set_error_constructor_parent(
    context: vm::Context,
    constructor: runtime::Value,
    parent: runtime::Value,
) -> Result[(), BuiltinError] {
    let object = function_object(constructor, "Error subtype")?;
    let parent_object = function_object(parent, "Error")?;
    if runtime::set_prototype_of(context.heap(), object, Option::Some(parent_object)) {
        Result::Ok(())
    } else {
        Result::Err(BuiltinError { message: "cannot initialize Error constructor inheritance" })
    }
}

fn install_errors(context: vm::Context) -> Result[ErrorInstall, BuiltinError] {
    let (error, error_prototype) = install_error_type(context, "Error", Option::None)?;
    let (internal_error, internal_error_prototype) = install_error_type(
        context,
        "InternalError",
        Option::Some(error_prototype),
    )?;
    let (eval_error, _) = install_error_type(context, "EvalError", Option::Some(error_prototype))?;
    let (range_error, range_error_prototype) = install_error_type(
        context,
        "RangeError",
        Option::Some(error_prototype),
    )?;
    let (reference_error, reference_error_prototype) = install_error_type(
        context,
        "ReferenceError",
        Option::Some(error_prototype),
    )?;
    let (syntax_error, syntax_error_prototype) = install_error_type(
        context,
        "SyntaxError",
        Option::Some(error_prototype),
    )?;
    let (type_error, type_error_prototype) = install_error_type(
        context,
        "TypeError",
        Option::Some(error_prototype),
    )?;
    let (uri_error, uri_error_prototype) = install_error_type(
        context,
        "URIError",
        Option::Some(error_prototype),
    )?;
    let aggregate_error = install_aggregate_error(context, error_prototype)?;
    for constructor in Vec::from_array(
        [
            internal_error,
            eval_error,
            range_error,
            reference_error,
            syntax_error,
            type_error,
            uri_error,
            aggregate_error,
        ],
    ) {
        set_error_constructor_parent(context, constructor, error)?
    }
    register_error_prototype(context, vm::ErrorPrototypeKind::Error, error_prototype)?;
    register_error_prototype(
        context,
        vm::ErrorPrototypeKind::InternalError,
        internal_error_prototype,
    )?;
    register_error_prototype(context, vm::ErrorPrototypeKind::TypeError, type_error_prototype)?;
    register_error_prototype(context, vm::ErrorPrototypeKind::RangeError, range_error_prototype)?;
    register_error_prototype(
        context,
        vm::ErrorPrototypeKind::ReferenceError,
        reference_error_prototype,
    )?;
    register_error_prototype(context, vm::ErrorPrototypeKind::SyntaxError, syntax_error_prototype)?;
    register_error_prototype(context, vm::ErrorPrototypeKind::UriError, uri_error_prototype)?;
    Result::Ok(
        ErrorInstall {
            error,
            internal_error,
            eval_error,
            range_error,
            reference_error,
            syntax_error,
            type_error,
            uri_error,
            aggregate_error,
        },
    )
}
