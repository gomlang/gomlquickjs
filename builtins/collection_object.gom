fn initialize_map(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: int,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Map constructor requires new")),
    };
    let state = collections::JsMap::new();
    states[object] = state;
    let source = argument(arguments, 0);
    match source {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Ok(runtime::Value::Object(object))
        },
        _ => (),
    };
    let adder = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("set")),
        depth,
    )?;
    match adder {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("Map set method is not callable"))
        } else {},
        _ => return Result::Err(function_vm_error("Map set method is not callable")),
    };
    let started = collection_iterator_start(context, source, depth)?;
    let iterator = started.0;
    let next = started.1;
    let mut count = 0;
    while count < 16777216 {
        let entry = match collection_iterator_step(context, iterator, next, depth)? {
            Some(value) => value,
            None => return Result::Ok(runtime::Value::Object(object)),
        };
        match entry {
            runtime::Value::Object(_) => (),
            _ => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error("Map iterator value is not an object"),
                )
            },
        };
        let key = match context.read_property_at_depth(entry, runtime::Value::Int(0), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        let value = match context.read_property_at_depth(entry, runtime::Value::Int(1), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        match context.invoke_with_this_at_depth(adder, Vec::[key, value], this_value, depth) {
            Ok(_) => (),
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_vm_error("Map input exceeds implementation limit"),
    )
}

