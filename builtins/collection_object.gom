    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.species]",
                0,
                array_species_getter,
            )?;
            if !runtime::define_own_property(
                heap,
                object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define Set species" })
            }
        },
        None => (),
    }
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_to_string_tag(context, prototype, "Set")?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            collection_constructor_receiver_prototype(
                context.heap(),
                receiver,
                selected_prototype,
                prototype,
            )?;
            initialize_set(context, states, runtime::Value::Object(receiver), arguments, depth)
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    Result::Ok(constructor)
}

fn install_weak_map(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: std_collections::HashSet[runtime::ObjectId] = std_collections::HashSet::new();
    for (name, function) in Vec::from_array(
        [
            (
                "set",
                allocate_function(
                    context,
                    "WeakMap.prototype.set",
                    |heap, this_value, arguments| {
                        weak_map_set(heap, states, this_value, arguments)
                    },
                )?,
            ),
            (
                "get",
                allocate_function(
                    context,
                    "WeakMap.prototype.get",
                    |heap, this_value, arguments| {
                        weak_map_get(heap, states, this_value, arguments)
                    },
                )?,
            ),
        ],
    ) {
        define_value(heap, prototype, name, function, true, true)?
    }
    define_value(
        heap,
        prototype,
        "getOrInsert",
        allocate_vm_function(
            context,
            "WeakMap.prototype.getOrInsert",
            |this_value, arguments, depth| {
                weak_map_get_or_insert(context, states, false, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "getOrInsertComputed",
        allocate_vm_function(
            context,
            "WeakMap.prototype.getOrInsertComputed",
            |this_value, arguments, depth| {
                weak_map_get_or_insert(context, states, true, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, function) in Vec::from_array(
        [
            (
                "has",
                allocate_function(
                    context,
                    "WeakMap.prototype.has",
                    |heap, this_value, arguments| {
                        weak_map_has(heap, states, this_value, arguments)
                    },
                )?,
            ),
            (
                "delete",
                allocate_function(
                    context,
                    "WeakMap.prototype.delete",
                    |heap, this_value, arguments| {
                        weak_map_delete(heap, states, this_value, arguments)
                    },
                )?,
            ),
        ],
    ) {
        define_value(heap, prototype, name, function, true, true)?
    }
    let constructor = allocate_vm_function(
        context,
        "WeakMap",
        |this_value, arguments, depth| {
            initialize_weak_map(context, states, this_value, arguments, depth)
        },
    )?;
    let object = function_object(constructor, "WeakMap")?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_to_string_tag(context, prototype, "WeakMap")?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            collection_constructor_receiver_prototype(
                context.heap(),
                receiver,
                selected_prototype,
                prototype,
            )?;
            initialize_weak_map(context, states, runtime::Value::Object(receiver), arguments, depth)
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    Result::Ok(constructor)
}

fn install_weak_set(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: std_collections::HashSet[runtime::ObjectId] = std_collections::HashSet::new();
    define_to_string_tag(context, prototype, "WeakSet")?;
    for (name, function) in Vec::from_array(
        [
            (
                "add",
                allocate_function(
                    context,
                    "WeakSet.prototype.add",
                    |heap, this_value, arguments| {
                        weak_set_add(heap, states, this_value, arguments)
                    },
                )?,
            ),
            (
                "has",
                allocate_function(
                    context,
