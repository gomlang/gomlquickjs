        define_value(heap, prototype, name, function, true, true)?
    }
    let constructor = allocate_vm_function(
        context,
        "WeakSet",
        |this_value, arguments, depth| {
            initialize_weak_set(context, states, this_value, arguments, depth)
        },
    )?;
    let object = function_object(constructor, "WeakSet")?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            collection_constructor_receiver_prototype(
                context.heap(),
                receiver,
                selected_prototype,
                prototype,
            )?;
            initialize_weak_set(context, states, runtime::Value::Object(receiver), arguments, depth)
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    Result::Ok(constructor)
}

fn install_weak_ref(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: std_collections::HashSet[runtime::ObjectId] = std_collections::HashSet::new();
    define_to_string_tag(context, prototype, "WeakRef")?;
    define_value(
        heap,
        prototype,
        "deref",
        allocate_vm_function(
            context,
            "WeakRef.prototype.deref",
            |this_value, arguments, depth| {
                let _ = depth;
                weak_ref_deref(context, states, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        "WeakRef",
        |this_value, arguments, depth| {
            initialize_weak_ref(context, states, this_value, arguments, depth)
        },
    )?;
    let object = function_object(constructor, "WeakRef")?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            collection_constructor_receiver_prototype(
                context.heap(),
                receiver,
                selected_prototype,
                prototype,
            )?;
            initialize_weak_ref(context, states, runtime::Value::Object(receiver), arguments, depth)
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    Result::Ok(constructor)
}

fn install_finalization_registry(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let callback_name = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_to_string_tag(context, prototype, "FinalizationRegistry")?;
    define_value(
        heap,
        prototype,
        "register",
        allocate_function(
            context,
            "FinalizationRegistry.prototype.register",
            |heap, this_value, arguments| {
                finalization_registry_register(heap, callback_name, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "unregister",
        allocate_function(
            context,
            "FinalizationRegistry.prototype.unregister",
            |heap, this_value, arguments| {
                finalization_registry_unregister(heap, callback_name, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    let constructor = allocate_vm_function(
        context,
        "FinalizationRegistry",
        |this_value, arguments, depth| {
            initialize_finalization_registry(context, callback_name, this_value, arguments, depth)
        },
    )?;
    let object = function_object(constructor, "FinalizationRegistry")?;
    if !runtime::define_private_field(
        heap,
        object,
        callback_name,
        runtime::Value::Object(callback_name),
    ) {
        return Result::Err(BuiltinError { message: "cannot root FinalizationRegistry state" })
    }
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            collection_constructor_receiver_prototype(
                context.heap(),
                receiver,
                selected_prototype,
                prototype,
            )?;
            initialize_finalization_registry(
                context,
                callback_name,
                runtime::Value::Object(receiver),
                arguments,
                depth,
            )
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    Result::Ok(constructor)
}

fn install_collections(context: vm::Context, iterator_constructor: runtime::Value) -> Result[
    CollectionInstall,
    BuiltinError,
] {
    let iterator_constructor_object = function_object(iterator_constructor, "Iterator")?;
    let iterator_prototype = match runtime::get_property(
        context.heap(),
        iterator_constructor_object,
        runtime::string_property_key("prototype"),
    ) {
        Ok(Some(runtime::Value::Object(value))) => value,
        _ => return Result::Err(BuiltinError { message: "Iterator prototype is invalid" }),
    };
    let map = install_map(context, iterator_prototype)?;
    let map_constructor = map.constructor;
    let set = install_set(context, map, iterator_prototype)?;
    Result::Ok(
        CollectionInstall {
            map: map_constructor,
            set,
            weak_map: install_weak_map(context)?,
            weak_set: install_weak_set(context)?,
            weak_ref: install_weak_ref(context)?,
            finalization_registry: install_finalization_registry(context)?,
        },
    )
}
