fn initialize_weak_map(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, bool],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: int,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("WeakMap constructor requires new")),
    };
    states[object] = true;
    let source = argument(arguments, 0);
    match source {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Ok(runtime::Value::Object(object))
        },
        _ => (),
    };
    let adder = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("set")),
        depth,
    )?;
    match adder {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("WeakMap set method is not callable"))
        } else {},
        _ => return Result::Err(function_vm_error("WeakMap set method is not callable")),
    };
    let started = collection_iterator_start(context, source, depth)?;
    let iterator = started.0;
    let next = started.1;
    let mut count = 0;
    while count < 16777216 {
        let entry = match collection_iterator_step(context, iterator, next, depth)? {
            Some(value) => value,
            None => return Result::Ok(runtime::Value::Object(object)),
        };
        match entry {
            runtime::Value::Object(_) => (),
            _ => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error("WeakMap iterator value is not an object"),
                )
            },
        };
        let key = match context.read_property_at_depth(entry, runtime::Value::Int(0), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        let value = match context.read_property_at_depth(entry, runtime::Value::Int(1), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        match context.invoke_with_this_at_depth(adder, Vec::[key, value], this_value, depth) {
            Ok(_) => (),
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_vm_error("WeakMap input exceeds implementation limit"),
    )
}

fn initialize_weak_set(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, bool],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: int,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("WeakSet constructor requires new")),
    };
    states[object] = true;
    let source = argument(arguments, 0);
    match source {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Ok(runtime::Value::Object(object))
        },
        _ => (),
    };
    let adder = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("add")),
        depth,
    )?;
    match adder {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("WeakSet add method is not callable"))
        } else {},
        _ => return Result::Err(function_vm_error("WeakSet add method is not callable")),
    };
    let started = collection_iterator_start(context, source, depth)?;
    let iterator = started.0;
    let next = started.1;
    let mut count = 0;
    while count < 16777216 {
        match collection_iterator_step(context, iterator, next, depth)? {
            Some(value) => match context.invoke_with_this_at_depth(
                adder,
                Vec::[value],
                this_value,
                depth,
            ) {
                Ok(_) => (),
                Err(value) => {
                    return collection_close_with_error(context, iterator, depth, value)
                },
            },
            None => return Result::Ok(runtime::Value::Object(object)),
        };
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_vm_error("WeakSet input exceeds implementation limit"),
    )
}

fn initialize_weak_ref(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, bool],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: int,
) -> Result[runtime::Value, vm::VmError] {
    let _ = depth;
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("WeakRef constructor requires new")),
    };
    if runtime::weak_ref_set(context.heap(), object, argument(arguments, 0)) {
        states[object] = true;
        Result::Ok(runtime::Value::Object(object))
    } else {
        Result::Err(function_vm_error("WeakRef target must be an object or symbol"))
    }
}

fn initialize_finalization_registry(
    context: vm::Context,
    callback_name: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: int,
) -> Result[runtime::Value, vm::VmError] {
    let _ = depth;
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => {
            return Result::Err(function_vm_error("FinalizationRegistry constructor requires new"))
        },
    };
    let callback = argument(arguments, 0);
    match callback {
        runtime::Value::Object(value) => if value.is_callable() && context.heap().contains(value) {
            if runtime::define_private_field(context.heap(), object, callback_name, callback) {
                Result::Ok(runtime::Value::Object(object))
            } else {
                Result::Err(function_vm_error("cannot initialize FinalizationRegistry"))
            }
        } else {
            Result::Err(function_vm_error("FinalizationRegistry callback is not callable"))
        },
        _ => Result::Err(function_vm_error("FinalizationRegistry callback is not callable")),
    }
}

fn install_map(context: vm::Context) -> Result[MapInstallData, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, collections::JsMap] = HashMap::{};
    define_value(
        heap,
        prototype,
        "set",
        allocate_function(
            context,
            "Map.prototype.set",
            |heap, this_value, arguments| {
                map_set(heap, states, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "get",
        allocate_function(
            context,
            "Map.prototype.get",
            |heap, this_value, arguments| {
                map_get(heap, states, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "getOrInsert",
        allocate_vm_function(
            context,
            "Map.prototype.getOrInsert",
            |this_value, arguments, depth| {
                map_get_or_insert(context, states, false, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "getOrInsertComputed",
        allocate_vm_function(
            context,
            "Map.prototype.getOrInsertComputed",
            |this_value, arguments, depth| {
                map_get_or_insert(context, states, true, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, function) in Vec::[
        (
            "has",
            allocate_function(
                context,
                "Map.prototype.has",
                |heap, this_value, arguments| {
                    map_has(heap, states, this_value, arguments)
                },
            )?,
        ),
        (
            "delete",
            allocate_function(
                context,
                "Map.prototype.delete",
                |heap, this_value, arguments| {
                    map_delete(heap, states, this_value, arguments)
                },
            )?,
        ),
        (
            "clear",
            allocate_function(
                context,
                "Map.prototype.clear",
                |heap, this_value, arguments| {
                    map_clear(heap, states, this_value, arguments)
                },
            )?,
        ),
    ] {
        define_value(heap, prototype, name, function, true, true)?
    }
    let size = allocate_function(
        context,
        "get Map.prototype.size",
        |heap, this_value, arguments| {
            map_size(heap, states, this_value, arguments)
        },
    )?;
    if !runtime::define_own_property(
        heap,
        prototype,
        runtime::string_property_key("size"),
        runtime::accessor_descriptor(Option::Some(size), Option::None, false, true),
    ) {
        return Result::Err(BuiltinError { message: "cannot define Map size" })
    } else {};
    let entries = allocate_vm_function(
        context,
        "Map.prototype.entries",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            create_map_iterator(context, states, MapIteratorKind::Entries, this_value)
        },
    )?;
    let keys = allocate_vm_function(
        context,
        "Map.prototype.keys",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            create_map_iterator(context, states, MapIteratorKind::Keys, this_value)
        },
    )?;
    let values = allocate_vm_function(
        context,
        "Map.prototype.values",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            create_map_iterator(context, states, MapIteratorKind::Values, this_value)
        },
    )?;
    define_value(
        heap,
        prototype,
        "forEach",
        allocate_vm_function(
            context,
            "Map.prototype.forEach",
            |this_value, arguments, depth| {
                map_for_each(context, states, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(heap, prototype, "values", values, true, true)?;
    define_value(heap, prototype, "keys", keys, true, true)?;
    define_value(heap, prototype, "entries", entries, true, true)?;
    match context.iterator_symbol() {
        Some(symbol) => if !runtime::define_own_property(
            heap,
            prototype,
            runtime::PropertyKey::Symbol(symbol),
            runtime::data_descriptor(entries, true, false, true),
        ) {
            return Result::Err(BuiltinError { message: "cannot define Map iterator" })
        } else {},
        None => (),
    };
    let constructor = allocate_vm_function(
        context,
        "Map",
        |this_value, arguments, depth| {
            initialize_map(context, states, this_value, arguments, depth)
        },
    )?;
    let object = function_object(constructor, "Map")?;
    define_value(
        heap,
        object,
        "groupBy",
        allocate_vm_function(
            context,
            "Map.groupBy",
            |this_value, arguments, depth| {
                map_group_by(context, states, prototype, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.species]",
                0,
                array_species_getter,
            )?;
            if !runtime::define_own_property(
                heap,
                object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define Map species" })
            } else {}
        },
        None => (),
    };
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_to_string_tag(context, prototype, "Map")?;
    mark_constructor(context, constructor, "Map")?;
    Result::Ok(MapInstallData { constructor, prototype, states })
}

fn install_set(context: vm::Context, map: MapInstallData) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, collections::JsSet] = HashMap::{};
    for (name, function) in Vec::[
        (
            "add",
            allocate_function(
                context,
                "Set.prototype.add",
                |heap, this_value, arguments| {
                    set_add(heap, states, this_value, arguments)
                },
            )?,
        ),
        (
            "has",
            allocate_function(
                context,
                "Set.prototype.has",
                |heap, this_value, arguments| {
                    set_has(heap, states, this_value, arguments)
                },
            )?,
        ),
        (
            "delete",
            allocate_function(
                context,
                "Set.prototype.delete",
                |heap, this_value, arguments| {
                    set_delete(heap, states, this_value, arguments)
                },
            )?,
        ),
        (
            "clear",
            allocate_function(
                context,
                "Set.prototype.clear",
                |heap, this_value, arguments| {
                    set_clear(heap, states, this_value, arguments)
                },
            )?,
        ),
    ] {
        define_value(heap, prototype, name, function, true, true)?
    }
    let size = allocate_function(
        context,
        "get Set.prototype.size",
        |heap, this_value, arguments| {
            set_size(heap, states, this_value, arguments)
        },
    )?;
    if !runtime::define_own_property(
        heap,
        prototype,
        runtime::string_property_key("size"),
        runtime::accessor_descriptor(Option::Some(size), Option::None, false, true),
    ) {
        return Result::Err(BuiltinError { message: "cannot define Set size" })
    } else {};
    let values = allocate_vm_function(
        context,
        "Set.prototype.values",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            create_set_iterator(context, states, SetIteratorKind::Values, this_value)
        },
    )?;
    let entries = allocate_vm_function(
        context,
        "Set.prototype.entries",
        |this_value, arguments, depth| {
            let _ = arguments;
            let _ = depth;
            create_set_iterator(context, states, SetIteratorKind::Entries, this_value)
        },
    )?;
    define_value(
        heap,
        prototype,
        "forEach",
        allocate_vm_function(
            context,
            "Set.prototype.forEach",
            |this_value, arguments, depth| {
                set_for_each(context, states, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, function) in Vec::[
        (
            "isDisjointFrom",
            allocate_vm_function(
                context,
                "Set.prototype.isDisjointFrom",
                |this_value, arguments, depth| {
                    set_is_disjoint_from(context, states, this_value, arguments, depth)
                },
            )?,
        ),
        (
            "isSubsetOf",
            allocate_vm_function(
                context,
                "Set.prototype.isSubsetOf",
                |this_value, arguments, depth| {
                    set_is_subset_of(context, states, this_value, arguments, depth)
                },
            )?,
        ),
        (
            "isSupersetOf",
            allocate_vm_function(
                context,
                "Set.prototype.isSupersetOf",
                |this_value, arguments, depth| {
                    set_is_superset_of(context, states, this_value, arguments, depth)
                },
            )?,
        ),
        (
            "intersection",
            allocate_vm_function(
                context,
                "Set.prototype.intersection",
                |this_value, arguments, depth| {
                    set_intersection(context, states, prototype, this_value, arguments, depth)
                },
            )?,
        ),
        (
            "difference",
            allocate_vm_function(
                context,
                "Set.prototype.difference",
                |this_value, arguments, depth| {
                    set_difference(context, states, prototype, this_value, arguments, depth)
                },
            )?,
        ),
        (
            "symmetricDifference",
            allocate_vm_function(
                context,
                "Set.prototype.symmetricDifference",
                |this_value, arguments, depth| {
                    set_symmetric_difference(
                        context,
                        states,
                        prototype,
                        this_value,
                        arguments,
                        depth,
                    )
                },
            )?,
        ),
        (
            "union",
            allocate_vm_function(
                context,
                "Set.prototype.union",
                |this_value, arguments, depth| {
                    set_union(context, states, prototype, this_value, arguments, depth)
                },
            )?,
        ),
    ] {
        define_value(heap, prototype, name, function, true, true)?
    }
    define_value(heap, prototype, "values", values, true, true)?;
    define_value(heap, prototype, "keys", values, true, true)?;
    define_value(heap, prototype, "entries", entries, true, true)?;
    match context.iterator_symbol() {
        Some(symbol) => if !runtime::define_own_property(
            heap,
            prototype,
            runtime::PropertyKey::Symbol(symbol),
            runtime::data_descriptor(values, true, false, true),
        ) {
            return Result::Err(BuiltinError { message: "cannot define Set iterator" })
        } else {},
        None => (),
    };
    let constructor = allocate_vm_function(
        context,
        "Set",
        |this_value, arguments, depth| {
            initialize_set(context, states, this_value, arguments, depth)
        },
    )?;
    let object = function_object(constructor, "Set")?;
    define_value(
        heap,
        object,
        "groupBy",
        allocate_vm_function(
            context,
            "Set.groupBy",
            |this_value, arguments, depth| {
                map_group_by(context, map.states, map.prototype, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.species]",
                0,
                array_species_getter,
            )?;
            if !runtime::define_own_property(
                heap,
                object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(BuiltinError { message: "cannot define Set species" })
            } else {}
        },
        None => (),
    };
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_to_string_tag(context, prototype, "Set")?;
    mark_constructor(context, constructor, "Set")?;
    Result::Ok(constructor)
}

fn install_weak_map(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let heap = context.heap();
    let prototype = match allocate_ordinary(heap, heap.object_prototype()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let states: HashMap[runtime::ObjectId, bool] = HashMap::{};
    for (name, function) in Vec::[
        (
            "set",
            allocate_function(
                context,
                "WeakMap.prototype.set",
                |heap, this_value, arguments| {
                    weak_map_set(heap, states, this_value, arguments)
                },
            )?,
        ),
        (
            "get",
            allocate_function(
                context,
                "WeakMap.prototype.get",
                |heap, this_value, arguments| {
                    weak_map_get(heap, states, this_value, arguments)
                },
            )?,
        ),
    ] {
        define_value(heap, prototype, name, function, true, true)?
    }
    define_value(
        heap,
        prototype,
        "getOrInsert",
        allocate_vm_function(
            context,
            "WeakMap.prototype.getOrInsert",
            |this_value, arguments, depth| {
                weak_map_get_or_insert(context, states, false, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "getOrInsertComputed",
        allocate_vm_function(
            context,
            "WeakMap.prototype.getOrInsertComputed",
            |this_value, arguments, depth| {
                weak_map_get_or_insert(context, states, true, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, function) in Vec::[
        (
            "has",
            allocate_function(
                context,
                "WeakMap.prototype.has",
                |heap, this_value, arguments| {
                    weak_map_has(heap, states, this_value, arguments)
                },
            )?,
        ),
        (
            "delete",
            allocate_function(
                context,
                "WeakMap.prototype.delete",
                |heap, this_value, arguments| {
                    weak_map_delete(heap, states, this_value, arguments)
                },
            )?,
        ),
    ] {
        define_value(heap, prototype, name, function, true, true)?
    }
    let constructor = allocate_vm_function(
        context,
        "WeakMap",
        |this_value, arguments, depth| {
            initialize_weak_map(context, states, this_value, arguments, depth)
        },
    )?;
    let object = function_object(constructor, "WeakMap")?;
    define_value(heap, object, "prototype", runtime::Value::Object(prototype), false, false)?;
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    define_to_string_tag(context, prototype, "WeakMap")?;
    mark_constructor(context, constructor, "WeakMap")?;
    Result::Ok(constructor)
}

