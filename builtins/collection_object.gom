package builtins;

use gomlang::quickjs::arrayx;
use gomlang::quickjs::collections;
use gomlang::quickjs::dtoa;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::math;
use std::num;
use std::collections as std_collections;

struct MapInstallData {
    constructor: runtime::Value,
    prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, collections::JsMap],
}

struct SetRecord {
    object: runtime::Value,
    size: isize,
    has: runtime::Value,
    keys: runtime::Value,
}

struct CollectionInstall {
    map: runtime::Value,
    set: runtime::Value,
    weak_map: runtime::Value,
    weak_set: runtime::Value,
    weak_ref: runtime::Value,
    finalization_registry: runtime::Value,
}

fn collection_object(value: runtime::Value, kind: string) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    match value {
        runtime::Value::Object(value) => Result::Ok(value),
        _ => Result::Err(native_error(kind + " method called on incompatible receiver")),
    }
}

fn collection_constructor_receiver_prototype(
    heap: runtime::Heap,
    receiver: runtime::ObjectId,
    selected: Option[runtime::ObjectId],
    prototype: runtime::ObjectId,
) -> Result[(), vm::VmError] {
    match selected {
        Some(_) => Result::Ok(()),
        None => if runtime::set_prototype_of(heap, receiver, Option::Some(prototype)) {
            Result::Ok(())
        } else {
            Result::Err(function_vm_error("cannot initialize collection prototype"))
        },
    }
}

fn map_state(states: HashMap[runtime::ObjectId, collections::JsMap], value: runtime::Value) -> Result[
    collections::JsMap,
    vm::NativeError,
] {
    let object = collection_object(value, "Map")?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error("Map method called on incompatible receiver")),
    }
}

fn set_state(states: HashMap[runtime::ObjectId, collections::JsSet], value: runtime::Value) -> Result[
    collections::JsSet,
    vm::NativeError,
] {
    let object = collection_object(value, "Set")?;
    match states.get(object) {
        Some(value) => Result::Ok(value),
        None => Result::Err(native_error("Set method called on incompatible receiver")),
    }
}

fn weak_map_state(states: std_collections::HashSet[runtime::ObjectId], value: runtime::Value) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    let object = collection_object(value, "WeakMap")?;
    if states.contains(object) {
        Result::Ok(object)
    } else {
        Result::Err(native_error("WeakMap method called on incompatible receiver"))
    }
}

fn weak_set_state(states: std_collections::HashSet[runtime::ObjectId], value: runtime::Value) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    let object = collection_object(value, "WeakSet")?;
    if states.contains(object) {
        Result::Ok(object)
    } else {
        Result::Err(native_error("WeakSet method called on incompatible receiver"))
    }
}

fn weak_ref_state(states: std_collections::HashSet[runtime::ObjectId], value: runtime::Value) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    let object = collection_object(value, "WeakRef")?;
    if states.contains(object) {
        Result::Ok(object)
    } else {
        Result::Err(native_error("WeakRef method called on incompatible receiver"))
    }
}

fn map_get(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    match map_state(states, this_value)?.get(argument(arguments, 0)) {
        Some(value) => Result::Ok(value),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn map_set(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    map_state(states, this_value)?.set(argument(arguments, 0), argument(arguments, 1));
    Result::Ok(this_value)
}

fn collection_callable(value: runtime::Value, message: string) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match value {
        runtime::Value::Object(object) => if object.is_callable() {
            Result::Ok(value)
        } else {
            Result::Err(function_vm_error(message))
        },
        _ => Result::Err(function_vm_error(message)),
    }
}

fn map_get_or_insert(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    computed: bool,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match map_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let callback: Option[runtime::Value] = if computed {
        Option::Some(collection_callable(argument(arguments, 1), "not a function")?)
    } else {
        Option::None
    };
    let key = collections::canonical_key(argument(arguments, 0));
    match state.get(key) {
        Some(value) => Result::Ok(value),
        None => {
            let value = match callback {
                Some(callback) => {
                    let value = context.invoke_with_this_at_depth(
                        callback,
                        Vec::from_array([key]),
                        runtime::Value::Undefined,
                        depth,
                    )?;
                    let _ = state.delete(key);
                    value
                },
                None => argument(arguments, 1),
            };
            state.set(key, value);
            Result::Ok(value)
        },
    }
}

fn map_has(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    Result::Ok(runtime::Value::Bool(map_state(states, this_value)?.has(argument(arguments, 0))))
}

fn map_delete(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    Result::Ok(runtime::Value::Bool(map_state(states, this_value)?.delete(argument(arguments, 0))))
}

fn map_clear(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    map_state(states, this_value)?.clear();
    Result::Ok(runtime::Value::Undefined)
}

fn map_size(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(array_length_value(map_state(states, this_value)?.size()))
}

fn pair_array(heap: runtime::Heap, key: runtime::Value, value: runtime::Value) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let object = allocate_array(heap, Vec::from_array([key, value]), 2)?;
    Result::Ok(runtime::Value::Object(object))
}

fn set_add(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    set_state(states, this_value)?.add(argument(arguments, 0));
    Result::Ok(this_value)
}

fn set_has(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    Result::Ok(runtime::Value::Bool(set_state(states, this_value)?.has(argument(arguments, 0))))
}

fn set_delete(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    Result::Ok(runtime::Value::Bool(set_state(states, this_value)?.delete(argument(arguments, 0))))
}

fn set_clear(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    set_state(states, this_value)?.clear();
    Result::Ok(runtime::Value::Undefined)
}

fn set_size(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    Result::Ok(array_length_value(set_state(states, this_value)?.size()))
}

fn weak_map_get(
    heap: runtime::Heap,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    match runtime::weak_map_get(heap, weak_map_state(states, this_value)?, argument(arguments, 0)) {
        Some(value) => Result::Ok(value),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn weak_map_set(
    heap: runtime::Heap,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    if runtime::weak_map_set(
        heap,
        weak_map_state(states, this_value)?,
        argument(arguments, 0),
        argument(arguments, 1),
    ) {
        Result::Ok(this_value)
    } else {
        Result::Err(native_error("WeakMap key must be an object or symbol"))
    }
}

fn weak_map_has(
    heap: runtime::Heap,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    Result::Ok(
        runtime::Value::Bool(
            runtime::weak_map_has(heap, weak_map_state(states, this_value)?, argument(arguments, 0)),
        ),
    )
}

fn weak_map_delete(
    heap: runtime::Heap,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    Result::Ok(
        runtime::Value::Bool(
            runtime::weak_map_delete(
                heap,
                weak_map_state(states, this_value)?,
                argument(arguments, 0),
            ),
        ),
    )
}

fn weak_map_get_or_insert(
    context: vm::Context,
    states: std_collections::HashSet[runtime::ObjectId],
    computed: bool,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match weak_map_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let callback: Option[runtime::Value] = if computed {
        Option::Some(collection_callable(argument(arguments, 1), "not a function")?)
    } else {
        Option::None
    };
    let key = argument(arguments, 0);
    if !runtime::is_weak_target(context.heap(), key) {
        return Result::Err(function_vm_error("invalid value used as WeakMap key"))
    }
    match runtime::weak_map_get(context.heap(), object, key) {
        Some(value) => Result::Ok(value),
        None => {
            let value = match callback {
                Some(callback) => {
                    let value = context.invoke_with_this_at_depth(
                        callback,
                        Vec::from_array([key]),
                        runtime::Value::Undefined,
                        depth,
                    )?;
                    let _ = runtime::weak_map_delete(context.heap(), object, key);
                    value
                },
                None => argument(arguments, 1),
            };
            if runtime::weak_map_set(context.heap(), object, key, value) {
                Result::Ok(value)
            } else {
                Result::Err(function_vm_error("invalid value used as WeakMap key"))
            }
        },
    }
}

fn weak_set_add(
    heap: runtime::Heap,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    if runtime::weak_set_add(heap, weak_set_state(states, this_value)?, argument(arguments, 0)) {
        Result::Ok(this_value)
    } else {
        Result::Err(native_error("WeakSet value must be an object or symbol"))
    }
}

fn weak_set_has(
    heap: runtime::Heap,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    Result::Ok(
        runtime::Value::Bool(
            runtime::weak_set_has(heap, weak_set_state(states, this_value)?, argument(arguments, 0)),
        ),
    )
}

fn weak_set_delete(
    heap: runtime::Heap,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    Result::Ok(
        runtime::Value::Bool(
            runtime::weak_set_delete(
                heap,
                weak_set_state(states, this_value)?,
                argument(arguments, 0),
            ),
        ),
    )
}

fn weak_ref_deref(
    context: vm::Context,
    states: std_collections::HashSet[runtime::ObjectId],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let owner = match weak_ref_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let _ = context.collect_garbage();
    match runtime::weak_ref_deref(context.heap(), owner) {
        Some(value) => Result::Ok(value),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn finalization_registry_callback(
    heap: runtime::Heap,
    callback_name: runtime::ObjectId,
    value: runtime::Value,
) -> Result[(runtime::ObjectId, runtime::Value), vm::NativeError] {
    let object = collection_object(value, "FinalizationRegistry")?;
    match runtime::private_element(heap, object, callback_name) {
        Some(runtime::PrivateElement::Field(callback)) => Result::Ok((object, callback)),
        _ => Result::Err(
            native_error("FinalizationRegistry method called on incompatible receiver"),
        ),
    }
}

fn finalization_registry_register(
    heap: runtime::Heap,
    callback_name: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let state = finalization_registry_callback(heap, callback_name, this_value)?;
    let target = argument(arguments, 0);
    let held = argument(arguments, 1);
    if !runtime::is_weak_target(heap, target) {
        return Result::Err(native_error("FinalizationRegistry target is invalid"))
    } else if runtime::same_value(target, held) {
        return Result::Err(native_error("FinalizationRegistry held value cannot be the target"))
    }
    let token = match argument(arguments, 2) {
        runtime::Value::Undefined => Option::None,
        value => if runtime::is_weak_target(heap, value) {
            Option::Some(value)
        } else {
            return Result::Err(native_error("FinalizationRegistry unregister token is invalid"))
        },
    };
    if runtime::finalization_register(heap, state.0, state.1, target, held, token) {
        Result::Ok(runtime::Value::Undefined)
    } else {
        Result::Err(native_error("cannot register FinalizationRegistry target"))
    }
}

fn finalization_registry_unregister(
    heap: runtime::Heap,
    callback_name: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let state = finalization_registry_callback(heap, callback_name, this_value)?;
    let token = argument(arguments, 0);
    match runtime::finalization_unregister(heap, state.0, token) {
        Some(value) => Result::Ok(runtime::Value::Bool(value)),
        None => Result::Err(native_error("FinalizationRegistry unregister token is invalid")),
    }
}

enum MapIteratorKind {
    Keys,
    Values,
    Entries,
}

enum SetIteratorKind {
    Values,
    Entries,
}

struct MapIteratorState {
    source: runtime::ObjectId,
    index: Ref[isize],
    done: Ref[bool],
    kind: isize,
}

struct SetIteratorState {
    source: runtime::ObjectId,
    index: Ref[isize],
    done: Ref[bool],
    kind: isize,
}

fn map_collection_gc_edges(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    iterator_states: HashMap[runtime::ObjectId, MapIteratorState],
) -> Vec[runtime::GcEdge] {
    let edges: Vec[runtime::GcEdge] = Vec::new();
    let stale: Vec[runtime::ObjectId] = Vec::new();
    for (object, state) in states.entries() {
        if heap.contains(object) {
            let values: Vec[runtime::Value] = Vec::new();
            for entry in state.entries() {
                values.push(entry.key);
                values.push(entry.value)
            }
            edges.push(runtime::GcEdge { owner: object, values })
        } else {
            stale.push(object)
        }
    }
    for object in stale {
        let _ = states.remove(object);
    }
    let stale_iterators: Vec[runtime::ObjectId] = Vec::new();
    for (object, state) in iterator_states.entries() {
        if heap.contains(object) {
            edges.push(
                runtime::GcEdge {
                    owner: object,
                    values: Vec::from_array([runtime::Value::Object(state.source)]),
                },
            )
        } else {
            stale_iterators.push(object)
        }
    }
    for object in stale_iterators {
        let _ = iterator_states.remove(object);
    }
    edges
}

fn set_collection_gc_edges(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    iterator_states: HashMap[runtime::ObjectId, SetIteratorState],
) -> Vec[runtime::GcEdge] {
    let edges: Vec[runtime::GcEdge] = Vec::new();
    let stale: Vec[runtime::ObjectId] = Vec::new();
    for (object, state) in states.entries() {
        if heap.contains(object) {
            edges.push(runtime::GcEdge { owner: object, values: state.values() })
        } else {
            stale.push(object)
        }
    }
    for object in stale {
        let _ = states.remove(object);
    }
    let stale_iterators: Vec[runtime::ObjectId] = Vec::new();
    for (object, state) in iterator_states.entries() {
        if heap.contains(object) {
            edges.push(
                runtime::GcEdge {
                    owner: object,
                    values: Vec::from_array([runtime::Value::Object(state.source)]),
                },
            )
        } else {
            stale_iterators.push(object)
        }
    }
    for object in stale_iterators {
        let _ = iterator_states.remove(object);
    }
    edges
}

fn map_iterator_value(context: vm::Context, kind: MapIteratorKind, entry: collections::MapEntry) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match kind {
        MapIteratorKind::Keys => Result::Ok(entry.key),
        MapIteratorKind::Values => Result::Ok(entry.value),
        MapIteratorKind::Entries => match pair_array(context.heap(), entry.key, entry.value) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_vm_error(value.message)),
        },
    }
}

fn map_iterator_kind_value(kind: MapIteratorKind) -> isize {
    match kind {
        MapIteratorKind::Keys => 0,
        MapIteratorKind::Values => 1,
        MapIteratorKind::Entries => 2,
    }
}

fn map_iterator_kind(kind: isize) -> MapIteratorKind {
    match kind {
        0 => MapIteratorKind::Keys,
        1 => MapIteratorKind::Values,
        _ => MapIteratorKind::Entries,
    }
}

fn map_iterator_next(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    iterator_states: HashMap[runtime::ObjectId, MapIteratorState],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let iterator = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Map iterator has an invalid receiver")),
    };
    let iterator_state = match iterator_states.get(iterator) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Map iterator has an invalid receiver")),
    };
    if iterator_state.done.get() {
        return array_iterator_result(context, runtime::Value::Undefined, true)
    }
    let state = match states.get(iterator_state.source) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Map iterator has an invalid receiver")),
    };
    while iterator_state.index.get() < state.slot_len() {
        let current = iterator_state.index.get();
        iterator_state.index.set(current + 1);
        match state.entry_at(current) {
            Some(entry) => {
                return array_iterator_result(
                    context,
                    map_iterator_value(context, map_iterator_kind(iterator_state.kind), entry)?,
                    false,
                )
            },
            None => (),
        }
    }
    iterator_state.done.set(true);
    array_iterator_result(context, runtime::Value::Undefined, true)
}

fn install_map_iterator_prototype(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    iterator_states: HashMap[runtime::ObjectId, MapIteratorState],
    base_prototype: runtime::ObjectId,
) -> Result[runtime::ObjectId, BuiltinError] {
    let prototype = match allocate_ordinary(context.heap(), Option::Some(base_prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_value(
        context.heap(),
        prototype,
        "next",
        allocate_vm_function(
            context,
            "Map Iterator.prototype.next",
            |this_value, arguments, depth| {
                let _ = depth;
                map_iterator_next(context, states, iterator_states, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    define_to_string_tag(context, prototype, "Map Iterator")?;
    Result::Ok(prototype)
}

fn create_map_iterator(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    iterator_states: HashMap[runtime::ObjectId, MapIteratorState],
    iterator_prototype: runtime::ObjectId,
    kind: MapIteratorKind,
    this_value: runtime::Value,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Map method called on incompatible receiver")),
    };
    if states.get(object).is_none() {
        return Result::Err(function_vm_error("Map method called on incompatible receiver"))
    }
    let iterator = match allocate_ordinary(context.heap(), Option::Some(iterator_prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    iterator_states[iterator] = MapIteratorState {
        source: object,
        index: Ref::new(0),
        done: Ref::new(false),
        kind: map_iterator_kind_value(kind),
    };
    Result::Ok(runtime::Value::Object(iterator))
}

fn set_iterator_value(context: vm::Context, kind: SetIteratorKind, value: runtime::Value) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match kind {
        SetIteratorKind::Values => Result::Ok(value),
        SetIteratorKind::Entries => match pair_array(context.heap(), value, value) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_vm_error(value.message)),
        },
    }
}

fn set_iterator_kind_value(kind: SetIteratorKind) -> isize {
    match kind {
        SetIteratorKind::Values => 0,
        SetIteratorKind::Entries => 1,
    }
}

fn set_iterator_kind(kind: isize) -> SetIteratorKind {
    if kind == 0 {
        SetIteratorKind::Values
    } else {
        SetIteratorKind::Entries
    }
}

fn set_iterator_next(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    iterator_states: HashMap[runtime::ObjectId, SetIteratorState],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let iterator = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Set iterator has an invalid receiver")),
    };
    let iterator_state = match iterator_states.get(iterator) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Set iterator has an invalid receiver")),
    };
    if iterator_state.done.get() {
        return array_iterator_result(context, runtime::Value::Undefined, true)
    }
    let state = match states.get(iterator_state.source) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Set iterator has an invalid receiver")),
    };
    while iterator_state.index.get() < state.slot_len() {
        let current = iterator_state.index.get();
        iterator_state.index.set(current + 1);
        match state.value_at(current) {
            Some(value) => {
                return array_iterator_result(
                    context,
                    set_iterator_value(context, set_iterator_kind(iterator_state.kind), value)?,
                    false,
                )
            },
            None => (),
        }
    }
    iterator_state.done.set(true);
    array_iterator_result(context, runtime::Value::Undefined, true)
}

fn install_set_iterator_prototype(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    iterator_states: HashMap[runtime::ObjectId, SetIteratorState],
    base_prototype: runtime::ObjectId,
) -> Result[runtime::ObjectId, BuiltinError] {
    let prototype = match allocate_ordinary(context.heap(), Option::Some(base_prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_value(
        context.heap(),
        prototype,
        "next",
        allocate_vm_function(
            context,
            "Set Iterator.prototype.next",
            |this_value, arguments, depth| {
                let _ = depth;
                set_iterator_next(context, states, iterator_states, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    define_to_string_tag(context, prototype, "Set Iterator")?;
    Result::Ok(prototype)
}

fn create_set_iterator(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    iterator_states: HashMap[runtime::ObjectId, SetIteratorState],
    iterator_prototype: runtime::ObjectId,
    kind: SetIteratorKind,
    this_value: runtime::Value,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Set method called on incompatible receiver")),
    };
    if states.get(object).is_none() {
        return Result::Err(function_vm_error("Set method called on incompatible receiver"))
    }
    let iterator = match allocate_ordinary(context.heap(), Option::Some(iterator_prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    iterator_states[iterator] = SetIteratorState {
        source: object,
        index: Ref::new(0),
        done: Ref::new(false),
        kind: set_iterator_kind_value(kind),
    };
    Result::Ok(runtime::Value::Object(iterator))
}

fn collection_callback(arguments: Vec[runtime::Value], kind: string) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let callback = argument(arguments, 0);
    match callback {
        runtime::Value::Object(object) => if object.is_callable() {
            Result::Ok(callback)
        } else {
            Result::Err(function_vm_error(kind + ".prototype.forEach callback is not callable"))
        },
        _ => {
            Result::Err(function_vm_error(kind + ".prototype.forEach callback is not callable"))
        },
    }
}

fn map_for_each(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match collection_object(this_value, "Map") {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let state = match states.get(object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Map method called on incompatible receiver")),
    };
    let callback = collection_callback(arguments, "Map")?;
    let receiver = argument(arguments, 1);
    let mut index = 0;
    while index < state.slot_len() {
        match state.entry_at(index) {
            Some(entry) => {
                let _ = context.invoke_with_this_at_depth(
                    callback,
                    Vec::from_array([entry.value, entry.key, this_value]),
                    receiver,
                    depth,
                )?;
            },
            None => (),
        }
        index += 1;
    }
    Result::Ok(runtime::Value::Undefined)
}

fn set_for_each(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match collection_object(this_value, "Set") {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let state = match states.get(object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("Set method called on incompatible receiver")),
    };
    let callback = collection_callback(arguments, "Set")?;
    let receiver = argument(arguments, 1);
    let mut index = 0;
    while index < state.slot_len() {
        match state.value_at(index) {
            Some(value) => {
                let _ = context.invoke_with_this_at_depth(
                    callback,
                    Vec::from_array([value, value, this_value]),
                    receiver,
                    depth,
                )?;
            },
            None => (),
        }
        index += 1;
    }
    Result::Ok(runtime::Value::Undefined)
}

fn collection_iterator_start(context: vm::Context, source: runtime::Value, depth: isize) -> Result[
    (runtime::Value, runtime::Value),
    vm::VmError,
] {
    let symbol = match context.iterator_symbol() {
        Some(value) => value,
        None => return Result::Err(function_vm_error("iterator symbol is not installed")),
    };
    let method = context.read_property_at_depth(source, runtime::Value::Symbol(symbol), depth)?;
    match method {
        runtime::Value::Object(object) => if !object.is_callable() {
            return Result::Err(function_vm_error("iterator method is not callable"))
        },
        _ => return Result::Err(function_vm_error("value is not iterable")),
    }
    let arguments: Vec[runtime::Value] = Vec::new();
    let iterator = context.invoke_with_this_at_depth(method, arguments, source, depth)?;
    match iterator {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("iterator result is not an object")),
    }
    let next = context.read_property_at_depth(
        iterator,
        runtime::Value::String(js_string("next")),
        depth,
    )?;
    match next {
        runtime::Value::Object(object) => if object.is_callable() {
            Result::Ok((iterator, next))
        } else {
            Result::Err(function_vm_error("iterator next is not callable"))
        },
        _ => Result::Err(function_vm_error("iterator next is not callable")),
    }
}

fn collection_iterator_step(
    context: vm::Context,
    iterator: runtime::Value,
    next: runtime::Value,
    depth: isize,
) -> Result[Option[runtime::Value], vm::VmError] {
    let arguments: Vec[runtime::Value] = Vec::new();
    let result = context.invoke_with_this_at_depth(next, arguments, iterator, depth)?;
    match result {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("iterator next result is not an object")),
    }
    let done = context.read_property_at_depth(
        result,
        runtime::Value::String(js_string("done")),
        depth,
    )?;
    if runtime::to_boolean(done) {
        Result::Ok(Option::None)
    } else {
        match context.read_property_at_depth(
            result,
            runtime::Value::String(js_string("value")),
            depth,
        ) {
            Ok(value) => Result::Ok(Option::Some(value)),
            Err(value) => Result::Err(value),
        }
    }
}

fn collection_close_with_error(
    context: vm::Context,
    iterator: runtime::Value,
    depth: isize,
    value: vm::VmError,
) -> Result[runtime::Value, vm::VmError] {
    let _ = array_from_close(context, iterator, depth);
    Result::Err(value)
}

fn map_result(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    prototype: runtime::ObjectId,
) -> Result[(runtime::Value, collections::JsMap), vm::VmError] {
    let object = match allocate_ordinary(heap, Option::Some(prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let state = collections::JsMap::new();
    states[object] = state;
    Result::Ok((runtime::Value::Object(object), state))
}

fn map_group_by(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let callback = collection_callable(argument(arguments, 1), "not a function")?;
    let started = collection_iterator_start(context, argument(arguments, 0), depth)?;
    let iterator = started.0;
    let next = started.1;
    let result: (runtime::Value, collections::JsMap) = map_result(context.heap(), states, prototype)?;
    let output = result.0;
    let state = result.1;
    let callback_this = match context.global_object() {
        Some(value) => runtime::Value::Object(value),
        None => runtime::Value::Undefined,
    };
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        let item = match collection_iterator_step(context, iterator, next, depth) {
            Ok(Some(value)) => value,
            Ok(None) => return Result::Ok(output),
            Err(value) => return Result::Err(value),
        };
        let key = match context.invoke_with_this_at_depth(
            callback,
            Vec::from_array([item, array_length_value(count)]),
            callback_this,
            depth,
        ) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        let group = match state.get(key) {
            Some(runtime::Value::Object(value)) => value,
            Some(_) => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error("Map.groupBy group is not an Array"),
                )
            },
            None => {
                let value = match allocate_array(context.heap(), Vec::new(), 0) {
                    Ok(value) => value,
                    Err(value) => {
                        return collection_close_with_error(
                            context,
                            iterator,
                            depth,
                            function_native_error(value),
                        )
                    },
                };
                state.set(key, runtime::Value::Object(value));
                value
            },
        };
        match arrayx::push(context.heap(), group, Vec::from_array([item])) {
            Ok(_) => (),
            Err(value) => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error(value.to_string()),
                )
            },
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_range_error("Map.groupBy input exceeds implementation limit"),
    )
}

fn set_record_size(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let number = match number_value_at_depth(context, value, depth)? {
        runtime::Value::Float(value) => value,
        _ => 0.0,
    };
    if math::is_nan(number) {
        Result::Err(function_vm_error(".size is not a number"))
    } else if number < 0.0 {
        Result::Err(function_range_error(".size must be positive"))
    } else if !math::is_finite(number) || number >= 9007199254740991.0 {
        Result::Ok(9007199254740991)
    } else {
        Result::Ok(
            num::parse_int_structured(dtoa::number_to_string(math::trunc(number))).unwrap_or(0),
        )
    }
}

fn set_record_callable(value: runtime::Value, name: string) -> Result[runtime::Value, vm::VmError] {
    match value {
        runtime::Value::Undefined => Result::Err(function_vm_error("." + name + " is undefined")),
        runtime::Value::Object(object) => if object.is_callable() {
            Result::Ok(value)
        } else {
            Result::Err(function_vm_error("." + name + " is not a function"))
        },
        _ => Result::Err(function_vm_error("." + name + " is not a function")),
    }
}

fn get_set_record(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    SetRecord,
    vm::VmError,
] {
    let size_value = context.read_property_at_depth(
        value,
        runtime::Value::String(js_string("size")),
        depth,
    )?;
    let size = set_record_size(context, size_value, depth)?;
    let has = set_record_callable(
        context.read_property_at_depth(value, runtime::Value::String(js_string("has")), depth)?,
        "has",
    )?;
    let keys = set_record_callable(
        context.read_property_at_depth(value, runtime::Value::String(js_string("keys")), depth)?,
        "keys",
    )?;
    Result::Ok(SetRecord { object: value, size, has, keys })
}

fn set_record_has(context: vm::Context, record: SetRecord, value: runtime::Value, depth: isize) -> Result[
    bool,
    vm::VmError,
] {
    Result::Ok(
        runtime::to_boolean(
            context.invoke_with_this_at_depth(
                record.has,
                Vec::from_array([value]),
                record.object,
                depth,
            )?,
        ),
    )
}

fn set_record_iterator(context: vm::Context, record: SetRecord, depth: isize) -> Result[
    (runtime::Value, runtime::Value),
    vm::VmError,
] {
    let arguments: Vec[runtime::Value] = Vec::new();
    let iterator = context.invoke_with_this_at_depth(record.keys, arguments, record.object, depth)?;
    match iterator {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("set-like keys result is not an object")),
    }
    let next = set_record_callable(
        context.read_property_at_depth(iterator, runtime::Value::String(js_string("next")), depth)?,
        "next",
    )?;
    Result::Ok((iterator, next))
}

fn set_result(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    prototype: runtime::ObjectId,
) -> Result[(runtime::Value, collections::JsSet), vm::VmError] {
    let object = match allocate_ordinary(heap, Option::Some(prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let state = collections::JsSet::new();
    states[object] = state;
    Result::Ok((runtime::Value::Object(object), state))
}

fn set_copy_result(
    heap: runtime::Heap,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    prototype: runtime::ObjectId,
    source: collections::JsSet,
) -> Result[(runtime::Value, collections::JsSet), vm::VmError] {
    let result: (runtime::Value, collections::JsSet) = set_result(heap, states, prototype)?;
    for value in source.values() {
        result.1.add(value)
    }
    Result::Ok(result)
}

fn set_is_disjoint_from(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match set_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let record = get_set_record(context, argument(arguments, 0), depth)?;
    if state.size() <= record.size {
        let mut index = 0;
        while index < state.slot_len() {
            match state.value_at(index) {
                Some(value) => if set_record_has(context, record, value, depth)? {
                    return Result::Ok(runtime::Value::Bool(false))
                },
                None => (),
            }
            index += 1;
        }
    } else {
        let started = set_record_iterator(context, record, depth)?;
        let mut count = 0;
        while count < ARRAY_FROM_LIMIT {
            match collection_iterator_step(context, started.0, started.1, depth)? {
                Some(value) => if state.has(value) {
                    array_from_close(context, started.0, depth)?;
                    return Result::Ok(runtime::Value::Bool(false))
                },
                None => return Result::Ok(runtime::Value::Bool(true)),
            }
            count += 1;
        }
        return collection_close_with_error(
            context,
            started.0,
            depth,
            function_range_error("set-like keys iterator exceeds implementation limit"),
        )
    }
    Result::Ok(runtime::Value::Bool(true))
}

fn set_is_subset_of(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match set_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let record = get_set_record(context, argument(arguments, 0), depth)?;
    if state.size() > record.size {
        return Result::Ok(runtime::Value::Bool(false))
    }
    let mut index = 0;
    while index < state.slot_len() {
        match state.value_at(index) {
            Some(value) => if !set_record_has(context, record, value, depth)? {
                return Result::Ok(runtime::Value::Bool(false))
            },
            None => (),
        }
        index += 1;
    }
    Result::Ok(runtime::Value::Bool(true))
}

fn set_is_superset_of(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match set_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let record = get_set_record(context, argument(arguments, 0), depth)?;
    if state.size() < record.size {
        return Result::Ok(runtime::Value::Bool(false))
    }
    let started = set_record_iterator(context, record, depth)?;
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        match collection_iterator_step(context, started.0, started.1, depth)? {
            Some(value) => if !state.has(value) {
                array_from_close(context, started.0, depth)?;
                return Result::Ok(runtime::Value::Bool(false))
            },
            None => return Result::Ok(runtime::Value::Bool(true)),
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        started.0,
        depth,
        function_range_error("set-like keys iterator exceeds implementation limit"),
    )
}

fn set_intersection(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match set_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let record = get_set_record(context, argument(arguments, 0), depth)?;
    let result = set_result(context.heap(), states, prototype)?;
    if state.size() > record.size {
        let started = set_record_iterator(context, record, depth)?;
        let mut count = 0;
        while count < ARRAY_FROM_LIMIT {
            match collection_iterator_step(context, started.0, started.1, depth)? {
                Some(value) => if state.has(value) {
                    result.1.add(value)
                },
                None => return Result::Ok(result.0),
            }
            count += 1;
        }
        collection_close_with_error(
            context,
            started.0,
            depth,
            function_range_error("set-like keys iterator exceeds implementation limit"),
        )
    } else {
        let mut index = 0;
        while index < state.slot_len() {
            match state.value_at(index) {
                Some(value) => if set_record_has(context, record, value, depth)? {
                    result.1.add(value)
                },
                None => (),
            }
            index += 1;
        }
        Result::Ok(result.0)
    }
}

fn set_difference(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match set_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let record = get_set_record(context, argument(arguments, 0), depth)?;
    let result = set_copy_result(context.heap(), states, prototype, state)?;
    if state.size() <= record.size {
        let mut index = 0;
        while index < result.1.slot_len() {
            match result.1.value_at(index) {
                Some(value) => if set_record_has(context, record, value, depth)? {
                    let _ = result.1.delete(value);
                },
                None => (),
            }
            index += 1;
        }
        Result::Ok(result.0)
    } else {
        let started = set_record_iterator(context, record, depth)?;
        let mut count = 0;
        while count < ARRAY_FROM_LIMIT {
            match collection_iterator_step(context, started.0, started.1, depth)? {
                Some(value) => {
                    let _ = result.1.delete(value);
                },
                None => return Result::Ok(result.0),
            }
            count += 1;
        }
        collection_close_with_error(
            context,
            started.0,
            depth,
            function_range_error("set-like keys iterator exceeds implementation limit"),
        )
    }
}

fn set_symmetric_difference(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match set_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let record = get_set_record(context, argument(arguments, 0), depth)?;
    let started = set_record_iterator(context, record, depth)?;
    let result = set_copy_result(context.heap(), states, prototype, state)?;
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        match collection_iterator_step(context, started.0, started.1, depth)? {
            Some(value) => if state.has(value) {
                let _ = result.1.delete(value);
            } else if !result.1.has(value) {
                result.1.add(value)
            },
            None => return Result::Ok(result.0),
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        started.0,
        depth,
        function_range_error("set-like keys iterator exceeds implementation limit"),
    )
}

fn set_union(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsSet],
    prototype: runtime::ObjectId,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = match set_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let record = get_set_record(context, argument(arguments, 0), depth)?;
    let started = set_record_iterator(context, record, depth)?;
    let result = set_copy_result(context.heap(), states, prototype, state)?;
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        match collection_iterator_step(context, started.0, started.1, depth)? {
            Some(value) => result.1.add(value),
            None => return Result::Ok(result.0),
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        started.0,
        depth,
        function_range_error("set-like keys iterator exceeds implementation limit"),
    )
}

fn initialize_map(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, collections::JsMap],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match this_value {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(function_vm_error("Map constructor requires new")),
    };
    let state = collections::JsMap::new();
    states[object] = state;
    let source = argument(arguments, 0);
    match source {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Ok(runtime::Value::Object(object))
        },
        _ => (),
    }
    let adder = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("set")),
        depth,
    )?;
    match adder {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("Map set method is not callable"))
        },
        _ => return Result::Err(function_vm_error("Map set method is not callable")),
    }
    let started = collection_iterator_start(context, source, depth)?;
    let iterator = started.0;
    let next = started.1;
    let mut count = 0;
    while count < 16777216 {
        let entry = match collection_iterator_step(context, iterator, next, depth)? {
            Some(value) => value,
            None => return Result::Ok(runtime::Value::Object(object)),
        };
        match entry {
            runtime::Value::Object(_) => (),
            _ => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error("Map iterator value is not an object"),
                )
            },
        }
        let key = match context.read_property_at_depth(entry, runtime::Value::Int(0), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        let value = match context.read_property_at_depth(entry, runtime::Value::Int(1), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        match context.invoke_with_this_at_depth(
            adder,
            Vec::from_array([key, value]),
            this_value,
            depth,
        ) {
            Ok(_) => (),
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_vm_error("Map input exceeds implementation limit"),
    )
}

