package builtins;

use gomlang::quickjs::dtoa;
use gomlang::quickjs::json;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::collections;
use std::math;
use std::num;

fn json_builtin_callable(value: runtime::Value) -> bool {
    match value {
        runtime::Value::Object(value) => value.is_callable(),
        _ => false,
    }
}

fn json_builtin_allocate_object(heap: runtime::Heap) -> Result[runtime::ObjectId, vm::VmError] {
    match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn json_builtin_define(
    heap: runtime::Heap,
    object: runtime::ObjectId,
    key: runtime::JsString,
    value: runtime::Value,
) -> Result[(), vm::VmError] {
    if runtime::define_own_property(
        heap,
        object,
        runtime::PropertyKey::String(key),
        runtime::data_descriptor(value, true, true, true),
    ) {
        Result::Ok(())
    } else {
        Result::Err(function_vm_error("cannot define JSON property"))
    }
}

fn json_builtin_enumerable_keys(context: vm::Context, object: runtime::ObjectId, depth: isize) -> Result[
    Vec[runtime::JsString],
    vm::VmError,
] {
    let keys: Vec[runtime::JsString] = Vec::new();
    for key in proxy_own_key_values_at_depth(context, object, depth)? {
        match key {
            runtime::Value::String(name) => match proxy_get_own_property_descriptor_at_depth(
                context,
                object,
                runtime::PropertyKey::String(name),
                depth,
            )? {
                Some(descriptor) => if runtime::descriptor_enumerable(descriptor) {
                    keys.push(name)
                },
                None => (),
            },
            _ => (),
        }
    }
    Result::Ok(keys)
}

fn json_builtin_is_array(context: vm::Context, object: runtime::ObjectId) -> Result[
    bool,
    vm::VmError,
] {
    let value = match context.heap().get(object) {
        Some(value) => value,
        None => return Result::Err(function_vm_error("JSON object is invalid")),
    };
    if value.is_proxy() {
        match value.proxy_target() {
            Some(target) => json_builtin_is_array(context, target),
            None => Result::Err(function_vm_error("proxy has been revoked")),
        }
    } else {
        match value.kind() {
            runtime::ObjectKind::Array => Result::Ok(true),
            runtime::ObjectKind::Ordinary | runtime::ObjectKind::Function => Result::Ok(false),
        }
    }
}

fn json_builtin_array_length(context: vm::Context, object: runtime::ObjectId, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let value = context.read_property_at_depth(
        runtime::Value::Object(object),
        runtime::Value::String(js_string("length")),
        depth,
    )?;
    let number = match number_value_at_depth(context, value, depth)? {
        runtime::Value::Float(value) => value,
        _ => return Result::Err(function_vm_error("invalid JSON array length")),
    };
    if math::is_nan(number) || number <= 0.0 {
        Result::Ok(0)
    } else if math::is_finite(number) && number <= 4294967295.0 {
        match num::parse_int_structured(dtoa::number_to_string(math::floor(number))) {
            Ok(value) => Result::Ok(value),
            Err(_) => Result::Err(function_vm_error("invalid JSON array length")),
        }
    } else {
        Result::Err(function_vm_error("invalid JSON array length"))
    }
}

fn json_builtin_update_revived_property(
    context: vm::Context,
    object: runtime::ObjectId,
    name: runtime::JsString,
    value: runtime::Value,
    depth: isize,
) -> Result[(), vm::VmError] {
    let key = runtime::Value::String(name);
    match value {
        runtime::Value::Undefined => {
            let _ = context.delete_property_at_depth(runtime::Value::Object(object), key, depth)?;
            Result::Ok(())
        },
        _ => {
            let _ = proxy_define_property_at_depth(
                context,
                object,
                runtime::PropertyKey::String(name),
                runtime::data_descriptor(value, true, true, true),
                Option::None,
                depth,
            )?;
            Result::Ok(())
        },
    }
}

fn json_builtin_revive(
    context: vm::Context,
    sources: json::JsonParseSources,
    holder: runtime::ObjectId,
    key: runtime::JsString,
    reviver: runtime::Value,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let value = context.read_property_at_depth(
        runtime::Value::Object(holder),
        runtime::Value::String(key),
        depth,
    )?;
    let reviver_context = json_builtin_allocate_object(context.heap())?;
    match value {
        runtime::Value::Object(object) => {
            if json_builtin_is_array(context, object)? {
                let length = json_builtin_array_length(context, object, depth)?;
                let mut index = 0;
                while index < length {
                    let name = js_string(index.to_string());
                    let revived = json_builtin_revive(
                        context,
                        sources,
                        object,
                        name,
                        reviver,
                        depth,
                    )?;
                    json_builtin_update_revived_property(context, object, name, revived, depth)?;
                    index += 1;
                }
            } else {
                let keys = json_builtin_enumerable_keys(context, object, depth)?;
                for name in keys {
                    let revived = json_builtin_revive(
                        context,
                        sources,
                        object,
                        name,
                        reviver,
                        depth,
                    )?;
                    json_builtin_update_revived_property(context, object, name, revived, depth)?
                }
            }
        },
        _ => (),
    }
    match sources.source_for(holder, runtime::PropertyKey::String(key), value) {
        Some(source) => json_builtin_define(
            context.heap(),
            reviver_context,
            js_string("source"),
            runtime::Value::String(source),
        )?,
        None => (),
    }
    context.invoke_with_this_at_depth(
        reviver,
        Vec::from_array(
            [runtime::Value::String(key), value, runtime::Value::Object(reviver_context)],
        ),
        runtime::Value::Object(holder),
        depth,
    )
}

fn json_builtin_error_offset(error: json::JsonError) -> isize {
    if error.offset > 0
        && (error.message == "invalid string escape" || error.message == "invalid Unicode escape"
            || error.message == "unescaped control character in string") {
        error.offset - 1
    } else {
        error.offset
    }
}

fn json_builtin_error_stack(source: runtime::JsString, error: json::JsonError) -> runtime::JsString {
    let target = json_builtin_error_offset(error);
    let mut line = 1;
    let mut column = 1;
    let mut index = 0;
    while index < target && index < source.len() {
        if source.get(index) == 10 {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
        index += 1;
    }
    js_string("    at <input>:" + line.to_string() + ":" + column.to_string())
}

fn json_builtin_syntax_error(
    context: vm::Context,
    source: runtime::JsString,
    error: json::JsonError,
    depth: isize,
) -> vm::VmError {
    let fallback = function_syntax_error(error.to_string());
    let global = match context.global_object() {
        Some(value) => value,
        None => return fallback,
    };
    let constructor = match runtime::get_property(
        context.heap(),
        global,
        runtime::string_property_key("SyntaxError"),
    ) {
        Ok(Some(value)) => value,
        _ => return fallback,
    };
    let value = match context.invoke_with_this_at_depth(
        constructor,
        Vec::from_array([runtime::Value::String(js_string(error.to_string()))]),
        runtime::Value::Undefined,
        depth,
    ) {
        Ok(value) => value,
        Err(_) => return fallback,
    };
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return fallback,
    };
    if !runtime::define_own_property(
        context.heap(),
        object,
        runtime::string_property_key("stack"),
        runtime::data_descriptor(
            runtime::Value::String(json_builtin_error_stack(source, error)),
            true,
            false,
            true,
        ),
    ) {
        fallback
    } else {
        vm::VmError { offset: -1, kind: vm::VmErrorKind::Thrown(value) }
    }
}

fn json_builtin_parse(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let source = match string_value_at_depth(context, argument(arguments, 0), depth)? {
        runtime::Value::String(value) => value,
        _ => return Result::Err(function_vm_error("JSON source is not a string")),
    };
    let parsed = match json::parse_with_sources(context.heap(), source) {
        Ok(value) => value,
        Err(value) => return Result::Err(json_builtin_syntax_error(context, source, value, depth)),
    };
    let value = parsed.value;
    let reviver = argument(arguments, 1);
    if !json_builtin_callable(reviver) {
        return Result::Ok(value)
    }
    let root = json_builtin_allocate_object(context.heap())?;
    let empty = js_string("");
    json_builtin_define(context.heap(), root, empty, value)?;
    let sources = parsed.sources();
    sources.attach_root(root, runtime::PropertyKey::String(empty));
    json_builtin_revive(context, sources, root, empty, reviver, depth)
}

fn json_builtin_append_ascii(output: Vec[u16], value: string) -> () {
    let bytes = value.to_bytes();
    let mut index = 0;
    while index < bytes.len() {
        output.push(bytes[index].to_u16());
        index += 1;
    }
}

fn json_builtin_append_string(output: Vec[u16], value: runtime::JsString) -> () {
    let mut index = 0;
    while index < value.len() {
        output.push(value.get(index));
        index += 1;
    }
}

fn json_builtin_hex(value: u16) -> u16 {
    if value < 10 {
        48 + value
    } else {
        87 + value
    }
}

fn json_builtin_append_escape(output: Vec[u16], value: u16) -> () {
    output.push(92);
    output.push(117);
    output.push(json_builtin_hex((value >> 12) & 15));
    output.push(json_builtin_hex((value >> 8) & 15));
    output.push(json_builtin_hex((value >> 4) & 15));
    output.push(json_builtin_hex(value & 15));
}

fn json_builtin_append_quoted(output: Vec[u16], value: runtime::JsString) -> () {
    output.push(34);
    let mut index = 0;
    while index < value.len() {
        let current = value.get(index);
        if current == 34 || current == 92 {
            output.push(92);
            output.push(current);
        } else if current == 8 {
            json_builtin_append_ascii(output, "\\b")
        } else if current == 9 {
            json_builtin_append_ascii(output, "\\t")
        } else if current == 10 {
            json_builtin_append_ascii(output, "\\n")
        } else if current == 12 {
            json_builtin_append_ascii(output, "\\f")
        } else if current == 13 {
            json_builtin_append_ascii(output, "\\r")
        } else if current < 0x20 {
            json_builtin_append_escape(output, current)
        } else if runtime::is_high_surrogate(current) {
            if index + 1 < value.len() && runtime::is_low_surrogate(value.get(index + 1)) {
                output.push(current);
                output.push(value.get(index + 1));
                index += 1;
            } else {
                json_builtin_append_escape(output, current)
            }
        } else if runtime::is_low_surrogate(current) {
            json_builtin_append_escape(output, current)
        } else {
            output.push(current)
        }
        index += 1;
    }
    output.push(34);
}

fn json_builtin_append_indent(output: Vec[u16], gap: runtime::JsString, nesting: isize) -> () {
    let mut current = 0;
    while current < nesting {
        json_builtin_append_string(output, gap);
        current += 1;
    }
}

fn json_builtin_raw_character(value: u16) -> bool {
    (value >= 97 && value <= 122) || (value >= 48 && value <= 57) || value == 45 || value == 34
}

fn json_builtin_is_raw_json(
    context: vm::Context,
    raw_values: HashMap[runtime::ObjectId, runtime::JsString],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let _ = depth;
    let result = match argument(arguments, 0) {
        runtime::Value::Object(object) => {
            context.heap().contains(object) && raw_values.get(object).is_some()
        },
        _ => false,
    };
    Result::Ok(runtime::Value::Bool(result))
}

fn json_builtin_raw_json(
    context: vm::Context,
    raw_values: HashMap[runtime::ObjectId, runtime::JsString],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let source = match string_value_at_depth(context, argument(arguments, 0), depth)? {
        runtime::Value::String(value) => value,
        _ => return Result::Err(function_vm_error("raw JSON source is not a string")),
    };
    if source.len() == 0 || !json_builtin_raw_character(source.get(0))
        || !json_builtin_raw_character(source.get(source.len() - 1)) {
        return Result::Err(function_syntax_error("invalid rawJSON string"))
    }
    match json::parse(context.heap(), source) {
        Ok(runtime::Value::Object(_)) => {
            return Result::Err(function_syntax_error("invalid rawJSON string"))
        },
        Ok(_) => (),
        Err(_) => return Result::Err(function_syntax_error("invalid rawJSON string")),
    }
    let object = match runtime::new_null_prototype_object(context.heap()) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    if !runtime::define_own_property(
        context.heap(),
        object,
        runtime::string_property_key("rawJSON"),
        runtime::data_descriptor(runtime::Value::String(source), false, true, false),
    )
        || !runtime::prevent_extensions(context.heap(), object) {
        return Result::Err(function_vm_error("cannot create raw JSON object"))
    }
    raw_values[object] = source;
    Result::Ok(runtime::Value::Object(object))
}

fn json_builtin_unbox(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    match value {
        runtime::Value::Object(object) => match runtime::primitive_value(context.heap(), object) {
            Some(runtime::Value::Bool(value)) => Result::Ok(runtime::Value::Bool(value)),
            Some(runtime::Value::Int(_)) | Some(runtime::Value::Float(_)) => {
                number_value_at_depth(context, value, depth)
            },
            Some(runtime::Value::String(_)) => string_value_at_depth(context, value, depth),
            Some(runtime::Value::BigInt(value)) => Result::Ok(runtime::Value::BigInt(value)),
            _ => Result::Ok(runtime::Value::Object(object)),
        },
        _ => Result::Ok(value),
    }
}

fn json_builtin_object_keys(
    context: vm::Context,
    object: runtime::ObjectId,
    property_list: Option[Vec[runtime::JsString]],
    depth: isize,
) -> Result[Vec[runtime::JsString], vm::VmError] {
    match property_list {
        Some(value) => Result::Ok(value),
        None => json_builtin_enumerable_keys(context, object, depth),
    }
}

fn json_builtin_write_array(
    context: vm::Context,
    raw_values: HashMap[runtime::ObjectId, runtime::JsString],
    object: runtime::ObjectId,
    replacer: Option[runtime::Value],
    property_list: Option[Vec[runtime::JsString]],
    gap: runtime::JsString,
    nesting: isize,
    stack: collections::HashSet[runtime::ObjectId],
    output: Vec[u16],
    depth: isize,
) -> Result[(), vm::VmError] {
    let length = json_builtin_array_length(context, object, depth)?;
    output.push(91);
    let mut index = 0;
    while index < length {
        if index > 0 {
            output.push(44)
        }
        if gap.len() > 0 {
            output.push(10);
            json_builtin_append_indent(output, gap, nesting + 1)
        }
        let element: Vec[u16] = Vec::new();
        if json_builtin_write_property(
            context,
            raw_values,
            js_string(index.to_string()),
            object,
            replacer,
            property_list,
            gap,
            nesting + 1,
            stack,
            element,
            depth,
        )? {
            for value in element {
                output.push(value)
            }
        } else {
            json_builtin_append_ascii(output, "null")
        }
        index += 1;
    }
    if length > 0 && gap.len() > 0 {
        output.push(10);
        json_builtin_append_indent(output, gap, nesting)
    }
    output.push(93);
    Result::Ok(())
}

fn json_builtin_write_object(
    context: vm::Context,
    raw_values: HashMap[runtime::ObjectId, runtime::JsString],
    object: runtime::ObjectId,
    replacer: Option[runtime::Value],
    property_list: Option[Vec[runtime::JsString]],
    gap: runtime::JsString,
    nesting: isize,
    stack: collections::HashSet[runtime::ObjectId],
    output: Vec[u16],
    depth: isize,
) -> Result[(), vm::VmError] {
    output.push(123);
    let keys = json_builtin_object_keys(context, object, property_list, depth)?;
    let mut count = 0;
    for key in keys {
        let property: Vec[u16] = Vec::new();
        if json_builtin_write_property(
            context,
            raw_values,
            key,
            object,
            replacer,
            property_list,
            gap,
            nesting + 1,
            stack,
            property,
            depth,
        )? {
            if count > 0 {
                output.push(44)
            }
            if gap.len() > 0 {
                output.push(10);
                json_builtin_append_indent(output, gap, nesting + 1)
            }
            json_builtin_append_quoted(output, key);
            output.push(58);
            if gap.len() > 0 {
                output.push(32)
            }
            for value in property {
                output.push(value)
            }
            count += 1;
        }
    }
    if count > 0 && gap.len() > 0 {
        output.push(10);
        json_builtin_append_indent(output, gap, nesting)
    }
    output.push(125);
    Result::Ok(())
}

fn json_builtin_write_value(
    context: vm::Context,
    raw_values: HashMap[runtime::ObjectId, runtime::JsString],
    value: runtime::Value,
    replacer: Option[runtime::Value],
    property_list: Option[Vec[runtime::JsString]],
    gap: runtime::JsString,
    nesting: isize,
    stack: collections::HashSet[runtime::ObjectId],
    output: Vec[u16],
    depth: isize,
) -> Result[bool, vm::VmError] {
    match value {
        runtime::Value::Undefined | runtime::Value::Symbol(_) => Result::Ok(false),
        runtime::Value::Null => {
            json_builtin_append_ascii(output, "null");
            Result::Ok(true)
        },
        runtime::Value::Bool(value) => {
            json_builtin_append_ascii(
                output,
                if value {
                    "true"
                } else {
                    "false"
                },
            );
            Result::Ok(true)
        },
        runtime::Value::Int(value) => {
            json_builtin_append_ascii(output, value.to_string());
            Result::Ok(true)
        },
        runtime::Value::Float(value) => {
            json_builtin_append_ascii(
                output,
                if math::is_finite(value) {
                    dtoa::number_to_string(value)
                } else {
                    "null"
                },
            );
            Result::Ok(true)
        },
        runtime::Value::String(value) => {
            json_builtin_append_quoted(output, value);
            Result::Ok(true)
        },
        runtime::Value::BigInt(_) => {
            Result::Err(function_vm_error("cannot serialize BigInt as JSON"))
        },
        runtime::Value::Object(object) => {
            match raw_values.get(object) {
                Some(value) => {
                    json_builtin_append_string(output, value);
                    return Result::Ok(true)
                },
                None => (),
            }
            if object.is_callable() {
                Result::Ok(false)
            } else {
                if stack.contains(object) {
                    return Result::Err(function_vm_error("circular reference"))
                }
                let _ = stack.insert(object);
                if json_builtin_is_array(context, object)? {
                    json_builtin_write_array(
                        context,
                        raw_values,
                        object,
                        replacer,
                        property_list,
                        gap,
                        nesting,
                        stack,
                        output,
                        depth,
                    )?
                } else {
                    json_builtin_write_object(
                        context,
                        raw_values,
                        object,
                        replacer,
                        property_list,
                        gap,
                        nesting,
                        stack,
                        output,
                        depth,
                    )?
                }
                let _ = stack.remove(object);
                Result::Ok(true)
            }
        },
    }
}

fn json_builtin_write_property(
    context: vm::Context,
    raw_values: HashMap[runtime::ObjectId, runtime::JsString],
    key: runtime::JsString,
    holder: runtime::ObjectId,
    replacer: Option[runtime::Value],
    property_list: Option[Vec[runtime::JsString]],
    gap: runtime::JsString,
    nesting: isize,
    stack: collections::HashSet[runtime::ObjectId],
    output: Vec[u16],
    depth: isize,
) -> Result[bool, vm::VmError] {
    let key_value = runtime::Value::String(key);
    let mut value = context.read_property_at_depth(runtime::Value::Object(holder), key_value, depth)?;
    match value {
        runtime::Value::Object(_) | runtime::Value::BigInt(_) => {
            let method = context.read_property_at_depth(
                value,
                runtime::Value::String(js_string("toJSON")),
                depth,
            )?;
            if json_builtin_callable(method) {
                value = context.invoke_with_this_at_depth(
                    method,
                    Vec::from_array([key_value]),
                    value,
                    depth,
                )?;
            }
        },
        _ => (),
    }
    match replacer {
        Some(callback) => {
            value = context.invoke_with_this_at_depth(
                callback,
                Vec::from_array([key_value, value]),
                runtime::Value::Object(holder),
                depth,
            )?;
        },
        None => (),
    }
    json_builtin_write_value(
        context,
        raw_values,
        json_builtin_unbox(context, value, depth)?,
        replacer,
        property_list,
        gap,
        nesting,
        stack,
        output,
        depth,
    )
}

fn json_builtin_property_list(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    Option[Vec[runtime::JsString]],
    vm::VmError,
] {
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return Result::Ok(Option::None),
    };
    if !json_builtin_is_array(context, object)? {
        return Result::Ok(Option::None)
    }
    let length = json_builtin_array_length(context, object, depth)?;
    let result: Vec[runtime::JsString] = Vec::new();
    let mut index = 0;
    while index < length {
        let item = context.read_property_at_depth(
            value,
            runtime::Value::String(js_string(index.to_string())),
            depth,
        )?;
        let converted = match item {
            runtime::Value::String(value) => Option::Some(value),
            runtime::Value::Int(_) | runtime::Value::Float(_) => {
                match string_value_at_depth(context, item, depth)? {
                    runtime::Value::String(value) => Option::Some(value),
                    _ => Option::None,
                }
            },
            runtime::Value::Object(object) => match runtime::primitive_value(context.heap(), object) {
                Some(runtime::Value::String(_)) | Some(runtime::Value::Int(_)) | Some(runtime::Value::Float(_)) => {
                    match string_value_at_depth(context, item, depth)? {
                        runtime::Value::String(value) => Option::Some(value),
                        _ => Option::None,
                    }
                },
                _ => Option::None,
            },
            _ => Option::None,
        };
        match converted {
            Some(name) => {
                let mut found = false;
                for existing in result {
                    if existing == name {
                        found = true;
                    }
                }
                if !found {
                    result.push(name)
                }
            },
            None => (),
        }
        index += 1;
    }
    Result::Ok(Option::Some(result))
}

fn json_builtin_space(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::JsString,
    vm::VmError,
] {
    let converted = match value {
        runtime::Value::String(value) => runtime::Value::String(value),
        runtime::Value::Int(_) | runtime::Value::Float(_) => {
            number_value_at_depth(context, value, depth)?
        },
        runtime::Value::Object(object) => match runtime::primitive_value(context.heap(), object) {
            Some(runtime::Value::String(_)) => string_value_at_depth(context, value, depth)?,
            Some(runtime::Value::Int(_)) | Some(runtime::Value::Float(_)) => {
                number_value_at_depth(context, value, depth)?
            },
            _ => runtime::Value::Undefined,
        },
        _ => runtime::Value::Undefined,
    };
    match converted {
        runtime::Value::String(value) => {
            Result::Ok(
                value.slice(
                    0,
                    if value.len() < 10 {
                        value.len()
                    } else {
                        10
                    },
                ),
            )
        },
        runtime::Value::Float(value) => {
            let count = if math::is_nan(value) || value <= 0.0 {
                0
            } else if value >= 10.0 {
                10
            } else {
                num::parse_int_structured(dtoa::number_to_string(math::floor(value))).unwrap_or(0)
            };
            let units: Vec[u16] = Vec::with_capacity(count);
            let mut index = 0;
            while index < count {
                units.push(32);
                index += 1;
            }
            Result::Ok(runtime::JsString::from_code_units(units))
        },
        _ => Result::Ok(js_string("")),
    }
}

fn json_builtin_stringify(
    context: vm::Context,
    raw_values: HashMap[runtime::ObjectId, runtime::JsString],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let replacer_value = argument(arguments, 1);
    let replacer = if json_builtin_callable(replacer_value) {
        Option::Some(replacer_value)
    } else {
        Option::None
    };
    let property_list = if replacer.is_some() {
        Option::None
    } else {
        json_builtin_property_list(context, replacer_value, depth)?
    };
    let gap = json_builtin_space(context, argument(arguments, 2), depth)?;
    let root = json_builtin_allocate_object(context.heap())?;
    let empty = js_string("");
    json_builtin_define(context.heap(), root, empty, argument(arguments, 0))?;
    let output: Vec[u16] = Vec::new();
    let stack: collections::HashSet[runtime::ObjectId] = collections::HashSet::new();
    if json_builtin_write_property(
        context,
        raw_values,
        empty,
        root,
        replacer,
        property_list,
        gap,
        0,
        stack,
        output,
        depth,
    )? {
        Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(output)))
    } else {
        Result::Ok(runtime::Value::Undefined)
    }
}

fn install_json(context: vm::Context, object: runtime::ObjectId) -> Result[(), BuiltinError] {
    let raw_values: HashMap[runtime::ObjectId, runtime::JsString] = HashMap::new();
    define_value(
        context.heap(),
        object,
        "parse",
        allocate_vm_function(
            context,
            "parse",
            |this_value, arguments, depth| {
                json_builtin_parse(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "isRawJSON",
        allocate_vm_function(
            context,
            "isRawJSON",
            |this_value, arguments, depth| {
                json_builtin_is_raw_json(context, raw_values, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "rawJSON",
        allocate_vm_function(
            context,
            "rawJSON",
            |this_value, arguments, depth| {
                json_builtin_raw_json(context, raw_values, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "stringify",
        allocate_vm_function(
            context,
            "stringify",
            |this_value, arguments, depth| {
                json_builtin_stringify(context, raw_values, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )
}
