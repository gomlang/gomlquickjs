package builtins;

use gomlang::quickjs::dtoa;
use gomlang::quickjs::regexp;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::math;
use std::num;

struct RegExpState {
    pattern: runtime::JsString,
    source: runtime::JsString,
    flags: runtime::JsString,
    compiled: regexp::Regex,
    has_indices: bool,
    global: bool,
    ignore_case: bool,
    multiline: bool,
    dot_all: bool,
    unicode: bool,
    unicode_sets: bool,
    sticky: bool,
}

struct LocatedMatch {
    start: isize,
    end: isize,
    captures: Vec[Option[regexp::RegexCapture]],
    capture_names: Vec[Option[runtime::JsString]],
}

struct RegExpInstall {
    constructor: runtime::Value,
    prototype: runtime::ObjectId,
    states: HashMap[runtime::ObjectId, RegExpState],
}

struct RegExpConstructorInput {
    pattern: runtime::JsString,
    flags: runtime::Value,
}

fn regexp_with_root[T](
    context: vm::Context,
    value: runtime::Value,
    callback: () -> Result[T, vm::VmError],
) -> Result[T, vm::VmError] {
    let root = Ref::new(value);
    context.add_external_root(root);
    let result = callback();
    let _ = context.remove_external_root(root);
    result
}

fn regexp_gc_edges(heap: runtime::Heap, states: HashMap[runtime::ObjectId, RegExpState]) -> Vec[
    runtime::GcEdge,
] {
    let stale: Vec[runtime::ObjectId] = Vec::new();
    for (object, _) in states.entries() {
        if !heap.contains(object) {
            stale.push(object)
        } else {}
    }
    for object in stale {
        let _ = states.remove(object);
    }
    Vec::new()
}

fn regexp_compile_error(value: regexp::RegexError) -> vm::NativeError {
    native_error(
        "SyntaxError: invalid regular expression at UTF-16 offset " + value.offset.to_string()
            + ": "
            + value.message,
    )
}

fn regexp_builtin_error(message: string) -> BuiltinError {
    BuiltinError { message }
}

fn regexp_object(value: runtime::Value) -> Result[runtime::ObjectId, vm::NativeError] {
    match value {
        runtime::Value::Object(value) => Result::Ok(value),
        _ => Result::Err(native_error("RegExp method called on incompatible receiver")),
    }
}

fn regexp_state(states: HashMap[runtime::ObjectId, RegExpState], value: runtime::Value) -> Result[
    (runtime::ObjectId, RegExpState),
    vm::NativeError,
] {
    let object = regexp_object(value)?;
    match states.get(object) {
        Some(state) => Result::Ok((object, state)),
        None => Result::Err(native_error("RegExp method called on incompatible receiver")),
    }
}

fn append_source_escape(output: Vec[u16], value: u16) -> unit {
    output.push(92);
    if value == 10 {
        output.push(110)
    } else if value == 13 {
        output.push(114)
    } else if value == 0x2028 {
        output.push(117);
        output.push(50);
        output.push(48);
        output.push(50);
        output.push(56)
    } else if value == 0x2029 {
        output.push(117);
        output.push(50);
        output.push(48);
        output.push(50);
        output.push(57)
    } else {
        output.push(value)
    }
}

fn regexp_source(pattern: runtime::JsString) -> runtime::JsString {
    if pattern.len() == 0 {
        return js_string("(?:)")
    } else {};
    let output: Vec[u16] = Vec::with_capacity(pattern.len());
    let mut index = 0;
    while index < pattern.len() {
        let value = pattern.get(index);
        if value == 47 || value == 10 || value == 13 || value == 0x2028 || value == 0x2029 {
            append_source_escape(output, value)
        } else {
            output.push(value)
        };
        index += 1;
    }
    runtime::JsString::from_code_units(output)
}

fn canonical_flags(flags: regexp::RegexFlags) -> string {
    let mut output = "";
    if flags.has_indices {
        output += "d";
    } else {};
    if flags.global {
        output += "g";
    } else {};
    if flags.ignore_case {
        output += "i";
    } else {};
    if flags.multiline {
        output += "m";
    } else {};
    if flags.dot_all {
        output += "s";
    } else {};
    if flags.unicode {
        output += "u";
    } else {};
    if flags.unicode_sets {
        output += "v";
    } else {};
    if flags.sticky {
        output += "y";
    } else {};
    output
}

fn flags_text(value: runtime::JsString) -> Result[string, vm::NativeError] {
    match value.to_host_string() {
        Ok(value) => Result::Ok(value),
        Err(_) => Result::Err(native_error("SyntaxError: invalid regular expression flags")),
    }
}

fn new_regexp_state(pattern: runtime::JsString, requested_flags: runtime::JsString) -> Result[
    RegExpState,
    vm::NativeError,
] {
    let requested = flags_text(requested_flags)?;
    let parsed = match regexp::parse_flags(requested) {
        Ok(value) => value,
        Err(value) => return Result::Err(regexp_compile_error(value)),
    };
    let compiled = match regexp::compile_with_flags(pattern, requested) {
        Ok(value) => value,
        Err(value) => return Result::Err(regexp_compile_error(value)),
    };
    let flags_host = canonical_flags(parsed);
    Result::Ok(
        RegExpState {
            pattern,
            source: regexp_source(pattern),
            flags: js_string(flags_host),
            compiled,
            has_indices: parsed.has_indices,
            global: parsed.global,
            ignore_case: parsed.ignore_case,
            multiline: parsed.multiline,
            dot_all: parsed.dot_all,
            unicode: parsed.unicode,
            unicode_sets: parsed.unicode_sets,
            sticky: parsed.sticky,
        },
    )
}

fn define_regexp_instance(heap: runtime::Heap, object: runtime::ObjectId, state: RegExpState) -> Result[
    unit,
    vm::NativeError,
] {
    let _ = state;
    define_data(
        heap,
        object,
        runtime::string_property_key("lastIndex"),
        runtime::Value::Int(0),
        true,
        false,
        false,
    )
}

fn regexp_is_regexp_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    value: runtime::Value,
    depth: isize,
) -> Result[bool, vm::VmError] {
    let object = match value {
        runtime::Value::Object(value) => value,
        _ => return Result::Ok(false),
    };
    match context.well_known_symbol(vm::WellKnownSymbolKind::Match) {
        Some(symbol) => match context.read_property_at_depth(
            value,
            runtime::Value::Symbol(symbol),
            depth,
        )? {
            runtime::Value::Undefined => (),
            result => return Result::Ok(runtime::to_boolean(result)),
        },
        None => (),
    };
    Result::Ok(states.get(object).is_some())
}

fn regexp_constructor_input_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    arguments: Vec[runtime::Value],
    is_regexp: bool,
    depth: isize,
) -> Result[RegExpConstructorInput, vm::VmError] {
    let value = argument(arguments, 0);
    let requested_flags = argument(arguments, 1);
    let state = match value {
        runtime::Value::Object(object) => states.get(object),
        _ => Option::None,
    };
    let (pattern_value, flags_value) = match state {
        Some(state) => (
            runtime::Value::String(state.pattern),
            match requested_flags {
                runtime::Value::Undefined => runtime::Value::String(state.flags),
                value => value,
            },
        ),
        None => if is_regexp {
            let pattern_value = context.read_property_at_depth(
                value,
                runtime::Value::String(js_string("source")),
                depth,
            )?;
            let flags_value = regexp_with_root(
                context,
                pattern_value,
                || match requested_flags {
                    runtime::Value::Undefined => context.read_property_at_depth(
                        value,
                        runtime::Value::String(js_string("flags")),
                        depth,
                    ),
                    value => Result::Ok(value),
                },
            )?;
            (pattern_value, flags_value)
        } else {
            (
                match value {
                    runtime::Value::Undefined => runtime::Value::String(js_string("")),
                    value => value,
                },
                requested_flags,
            )
        },
    };
    let pattern_value = match pattern_value {
        runtime::Value::Undefined => runtime::Value::String(js_string("")),
        value => value,
    };
    let converted_pattern = regexp_with_root(
        context,
        flags_value,
        || string_value_at_depth(context, pattern_value, depth),
    )?;
    let pattern = match converted_pattern {
        runtime::Value::String(value) => value,
        _ => return Result::Err(function_vm_error("RegExp pattern is not a string")),
    };
    Result::Ok(RegExpConstructorInput { pattern, flags: flags_value })
}

fn regexp_constructor_prepare_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let is_regexp = regexp_is_regexp_at_depth(context, states, argument(arguments, 0), depth)?;
    let input = regexp_constructor_input_at_depth(context, states, arguments, is_regexp, depth)?;
    Result::Ok(Vec::from_array([runtime::Value::String(input.pattern), input.flags]))
}

fn regexp_flags_at_constructor_depth(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::JsString,
    vm::VmError,
] {
    match value {
        runtime::Value::Undefined => Result::Ok(js_string("")),
        value => match string_value_at_depth(context, value, depth)? {
            runtime::Value::String(value) => Result::Ok(value),
            _ => Result::Err(function_vm_error("RegExp flags are not a string")),
        },
    }
}

fn regexp_prepared_state_at_depth(
    context: vm::Context,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[RegExpState, vm::VmError] {
    let pattern = match argument(arguments, 0) {
        runtime::Value::String(value) => value,
        _ => return Result::Err(function_vm_error("RegExp pattern is not prepared")),
    };
    let flags = regexp_flags_at_constructor_depth(context, argument(arguments, 1), depth)?;
    match new_regexp_state(pattern, flags) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(function_native_error(value)),
    }
}

fn regexp_initialize_instance_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    object: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    regexp_with_root(
        context,
        runtime::Value::Object(object),
        || regexp_initialize_rooted_instance_at_depth(context, states, object, arguments, depth),
    )
}

fn regexp_initialize_rooted_instance_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    object: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let state = regexp_prepared_state_at_depth(context, arguments, depth)?;
    match define_regexp_instance(context.heap(), object, state) {
        Ok(()) => (),
        Err(value) => return Result::Err(function_native_error(value)),
    };
    states[object] = state;
    if context.set_object_builtin_tag(object, js_string("RegExp")) {
        Result::Ok(runtime::Value::Object(object))
    } else {
        Result::Err(function_vm_error("cannot register RegExp instance"))
    }
}

fn regexp_allocate_instance_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    prototype: runtime::ObjectId,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match allocate_ordinary(context.heap(), Option::Some(prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    regexp_initialize_instance_at_depth(context, states, object, arguments, depth)
}

fn regexp_constructor_call_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    prototype: runtime::ObjectId,
    constructor: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let value = argument(arguments, 0);
    let is_regexp = regexp_is_regexp_at_depth(context, states, value, depth)?;
    if is_regexp
        && match argument(arguments, 1) {
            runtime::Value::Undefined => true,
            _ => false,
        } {
        let pattern_constructor = context.read_property_at_depth(
            value,
            runtime::Value::String(js_string("constructor")),
            depth,
        )?;
        if runtime::same_value(pattern_constructor, constructor) {
            return Result::Ok(value)
        } else {}
    } else {};
    let input = regexp_constructor_input_at_depth(context, states, arguments, is_regexp, depth)?;
    regexp_allocate_instance_at_depth(
        context,
        states,
        prototype,
        Vec::from_array([runtime::Value::String(input.pattern), input.flags]),
        depth,
    )
}

fn regexp_compile_instance_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match regexp_state(states, this_value) {
        Ok((object, _)) => object,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let pattern_value = argument(arguments, 0);
    let requested_flags = argument(arguments, 1);
    let replacement = match pattern_value {
        runtime::Value::Object(object) => states.get(object),
        _ => Option::None,
    };
    let state = match replacement {
        Some(state) => {
            match requested_flags {
                runtime::Value::Undefined => (),
                _ => return Result::Err(function_vm_error("flags must be undefined")),
            };
            state
        },
        None => {
            let source = match pattern_value {
                runtime::Value::Undefined => runtime::Value::String(js_string("")),
                value => value,
            };
            let pattern = match string_value_at_depth(context, source, depth)? {
                runtime::Value::String(value) => value,
                _ => return Result::Err(function_vm_error("RegExp pattern is not a string")),
            };
            let flags = regexp_flags_at_constructor_depth(context, requested_flags, depth)?;
            match new_regexp_state(pattern, flags) {
                Ok(value) => value,
                Err(value) => return Result::Err(function_native_error(value)),
            }
        },
    };
    states[object] = state;
    match set_regexp_last_index(context.heap(), object, 0) {
        Ok(()) => (),
        Err(value) => return Result::Err(function_native_error(value)),
    };
    Result::Ok(runtime::Value::Object(object))
}

fn regexp_state_property(
    states: HashMap[runtime::ObjectId, RegExpState],
    prototype: runtime::ObjectId,
    property: string,
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = arguments;
    let object = regexp_object(this_value)?;
    if object == prototype {
        if property == "source" {
            return Result::Ok(runtime::Value::String(js_string("(?:)")))
        } else {
            return Result::Ok(runtime::Value::Undefined)
        }
    } else {};
    let state = match states.get(object) {
        Some(value) => value,
        None => return Result::Err(native_error("RegExp method called on incompatible receiver")),
    };
    if property == "source" {
        Result::Ok(runtime::Value::String(state.source))
    } else if property == "hasIndices" {
        Result::Ok(runtime::Value::Bool(state.has_indices))
    } else if property == "global" {
        Result::Ok(runtime::Value::Bool(state.global))
    } else if property == "ignoreCase" {
        Result::Ok(runtime::Value::Bool(state.ignore_case))
    } else if property == "multiline" {
        Result::Ok(runtime::Value::Bool(state.multiline))
    } else if property == "dotAll" {
        Result::Ok(runtime::Value::Bool(state.dot_all))
    } else if property == "unicode" {
        Result::Ok(runtime::Value::Bool(state.unicode))
    } else if property == "unicodeSets" {
        Result::Ok(runtime::Value::Bool(state.unicode_sets))
    } else {
        Result::Ok(runtime::Value::Bool(state.sticky))
    }
}

fn regexp_flags_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    match this_value {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("RegExp flags getter requires an object")),
    };
    let mut output = "";
    for (name, flag) in Vec::from_array(
        [
            ("hasIndices", "d"),
            ("global", "g"),
            ("ignoreCase", "i"),
            ("multiline", "m"),
            ("dotAll", "s"),
            ("unicode", "u"),
            ("unicodeSets", "v"),
            ("sticky", "y"),
        ],
    ) {
        if runtime::to_boolean(
            context.read_property_at_depth(
                this_value,
                runtime::Value::String(js_string(name)),
                depth,
            )?,
        ) {
            output += flag;
        } else {}
    }
    Result::Ok(runtime::Value::String(js_string(output)))
}

fn regexp_to_string_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    match this_value {
        runtime::Value::Object(_) => (),
        _ => return Result::Err(function_vm_error("RegExp toString requires an object")),
    };
    let source = match string_value_at_depth(
        context,
        context.read_property_at_depth(
            this_value,
            runtime::Value::String(js_string("source")),
            depth,
        )?,
        depth,
    )? {
        runtime::Value::String(value) => value,
        _ => return Result::Err(function_vm_error("RegExp source is not a string")),
    };
    let flags = match string_value_at_depth(
        context,
        context.read_property_at_depth(
            this_value,
            runtime::Value::String(js_string("flags")),
            depth,
        )?,
        depth,
    )? {
        runtime::Value::String(value) => value,
        _ => return Result::Err(function_vm_error("RegExp flags are not a string")),
    };
    Result::Ok(
        runtime::Value::String(js_string("/").concat(source).concat(js_string("/")).concat(flags)),
    )
}

fn define_regexp_getter(
    heap: runtime::Heap,
    prototype: runtime::ObjectId,
    name: string,
    getter: runtime::Value,
) -> Result[unit, BuiltinError] {
    if runtime::define_own_property(
        heap,
        prototype,
        runtime::string_property_key(name),
        runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
    ) {
        Result::Ok(())
    } else {
        Result::Err(regexp_builtin_error("cannot define RegExp getter " + name))
    }
}

fn regexp_last_index_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    input_length: isize,
    depth: isize,
) -> Result[isize, vm::VmError] {
    let value = context.read_property_at_depth(
        runtime::Value::Object(object),
        runtime::Value::String(js_string("lastIndex")),
        depth,
    )?;
    let number = match number_value_at_depth(context, value, depth)? {
        runtime::Value::Float(value) => value,
        _ => return Result::Err(function_vm_error("RegExp lastIndex is not numeric")),
    };
    if math::is_nan(number) || number <= 0.0 {
        Result::Ok(0)
    } else if math::is_infinite(number)
        || number > num::parse_float64(input_length.to_string()).unwrap_or(0.0) {
        Result::Ok(input_length + 1)
    } else {
        Result::Ok(num::parse_int(dtoa::number_to_string(math::floor(number))).unwrap_or(0))
    }
}

fn regexp_last_index(heap: runtime::Heap, object: runtime::ObjectId, input_length: isize) -> Result[
    isize,
    vm::NativeError,
] {
    let value = match runtime::get_property(heap, object, runtime::string_property_key("lastIndex")) {
        Ok(Some(value)) => value,
        Ok(None) => runtime::Value::Undefined,
        Err(value) => return Result::Err(native_error(value.message)),
    };
    let number = match runtime::primitive_to_number(value) {
        Ok(value) => value,
        Err(value) => return Result::Err(native_error(value.message)),
    };
    if math::is_nan(number) || number <= 0.0 {
        Result::Ok(0)
    } else if math::is_infinite(number)
        || number > num::parse_float64(input_length.to_string()).unwrap_or(0.0) {
        Result::Ok(input_length + 1)
    } else {
        Result::Ok(num::parse_int(dtoa::number_to_string(math::floor(number))).unwrap_or(0))
    }
}

fn set_regexp_last_index(heap: runtime::Heap, object: runtime::ObjectId, value: isize) -> Result[
    unit,
    vm::NativeError,
] {
    if runtime::set_existing_data_property(
        heap,
        object,
        runtime::string_property_key("lastIndex"),
        array_length_value(value),
    ) {
        Result::Ok(())
    } else {
        Result::Err(native_error("cannot update RegExp lastIndex"))
    }
}

fn located_match(regex: regexp::Regex, value: regexp::RegexMatch, start: isize) -> LocatedMatch {
    let captures: Vec[Option[regexp::RegexCapture]] = Vec::with_capacity(value.capture_count() + 1);
    let capture_names: Vec[Option[runtime::JsString]] = Vec::with_capacity(
        value.capture_count() + 1,
    );
    captures.push(Option::Some(regexp::RegexCapture { start, end: value.end }));
    capture_names.push(Option::None);
    let mut index = 1;
    while index <= value.capture_count() {
        captures.push(value.capture(index));
        capture_names.push(regex.capture_name(index));
        index += 1;
    }
    LocatedMatch { start, end: value.end, captures, capture_names }
}

fn match_at(state: RegExpState, input: runtime::JsString, offset: isize) -> Result[
    Option[LocatedMatch],
    vm::NativeError,
] {
    match state.compiled.match_at(input, offset) {
        Some(value) => Result::Ok(Option::Some(located_match(state.compiled, value, offset))),
        None => Result::Ok(Option::None),
    }
}

fn find_regexp_match(state: RegExpState, input: runtime::JsString, last_index: isize) -> Result[
    Option[LocatedMatch],
    vm::NativeError,
] {
    if !state.global && !state.sticky {
        match state.compiled.search(input) {
            Some(value) => {
                Result::Ok(Option::Some(located_match(state.compiled, value, value.start)))
            },
            None => Result::Ok(Option::None),
        }
    } else if last_index < 0 || last_index > input.len() {
        Result::Ok(Option::None)
    } else if state.sticky {
        match_at(state, input, last_index)
    } else {
        let mut offset = last_index;
        while offset <= input.len() {
            match match_at(state, input, offset)? {
                Some(value) => return Result::Ok(Option::Some(value)),
                None => {
                    offset += 1;
                },
            }
        }
        Result::Ok(Option::None)
    }
}

fn regexp_unicode_start(state: RegExpState, input: runtime::JsString, index: isize) -> isize {
    if (state.unicode || state.unicode_sets) && index > 0 && index < input.len() {
        let current = input.get(index);
        let previous = input.get(index - 1);
        if current >= 0xdc00 && current <= 0xdfff && previous >= 0xd800 && previous <= 0xdbff {
            index - 1
        } else {
            index
        }
    } else {
        index
    }
}

fn regexp_groups_value(heap: runtime::Heap, input: runtime::JsString, found: LocatedMatch) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let mut has_named_captures = false;
    let mut name_index = 1;
    while name_index < found.capture_names.len() {
        if found.capture_names[name_index].is_some() {
            has_named_captures = true;
        } else {};
        name_index += 1;
    }
    if has_named_captures {
        let groups = match runtime::new_null_prototype_object(heap) {
            Ok(value) => value,
            Err(value) => return Result::Err(native_error(value.message)),
        };
        let mut index = 1;
        while index < found.capture_names.len() {
            match found.capture_names[index] {
                Some(name) => {
                    let value = match found.captures[index] {
                        Some(capture) => {
                            runtime::Value::String(input.slice(capture.start, capture.end))
                        },
                        None => runtime::Value::Undefined,
                    };
                    let key = runtime::js_string_property_key(name);
                    let should_define = match value {
                        runtime::Value::Undefined => match heap.get(groups) {
                            Some(object) => object.own_property(key).is_none(),
                            None => false,
                        },
                        _ => true,
                    };
                    if should_define {
                        define_data(heap, groups, key, value, true, true, true)?
                    } else {}
                },
                None => {},
            };
            index += 1;
        }
        Result::Ok(runtime::Value::Object(groups))
    } else {
        Result::Ok(runtime::Value::Undefined)
    }
}

fn regexp_capture_index_value(heap: runtime::Heap, capture: Option[regexp::RegexCapture]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    match capture {
        Some(value) => {
            let values = Vec::from_array(
                [array_length_value(value.start), array_length_value(value.end)],
            );
            Result::Ok(runtime::Value::Object(allocate_array(heap, values, 2)?))
        },
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn regexp_index_groups_value(heap: runtime::Heap, found: LocatedMatch, values: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    if !string_has_named_captures(found) {
        return Result::Ok(runtime::Value::Undefined)
    } else {};
    let groups = match runtime::new_null_prototype_object(heap) {
        Ok(value) => value,
        Err(value) => return Result::Err(native_error(value.message)),
    };
    let mut index = 1;
    while index < found.capture_names.len() {
        match found.capture_names[index] {
            Some(name) => {
                let key = runtime::js_string_property_key(name);
                let should_define = match values[index] {
                    runtime::Value::Undefined => match heap.get(groups) {
                        Some(object) => object.own_property(key).is_none(),
                        None => false,
                    },
                    _ => true,
                };
                if should_define {
                    define_data(heap, groups, key, values[index], true, true, true)?
                } else {}
            },
            None => {},
        };
        index += 1;
    }
    Result::Ok(runtime::Value::Object(groups))
}

fn regexp_indices_value(heap: runtime::Heap, found: LocatedMatch) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let values: Vec[runtime::Value] = Vec::with_capacity(found.captures.len());
    let mut index = 0;
    while index < found.captures.len() {
        values.push(regexp_capture_index_value(heap, found.captures[index])?);
        index += 1;
    }
    let object = allocate_array(heap, values, values.len())?;
    let groups = regexp_index_groups_value(heap, found, values)?;
    define_data(heap, object, runtime::string_property_key("groups"), groups, true, true, true)?;
    Result::Ok(runtime::Value::Object(object))
}

fn regexp_match_array(
    heap: runtime::Heap,
    input: runtime::JsString,
    found: LocatedMatch,
    has_indices: bool,
) -> Result[runtime::Value, vm::NativeError] {
    let values: Vec[runtime::Value] = Vec::with_capacity(found.captures.len());
    let mut index = 0;
    while index < found.captures.len() {
        match found.captures[index] {
            Some(capture) => values.push(
                runtime::Value::String(input.slice(capture.start, capture.end)),
            ),
            None => values.push(runtime::Value::Undefined),
        };
        index += 1;
    }
    let object = allocate_array(heap, values, values.len())?;
    define_data(
        heap,
        object,
        runtime::string_property_key("index"),
        array_length_value(found.start),
        true,
        true,
        true,
    )?;
    define_data(
        heap,
        object,
        runtime::string_property_key("input"),
        runtime::Value::String(input),
        true,
        true,
        true,
    )?;
    let groups = regexp_groups_value(heap, input, found)?;
    define_data(heap, object, runtime::string_property_key("groups"), groups, true, true, true)?;
    if has_indices {
        let indices = regexp_indices_value(heap, found)?;
        define_data(
            heap,
            object,
            runtime::string_property_key("indices"),
            indices,
            true,
            true,
            true,
        )?
    } else {};
    Result::Ok(runtime::Value::Object(object))
}

fn regexp_execute_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let (object, state) = match regexp_state(states, this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let input = match string_value_at_depth(context, argument(arguments, 0), depth)? {
        runtime::Value::String(value) => value,
        _ => return Result::Err(function_vm_error("RegExp input is not a string")),
    };
    let indexed = state.global || state.sticky;
    let converted_last_index = regexp_last_index_at_depth(context, object, input.len(), depth)?;
    let last_index = if indexed {
        converted_last_index
    } else {
        0
    };
    let last_index = regexp_unicode_start(state, input, last_index);
    let found = match find_regexp_match(state, input, last_index) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    match found {
        Some(found) => {
            if indexed {
                match set_regexp_last_index(context.heap(), object, found.end) {
                    Ok(()) => (),
                    Err(value) => return Result::Err(function_native_error(value)),
                }
            } else {};
            match regexp_match_array(context.heap(), input, found, state.has_indices) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(function_native_error(value)),
            }
        },
        None => {
            if indexed {
                match set_regexp_last_index(context.heap(), object, 0) {
                    Ok(()) => (),
                    Err(value) => return Result::Err(function_native_error(value)),
                }
            } else {};
            Result::Ok(runtime::Value::Null)
        },
    }
}

fn regexp_exec_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    receiver: runtime::Value,
    input: runtime::Value,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    regexp_with_root(
        context,
        receiver,
        || regexp_with_root(
            context,
            input,
            || {
                let exec = context.read_property_at_depth(
                    receiver,
                    runtime::Value::String(js_string("exec")),
                    depth,
                )?;
                regexp_with_root(
                    context,
                    exec,
                    || {
                        let result = match exec {
                            runtime::Value::Object(object) => if object.is_callable() {
                                context.invoke_with_this_at_depth(
                                    exec,
                                    Vec::from_array([input]),
                                    receiver,
                                    depth,
                                )?
                            } else {
                                regexp_execute_at_depth(
                                    context,
                                    states,
                                    receiver,
                                    Vec::from_array([input]),
                                    depth,
                                )?
                            },
                            _ => regexp_execute_at_depth(
                                context,
                                states,
                                receiver,
                                Vec::from_array([input]),
                                depth,
                            )?,
                        };
                        match result {
                            runtime::Value::Null | runtime::Value::Object(_) => {
                                Result::Ok(result)
                            },
                            _ => Result::Err(
                                function_vm_error(
                                    "RegExp exec method must return an object or null",
                                ),
                            ),
                        }
                    },
                )
            },
        ),
    )
}

fn regexp_test_at_depth(
    context: vm::Context,
    states: HashMap[runtime::ObjectId, RegExpState],
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let result = regexp_exec_at_depth(context, states, this_value, argument(arguments, 0), depth)?;
    match result {
        runtime::Value::Null => Result::Ok(runtime::Value::Bool(false)),
        runtime::Value::Object(_) => Result::Ok(runtime::Value::Bool(true)),
        _ => Result::Err(function_vm_error("RegExp exec method must return an object or null")),
    }
}

fn regexp_escape_hex_digit(value: u16) -> u16 {
    if value < 10 {
        48 + value
    } else {
        87 + value
    }
}

fn regexp_escape_hex2(output: Vec[u16], value: u16) -> unit {
    output.push(92);
    output.push(120);
    output.push(regexp_escape_hex_digit((value >> 4) & 15));
    output.push(regexp_escape_hex_digit(value & 15));
}

fn regexp_escape_hex4(output: Vec[u16], value: u16) -> unit {
    output.push(92);
    output.push(117);
    output.push(regexp_escape_hex_digit((value >> 12) & 15));
    output.push(regexp_escape_hex_digit((value >> 8) & 15));
    output.push(regexp_escape_hex_digit((value >> 4) & 15));
    output.push(regexp_escape_hex_digit(value & 15));
}

fn regexp_escape_space(value: u16) -> bool {
    value == 0x00a0 || value == 0x1680 || value >= 0x2000 && value <= 0x200a || value == 0x2028
        || value == 0x2029
        || value == 0x202f
        || value == 0x205f
        || value == 0x3000
        || value == 0xfeff
}

fn regexp_escape_syntax(value: u16) -> bool {
    value == 36 || value == 40 || value == 41 || value == 42 || value == 43 || value == 46
        || value == 47
        || value == 63
        || value == 91
        || value == 92
        || value == 93
        || value == 94
        || value == 123
        || value == 124
        || value == 125
        || value == 127
}

fn regexp_escape_punctuator(value: u16) -> bool {
    value == 34 || value == 35 || value == 37 || value == 38 || value == 39 || value == 44
        || value == 45
        || value == 58
        || value == 59
        || value == 60
        || value == 61
        || value == 62
        || value == 64
        || value == 96
        || value == 126
        || value == 33
}

fn regexp_escape_static(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let input = match argument(arguments, 0) {
        runtime::Value::String(value) => value,
        _ => return Result::Err(native_error("not a string")),
    };
    let output: Vec[u16] = Vec::with_capacity(input.len());
    let mut index = 0;
    while index < input.len() {
        let value = input.get(index);
        let ascii_alphanumeric = value >= 48 && value <= 57 || value >= 65 && value <= 90
            || value >= 97 && value <= 122;
        if value < 33 {
            if value >= 9 && value <= 13 {
                output.push(92);
                output.push(Vec::from_array([116, 110, 118, 102, 114])[(value - 9).to_isize()])
            } else {
                regexp_escape_hex2(output, value)
            }
        } else if value < 128 {
            if index == 0 && ascii_alphanumeric || regexp_escape_punctuator(value) {
                regexp_escape_hex2(output, value)
            } else {
                if regexp_escape_syntax(value) {
                    output.push(92)
                } else {};
                output.push(value)
            }
        } else if value < 256 {
            regexp_escape_hex2(output, value)
        } else if value >= 0xd800 && value <= 0xdbff && index + 1 < input.len()
            && input.get(index + 1) >= 0xdc00
            && input.get(index + 1) <= 0xdfff {
            output.push(value);
            index += 1;
            output.push(input.get(index))
        } else if value >= 0xd800 && value <= 0xdfff || regexp_escape_space(value) {
            regexp_escape_hex4(output, value)
        } else {
            output.push(value)
        };
        index += 1;
    }
    Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(output)))
}

fn install_regexp_runtime(context: vm::Context) -> Result[RegExpInstall, BuiltinError] {
    let heap = context.heap();
    let prototype = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(regexp_builtin_error(value.message)),
    };
    let states: HashMap[runtime::ObjectId, RegExpState] = HashMap::new();
    context.add_external_edge_provider(|| regexp_gc_edges(context.heap(), states));
    let flags_getter = allocate_vm_function(
        context,
        "get RegExp.prototype.flags",
        |this_value, arguments, depth| {
            regexp_flags_at_depth(context, this_value, arguments, depth)
        },
    )?;
    define_regexp_getter(heap, prototype, "flags", flags_getter)?;
    for name in Vec::from_array(
        [
            "source",
            "global",
            "ignoreCase",
            "multiline",
            "dotAll",
            "unicode",
            "unicodeSets",
            "sticky",
            "hasIndices",
        ],
    ) {
        let property = name;
        let getter = allocate_function(
            context,
            "get RegExp.prototype." + property,
            |heap, this_value, arguments| {
                regexp_state_property(states, prototype, property, heap, this_value, arguments)
            },
        )?;
        define_regexp_getter(heap, prototype, property, getter)?
    }
    let exec = allocate_vm_function(
        context,
        "RegExp.prototype.exec",
        |this_value, arguments, depth| {
            regexp_execute_at_depth(context, states, this_value, arguments, depth)
        },
    )?;
    let test = allocate_vm_function(
        context,
        "RegExp.prototype.test",
        |this_value, arguments, depth| {
            regexp_test_at_depth(context, states, this_value, arguments, depth)
        },
    )?;
    let compile_method = allocate_vm_function(
        context,
        "RegExp.prototype.compile",
        |this_value, arguments, depth| {
            regexp_compile_instance_at_depth(context, states, this_value, arguments, depth)
        },
    )?;
    let to_string = allocate_vm_function(
        context,
        "RegExp.prototype.toString",
        |this_value, arguments, depth| {
            regexp_to_string_at_depth(context, this_value, arguments, depth)
        },
    )?;
    define_value(heap, prototype, "exec", exec, true, true)?;
    define_value(heap, prototype, "test", test, true, true)?;
    define_value(heap, prototype, "compile", compile_method, true, true)?;
    define_value(heap, prototype, "toString", to_string, true, true)?;
    let constructor_value = Ref::new(runtime::Value::Undefined);
    let constructor = allocate_vm_function(
        context,
        "RegExp",
        |this_value, arguments, depth| {
            let _ = this_value;
            regexp_constructor_call_at_depth(
                context,
                states,
                prototype,
                constructor_value.get(),
                arguments,
                depth,
            )
        },
    )?;
    constructor_value.set(constructor);
    match context.set_vm_constructor_callback(
        constructor,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = new_target;
            constructor_receiver_prototype(context.heap(), receiver, selected_prototype, prototype)?;
            regexp_initialize_instance_at_depth(context, states, receiver, arguments, depth)
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(regexp_builtin_error(value.kind.debug())),
    };
    match context.set_vm_constructor_prepare_callback(
        constructor,
        |arguments, depth| regexp_constructor_prepare_at_depth(context, states, arguments, depth),
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(regexp_builtin_error(value.kind.debug())),
    };
    let constructor_object = function_object(constructor, "RegExp")?;
    define_value(
        heap,
        constructor_object,
        "escape",
        allocate_function(context, "RegExp.escape", regexp_escape_static)?,
        true,
        true,
    )?;
    define_value(
        heap,
        constructor_object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    match context.well_known_symbol(vm::WellKnownSymbolKind::Species) {
        Some(symbol) => {
            let getter = allocate_function_with_length(
                context,
                "get [Symbol.species]",
                0,
                array_species_getter,
            )?;
            if !runtime::define_own_property(
                heap,
                constructor_object,
                runtime::PropertyKey::Symbol(symbol),
                runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
            ) {
                return Result::Err(regexp_builtin_error("cannot define RegExp species"))
            } else {}
        },
        None => (),
    };
    define_value(heap, prototype, "constructor", constructor, true, true)?;
    match context.set_regexp_constructor(constructor) {
        Ok(()) => (),
        Err(_) => return Result::Err(regexp_builtin_error("cannot register RegExp constructor")),
    };
    Result::Ok(RegExpInstall { constructor, prototype, states })
}

pub fn install_regexp(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    Result::Ok(install_regexp_runtime(context)?.constructor)
}
