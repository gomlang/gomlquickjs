package builtins;

use gomlang::quickjs::bytecode;
use gomlang::quickjs::runtime;
use gomlang::quickjs::vm;
use std::num;
use std::testing;

fn arraybuffer_expect_install(value: Result[ArrayBufferInstall, BuiltinError]) -> ArrayBufferInstall {
    match value {
        Ok(value) => value,
        Err(value) => {
            testing::fail(value.message);
            loop {}
        },
    }
}

fn arraybuffer_expect_value(value: Result[runtime::Value, vm::VmError]) -> runtime::Value {
    match value {
        Ok(value) => value,
        Err(value) => {
            testing::fail(value.kind.debug());
            runtime::Value::Undefined
        },
    }
}

fn arraybuffer_expect_object(value: runtime::Value) -> runtime::ObjectId {
    match value {
        runtime::Value::Object(value) => value,
        _ => {
            testing::fail("expected object");
            loop {}
        },
    }
}

fn arraybuffer_property(heap: runtime::Heap, object: runtime::ObjectId, name: string) -> runtime::Value {
    match runtime::get_property(heap, object, runtime::string_property_key(name)) {
        Ok(Some(value)) => value,
        Ok(None) => {
            testing::fail("missing ArrayBuffer property " + name);
            runtime::Value::Undefined
        },
        Err(value) => {
            testing::fail(value.message);
            runtime::Value::Undefined
        },
    }
}

fn arraybuffer_invoke(
    context: vm::Context,
    callable: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let code: Vec[bytecode::Instruction] = Vec::from_array([bytecode::Instruction::GetLoc(0)]);
    let mut index = 0;
    while index < arguments.len() {
        code.push(bytecode::Instruction::GetLoc(index + 1));
        index += 1;
    }
    code.push(bytecode::Instruction::Call(arguments.len()));
    code.push(bytecode::Instruction::Return);
    let locals: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 1);
    locals.push(callable);
    for value in arguments {
        locals.push(value)
    }
    context.execute_with_locals(bytecode::Function::new(Vec::new(), code, locals.len()), locals)
}

fn arraybuffer_invoke_method(
    context: vm::Context,
    receiver: runtime::Value,
    name: string,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::VmError] {
    let object = arraybuffer_expect_object(receiver);
    let callable = arraybuffer_property(context.heap(), object, name);
    let code: Vec[bytecode::Instruction] = Vec::from_array(
        [bytecode::Instruction::GetLoc(0), bytecode::Instruction::GetLoc(1)],
    );
    let mut index = 0;
    while index < arguments.len() {
        code.push(bytecode::Instruction::GetLoc(index + 2));
        index += 1;
    }
    code.push(bytecode::Instruction::CallMethod(arguments.len()));
    code.push(bytecode::Instruction::Return);
    let locals: Vec[runtime::Value] = Vec::with_capacity(arguments.len() + 2);
    locals.push(receiver);
    locals.push(callable);
    for value in arguments {
        locals.push(value)
    }
    context.execute_with_locals(bytecode::Function::new(Vec::new(), code, locals.len()), locals)
}

fn arraybuffer_read_property(context: vm::Context, receiver: runtime::Value, name: string) -> runtime::Value {
    let bytes = name.to_bytes();
    arraybuffer_expect_value(
        context.read_property_at_depth(
            receiver,
            runtime::Value::String(runtime::JsString::from_utf8(bytes.slice(0, bytes.len()))),
            0,
        ),
    )
}

fn arraybuffer_set_index(
    context: vm::Context,
    receiver: runtime::Value,
    index: isize,
    value: runtime::Value,
) -> () {
    let object = arraybuffer_expect_object(receiver);
    match runtime::set_property(
        context.heap(),
        object,
        runtime::string_property_key(index.to_string()),
        value,
    ) {
        Ok(true) => (),
        Ok(false) => testing::fail("typed array index is not writable"),
        Err(value) => testing::fail(value.message),
    }
}

fn arraybuffer_construct(
    context: vm::Context,
    constructor: runtime::Value,
    arguments: Vec[runtime::Value],
) -> runtime::Value {
    if vm::is_constructor(context, constructor) {
        arraybuffer_expect_value(
            context.construct_with_new_target_at_depth(constructor, arguments, constructor, 0),
        )
    } else {
        arraybuffer_expect_value(arraybuffer_invoke(context, constructor, arguments))
    }
}

fn arraybuffer_int(value: runtime::Value) -> isize {
    match value {
        runtime::Value::Int(value) => value.to_isize(),
        _ => {
            testing::fail("expected integer");
            0
        },
    }
}

fn arraybuffer_expect_number(value: runtime::Value) -> f64 {
    match value {
        runtime::Value::Int(value) => num::parse_float64_structured(value.to_string()).unwrap_or(
            0.0,
        ),
        runtime::Value::Float(value) => value,
        _ => {
            testing::fail("expected number");
            0.0
        },
    }
}

#[test]
fn arraybuffer_installer_returns_five_callable_constructors() -> () {
    let context = vm::Context::new(runtime::Heap::new());
    let install = arraybuffer_expect_install(install_arraybuffer(context));
    for value in Vec::from_array(
        [
            install.array_buffer,
            install.data_view,
            install.uint8_array,
            install.int32_array,
            install.float64_array,
        ],
    ) {
        testing::assert(arraybuffer_expect_object(value).is_callable())
    }
}

#[test]
fn arraybuffer_constructor_slice_transfer_and_detach_keep_errors() -> () {
    let context = vm::Context::new(runtime::Heap::new());
    let install = arraybuffer_expect_install(install_arraybuffer(context));
    let empty = arraybuffer_construct(
        context,
        install.array_buffer,
        Vec::from_array([runtime::Value::Undefined]),
    );
    testing::assert_eq(arraybuffer_int(arraybuffer_read_property(context, empty, "byteLength")), 0);
    let buffer = arraybuffer_construct(
        context,
        install.array_buffer,
        Vec::from_array([runtime::Value::Int(8)]),
    );
    testing::assert_eq(arraybuffer_int(arraybuffer_read_property(context, buffer, "byteLength")), 8);
    let sliced = arraybuffer_expect_value(
        arraybuffer_invoke_method(
            context,
            buffer,
            "slice",
            Vec::from_array([runtime::Value::Int(2), runtime::Value::Int(6)]),
        ),
    );
    testing::assert_eq(arraybuffer_int(arraybuffer_read_property(context, sliced, "byteLength")), 4);
    let transferred = arraybuffer_expect_value(
        arraybuffer_invoke_method(
            context,
            buffer,
            "transfer",
            Vec::from_array([runtime::Value::Int(10)]),
        ),
    );
    testing::assert_eq(
        arraybuffer_int(arraybuffer_read_property(context, transferred, "byteLength")),
        10,
    );
    match arraybuffer_invoke_method(context, buffer, "slice", Vec::new()) {
        Err(vm::VmError { kind: vm::VmErrorKind::TypeError(message), .. }) => {
            testing::assert(message.contains("detached"))
        },
        _ => testing::fail("expected detached buffer error"),
    }
}

#[test]
fn data_view_wrapper_preserves_aliasing_endianness_and_bounds() -> () {
    let context = vm::Context::new(runtime::Heap::new());
    let install = arraybuffer_expect_install(install_arraybuffer(context));
    let buffer = arraybuffer_construct(
        context,
        install.array_buffer,
        Vec::from_array([runtime::Value::Int(16)]),
    );
    let view = arraybuffer_construct(
        context,
        install.data_view,
        Vec::from_array([buffer, runtime::Value::Int(2), runtime::Value::Int(8)]),
    );
    testing::assert_eq(arraybuffer_int(arraybuffer_read_property(context, view, "byteLength")), 8);
    let _ = arraybuffer_expect_value(
        arraybuffer_invoke_method(
            context,
            view,
            "setUint32",
            Vec::from_array([runtime::Value::Int(0), runtime::Value::Float(305419896.0)]),
        ),
    );
    testing::assert_eq(
        arraybuffer_int(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    view,
                    "getUint16",
                    Vec::from_array([runtime::Value::Int(0)]),
                ),
            ),
        ),
        0x1234,
    );
    testing::assert_eq(
        arraybuffer_int(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    view,
                    "getUint16",
                    Vec::from_array([runtime::Value::Int(0), runtime::Value::Bool(true)]),
                ),
            ),
        ),
        0x3412,
    );
    let _ = arraybuffer_expect_value(
        arraybuffer_invoke_method(
            context,
            view,
            "setFloat64",
            Vec::from_array([runtime::Value::Int(0), runtime::Value::Float(-3.25)]),
        ),
    );
    testing::assert_eq(
        arraybuffer_expect_number(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    view,
                    "getFloat64",
                    Vec::from_array([runtime::Value::Int(0)]),
                ),
            ),
        ),
        -3.25,
    );
    match arraybuffer_invoke_method(
        context,
        view,
        "getFloat64",
        Vec::from_array([runtime::Value::Int(1)]),
    ) {
        Err(vm::VmError { kind: vm::VmErrorKind::RangeError(_), .. }) => (),
        _ => testing::fail("expected DataView bounds error"),
    }
}

#[test]
fn data_view_checks_detachment_after_valid_large_indices() -> () {
    let context = vm::Context::new(runtime::Heap::new());
    let install = arraybuffer_expect_install(install_arraybuffer(context));
    let buffer = arraybuffer_construct(
        context,
        install.array_buffer,
        Vec::from_array([runtime::Value::Int(1)]),
    );
    let view = arraybuffer_construct(context, install.data_view, Vec::from_array([buffer]));
    match install.detach_array_buffer(buffer) {
        Ok(()) => (),
        Err(value) => testing::fail(value),
    }
    match arraybuffer_invoke_method(
        context,
        view,
        "getInt8",
        Vec::from_array([runtime::Value::Float(9007199254740991.0)]),
    ) {
        Err(vm::VmError { kind: vm::VmErrorKind::TypeError(_), .. }) => (),
        _ => testing::fail("expected detached DataView error after ToIndex"),
    }
}

#[test]
fn uint8_array_wrapper_supports_get_set_and_aliasing_subarray() -> () {
    let context = vm::Context::new(runtime::Heap::new());
    let install = arraybuffer_expect_install(install_arraybuffer(context));
    let array = arraybuffer_construct(
        context,
        install.uint8_array,
        Vec::from_array([runtime::Value::Int(4)]),
    );
    arraybuffer_set_index(context, array, 1, runtime::Value::Float(257.9));
    testing::assert_eq(
        arraybuffer_int(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    array,
                    "get",
                    Vec::from_array([runtime::Value::Int(1)]),
                ),
            ),
        ),
        1,
    );
    let subarray = arraybuffer_expect_value(
        arraybuffer_invoke_method(
            context,
            array,
            "subarray",
            Vec::from_array([runtime::Value::Int(1), runtime::Value::Int(3)]),
        ),
    );
    arraybuffer_set_index(context, subarray, 0, runtime::Value::Int(99));
    testing::assert_eq(
        arraybuffer_int(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    array,
                    "get",
                    Vec::from_array([runtime::Value::Int(1)]),
                ),
            ),
        ),
        99,
    );
    testing::assert_eq(arraybuffer_int(arraybuffer_read_property(context, subarray, "length")), 2)
}

#[test]
fn int32_and_float64_wrappers_convert_values_and_share_buffers() -> () {
    let context = vm::Context::new(runtime::Heap::new());
    let install = arraybuffer_expect_install(install_arraybuffer(context));
    let integers = arraybuffer_construct(
        context,
        install.int32_array,
        Vec::from_array([runtime::Value::Int(2)]),
    );
    arraybuffer_set_index(context, integers, 0, runtime::Value::Float(4294967295.0));
    testing::assert_eq(
        arraybuffer_int(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    integers,
                    "get",
                    Vec::from_array([runtime::Value::Int(0)]),
                ),
            ),
        ),
        -1,
    );
    let floats = arraybuffer_construct(
        context,
        install.float64_array,
        Vec::from_array([runtime::Value::Int(2)]),
    );
    arraybuffer_set_index(context, floats, 1, runtime::Value::Float(6.5));
    testing::assert_eq(
        arraybuffer_expect_number(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    floats,
                    "get",
                    Vec::from_array([runtime::Value::Int(1)]),
                ),
            ),
        ),
        6.5,
    );
    let buffer = arraybuffer_read_property(context, floats, "buffer");
    let view = arraybuffer_construct(context, install.data_view, Vec::from_array([buffer]));
    testing::assert_eq(
        arraybuffer_expect_number(
            arraybuffer_expect_value(
                arraybuffer_invoke_method(
                    context,
                    view,
                    "getFloat64",
                    Vec::from_array([runtime::Value::Int(8), runtime::Value::Bool(true)]),
                ),
            ),
        ),
        6.5,
    )
}

#[test]
fn typed_array_views_zero_metadata_and_fail_after_buffer_detach() -> () {
    let context = vm::Context::new(runtime::Heap::new());
    let install = arraybuffer_expect_install(install_arraybuffer(context));
    let buffer = arraybuffer_construct(
        context,
        install.array_buffer,
        Vec::from_array([runtime::Value::Int(8)]),
    );
    let array = arraybuffer_construct(context, install.int32_array, Vec::from_array([buffer]));
    let _ = arraybuffer_expect_value(
        arraybuffer_invoke_method(context, buffer, "transfer", Vec::new()),
    );
    testing::assert_eq(arraybuffer_int(arraybuffer_read_property(context, array, "length")), 0);
    match arraybuffer_invoke_method(
        context,
        array,
        "get",
        Vec::from_array([runtime::Value::Int(0)]),
    ) {
        Err(vm::VmError { kind: vm::VmErrorKind::TypeError(message), .. }) => {
            testing::assert(message.contains("detached buffer"))
        },
        _ => testing::fail("expected detached typed array error"),
    }
}
