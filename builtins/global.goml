fn math_log10(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let value = number_argument(arguments, 0)?;
    let result = math::log(value) / math::LN_10;
    let nearest = math::round(result);
    Result::Ok(
        runtime::Value::Float(
            if value > 0.0 && math::is_finite(value) && math::pow(10.0, nearest) == value {
                nearest
            } else {
                result
            },
        ),
    )
}

