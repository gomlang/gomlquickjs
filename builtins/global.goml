fn math_abs(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let value = number_argument(arguments, 0)?;
    Result::Ok(
        runtime::Value::Float(
            if value < 0.0 {
                -value
            } else if value == 0.0 {
                0.0
            } else {
                value
            },
        ),
    )
}

fn math_random(
    state: Ref[u64],
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let _ = arguments;
    let mut value = state.get();
    value ^= value >> 12;
    value ^= value << 25;
    value ^= value >> 27;
    state.set(value);
    let sample = (value * MATH_RANDOM_MULTIPLIER) >> 11;
    Result::Ok(
        runtime::Value::Float(
            num::parse_float64_structured(sample.to_string()).unwrap_or(0.0) / 9007199254740992.0,
        ),
    )
}

fn performance_now(
    origin: time::Instant,
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let _ = arguments;
    Result::Ok(
        runtime::Value::Float(
            num::parse_float64_structured(origin.elapsed().as_nanoseconds().to_string()).unwrap_or(
                0.0,
            )
                / 1000000.0,
        ),
    )
}

fn math_floor(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
