fn define_value(
    heap: runtime::Heap,
    object: runtime::ObjectId,
    name: string,
    value: runtime::Value,
    writable: bool,
    configurable: bool,
) -> Result[(), BuiltinError] {
    if runtime::define_own_property(
        heap,
        object,
        runtime::string_property_key(name),
        runtime::data_descriptor(value, writable, false, configurable),
    ) {
        Result::Ok(())
    } else {
        Result::Err(BuiltinError { message: "cannot define builtin " + name })
    }
}

fn builtin_own_value(heap: runtime::Heap, object: runtime::ObjectId, name: string) -> Result[
    runtime::Value,
    BuiltinError,
] {
    match heap.get(object) {
        Some(value) => match value.own_property(runtime::string_property_key(name)) {
            Some(descriptor) => match runtime::descriptor_value(descriptor) {
                Some(value) => Result::Ok(value),
                None => Result::Err(
                    BuiltinError { message: "builtin property is not data: " + name },
                ),
            },
            None => Result::Err(BuiltinError { message: "missing builtin property: " + name }),
        },
        None => Result::Err(BuiltinError { message: "builtin object is not live: " + name }),
    }
}

fn allocate_function(
    context: vm::Context,
    name: string,
    callback: (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
        runtime::Value,
        vm::NativeError,
    ],
) -> Result[runtime::Value, BuiltinError] {
    allocate_function_with_length(context, name, builtin_function_length(name), callback)
}

fn builtin_function_name(name: string) -> string {
    if name == "Function.prototype" {
        ""
    } else {
        let prefix = if text::starts_with_at(name, 0, "get ") {
            "get "
        } else if text::starts_with_at(name, 0, "set ") {
            "set "
        } else {
            ""
        };
        let base = if prefix == "" {
            name
        } else {
            name.byte_slice(prefix.byte_len(), name.byte_len())
        };
        let simple = match text::rfind(base, "[Symbol.") {
            Some(index) => base.byte_slice(index, base.byte_len()),
            None => match text::rfind(base, ".") {
                Some(index) => base.byte_slice(index + 1, base.byte_len()),
                None => base,
            },
        };
        if prefix == "" {
            simple
        } else {
            prefix + simple
        }
    }
}

fn builtin_function_length(name: string) -> isize {
    match name {
        "AggregateError" => 2,
        "Error" | "EvalError" | "InternalError" | "RangeError" | "ReferenceError" | "SyntaxError" | "TypeError" | "URIError" => 1,
        "Array" | "ArrayBuffer" | "SharedArrayBuffer" | "Boolean" | "BigInt" | "DataView" | "FinalizationRegistry" | "Function" | "Number" | "Object" | "Promise" | "String" | "WeakRef" => 1,
        "Float64Array" | "Int32Array" | "Uint8Array" | "Uint8ClampedArray" | "Int8Array" | "Int16Array" | "Uint16Array" | "Uint32Array" | "Float16Array" | "Float32Array" | "BigInt64Array" | "BigUint64Array" => 3,
        "Float64Array.from" | "Int32Array.from" | "Uint8Array.from" | "Uint8ClampedArray.from" | "Int8Array.from" | "Int16Array.from" | "Uint16Array.from" | "Uint32Array.from" | "Float16Array.from" | "Float32Array.from" | "BigInt64Array.from" | "BigUint64Array.from" => 1,
        "Date" => 7,
        "RegExp" => 2,
        "Map" | "Set" | "Symbol" | "Function.prototype" => 0,
        "Object.assign" | "Object.create" | "Object.defineProperties" | "Object.groupBy" => 2,
        "Object.defineProperty" => 3,
        "Object.fromEntries" => 1,
        "Object.entries" | "Object.getOwnPropertyDescriptors" | "Object.getOwnPropertyNames" | "Object.getOwnPropertySymbols" | "Object.getPrototypeOf" | "Object.isExtensible" | "Object.isFrozen" | "Object.isSealed" | "Object.keys" | "Object.preventExtensions" | "Object.seal" | "Object.freeze" | "Object.values" => 1,
        "Object.getOwnPropertyDescriptor" | "Object.hasOwn" | "Object.is" | "Object.setPrototypeOf" => 2,
        "isArray" => 1,
        "is" | "asIntN" | "asUintN" => 2,
        "Reflect.apply" | "Reflect.defineProperty" | "Reflect.set" => 3,
        "Reflect.construct" | "Reflect.deleteProperty" | "Reflect.get" | "Reflect.getOwnPropertyDescriptor" | "Reflect.has" | "Reflect.setPrototypeOf" => 2,
        "Reflect.getPrototypeOf" | "Reflect.isExtensible" | "Reflect.ownKeys" | "Reflect.preventExtensions" => 1,
        "Object.prototype.hasOwnProperty" | "Object.prototype.isPrototypeOf" | "Object.prototype.propertyIsEnumerable" | "Object.prototype.__lookupGetter__" | "Object.prototype.__lookupSetter__" => 1,
        "Object.prototype.__defineGetter__" | "Object.prototype.__defineSetter__" => 2,
        "Object.prototype.toString" | "Object.prototype.valueOf" => 0,
        "Function.prototype.apply" => 2,
        "Function.prototype.toString" => 0,
        "Function.prototype[Symbol.hasInstance]" => 1,
        "Function.prototype.bind" | "Function.prototype.call" => 1,
        "Array.from" => 1,
        "Array.prototype.entries" | "Array.prototype.keys" | "Array.prototype.values" => 0,
        "Array.prototype.reduce" | "Array.prototype.reduceRight" => 1,
        "Array.prototype.with" | "Array.prototype.toSpliced" | "Array.prototype.copyWithin" => 2,
        "Array.prototype.toReversed" | "Array.prototype.flat" => 0,
        "Array.prototype.toSorted" | "Array.prototype.fill" | "Array.prototype.findLast" | "Array.prototype.findLastIndex" | "Array.prototype.flatMap" | "Array.prototype.sort" => 1,
        "TypedArray.prototype.set" => 1,
        "TypedArray.prototype.subarray" => 2,
        "Map.prototype.clear" | "Map.prototype.entries" | "Map.prototype.keys" | "Map.prototype.values" | "Set.prototype.clear" | "Set.prototype.entries" | "Set.prototype.values" => 0,
        "Map.prototype.delete" | "Map.prototype.get" | "Map.prototype.has" | "Map.prototype.forEach" | "Set.prototype.add" | "Set.prototype.delete" | "Set.prototype.has" | "Set.prototype.forEach" | "Set.prototype.isDisjointFrom" | "Set.prototype.isSubsetOf" | "Set.prototype.isSupersetOf" | "Set.prototype.intersection" | "Set.prototype.difference" | "Set.prototype.symmetricDifference" | "Set.prototype.union" | "WeakMap.prototype.get" | "WeakMap.prototype.has" | "WeakMap.prototype.delete" | "WeakSet.prototype.add" | "WeakSet.prototype.has" | "WeakSet.prototype.delete" => 1,
        "Map.groupBy" | "Set.groupBy" | "Map.prototype.set" | "Map.prototype.getOrInsert" | "Map.prototype.getOrInsertComputed" | "WeakMap.prototype.set" | "WeakMap.prototype.getOrInsert" | "WeakMap.prototype.getOrInsertComputed" => 2,
        "Error.isError" | "RegExp.escape" | "Promise.prototype.catch" | "Promise.prototype.finally" | "Promise.reject" | "Promise.resolve" => 1,
        "Promise.prototype.then" => 2,
        "Promise.all" | "Promise.allSettled" | "Promise.any" | "Promise.race" | "Promise.try" => 1,
        "Promise.withResolvers" => 0,
        "RegExp.prototype.exec" | "RegExp.prototype.test" | "RegExp.prototype[Symbol.match]" | "RegExp.prototype[Symbol.matchAll]" | "RegExp.prototype[Symbol.search]" | "String.prototype.matchAll" => 1,
        "RegExp.prototype[Symbol.replace]" | "RegExp.prototype[Symbol.split]" => 2,
        "RegExp.prototype.compile" => 2,
        "FinalizationRegistry.prototype.register" => 2,
        "FinalizationRegistry.prototype.unregister" => 1,
        "set __proto__" => 1,
        "Date.parse" => 1,
        "Date.UTC" => 7,
        "Date.now" | "Date.prototype.getTime" | "Date.prototype.valueOf" => 0,
        "Date.prototype.toJSON" | "Date.prototype[Symbol.toPrimitive]" => 1,
        "ArrayBuffer.prototype.slice" => 2,
        "ArrayBuffer.prototype.resize" => 1,
        "SharedArrayBuffer.prototype.slice" => 2,
        "SharedArrayBuffer.prototype.grow" => 1,
        "ArrayBuffer.isView" => 1,
        "Atomics.add" | "Atomics.and" | "Atomics.exchange" | "Atomics.or" | "Atomics.store" | "Atomics.sub" | "Atomics.xor" => 3,
        "Atomics.compareExchange" => 4,
        "Atomics.isLockFree" => 1,
        "Atomics.load" => 2,
        "Atomics.notify" => 3,
        "Atomics.pause" => 0,
        "Atomics.wait" => 4,
        "DataView.prototype.getInt8" | "DataView.prototype.getUint8" | "DataView.prototype.getInt16" | "DataView.prototype.getUint16" | "DataView.prototype.getInt32" | "DataView.prototype.getUint32" | "DataView.prototype.getBigInt64" | "DataView.prototype.getBigUint64" | "DataView.prototype.getFloat16" | "DataView.prototype.getFloat32" | "DataView.prototype.getFloat64" => 1,
        "DataView.prototype.setInt8" | "DataView.prototype.setUint8" | "DataView.prototype.setInt16" | "DataView.prototype.setUint16" | "DataView.prototype.setInt32" | "DataView.prototype.setUint32" | "DataView.prototype.setBigInt64" | "DataView.prototype.setBigUint64" | "DataView.prototype.setFloat16" | "DataView.prototype.setFloat32" | "DataView.prototype.setFloat64" => 2,
        "Uint8Array.prototype.get" | "Int32Array.prototype.get" | "Float64Array.prototype.get" | "Uint8ClampedArray.prototype.get" | "Int8Array.prototype.get" | "Int16Array.prototype.get" | "Uint16Array.prototype.get" | "Uint32Array.prototype.get" | "Float16Array.prototype.get" | "Float32Array.prototype.get" | "BigInt64Array.prototype.get" | "BigUint64Array.prototype.get" => 1,
        "Uint8Array.prototype.set" | "Int32Array.prototype.set" | "Float64Array.prototype.set" | "Uint8Array.prototype.subarray" | "Int32Array.prototype.subarray" | "Float64Array.prototype.subarray" | "Uint8ClampedArray.prototype.set" | "Int8Array.prototype.set" | "Int16Array.prototype.set" | "Uint16Array.prototype.set" | "Uint32Array.prototype.set" | "Float16Array.prototype.set" | "Float32Array.prototype.set" | "Uint8ClampedArray.prototype.subarray" | "Int8Array.prototype.subarray" | "Int16Array.prototype.subarray" | "Uint16Array.prototype.subarray" | "Uint32Array.prototype.subarray" | "Float16Array.prototype.subarray" | "Float32Array.prototype.subarray" | "BigInt64Array.prototype.set" | "BigUint64Array.prototype.set" | "BigInt64Array.prototype.subarray" | "BigUint64Array.prototype.subarray" => 2,
        "Symbol.for" | "Symbol.keyFor" => 1,
        "String.prototype.match" | "String.prototype.search" => 1,
        "String.prototype.replace" | "String.prototype.replaceAll" | "String.prototype.split" => 2,
        "String.prototype.iterator" => 0,
        "Iterator.from" => 1,
        "Iterator.concat" => 0,
        "Iterator.prototype.drop" | "Iterator.prototype.filter" | "Iterator.prototype.flatMap" | "Iterator.prototype.map" | "Iterator.prototype.take" | "Iterator.prototype.every" | "Iterator.prototype.find" | "Iterator.prototype.forEach" | "Iterator.prototype.some" | "Iterator.prototype.reduce" => 1,
        "Iterator.prototype.toArray" | "Iterator.prototype[Symbol.iterator]" => 0,
        "parse" => 2,
        "stringify" => 3,
        "rawJSON" | "isRawJSON" => 1,
        "parseInt" => 2,
        "parseFloat" | "isNaN" | "isFinite" | "isInteger" | "isSafeInteger" | "encodeURI" | "encodeURIComponent" | "decodeURI" | "decodeURIComponent" | "escape" | "unescape" | "fromCharCode" | "fromCodePoint" | "String.raw" | "sumPrecise" => 1,
        "max" | "min" | "pow" | "imul" | "atan2" | "hypot" => 2,
        "abs" | "floor" | "ceil" | "trunc" | "round" | "sign" | "exp" | "log" | "log2" | "log10" | "sin" | "cos" | "tan" | "asin" | "acos" | "atan" | "sqrt" | "clz32" | "f16round" | "fround" | "cbrt" | "log1p" | "expm1" | "sinh" | "cosh" | "tanh" | "asinh" | "acosh" | "atanh" => 1,
        _ => match builtin_function_name(name) {
            "toString" | "toLocaleString" | "valueOf" | "clear" | "entries" | "keys" | "values" | "pop" | "reverse" | "toReversed" | "shift" | "trim" | "trimStart" | "trimEnd" => 0,
            "at" | "charAt" | "charCodeAt" | "codePointAt" | "includes" | "indexOf" | "lastIndexOf" | "join" | "fill" | "repeat" | "push" | "unshift" | "forEach" | "map" | "filter" | "every" | "some" | "find" | "findIndex" | "findLast" | "findLastIndex" | "reduce" | "reduceRight" | "sort" | "toSorted" | "startsWith" | "endsWith" | "padStart" | "padEnd" | "concat" | "anchor" | "fontcolor" | "fontsize" | "link" | "localeCompare" | "setTime" | "setMilliseconds" | "setUTCMilliseconds" | "setDate" | "setUTCDate" | "setYear" => 1,
            "slice" | "substring" | "substr" | "splice" | "copyWithin" | "with" | "setSeconds" | "setUTCSeconds" | "setMonth" | "setUTCMonth" => 2,
            "setMinutes" | "setUTCMinutes" | "setFullYear" | "setUTCFullYear" => 3,
            "setHours" | "setUTCHours" => 4,
            _ => 0,
        },
    }
}

fn initialize_builtin_function(
    heap: runtime::Heap,
    value: runtime::Value,
    name: string,
    length: isize,
) -> bool {
    match value {
        runtime::Value::Object(object) => runtime::define_own_property(
            heap,
            object,
            runtime::string_property_key("length"),
            runtime::data_descriptor(runtime::Value::Int(length.to_i32()), false, false, true),
        )
            && runtime::define_own_property(
                heap,
                object,
                runtime::string_property_key("name"),
                runtime::data_descriptor(
                    runtime::Value::String(js_string(builtin_function_name(name))),
                    false,
                    false,
                    true,
                ),
            ),
        _ => false,
    }
}

fn allocate_function_with_length(
    context: vm::Context,
    name: string,
    length: isize,
    callback: (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
        runtime::Value,
        vm::NativeError,
    ],
) -> Result[runtime::Value, BuiltinError] {
    match context.new_builtin_function(callback) {
        Ok(value) => if initialize_builtin_function(context.heap(), value, name, length) {
            Result::Ok(value)
        } else {
            Result::Err(BuiltinError { message: "cannot initialize builtin " + name })
        },
        Err(_) => {
            Result::Err(BuiltinError { message: "cannot allocate builtin " + name })
        },
    }
}

fn allocate_vm_function(
    context: vm::Context,
    name: string,
    callback: (runtime::Value, Vec[runtime::Value], isize) -> Result[runtime::Value, vm::VmError],
) -> Result[runtime::Value, BuiltinError] {
    allocate_vm_function_with_length(context, name, builtin_function_length(name), callback)
}

fn allocate_vm_function_with_length(
    context: vm::Context,
    name: string,
    length: isize,
    callback: (runtime::Value, Vec[runtime::Value], isize) -> Result[runtime::Value, vm::VmError],
) -> Result[runtime::Value, BuiltinError] {
    match context.new_vm_function(callback) {
        Ok(value) => if initialize_builtin_function(context.heap(), value, name, length) {
            Result::Ok(value)
        } else {
            Result::Err(BuiltinError { message: "cannot initialize builtin " + name })
        },
        Err(_) => Result::Err(BuiltinError { message: "cannot allocate builtin " + name }),
    }
}

fn number_value_at_depth(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    match runtime::primitive_to_number(primitive) {
        Ok(value) => Result::Ok(runtime::Value::Float(value)),
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn bigint_value_at_depth(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let primitive = context.to_primitive_number_at_depth(value, depth)?;
    match primitive {
        runtime::Value::BigInt(value) => Result::Ok(runtime::Value::BigInt(value)),
        runtime::Value::Bool(value) => Result::Ok(
            runtime::Value::BigInt(
                runtime::BigInt::from_int64(
                    if value {
                        1
                    } else {
                        0
                    },
                ),
            ),
        ),
        runtime::Value::String(value) => match runtime::string_to_bigint(value) {
            Ok(value) => Result::Ok(runtime::Value::BigInt(value)),
            Err(value) => Result::Err(function_syntax_error(value.message)),
        },
        _ => Result::Err(function_vm_error("cannot convert value to BigInt")),
    }
}

fn number_arguments_at_depth(
    context: vm::Context,
    arguments: Vec[runtime::Value],
    minimum: isize,
    all: bool,
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let converted = arguments;
    while converted.len() < minimum {
        converted.push(runtime::Value::Undefined);
    }
    let total = converted.len();
    let mut index = 0;
    while index < total {
        if all || index < minimum {
            converted[index] = number_value_at_depth(context, converted[index], depth)?;
        }
        index += 1;
    }
    Result::Ok(converted)
}

fn define_number_function(
    context: vm::Context,
    object: runtime::ObjectId,
    name: string,
    callback: NativeBuiltin,
    minimum: isize,
    all: bool,
) -> Result[(), BuiltinError] {
    define_value(
        context.heap(),
        object,
        name,
        allocate_vm_function(
            context,
            name,
            |this_value, arguments, depth| {
                let converted = number_arguments_at_depth(context, arguments, minimum, all, depth)?;
                match callback(context.heap(), this_value, converted) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => Result::Err(function_native_error(value)),
                }
            },
        )?,
        true,
        true,
    )
}

fn string_value_at_depth(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let primitive = context.to_primitive_string_at_depth(value, depth)?;
    match primitive {
        runtime::Value::Symbol(_) => {
            Result::Err(function_vm_error("cannot convert symbol to string"))
        },
        _ => match string_constructor(
            context.heap(),
            runtime::Value::Undefined,
            Vec::from_array([primitive]),
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
    }
}

fn string_arguments_at_depth(
    context: vm::Context,
    arguments: Vec[runtime::Value],
    minimum: isize,
    all: bool,
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let converted = arguments;
    while converted.len() < minimum {
        converted.push(runtime::Value::Undefined);
    }
    let total = converted.len();
    let mut index = 0;
    while index < total {
        if all || index < minimum {
            converted[index] = string_value_at_depth(context, converted[index], depth)?;
        }
        index += 1;
    }
    Result::Ok(converted)
}

fn define_string_function(
    context: vm::Context,
    object: runtime::ObjectId,
    name: string,
    callback: NativeBuiltin,
    minimum: isize,
    all: bool,
) -> Result[(), BuiltinError] {
    define_value(
        context.heap(),
        object,
        name,
        allocate_vm_function(
            context,
            name,
            |this_value, arguments, depth| {
                let converted = string_arguments_at_depth(context, arguments, minimum, all, depth)?;
                match callback(context.heap(), this_value, converted) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => Result::Err(function_native_error(value)),
                }
            },
        )?,
        true,
        true,
    )
}

fn define_parse_int_function(context: vm::Context, object: runtime::ObjectId) -> Result[
    (),
    BuiltinError,
] {
    define_value(
        context.heap(),
        object,
        "parseInt",
        allocate_vm_function(
            context,
            "parseInt",
            |this_value, arguments, depth| {
                let converted = Vec::from_array(
                    [
                        string_value_at_depth(context, argument(arguments, 0), depth)?,
                        number_value_at_depth(context, argument(arguments, 1), depth)?,
                    ],
                );
                match global_parse_int(context.heap(), this_value, converted) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => Result::Err(function_native_error(value)),
                }
            },
        )?,
        true,
        true,
    )
}

fn define_bigint_width_function(
    context: vm::Context,
    object: runtime::ObjectId,
    name: string,
    callback: NativeBuiltin,
) -> Result[(), BuiltinError] {
    define_value(
        context.heap(),
        object,
        name,
        allocate_vm_function(
            context,
            name,
            |this_value, arguments, depth| {
                let converted = Vec::from_array(
                    [
                        number_value_at_depth(context, argument(arguments, 0), depth)?,
                        bigint_value_at_depth(context, argument(arguments, 1), depth)?,
                    ],
                );
                match callback(context.heap(), this_value, converted) {
                    Ok(value) => Result::Ok(value),
                    Err(value) => Result::Err(function_native_error(value)),
                }
            },
        )?,
        true,
        true,
    )
}

fn property_key_value_at_depth(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let primitive = context.to_primitive_string_at_depth(value, depth)?;
    match primitive {
        runtime::Value::Symbol(value) => Result::Ok(runtime::Value::Symbol(value)),
        _ => match string_constructor(
            context.heap(),
            runtime::Value::Undefined,
            Vec::from_array([primitive]),
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
    }
}

fn reflect_type_error(message: string) -> vm::VmError {
    vm::VmError { offset: -1, kind: vm::VmErrorKind::TypeError(message) }
}

fn reflect_object(value: runtime::Value) -> Result[runtime::ObjectId, vm::VmError] {
    match value {
        runtime::Value::Object(value) => Result::Ok(value),
        _ => Result::Err(reflect_type_error("Reflect target is not an object")),
    }
}

fn reflect_arguments(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    Vec[runtime::Value],
    vm::VmError,
] {
    let _ = reflect_object(value)?;
    function_apply_arguments(context, value, depth)
}

struct ParsedPropertyDescriptor {
    descriptor: runtime::PropertyDescriptor,
    trap_value: runtime::Value,
}

fn descriptor_snapshot_value(fields: Vec[(string, runtime::Value)], name: string) -> Option[
    runtime::Value,
] {
    for field in fields {
        if field.0 == name {
            return Option::Some(field.1)
        }
    }
    Option::None
}

fn parsed_descriptor_from_object_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    current: Option[runtime::PropertyDescriptor],
    depth: isize,
) -> Result[ParsedPropertyDescriptor, vm::VmError] {
    let snapshot = match runtime::new_null_prototype_object(context.heap()) {
        Ok(value) => value,
        Err(value) => return Result::Err(reflect_type_error(value.message)),
    };
    let fields: Vec[(string, runtime::Value)] = Vec::new();
    for name in Vec::from_array(["enumerable", "configurable", "value", "writable", "get", "set"]) {
        let key_value = runtime::Value::String(js_string(name));
        let present = context.has_property_at_depth(
            runtime::Value::Object(object),
            key_value,
            depth,
        )?;
        if present {
            let value = context.read_property_at_depth(
                runtime::Value::Object(object),
                key_value,
                depth,
            )?;
            fields.push((name, value))
        }
    }
    for name in Vec::from_array(["value", "writable", "get", "set", "enumerable", "configurable"]) {
        match descriptor_snapshot_value(fields, name) {
            Some(value) => if !runtime::define_own_property(
                context.heap(),
                snapshot,
                runtime::string_property_key(name),
                runtime::data_descriptor(value, true, true, true),
            ) {
                return Result::Err(reflect_type_error("cannot snapshot property descriptor"))
            },
            None => (),
        }
    }
    match descriptor_from_object(context.heap(), snapshot, current) {
        Ok(value) => Result::Ok(
            ParsedPropertyDescriptor {
                descriptor: value,
                trap_value: runtime::Value::Object(snapshot),
            },
        ),
        Err(value) => Result::Err(function_native_error(value)),
    }
}

fn descriptor_from_object_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    current: Option[runtime::PropertyDescriptor],
    depth: isize,
) -> Result[runtime::PropertyDescriptor, vm::VmError] {
    Result::Ok(parsed_descriptor_from_object_at_depth(context, object, current, depth)?.descriptor)
}

fn typed_array_descriptor_at_depth(
    context: vm::Context,
    target: runtime::ObjectId,
    key: runtime::PropertyKey,
    descriptor: runtime::PropertyDescriptor,
    depth: isize,
) -> Result[runtime::PropertyDescriptor, vm::VmError] {
    if !runtime::is_typed_array_valid_numeric_property(context.heap(), target, key) {
        Result::Ok(descriptor)
    } else {
        match descriptor {
            runtime::PropertyDescriptor::Data { value, writable, enumerable, configurable } => {
                Result::Ok(
                    runtime::data_descriptor(
                        if runtime::is_bigint_typed_array(context.heap(), target) {
                            bigint_value_at_depth(context, value, depth)?
                        } else {
                            number_value_at_depth(context, value, depth)?
                        },
                        writable,
                        enumerable,
                        configurable,
                    ),
                )
            },
            runtime::PropertyDescriptor::Accessor { .. } => Result::Ok(descriptor),
        }
    }
}

fn property_key_runtime_value(key: runtime::PropertyKey) -> runtime::Value {
    match key {
        runtime::PropertyKey::String(value) => runtime::Value::String(value),
        runtime::PropertyKey::Symbol(value) => runtime::Value::Symbol(value),
    }
}

fn reflect_proxy_parts(context: vm::Context, object: runtime::ObjectId) -> Result[
    Option[(runtime::ObjectId, runtime::ObjectId)],
    vm::VmError,
] {
    let value = match context.heap().get(object) {
        Some(value) => value,
        None => return Result::Err(reflect_type_error("proxy is invalid")),
    };
    if !value.is_proxy() {
        return Result::Ok(Option::None)
    }
    match (value.proxy_target(), value.proxy_handler()) {
        (Some(target), Some(handler)) => Result::Ok(Option::Some((target, handler))),
        _ => Result::Err(reflect_type_error("proxy has been revoked")),
    }
}

fn reflect_proxy_trap_at_depth(
    context: vm::Context,
    handler: runtime::ObjectId,
    name: string,
    depth: isize,
) -> Result[Option[runtime::Value], vm::VmError] {
    let value = context.read_property_at_depth(
        runtime::Value::Object(handler),
        runtime::Value::String(js_string(name)),
        depth,
    )?;
    match value {
        runtime::Value::Undefined | runtime::Value::Null => Result::Ok(Option::None),
        _ => Result::Ok(Option::Some(value)),
    }
}

fn proxy_target_current_descriptor(
    context: vm::Context,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
) -> Result[Option[runtime::PropertyDescriptor], vm::VmError] {
    match reflect_proxy_parts(context, object)? {
        Some((target, _)) => proxy_target_current_descriptor(context, target, key),
        None => match context.heap().get(object) {
            Some(value) => checked_module_namespace_descriptor(
                context,
                object,
                value.own_property(key),
            ),
            None => Result::Err(reflect_type_error("object is invalid")),
        },
    }
}

fn checked_module_namespace_descriptor(
    context: vm::Context,
    object: runtime::ObjectId,
    descriptor: Option[runtime::PropertyDescriptor],
) -> Result[Option[runtime::PropertyDescriptor], vm::VmError] {
    match descriptor {
        Some(runtime::PropertyDescriptor::Data { value, writable, enumerable, configurable }) => {
            if runtime::is_module_namespace(context.heap(), object)
                && runtime::is_tdz_value(context.heap(), value) {
                Result::Err(
                    vm::VmError {
                        offset: -1,
                        kind: vm::VmErrorKind::ReferenceError("binding is not initialized"),
                    },
                )
            } else {
                Result::Ok(
                    Option::Some(
                        runtime::data_descriptor(value, writable, enumerable, configurable),
                    ),
                )
            }
        },
        Some(value) => Result::Ok(Option::Some(value)),
        None => Result::Ok(Option::None),
    }
}

fn proxy_get_own_property_descriptor_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
    depth: isize,
) -> Result[Option[runtime::PropertyDescriptor], vm::VmError] {
    match reflect_proxy_parts(context, object)? {
        Some((target, handler)) => match reflect_proxy_trap_at_depth(
            context,
            handler,
            "getOwnPropertyDescriptor",
            depth,
        )? {
            Some(trap) => {
                let result = context.invoke_with_this_at_depth(
                    trap,
                    Vec::from_array(
                        [runtime::Value::Object(target), property_key_runtime_value(key)],
                    ),
                    runtime::Value::Object(handler),
                    depth,
                )?;
                let target_descriptor = proxy_get_own_property_descriptor_at_depth(
                    context,
                    target,
                    key,
                    depth,
                )?;
                let extensible = context.is_extensible_at_depth(
                    runtime::Value::Object(target),
                    depth,
                )?;
                match result {
                    runtime::Value::Undefined => match target_descriptor {
                        Some(value) => if !runtime::descriptor_configurable(value) || !extensible {
                            Result::Err(
                                reflect_type_error(
                                    "proxy getOwnPropertyDescriptor trap hid a required property",
                                ),
                            )
                        } else {
                            Result::Ok(Option::None)
                        },
                        None => Result::Ok(Option::None),
                    },
                    runtime::Value::Object(descriptor_object) => {
                        let descriptor = descriptor_from_object_at_depth(
                            context,
                            descriptor_object,
                            Option::None,
                            depth,
                        )?;
                        if !runtime::compatible_property_descriptor(
                            extensible,
                            descriptor,
                            target_descriptor,
                        ) {
                            return Result::Err(
                                reflect_type_error(
                                    "proxy getOwnPropertyDescriptor trap returned an incompatible descriptor",
                                ),
                            )
                        }
                        if !runtime::descriptor_configurable(descriptor) {
                            match target_descriptor {
                                Some(value) => if runtime::descriptor_configurable(value) {
                                    return Result::Err(
                                        reflect_type_error(
                                            "proxy getOwnPropertyDescriptor trap made a configurable property non-configurable",
                                        ),
                                    )
                                },
                                None => return Result::Err(
                                    reflect_type_error(
                                        "proxy getOwnPropertyDescriptor trap created a non-configurable property",
                                    ),
                                ),
                            }
                        }
                        match target_descriptor {
                            Some(value) => if !runtime::descriptor_configurable(descriptor)
                                && runtime::descriptor_is_data(descriptor)
                                && !runtime::descriptor_writable(descriptor)
                                && runtime::descriptor_is_data(value)
                                && runtime::descriptor_writable(value) {
                                return Result::Err(
                                    reflect_type_error(
                                        "proxy getOwnPropertyDescriptor trap made a writable property non-writable",
                                    ),
                                )
                            },
                            None => (),
                        }
                        Result::Ok(Option::Some(descriptor))
                    },
                    _ => Result::Err(
                        reflect_type_error(
                            "proxy getOwnPropertyDescriptor trap returned an invalid descriptor",
                        ),
                    ),
                }
            },
            None => proxy_get_own_property_descriptor_at_depth(context, target, key, depth),
        },
        None => match context.heap().get(object) {
            Some(value) => checked_module_namespace_descriptor(
                context,
                object,
                value.own_property(key),
            ),
            None => Result::Err(reflect_type_error("object is invalid")),
        },
    }
}

fn proxy_descriptor_field_present(
    context: vm::Context,
    descriptor: Option[runtime::Value],
    name: string,
) -> bool {
    match descriptor {
        Some(runtime::Value::Object(object)) => match context.heap().get(object) {
            Some(value) => value.own_property(runtime::string_property_key(name)).is_some(),
            None => false,
        },
        Some(_) => false,
        None => true,
    }
}

fn proxy_define_property_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
    descriptor: runtime::PropertyDescriptor,
    trap_descriptor: Option[runtime::Value],
    depth: isize,
) -> Result[bool, vm::VmError] {
    match reflect_proxy_parts(context, object)? {
        Some((target, handler)) => match reflect_proxy_trap_at_depth(
            context,
            handler,
            "defineProperty",
            depth,
        )? {
            Some(trap) => {
                let descriptor_value = match trap_descriptor {
                    Some(value) => value,
                    None => match descriptor_object(context.heap(), descriptor) {
                        Ok(value) => value,
                        Err(value) => return Result::Err(function_native_error(value)),
                    },
                };
                let result = runtime::to_boolean(
                    context.invoke_with_this_at_depth(
                        trap,
                        Vec::from_array(
                            [
                                runtime::Value::Object(target),
                                property_key_runtime_value(key),
                                descriptor_value,
                            ],
                        ),
                        runtime::Value::Object(handler),
                        depth,
                    )?,
                );
                if !result {
                    return Result::Ok(false)
                }
                let target_descriptor = proxy_get_own_property_descriptor_at_depth(
                    context,
                    target,
                    key,
                    depth,
                )?;
                let extensible = context.is_extensible_at_depth(
                    runtime::Value::Object(target),
                    depth,
                )?;
                if !runtime::compatible_property_descriptor(
                    extensible,
                    descriptor,
                    target_descriptor,
                ) {
                    return Result::Err(
                        reflect_type_error(
                            "proxy defineProperty trap accepted an incompatible descriptor",
                        ),
                    )
                }
                let setting_configurable_false = !runtime::descriptor_configurable(descriptor)
                    && proxy_descriptor_field_present(context, trap_descriptor, "configurable");
                let setting_writable_false = runtime::descriptor_is_data(descriptor)
                    && !runtime::descriptor_writable(descriptor)
                    && proxy_descriptor_field_present(context, trap_descriptor, "writable");
                if setting_configurable_false {
                    match target_descriptor {
                        Some(value) => if runtime::descriptor_configurable(value) {
                            return Result::Err(
                                reflect_type_error(
                                    "proxy defineProperty trap made a configurable property non-configurable",
                                ),
                            )
                        },
                        None => return Result::Err(
                            reflect_type_error(
                                "proxy defineProperty trap created a non-configurable property",
                            ),
                        ),
                    }
                }
                match target_descriptor {
                    Some(value) => if setting_writable_false && runtime::descriptor_is_data(value)
                        && !runtime::descriptor_configurable(value)
                        && runtime::descriptor_writable(value) {
                        return Result::Err(
                            reflect_type_error(
                                "proxy defineProperty trap made a writable property non-writable",
                            ),
                        )
                    },
                    None => (),
                }
                Result::Ok(true)
            },
            None => proxy_define_property_at_depth(
                context,
                target,
                key,
                descriptor,
                trap_descriptor,
                depth,
            ),
        },
        None => {
            let valid_typed_index = runtime::is_typed_array_valid_numeric_property(
                context.heap(),
                object,
                key,
            );
            let converted = array_length_descriptor_at_depth(
                context,
                object,
                key,
                descriptor,
                depth,
            )?;
            let converted = typed_array_descriptor_at_depth(context, object, key, converted, depth)?;
            let defined = runtime::define_own_property(context.heap(), object, key, converted);
            Result::Ok(
                defined
                    || valid_typed_index
                        && !runtime::is_typed_array_valid_numeric_property(
                            context.heap(),
                            object,
                            key,
                        ),
            )
        },
    }
}

fn proxy_own_key_values_at_depth(context: vm::Context, object: runtime::ObjectId, depth: isize) -> Result[
    Vec[runtime::Value],
    vm::VmError,
] {
    let keys = context.own_keys_at_depth(runtime::Value::Object(object), depth)?;
    reflect_arguments(context, keys, depth)
}

fn proxy_own_enumerable_string_keys_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let result: Vec[runtime::Value] = Vec::new();
    for value in proxy_own_key_values_at_depth(context, object, depth)? {
        match value {
            runtime::Value::String(name) => match proxy_get_own_property_descriptor_at_depth(
                context,
                object,
                runtime::js_string_property_key(name),
                depth,
            )? {
                Some(descriptor) => if runtime::descriptor_enumerable(descriptor) {
                    result.push(runtime::Value::String(name))
                },
                None => (),
            },
            _ => (),
        }
    }
    Result::Ok(result)
}

fn object_define_property_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = reflect_object(argument(arguments, 0))?;
    let key_value = property_key_value_at_depth(context, argument(arguments, 1), depth)?;
    let key = match property_key_from_value(context.heap(), key_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let descriptor_object = reflect_object(argument(arguments, 2))?;
    let current = proxy_target_current_descriptor(context, target, key)?;
    let descriptor = parsed_descriptor_from_object_at_depth(
        context,
        descriptor_object,
        current,
        depth,
    )?;
    if proxy_define_property_at_depth(
        context,
        target,
        key,
        descriptor.descriptor,
        Option::Some(descriptor.trap_value),
        depth,
    )? {
        Result::Ok(runtime::Value::Object(target))
    } else {
        Result::Err(reflect_type_error("cannot define object property"))
    }
}

fn object_get_own_property_descriptor_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let object = match object_coercion(context.heap(), argument(arguments, 0)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let key_value = property_key_value_at_depth(context, argument(arguments, 1), depth)?;
    let key = match property_key_from_value(context.heap(), key_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    match proxy_get_own_property_descriptor_at_depth(context, object, key, depth)? {
        Some(value) => match descriptor_object(context.heap(), value) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn object_own_property_test_at_depth(
    context: vm::Context,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
    enumerable: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let descriptor = proxy_get_own_property_descriptor_at_depth(context, object, key, depth)?;
    Result::Ok(
        runtime::Value::Bool(
            match descriptor {
                Some(value) => !enumerable || runtime::descriptor_enumerable(value),
                None => false,
            },
        ),
    )
}

fn object_has_own_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let object = match object_coercion(context.heap(), argument(arguments, 0)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let converted = property_key_value_at_depth(context, argument(arguments, 1), depth)?;
    let key = match property_key_from_value(context.heap(), converted) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    object_own_property_test_at_depth(context, object, key, false, depth)
}

fn object_prototype_own_property_test_at_depth(
    context: vm::Context,
    receiver: runtime::Value,
    key_value: runtime::Value,
    enumerable: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let converted = property_key_value_at_depth(context, key_value, depth)?;
    let key = match property_key_from_value(context.heap(), converted) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let object = match object_coercion(context.heap(), receiver) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    object_own_property_test_at_depth(context, object, key, enumerable, depth)
}

fn object_prototype_has_own_property_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    object_prototype_own_property_test_at_depth(
        context,
        this_value,
        argument(arguments, 0),
        false,
        depth,
    )
}

fn object_prototype_property_is_enumerable_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    object_prototype_own_property_test_at_depth(
        context,
        this_value,
        argument(arguments, 0),
        true,
        depth,
    )
}

fn object_own_keys_by_kind_at_depth(
    context: vm::Context,
    value: runtime::Value,
    symbols: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match object_coercion(context.heap(), value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let values: Vec[runtime::Value] = Vec::new();
    for key in proxy_own_key_values_at_depth(context, object, depth)? {
        match key {
            runtime::Value::String(_) => if !symbols {
                values.push(key)
            },
            runtime::Value::Symbol(_) => if symbols {
                values.push(key)
            },
            _ => (),
        }
    }
    match allocate_array(context.heap(), values, values.len()) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(value) => Result::Err(function_native_error(value)),
    }
}

fn object_get_own_property_names_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_own_keys_by_kind_at_depth(context, argument(arguments, 0), false, depth)
}

fn object_get_own_property_symbols_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_own_keys_by_kind_at_depth(context, argument(arguments, 0), true, depth)
}

fn object_keys_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let object = match object_coercion(context.heap(), argument(arguments, 0)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let keys = proxy_own_enumerable_string_keys_at_depth(context, object, depth)?;
    match allocate_array(context.heap(), keys, keys.len()) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(value) => Result::Err(function_native_error(value)),
    }
}

fn object_define_properties_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = reflect_object(argument(arguments, 0))?;
    let descriptors = match object_coercion(context.heap(), argument(arguments, 1)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let pending: Vec[(runtime::PropertyKey, runtime::PropertyDescriptor, runtime::Value)] = Vec::new();
    for key_value in proxy_own_key_values_at_depth(context, descriptors, depth)? {
        let key = match key_value {
            runtime::Value::String(value) => runtime::js_string_property_key(value),
            runtime::Value::Symbol(value) => runtime::PropertyKey::Symbol(value),
            _ => return Result::Err(reflect_type_error("descriptor key is invalid")),
        };
        match proxy_get_own_property_descriptor_at_depth(context, descriptors, key, depth)? {
            Some(value) => if runtime::descriptor_enumerable(value) {
                let descriptor = context.read_property_at_depth(
                    runtime::Value::Object(descriptors),
                    key_value,
                    depth,
                )?;
                let descriptor = reflect_object(descriptor)?;
                let current = proxy_target_current_descriptor(context, target, key)?;
                let parsed = parsed_descriptor_from_object_at_depth(
                    context,
                    descriptor,
                    current,
                    depth,
                )?;
                pending.push(
                    (
                        key,
                        typed_array_descriptor_at_depth(
                            context,
                            target,
                            key,
                            parsed.descriptor,
                            depth,
                        )?,
                        parsed.trap_value,
                    ),
                )
            },
            None => (),
        }
    }
    for entry in pending {
        if !proxy_define_property_at_depth(
            context,
            target,
            entry.0,
            entry.1,
            Option::Some(entry.2),
            depth,
        )? {
            return Result::Err(reflect_type_error("cannot define object property"))
        }
    }
    Result::Ok(runtime::Value::Object(target))
}

fn object_get_own_property_descriptors_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let source = match object_coercion(context.heap(), argument(arguments, 0)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let result = match allocate_ordinary(context.heap(), Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    for key_value in proxy_own_key_values_at_depth(context, source, depth)? {
        let key = match key_value {
            runtime::Value::String(value) => runtime::js_string_property_key(value),
            runtime::Value::Symbol(value) => runtime::PropertyKey::Symbol(value),
            _ => return Result::Err(reflect_type_error("property key is invalid")),
        };
        match proxy_get_own_property_descriptor_at_depth(context, source, key, depth)? {
            Some(descriptor) => {
                let value = match descriptor_object(context.heap(), descriptor) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_native_error(value)),
                };
                if !runtime::define_own_property(
                    context.heap(),
                    result,
                    key,
                    runtime::data_descriptor(value, true, true, true),
                ) {
                    return Result::Err(reflect_type_error("cannot define descriptor result"))
                }
            },
            None => (),
        }
    }
    Result::Ok(runtime::Value::Object(result))
}

fn object_integrity_descriptor(descriptor: runtime::PropertyDescriptor, frozen: bool) -> runtime::PropertyDescriptor {
    if runtime::descriptor_is_data(descriptor) {
        runtime::data_descriptor(
            runtime::descriptor_value(descriptor).unwrap_or(runtime::Value::Undefined),
            runtime::descriptor_writable(descriptor) && !frozen,
            runtime::descriptor_enumerable(descriptor),
            false,
        )
    } else {
        runtime::accessor_descriptor(
            runtime::descriptor_get(descriptor),
            runtime::descriptor_set(descriptor),
            runtime::descriptor_enumerable(descriptor),
            false,
        )
    }
}

fn object_integrity_trap_descriptor(
    context: vm::Context,
    descriptor: runtime::PropertyDescriptor,
    frozen: bool,
) -> Result[runtime::Value, vm::VmError] {
    let object = match allocate_ordinary(context.heap(), Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    match define_data(
        context.heap(),
        object,
        runtime::string_property_key("configurable"),
        runtime::Value::Bool(false),
        true,
        true,
        true,
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(function_native_error(value)),
    }
    if frozen && runtime::descriptor_is_data(descriptor) {
        match define_data(
            context.heap(),
            object,
            runtime::string_property_key("writable"),
            runtime::Value::Bool(false),
            true,
            true,
            true,
        ) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_native_error(value)),
        }
    }
    Result::Ok(runtime::Value::Object(object))
}

fn object_set_integrity_level_at_depth(
    context: vm::Context,
    target: runtime::Value,
    frozen: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match target {
        runtime::Value::Object(value) => value,
        _ => return Result::Ok(target),
    };
    if !context.prevent_extensions_at_depth(target, depth)? {
        return Result::Err(reflect_type_error("cannot prevent object extensions"))
    }
    if frozen && runtime::is_typed_array_backed_by_variable_length_buffer(context.heap(), object) {
        return Result::Err(reflect_type_error("cannot freeze variable-length TypedArray"))
    }
    for key_value in proxy_own_key_values_at_depth(context, object, depth)? {
        let key = match key_value {
            runtime::Value::String(value) => runtime::js_string_property_key(value),
            runtime::Value::Symbol(value) => runtime::PropertyKey::Symbol(value),
            _ => return Result::Err(reflect_type_error("property key is invalid")),
        };
        match proxy_get_own_property_descriptor_at_depth(context, object, key, depth)? {
            Some(descriptor) => {
                let trap_descriptor = object_integrity_trap_descriptor(context, descriptor, frozen)?;
                if !proxy_define_property_at_depth(
                    context,
                    object,
                    key,
                    object_integrity_descriptor(descriptor, frozen),
                    Option::Some(trap_descriptor),
                    depth,
                )? {
                    return Result::Err(reflect_type_error("cannot set object integrity level"))
                }
            },
            None => (),
        }
    }
    Result::Ok(target)
}

fn object_test_integrity_level_at_depth(
    context: vm::Context,
    target: runtime::Value,
    frozen: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let object = match target {
        runtime::Value::Object(value) => value,
        _ => return Result::Ok(runtime::Value::Bool(true)),
    };
    if context.is_extensible_at_depth(target, depth)? {
        return Result::Ok(runtime::Value::Bool(false))
    }
    for key_value in proxy_own_key_values_at_depth(context, object, depth)? {
        let key = match key_value {
            runtime::Value::String(value) => runtime::js_string_property_key(value),
            runtime::Value::Symbol(value) => runtime::PropertyKey::Symbol(value),
            _ => return Result::Err(reflect_type_error("property key is invalid")),
        };
        match proxy_get_own_property_descriptor_at_depth(context, object, key, depth)? {
            Some(descriptor) => if runtime::descriptor_configurable(descriptor)
                || frozen && runtime::descriptor_is_data(descriptor)
                    && runtime::descriptor_writable(descriptor) {
                return Result::Ok(runtime::Value::Bool(false))
            },
            None => (),
        }
    }
    Result::Ok(runtime::Value::Bool(true))
}

fn object_seal_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_set_integrity_level_at_depth(context, argument(arguments, 0), false, depth)
}

fn object_freeze_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_set_integrity_level_at_depth(context, argument(arguments, 0), true, depth)
}

fn object_is_sealed_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_test_integrity_level_at_depth(context, argument(arguments, 0), false, depth)
}

fn object_is_frozen_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_test_integrity_level_at_depth(context, argument(arguments, 0), true, depth)
}

fn object_create_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let prototype = match argument(arguments, 0) {
        runtime::Value::Null => Option::None,
        runtime::Value::Object(value) => Option::Some(value),
        _ => return Result::Err(reflect_type_error("Object prototype is not an object or null")),
    };
    let object = match prototype {
        Some(value) => match runtime::new_ordinary_object(context.heap(), Option::Some(value)) {
            Ok(value) => value,
            Err(value) => return Result::Err(reflect_type_error(value.message)),
        },
        None => match runtime::new_null_prototype_object(context.heap()) {
            Ok(value) => value,
            Err(value) => return Result::Err(reflect_type_error(value.message)),
        },
    };
    match argument(arguments, 1) {
        runtime::Value::Undefined => Result::Ok(runtime::Value::Object(object)),
        descriptors => object_define_properties_at_depth(
            context,
            runtime::Value::Undefined,
            Vec::from_array([runtime::Value::Object(object), descriptors]),
            depth,
        ),
    }
}

fn object_assign_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = match object_coercion(context.heap(), argument(arguments, 0)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let target_value = runtime::Value::Object(target);
    let mut index = 1;
    while index < arguments.len() {
        match arguments[index] {
            runtime::Value::Undefined | runtime::Value::Null => (),
            source_value => {
                let source = match object_coercion(context.heap(), source_value) {
                    Ok(value) => value,
                    Err(value) => return Result::Err(function_native_error(value)),
                };
                for key_value in proxy_own_key_values_at_depth(context, source, depth)? {
                    let key = match key_value {
                        runtime::Value::String(value) => runtime::js_string_property_key(value),
                        runtime::Value::Symbol(value) => runtime::PropertyKey::Symbol(value),
                        _ => return Result::Err(reflect_type_error("assign source key is invalid")),
                    };
                    match proxy_get_own_property_descriptor_at_depth(context, source, key, depth)? {
                        Some(descriptor) => if runtime::descriptor_enumerable(descriptor) {
                            let value = context.reflect_get_at_depth(
                                runtime::Value::Object(source),
                                key_value,
                                runtime::Value::Object(source),
                                depth,
                            )?;
                            if !context.reflect_set_at_depth(
                                target_value,
                                key_value,
                                value,
                                target_value,
                                depth,
                            )? {
                                return Result::Err(
                                    reflect_type_error("cannot assign object property"),
                                )
                            }
                        },
                        None => (),
                    }
                }
            },
        }
        index += 1;
    }
    Result::Ok(target_value)
}

fn object_enumerable_values_at_depth(
    context: vm::Context,
    value: runtime::Value,
    entries: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let source = match object_coercion(context.heap(), value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let values: Vec[runtime::Value] = Vec::new();
    for key in proxy_own_key_values_at_depth(context, source, depth)? {
        match key {
            runtime::Value::String(name) => match proxy_get_own_property_descriptor_at_depth(
                context,
                source,
                runtime::js_string_property_key(name),
                depth,
            )? {
                Some(descriptor) => if runtime::descriptor_enumerable(descriptor) {
                    let value = context.reflect_get_at_depth(
                        runtime::Value::Object(source),
                        runtime::Value::String(name),
                        runtime::Value::Object(source),
                        depth,
                    )?;
                    if entries {
                        let pair = match allocate_array(
                            context.heap(),
                            Vec::from_array([runtime::Value::String(name), value]),
                            2,
                        ) {
                            Ok(value) => value,
                            Err(value) => return Result::Err(function_native_error(value)),
                        };
                        values.push(runtime::Value::Object(pair))
                    } else {
                        values.push(value)
                    }
                },
                None => (),
            },
            _ => (),
        }
    }
    match allocate_array(context.heap(), values, values.len()) {
        Ok(value) => Result::Ok(runtime::Value::Object(value)),
        Err(value) => Result::Err(function_native_error(value)),
    }
}

fn object_values_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_enumerable_values_at_depth(context, argument(arguments, 0), false, depth)
}

fn object_entries_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    object_enumerable_values_at_depth(context, argument(arguments, 0), true, depth)
}

fn reflect_apply(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = function_callable(argument(arguments, 0))?;
    let values = reflect_arguments(context, argument(arguments, 2), depth)?;
    context.invoke_with_this_at_depth(target, values, argument(arguments, 1), depth)
}

fn reflect_construct(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    if !vm::is_constructor(context, target) {
        return Result::Err(reflect_type_error("Reflect.construct target is not a constructor"))
    }
    let values = reflect_arguments(context, argument(arguments, 1), depth)?;
    let new_target = match argument(arguments, 2) {
        runtime::Value::Undefined => target,
        value => value,
    };
    if !vm::is_constructor(context, new_target) {
        return Result::Err(reflect_type_error("Reflect.construct newTarget is not a constructor"))
    }
    context.construct_with_new_target_at_depth(target, values, new_target, depth)
}

fn reflect_define_property(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = reflect_object(argument(arguments, 0))?;
    let key_value = property_key_value_at_depth(context, argument(arguments, 1), depth)?;
    let key = match property_key_from_value(context.heap(), key_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let descriptor_object = reflect_object(argument(arguments, 2))?;
    let current = proxy_target_current_descriptor(context, target, key)?;
    let descriptor = parsed_descriptor_from_object_at_depth(
        context,
        descriptor_object,
        current,
        depth,
    )?;
    Result::Ok(
        runtime::Value::Bool(
            proxy_define_property_at_depth(
                context,
                target,
                key,
                descriptor.descriptor,
                Option::Some(descriptor.trap_value),
                depth,
            )?,
        ),
    )
}

fn reflect_delete_property(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    Result::Ok(
        runtime::Value::Bool(
            context.delete_property_at_depth(target, argument(arguments, 1), depth)?,
        ),
    )
}

fn reflect_get(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    let receiver = if arguments.len() < 3 {
        target
    } else {
        arguments[2]
    };
    context.reflect_get_at_depth(target, argument(arguments, 1), receiver, depth)
}

fn reflect_get_own_property_descriptor(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = reflect_object(argument(arguments, 0))?;
    let key_value = property_key_value_at_depth(context, argument(arguments, 1), depth)?;
    let key = match property_key_from_value(context.heap(), key_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    match proxy_get_own_property_descriptor_at_depth(context, target, key, depth)? {
        Some(value) => match descriptor_object(context.heap(), value) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_native_error(value)),
        },
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn reflect_get_prototype_of(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    context.get_prototype_of_at_depth(target, depth)
}

fn reflect_has(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    Result::Ok(
        runtime::Value::Bool(context.has_property_at_depth(target, argument(arguments, 1), depth)?),
    )
}

fn reflect_is_extensible(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    Result::Ok(runtime::Value::Bool(context.is_extensible_at_depth(target, depth)?))
}

fn reflect_own_keys(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    context.own_keys_at_depth(target, depth)
}

fn reflect_prevent_extensions(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    Result::Ok(runtime::Value::Bool(context.prevent_extensions_at_depth(target, depth)?))
}

fn reflect_set(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    let receiver = if arguments.len() < 4 {
        target
    } else {
        arguments[3]
    };
    Result::Ok(
        runtime::Value::Bool(
            context.reflect_set_at_depth(
                target,
                argument(arguments, 1),
                argument(arguments, 2),
                receiver,
                depth,
            )?,
        ),
    )
}

fn reflect_set_prototype_of(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    let _ = reflect_object(target)?;
    let prototype = match argument(arguments, 1) {
        runtime::Value::Null => runtime::Value::Null,
        runtime::Value::Object(value) => runtime::Value::Object(value),
        _ => return Result::Err(reflect_type_error("Reflect prototype is not an object or null")),
    };
    Result::Ok(runtime::Value::Bool(context.set_prototype_of_at_depth(target, prototype, depth)?))
}

fn install_reflect(context: vm::Context) -> Result[runtime::ObjectId, BuiltinError] {
    let object = match allocate_ordinary(context.heap(), Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    for (name, callback) in Vec::from_array(
        [
            ("apply", reflect_apply),
            ("construct", reflect_construct),
            ("defineProperty", reflect_define_property),
            ("deleteProperty", reflect_delete_property),
            ("get", reflect_get),
            ("getOwnPropertyDescriptor", reflect_get_own_property_descriptor),
            ("getPrototypeOf", reflect_get_prototype_of),
            ("has", reflect_has),
            ("isExtensible", reflect_is_extensible),
            ("ownKeys", reflect_own_keys),
            ("preventExtensions", reflect_prevent_extensions),
            ("set", reflect_set),
            ("setPrototypeOf", reflect_set_prototype_of),
        ],
    ) {
        define_value(
            context.heap(),
            object,
            name,
            allocate_vm_function(
                context,
                "Reflect." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    Result::Ok(object)
}

fn mark_constructor(context: vm::Context, value: runtime::Value, name: string) -> Result[
    (),
    BuiltinError,
] {
    match context.mark_native_constructor(value) {
        Ok(()) => Result::Ok(()),
        Err(_) => Result::Err(BuiltinError { message: "cannot register constructor " + name }),
    }
}

fn define_function(
    context: vm::Context,
    object: runtime::ObjectId,
    name: string,
    callback: (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
        runtime::Value,
        vm::NativeError,
    ],
) -> Result[(), BuiltinError] {
    let function = allocate_function(context, name, callback)?;
    define_value(context.heap(), object, name, function, true, true)
}

fn define_to_string_tag(context: vm::Context, object: runtime::ObjectId, tag: string) -> Result[
    (),
    BuiltinError,
] {
    match context.well_known_symbol(vm::WellKnownSymbolKind::ToStringTag) {
        Some(symbol) => if runtime::define_own_property(
            context.heap(),
            object,
            runtime::PropertyKey::Symbol(symbol),
            runtime::data_descriptor(runtime::Value::String(js_string(tag)), false, false, true),
        ) {
            Result::Ok(())
        } else {
            Result::Err(BuiltinError { message: "cannot define Symbol.toStringTag" })
        },
        None => Result::Ok(()),
    }
}

fn function_object(value: runtime::Value, name: string) -> Result[runtime::ObjectId, BuiltinError] {
    match value {
        runtime::Value::Object(value) => Result::Ok(value),
        _ => Result::Err(BuiltinError { message: "builtin is not callable: " + name }),
    }
}

fn reparent_callable_properties(
    heap: runtime::Heap,
    holder: runtime::ObjectId,
    prototype: runtime::ObjectId,
) -> () {
    let object = match heap.get(holder) {
        Some(value) => value,
        None => return,
    };
    for key in runtime::own_property_keys(heap, holder) {
        match object.own_property(key) {
            Some(descriptor) => for value in Vec::from_array(
                [
                    runtime::descriptor_value(descriptor),
                    runtime::descriptor_get(descriptor),
                    runtime::descriptor_set(descriptor),
                ],
            ) {
                match value {
                    Some(runtime::Value::Object(value)) => if value.is_callable() {
                        let _ = runtime::set_prototype_of(heap, value, Option::Some(prototype));
                    },
                    _ => (),
                }
            },
            None => (),
        }
    }
}

fn function_restricted_property(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let _ = arguments;
    Result::Err(native_error("TypeError: restricted function property"))
}

fn install_function(context: vm::Context, object_constructor: runtime::Value) -> Result[
    runtime::Value,
    BuiltinError,
] {
    let prototype_value = allocate_vm_function(
        context,
        "Function.prototype",
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Ok(runtime::Value::Undefined)
        },
    )?;
    let prototype = function_object(prototype_value, "Function.prototype")?;
    if !context.heap().set_function_prototype(prototype) {
        return Result::Err(BuiltinError { message: "cannot install Function prototype" })
    }
    let constructor = allocate_vm_function(
        context,
        "Function",
        |this_value, arguments, depth| {
            dynamic_function_constructor_vm(
                context,
                vm::FunctionKind::Ordinary,
                this_value,
                arguments,
                depth,
            )
        },
    )?;
    let constructor_object = function_object(constructor, "Function")?;
    define_value(context.heap(), constructor_object, "prototype", prototype_value, false, false)?;
    let thrower = allocate_function_with_length(context, "", 0, function_restricted_property)?;
    let thrower_object = function_object(thrower, "restricted function property")?;
    if !runtime::define_own_property(
        context.heap(),
        thrower_object,
        runtime::string_property_key("length"),
        runtime::data_descriptor(runtime::Value::Int(0), false, false, false),
    )
        || !runtime::define_own_property(
            context.heap(),
            thrower_object,
            runtime::string_property_key("name"),
            runtime::data_descriptor(runtime::Value::String(js_string("")), false, false, false),
        )
        || !runtime::prevent_extensions(context.heap(), thrower_object) {
        return Result::Err(BuiltinError { message: "cannot freeze restricted function property" })
    }
    for name in Vec::from_array(["caller", "arguments"]) {
        if !runtime::define_own_property(
            context.heap(),
            prototype,
            runtime::string_property_key(name),
            runtime::accessor_descriptor(Option::Some(thrower), Option::Some(thrower), false, true),
        ) {
            return Result::Err(
                BuiltinError { message: "cannot install restricted Function property " + name },
            )
        }
    }
    let call = allocate_vm_function(
        context,
        "Function.prototype.call",
        |this_value, arguments, depth| {
            function_call(context, this_value, arguments, depth)
        },
    )?;
    let apply = allocate_vm_function(
        context,
        "Function.prototype.apply",
        |this_value, arguments, depth| {
            function_apply(context, this_value, arguments, depth)
        },
    )?;
    let bind = allocate_vm_function(
        context,
        "Function.prototype.bind",
        |this_value, arguments, depth| {
            function_bind(context, this_value, arguments, depth)
        },
    )?;
    let to_string = allocate_vm_function(
        context,
        "Function.prototype.toString",
        |this_value, arguments, depth| {
            function_to_string(context, this_value, arguments, depth)
        },
    )?;
    let file_name = allocate_vm_function(
        context,
        "get Function.prototype.fileName",
        |this_value, arguments, depth| {
            function_file_name(context, this_value, arguments, depth)
        },
    )?;
    let line_number = allocate_vm_function(
        context,
        "get Function.prototype.lineNumber",
        |this_value, arguments, depth| {
            function_line_number(context, this_value, arguments, depth)
        },
    )?;
    let column_number = allocate_vm_function(
        context,
        "get Function.prototype.columnNumber",
        |this_value, arguments, depth| {
            function_column_number(context, this_value, arguments, depth)
        },
    )?;
    define_value(context.heap(), prototype, "call", call, true, true)?;
    define_value(context.heap(), prototype, "apply", apply, true, true)?;
    define_value(context.heap(), prototype, "bind", bind, true, true)?;
    define_value(context.heap(), prototype, "toString", to_string, true, true)?;
    for (name, getter) in Vec::from_array(
        [("fileName", file_name), ("lineNumber", line_number), ("columnNumber", column_number)],
    ) {
        if !runtime::define_own_property(
            context.heap(),
            prototype,
            runtime::string_property_key(name),
            runtime::accessor_descriptor(Option::Some(getter), Option::None, false, true),
        ) {
            return Result::Err(
                BuiltinError { message: "cannot install Function source accessor " + name },
            )
        }
    }
    define_value(context.heap(), prototype, "constructor", constructor, true, true)?;
    register_dynamic_function_constructor(context, constructor, vm::FunctionKind::Ordinary)?;
    let object = function_object(object_constructor, "Object")?;
    let _ = runtime::set_prototype_of(context.heap(), object, Option::Some(prototype));
    reparent_callable_properties(context.heap(), object, prototype);
    match context.heap().object_prototype() {
        Some(value) => reparent_callable_properties(context.heap(), value, prototype),
        None => (),
    }
    Result::Ok(constructor)
}

fn install_function_has_instance(context: vm::Context) -> Result[(), BuiltinError] {
    let prototype = match context.heap().function_prototype() {
        Some(value) => value,
        None => return Result::Err(BuiltinError { message: "Function prototype is not installed" }),
    };
    let symbol = match context.well_known_symbol(vm::WellKnownSymbolKind::HasInstance) {
        Some(value) => value,
        None => return Result::Err(BuiltinError { message: "Symbol.hasInstance is not installed" }),
    };
    let method = allocate_vm_function(
        context,
        "Function.prototype[Symbol.hasInstance]",
        |this_value, arguments, depth| {
            function_has_instance(context, this_value, arguments, depth)
        },
    )?;
    if runtime::define_own_property(
        context.heap(),
        prototype,
        runtime::PropertyKey::Symbol(symbol),
        runtime::data_descriptor(method, false, false, false),
    ) {
        Result::Ok(())
    } else {
        Result::Err(BuiltinError { message: "cannot install Function Symbol.hasInstance" })
    }
}

fn install_number(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let function = allocate_vm_function(
        context,
        "Number",
        |this_value, arguments, depth| {
            number_constructor_vm(context, this_value, arguments, depth)
        },
    )?;
    let object = function_object(function, "Number")?;
    define_value(context.heap(), object, "NaN", runtime::Value::Float(nan()), false, false)?;
    define_value(
        context.heap(),
        object,
        "POSITIVE_INFINITY",
        runtime::Value::Float(infinity()),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "NEGATIVE_INFINITY",
        runtime::Value::Float(-infinity()),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "MAX_VALUE",
        runtime::Value::Float(
            num::parse_float64_structured("1.7976931348623157e308").unwrap_or(0.0),
        ),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "MIN_VALUE",
        runtime::Value::Float(num::parse_float64_structured("5e-324").unwrap_or(0.0)),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "MAX_SAFE_INTEGER",
        runtime::Value::Float(9007199254740991.0),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "MIN_SAFE_INTEGER",
        runtime::Value::Float(-9007199254740991.0),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "EPSILON",
        runtime::Value::Float(2.220446049250313e-16),
        false,
        false,
    )?;
    define_function(context, object, "isNaN", number_is_nan)?;
    define_function(context, object, "isFinite", number_is_finite)?;
    define_function(context, object, "isInteger", number_is_integer)?;
    define_function(context, object, "isSafeInteger", number_is_safe_integer)?;
    define_parse_int_function(context, object)?;
    define_string_function(context, object, "parseFloat", global_parse_float, 1, false)?;
    Result::Ok(function)
}

fn install_object(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let function = allocate_function(context, "Object", object_constructor)?;
    let object = function_object(function, "Object")?;
    let prototype = match runtime::new_null_prototype_object(context.heap()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    if !context.heap().set_object_prototype(prototype) {
        return Result::Err(BuiltinError { message: "cannot install Object prototype" })
    }
    if !runtime::set_immutable_prototype(context.heap(), prototype) {
        return Result::Err(BuiltinError { message: "cannot lock Object prototype" })
    }
    let _ = runtime::set_prototype_of(context.heap(), object, Option::Some(prototype));
    match context.set_native_constructor_callback(
        function,
        |heap, receiver, arguments, selected_prototype, new_target| {
            let _ = selected_prototype;
            if runtime::same_value(new_target, function) {
                object_constructor(heap, runtime::Value::Object(receiver), arguments)
            } else {
                Result::Ok(runtime::Value::Object(receiver))
            }
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    define_value(
        context.heap(),
        object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    define_value(context.heap(), prototype, "constructor", function, true, true)?;
    for (name, callback) in Vec::from_array(
        [
            ("hasOwnProperty", object_prototype_has_own_property_at_depth),
            ("propertyIsEnumerable", object_prototype_property_is_enumerable_at_depth),
        ],
    ) {
        define_value(
            context.heap(),
            prototype,
            name,
            allocate_vm_function(
                context,
                "Object.prototype." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    define_value(
        context.heap(),
        prototype,
        "isPrototypeOf",
        allocate_vm_function(
            context,
            "Object.prototype.isPrototypeOf",
            |this_value, arguments, depth| {
                object_prototype_is_prototype_of_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        prototype,
        "toString",
        allocate_vm_function(
            context,
            "Object.prototype.toString",
            |this_value, arguments, depth| {
                object_prototype_to_string_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        prototype,
        "toLocaleString",
        allocate_vm_function(
            context,
            "Object.prototype.toLocaleString",
            |this_value, arguments, depth| {
                object_prototype_to_locale_string_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, getter) in Vec::from_array([("__defineGetter__", true), ("__defineSetter__", false)]) {
        define_value(
            context.heap(),
            prototype,
            name,
            allocate_vm_function(
                context,
                "Object.prototype." + name,
                |this_value, arguments, depth| {
                    object_prototype_define_accessor_at_depth(
                        context,
                        this_value,
                        arguments,
                        getter,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    for (name, getter) in Vec::from_array([("__lookupGetter__", true), ("__lookupSetter__", false)]) {
        define_value(
            context.heap(),
            prototype,
            name,
            allocate_vm_function(
                context,
                "Object.prototype." + name,
                |this_value, arguments, depth| {
                    object_prototype_lookup_accessor_at_depth(
                        context,
                        this_value,
                        arguments,
                        getter,
                        depth,
                    )
                },
            )?,
            true,
            true,
        )?
    }
    define_function(context, prototype, "valueOf", object_prototype_value_of)?;
    let proto_get = allocate_vm_function(
        context,
        "get __proto__",
        |this_value, arguments, depth| {
            object_prototype_proto_get_at_depth(context, this_value, arguments, depth)
        },
    )?;
    let proto_set = allocate_vm_function(
        context,
        "set __proto__",
        |this_value, arguments, depth| {
            object_prototype_proto_set_at_depth(context, this_value, arguments, depth)
        },
    )?;
    if !runtime::define_own_property(
        context.heap(),
        prototype,
        runtime::string_property_key("__proto__"),
        runtime::accessor_descriptor(Option::Some(proto_get), Option::Some(proto_set), false, true),
    ) {
        return Result::Err(BuiltinError { message: "cannot install Object __proto__ accessor" })
    }
    define_value(
        context.heap(),
        object,
        "create",
        allocate_vm_function(
            context,
            "Object.create",
            |this_value, arguments, depth| {
                object_create_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, callback) in Vec::from_array(
        [
            ("getPrototypeOf", object_get_prototype_of_at_depth),
            ("setPrototypeOf", object_set_prototype_of_at_depth),
            ("preventExtensions", object_prevent_extensions_at_depth),
            ("isExtensible", object_is_extensible_at_depth),
        ],
    ) {
        define_value(
            context.heap(),
            object,
            name,
            allocate_vm_function(
                context,
                "Object." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    define_value(
        context.heap(),
        object,
        "hasOwn",
        allocate_vm_function(
            context,
            "Object.hasOwn",
            |this_value, arguments, depth| {
                object_has_own_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "defineProperty",
        allocate_vm_function(
            context,
            "Object.defineProperty",
            |this_value, arguments, depth| {
                object_define_property_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "defineProperties",
        allocate_vm_function(
            context,
            "Object.defineProperties",
            |this_value, arguments, depth| {
                object_define_properties_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "getOwnPropertyDescriptor",
        allocate_vm_function(
            context,
            "Object.getOwnPropertyDescriptor",
            |this_value, arguments, depth| {
                object_get_own_property_descriptor_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "getOwnPropertyDescriptors",
        allocate_vm_function(
            context,
            "Object.getOwnPropertyDescriptors",
            |this_value, arguments, depth| {
                object_get_own_property_descriptors_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, callback) in Vec::from_array(
        [
            ("getOwnPropertyNames", object_get_own_property_names_at_depth),
            ("getOwnPropertySymbols", object_get_own_property_symbols_at_depth),
        ],
    ) {
        define_value(
            context.heap(),
            object,
            name,
            allocate_vm_function(
                context,
                "Object." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    define_function(context, object, "is", object_is)?;
    define_value(
        context.heap(),
        object,
        "keys",
        allocate_vm_function(
            context,
            "Object.keys",
            |this_value, arguments, depth| {
                object_keys_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "values",
        allocate_vm_function(
            context,
            "Object.values",
            |this_value, arguments, depth| {
                object_values_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "entries",
        allocate_vm_function(
            context,
            "Object.entries",
            |this_value, arguments, depth| {
                object_entries_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "fromEntries",
        allocate_vm_function(
            context,
            "Object.fromEntries",
            |this_value, arguments, depth| {
                object_from_entries(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "groupBy",
        allocate_vm_function(
            context,
            "Object.groupBy",
            |this_value, arguments, depth| {
                object_group_by(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "assign",
        allocate_vm_function(
            context,
            "Object.assign",
            |this_value, arguments, depth| {
                object_assign_at_depth(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    for (name, callback) in Vec::from_array(
        [
            ("seal", object_seal_at_depth),
            ("freeze", object_freeze_at_depth),
            ("isSealed", object_is_sealed_at_depth),
            ("isFrozen", object_is_frozen_at_depth),
        ],
    ) {
        define_value(
            context.heap(),
            object,
            name,
            allocate_vm_function(
                context,
                "Object." + name,
                |this_value, arguments, depth| {
                    callback(context, this_value, arguments, depth)
                },
            )?,
            true,
            true,
        )?
    }
    Result::Ok(function)
}

fn install_array(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let function = allocate_vm_function(
        context,
        "Array",
        |this_value, arguments, depth| {
            array_constructor_vm(context, this_value, arguments, depth)
        },
    )?;
    context.set_intrinsic_array_constructor(function);
    match context.set_vm_constructor_callback(
        function,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = receiver;
            let _ = new_target;
            let result = array_constructor_vm(context, runtime::Value::Undefined, arguments, depth)?;
            match (result, selected_prototype) {
                (runtime::Value::Object(object), Some(prototype)) => if runtime::set_prototype_of(
                    context.heap(),
                    object,
                    Option::Some(prototype),
                ) {
                    Result::Ok(result)
                } else {
                    Result::Err(function_vm_error("cannot set Array instance prototype"))
                },
                _ => Result::Ok(result),
            }
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    let object = function_object(function, "Array")?;
    define_function(context, object, "isArray", array_is_array)?;
    define_value(
        context.heap(),
        object,
        "of",
        allocate_vm_function(
            context,
            "Array.of",
            |this_value, arguments, depth| array_of(context, this_value, arguments, depth),
        )?,
        true,
        true,
    )?;
    define_value(
        context.heap(),
        object,
        "from",
        allocate_vm_function(
            context,
            "Array.from",
            |this_value, arguments, depth| {
                array_from(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    Result::Ok(function)
}

fn install_string(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let function = allocate_vm_function(
        context,
        "String",
        |this_value, arguments, depth| {
            string_constructor_vm(context, this_value, arguments, depth)
        },
    )?;
    let object = function_object(function, "String")?;
    define_number_function(context, object, "fromCharCode", string_from_char_code, 0, true)?;
    define_number_function(context, object, "fromCodePoint", string_from_code_point, 0, true)?;
    define_value(
        context.heap(),
        object,
        "raw",
        allocate_vm_function(
            context,
            "String.raw",
            |this_value, arguments, depth| {
                string_raw(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    Result::Ok(function)
}

fn install_math(context: vm::Context, object: runtime::ObjectId) -> Result[(), BuiltinError] {
    define_value(
        context.heap(),
        object,
        "E",
        runtime::Value::Float(2.718281828459045),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "LN2",
        runtime::Value::Float(0.6931471805599453),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "LN10",
        runtime::Value::Float(2.302585092994046),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "LOG2E",
        runtime::Value::Float(1.4426950408889634),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "LOG10E",
        runtime::Value::Float(0.4342944819032518),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "PI",
        runtime::Value::Float(3.141592653589793),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "SQRT1_2",
        runtime::Value::Float(0.7071067811865476),
        false,
        false,
    )?;
    define_value(
        context.heap(),
        object,
        "SQRT2",
        runtime::Value::Float(1.4142135623730951),
        false,
        false,
    )?;
    define_number_function(context, object, "abs", math_abs, 1, false)?;
    define_number_function(context, object, "floor", math_floor, 1, false)?;
    define_number_function(context, object, "ceil", math_ceil, 1, false)?;
    define_number_function(context, object, "trunc", math_trunc, 1, false)?;
    define_number_function(context, object, "round", math_round, 1, false)?;
    define_number_function(context, object, "sign", math_sign, 1, false)?;
    define_number_function(context, object, "exp", math_exp, 1, false)?;
    define_number_function(context, object, "log", math_log, 1, false)?;
    define_number_function(context, object, "log2", math_log2, 1, false)?;
    define_number_function(context, object, "log10", math_log10, 1, false)?;
    define_number_function(context, object, "sin", math_sin, 1, false)?;
    define_number_function(context, object, "cos", math_cos, 1, false)?;
    define_number_function(context, object, "tan", math_tan, 1, false)?;
    define_number_function(context, object, "asin", math_asin, 1, false)?;
    define_number_function(context, object, "acos", math_acos, 1, false)?;
    define_number_function(context, object, "atan", math_atan, 1, false)?;
    define_number_function(context, object, "sqrt", math_sqrt, 1, false)?;
    define_number_function(context, object, "pow", math_pow, 2, false)?;
    define_number_function(context, object, "max", math_max, 0, true)?;
    define_number_function(context, object, "min", math_min, 0, true)?;
    define_number_function(context, object, "clz32", math_clz32, 1, false)?;
    define_number_function(context, object, "imul", math_imul, 2, false)?;
    define_number_function(context, object, "fround", math_fround, 1, false)?;
    define_number_function(context, object, "f16round", math_f16round, 1, false)?;
    define_number_function(context, object, "hypot", math_hypot, 0, true)?;
    define_value(
        context.heap(),
        object,
        "sumPrecise",
        allocate_vm_function(
            context,
            "sumPrecise",
            |this_value, arguments, depth| {
                math_sum_precise(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_number_function(context, object, "cbrt", math_cbrt, 1, false)?;
    define_number_function(context, object, "log1p", math_log1p, 1, false)?;
    define_number_function(context, object, "expm1", math_expm1, 1, false)?;
    define_number_function(context, object, "sinh", math_sinh, 1, false)?;
    define_number_function(context, object, "cosh", math_cosh, 1, false)?;
    define_number_function(context, object, "tanh", math_tanh, 1, false)?;
    define_number_function(context, object, "asinh", math_asinh, 1, false)?;
    define_number_function(context, object, "acosh", math_acosh, 1, false)?;
    define_number_function(context, object, "atanh", math_atanh, 1, false)?;
    define_number_function(context, object, "atan2", math_atan2, 2, false)?;
    let seed_value = time::SystemTime::now().unix_nanoseconds().to_u64() ^ MATH_RANDOM_SEED;
    let random_state: Ref[u64] = Ref::new(
        if seed_value == 0 {
            MATH_RANDOM_SEED
        } else {
            seed_value
        },
    );
    define_value(
        context.heap(),
        object,
        "random",
        allocate_function(
            context,
            "Math.random",
            |heap, this_value, arguments| {
                math_random(random_state, heap, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    Result::Ok(())
}

fn proxy_object_argument(value: runtime::Value, name: string) -> Result[
    runtime::ObjectId,
    vm::VmError,
] {
    match value {
        runtime::Value::Object(value) => Result::Ok(value),
        _ => Result::Err(function_vm_error("Proxy " + name + " must be an object")),
    }
}

fn create_proxy_value(context: vm::Context, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::VmError,
] {
    let target = proxy_object_argument(argument(arguments, 0), "target")?;
    let handler = proxy_object_argument(argument(arguments, 1), "handler")?;
    match runtime::new_proxy(context.heap(), target, handler) {
        Ok(value) => {
            let result = runtime::Value::Object(value);
            if vm::is_constructor(context, runtime::Value::Object(target)) {
                context.mark_proxy_constructor(result)?
            }
            Result::Ok(result)
        },
        Err(value) => Result::Err(function_vm_error(value.message)),
    }
}

fn proxy_revocable(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let _ = depth;
    let proxy = create_proxy_value(context, arguments)?;
    let proxy_object = proxy_object_argument(proxy, "value")?;
    let revoke = match allocate_vm_function_with_length(
        context,
        "",
        0,
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            let _ = runtime::revoke_proxy(context.heap(), proxy_object);
            Result::Ok(runtime::Value::Undefined)
        },
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let result = match runtime::new_ordinary_object(
        context.heap(),
        context.heap().object_prototype(),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    if !runtime::define_own_property(
        context.heap(),
        result,
        runtime::string_property_key("proxy"),
        runtime::data_descriptor(proxy, true, true, true),
    )
        || !runtime::define_own_property(
            context.heap(),
            result,
            runtime::string_property_key("revoke"),
            runtime::data_descriptor(revoke, true, true, true),
        ) {
        Result::Err(function_vm_error("cannot create Proxy.revocable result"))
    } else {
        Result::Ok(runtime::Value::Object(result))
    }
}

fn install_proxy(context: vm::Context) -> Result[runtime::Value, BuiltinError] {
    let constructor = allocate_vm_function_with_length(
        context,
        "Proxy",
        2,
        |this_value, arguments, depth| {
            let _ = this_value;
            let _ = arguments;
            let _ = depth;
            Result::Err(function_vm_error("Proxy constructor requires new"))
        },
    )?;
    match context.set_vm_self_allocating_constructor_callback(
        constructor,
        |arguments, depth| {
            let _ = depth;
            create_proxy_value(context, arguments)
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    let object = function_object(constructor, "Proxy")?;
    define_value(
        context.heap(),
        object,
        "revocable",
        allocate_vm_function_with_length(
            context,
            "revocable",
            2,
            |this_value, arguments, depth| {
                proxy_revocable(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    Result::Ok(constructor)
}

pub fn install(context: vm::Context) -> Result[Realm, BuiltinError] {
    let heap = context.heap();
    let global = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let math_object = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let console_object = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let json_object = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let std_object = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let os_object = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let performance_object = match runtime::new_ordinary_object(heap, Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let object = install_object(context)?;
    let object_prototype = match heap.object_prototype() {
        Some(value) => value,
        None => return Result::Err(BuiltinError { message: "Object prototype is not installed" }),
    };
    for value in Vec::from_array(
        [
            global,
            math_object,
            console_object,
            json_object,
            std_object,
            os_object,
            performance_object,
        ],
    ) {
        if !runtime::set_prototype_of(heap, value, Option::Some(object_prototype)) {
            return Result::Err(BuiltinError { message: "cannot initialize object prototype" })
        }
    }
    let function = install_function(context, object)?;
    let reflect = install_reflect(context)?;
    let proxy = install_proxy(context)?;
    if !runtime::set_prototype_of(heap, reflect, Option::Some(object_prototype)) {
        return Result::Err(BuiltinError { message: "cannot initialize Reflect prototype" })
    }
    install_math(context, math_object)?;
    let number = install_number(context)?;
    let bigint = allocate_vm_function(
        context,
        "BigInt",
        |this_value, arguments, depth| {
            bigint_constructor_vm(context, this_value, arguments, depth)
        },
    )?;
    match context.set_vm_constructor_callback(
        bigint,
        |receiver, arguments, selected_prototype, new_target, depth| {
            let _ = receiver;
            let _ = arguments;
            let _ = selected_prototype;
            let _ = new_target;
            let _ = depth;
            Result::Err(function_vm_error("BigInt is not a constructor"))
        },
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(BuiltinError { message: value.kind.debug() }),
    }
    let bigint_object = function_object(bigint, "BigInt")?;
    define_bigint_width_function(context, bigint_object, "asUintN", bigint_as_uint_n)?;
    define_bigint_width_function(context, bigint_object, "asIntN", bigint_as_int_n)?;
    let symbol = install_symbol(context)?;
    install_function_has_instance(context)?;
    let iterator = install_iterator(context)?;
    install_generator(context, function, iterator)?;
    define_to_string_tag(context, reflect, "Reflect")?;
    define_to_string_tag(context, math_object, "Math")?;
    define_to_string_tag(context, json_object, "JSON")?;
    define_to_string_tag(context, std_object, "std")?;
    define_to_string_tag(context, os_object, "os")?;
    let performance_origin = time::Instant::now();
    define_value(
        heap,
        performance_object,
        "now",
        allocate_function(
            context,
            "performance.now",
            |heap, this_value, arguments| {
                performance_now(performance_origin, heap, this_value, arguments)
            },
        )?,
        true,
        true,
    )?;
    let regexp_install = install_regexp_runtime(context)?;
    let regexp = regexp_install.constructor;
    let date = install_date(context)?;
    let collections = install_collections(context, iterator)?;
    let errors = install_errors(context)?;
    let buffers = install_arraybuffer(context)?;
    let os_state = new_os_state(buffers.buffer_states);
    let timer_state = new_timer_state();
    install_std(context, std_object, buffers.buffer_states, buffers.array_buffer, os_state)?;
    install_os(context, os_object, os_state)?;
    let _ = install_worker(context, os_object, buffers)?;
    let promise_queue = promise::JobQueue::new();
    context.set_microtask_queue(|| promise_queue.run_all(), || !promise_queue.is_empty());
    let promise = install_promise_with_queue(
        context,
        promise_queue,
        Option::Some(function),
        Option::Some(errors.aggregate_error),
    )?;
    define_value(
        heap,
        os_object,
        "sleepAsync",
        allocate_vm_function_with_length(
            context,
            "os.sleepAsync",
            1,
            |this_value, arguments, depth| {
                let _ = this_value;
                global_sleep_async(context, timer_state, promise, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    let array = install_array(context)?;
    let _ = install_array_prototype(context, array)?;
    install_typed_array_iterators(context, buffers)?;
    let boolean = allocate_vm_function(
        context,
        "Boolean",
        |this_value, arguments, depth| {
            let _ = depth;
            match boolean_constructor(context.heap(), this_value, arguments) {
                Ok(value) => Result::Ok(value),
                Err(value) => Result::Err(function_native_error(value)),
            }
        },
    )?;
    let string_function = install_string(context)?;
    let string_prototype = install_string_prototype(context, string_function)?;
    install_primitive_prototypes(
        context,
        number,
        bigint,
        boolean,
        symbol,
        string_function,
        string_prototype,
    )?;
    install_string_iterator(context, string_prototype, iterator)?;
    install_regexp_string_methods(
        context,
        string_prototype,
        regexp,
        regexp_install.prototype,
        regexp_install.states,
        regexp_install.exec,
        regexp_install.flags_getter,
        regexp_install.flag_getters,
        iterator,
    )?;
    let _ = install_bjson(context, buffers, date)?;
    for (value, name) in Vec::from_array(
        [
            (regexp, "RegExp"),
            (collections.map, "Map"),
            (collections.set, "Set"),
            (collections.weak_map, "WeakMap"),
            (collections.weak_set, "WeakSet"),
            (collections.weak_ref, "WeakRef"),
            (collections.finalization_registry, "FinalizationRegistry"),
            (errors.error, "Error"),
            (errors.internal_error, "InternalError"),
            (errors.eval_error, "EvalError"),
            (errors.range_error, "RangeError"),
            (errors.reference_error, "ReferenceError"),
            (errors.syntax_error, "SyntaxError"),
            (errors.type_error, "TypeError"),
            (errors.uri_error, "URIError"),
            (errors.aggregate_error, "AggregateError"),
            (buffers.array_buffer, "ArrayBuffer"),
            (buffers.shared_array_buffer, "SharedArrayBuffer"),
            (buffers.data_view, "DataView"),
            (buffers.uint8_array, "Uint8Array"),
            (buffers.int32_array, "Int32Array"),
            (buffers.float64_array, "Float64Array"),
            (buffers.uint8_clamped_array, "Uint8ClampedArray"),
            (buffers.int8_array, "Int8Array"),
            (buffers.int16_array, "Int16Array"),
            (buffers.uint16_array, "Uint16Array"),
            (buffers.uint32_array, "Uint32Array"),
            (buffers.float16_array, "Float16Array"),
            (buffers.float32_array, "Float32Array"),
            (buffers.bigint64_array, "BigInt64Array"),
            (buffers.biguint64_array, "BigUint64Array"),
            (promise, "Promise"),
            (iterator, "Iterator"),
            (function, "Function"),
            (object, "Object"),
            (array, "Array"),
        ],
    ) {
        mark_constructor(context, value, name)?
    }
    define_function(context, console_object, "log", qjs_print)?;
    define_value(
        heap,
        std_object,
        "gc",
        allocate_vm_function(
            context,
            "std.gc",
            |this_value, arguments, depth| {
                global_collect_garbage(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        os_object,
        "setTimeout",
        allocate_vm_function_with_length(
            context,
            "setTimeout",
            2,
            |this_value, arguments, depth| {
                global_set_timeout(context, timer_state, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        os_object,
        "clearTimeout",
        allocate_vm_function_with_length(
            context,
            "clearTimeout",
            1,
            |this_value, arguments, depth| {
                global_clear_timeout(context, timer_state, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        os_object,
        "platform",
        runtime::Value::String(js_string("linux")),
        true,
        true,
    )?;
    install_json(context, json_object)?;
    define_value(heap, global, "undefined", runtime::Value::Undefined, false, false)?;
    define_value(heap, global, "NaN", runtime::Value::Float(nan()), false, false)?;
    define_value(heap, global, "Infinity", runtime::Value::Float(infinity()), false, false)?;
    define_value(heap, global, "Math", runtime::Value::Object(math_object), true, true)?;
    define_value(heap, global, "Reflect", runtime::Value::Object(reflect), true, true)?;
    define_value(heap, global, "Proxy", proxy, true, true)?;
    define_value(heap, global, "Function", function, true, true)?;
    define_value(heap, global, "Number", number, true, true)?;
    define_value(heap, global, "BigInt", bigint, true, true)?;
    define_value(heap, global, "RegExp", regexp, true, true)?;
    define_value(heap, global, "Date", date, true, true)?;
    define_value(heap, global, "Map", collections.map, true, true)?;
    define_value(heap, global, "Set", collections.set, true, true)?;
    define_value(heap, global, "WeakMap", collections.weak_map, true, true)?;
    define_value(heap, global, "WeakSet", collections.weak_set, true, true)?;
    define_value(heap, global, "WeakRef", collections.weak_ref, true, true)?;
    define_value(
        heap,
        global,
        "FinalizationRegistry",
        collections.finalization_registry,
        true,
        true,
    )?;
    define_value(heap, global, "Error", errors.error, true, true)?;
    define_value(heap, global, "InternalError", errors.internal_error, true, true)?;
    define_value(heap, global, "EvalError", errors.eval_error, true, true)?;
    define_value(heap, global, "RangeError", errors.range_error, true, true)?;
    define_value(heap, global, "ReferenceError", errors.reference_error, true, true)?;
    define_value(heap, global, "SyntaxError", errors.syntax_error, true, true)?;
    define_value(heap, global, "TypeError", errors.type_error, true, true)?;
    define_value(heap, global, "URIError", errors.uri_error, true, true)?;
    define_value(heap, global, "AggregateError", errors.aggregate_error, true, true)?;
    define_value(heap, global, "ArrayBuffer", buffers.array_buffer, true, true)?;
    define_value(heap, global, "SharedArrayBuffer", buffers.shared_array_buffer, true, true)?;
    define_value(heap, global, "Atomics", buffers.atomics, true, true)?;
    define_value(heap, global, "DataView", buffers.data_view, true, true)?;
    define_value(heap, global, "Uint8Array", buffers.uint8_array, true, true)?;
    define_value(heap, global, "Int32Array", buffers.int32_array, true, true)?;
    define_value(heap, global, "Float64Array", buffers.float64_array, true, true)?;
    define_value(heap, global, "Uint8ClampedArray", buffers.uint8_clamped_array, true, true)?;
    define_value(heap, global, "Int8Array", buffers.int8_array, true, true)?;
    define_value(heap, global, "Int16Array", buffers.int16_array, true, true)?;
    define_value(heap, global, "Uint16Array", buffers.uint16_array, true, true)?;
    define_value(heap, global, "Uint32Array", buffers.uint32_array, true, true)?;
    define_value(heap, global, "Float16Array", buffers.float16_array, true, true)?;
    define_value(heap, global, "Float32Array", buffers.float32_array, true, true)?;
    define_value(heap, global, "BigInt64Array", buffers.bigint64_array, true, true)?;
    define_value(heap, global, "BigUint64Array", buffers.biguint64_array, true, true)?;
    define_value(heap, global, "Object", object, true, true)?;
    define_value(heap, global, "Array", array, true, true)?;
    define_value(heap, global, "Boolean", boolean, true, true)?;
    define_value(heap, global, "String", string_function, true, true)?;
    define_value(heap, global, "Symbol", symbol, true, true)?;
    define_value(heap, global, "Promise", promise, true, true)?;
    define_value(heap, global, "Iterator", iterator, true, true)?;
    define_value(heap, global, "console", runtime::Value::Object(console_object), true, true)?;
    define_value(heap, global, "JSON", runtime::Value::Object(json_object), true, true)?;
    define_value(heap, global, "std", runtime::Value::Object(std_object), true, true)?;
    define_value(heap, global, "os", runtime::Value::Object(os_object), true, true)?;
    context.register_virtual_module("std", runtime::Value::Object(std_object));
    context.register_virtual_module("os", runtime::Value::Object(os_object));
    define_value(
        heap,
        global,
        "performance",
        runtime::Value::Object(performance_object),
        true,
        true,
    )?;
    define_value(heap, global, "globalThis", runtime::Value::Object(global), true, true)?;
    define_number_function(context, global, "isNaN", global_is_nan, 1, false)?;
    define_number_function(context, global, "isFinite", global_is_finite, 1, false)?;
    let number_object = function_object(number, "Number")?;
    define_value(
        heap,
        global,
        "parseInt",
        builtin_own_value(heap, number_object, "parseInt")?,
        true,
        true,
    )?;
    define_value(
        heap,
        global,
        "parseFloat",
        builtin_own_value(heap, number_object, "parseFloat")?,
        true,
        true,
    )?;
    define_string_function(context, global, "encodeURI", global_encode_uri, 1, false)?;
    define_string_function(
        context,
        global,
        "encodeURIComponent",
        global_encode_uri_component,
        1,
        false,
    )?;
    define_string_function(context, global, "decodeURI", global_decode_uri, 1, false)?;
    define_string_function(
        context,
        global,
        "decodeURIComponent",
        global_decode_uri_component,
        1,
        false,
    )?;
    define_string_function(context, global, "escape", global_escape, 1, false)?;
    define_string_function(context, global, "unescape", global_unescape, 1, false)?;
    let eval_function = allocate_vm_function_with_length(
        context,
        "eval",
        1,
        |this_value, arguments, depth| {
            global_eval(context, this_value, arguments, depth)
        },
    )?;
    context.set_intrinsic_eval(eval_function);
    define_value(heap, global, "eval", eval_function, true, true)?;
    define_value(
        heap,
        global,
        "__loadScript",
        allocate_vm_function_with_length(
            context,
            "__loadScript",
            1,
            |this_value, arguments, depth| {
                global_load_script(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_function(context, global, "print", qjs_print)?;
    match context.set_global_object(global) {
        Ok(()) => (),
        Err(_) => {
            return Result::Err(BuiltinError { message: "cannot install global object" })
        },
    }
    let realm = Realm {
        global_value: global,
        math_value: math_object,
        json_value: json_object,
        buffer_install_value: buffers,
        promise_queue_value: promise_queue,
    };
    let empty_arguments: Vec[string] = Vec::new();
    set_script_args(context, realm, empty_arguments)?;
    define_to_string_tag(context, global, "global")?;
    Result::Ok(realm)
}
