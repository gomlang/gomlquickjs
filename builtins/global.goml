#[derive(PartialEq, Eq, Debug)]
pub struct BuiltinError {
    pub message: string,
}

type NativeBuiltin = (runtime::Heap, runtime::Value, Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
];

struct TimerState {
    next_id: Ref[isize],
    active: collections::HashSet[isize],
}

fn new_timer_state() -> TimerState {
    TimerState { next_id: Ref::new(1), active: collections::HashSet::new() }
}

const MATH_RANDOM_MULTIPLIER: u64 = 2685821657736338717;

const MATH_RANDOM_SEED: u64 = 11400714819323198485;

pub struct Realm {
    global_value: runtime::ObjectId,
    math_value: runtime::ObjectId,
    json_value: runtime::ObjectId,
    buffer_install_value: ArrayBufferInstall,
    promise_queue_value: promise::JobQueue,
}

impl Realm {
    pub fn global_object(self: Realm) -> runtime::ObjectId {
        self.global_value
    }

    pub fn math_object(self: Realm) -> runtime::ObjectId {
        self.math_value
    }

    pub fn json_object(self: Realm) -> runtime::ObjectId {
        self.json_value
    }

    pub fn arraybuffer_install(self: Realm) -> ArrayBufferInstall {
        self.buffer_install_value
    }

    pub fn promise_queue(self: Realm) -> promise::JobQueue {
        self.promise_queue_value
    }
}

pub fn set_script_args(context: vm::Context, realm: Realm, arguments: Vec[string]) -> Result[
    (),
    BuiltinError,
] {
    let values: Vec[runtime::Value] = Vec::with_capacity(arguments.len());
    for value in arguments {
        values.push(runtime::Value::String(js_string(value)))
    }
    let array = match allocate_array(context.heap(), values, values.len()) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_value(
        context.heap(),
        realm.global_value,
        "scriptArgs",
        runtime::Value::Object(array),
        true,
        true,
    )
}

fn native_error(message: string) -> vm::NativeError {
    vm::NativeError { message }
}

fn function_vm_error(message: string) -> vm::VmError {
    vm::VmError { offset: -1, kind: vm::VmErrorKind::TypeError(message) }
}

fn function_range_error(message: string) -> vm::VmError {
    vm::VmError { offset: -1, kind: vm::VmErrorKind::RangeError(message) }
}

fn function_syntax_error(message: string) -> vm::VmError {
    vm::VmError { offset: -1, kind: vm::VmErrorKind::SyntaxError(message) }
}

fn function_native_error(value: vm::NativeError) -> vm::VmError {
    let message = value.message;
    if text::starts_with_at(message, 0, "RangeError: ") {
        function_range_error(message.byte_slice(12, message.byte_len()))
    } else if text::starts_with_at(message, 0, "SyntaxError: ") {
        function_syntax_error(message.byte_slice(13, message.byte_len()))
    } else if text::starts_with_at(message, 0, "URIError: ") {
        vm::VmError {
            offset: -1,
            kind: vm::VmErrorKind::UriError(message.byte_slice(10, message.byte_len())),
        }
    } else if text::starts_with_at(message, 0, "TypeError: ") {
        function_vm_error(message.byte_slice(11, message.byte_len()))
    } else {
        function_vm_error(message)
    }
}

fn infinity() -> f64 {
    num::parse_float64_structured("Infinity").unwrap_or(0.0)
}

fn nan() -> f64 {
    num::parse_float64_structured("NaN").unwrap_or(0.0)
}

fn js_string(value: string) -> runtime::JsString {
    let bytes = value.to_bytes();
    runtime::JsString::from_utf8(bytes.slice(0, bytes.len()))
}

fn argument(arguments: Vec[runtime::Value], index: isize) -> runtime::Value {
    if index < 0 || index >= arguments.len() {
        runtime::Value::Undefined
    } else {
        arguments[index]
    }
}

fn number_argument(arguments: Vec[runtime::Value], index: isize) -> Result[f64, vm::NativeError] {
    match runtime::primitive_to_number(argument(arguments, index)) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(native_error(value.message)),
    }
}

fn number_primitive(value: runtime::Value) -> Result[runtime::Value, vm::VmError] {
    match value {
        runtime::Value::BigInt(value) => {
            Result::Ok(runtime::Value::Float(dtoa::parse_number(value.to_string())))
        },
        _ => match runtime::primitive_to_number(value) {
            Ok(value) => Result::Ok(runtime::Value::Float(value)),
            Err(value) => Result::Err(function_vm_error(value.message)),
        },
    }
}

fn number_constructor_vm(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    if arguments.is_empty() {
        Result::Ok(runtime::Value::Int(0))
    } else {
        number_primitive(context.to_primitive_number_at_depth(arguments[0], depth)?)
    }
}

fn boolean_constructor(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    Result::Ok(runtime::Value::Bool(runtime::to_boolean(argument(arguments, 0))))
}

fn bigint_constructor_vm(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let value = context.to_primitive_number_at_depth(argument(arguments, 0), depth)?;
    match value {
        runtime::Value::BigInt(value) => Result::Ok(runtime::Value::BigInt(value)),
        runtime::Value::Int(value) => Result::Ok(
            runtime::Value::BigInt(runtime::BigInt::from_int64(value.to_i64())),
        ),
        runtime::Value::Float(value) => match runtime::integral_number_to_bigint(value) {
            Ok(value) => Result::Ok(runtime::Value::BigInt(value)),
            Err(value) => Result::Err(function_range_error(value.message)),
        },
        runtime::Value::String(value) => match runtime::string_to_bigint(value) {
            Ok(value) => Result::Ok(runtime::Value::BigInt(value)),
            Err(value) => Result::Err(function_syntax_error(value.message)),
        },
        runtime::Value::Bool(value) => Result::Ok(
            runtime::Value::BigInt(
                runtime::BigInt::from_int64(
                    if value {
                        1
                    } else {
                        0
                    },
                ),
            ),
        ),
        runtime::Value::Undefined | runtime::Value::Null | runtime::Value::Symbol(_) => {
            Result::Err(function_vm_error("cannot convert value to BigInt"))
        },
        runtime::Value::Object(_) => {
            Result::Err(function_vm_error("cannot convert object to BigInt"))
        },
    }
}

fn bigint_width(arguments: Vec[runtime::Value]) -> Result[isize, vm::NativeError] {
    let value = number_argument(arguments, 0)?;
    let integer = if math::is_nan(value) || value == 0.0 {
        0.0
    } else if !math::is_finite(value) {
        return Result::Err(native_error("RangeError: invalid BigInt width"))
    } else {
        math::trunc(value)
    };
    if integer < 0.0 || integer > 100000000.0 {
        Result::Err(native_error("RangeError: invalid BigInt width"))
    } else {
        Result::Ok(num::parse_int_structured(dtoa::number_to_string(integer)).unwrap_or(-1))
    }
}

fn bigint_value(value: runtime::Value) -> Result[runtime::BigInt, vm::NativeError] {
    match value {
        runtime::Value::BigInt(value) => Result::Ok(value),
        _ => Result::Err(native_error("value is not a BigInt")),
    }
}

fn bigint_as_uint_n(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let width = bigint_width(arguments)?;
    let value = bigint_value(argument(arguments, 1))?;
    if width == 0 {
        return Result::Ok(runtime::Value::BigInt(runtime::BigInt::from_int64(0)))
    }
    let modulus = match runtime::BigInt::from_int64(1).shift_left(width) {
        Ok(value) => value,
        Err(_) => {
            return Result::Err(
                native_error("RangeError: BigInt width exceeds implementation limit"),
            )
        },
    };
    let mut result = match value.remainder(modulus) {
        Ok(value) => value,
        Err(_) => return Result::Err(native_error("cannot truncate BigInt")),
    };
    if result.negative() {
        result = result.add(modulus);
    }
    Result::Ok(runtime::Value::BigInt(result))
}

fn bigint_as_int_n(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let unsigned = match bigint_as_uint_n(heap, this_value, arguments) {
        Ok(runtime::Value::BigInt(value)) => value,
        Ok(_) => return Result::Err(native_error("cannot truncate BigInt")),
        Err(value) => return Result::Err(value),
    };
    let width = bigint_width(arguments)?;
    if width == 0 {
        Result::Ok(runtime::Value::BigInt(unsigned))
    } else {
        let threshold = match runtime::BigInt::from_int64(1).shift_left(width - 1) {
            Ok(value) => value,
            Err(_) => {
                return Result::Err(
                    native_error("RangeError: BigInt width exceeds implementation limit"),
                )
            },
        };
        if unsigned.compare(threshold) >= 0 {
            let modulus = match threshold.shift_left(1) {
                Ok(value) => value,
                Err(_) => {
                    return Result::Err(
                        native_error("RangeError: BigInt width exceeds implementation limit"),
                    )
                },
            };
            Result::Ok(runtime::Value::BigInt(unsigned.subtract(modulus)))
        } else {
            Result::Ok(runtime::Value::BigInt(unsigned))
        }
    }
}

fn string_constructor(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    if arguments.is_empty() {
        Result::Ok(runtime::Value::String(js_string("")))
    } else {
        match arguments[0] {
            runtime::Value::Undefined => {
                Result::Ok(runtime::Value::String(js_string("undefined")))
            },
            runtime::Value::Null => Result::Ok(runtime::Value::String(js_string("null"))),
            runtime::Value::Bool(value) => {
                Result::Ok(runtime::Value::String(js_string(value.to_string())))
            },
            runtime::Value::Int(value) => {
                Result::Ok(runtime::Value::String(js_string(value.to_string())))
            },
            runtime::Value::Float(value) => {
                Result::Ok(runtime::Value::String(js_string(dtoa::number_to_string(value))))
            },
            runtime::Value::String(value) => Result::Ok(runtime::Value::String(value)),
            runtime::Value::BigInt(value) => {
                Result::Ok(runtime::Value::String(js_string(value.to_string())))
            },
            runtime::Value::Symbol(value) => match value.description() {
                Some(description) => Result::Ok(
                    runtime::Value::String(
                        js_string("Symbol(").concat(description).concat(js_string(")")),
                    ),
                ),
                None => Result::Ok(runtime::Value::String(js_string("Symbol()"))),
            },
            runtime::Value::Object(object) => match runtime::primitive_value(heap, object) {
                Some(runtime::Value::Symbol(_)) => {
                    Result::Err(native_error("cannot convert symbol to string"))
                },
                Some(value) => string_constructor(
                    heap,
                    runtime::Value::Undefined,
                    Vec::from_array([value]),
                ),
                None => {
                    Result::Err(
                        native_error("ordinary object string conversion is not implemented"),
                    )
                },
            },
        }
    }
}

fn string_constructor_vm(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    if arguments.is_empty() {
        return Result::Ok(runtime::Value::String(js_string("")))
    }
    let input = arguments[0];
    match input {
        runtime::Value::Symbol(_) => match string_constructor(
            context.heap(),
            runtime::Value::Undefined,
            Vec::from_array([input]),
        ) {
            Ok(value) => return Result::Ok(value),
            Err(value) => return Result::Err(function_vm_error(value.message)),
        },
        _ => (),
    }
    let primitive = context.to_primitive_string_at_depth(input, depth)?;
    match primitive {
        runtime::Value::Symbol(_) => {
            Result::Err(function_vm_error("cannot convert symbol to string"))
        },
        _ => match string_constructor(
            context.heap(),
            runtime::Value::Undefined,
            Vec::from_array([primitive]),
        ) {
            Ok(value) => Result::Ok(value),
            Err(value) => Result::Err(function_vm_error(value.message)),
        },
    }
}

fn string_from_char_code(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let units: Vec[u16] = Vec::with_capacity(arguments.len());
    let mut index = 0;
    while index < arguments.len() {
        units.push((to_u32(number_argument(arguments, index)?) & 0xffff).to_u16());
        index += 1;
    }
    Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(units)))
}

fn string_from_code_point(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let units: Vec[u16] = Vec::new();
    let mut index = 0;
    while index < arguments.len() {
        let value = number_argument(arguments, index)?;
        if !math::is_finite(value) || value < 0.0 || value > 1114111.0
            || math::trunc(value) != value {
            return Result::Err(native_error("RangeError: invalid Unicode code point"))
        }
        let point = num::parse_int_structured(dtoa::number_to_string(value)).unwrap_or(-1);
        if point < 0 {
            return Result::Err(native_error("RangeError: invalid Unicode code point"))
        } else if point <= 0xffff {
            units.push(point.to_u16())
        } else {
            let scalar = point - 0x10000;
            units.push((0xd800 + scalar / 1024).to_u16());
            units.push((0xdc00 + scalar % 1024).to_u16())
        }
        index += 1;
    }
    Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(units)))
}

fn string_raw_append(output: Vec[u16], value: runtime::JsString) -> () {
    let mut index = 0;
    while index < value.len() {
        output.push(value.get(index));
        index += 1;
    }
}

fn string_raw_length(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let number = match number_value_at_depth(context, value, depth)? {
        runtime::Value::Float(value) => value,
        _ => 0.0,
    };
    if math::is_nan(number) || number <= 0.0 {
        Result::Ok(0)
    } else if number >= 9007199254740991.0 || !math::is_finite(number) {
        Result::Ok(9007199254740991)
    } else {
        Result::Ok(
            num::parse_int_structured(dtoa::number_to_string(math::floor(number))).unwrap_or(0),
        )
    }
}

fn string_raw(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let template = argument(arguments, 0);
    match template {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Err(function_vm_error("String.raw requires a template object"))
        },
        _ => (),
    }
    let raw = context.read_property_at_depth(
        template,
        runtime::Value::String(js_string("raw")),
        depth,
    )?;
    match raw {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Err(function_vm_error("String.raw template.raw is not an object"))
        },
        _ => (),
    }
    let length = string_raw_length(
        context,
        context.read_property_at_depth(raw, runtime::Value::String(js_string("length")), depth)?,
        depth,
    )?;
    if length == 0 {
        return Result::Ok(runtime::Value::String(js_string("")))
    }
    let output: Vec[u16] = Vec::new();
    let mut index = 0;
    while index < length {
        let segment = string_value_at_depth(
            context,
            context.read_property_at_depth(
                raw,
                runtime::Value::String(js_string(index.to_string())),
                depth,
            )?,
            depth,
        )?;
        match segment {
            runtime::Value::String(value) => string_raw_append(output, value),
            _ => (),
        }
        if index + 1 < length {
            if index + 1 < arguments.len() {
                let substitution = string_value_at_depth(
                    context,
                    argument(arguments, index + 1),
                    depth,
                )?;
                match substitution {
                    runtime::Value::String(value) => string_raw_append(output, value),
                    _ => (),
                }
            }
        }
        index += 1;
    }
    Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(output)))
}

fn display_string(heap: runtime::Heap, value: runtime::Value) -> Result[string, vm::NativeError] {
    match value {
        runtime::Value::BigInt(value) => return Result::Ok(value.to_string() + "n"),
        _ => (),
    }
    let converted = match string_constructor(
        heap,
        runtime::Value::Undefined,
        Vec::from_array([value]),
    )? {
        runtime::Value::String(value) => value,
        _ => return Result::Err(native_error("string conversion did not produce a string")),
    };
    match converted.to_host_string() {
        Ok(value) => Result::Ok(value),
        Err(_) => Result::Err(native_error("string contains an unpaired surrogate")),
    }
}

fn value_string(heap: runtime::Heap, value: runtime::Value) -> Result[
    runtime::JsString,
    vm::NativeError,
] {
    match string_constructor(heap, runtime::Value::Undefined, Vec::from_array([value]))? {
        runtime::Value::String(value) => Result::Ok(value),
        _ => Result::Err(native_error("string conversion did not produce a string")),
    }
}

fn uri_value(value: Result[runtime::JsString, uri::UriError]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    match value {
        Ok(value) => Result::Ok(runtime::Value::String(value)),
        Err(value) => Result::Err(native_error("URIError: " + value.to_string())),
    }
}

fn global_encode_uri(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    uri_value(uri::encode_uri(value_string(heap, argument(arguments, 0))?))
}

fn global_encode_uri_component(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    uri_value(uri::encode_uri_component(value_string(heap, argument(arguments, 0))?))
}

fn global_decode_uri(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    uri_value(uri::decode_uri(value_string(heap, argument(arguments, 0))?))
}

fn global_decode_uri_component(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    uri_value(uri::decode_uri_component(value_string(heap, argument(arguments, 0))?))
}

fn legacy_escape_safe(value: u16) -> bool {
    value >= 48 && value <= 57 || value >= 65 && value <= 90 || value >= 97 && value <= 122
        || value == 64
        || value == 42
        || value == 95
        || value == 43
        || value == 45
        || value == 46
        || value == 47
}

fn legacy_hex_digit(value: isize) -> u16 {
    if value < 10 {
        (48 + value).to_u16()
    } else {
        (55 + value).to_u16()
    }
}

fn legacy_hex_value(value: u16) -> Option[isize] {
    if value >= 48 && value <= 57 {
        Option::Some((value - 48).to_isize())
    } else if value >= 65 && value <= 70 {
        Option::Some((value - 55).to_isize())
    } else if value >= 97 && value <= 102 {
        Option::Some((value - 87).to_isize())
    } else {
        Option::None
    }
}

fn global_escape(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = this_value;
    let input = value_string(heap, argument(arguments, 0))?;
    let output: Vec[u16] = Vec::with_capacity(input.len());
    let mut index = 0;
    while index < input.len() {
        let value = input.get(index);
        if legacy_escape_safe(value) {
            output.push(value)
        } else if value < 256 {
            output.push(37);
            output.push(legacy_hex_digit((value >> 4).to_isize()));
            output.push(legacy_hex_digit((value & 15).to_isize()));
        } else {
            output.push(37);
            output.push(117);
            output.push(legacy_hex_digit(((value >> 12) & 15).to_isize()));
            output.push(legacy_hex_digit(((value >> 8) & 15).to_isize()));
            output.push(legacy_hex_digit(((value >> 4) & 15).to_isize()));
            output.push(legacy_hex_digit((value & 15).to_isize()));
        }
        index += 1;
    }
    Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(output)))
}

fn legacy_unescape_value(input: runtime::JsString, start: isize, count: isize) -> Option[u16] {
    if start + count > input.len() {
        return Option::None
    }
    let mut value = 0;
    let mut index = 0;
    while index < count {
        match legacy_hex_value(input.get(start + index)) {
            Some(digit) => {
                value = value * 16 + digit;
            },
            None => return Option::None,
        }
        index += 1;
    }
    Option::Some(value.to_u16())
}

fn global_unescape(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = this_value;
    let input = value_string(heap, argument(arguments, 0))?;
    let output: Vec[u16] = Vec::with_capacity(input.len());
    let mut index = 0;
    while index < input.len() {
        if input.get(index) == 37 && index + 1 < input.len() && input.get(index + 1) == 117 {
            match legacy_unescape_value(input, index + 2, 4) {
                Some(value) => {
                    output.push(value);
                    index += 6;
                },
                None => {
                    output.push(input.get(index));
                    index += 1;
                },
            }
        } else if input.get(index) == 37 {
            match legacy_unescape_value(input, index + 1, 2) {
                Some(value) => {
                    output.push(value);
                    index += 3;
                },
                None => {
                    output.push(input.get(index));
                    index += 1;
                },
            }
        } else {
            output.push(input.get(index));
            index += 1;
        }
    }
    Result::Ok(runtime::Value::String(runtime::JsString::from_code_units(output)))
}

fn numeric_whitespace(value: u16) -> bool {
    value == 0x0009 || value == 0x000a || value == 0x000b || value == 0x000c || value == 0x000d
        || value == 0x0020
        || value == 0x00a0
        || value == 0x1680
        || (value >= 0x2000 && value <= 0x200a)
        || value == 0x2028
        || value == 0x2029
        || value == 0x202f
        || value == 0x205f
        || value == 0x3000
        || value == 0xfeff
}

fn skip_numeric_whitespace(value: runtime::JsString) -> isize {
    let mut index = 0;
    while index < value.len() && numeric_whitespace(value.get(index)) {
        index += 1;
    }
    index
}

fn ascii_digit(value: u16) -> Option[isize] {
    if value >= 48 && value <= 57 {
        Option::Some((value - 48).to_isize())
    } else if value >= 65 && value <= 90 {
        Option::Some((value - 65).to_isize() + 10)
    } else if value >= 97 && value <= 122 {
        Option::Some((value - 97).to_isize() + 10)
    } else {
        Option::None
    }
}

fn int_float(value: isize) -> f64 {
    num::parse_float64_structured(value.to_string()).unwrap_or(0.0)
}

fn to_u32(value: f64) -> u32 {
    if !math::is_finite(value) || value == 0.0 {
        0
    } else {
        let integer = math::trunc(value);
        let mut remaining = integer - math::floor(integer / 4294967296.0) * 4294967296.0;
        let mut place = 2147483648.0;
        let mut mask: u32 = 0x80000000;
        let mut result: u32 = 0;
        while mask != 0 {
            if remaining >= place {
                result = result | mask;
                remaining -= place;
            }
            place /= 2.0;
            mask >>= 1;
        }
        result
    }
}

fn radix_argument(arguments: Vec[runtime::Value]) -> Result[isize, vm::NativeError] {
    if arguments.len() < 2
        || match arguments[1] {
            runtime::Value::Undefined => true,
            _ => false,
        } {
        Result::Ok(0)
    } else {
        Result::Ok(to_u32(number_argument(arguments, 1)?).to_i32().to_isize())
    }
}

fn global_parse_int(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = this_value;
    let value = value_string(heap, argument(arguments, 0))?;
    let mut index = skip_numeric_whitespace(value);
    let mut negative = false;
    if index < value.len() && (value.get(index) == 43 || value.get(index) == 45) {
        negative = value.get(index) == 45;
        index += 1;
    }
    let mut radix = radix_argument(arguments)?;
    let strip_prefix = radix == 0 || radix == 16;
    if radix == 0 {
        radix = 10;
    }
    if radix < 2 || radix > 36 {
        return Result::Ok(runtime::Value::Float(nan()))
    }
    if strip_prefix && index + 1 < value.len() && value.get(index) == 48
        && (value.get(index + 1) == 88 || value.get(index + 1) == 120) {
        radix = 16;
        index += 2;
    }
    let start = index;
    let mut result = 0.0;
    while index < value.len() {
        let digit = match ascii_digit(value.get(index)) {
            Some(value) => value,
            None => break,
        };
        if digit >= radix {
            break
        }
        result = result * int_float(radix) + int_float(digit);
        index += 1;
    }
    if index == start {
        Result::Ok(runtime::Value::Float(nan()))
    } else if negative {
        Result::Ok(runtime::Value::Float(-result))
    } else {
        Result::Ok(runtime::Value::Float(result))
    }
}

fn decimal_digit(value: u16) -> bool {
    value >= 48 && value <= 57
}

fn append_ascii_range(output: Vec[byte], value: runtime::JsString, start: isize, end: isize) -> () {
    let mut index = start;
    while index < end {
        output.push(value.get(index).to_u8());
        index += 1;
    }
}

fn global_parse_float(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    let value = value_string(heap, argument(arguments, 0))?;
    let start = skip_numeric_whitespace(value);
    let mut index = start;
    if index < value.len() && (value.get(index) == 43 || value.get(index) == 45) {
        index += 1;
    }
    let sign_end = index;
    let infinity_units = js_string("Infinity");
    if index + infinity_units.len() <= value.len()
        && value.slice(index, index + infinity_units.len()) == infinity_units {
        let result = if start < sign_end && value.get(start) == 45 {
            -infinity()
        } else {
            infinity()
        };
        return Result::Ok(runtime::Value::Float(result))
    }
    let mut digit_count = 0;
    while index < value.len() && decimal_digit(value.get(index)) {
        digit_count += 1;
        index += 1;
    }
    if index < value.len() && value.get(index) == 46 {
        index += 1;
        while index < value.len() && decimal_digit(value.get(index)) {
            digit_count += 1;
            index += 1;
        }
    }
    if digit_count == 0 {
        return Result::Ok(runtime::Value::Float(nan()))
    }
    if index < value.len() && (value.get(index) == 69 || value.get(index) == 101) {
        let exponent_start = index;
        index += 1;
        if index < value.len() && (value.get(index) == 43 || value.get(index) == 45) {
            index += 1;
        }
        let exponent_digits = index;
        while index < value.len() && decimal_digit(value.get(index)) {
            index += 1;
        }
        if index == exponent_digits {
            index = exponent_start;
        }
    }
    let bytes: Vec[byte] = Vec::with_capacity(index - start);
    append_ascii_range(bytes, value, start, index);
    let (_, text) = string_from_utf8(bytes);
    Result::Ok(runtime::Value::Float(dtoa::parse_number(text)))
}

fn qjs_print(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = this_value;
    let mut output = "";
    let mut index = 0;
    while index < arguments.len() {
        if index > 0 {
            output += " ";
        }
        output += display_string(heap, arguments[index])?;
        index += 1;
    }
    io::println(output);
    Result::Ok(runtime::Value::Undefined)
}

fn global_collect_garbage(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let _ = arguments;
    let _ = context.collect_garbage();
    let _ = depth;
    Result::Ok(runtime::Value::Undefined)
}

fn global_set_timeout(
    context: vm::Context,
    state: TimerState,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let _ = depth;
    let callback = argument(arguments, 0);
    match callback {
        runtime::Value::Object(object) => if !object.is_callable()
            || !context.heap().contains(object) {
            return Result::Err(function_vm_error("timer callback is not callable"))
        },
        _ => return Result::Err(function_vm_error("timer callback is not callable")),
    }
    let timer_id = state.next_id.get();
    state.next_id.set(timer_id + 1);
    let _ = state.active.insert(timer_id);
    let queued_arguments: Vec[runtime::Value] = Vec::from_array([callback]);
    let mut index = 2;
    while index < arguments.len() {
        queued_arguments.push(arguments[index]);
        index += 1;
    }
    let wrapper = match allocate_vm_function_with_length(
        context,
        "",
        0,
        |this_value, arguments, depth| {
            let _ = this_value;
            if !state.active.contains(timer_id) {
                Result::Ok(runtime::Value::Undefined)
            } else {
                let _ = state.active.remove(timer_id);
                let callback = argument(arguments, 0);
                let callback_arguments: Vec[runtime::Value] = Vec::new();
                let mut index = 1;
                while index < arguments.len() {
                    callback_arguments.push(arguments[index]);
                    index += 1;
                }
                context.invoke_with_this_at_depth(
                    callback,
                    callback_arguments,
                    runtime::Value::Undefined,
                    depth,
                )
            }
        },
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    context.enqueue_host_job(wrapper, queued_arguments)?;
    Result::Ok(runtime::Value::Int(timer_id.to_i32()))
}

fn global_clear_timeout(
    context: vm::Context,
    state: TimerState,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let timer_id = std_file_index(context, argument(arguments, 0), depth)?;
    let _ = state.active.remove(timer_id);
    Result::Ok(runtime::Value::Undefined)
}

fn global_sleep_async(
    context: vm::Context,
    timer_state: TimerState,
    promise: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let delay = argument(arguments, 0);
    let executor = match allocate_vm_function_with_length(
        context,
        "",
        2,
        |this_value, arguments, depth| {
            let _ = this_value;
            let resolve = argument(arguments, 0);
            let _ = global_set_timeout(
                context,
                timer_state,
                runtime::Value::Undefined,
                Vec::from_array([resolve, delay]),
                depth,
            )?;
            Result::Ok(runtime::Value::Undefined)
        },
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    context.construct_with_new_target_at_depth(promise, Vec::from_array([executor]), promise, depth)
}

fn global_eval(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let _ = depth;
    let source = argument(arguments, 0);
    let text = match source {
        runtime::Value::String(value) => value,
        _ => return Result::Ok(source),
    };
    let bindings: Vec[bytecode::EvalBinding] = Vec::new();
    let function = context.compile_dynamic_eval_source(text, bindings)?;
    context.execute_eval(function)
}

fn global_eval_script(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let source = string_value_at_depth(context, argument(arguments, 0), depth)?;
    let text = match source {
        runtime::Value::String(value) => value.to_host_string_lossy(),
        _ => return Result::Err(function_vm_error("evalScript source is not a string")),
    };
    let function = context.compile_dynamic_script_source(text, "<evalScript>")?;
    context.execute_script(function)
}

fn global_load_script(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let _ = depth;
    let path = match value_string(context.heap(), argument(arguments, 0)) {
        Ok(value) => match value.to_host_string() {
            Ok(value) => value,
            Err(value) => return Result::Err(function_vm_error(value.debug())),
        },
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let source = match fs::read_file_structured(path) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.to_string())),
    };
    let function = context.compile_dynamic_script_source(source, path)?;
    context.execute_script(function)
}

fn generator_next(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    context.resume_generator_at_depth(this_value, argument(arguments, 0), depth)
}

fn generator_throw(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    context.throw_generator_at_depth(this_value, argument(arguments, 0), depth)
}

fn generator_return(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    context.return_generator_at_depth(this_value, argument(arguments, 0), depth)
}

fn install_generator(
    context: vm::Context,
    function_constructor: runtime::Value,
    iterator_constructor: runtime::Value,
) -> Result[(), BuiltinError] {
    let heap = context.heap();
    let iterator_constructor_object = function_object(iterator_constructor, "Iterator")?;
    let iterator_prototype = match builtin_own_value(heap, iterator_constructor_object, "prototype")? {
        runtime::Value::Object(value) => value,
        _ => return Result::Err(BuiltinError { message: "Iterator prototype is invalid" }),
    };
    let prototype = match runtime::new_ordinary_object(heap, Option::Some(iterator_prototype)) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    define_value(
        heap,
        prototype,
        "next",
        allocate_vm_function_with_length(
            context,
            "next",
            1,
            |this_value, arguments, depth| {
                generator_next(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "throw",
        allocate_vm_function_with_length(
            context,
            "throw",
            1,
            |this_value, arguments, depth| {
                generator_throw(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "return",
        allocate_vm_function_with_length(
            context,
            "return",
            1,
            |this_value, arguments, depth| {
                generator_return(context, this_value, arguments, depth)
            },
        )?,
        true,
        true,
    )?;
    define_to_string_tag(context, prototype, "Generator")?;
    let function_prototype = match heap.function_prototype() {
        Some(value) => value,
        None => return Result::Err(BuiltinError { message: "Function prototype is not installed" }),
    };
    let function_kind_prototype = match runtime::new_ordinary_object(
        heap,
        Option::Some(function_prototype),
    ) {
        Ok(value) => value,
        Err(value) => return Result::Err(BuiltinError { message: value.message }),
    };
    let _ = install_dynamic_function_constructor(
        context,
        function_constructor,
        "GeneratorFunction",
        vm::FunctionKind::Generator,
        function_kind_prototype,
    )?;
    define_value(
        heap,
        function_kind_prototype,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        true,
    )?;
    define_value(
        heap,
        prototype,
        "constructor",
        runtime::Value::Object(function_kind_prototype),
        false,
        true,
    )?;
    define_to_string_tag(context, function_kind_prototype, "GeneratorFunction")?;
    match context.set_generator_prototype(prototype) {
        Ok(()) => Result::Ok(()),
        Err(error) => Result::Err(BuiltinError { message: error.kind.debug() }),
    }
}

fn number_is_nan(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let result = match argument(arguments, 0) {
        runtime::Value::Float(value) => math::is_nan(value),
        _ => false,
    };
    Result::Ok(runtime::Value::Bool(result))
}

fn number_is_finite(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let result = match argument(arguments, 0) {
        runtime::Value::Int(_) => true,
        runtime::Value::Float(value) => math::is_finite(value),
        _ => false,
    };
    Result::Ok(runtime::Value::Bool(result))
}

fn numeric_integer(value: runtime::Value) -> Option[f64] {
    match value {
        runtime::Value::Int(value) => match runtime::primitive_to_number(runtime::Value::Int(value)) {
            Ok(value) => Option::Some(value),
            Err(_) => Option::None,
        },
        runtime::Value::Float(value) => if math::is_finite(value) && math::trunc(value) == value {
            Option::Some(value)
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn number_is_integer(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    Result::Ok(runtime::Value::Bool(numeric_integer(argument(arguments, 0)).is_some()))
}

fn number_is_safe_integer(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = heap;
    let _ = this_value;
    let result = match numeric_integer(argument(arguments, 0)) {
        Some(value) => value >= -9007199254740991.0 && value <= 9007199254740991.0,
        None => false,
    };
    Result::Ok(runtime::Value::Bool(result))
}

fn allocate_ordinary(heap: runtime::Heap, prototype: Option[runtime::ObjectId]) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    match runtime::new_ordinary_object(heap, prototype) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(native_error(value.message)),
    }
}

fn define_data(
    heap: runtime::Heap,
    object: runtime::ObjectId,
    key: runtime::PropertyKey,
    value: runtime::Value,
    writable: bool,
    enumerable: bool,
    configurable: bool,
) -> Result[(), vm::NativeError] {
    if writable && enumerable && configurable
        && runtime::try_define_new_default_data_property(heap, object, key, value) {
        return Result::Ok(())
    }
    if runtime::define_own_property(
        heap,
        object,
        key,
        runtime::data_descriptor(value, writable, enumerable, configurable),
    ) {
        Result::Ok(())
    } else {
        Result::Err(native_error("cannot define object property"))
    }
}

fn array_length_value(length: isize) -> runtime::Value {
    if length <= 2147483647 {
        runtime::Value::Int(length.to_i32())
    } else {
        runtime::Value::Float(int_float(length))
    }
}

fn allocate_array(heap: runtime::Heap, values: Vec[runtime::Value], length: isize) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    match runtime::new_array_with_values(heap, values, length) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(native_error(value.message)),
    }
}

fn object_constructor(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = this_value;
    match argument(arguments, 0) {
        runtime::Value::Undefined | runtime::Value::Null => {
            Result::Ok(runtime::Value::Object(allocate_ordinary(heap, Option::None)?))
        },
        runtime::Value::Object(value) => Result::Ok(runtime::Value::Object(value)),
        value => box_primitive(heap, value),
    }
}

fn array_constructor_vm(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let _ = depth;
    if arguments.len() == 1 {
        match arguments[0] {
            runtime::Value::Int(value) => if value >= 0 {
                match allocate_array(context.heap(), Vec::new(), value.to_isize()) {
                    Ok(value) => Result::Ok(runtime::Value::Object(value)),
                    Err(value) => Result::Err(function_native_error(value)),
                }
            } else {
                Result::Err(function_range_error("invalid array length"))
            },
            runtime::Value::Float(value) => if math::is_finite(value) && value >= 0.0
                && value <= 4294967295.0
                && math::trunc(value) == value {
                let length = num::parse_int_structured(dtoa::number_to_string(value)).unwrap_or(-1);
                if length >= 0 {
                    match allocate_array(context.heap(), Vec::new(), length) {
                        Ok(value) => Result::Ok(runtime::Value::Object(value)),
                        Err(value) => Result::Err(function_native_error(value)),
                    }
                } else {
                    Result::Err(function_range_error("invalid array length"))
                }
            } else {
                Result::Err(function_range_error("invalid array length"))
            },
            _ => match allocate_array(context.heap(), arguments, 1) {
                Ok(value) => Result::Ok(runtime::Value::Object(value)),
                Err(value) => Result::Err(function_native_error(value)),
            },
        }
    } else {
        match allocate_array(context.heap(), arguments, arguments.len()) {
            Ok(value) => Result::Ok(runtime::Value::Object(value)),
            Err(value) => Result::Err(function_native_error(value)),
        }
    }
}

fn object_coercion(heap: runtime::Heap, value: runtime::Value) -> Result[
    runtime::ObjectId,
    vm::NativeError,
] {
    match value {
        runtime::Value::Undefined | runtime::Value::Null => {
            Result::Err(native_error("cannot convert null or undefined to object"))
        },
        runtime::Value::Object(value) => Result::Ok(value),
        value => match box_primitive(heap, value)? {
            runtime::Value::Object(value) => Result::Ok(value),
            _ => Result::Err(native_error("primitive boxing did not produce an object")),
        },
    }
}

fn function_callable(value: runtime::Value) -> Result[runtime::Value, vm::VmError] {
    match value {
        runtime::Value::Object(object) => if object.is_callable() {
            Result::Ok(value)
        } else {
            Result::Err(function_vm_error("Function method called on a non-callable value"))
        },
        _ => Result::Err(function_vm_error("Function method called on a non-callable value")),
    }
}

fn function_call(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let callable = function_callable(this_value)?;
    let receiver = argument(arguments, 0);
    let call_arguments: Vec[runtime::Value] = Vec::new();
    let mut index = 1;
    while index < arguments.len() {
        call_arguments.push(arguments[index]);
        index += 1;
    }
    context.invoke_with_this_at_depth(callable, call_arguments, receiver, depth)
}

fn function_to_string(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let _ = depth;
    let callable = function_callable(this_value)?;
    match vm::function_source(context, callable) {
        Some(source) => Result::Ok(runtime::Value::String(source)),
        None => Result::Ok(
            runtime::Value::String(
                js_string("function ").concat(
                    vm::native_function_name(context, callable).unwrap_or(js_string("")),
                ).concat(js_string("() {\n    [native code]\n}")),
            ),
        ),
    }
}

fn function_file_name(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let _ = depth;
    match vm::function_source_name(context, this_value) {
        Some(value) => Result::Ok(runtime::Value::String(value)),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn function_line_number(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let _ = depth;
    match vm::function_definition_location(context, this_value) {
        Some(value) => Result::Ok(runtime::Value::Int(value.line.to_i32())),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn function_column_number(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let _ = depth;
    match vm::function_definition_location(context, this_value) {
        Some(value) => Result::Ok(runtime::Value::Int(value.column.to_i32())),
        None => Result::Ok(runtime::Value::Undefined),
    }
}

fn function_has_instance(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    Result::Ok(
        runtime::Value::Bool(
            context.ordinary_has_instance_at_depth(this_value, argument(arguments, 0), depth)?,
        ),
    )
}

fn function_apply_length(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    isize,
    vm::VmError,
] {
    let number = match number_value_at_depth(context, value, depth)? {
        runtime::Value::Float(value) => value,
        _ => return Result::Err(function_vm_error("array-like length is not a number")),
    };
    if math::is_nan(number) || number <= 0.0 {
        Result::Ok(0)
    } else if !math::is_finite(number) || number > 65535.0 {
        Result::Err(
            vm::VmError {
                offset: -1,
                kind: vm::VmErrorKind::RangeError("too many arguments for Function.apply"),
            },
        )
    } else {
        Result::Ok(
            num::parse_int_structured(dtoa::number_to_string(math::floor(number))).unwrap_or(0),
        )
    }
}

fn function_apply_arguments(context: vm::Context, value: runtime::Value, depth: isize) -> Result[
    Vec[runtime::Value],
    vm::VmError,
] {
    match value {
        runtime::Value::Undefined | runtime::Value::Null => Result::Ok(Vec::new()),
        runtime::Value::Object(_) => {
            let length = function_apply_length(
                context,
                context.read_property_at_depth(
                    value,
                    runtime::Value::String(js_string("length")),
                    depth,
                )?,
                depth,
            )?;
            let values: Vec[runtime::Value] = Vec::with_capacity(length);
            let mut index = 0;
            while index < length {
                values.push(
                    context.read_property_at_depth(
                        value,
                        runtime::Value::String(js_string(index.to_string())),
                        depth,
                    )?,
                );
                index += 1;
            }
            Result::Ok(values)
        },
        _ => Result::Err(function_vm_error("Function.apply requires an array-like object")),
    }
}

fn function_apply(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let callable = function_callable(this_value)?;
    let receiver = argument(arguments, 0);
    let call_arguments = function_apply_arguments(context, argument(arguments, 1), depth)?;
    context.invoke_with_this_at_depth(callable, call_arguments, receiver, depth)
}

fn function_bind(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let callable = function_callable(this_value)?;
    let receiver = argument(arguments, 0);
    let bound_arguments: Vec[runtime::Value] = Vec::new();
    let mut index = 1;
    while index < arguments.len() {
        bound_arguments.push(arguments[index]);
        index += 1;
    }
    let target_has_length = match callable {
        runtime::Value::Object(object) => match context.heap().get(object) {
            Some(value) => value.is_proxy()
                || value.own_property(runtime::string_property_key("length")).is_some(),
            None => false,
        },
        _ => false,
    };
    let target_length = if target_has_length {
        match context.read_property_at_depth(
            callable,
            runtime::Value::String(js_string("length")),
            depth,
        )? {
            runtime::Value::Int(value) => int_float(value.to_isize()),
            runtime::Value::Float(value) => value,
            _ => 0.0,
        }
    } else {
        0.0
    };
    let length = if target_length > 0.0 && !math::is_finite(target_length) {
        runtime::Value::Float(target_length)
    } else if target_length > int_float(bound_arguments.len()) {
        runtime::Value::Float(math::floor(target_length) - int_float(bound_arguments.len()))
    } else {
        runtime::Value::Int(0)
    };
    let target_name = match context.read_property_at_depth(
        callable,
        runtime::Value::String(js_string("name")),
        depth,
    )? {
        runtime::Value::String(value) => value,
        _ => js_string(""),
    };
    let bound_prototype = match context.get_prototype_of_at_depth(callable, depth)? {
        runtime::Value::Object(value) => Option::Some(value),
        runtime::Value::Null => Option::None,
        _ => return Result::Err(function_vm_error("function prototype is invalid")),
    };
    let bound = context.new_bound_function(callable, receiver, bound_arguments)?;
    match bound {
        runtime::Value::Object(object) => if runtime::set_prototype_of(
            context.heap(),
            object,
            bound_prototype,
        )
            && runtime::define_own_property(
                context.heap(),
                object,
                runtime::string_property_key("length"),
                runtime::data_descriptor(length, false, false, true),
            )
            && runtime::define_own_property(
                context.heap(),
                object,
                runtime::string_property_key("name"),
                runtime::data_descriptor(
                    runtime::Value::String(js_string("bound ").concat(target_name)),
                    false,
                    false,
                    true,
                ),
            ) {
            Result::Ok(bound)
        } else {
            Result::Err(function_vm_error("cannot initialize bound function metadata"))
        },
        _ => Result::Err(function_vm_error("cannot allocate bound function")),
    }
}

fn dynamic_function_source_text(value: runtime::Value) -> Result[string, vm::VmError] {
    match value {
        runtime::Value::String(value) => Result::Ok(value.to_host_string_lossy()),
        _ => Result::Err(function_vm_error("dynamic function source is not a string")),
    }
}

fn dynamic_function_string_arguments(
    context: vm::Context,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let converted: Vec[runtime::Value] = Vec::with_capacity(arguments.len());
    let mut index = 0;
    while index < arguments.len() {
        converted.push(string_value_at_depth(context, arguments[index], depth)?);
        index += 1;
    }
    Result::Ok(converted)
}

fn dynamic_function_sources(arguments: Vec[runtime::Value]) -> Result[(string, string), vm::VmError] {
    let sources: Vec[string] = Vec::with_capacity(arguments.len());
    for argument in arguments {
        sources.push(dynamic_function_source_text(argument)?)
    }
    let mut parameter_source = "";
    let mut body_source = "";
    let mut index = 0;
    if !sources.is_empty() {
        body_source = sources[sources.len() - 1];
        while index + 1 < sources.len() {
            if index > 0 {
                parameter_source += ",";
            }
            parameter_source += sources[index];
            index += 1;
        }
    }
    Result::Ok((parameter_source, body_source))
}

fn dynamic_function_prepare(
    context: vm::Context,
    kind: vm::FunctionKind,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[Vec[runtime::Value], vm::VmError] {
    let converted = dynamic_function_string_arguments(context, arguments, depth)?;
    let sources = dynamic_function_sources(converted)?;
    let _ = context.compile_dynamic_function_source(kind, sources.0, sources.1)?;
    Result::Ok(converted)
}

fn dynamic_function_create(
    context: vm::Context,
    kind: vm::FunctionKind,
    arguments: Vec[runtime::Value],
    requested_prototype: Option[runtime::ObjectId],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let converted = dynamic_function_string_arguments(context, arguments, depth)?;
    let sources = dynamic_function_sources(converted)?;
    let wrapper = context.compile_dynamic_function_source(kind, sources.0, sources.1)?;
    let function = context.execute(wrapper)?;
    match function {
        runtime::Value::Object(object) => {
            match requested_prototype {
                Some(prototype) => if !runtime::set_prototype_of(
                    context.heap(),
                    object,
                    Option::Some(prototype),
                ) {
                    return Result::Err(
                        function_vm_error("cannot initialize dynamic function prototype"),
                    )
                },
                None => (),
            }
            if runtime::define_own_property(
                context.heap(),
                object,
                runtime::string_property_key("name"),
                runtime::data_descriptor(
                    runtime::Value::String(js_string("anonymous")),
                    false,
                    false,
                    true,
                ),
            ) {
                Result::Ok(function)
            } else {
                Result::Err(function_vm_error("cannot initialize dynamic function name"))
            }
        },
        _ => Result::Err(function_vm_error("dynamic compilation did not produce a function")),
    }
}

fn dynamic_function_constructor_vm(
    context: vm::Context,
    kind: vm::FunctionKind,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    dynamic_function_create(context, kind, arguments, Option::None, depth)
}

fn register_dynamic_function_constructor(
    context: vm::Context,
    constructor: runtime::Value,
    kind: vm::FunctionKind,
) -> Result[(), BuiltinError] {
    match context.set_vm_constructor_callback(
        constructor,
        |object, arguments, selected_prototype, new_target, depth| {
            let _ = object;
            let _ = new_target;
            dynamic_function_create(context, kind, arguments, selected_prototype, depth)
        },
    ) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    match context.set_vm_constructor_prepare_callback(
        constructor,
        |arguments, depth| dynamic_function_prepare(context, kind, arguments, depth),
    ) {
        Ok(()) => Result::Ok(()),
        Err(error) => Result::Err(BuiltinError { message: error.kind.debug() }),
    }
}

fn install_dynamic_function_constructor(
    context: vm::Context,
    function_constructor: runtime::Value,
    name: string,
    kind: vm::FunctionKind,
    prototype: runtime::ObjectId,
) -> Result[runtime::Value, BuiltinError] {
    let constructor = allocate_vm_function_with_length(
        context,
        name,
        1,
        |this_value, arguments, depth| {
            dynamic_function_constructor_vm(context, kind, this_value, arguments, depth)
        },
    )?;
    let constructor_object = function_object(constructor, name)?;
    let function_constructor_object = function_object(function_constructor, "Function")?;
    if !runtime::set_prototype_of(
        context.heap(),
        constructor_object,
        Option::Some(function_constructor_object),
    ) {
        return Result::Err(
            BuiltinError { message: "cannot initialize " + name + " constructor prototype" },
        )
    }
    define_value(
        context.heap(),
        constructor_object,
        "prototype",
        runtime::Value::Object(prototype),
        false,
        false,
    )?;
    define_value(context.heap(), prototype, "constructor", constructor, false, true)?;
    match context.set_function_kind_prototype(kind, prototype) {
        Ok(()) => (),
        Err(error) => return Result::Err(BuiltinError { message: error.kind.debug() }),
    }
    register_dynamic_function_constructor(context, constructor, kind)?;
    Result::Ok(constructor)
}

fn object_prototype_is_prototype_of_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match argument(arguments, 0) {
        runtime::Value::Object(_) => (),
        _ => return Result::Ok(runtime::Value::Bool(false)),
    }
    let prototype = match object_coercion(context.heap(), this_value) {
        Ok(value) => runtime::Value::Object(value),
        Err(value) => return Result::Err(function_native_error(value)),
    };
    Result::Ok(
        runtime::Value::Bool(
            context.is_prototype_of_at_depth(prototype, argument(arguments, 0), depth)?,
        ),
    )
}

fn object_prototype_to_string(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = arguments;
    let name = match this_value {
        runtime::Value::Undefined => "Undefined",
        runtime::Value::Null => "Null",
        runtime::Value::Bool(_) => "Boolean",
        runtime::Value::Int(_) | runtime::Value::Float(_) => "Number",
        runtime::Value::String(_) => "String",
        runtime::Value::BigInt(_) | runtime::Value::Symbol(_) => "Object",
        runtime::Value::Object(value) => match heap.get(value) {
            Some(object) => match object.primitive_value() {
                Some(runtime::Value::Bool(_)) => "Boolean",
                Some(runtime::Value::Int(_)) | Some(runtime::Value::Float(_)) => "Number",
                Some(runtime::Value::String(_)) => "String",
                Some(runtime::Value::BigInt(_)) | Some(runtime::Value::Symbol(_)) => "Object",
                Some(runtime::Value::Undefined) | Some(runtime::Value::Null) | Some(runtime::Value::Object(_)) | None => match object.kind() {
                    runtime::ObjectKind::Array => "Array",
                    runtime::ObjectKind::Function => "Function",
                    runtime::ObjectKind::Ordinary => "Object",
                },
            },
            None => return Result::Err(native_error("object does not belong to this heap")),
        },
    };
    Result::Ok(runtime::Value::String(js_string("[object " + name + "]")))
}

fn object_prototype_to_string_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let base = match object_prototype_to_string(context.heap(), this_value, arguments) {
        Ok(runtime::Value::String(value)) => value,
        Ok(value) => return Result::Ok(value),
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let base = match this_value {
        runtime::Value::Object(object) => match context.object_builtin_tag(object) {
            Some(tag) => js_string("[object ").concat(tag).concat(js_string("]")),
            None => base,
        },
        _ => base,
    };
    match this_value {
        runtime::Value::Undefined | runtime::Value::Null => Result::Ok(runtime::Value::String(base)),
        _ => match context.well_known_symbol(vm::WellKnownSymbolKind::ToStringTag) {
            Some(symbol) => match context.read_property_at_depth(
                this_value,
                runtime::Value::Symbol(symbol),
                depth,
            )? {
                runtime::Value::String(tag) => Result::Ok(
                    runtime::Value::String(js_string("[object ").concat(tag).concat(js_string("]"))),
                ),
                _ => Result::Ok(runtime::Value::String(base)),
            },
            None => Result::Ok(runtime::Value::String(base)),
        },
    }
}

fn object_prototype_value_of(
    heap: runtime::Heap,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
) -> Result[runtime::Value, vm::NativeError] {
    let _ = arguments;
    let object = object_coercion(heap, this_value)?;
    if heap.contains(object) {
        Result::Ok(runtime::Value::Object(object))
    } else {
        Result::Err(native_error("object does not belong to this heap"))
    }
}

fn object_prototype_to_locale_string_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let method = context.read_property_at_depth(
        this_value,
        runtime::Value::String(js_string("toString")),
        depth,
    )?;
    let call_arguments: Vec[runtime::Value] = Vec::new();
    context.invoke_with_this_at_depth(method, call_arguments, this_value, depth)
}

fn object_prototype_define_accessor_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    getter: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let callable = argument(arguments, 1);
    match callable {
        runtime::Value::Object(value) => if !value.is_callable() {
            return Result::Err(function_vm_error("accessor must be callable"))
        },
        _ => return Result::Err(function_vm_error("accessor must be callable")),
    }
    let object = match object_coercion(context.heap(), this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let key = property_key_value_at_depth(context, argument(arguments, 0), depth)?;
    let descriptor = match allocate_ordinary(context.heap(), Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let field = if getter {
        "get"
    } else {
        "set"
    };
    match define_data(
        context.heap(),
        descriptor,
        runtime::string_property_key(field),
        callable,
        true,
        true,
        true,
    ) {
        Ok(()) => (),
        Err(value) => return Result::Err(function_native_error(value)),
    }
    for name in Vec::from_array(["enumerable", "configurable"]) {
        match define_data(
            context.heap(),
            descriptor,
            runtime::string_property_key(name),
            runtime::Value::Bool(true),
            true,
            true,
            true,
        ) {
            Ok(()) => (),
            Err(value) => return Result::Err(function_native_error(value)),
        }
    }
    let _ = object_define_property_at_depth(
        context,
        runtime::Value::Undefined,
        Vec::from_array([runtime::Value::Object(object), key, runtime::Value::Object(descriptor)]),
        depth,
    )?;
    Result::Ok(runtime::Value::Undefined)
}

fn object_prototype_lookup_accessor_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    getter: bool,
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let mut object = match object_coercion(context.heap(), this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let key_value = property_key_value_at_depth(context, argument(arguments, 0), depth)?;
    let key = match property_key_from_value(context.heap(), key_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    let mut traversed = 0;
    while traversed < 1024 {
        match proxy_get_own_property_descriptor_at_depth(context, object, key, depth)? {
            Some(runtime::PropertyDescriptor::Accessor { get, set, .. }) => return match if getter {
                get
            } else {
                set
            } {
                Some(value) => Result::Ok(value),
                None => Result::Ok(runtime::Value::Undefined),
            },
            Some(runtime::PropertyDescriptor::Data { .. }) => {
                return Result::Ok(runtime::Value::Undefined)
            },
            None => (),
        }
        match context.get_prototype_of_at_depth(runtime::Value::Object(object), depth)? {
            runtime::Value::Object(value) => {
                object = value;
            },
            runtime::Value::Null => return Result::Ok(runtime::Value::Undefined),
            _ => return Result::Err(function_vm_error("object prototype is invalid")),
        }
        traversed += 1;
    }
    Result::Err(function_vm_error("object prototype chain exceeds implementation limit"))
}

fn object_prototype_proto_get_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = arguments;
    let object = match object_coercion(context.heap(), this_value) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    context.get_prototype_of_at_depth(runtime::Value::Object(object), depth)
}

fn object_prototype_proto_set_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    match this_value {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Err(function_vm_error("cannot set prototype of null or undefined"))
        },
        _ => (),
    }
    let prototype = match argument(arguments, 0) {
        runtime::Value::Null => runtime::Value::Null,
        runtime::Value::Object(value) => runtime::Value::Object(value),
        _ => return Result::Ok(runtime::Value::Undefined),
    };
    match this_value {
        runtime::Value::Object(_) => if context.set_prototype_of_at_depth(
            this_value,
            prototype,
            depth,
        )? {
            Result::Ok(runtime::Value::Undefined)
        } else {
            Result::Err(function_vm_error("cannot set object prototype"))
        },
        _ => Result::Ok(runtime::Value::Undefined),
    }
}

fn object_get_prototype_of_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let object = match object_coercion(context.heap(), argument(arguments, 0)) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_native_error(value)),
    };
    context.get_prototype_of_at_depth(runtime::Value::Object(object), depth)
}

fn object_set_prototype_of_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    match target {
        runtime::Value::Undefined | runtime::Value::Null => {
            return Result::Err(reflect_type_error("cannot set prototype of null or undefined"))
        },
        _ => (),
    }
    let prototype = match argument(arguments, 1) {
        runtime::Value::Null => runtime::Value::Null,
        runtime::Value::Object(value) => runtime::Value::Object(value),
        _ => return Result::Err(
            reflect_type_error("Object prototype may only be an object or null"),
        ),
    };
    match target {
        runtime::Value::Object(_) => if context.set_prototype_of_at_depth(target, prototype, depth)? {
            Result::Ok(target)
        } else {
            Result::Err(reflect_type_error("cannot set object prototype"))
        },
        _ => Result::Ok(target),
    }
}

fn object_prevent_extensions_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = argument(arguments, 0);
    match target {
        runtime::Value::Object(_) => if context.prevent_extensions_at_depth(target, depth)? {
            Result::Ok(target)
        } else {
            Result::Err(reflect_type_error("cannot prevent extensions"))
        },
        _ => Result::Ok(target),
    }
}

fn object_is_extensible_at_depth(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    match argument(arguments, 0) {
        runtime::Value::Object(value) => Result::Ok(
            runtime::Value::Bool(
                context.is_extensible_at_depth(runtime::Value::Object(value), depth)?,
            ),
        ),
        _ => Result::Ok(runtime::Value::Bool(false)),
    }
}

fn descriptor_object(heap: runtime::Heap, descriptor: runtime::PropertyDescriptor) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let object = allocate_ordinary(heap, Option::None)?;
    match runtime::descriptor_value(descriptor) {
        Some(value) => {
            define_data(
                heap,
                object,
                runtime::string_property_key("value"),
                value,
                true,
                true,
                true,
            )?;
            define_data(
                heap,
                object,
                runtime::string_property_key("writable"),
                runtime::Value::Bool(runtime::descriptor_writable(descriptor)),
                true,
                true,
                true,
            )?;
        },
        None => {
            define_data(
                heap,
                object,
                runtime::string_property_key("get"),
                match runtime::descriptor_get(descriptor) {
                    Some(value) => value,
                    None => runtime::Value::Undefined,
                },
                true,
                true,
                true,
            )?;
            define_data(
                heap,
                object,
                runtime::string_property_key("set"),
                match runtime::descriptor_set(descriptor) {
                    Some(value) => value,
                    None => runtime::Value::Undefined,
                },
                true,
                true,
                true,
            )?;
        },
    }
    define_data(
        heap,
        object,
        runtime::string_property_key("enumerable"),
        runtime::Value::Bool(runtime::descriptor_enumerable(descriptor)),
        true,
        true,
        true,
    )?;
    define_data(
        heap,
        object,
        runtime::string_property_key("configurable"),
        runtime::Value::Bool(runtime::descriptor_configurable(descriptor)),
        true,
        true,
        true,
    )?;
    Result::Ok(runtime::Value::Object(object))
}

fn property_key_from_value(heap: runtime::Heap, value: runtime::Value) -> Result[
    runtime::PropertyKey,
    vm::NativeError,
] {
    match value {
        runtime::Value::String(value) => Result::Ok(runtime::js_string_property_key(value)),
        runtime::Value::Symbol(value) => Result::Ok(runtime::PropertyKey::Symbol(value)),
        value => Result::Ok(runtime::js_string_property_key(value_string(heap, value)?)),
    }
}

fn object_property(heap: runtime::Heap, object: runtime::ObjectId, key: runtime::PropertyKey) -> Result[
    Option[runtime::Value],
    vm::NativeError,
] {
    match runtime::get_property(heap, object, key) {
        Ok(value) => Result::Ok(value),
        Err(value) => Result::Err(native_error(value.message)),
    }
}

fn descriptor_field(heap: runtime::Heap, object: runtime::ObjectId, name: string) -> Result[
    Option[runtime::Value],
    vm::NativeError,
] {
    object_property(heap, object, runtime::string_property_key(name))
}

fn descriptor_accessor(value: Option[runtime::Value], previous: Option[runtime::Value]) -> Result[
    Option[runtime::Value],
    vm::NativeError,
] {
    match value {
        None => Result::Ok(previous),
        Some(runtime::Value::Undefined) => Result::Ok(Option::None),
        Some(runtime::Value::Object(value)) => if value.is_callable() {
            Result::Ok(Option::Some(runtime::Value::Object(value)))
        } else {
            Result::Err(native_error("property accessor must be callable or undefined"))
        },
        Some(_) => Result::Err(native_error("property accessor must be callable or undefined")),
    }
}

fn descriptor_from_object(
    heap: runtime::Heap,
    object: runtime::ObjectId,
    current: Option[runtime::PropertyDescriptor],
) -> Result[runtime::PropertyDescriptor, vm::NativeError] {
    let enumerable = descriptor_field(heap, object, "enumerable")?;
    let configurable = descriptor_field(heap, object, "configurable")?;
    let value = descriptor_field(heap, object, "value")?;
    let writable = descriptor_field(heap, object, "writable")?;
    let get = descriptor_field(heap, object, "get")?;
    let set = descriptor_field(heap, object, "set")?;
    let data_requested = value.is_some() || writable.is_some();
    let accessor_requested = get.is_some() || set.is_some();
    if data_requested && accessor_requested {
        return Result::Err(native_error("property descriptor cannot mix data and accessors"))
    }
    let current_enumerable = match current {
        Some(value) => runtime::descriptor_enumerable(value),
        None => false,
    };
    let current_configurable = match current {
        Some(value) => runtime::descriptor_configurable(value),
        None => false,
    };
    let next_enumerable = match enumerable {
        Some(value) => runtime::to_boolean(value),
        None => current_enumerable,
    };
    let next_configurable = match configurable {
        Some(value) => runtime::to_boolean(value),
        None => current_configurable,
    };
    let use_accessor = if accessor_requested {
        true
    } else if data_requested {
        false
    } else {
        match current {
            Some(value) => !runtime::descriptor_is_data(value),
            None => false,
        }
    };
    if use_accessor {
        let previous_get = match current {
            Some(value) => if runtime::descriptor_is_data(value) {
                Option::None
            } else {
                runtime::descriptor_get(value)
            },
            None => Option::None,
        };
        let previous_set = match current {
            Some(value) => if runtime::descriptor_is_data(value) {
                Option::None
            } else {
                runtime::descriptor_set(value)
            },
            None => Option::None,
        };
        Result::Ok(
            runtime::accessor_descriptor(
                descriptor_accessor(get, previous_get)?,
                descriptor_accessor(set, previous_set)?,
                next_enumerable,
                next_configurable,
            ),
        )
    } else {
        let previous_value = match current {
            Some(descriptor) => match runtime::descriptor_value(descriptor) {
                Some(value) => value,
                None => runtime::Value::Undefined,
            },
            None => runtime::Value::Undefined,
        };
        let previous_writable = match current {
            Some(descriptor) => runtime::descriptor_writable(descriptor),
            None => false,
        };
        Result::Ok(
            runtime::data_descriptor(
                match value {
                    Some(value) => value,
                    None => previous_value,
                },
                match writable {
                    Some(value) => runtime::to_boolean(value),
                    None => previous_writable,
                },
                next_enumerable,
                next_configurable,
            ),
        )
    }
}

fn object_is(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    Result::Ok(
        runtime::Value::Bool(runtime::same_value(argument(arguments, 0), argument(arguments, 1))),
    )
}

fn object_from_entries(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let target = match runtime::new_ordinary_object(context.heap(), Option::None) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let started = collection_iterator_start(context, argument(arguments, 0), depth)?;
    let iterator = started.0;
    let next = started.1;
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        let entry = match collection_iterator_step(context, iterator, next, depth) {
            Ok(Some(value)) => value,
            Ok(None) => return Result::Ok(runtime::Value::Object(target)),
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        match entry {
            runtime::Value::Object(_) => (),
            _ => return collection_close_with_error(
                context,
                iterator,
                depth,
                function_vm_error("Object.fromEntries iterator value is not an object"),
            ),
        }
        let key = match context.read_property_at_depth(entry, runtime::Value::Int(0), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        let value = match context.read_property_at_depth(entry, runtime::Value::Int(1), depth) {
            Ok(value) => value,
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        match context.create_data_property_at_depth(
            runtime::Value::Object(target),
            key,
            value,
            depth,
        ) {
            Ok(()) => (),
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_vm_error("Object.fromEntries input exceeds implementation limit"),
    )
}

fn object_group_by(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let callback = argument(arguments, 1);
    match callback {
        runtime::Value::Object(object) => if !object.is_callable() {
            return Result::Err(function_vm_error("Object.groupBy callback is not callable"))
        },
        _ => return Result::Err(function_vm_error("Object.groupBy callback is not callable")),
    }
    let target = match runtime::new_null_prototype_object(context.heap()) {
        Ok(value) => value,
        Err(value) => return Result::Err(function_vm_error(value.message)),
    };
    let started = collection_iterator_start(context, argument(arguments, 0), depth)?;
    let iterator = started.0;
    let next = started.1;
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        let item = match collection_iterator_step(context, iterator, next, depth) {
            Ok(Some(value)) => value,
            Ok(None) => return Result::Ok(runtime::Value::Object(target)),
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        let key_value = match context.invoke_with_this_at_depth(
            callback,
            Vec::from_array([item, array_length_value(count)]),
            runtime::Value::Undefined,
            depth,
        ) {
            Ok(value) => match property_key_value_at_depth(context, value, depth) {
                Ok(value) => value,
                Err(value) => {
                    return collection_close_with_error(context, iterator, depth, value)
                },
            },
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        let key = match property_key_from_value(context.heap(), key_value) {
            Ok(value) => value,
            Err(value) => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_native_error(value),
                )
            },
        };
        let group = match runtime::get_property(context.heap(), target, key) {
            Ok(Some(runtime::Value::Object(value))) => value,
            Ok(Some(_)) => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error("Object.groupBy group is not an Array"),
                )
            },
            Ok(None) => {
                let value = match allocate_array(context.heap(), Vec::new(), 0) {
                    Ok(value) => value,
                    Err(value) => {
                        return collection_close_with_error(
                            context,
                            iterator,
                            depth,
                            function_native_error(value),
                        )
                    },
                };
                match context.create_data_property_at_depth(
                    runtime::Value::Object(target),
                    key_value,
                    runtime::Value::Object(value),
                    depth,
                ) {
                    Ok(()) => value,
                    Err(error) => {
                        return collection_close_with_error(context, iterator, depth, error)
                    },
                }
            },
            Err(value) => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error(value.message),
                )
            },
        };
        match arrayx::push(context.heap(), group, Vec::from_array([item])) {
            Ok(_) => (),
            Err(value) => {
                return collection_close_with_error(
                    context,
                    iterator,
                    depth,
                    function_vm_error(value.to_string()),
                )
            },
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_range_error("Object.groupBy input exceeds implementation limit"),
    )
}

fn array_is_array_value(heap: runtime::Heap, value: runtime::Value) -> Result[bool, vm::NativeError] {
    let object = match value {
        runtime::Value::Object(value) => match heap.get(value) {
            Some(object) => object,
            None => return Result::Ok(false),
        },
        _ => return Result::Ok(false),
    };
    if object.is_proxy() {
        match object.proxy_target() {
            Some(target) => array_is_array_value(heap, runtime::Value::Object(target)),
            None => Result::Err(native_error("proxy has been revoked")),
        }
    } else {
        match object.kind() {
            runtime::ObjectKind::Array => Result::Ok(true),
            runtime::ObjectKind::Ordinary | runtime::ObjectKind::Function => Result::Ok(false),
        }
    }
}

fn array_is_array(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = this_value;
    Result::Ok(runtime::Value::Bool(array_is_array_value(heap, argument(arguments, 0))?))
}

