fn math_round(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let value = number_argument(arguments, 0)?;
    let result = if math::is_nan(value) || math::is_infinite(value) || value == 0.0
        || math::trunc(value) == value {
        value
    } else if value < 0.0 && value >= -0.5 {
        num::parse_float64_structured("-0").unwrap_or(0.0)
    } else if value > 0.0 && value < 0.5 {
        0.0
    } else {
        math::floor(value + 0.5)
    };
    Result::Ok(runtime::Value::Float(result))
}

fn math_sign(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let value = number_argument(arguments, 0)?;
    let result = if math::is_nan(value) || value == 0.0 {
        value
    } else if value < 0.0 {
        -1.0
    } else {
        1.0
    };
    Result::Ok(runtime::Value::Float(result))
}

