fn math_hypot(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let values: Vec[f64] = Vec::with_capacity(arguments.len());
    let mut index = 0;
    while index < arguments.len() {
        values.push(number_argument(arguments, index)?);
        index += 1;
    }
    Result::Ok(runtime::Value::Float(mathx::hypot(values)))
}

fn math_sum_precise(
    context: vm::Context,
    this_value: runtime::Value,
    arguments: Vec[runtime::Value],
    depth: isize,
) -> Result[runtime::Value, vm::VmError] {
    let _ = this_value;
    let started = collection_iterator_start(context, argument(arguments, 0), depth)?;
    let iterator = started.0;
    let next = started.1;
    let sum = mathx::PreciseSum::new();
    let mut count = 0;
    while count < ARRAY_FROM_LIMIT {
        let item = match collection_iterator_step(context, iterator, next, depth) {
            Ok(Some(value)) => value,
            Ok(None) => return Result::Ok(runtime::Value::Float(sum.result())),
            Err(value) => return collection_close_with_error(context, iterator, depth, value),
        };
        match item {
            runtime::Value::Int(value) => sum.add(int_float(value.to_isize())),
            runtime::Value::Float(value) => sum.add(value),
            _ => return collection_close_with_error(
                context,
                iterator,
                depth,
                function_vm_error("Math.sumPrecise input contains a non-number"),
            ),
        }
        count += 1;
    }
    collection_close_with_error(
        context,
        iterator,
        depth,
        function_range_error("Math.sumPrecise input exceeds implementation limit"),
    )
}

fn math_cbrt(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    Result::Ok(runtime::Value::Float(mathx::cbrt(number_argument(arguments, 0)?)))
}

