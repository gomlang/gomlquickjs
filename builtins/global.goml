fn math_pow(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let base = number_argument(arguments, 0)?;
    let exponent = number_argument(arguments, 1)?;
    let result = if math::is_nan(exponent)
        || math::is_infinite(exponent) && (base == 1.0 || base == -1.0) {
        nan()
    } else {
        math::pow(base, exponent)
    };
    Result::Ok(runtime::Value::Float(result))
}

fn math_max(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let mut result = -infinity();
    let mut index = 0;
    while index < arguments.len() {
        let value = number_argument(arguments, index)?;
        if math::is_nan(value) {
            return Result::Ok(runtime::Value::Float(nan()))
        } else if value > result || value == 0.0 && result == 0.0 && 1.0 / value > 1.0 / result {
            result = value;
        }
        index += 1;
    }
    Result::Ok(runtime::Value::Float(result))
}

fn math_min(heap: runtime::Heap, this_value: runtime::Value, arguments: Vec[runtime::Value]) -> Result[
    runtime::Value,
    vm::NativeError,
] {
    let _ = heap;
    let _ = this_value;
    let mut result = infinity();
    let mut index = 0;
    while index < arguments.len() {
        let value = number_argument(arguments, index)?;
        if math::is_nan(value) {
            return Result::Ok(runtime::Value::Float(nan()))
        } else if value < result || value == 0.0 && result == 0.0 && 1.0 / value < 1.0 / result {
            result = value;
        }
        index += 1;
    }
    Result::Ok(runtime::Value::Float(result))
}

