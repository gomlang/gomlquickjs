package lexer;

use std::testing;

fn assert_kind(result: LexResult, index: isize, expected: TokenKind) -> unit {
    testing::assert_eq(result.tokens[index].kind, expected)
}

#[test]
fn skips_whitespace_and_comments_and_preserves_line_breaks() -> unit {
    let result = lex(" \t// first\r\n/* second\nthird */ let value");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 3);
    assert_kind(result, 0, TokenKind::LetKeyword);
    assert_kind(result, 1, TokenKind::Identifier);
    assert_kind(result, 2, TokenKind::Eof);
    testing::assert(result.tokens[0].line_break_before);
    testing::assert(!result.tokens[1].line_break_before);
    testing::assert_eq(result.tokens[1].value, "value")
}

#[test]
fn accepts_hashbang_only_at_the_start_of_source() -> unit {
    let result = lex("#! /usr/bin/env qjs\nlet value = 1;");
    testing::assert_eq(result.errors.len(), 0);
    assert_kind(result, 0, TokenKind::LetKeyword);
    testing::assert(result.tokens[0].line_break_before);
    testing::assert_eq(result.tokens[0].span.start, 20);
    let misplaced = lex("let value = 1;\n#! invalid");
    testing::assert(misplaced.errors.len() > 0)
}

#[test]
fn recognizes_all_quickjs_keywords() -> unit {
    let result = lex(
        "null false true if else return var this delete void typeof new in instanceof do while for break continue switch case default throw try catch finally function debugger with class const enum export extends import super implements interface let package private protected public static yield await",
    );
    let expected = Vec::from_array(
        [
            TokenKind::NullKeyword,
            TokenKind::FalseKeyword,
            TokenKind::TrueKeyword,
            TokenKind::IfKeyword,
            TokenKind::ElseKeyword,
            TokenKind::ReturnKeyword,
            TokenKind::VarKeyword,
            TokenKind::ThisKeyword,
            TokenKind::DeleteKeyword,
            TokenKind::VoidKeyword,
            TokenKind::TypeofKeyword,
            TokenKind::NewKeyword,
            TokenKind::InKeyword,
            TokenKind::InstanceofKeyword,
            TokenKind::DoKeyword,
            TokenKind::WhileKeyword,
            TokenKind::ForKeyword,
            TokenKind::BreakKeyword,
            TokenKind::ContinueKeyword,
            TokenKind::SwitchKeyword,
            TokenKind::CaseKeyword,
            TokenKind::DefaultKeyword,
            TokenKind::ThrowKeyword,
            TokenKind::TryKeyword,
            TokenKind::CatchKeyword,
            TokenKind::FinallyKeyword,
            TokenKind::FunctionKeyword,
            TokenKind::DebuggerKeyword,
            TokenKind::WithKeyword,
            TokenKind::ClassKeyword,
            TokenKind::ConstKeyword,
            TokenKind::EnumKeyword,
            TokenKind::ExportKeyword,
            TokenKind::ExtendsKeyword,
            TokenKind::ImportKeyword,
            TokenKind::SuperKeyword,
            TokenKind::ImplementsKeyword,
            TokenKind::InterfaceKeyword,
            TokenKind::LetKeyword,
            TokenKind::PackageKeyword,
            TokenKind::PrivateKeyword,
            TokenKind::ProtectedKeyword,
            TokenKind::PublicKeyword,
            TokenKind::StaticKeyword,
            TokenKind::YieldKeyword,
            TokenKind::AwaitKeyword,
        ],
    );
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), expected.len() + 1);
    for index in 0..expected.len() {
        assert_kind(result, index, expected[index])
    }
}

#[test]
fn recognizes_ascii_utf8_and_private_identifiers() -> unit {
    let result = lex("async of $value _name 变量 #字段");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 7);
    for index in 0..5 {
        assert_kind(result, index, TokenKind::Identifier)
    }
    assert_kind(result, 5, TokenKind::PrivateIdentifier);
    testing::assert_eq(result.tokens[4].value, "变量");
    testing::assert_eq(result.tokens[4].span.start, 22);
    testing::assert_eq(result.tokens[4].span.end, 28);
    testing::assert_eq(result.tokens[5].value, "字段")
}

#[test]
fn decodes_unicode_escapes_in_identifiers_and_private_names() -> unit {
    let result = lex("\\u0061bc \\u{10400}x #\\u005Fsecret a\\u200Cb a\\u200Db");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 6);
    assert_kind(result, 0, TokenKind::Identifier);
    assert_kind(result, 1, TokenKind::Identifier);
    assert_kind(result, 2, TokenKind::PrivateIdentifier);
    assert_kind(result, 3, TokenKind::Identifier);
    assert_kind(result, 4, TokenKind::Identifier);
    testing::assert_eq(result.tokens[0].lexeme, "\\u0061bc");
    testing::assert_eq(result.tokens[0].value, "abc");
    testing::assert_eq(result.tokens[0].span, Span { start: 0, end: 8 });
    testing::assert_eq(result.tokens[1].lexeme, "\\u{10400}x");
    testing::assert_eq(result.tokens[1].value, "𐐀x");
    testing::assert_eq(result.tokens[1].span, Span { start: 9, end: 19 });
    testing::assert_eq(result.tokens[2].value, "_secret");
    testing::assert_eq(result.tokens[3].value, "a\u200Cb");
    testing::assert_eq(result.tokens[4].value, "a\u200Db");
    for index in 0..5 {
        testing::assert(result.tokens[index].has_escape)
    }
}

#[test]
fn preserves_escaped_reserved_words_as_marked_identifiers() -> unit {
    let result = lex("\\u0069f \\u{6C}et #\\u0069f \\u0061sync");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 5);
    assert_kind(result, 0, TokenKind::Identifier);
    assert_kind(result, 1, TokenKind::Identifier);
    assert_kind(result, 2, TokenKind::PrivateIdentifier);
    assert_kind(result, 3, TokenKind::Identifier);
    testing::assert_eq(result.tokens[0].value, "if");
    testing::assert_eq(result.tokens[1].value, "let");
    testing::assert_eq(result.tokens[2].value, "if");
    testing::assert_eq(result.tokens[3].value, "async");
    testing::assert(result.tokens[0].is_reserved);
    testing::assert(result.tokens[1].is_reserved);
    testing::assert(!result.tokens[2].is_reserved);
    testing::assert(!result.tokens[3].is_reserved)
}

#[test]
fn rejects_escaped_codepoints_outside_identifier_positions_and_recovers() -> unit {
    let result = lex("\\u0030bad ok a\\u002Db tail #\\u0030private end");
    testing::assert_eq(result.errors.len(), 3);
    testing::assert_eq(result.tokens.len(), 7);
    assert_kind(result, 0, TokenKind::Error);
    assert_kind(result, 1, TokenKind::Identifier);
    assert_kind(result, 2, TokenKind::Error);
    assert_kind(result, 3, TokenKind::Identifier);
    assert_kind(result, 4, TokenKind::Error);
    assert_kind(result, 5, TokenKind::Identifier);
    testing::assert_eq(result.tokens[0].value, "0bad");
    testing::assert_eq(result.tokens[2].value, "a-b");
    testing::assert_eq(result.tokens[4].value, "0private");
    testing::assert_eq(
        result.errors[0].message,
        "escaped code point is not valid at the start of an identifier",
    );
    testing::assert_eq(result.errors[1].message, "escaped code point is not valid in an identifier")
}

#[test]
fn rejects_malformed_out_of_range_and_surrogate_identifier_escapes() -> unit {
    let result = lex("\\uD800 one \\u{110000} two \\u{} three \\u12 four #\\uDFFF five");
    testing::assert_eq(result.errors.len(), 5);
    testing::assert_eq(result.tokens.len(), 11);
    for index in 0..5 {
        assert_kind(result, index * 2, TokenKind::Error);
        assert_kind(result, index * 2 + 1, TokenKind::Identifier)
    }
    assert_kind(result, 10, TokenKind::Eof);
    for index in 0..5 {
        testing::assert_eq(result.errors[index].message, "invalid Unicode escape in identifier")
    }
}

#[test]
fn rejects_non_identifier_unicode_characters() -> unit {
    let result = lex("😀value \u0300mark valid\u0300");
    testing::assert_eq(result.errors.len(), 2);
    assert_kind(result, 0, TokenKind::Error);
    assert_kind(result, 1, TokenKind::Identifier);
    assert_kind(result, 2, TokenKind::Error);
    assert_kind(result, 3, TokenKind::Identifier);
    assert_kind(result, 4, TokenKind::Identifier);
    assert_kind(result, 5, TokenKind::Eof);
    testing::assert_eq(result.tokens[4].value, "valid\u0300")
}

#[test]
fn scans_no_substitution_and_interpolated_templates() -> unit {
    let result = lex("`plain` `head ${value} tail`");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 5);
    assert_kind(result, 0, TokenKind::NoSubstitutionTemplate);
    assert_kind(result, 1, TokenKind::TemplateHead);
    assert_kind(result, 2, TokenKind::Identifier);
    assert_kind(result, 3, TokenKind::TemplateTail);
    testing::assert_eq(result.tokens[0].value, "plain");
    testing::assert_eq(result.tokens[1].value, "head ");
    testing::assert_eq(result.tokens[3].value, " tail");
    testing::assert_eq(result.tokens[1].lexeme, "`head ${");
    testing::assert_eq(result.tokens[3].lexeme, "} tail`")
}

#[test]
fn scans_nested_template_substitutions_and_braces() -> unit {
    let result = lex("`a ${{value: `b ${inner}`}.value} c ${tail} d`");
    testing::assert_eq(result.errors.len(), 0);
    let kinds: Vec[TokenKind] = Vec::new();
    for token in result.tokens {
        kinds.push(token.kind)
    }
    testing::assert(
        kinds
            == Vec::from_array(
                [
                    TokenKind::TemplateHead,
                    TokenKind::LBrace,
                    TokenKind::Identifier,
                    TokenKind::Colon,
                    TokenKind::TemplateHead,
                    TokenKind::Identifier,
                    TokenKind::TemplateTail,
                    TokenKind::RBrace,
                    TokenKind::Dot,
                    TokenKind::Identifier,
                    TokenKind::TemplateMiddle,
                    TokenKind::Identifier,
                    TokenKind::TemplateTail,
                    TokenKind::Eof,
                ],
            ),
    )
}

#[test]
fn decodes_template_escapes_and_normalizes_crlf() -> unit {
    let result = lex("`a\\n\\x62\\u0063\r\nd`");
    testing::assert_eq(result.errors.len(), 0);
    assert_kind(result, 0, TokenKind::NoSubstitutionTemplate);
    testing::assert_eq(result.tokens[0].value, "a\nbc\nd")
}

#[test]
fn reports_unterminated_templates_and_recovers_to_eof() -> unit {
    let result = lex("before `never ${ends");
    testing::assert_eq(result.errors.len(), 1);
    testing::assert_eq(result.errors[0].message, "unterminated template literal");
    assert_kind(result, 0, TokenKind::Identifier);
    assert_kind(result, 1, TokenKind::TemplateHead);
    assert_kind(result, 2, TokenKind::Identifier);
    assert_kind(result, 3, TokenKind::Eof)
}

#[test]
fn recognizes_complete_operator_set() -> unit {
    let result = lex(
        "( ) { } [ ] ; , : . ... ? ?. => = + - * % ** ++ -- += -= *= %= **= << >> >>> <<= >>= >>>= < <= > >= == === != !== & | ^ ~ &= |= ^= && || ?? &&= ||= ??= !",
    );
    let expected = Vec::from_array(
        [
            TokenKind::LParen,
            TokenKind::RParen,
            TokenKind::LBrace,
            TokenKind::RBrace,
            TokenKind::LBracket,
            TokenKind::RBracket,
            TokenKind::Semicolon,
            TokenKind::Comma,
            TokenKind::Colon,
            TokenKind::Dot,
            TokenKind::Ellipsis,
            TokenKind::Question,
            TokenKind::OptionalChain,
            TokenKind::Arrow,
            TokenKind::Assign,
            TokenKind::Plus,
            TokenKind::Minus,
            TokenKind::Star,
            TokenKind::Percent,
            TokenKind::Power,
            TokenKind::Increment,
            TokenKind::Decrement,
            TokenKind::PlusAssign,
            TokenKind::MinusAssign,
            TokenKind::StarAssign,
            TokenKind::PercentAssign,
            TokenKind::PowerAssign,
            TokenKind::ShiftLeft,
            TokenKind::ShiftRight,
            TokenKind::ShiftRightUnsigned,
            TokenKind::ShiftLeftAssign,
            TokenKind::ShiftRightAssign,
            TokenKind::ShiftRightUnsignedAssign,
            TokenKind::Less,
            TokenKind::LessEqual,
            TokenKind::Greater,
            TokenKind::GreaterEqual,
            TokenKind::Equal,
            TokenKind::StrictEqual,
            TokenKind::NotEqual,
            TokenKind::StrictNotEqual,
            TokenKind::BitAnd,
            TokenKind::BitOr,
            TokenKind::BitXor,
            TokenKind::BitNot,
            TokenKind::BitAndAssign,
            TokenKind::BitOrAssign,
            TokenKind::BitXorAssign,
            TokenKind::LogicalAnd,
            TokenKind::LogicalOr,
            TokenKind::NullishCoalescing,
            TokenKind::LogicalAndAssign,
            TokenKind::LogicalOrAssign,
            TokenKind::NullishCoalescingAssign,
            TokenKind::LogicalNot,
        ],
    );
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), expected.len() + 1);
    for index in 0..expected.len() {
        assert_kind(result, index, expected[index])
    }
}

#[test]
fn distinguishes_regexp_literals_from_division_and_assignment() -> unit {
    let result = lex(
        "let pattern = /a[\\/]b+/gim; left / right; left /= right; if (ready) /x/.test(value);",
    );
    testing::assert_eq(result.errors.len(), 0);
    assert_kind(result, 3, TokenKind::RegExp);
    testing::assert_eq(result.tokens[3].value, "a[\\/]b+");
    testing::assert_eq(result.tokens[3].regex_flags, "gim");
    assert_kind(result, 6, TokenKind::Slash);
    assert_kind(result, 10, TokenKind::SlashAssign);
    assert_kind(result, 17, TokenKind::RegExp);
    testing::assert_eq(result.tokens[17].value, "x")
}

#[test]
fn reports_unterminated_regexp_literals() -> unit {
    let result = lex("let value = /unterminated\nlet tail = 1;");
    testing::assert_eq(result.errors.len(), 1);
    testing::assert_eq(result.errors[0].message, "unterminated regular expression literal");
    assert_kind(result, 3, TokenKind::Error);
    assert_kind(result, 4, TokenKind::LetKeyword)
}

#[test]
fn distinguishes_block_and_object_brace_slash_contexts() -> unit {
    let result = lex("if (ready) {} /x/.test(''); let ratio = {} / 2;");
    testing::assert_eq(result.errors.len(), 0);
    assert_kind(result, 6, TokenKind::RegExp);
    assert_kind(result, 18, TokenKind::Slash)
}

#[test]
fn distinguishes_declarations_from_function_class_and_arrow_expressions() -> unit {
    let result = lex(
        "let fn = function() {} / 2; let type = class {} / 2; let arrow = () => {} / 2; function declared() {} /x/.test('x'); class Declared {} /y/.test('y');",
    );
    testing::assert_eq(result.errors.len(), 0);
    let regexps = Ref::new(0);
    let divisions = Ref::new(0);
    for token in result.tokens {
        if token.kind == TokenKind::RegExp {
            regexps.set(regexps.get() + 1)
        } else if token.kind == TokenKind::Slash {
            divisions.set(divisions.get() + 1)
        } else {}
    }
    testing::assert_eq(regexps.get(), 2);
    testing::assert_eq(divisions.get(), 3)
}

#[test]
fn decodes_common_string_escapes() -> unit {
    let result = lex("\"a\\n\\t\\x42\\u0043\" 'it\\'s' \"\\u{4F60}\\u{597D}\"");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 4);
    for index in 0..3 {
        assert_kind(result, index, TokenKind::String)
    }
    testing::assert_eq(result.tokens[0].value, "a\n\tBC");
    testing::assert_eq(result.tokens[1].value, "it's");
    testing::assert_eq(result.tokens[2].value, "你好")
}

#[test]
fn accepts_surrogate_code_units_in_string_escapes() -> unit {
    let result = lex("\"\\ud800\\u{dc00}\" '\\udfff'");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 3);
    assert_kind(result, 0, TokenKind::String);
    assert_kind(result, 1, TokenKind::String);
    testing::assert_eq(result.tokens[0].lexeme, "\"\\ud800\\u{dc00}\"");
    testing::assert_eq(result.tokens[1].lexeme, "'\\udfff'")
}

#[test]
fn scans_decimal_radix_bigint_and_separated_numbers() -> unit {
    let result = lex("0 123 1.5 .25 1. 1e3 1.2e-3 0b1010 0o77 0xFF 123n 0xFFn 1_000");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 14);
    for index in 0..10 {
        assert_kind(result, index, TokenKind::Number)
    }
    assert_kind(result, 10, TokenKind::BigInt);
    assert_kind(result, 11, TokenKind::BigInt);
    assert_kind(result, 12, TokenKind::Number)
}

#[test]
fn scans_legacy_octal_before_property_access() -> unit {
    let result = lex("01.a 077 08.5");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens[0].lexeme, "01");
    assert_kind(result, 0, TokenKind::Number);
    assert_kind(result, 1, TokenKind::Dot);
    assert_kind(result, 2, TokenKind::Identifier);
    testing::assert_eq(result.tokens[3].lexeme, "077");
    testing::assert_eq(result.tokens[4].lexeme, "08.5")
}

#[test]
fn recovers_after_invalid_numbers_strings_and_characters() -> unit {
    let result = lex("0b102 next 1e+ tail 123abc done \"bad\\xG0\" after @ final");
    testing::assert_eq(result.errors.len(), 5);
    assert_kind(result, 0, TokenKind::Number);
    assert_kind(result, 1, TokenKind::Identifier);
    assert_kind(result, 2, TokenKind::Number);
    assert_kind(result, 3, TokenKind::Identifier);
    assert_kind(result, 4, TokenKind::Number);
    assert_kind(result, 5, TokenKind::Identifier);
    assert_kind(result, 6, TokenKind::String);
    assert_kind(result, 7, TokenKind::Identifier);
    assert_kind(result, 8, TokenKind::Error);
    assert_kind(result, 9, TokenKind::Identifier);
    assert_kind(result, 10, TokenKind::Eof)
}

#[test]
fn recovers_from_unterminated_string_at_next_line() -> unit {
    let result = lex("\"broken\nlet value");
    testing::assert_eq(result.errors.len(), 1);
    assert_kind(result, 0, TokenKind::String);
    assert_kind(result, 1, TokenKind::LetKeyword);
    assert_kind(result, 2, TokenKind::Identifier);
    testing::assert(result.tokens[1].line_break_before)
}

#[test]
fn reports_unterminated_block_comment_and_emits_eof() -> unit {
    let result = lex("name /* never closed");
    testing::assert_eq(result.errors.len(), 1);
    testing::assert_eq(result.errors[0].message, "unterminated block comment");
    testing::assert_eq(result.tokens.len(), 2);
    assert_kind(result, 0, TokenKind::Identifier);
    assert_kind(result, 1, TokenKind::Eof)
}

#[test]
fn emits_eof_for_empty_input() -> unit {
    let result = lex("");
    testing::assert_eq(result.errors.len(), 0);
    testing::assert_eq(result.tokens.len(), 1);
    assert_kind(result, 0, TokenKind::Eof);
    testing::assert_eq(result.tokens[0].span, Span { start: 0, end: 0 })
}
