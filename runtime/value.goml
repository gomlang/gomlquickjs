package runtime;

use gomlang::quickjs::bigint;
use gomlang::quickjs::dtoa;
use std::math;
use std::num;

pub struct Symbol {
    id_value: u64,
    description_value: Option[JsString],
    registered_value: bool,
}

impl Symbol {
    pub fn new(id: u64, description: Option[string]) -> Symbol {
        Symbol {
            id_value: id,
            description_value: match description {
                Some(value) => {
                    let bytes = value.to_bytes();
                    Option::Some(JsString::from_utf8(bytes.slice(0, bytes.len())))
                },
                None => Option::None,
            },
            registered_value: false,
        }
    }

    pub fn from_js_string(id: u64, description: Option[JsString]) -> Symbol {
        Symbol { id_value: id, description_value: description, registered_value: false }
    }

    pub fn id(self: Symbol) -> u64 {
        self.id_value
    }

    pub fn description(self: Symbol) -> Option[JsString] {
        self.description_value
    }

    pub fn with_registry_registration(self: Symbol) -> Symbol {
        Symbol {
            id_value: self.id_value,
            description_value: self.description_value,
            registered_value: true,
        }
    }

    pub fn is_registered(self: Symbol) -> bool {
        self.registered_value
    }
}

impl PartialEq for Symbol {
    fn eq(self: Symbol, other: Symbol) -> bool {
        self.id_value == other.id_value
    }
}

impl Eq for Symbol {}

impl Hash for Symbol {
    fn hash(self: Symbol) -> u64 {
        self.id_value
    }
}

pub struct BigInt {
    integer_value: bigint::BigInteger,
}

impl BigInt {
    pub fn new(negative: bool, magnitude: string) -> BigInt {
        let value = match bigint::parse(magnitude) {
            Ok(value) => value,
            Err(_) => bigint::BigInteger::zero(),
        };
        BigInt::from_integer(
            if negative {
                value.negate()
            } else {
                value
            },
        )
    }

    pub fn from_integer(value: bigint::BigInteger) -> BigInt {
        BigInt { integer_value: value.copy() }
    }

    pub fn from_int64(value: i64) -> BigInt {
        BigInt::from_integer(bigint::BigInteger::from_int64(value))
    }

    pub fn parse_radix(value: string, radix: isize) -> Result[BigInt, bigint::BigIntError] {
        Result::Ok(BigInt::from_integer(bigint::parse_radix(value, radix)?))
    }

    pub fn integer(self: BigInt) -> bigint::BigInteger {
        self.integer_value.copy()
    }

    pub fn negative(self: BigInt) -> bool {
        self.integer_value.is_negative()
    }

    pub fn magnitude(self: BigInt) -> string {
        self.integer_value.abs().to_string()
    }

    pub fn is_zero(self: BigInt) -> bool {
        self.integer_value.is_zero()
    }

    pub fn negate(self: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.negate())
    }

    pub fn compare(self: BigInt, other: BigInt) -> isize {
        self.integer_value.compare(other.integer_value)
    }

    pub fn add(self: BigInt, other: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.add(other.integer_value))
    }

    pub fn subtract(self: BigInt, other: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.subtract(other.integer_value))
    }

    pub fn multiply(self: BigInt, other: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.multiply(other.integer_value))
    }

    pub fn divide(self: BigInt, other: BigInt) -> Result[BigInt, bigint::BigIntError] {
        Result::Ok(BigInt::from_integer(self.integer_value.divide(other.integer_value)?))
    }

    pub fn remainder(self: BigInt, other: BigInt) -> Result[BigInt, bigint::BigIntError] {
        Result::Ok(BigInt::from_integer(self.integer_value.remainder(other.integer_value)?))
    }

    pub fn pow(self: BigInt, exponent: isize) -> Result[BigInt, bigint::BigIntError] {
        Result::Ok(BigInt::from_integer(self.integer_value.pow(exponent)?))
    }

    pub fn bit_and(self: BigInt, other: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.bit_and(other.integer_value))
    }

    pub fn bit_or(self: BigInt, other: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.bit_or(other.integer_value))
    }

    pub fn bit_xor(self: BigInt, other: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.bit_xor(other.integer_value))
    }

    pub fn bit_not(self: BigInt) -> BigInt {
        BigInt::from_integer(self.integer_value.bit_not())
    }

    pub fn shift_left(self: BigInt, count: isize) -> Result[BigInt, bigint::BigIntError] {
        Result::Ok(BigInt::from_integer(self.integer_value.shift_left(count)?))
    }

    pub fn shift_right(self: BigInt, count: isize) -> Result[BigInt, bigint::BigIntError] {
        Result::Ok(BigInt::from_integer(self.integer_value.shift_right(count)?))
    }

    pub fn limb_count(self: BigInt) -> isize {
        self.integer_value.limb_count()
    }

    pub fn limbs(self: BigInt) -> Vec[u32] {
        self.integer_value.limbs()
    }
}

impl PartialEq for BigInt {
    fn eq(self: BigInt, other: BigInt) -> bool {
        self.integer_value == other.integer_value
    }
}

impl Eq for BigInt {}

impl Hash for BigInt {
    fn hash(self: BigInt) -> u64 {
        let mut result = Hash::hash(self.negative());
        for limb in self.limbs() {
            result = (result ^ Hash::hash(limb)) * 1099511628211;
        }
        result
    }
}

impl ToString for BigInt {
    fn to_string(self: BigInt) -> string {
        self.integer_value.to_string()
    }
}

fn bigint_whitespace(value: u16) -> bool {
    value == 0x0009 || value == 0x000a || value == 0x000b || value == 0x000c || value == 0x000d
        || value == 0x0020
        || value == 0x00a0
        || value == 0x1680
        || (value >= 0x2000 && value <= 0x200a)
        || value == 0x2028
        || value == 0x2029
        || value == 0x202f
        || value == 0x205f
        || value == 0x3000
        || value == 0xfeff
}

pub fn string_to_bigint(value: JsString) -> Result[BigInt, TypeError] {
    let mut start = 0;
    let mut end = value.len();
    while start < end && bigint_whitespace(value.get(start)) {
        start += 1;
    }
    while end > start && bigint_whitespace(value.get(end - 1)) {
        end -= 1;
    }
    if start == end {
        return Result::Ok(BigInt::from_integer(bigint::BigInteger::zero()))
    }
    let mut index = start;
    let mut negative = false;
    let mut signed = false;
    if value.get(index) == 43 || value.get(index) == 45 {
        signed = true;
        negative = value.get(index) == 45;
        index += 1;
    }
    if index == end {
        return Result::Err(TypeError { message: "cannot convert string to bigint" })
    }
    if value.get(index) == 43 || value.get(index) == 45 {
        return Result::Err(TypeError { message: "cannot convert string to bigint" })
    }
    let mut radix = 10;
    if !signed && index + 1 < end && value.get(index) == 48 {
        let marker = value.get(index + 1);
        if marker == 88 || marker == 120 {
            radix = 16;
            index += 2;
        } else if marker == 79 || marker == 111 {
            radix = 8;
            index += 2;
        } else if marker == 66 || marker == 98 {
            radix = 2;
            index += 2;
        }
    }
    if index == end {
        return Result::Err(TypeError { message: "cannot convert string to bigint" })
    }
    let bytes: Vec[byte] = Vec::with_capacity(end - index);
    while index < end {
        let current = value.get(index);
        if current > 127 {
            return Result::Err(TypeError { message: "cannot convert string to bigint" })
        }
        bytes.push(current.to_u8());
        index += 1;
    }
    let (_, digits) = string_from_utf8(bytes);
    match bigint::parse_radix(digits, radix) {
        Ok(result) => Result::Ok(
            BigInt::from_integer(
                if negative {
                    result.negate()
                } else {
                    result
                },
            ),
        ),
        Err(_) => Result::Err(TypeError { message: "cannot convert string to bigint" }),
    }
}

pub fn integral_number_to_bigint(value: f64) -> Result[BigInt, TypeError] {
    if !math::is_finite(value) || math::trunc(value) != value {
        return Result::Err(TypeError { message: "number is not an integer" })
    }
    if value == 0.0 {
        return Result::Ok(BigInt::from_integer(bigint::BigInteger::zero()))
    }
    let negative = value < 0.0;
    let mut scaled = if negative {
        -value
    } else {
        value
    };
    let mut exponent = 0;
    while scaled >= 2.0 {
        scaled *= 0.5;
        exponent += 1;
    }
    let mut mantissa = 0.to_u64();
    let mut index = 0;
    while index < 53 {
        mantissa <<= 1;
        if scaled >= 1.0 {
            mantissa |= 1;
            scaled -= 1.0;
        }
        scaled *= 2.0;
        index += 1;
    }
    let binary_exponent = exponent - 52;
    let integer = bigint::BigInteger::from_uint64(mantissa);
    let magnitude = if binary_exponent >= 0 {
        match integer.shift_left(binary_exponent) {
            Ok(value) => value,
            Err(_) => return Result::Err(TypeError { message: "number is outside bigint range" }),
        }
    } else {
        match integer.shift_right(-binary_exponent) {
            Ok(value) => value,
            Err(_) => return Result::Err(TypeError { message: "number is outside bigint range" }),
        }
    };
    Result::Ok(
        BigInt::from_integer(
            if negative {
                magnitude.negate()
            } else {
                magnitude
            },
        ),
    )
}

pub fn primitive_to_bigint(value: Value) -> Result[BigInt, TypeError] {
    match value {
        Value::BigInt(value) => Result::Ok(value),
        Value::Bool(value) => Result::Ok(
            BigInt::from_int64(
                if value {
                    1
                } else {
                    0
                },
            ),
        ),
        Value::String(value) => string_to_bigint(value),
        _ => Result::Err(TypeError { message: "cannot convert value to BigInt" }),
    }
}

pub enum Value {
    Undefined,
    Null,
    Bool(bool),
    Int(i32),
    Float(f64),
    String(JsString),
    Symbol(Symbol),
    BigInt(BigInt),
    Object(ObjectId),
}

#[derive(PartialEq, Eq, Debug)]
pub struct TypeError {
    pub message: string,
}

pub fn int_to_number(value: i32) -> f64 {
    if value == 0 {
        return 0.0
    }
    let negative = value < 0;
    let magnitude = if negative {
        (-value.to_i64()).to_u64()
    } else {
        value.to_u64()
    };
    if negative {
        -uint64_to_number(magnitude)
    } else {
        uint64_to_number(magnitude)
    }
}

pub fn uint64_to_number(magnitude: u64) -> f64 {
    if magnitude == 0 {
        return 0.0
    }
    let mut highest_bit: u64 = 0;
    let mut remaining: u64 = 64;
    while remaining > 1 {
        let half = remaining >> 1;
        if magnitude >> (highest_bit + half) != 0 {
            highest_bit += half;
        }
        remaining -= half;
    }
    let exponent = (highest_bit + 1023) << 52;
    let mantissa_field = if highest_bit > 52 {
        (magnitude >> (highest_bit - 52)) & 0xfffffffffffff
    } else {
        (magnitude - (1.to_u64() << highest_bit)) << (52 - highest_bit)
    };
    float64_from_bits(exponent | mantissa_field)
}

fn not_a_number() -> f64 {
    num::parse_float64_structured("NaN").unwrap_or(0.0)
}

fn number_same_value(left: f64, right: f64) -> bool {
    if math::is_nan(left) && math::is_nan(right) {
        true
    } else if left == 0.0 && right == 0.0 {
        1.0 / left == 1.0 / right
    } else {
        left == right
    }
}

fn number_same_value_zero(left: f64, right: f64) -> bool {
    if math::is_nan(left) && math::is_nan(right) {
        true
    } else {
        left == right
    }
}

pub fn same_value(left: Value, right: Value) -> bool {
    match (left, right) {
        (Undefined, Undefined) | (Null, Null) => true,
        (Bool(left_value), Bool(right_value)) => left_value == right_value,
        (Int(left_value), Int(right_value)) => left_value == right_value,
        (Float(left_value), Float(right_value)) => {
            number_same_value(left_value, right_value)
        },
        (Int(left_value), Float(right_value)) => {
            number_same_value(int_to_number(left_value), right_value)
        },
        (Float(left_value), Int(right_value)) => {
            number_same_value(left_value, int_to_number(right_value))
        },
        (String(left_value), String(right_value)) => left_value == right_value,
        (Symbol(left_value), Symbol(right_value)) => left_value == right_value,
        (BigInt(left_value), BigInt(right_value)) => left_value == right_value,
        (Object(left_value), Object(right_value)) => left_value == right_value,
        _ => false,
    }
}

pub fn same_value_zero(left: Value, right: Value) -> bool {
    match (left, right) {
        (Float(left_value), Float(right_value)) => {
            number_same_value_zero(left_value, right_value)
        },
        (Int(left_value), Float(right_value)) => {
            number_same_value_zero(int_to_number(left_value), right_value)
        },
        (Float(left_value), Int(right_value)) => {
            number_same_value_zero(left_value, int_to_number(right_value))
        },
        _ => same_value(left, right),
    }
}

pub fn strict_equal(left: Value, right: Value) -> bool {
    match (left, right) {
        (Float(left_value), Float(right_value)) => {
            !math::is_nan(left_value) && !math::is_nan(right_value) && left_value == right_value
        },
        (Int(left_value), Float(right_value)) => {
            !math::is_nan(right_value) && int_to_number(left_value) == right_value
        },
        (Float(left_value), Int(right_value)) => {
            !math::is_nan(left_value) && left_value == int_to_number(right_value)
        },
        _ => same_value(left, right),
    }
}

pub fn to_boolean(value: Value) -> bool {
    match value {
        Undefined | Null => false,
        Bool(value) => value,
        Int(value) => value != 0,
        Float(value) => value != 0.0 && !math::is_nan(value),
        String(value) => value.len() != 0,
        BigInt(value) => !value.is_zero(),
        Symbol(_) => true,
        Object(value) => !value.is_html_dda(),
    }
}

pub fn type_of(value: Value) -> string {
    match value {
        Undefined => "undefined",
        Null => "object",
        Bool(_) => "boolean",
        Int(_) | Float(_) => "number",
        String(_) => "string",
        Symbol(_) => "symbol",
        BigInt(_) => "bigint",
        Object(value) => if value.is_html_dda() {
            "undefined"
        } else if value.is_callable() {
            "function"
        } else {
            "object"
        },
    }
}

pub fn primitive_to_number(value: Value) -> Result[f64, TypeError] {
    match value {
        Undefined => Result::Ok(not_a_number()),
        Null => Result::Ok(0.0),
        Bool(value) => if value {
            Result::Ok(1.0)
        } else {
            Result::Ok(0.0)
        },
        Int(value) => Result::Ok(int_to_number(value)),
        Float(value) => Result::Ok(value),
        String(value) => match value.to_host_string() {
            Ok(text) => Result::Ok(dtoa::parse_number(text)),
            Err(_) => Result::Ok(not_a_number()),
        },
        Symbol(_) => Result::Err(TypeError { message: "cannot convert symbol to number" }),
        BigInt(_) => Result::Err(TypeError { message: "cannot convert bigint to number" }),
        Object(_) => Result::Err(TypeError { message: "object requires ToPrimitive" }),
    }
}
