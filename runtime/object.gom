package runtime;

use gomlang::quickjs::arraybuffer;
use gomlang::quickjs::dtoa;
use std::collections;
use std::math;
use std::num;

#[derive(Hash, PartialEq, Eq)]
pub enum PropertyKey {
    String(JsString),
    Symbol(Symbol),
}

pub fn string_property_key(value: string) -> PropertyKey {
    let bytes = value.to_bytes();
    PropertyKey::String(JsString::from_utf8(bytes.slice(0, bytes.len())))
}

pub fn js_string_property_key(value: JsString) -> PropertyKey {
    PropertyKey::String(value)
}

pub fn is_length_property_key(key: PropertyKey) -> bool {
    match key {
        PropertyKey::String(value) => value.len() == 6 && value.get(0) == 108 && value.get(1) == 101
            && value.get(2) == 110
            && value.get(3) == 103
            && value.get(4) == 116
            && value.get(5) == 104,
        PropertyKey::Symbol(_) => false,
    }
}

pub enum PropertyDescriptor {
    Data {
        value: Value,
        writable: bool,
        enumerable: bool,
        configurable: bool,
    },
    Accessor {
        get: Option[Value],
        set: Option[Value],
        enumerable: bool,
        configurable: bool,
    },
}

enum OrdinaryProperty {
    Default(Value),
    Cached(Ref[Option[Value]]),
    CachedDescribed {
        cell: Ref[Option[Value]],
        writable: bool,
        enumerable: bool,
        configurable: bool,
    },
    Described(PropertyDescriptor),
}

enum ArrayElement {
    Default(Value),
    Described(PropertyDescriptor),
}

enum FastArraySlot {
    Hole,
    Data(Value),
    Observable,
}

pub enum ArrayIndexWriteResult {
    Written,
    ReadOnly,
    Unhandled,
}

pub enum ArrayPopResult {
    Empty,
    Value(Value),
    Slow,
}

pub enum ArrayShiftResult {
    Empty,
    Value(Value),
    Slow,
}

pub struct EvalBindingCache {
    entries_value: Vec[Option[EvalBindingCacheEntry]],
}

pub struct EvalBindingCacheEntry {
    pub root_identity: u64,
    pub root_epoch: u64,
    pub kind: EvalBindingCacheKind,
}

pub enum EvalBindingCacheKind {
    Cell {
        cell: Ref[Value],
        environment_epoch: Ref[u64],
        captured_epoch: u64,
    },
    GlobalLexical {
        value: Ref[Value],
        initialized: Ref[bool],
        mutable: bool,
    },
    GlobalObject,
}

impl EvalBindingCache {
    pub fn new() -> EvalBindingCache {
        EvalBindingCache { entries_value: Vec::new() }
    }

    pub fn get_entry(self: EvalBindingCache, index: isize) -> Option[EvalBindingCacheEntry] {
        if index < 0 || index >= self.entries_value.len() {
            Option::None
        } else {
            self.entries_value[index]
        }
    }

    pub fn set_entry(self: EvalBindingCache, index: isize, entry: Option[EvalBindingCacheEntry]) -> EvalBindingCache {
        let mut cache = self;
        while cache.entries_value.len() <= index {
            cache.entries_value.push(Option::None)
        }
        cache.entries_value[index] = entry;
        cache
    }
}

pub enum PropertyWriteResult {
    Written,
    ReadOnly,
    Unhandled,
}

pub struct PropertyAccessCache {
    object_value: ObjectId,
    receiver_prototype_value: Option[ObjectId],
    key_value: PropertyKey,
    cell_value: Ref[Option[Value]],
    writable_value: bool,
}

pub enum PrivateElement {
    Field(Value),
    Method(Value),
    Accessor {
        get: Option[Value],
        set: Option[Value],
    },
}

pub enum ObjectKind {
    Ordinary,
    Array,
    Function,
}

pub enum TypedArrayView {
    Uint8(arraybuffer::Uint8Array),
    Int32(arraybuffer::Int32Array),
    Float64(arraybuffer::Float64Array),
    Numeric(arraybuffer::NumericArray),
    BigInt(arraybuffer::BigIntArray),
}

struct TypedArrayState {
    view: TypedArrayView,
    buffer_object: ObjectId,
}

struct ArrayLengthState {
    value: isize,
    writable: bool,
    enumerable: bool,
    configurable: bool,
}

enum TypedArrayNumericIndex {
    Invalid,
    Index(isize),
}

fn typed_array_length(view: TypedArrayView) -> isize {
    match view {
        TypedArrayView::Uint8(value) => value.length(),
        TypedArrayView::Int32(value) => value.length(),
        TypedArrayView::Float64(value) => value.length(),
        TypedArrayView::Numeric(value) => value.length(),
        TypedArrayView::BigInt(value) => value.length(),
    }
}

fn typed_array_element(view: TypedArrayView, index: isize) -> Option[Value] {
    if index < 0 || index >= typed_array_length(view) {
        Option::None
    } else {
        match view {
            TypedArrayView::Uint8(value) => match value.get(index) {
                Ok(value) => Option::Some(Value::Int(value.to_i32())),
                Err(_) => Option::None,
            },
            TypedArrayView::Int32(value) => match value.get(index) {
                Ok(value) => Option::Some(Value::Int(value)),
                Err(_) => Option::None,
            },
            TypedArrayView::Float64(value) => match value.get(index) {
                Ok(value) => Option::Some(Value::Float(value)),
                Err(_) => Option::None,
            },
            TypedArrayView::Numeric(value) => match value.get(index) {
                Ok(value) => Option::Some(Value::Float(value)),
                Err(_) => Option::None,
            },
            TypedArrayView::BigInt(value) => match value.get(index) {
                Ok(value) => Option::Some(Value::BigInt(BigInt::from_integer(value))),
                Err(_) => Option::None,
            },
        }
    }
}

fn typed_array_set_element(view: TypedArrayView, index: isize, value: f64) -> bool {
    if index < 0 || index >= typed_array_length(view) {
        false
    } else {
        match view {
            TypedArrayView::Uint8(target) => target.set(index, value).is_ok(),
            TypedArrayView::Int32(target) => target.set(index, value).is_ok(),
            TypedArrayView::Float64(target) => target.set(index, value).is_ok(),
            TypedArrayView::Numeric(target) => target.set(index, value).is_ok(),
            TypedArrayView::BigInt(_) => false,
        }
    }
}

fn typed_array_set_value(view: TypedArrayView, index: isize, value: Value) -> Result[
    bool,
    TypeError,
] {
    match view {
        TypedArrayView::BigInt(target) => {
            let converted = primitive_to_bigint(value)?;
            if index < 0 || index >= target.length() {
                Result::Ok(false)
            } else {
                Result::Ok(target.set(index, converted.integer()).is_ok())
            }
        },
        _ => {
            let converted = primitive_to_number(value)?;
            Result::Ok(typed_array_set_element(view, index, converted))
        },
    }
}

pub fn read_typed_array_index(view: TypedArrayView, index: isize) -> Value {
    match typed_array_element(view, index) {
        Some(value) => value,
        None => Value::Undefined,
    }
}

pub fn write_typed_array_index(view: TypedArrayView, index: isize, value: Value) -> Result[
    bool,
    TypeError,
] {
    let valid = index >= 0 && index < typed_array_length(view);
    let written = typed_array_set_value(view, index, value)?;
    Result::Ok(written || !valid)
}

fn typed_array_numeric_index(key: PropertyKey) -> Option[TypedArrayNumericIndex] {
    let value = match key {
        PropertyKey::String(value) => value,
        PropertyKey::Symbol(_) => return Option::None,
    };
    let source = match value.to_host_string() {
        Ok(value) => value,
        Err(_) => return Option::None,
    };
    if source == "-0" {
        return Option::Some(TypedArrayNumericIndex::Invalid)
    }
    let number = match primitive_to_number(Value::String(value)) {
        Ok(value) => value,
        Err(_) => return Option::None,
    };
    if dtoa::number_to_string(number) != source {
        Option::None
    } else if !math::is_finite(number) || number < 0.0 || math::trunc(number) != number
        || number > 2147483647.0 {
        Option::Some(TypedArrayNumericIndex::Invalid)
    } else {
        match num::parse_int_structured(dtoa::number_to_string(number)) {
            Ok(value) => Option::Some(TypedArrayNumericIndex::Index(value)),
            Err(_) => Option::Some(TypedArrayNumericIndex::Invalid),
        }
    }
}

#[derive(PartialEq, Eq, Debug)]
pub enum PrimitivePrototypeKind {
    Boolean,
    Number,
    String,
    BigInt,
    Symbol,
}

pub struct ObjectId {
    heap_identity_value: Ref[bool],
    slot_value: isize,
    generation_value: u64,
    callable_value: bool,
}

impl ObjectId {
    pub fn slot(self: ObjectId) -> isize {
        self.slot_value
    }

    pub fn generation(self: ObjectId) -> u64 {
        self.generation_value
    }

    pub fn is_callable(self: ObjectId) -> bool {
        self.callable_value
    }
}

impl PartialEq for ObjectId {
    fn eq(self: ObjectId, other: ObjectId) -> bool {
        self.heap_identity_value == other.heap_identity_value && self.slot_value == other.slot_value
            && self.generation_value == other.generation_value
    }
}

impl Eq for ObjectId {}

impl Hash for ObjectId {
    fn hash(self: ObjectId) -> u64 {
        ptr_hash(self.heap_identity_value) * 1099511628211 + Hash::hash(self.slot_value) * 16777619
            + self.generation_value
    }
}

impl Debug for ObjectId {
    fn debug(self: ObjectId) -> string {
        "ObjectId(" + self.slot_value.to_string() + ", " + self.generation_value.to_string() + ")"
    }
}

pub struct Object {
    state_value: Ref[ObjectState],
}

struct ObjectState {
    kind_value: ObjectKind,
    prototype_value: Ref[Option[ObjectId]],
    immutable_prototype_value: Ref[bool],
    extensible_value: Ref[bool],
    properties_value: collections::IndexMap[PropertyKey, OrdinaryProperty],
    array_length_value: Ref[Option[ArrayLengthState]],
    array_dense_properties_value: Vec[Option[ArrayElement]],
    array_sparse_properties_value: Ref[Option[HashMap[u32, PropertyDescriptor]]],
    private_elements_value: Ref[Option[HashMap[ObjectId, PrivateElement]]],
    primitive_value_value: Ref[Option[Value]],
    argument_map_value: Ref[Option[HashMap[u32, Ref[Value]]]],
    module_namespace_bindings_value: Ref[Option[HashMap[PropertyKey, Ref[Value]]]],
    module_namespace_value: Ref[bool],
    typed_array_value: Ref[Option[TypedArrayState]],
    proxy_value: Ref[Option[ProxyData]],
}

struct ProxyData {
    target_value: Ref[Option[ObjectId]],
    handler_value: Ref[Option[ObjectId]],
}

impl Object {
    pub fn kind(self: Object) -> ObjectKind {
        self.state_value.get().kind_value
    }

    pub fn typed_array_view(self: Object) -> Option[TypedArrayView] {
        match self.state_value.get().typed_array_value.get() {
            Some(value) => Option::Some(value.view),
            None => Option::None,
        }
    }

    pub fn prototype(self: Object) -> Option[ObjectId] {
        self.state_value.get().prototype_value.get()
    }

    pub fn extensible(self: Object) -> bool {
        self.state_value.get().extensible_value.get()
    }

    pub fn prevent_extensions(self: Object) -> () {
        self.state_value.get().extensible_value.set(false)
    }

    pub fn own_property(self: Object, key: PropertyKey) -> Option[PropertyDescriptor] {
        match self.state_value.get().typed_array_value.get() {
            Some(state) => match typed_array_numeric_index(key) {
                Some(TypedArrayNumericIndex::Index(index)) => {
                    typed_array_element(state.view, index).map(
                        |value| data_descriptor(value, true, true, true),
                    )
                },
                Some(TypedArrayNumericIndex::Invalid) => Option::None,
                None => match self.state_value.get().properties_value.get(key) {
                    Some(value) => Option::Some(
                        mapped_descriptor(self, key, ordinary_property_descriptor(value)),
                    ),
                    None => Option::None,
                },
            },
            None => match self.kind() {
                ObjectKind::Array => match key {
                    PropertyKey::String(value) => if is_length_property_key(key) {
                        self.state_value.get().array_length_value.get().map(array_length_descriptor)
                    } else {
                        match canonical_array_index(value) {
                            Some(index) => array_index_descriptor(self, index),
                            None => self.state_value.get().properties_value.get(key).map(
                                ordinary_property_descriptor,
                            ),
                        }
                    },
                    PropertyKey::Symbol(_) => {
                        self.state_value.get().properties_value.get(key).map(
                            ordinary_property_descriptor,
                        )
                    },
                },
                _ => match self.state_value.get().properties_value.get(key) {
                    Some(value) => Option::Some(
                        mapped_descriptor(self, key, ordinary_property_descriptor(value)),
                    ),
                    None => Option::None,
                },
            },
        }
    }

    pub fn own_array_index(self: Object, index: isize) -> Option[PropertyDescriptor] {
        if index < 0 || index > 4294967294 {
            Option::None
        } else {
            match self.kind() {
                ObjectKind::Array => array_index_descriptor(self, index.to_u32()),
                _ => Option::None,
            }
        }
    }

    pub fn own_array_index_value(self: Object, index: isize) -> Option[Value] {
        if index < 0 || index > 4294967294 {
            Option::None
        } else {
            match self.kind() {
                ObjectKind::Array => array_index_value(self, index.to_u32()),
                _ => Option::None,
            }
        }
    }

    pub fn write_array_index(self: Object, index: isize, value: Value) -> ArrayIndexWriteResult {
        if index < 0 || index > 4294967294 {
            ArrayIndexWriteResult::Unhandled
        } else {
            match self.kind() {
                ObjectKind::Array => write_existing_array_index_value(self, index.to_u32(), value),
                _ => ArrayIndexWriteResult::Unhandled,
            }
        }
    }

    pub fn own_array_length(self: Object) -> Option[Value] {
        match self.kind() {
            ObjectKind::Array => self.state_value.get().array_length_value.get().map(
                |state| array_length_value(state.value),
            ),
            _ => Option::None,
        }
    }

    pub fn array_length_state(self: Object) -> Option[(isize, bool)] {
        match self.kind() {
            ObjectKind::Array => self.state_value.get().array_length_value.get().map(
                |state| (state.value, state.writable),
            ),
            _ => Option::None,
        }
    }

    pub fn set_array_length_state(self: Object, value: isize) -> bool {
        match self.kind() {
            ObjectKind::Array => match self.state_value.get().array_length_value.get() {
                Some(state) => {
                    self.state_value.get().array_length_value.set(
                        Option::Some(
                            ArrayLengthState {
                                value,
                                writable: state.writable,
                                enumerable: state.enumerable,
                                configurable: state.configurable,
                            },
                        ),
                    );
                    true
                },
                None => false,
            },
            _ => false,
        }
    }

    fn remove_sparse_from(self: Object, minimum: u32) -> () {
        let stale: Vec[u32] = Vec::new();
        for (index, _) in self.sparse_entries() {
            if index >= minimum {
                stale.push(index)
            }
        }
        for index in stale {
            self.sparse_remove(index);
        }
    }

    pub fn array_append_dense(self: Object, value: Value) -> ArrayIndexWriteResult {
        match self.kind() {
            ObjectKind::Array => {
                let dense_len = self.state_value.get().array_dense_properties_value.len();
                let length = match self.state_value.get().array_length_value.get() {
                    Some(state) => state.value,
                    None => return ArrayIndexWriteResult::Unhandled,
                };
                if dense_len != length || !self.extensible()
                    || self.sparse_get(dense_len.to_u32()).is_some() {
                    return ArrayIndexWriteResult::Unhandled
                }
                self.state_value.get().array_dense_properties_value.push(
                    Option::Some(ArrayElement::Default(value)),
                );
                ArrayIndexWriteResult::Written
            },
            _ => ArrayIndexWriteResult::Unhandled,
        }
    }

    pub fn array_pop_fast(self: Object, size: isize) -> ArrayPopResult {
        if size <= 0 {
            return ArrayPopResult::Empty
        }
        match self.kind() {
            ObjectKind::Array => {
                let index = (size - 1).to_u32();
                let dense_index = size - 1;
                if dense_index >= self.state_value.get().array_dense_properties_value.len() {
                    return ArrayPopResult::Slow
                }
                match self.state_value.get().array_dense_properties_value[dense_index] {
                    Some(ArrayElement::Default(value)) => {
                        self.state_value.get().array_dense_properties_value[dense_index] = Option::None;
                        self.remove_sparse_from(index);
                        trim_array_dense_properties(self);
                        ArrayPopResult::Value(value)
                    },
                    _ => ArrayPopResult::Slow,
                }
            },
            _ => ArrayPopResult::Slow,
        }
    }

    pub fn array_shift_fast(self: Object, size: isize) -> ArrayShiftResult {
        if size <= 0 {
            return ArrayShiftResult::Empty
        }
        match self.kind() {
            ObjectKind::Array => {
                if size > self.state_value.get().array_dense_properties_value.len() {
                    return ArrayShiftResult::Slow
                }
                for (index, _) in self.sparse_entries() {
                    if index < size.to_u32() {
                        return ArrayShiftResult::Slow
                    }
                }
                let dense = self.state_value.get().array_dense_properties_value;
                let mut index = 0;
                while index < size {
                    match dense[index] {
                        Some(ArrayElement::Default(_)) => (),
                        _ => return ArrayShiftResult::Slow,
                    }
                    index += 1;
                }
                match dense[0] {
                    Some(ArrayElement::Default(value)) => {
                        index = 1;
                        while index < size {
                            dense[index - 1] = dense[index];
                            index += 1;
                        }
                        dense[size - 1] = Option::None;
                        self.remove_sparse_from((size - 1).to_u32());
                        trim_array_dense_properties(self);
                        ArrayShiftResult::Value(value)
                    },
                    _ => ArrayShiftResult::Slow,
                }
            },
            _ => ArrayShiftResult::Slow,
        }
    }

    fn sparse_get(self: Object, index: u32) -> Option[PropertyDescriptor] {
        match self.state_value.get().array_sparse_properties_value.get() {
            Some(map) => map.get(index),
            None => Option::None,
        }
    }

    fn sparse_set(self: Object, index: u32, descriptor: PropertyDescriptor) -> () {
        let map = match self.state_value.get().array_sparse_properties_value.get() {
            Some(map) => map,
            None => HashMap::new(),
        };
        map[index] = descriptor;
        self.state_value.get().array_sparse_properties_value.set(Option::Some(map))
    }

    fn sparse_remove(self: Object, index: u32) -> () {
        match self.state_value.get().array_sparse_properties_value.get() {
            Some(map) => {
                let _ = map.remove(index);
            },
            None => (),
        }
    }

    fn sparse_len(self: Object) -> isize {
        match self.state_value.get().array_sparse_properties_value.get() {
            Some(map) => map.len(),
            None => 0,
        }
    }

    fn sparse_entries(self: Object) -> Vec[(u32, PropertyDescriptor)] {
        match self.state_value.get().array_sparse_properties_value.get() {
            Some(map) => map.entries(),
            None => Vec::new(),
        }
    }

    fn sparse_contains(self: Object, index: u32) -> bool {
        match self.state_value.get().array_sparse_properties_value.get() {
            Some(map) => map.contains(index),
            None => false,
        }
    }

    fn private_elements_get(self: Object, name: ObjectId) -> Option[PrivateElement] {
        match self.state_value.get().private_elements_value.get() {
            Some(map) => map.get(name),
            None => Option::None,
        }
    }

    fn private_elements_set(self: Object, name: ObjectId, element: PrivateElement) -> () {
        let map = match self.state_value.get().private_elements_value.get() {
            Some(map) => map,
            None => HashMap::new(),
        };
        map[name] = element;
        self.state_value.get().private_elements_value.set(Option::Some(map))
    }

    fn private_elements_entries(self: Object) -> Vec[(ObjectId, PrivateElement)] {
        match self.state_value.get().private_elements_value.get() {
            Some(map) => map.entries(),
            None => Vec::new(),
        }
    }

    fn argument_map_get(self: Object, index: u32) -> Option[Ref[Value]] {
        match self.state_value.get().argument_map_value.get() {
            Some(map) => map.get(index),
            None => Option::None,
        }
    }

    fn argument_map_set(self: Object, index: u32, cell: Ref[Value]) -> () {
        let map = match self.state_value.get().argument_map_value.get() {
            Some(map) => map,
            None => HashMap::new(),
        };
        map[index] = cell;
        self.state_value.get().argument_map_value.set(Option::Some(map))
    }

    fn argument_map_remove(self: Object, index: u32) -> () {
        match self.state_value.get().argument_map_value.get() {
            Some(map) => {
                let _ = map.remove(index);
            },
            None => (),
        }
    }

    fn argument_map_len(self: Object) -> isize {
        match self.state_value.get().argument_map_value.get() {
            Some(map) => map.len(),
            None => 0,
        }
    }

    fn argument_map_entries(self: Object) -> Vec[(u32, Ref[Value])] {
        match self.state_value.get().argument_map_value.get() {
            Some(map) => map.entries(),
            None => Vec::new(),
        }
    }

    fn namespace_bindings_get(self: Object, key: PropertyKey) -> Option[Ref[Value]] {
        match self.state_value.get().module_namespace_bindings_value.get() {
            Some(map) => map.get(key),
            None => Option::None,
        }
    }

    fn namespace_bindings_set(self: Object, key: PropertyKey, cell: Ref[Value]) -> () {
        let map = match self.state_value.get().module_namespace_bindings_value.get() {
            Some(map) => map,
            None => HashMap::new(),
        };
        map[key] = cell;
        self.state_value.get().module_namespace_bindings_value.set(Option::Some(map))
    }

    fn namespace_bindings_len(self: Object) -> isize {
        match self.state_value.get().module_namespace_bindings_value.get() {
            Some(map) => map.len(),
            None => 0,
        }
    }

    fn namespace_bindings_entries(self: Object) -> Vec[(PropertyKey, Ref[Value])] {
        match self.state_value.get().module_namespace_bindings_value.get() {
            Some(map) => map.entries(),
            None => Vec::new(),
        }
    }

    pub fn own_property_count(self: Object) -> isize {
        let mut dense_count = 0;
        for descriptor in self.state_value.get().array_dense_properties_value {
            if descriptor.is_some() {
                dense_count += 1;
            }
        }
        self.state_value.get().properties_value.len() + dense_count + self.sparse_len()
            + if self.state_value.get().array_length_value.get().is_some() {
                1
            } else {
                0
            }
            + match self.state_value.get().typed_array_value.get() {
                Some(value) => typed_array_length(value.view),
                None => 0,
            }
    }

    pub fn private_element(self: Object, name: ObjectId) -> Option[PrivateElement] {
        self.private_elements_get(name)
    }

    pub fn primitive_value(self: Object) -> Option[Value] {
        self.state_value.get().primitive_value_value.get()
    }

    pub fn set_primitive_value(self: Object, value: Value) -> () {
        self.state_value.get().primitive_value_value.set(Option::Some(value))
    }

    pub fn is_proxy(self: Object) -> bool {
        self.state_value.get().proxy_value.get().is_some()
    }

    pub fn proxy_target(self: Object) -> Option[ObjectId] {
        match self.state_value.get().proxy_value.get() {
            Some(value) => value.target_value.get(),
            None => Option::None,
        }
    }

    pub fn proxy_handler(self: Object) -> Option[ObjectId] {
        match self.state_value.get().proxy_value.get() {
            Some(value) => value.handler_value.get(),
            None => Option::None,
        }
    }

    pub fn revoke_proxy(self: Object) -> bool {
        match self.state_value.get().proxy_value.get() {
            Some(value) => {
                value.target_value.set(Option::None);
                value.handler_value.set(Option::None);
                true
            },
            None => false,
        }
    }
}

enum HeapSlot {
    Occupied {
        generation: u64,
        object: Object,
    },
    Vacant {
        generation: u64,
        next: Option[isize],
    },
}

#[derive(Hash, PartialEq, Eq)]
enum WeakTarget {
    Object(ObjectId),
    Symbol(Symbol),
}

#[derive(Hash, PartialEq, Eq)]
struct WeakEntryKey {
    owner: ObjectId,
    target: WeakTarget,
}

struct WeakEntry {
    value: Value,
}

struct FinalizationCell {
    owner: ObjectId,
    target: Value,
    held: Value,
    token: Option[Value],
    callback: Value,
}

pub struct FinalizationJob {
    pub callback: Value,
    pub held: Value,
}

pub struct Heap {
    identity_value: Ref[bool],
    slots_value: Vec[HeapSlot],
    free_head_value: Ref[Option[isize]],
    live_count_value: Ref[isize],
    object_prototype_value: Ref[Option[ObjectId]],
    function_prototype_value: Ref[Option[ObjectId]],
    array_prototype_value: Ref[Option[ObjectId]],
    boolean_prototype_value: Ref[Option[ObjectId]],
    number_prototype_value: Ref[Option[ObjectId]],
    string_prototype_value: Ref[Option[ObjectId]],
    bigint_prototype_value: Ref[Option[ObjectId]],
    symbol_prototype_value: Ref[Option[ObjectId]],
    weak_entries_value: HashMap[WeakEntryKey, WeakEntry],
    finalization_cells_value: Vec[Option[FinalizationCell]],
    finalization_jobs_value: collections::Deque[FinalizationJob],
    environment_counter_value: Ref[u64],
    stack_pool_value: Ref[Vec[Vec[Value]]],
}

pub struct GcStats {
    pub live_before: isize,
    pub reachable: isize,
    pub collected: isize,
    pub live_after: isize,
}

pub struct GcEdge {
    pub owner: ObjectId,
    pub values: Vec[Value],
}

impl PropertyAccessCache {
    pub fn read(self: PropertyAccessCache, heap: Heap, object: ObjectId) -> Option[Value] {
        if object != self.object_value {
            let prototype = match self.receiver_prototype_value {
                Some(value) => value,
                None => return Option::None,
            };
            let receiver = match heap.get(object) {
                Some(value) => value,
                None => return Option::None,
            };
            if receiver.is_proxy() || receiver.state_value.get().module_namespace_value.get()
                || receiver.prototype() != Option::Some(prototype)
                || receiver.own_property(self.key_value).is_some() {
                return Option::None
            }
        }
        match heap.get(self.object_value) {
            Some(target) => if !target.is_proxy()
                && !target.state_value.get().module_namespace_value.get() {
                self.cell_value.get()
            } else {
                Option::None
            },
            None => Option::None,
        }
    }

    pub fn write(self: PropertyAccessCache, heap: Heap, object: ObjectId, value: Value) -> bool {
        if !self.writable_value
            || object != self.object_value && self.receiver_prototype_value.is_some() {
            return false
        }
        match self.read(heap, object) {
            Some(_) => {
                self.cell_value.set(Option::Some(value));
                true
            },
            None => false,
        }
    }
}

pub fn property_access_cache(heap: Heap, object: ObjectId, key: PropertyKey) -> Option[
    PropertyAccessCache,
] {
    match heap.get(object) {
        Some(target) => if target.is_proxy()
            || target.state_value.get().module_namespace_value.get() {
            Option::None
        } else {
            match argument_index(key) {
                Some(index) => if target.argument_map_get(index).is_some() {
                    return Option::None
                },
                None => (),
            }
            match target.state_value.get().properties_value.get(key) {
                Some(OrdinaryProperty::Default(value)) => {
                    let cell = Ref::new(Option::Some(value));
                    target.state_value.get().properties_value.insert(
                        key,
                        OrdinaryProperty::Cached(cell),
                    );
                    Option::Some(
                        PropertyAccessCache {
                            object_value: object,
                            receiver_prototype_value: Option::None,
                            key_value: key,
                            cell_value: cell,
                            writable_value: true,
                        },
                    )
                },
                Some(OrdinaryProperty::Cached(cell)) => Option::Some(
                    PropertyAccessCache {
                        object_value: object,
                        receiver_prototype_value: Option::None,
                        key_value: key,
                        cell_value: cell,
                        writable_value: true,
                    },
                ),
                Some(OrdinaryProperty::CachedDescribed { cell, writable, .. }) => Option::Some(
                    PropertyAccessCache {
                        object_value: object,
                        receiver_prototype_value: Option::None,
                        key_value: key,
                        cell_value: cell,
                        writable_value: writable,
                    },
                ),
                Some(OrdinaryProperty::Described(PropertyDescriptor::Data {
                    value,
                    writable,
                    enumerable,
                    configurable,
                })) => {
                    let cell = Ref::new(Option::Some(value));
                    target.state_value.get().properties_value.insert(
                        key,
                        OrdinaryProperty::CachedDescribed {
                            cell,
                            writable,
                            enumerable,
                            configurable,
                        },
                    );
                    Option::Some(
                        PropertyAccessCache {
                            object_value: object,
                            receiver_prototype_value: Option::None,
                            key_value: key,
                            cell_value: cell,
                            writable_value: writable,
                        },
                    )
                },
                _ => Option::None,
            }
        },
        None => Option::None,
    }
}

pub fn inherited_property_access_cache(heap: Heap, object: ObjectId, key: PropertyKey) -> Option[
    PropertyAccessCache,
] {
    let receiver = match heap.get(object) {
        Some(value) => value,
        None => return Option::None,
    };
    if receiver.is_proxy() || receiver.state_value.get().module_namespace_value.get()
        || receiver.own_property(key).is_some() {
        return Option::None
    }
    let prototype = match receiver.prototype() {
        Some(value) => value,
        None => return Option::None,
    };
    match property_access_cache(heap, prototype, key) {
        Some(cache) => Option::Some(
            PropertyAccessCache {
                object_value: prototype,
                receiver_prototype_value: Option::Some(prototype),
                key_value: key,
                cell_value: cache.cell_value,
                writable_value: cache.writable_value,
            },
        ),
        None => Option::None,
    }
}

pub fn try_fast_property_set(heap: Heap, object: ObjectId, key: PropertyKey, value: Value) -> PropertyWriteResult {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return PropertyWriteResult::Unhandled,
    };
    if target.is_proxy() || target.state_value.get().module_namespace_value.get()
        || target.state_value.get().typed_array_value.get().is_some()
        || target.argument_map_len() > 0 {
        return PropertyWriteResult::Unhandled
    }
    match target.kind() {
        ObjectKind::Array => return PropertyWriteResult::Unhandled,
        ObjectKind::Ordinary | ObjectKind::Function => (),
    }
    match target.state_value.get().properties_value.get(key) {
        Some(OrdinaryProperty::Default(_)) => {
            target.state_value.get().properties_value.insert(key, OrdinaryProperty::Default(value));
            return PropertyWriteResult::Written
        },
        Some(OrdinaryProperty::Cached(cell)) => {
            cell.set(Option::Some(value));
            return PropertyWriteResult::Written
        },
        Some(OrdinaryProperty::CachedDescribed { cell, writable, .. }) => if writable {
            cell.set(Option::Some(value));
            return PropertyWriteResult::Written
        } else {
            return PropertyWriteResult::ReadOnly
        },
        Some(OrdinaryProperty::Described(_)) => return PropertyWriteResult::Unhandled,
        None => (),
    }
    let mut cursor = target.state_value.get().prototype_value.get();
    while cursor.is_some() {
        let current = match cursor {
            Some(value) => value,
            None => break,
        };
        let candidate = match heap.get(current) {
            Some(value) => value,
            None => return PropertyWriteResult::Unhandled,
        };
        if candidate.is_proxy() {
            return PropertyWriteResult::Unhandled
        }
        match candidate.own_property(key) {
            Some(PropertyDescriptor::Data { writable: false, .. }) => {
                return PropertyWriteResult::ReadOnly
            },
            Some(PropertyDescriptor::Data { writable: true, .. }) => {
                cursor = Option::None;
            },
            Some(PropertyDescriptor::Accessor { .. }) => {
                return PropertyWriteResult::Unhandled
            },
            None => {
                cursor = candidate.state_value.get().prototype_value.get();
            },
        }
    }
    if !target.state_value.get().extensible_value.get() {
        return PropertyWriteResult::ReadOnly
    }
    target.state_value.get().properties_value.insert(key, OrdinaryProperty::Default(value));
    PropertyWriteResult::Written
}

pub fn try_define_new_default_data_property(
    heap: Heap,
    object: ObjectId,
    key: PropertyKey,
    value: Value,
) -> bool {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    if target.is_proxy() || target.state_value.get().module_namespace_value.get()
        || target.state_value.get().typed_array_value.get().is_some()
        || target.argument_map_len() > 0
        || !target.extensible()
        || target.own_property(key).is_some() {
        return false
    }
    match target.kind() {
        ObjectKind::Array => match key {
            PropertyKey::String(value) => if is_length_property_key(key)
                || canonical_array_index(value).is_some() {
                return false
            },
            PropertyKey::Symbol(_) => (),
        },
        ObjectKind::Ordinary | ObjectKind::Function => (),
    }
    target.state_value.get().properties_value.insert(key, OrdinaryProperty::Default(value));
    true
}

pub fn try_fast_copy_default_properties(heap: Heap, target: ObjectId, source: ObjectId) -> bool {
    let target_object = match heap.get(target) {
        Some(value) => value,
        None => return false,
    };
    let source_object = match heap.get(source) {
        Some(value) => value,
        None => return false,
    };
    if target_object.is_proxy() || source_object.is_proxy()
        || target_object.state_value.get().module_namespace_value.get()
        || source_object.state_value.get().module_namespace_value.get()
        || target_object.state_value.get().typed_array_value.get().is_some()
        || source_object.state_value.get().typed_array_value.get().is_some()
        || target_object.argument_map_len() > 0
        || source_object.argument_map_len() > 0
        || !target_object.state_value.get().extensible_value.get()
        || !target_object.state_value.get().properties_value.is_empty() {
        return false
    }
    match (target_object.kind(), source_object.kind()) {
        (ObjectKind::Ordinary, ObjectKind::Ordinary) => (),
        _ => return false,
    }
    let entries = source_object.state_value.get().properties_value.entries();
    let values: Vec[(PropertyKey, Value)] = Vec::with_capacity(entries.len());
    for (key, property) in entries {
        match property {
            OrdinaryProperty::Default(value) => values.push((key, value)),
            OrdinaryProperty::Cached(cell) => match cell.get() {
                Some(value) => values.push((key, value)),
                None => return false,
            },
            OrdinaryProperty::CachedDescribed { .. } => return false,
            OrdinaryProperty::Described(_) => return false,
        }
    }
    target_object.state_value.get().properties_value.reserve(values.len());
    for (key, value) in values {
        target_object.state_value.get().properties_value.insert(
            key,
            OrdinaryProperty::Default(value),
        );
    }
    true
}

fn object_is_callable(kind: ObjectKind) -> bool {
    match kind {
        ObjectKind::Function => true,
        ObjectKind::Ordinary | ObjectKind::Array => false,
    }
}

fn make_object(kind: ObjectKind, prototype: Option[ObjectId]) -> Object {
    Object {
        state_value: Ref::new(
            ObjectState {
                kind_value: kind,
                prototype_value: Ref::new(prototype),
                immutable_prototype_value: Ref::new(false),
                extensible_value: Ref::new(true),
                properties_value: collections::IndexMap::new(),
                array_length_value: Ref::new(Option::None),
                array_dense_properties_value: Vec::new(),
                array_sparse_properties_value: Ref::new(Option::None),
                private_elements_value: Ref::new(Option::None),
                primitive_value_value: Ref::new(Option::None),
                argument_map_value: Ref::new(Option::None),
                module_namespace_bindings_value: Ref::new(Option::None),
                module_namespace_value: Ref::new(false),
                typed_array_value: Ref::new(Option::None),
                proxy_value: Ref::new(Option::None),
            },
        ),
    }
}

fn enqueue_object(
    heap: Heap,
    id: ObjectId,
    marked: collections::BitSet,
    pending: collections::Stack[ObjectId],
) -> () {
    if heap.identity_value == id.heap_identity_value && id.slot_value >= 0
        && id.slot_value < heap.slots_value.len()
        && !marked.contains(id.slot_value) {
        match heap.slots_value.get(id.slot_value) {
            HeapSlot::Occupied { generation, .. } => if generation == id.generation_value {
                let _ = marked.insert(id.slot_value);
                pending.push(id)
            },
            HeapSlot::Vacant { .. } => (),
        }
    }
}

fn enqueue_value(
    heap: Heap,
    value: Value,
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    pending: collections::Stack[ObjectId],
) -> () {
    match value {
        Value::Object(id) => enqueue_object(heap, id, marked, pending),
        Value::Symbol(value) => {
            symbols.insert(value.id());
        },
        _ => (),
    }
}

fn enqueue_optional_value(
    heap: Heap,
    value: Option[Value],
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    pending: collections::Stack[ObjectId],
) -> () {
    match value {
        Some(value) => enqueue_value(heap, value, marked, symbols, pending),
        None => (),
    }
}

fn enqueue_descriptor(
    heap: Heap,
    descriptor: PropertyDescriptor,
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    pending: collections::Stack[ObjectId],
) -> () {
    match descriptor {
        PropertyDescriptor::Data { value, .. } => enqueue_value(
            heap,
            value,
            marked,
            symbols,
            pending,
        ),
        PropertyDescriptor::Accessor { get, set, .. } => {
            enqueue_optional_value(heap, get, marked, symbols, pending);
            enqueue_optional_value(heap, set, marked, symbols, pending)
        },
    }
}

fn enqueue_private_element(
    heap: Heap,
    element: PrivateElement,
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    pending: collections::Stack[ObjectId],
) -> () {
    match element {
        PrivateElement::Field(value) | PrivateElement::Method(value) => {
            enqueue_value(heap, value, marked, symbols, pending)
        },
        PrivateElement::Accessor { get, set } => {
            enqueue_optional_value(heap, get, marked, symbols, pending);
            enqueue_optional_value(heap, set, marked, symbols, pending)
        },
    }
}

fn drain_pending(
    heap: Heap,
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    pending: collections::Stack[ObjectId],
) -> () {
    while !pending.is_empty() {
        let current = match pending.pop() {
            Some(value) => value,
            None => continue,
        };
        match heap.get(current) {
            Some(object) => {
                match object.state_value.get().prototype_value.get() {
                    Some(prototype) => enqueue_object(heap, prototype, marked, pending),
                    None => (),
                }
                for (key, property) in object.state_value.get().properties_value.entries() {
                    match key {
                        PropertyKey::Symbol(value) => {
                            symbols.insert(value.id());
                        },
                        PropertyKey::String(_) => (),
                    }
                    match property {
                        OrdinaryProperty::Default(value) => {
                            enqueue_value(heap, value, marked, symbols, pending)
                        },
                        OrdinaryProperty::Cached(cell) => {
                            enqueue_optional_value(heap, cell.get(), marked, symbols, pending)
                        },
                        OrdinaryProperty::CachedDescribed { cell, .. } => {
                            enqueue_optional_value(heap, cell.get(), marked, symbols, pending)
                        },
                        OrdinaryProperty::Described(descriptor) => {
                            enqueue_descriptor(heap, descriptor, marked, symbols, pending)
                        },
                    }
                }
                for descriptor in object.state_value.get().array_dense_properties_value {
                    match descriptor {
                        Some(ArrayElement::Default(value)) => {
                            enqueue_value(heap, value, marked, symbols, pending)
                        },
                        Some(ArrayElement::Described(value)) => {
                            enqueue_descriptor(heap, value, marked, symbols, pending)
                        },
                        None => (),
                    }
                }
                for (_, descriptor) in object.sparse_entries() {
                    enqueue_descriptor(heap, descriptor, marked, symbols, pending)
                }
                for (name, element) in object.private_elements_entries() {
                    enqueue_object(heap, name, marked, pending);
                    enqueue_private_element(heap, element, marked, symbols, pending)
                }
                enqueue_optional_value(
                    heap,
                    object.state_value.get().primitive_value_value.get(),
                    marked,
                    symbols,
                    pending,
                );
                for (_, cell) in object.argument_map_entries() {
                    enqueue_value(heap, cell.get(), marked, symbols, pending)
                }
                for (_, cell) in object.namespace_bindings_entries() {
                    enqueue_value(heap, cell.get(), marked, symbols, pending)
                }
                match object.state_value.get().typed_array_value.get() {
                    Some(value) => enqueue_object(heap, value.buffer_object, marked, pending),
                    None => (),
                }
                match object.state_value.get().proxy_value.get() {
                    Some(value) => {
                        match value.target_value.get() {
                            Some(target) => enqueue_object(heap, target, marked, pending),
                            None => (),
                        }
                        match value.handler_value.get() {
                            Some(handler) => enqueue_object(heap, handler, marked, pending),
                            None => (),
                        }
                    },
                    None => (),
                }
            },
            None => (),
        }
    }
}

fn marked_object(heap: Heap, id: ObjectId, marked: collections::BitSet) -> bool {
    if heap.identity_value != id.heap_identity_value || id.slot_value < 0
        || id.slot_value >= heap.slots_value.len()
        || !marked.contains(id.slot_value) {
        false
    } else {
        match heap.slots_value[id.slot_value] {
            HeapSlot::Occupied { generation, .. } => generation == id.generation_value,
            HeapSlot::Vacant { .. } => false,
        }
    }
}

fn marked_weak_key(
    heap: Heap,
    value: Value,
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
) -> bool {
    match value {
        Value::Object(object) => marked_object(heap, object, marked),
        Value::Symbol(value) => symbols.contains(value.id()),
        _ => false,
    }
}

fn enqueue_conditional_value(
    heap: Heap,
    value: Value,
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    pending: collections::Stack[ObjectId],
) -> bool {
    match value {
        Value::Object(object) => if marked_object(heap, object, marked) {
            false
        } else {
            enqueue_object(heap, object, marked, pending);
            marked_object(heap, object, marked)
        },
        Value::Symbol(value) => symbols.insert(value.id()),
        _ => false,
    }
}

fn mark_conditional_edges(
    heap: Heap,
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    pending: collections::Stack[ObjectId],
    edges: Vec[GcEdge],
) -> () {
    let mut changed = true;
    while changed {
        changed = false;
        for edge in edges {
            if marked_object(heap, edge.owner, marked) {
                for value in edge.values {
                    changed = enqueue_conditional_value(heap, value, marked, symbols, pending)
                        || changed;
                }
            }
        }
        for (key, entry) in heap.weak_entries_value.entries() {
            if marked_object(heap, key.owner, marked)
                && marked_weak_key(heap, weak_target_value(key.target), marked, symbols) {
                changed = enqueue_conditional_value(heap, entry.value, marked, symbols, pending)
                    || changed;
            }
        }
        for candidate in heap.finalization_cells_value {
            match candidate {
                Some(cell) => if marked_object(heap, cell.owner, marked) {
                    changed = enqueue_conditional_value(heap, cell.held, marked, symbols, pending)
                        || changed;
                    changed = enqueue_conditional_value(
                        heap,
                        cell.callback,
                        marked,
                        symbols,
                        pending,
                    )
                        || changed;
                },
                None => (),
            }
        }
        drain_pending(heap, marked, symbols, pending)
    }
}

fn mark_reachable(
    heap: Heap,
    roots: Vec[Value],
    marked: collections::BitSet,
    symbols: collections::HashSet[u64],
    edges: Vec[GcEdge],
) -> isize {
    let pending: collections::Stack[ObjectId] = collections::Stack::new();
    for root in roots {
        enqueue_value(heap, root, marked, symbols, pending)
    }
    drain_pending(heap, marked, symbols, pending);
    mark_conditional_edges(heap, marked, symbols, pending, edges);
    marked.len()
}

impl Heap {
    pub fn new() -> Heap {
        Heap {
            identity_value: Ref::new(false),
            slots_value: Vec::new(),
            free_head_value: Ref::new(Option::None),
            live_count_value: Ref::new(0),
            object_prototype_value: Ref::new(Option::None),
            function_prototype_value: Ref::new(Option::None),
            array_prototype_value: Ref::new(Option::None),
            boolean_prototype_value: Ref::new(Option::None),
            number_prototype_value: Ref::new(Option::None),
            string_prototype_value: Ref::new(Option::None),
            bigint_prototype_value: Ref::new(Option::None),
            symbol_prototype_value: Ref::new(Option::None),
            weak_entries_value: HashMap::new(),
            finalization_cells_value: Vec::new(),
            finalization_jobs_value: collections::Deque::new(),
            environment_counter_value: Ref::new(0),
            stack_pool_value: Ref::new(Vec::new()),
        }
    }

    pub fn stack_pool(self: Heap) -> Ref[Vec[Vec[Value]]] {
        self.stack_pool_value
    }

    pub fn next_environment_identity(self: Heap) -> u64 {
        let next = self.environment_counter_value.get() + 1;
        self.environment_counter_value.set(next);
        next
    }

    fn make_id(self: Heap, slot: isize, generation: u64, callable: bool) -> ObjectId {
        ObjectId {
            heap_identity_value: self.identity_value,
            slot_value: slot,
            generation_value: generation,
            callable_value: callable,
        }
    }

    fn append(self: Heap, object: Object, callable: bool) -> ObjectId {
        let slot = self.slots_value.len();
        self.slots_value.push(HeapSlot::Occupied { generation: 0, object });
        self.live_count_value.set(self.live_count_value.get() + 1);
        self.make_id(slot, 0, callable)
    }

    fn allocate_validated(self: Heap, kind: ObjectKind, prototype: Option[ObjectId]) -> ObjectId {
        let callable = object_is_callable(kind);
        let object = make_object(kind, prototype);
        match self.free_head_value.get() {
            Some(slot) => if slot >= 0 && slot < self.slots_value.len() {
                match self.slots_value.get(slot) {
                    HeapSlot::Vacant { generation, next } => {
                        self.slots_value.set(slot, HeapSlot::Occupied { generation, object });
                        self.free_head_value.set(next);
                        self.live_count_value.set(self.live_count_value.get() + 1);
                        self.make_id(slot, generation, callable)
                    },
                    HeapSlot::Occupied { .. } => {
                        self.free_head_value.set(Option::None);
                        self.append(object, callable)
                    },
                }
            } else {
                self.free_head_value.set(Option::None);
                self.append(object, callable)
            },
            None => self.append(object, callable),
        }
    }

    pub fn allocate(self: Heap, kind: ObjectKind, prototype: Option[ObjectId]) -> Result[
        ObjectId,
        TypeError,
    ] {
        match prototype {
            Some(value) => if self.contains(value) {
                Result::Ok(self.allocate_validated(kind, Option::Some(value)))
            } else {
                Result::Err(TypeError { message: "prototype does not belong to this heap" })
            },
            None => Result::Ok(self.allocate_validated(kind, Option::None)),
        }
    }

    pub fn contains(self: Heap, id: ObjectId) -> bool {
        if self.identity_value != id.heap_identity_value || id.slot_value < 0
            || id.slot_value >= self.slots_value.len() {
            false
        } else {
            match self.slots_value.get(id.slot_value) {
                HeapSlot::Occupied { generation, .. } => generation == id.generation_value,
                HeapSlot::Vacant { .. } => false,
            }
        }
    }

    pub fn get(self: Heap, id: ObjectId) -> Option[Object] {
        if self.identity_value != id.heap_identity_value || id.slot_value < 0
            || id.slot_value >= self.slots_value.len() {
            Option::None
        } else {
            match self.slots_value.get(id.slot_value) {
                HeapSlot::Occupied { generation, object } => if generation == id.generation_value {
                    Option::Some(object)
                } else {
                    Option::None
                },
                HeapSlot::Vacant { .. } => Option::None,
            }
        }
    }

    pub fn free(self: Heap, id: ObjectId) -> bool {
        if !self.contains(id) {
            false
        } else {
            let generation = match self.slots_value.get(id.slot_value) {
                HeapSlot::Occupied { generation, .. } => generation,
                HeapSlot::Vacant { generation, .. } => generation,
            };
            self.slots_value.set(
                id.slot_value,
                HeapSlot::Vacant { generation: generation + 1, next: self.free_head_value.get() },
            );
            self.free_head_value.set(Option::Some(id.slot_value));
            self.live_count_value.set(self.live_count_value.get() - 1);
            true
        }
    }

    pub fn live_count(self: Heap) -> isize {
        self.live_count_value.get()
    }

    pub fn slot_count(self: Heap) -> isize {
        self.slots_value.len()
    }

    pub fn array_prototype(self: Heap) -> Option[ObjectId] {
        self.array_prototype_value.get()
    }

    pub fn primitive_prototype(self: Heap, kind: PrimitivePrototypeKind) -> Option[ObjectId] {
        match kind {
            PrimitivePrototypeKind::Boolean => self.boolean_prototype_value.get(),
            PrimitivePrototypeKind::Number => self.number_prototype_value.get(),
            PrimitivePrototypeKind::String => self.string_prototype_value.get(),
            PrimitivePrototypeKind::BigInt => self.bigint_prototype_value.get(),
            PrimitivePrototypeKind::Symbol => self.symbol_prototype_value.get(),
        }
    }

    pub fn set_primitive_prototype(self: Heap, kind: PrimitivePrototypeKind, prototype: ObjectId) -> bool {
        if !self.contains(prototype) {
            false
        } else {
            match kind {
                PrimitivePrototypeKind::Boolean => {
                    self.boolean_prototype_value.set(Option::Some(prototype))
                },
                PrimitivePrototypeKind::Number => {
                    self.number_prototype_value.set(Option::Some(prototype))
                },
                PrimitivePrototypeKind::String => {
                    self.string_prototype_value.set(Option::Some(prototype))
                },
                PrimitivePrototypeKind::BigInt => {
                    self.bigint_prototype_value.set(Option::Some(prototype))
                },
                PrimitivePrototypeKind::Symbol => {
                    self.symbol_prototype_value.set(Option::Some(prototype))
                },
            }
            true
        }
    }

    pub fn object_prototype(self: Heap) -> Option[ObjectId] {
        self.object_prototype_value.get()
    }

    pub fn set_object_prototype(self: Heap, prototype: ObjectId) -> bool {
        if self.contains(prototype) {
            self.object_prototype_value.set(Option::Some(prototype));
            true
        } else {
            false
        }
    }

    pub fn function_prototype(self: Heap) -> Option[ObjectId] {
        self.function_prototype_value.get()
    }

    pub fn set_function_prototype(self: Heap, prototype: ObjectId) -> bool {
        if self.contains(prototype) && prototype.is_callable() {
            self.function_prototype_value.set(Option::Some(prototype));
            true
        } else {
            false
        }
    }

    pub fn set_array_prototype(self: Heap, prototype: ObjectId) -> bool {
        if self.contains(prototype) {
            self.array_prototype_value.set(Option::Some(prototype));
            true
        } else {
            false
        }
    }

    pub fn collect(self: Heap, roots: Vec[Value]) -> GcStats {
        let edges: Vec[GcEdge] = Vec::new();
        self.collect_with_edges(roots, edges)
    }

    pub fn collect_with_edges(self: Heap, roots: Vec[Value], edges: Vec[GcEdge]) -> GcStats {
        let live_before = self.live_count_value.get();
        let marked = collections::BitSet::new();
        let all_roots = roots;
        match self.object_prototype_value.get() {
            Some(value) => all_roots.push(Value::Object(value)),
            None => (),
        }
        match self.function_prototype_value.get() {
            Some(value) => all_roots.push(Value::Object(value)),
            None => (),
        }
        match self.array_prototype_value.get() {
            Some(value) => all_roots.push(Value::Object(value)),
            None => (),
        }
        for prototype in Vec::from_array(
            [
                self.boolean_prototype_value,
                self.number_prototype_value,
                self.string_prototype_value,
                self.bigint_prototype_value,
                self.symbol_prototype_value,
            ],
        ) {
            match prototype.get() {
                Some(value) => all_roots.push(Value::Object(value)),
                None => (),
            }
        }
        let mut finalization_job_index = 0;
        while finalization_job_index < self.finalization_jobs_value.len() {
            match self.finalization_jobs_value.get(finalization_job_index) {
                Some(job) => {
                    all_roots.push(job.callback);
                    all_roots.push(job.held)
                },
                None => (),
            }
            finalization_job_index += 1;
        }
        let marked_symbols: collections::HashSet[u64] = collections::HashSet::new();
        let reachable = mark_reachable(self, all_roots, marked, marked_symbols, edges);
        let mut finalization_index = 0;
        while finalization_index < self.finalization_cells_value.len() {
            match self.finalization_cells_value[finalization_index] {
                Some(cell) => if !marked_object(self, cell.owner, marked) {
                    self.finalization_cells_value[finalization_index] = Option::None;
                } else if !marked_weak_key(self, cell.target, marked, marked_symbols) {
                    self.finalization_jobs_value.push_back(
                        FinalizationJob { callback: cell.callback, held: cell.held },
                    );
                    self.finalization_cells_value[finalization_index] = Option::None;
                } else {
                    let token = match cell.token {
                        Some(value) => if marked_weak_key(self, value, marked, marked_symbols) {
                            Option::Some(value)
                        } else {
                            Option::None
                        },
                        None => Option::None,
                    };
                    self.finalization_cells_value[finalization_index] = Option::Some(
                        FinalizationCell {
                            owner: cell.owner,
                            target: cell.target,
                            held: cell.held,
                            token,
                            callback: cell.callback,
                        },
                    );
                },
                None => (),
            }
            finalization_index += 1;
        }
        let mut collected = 0;
        let mut slot = 0;
        while slot < self.slots_value.len() {
            if !marked.contains(slot) {
                match self.slots_value.get(slot) {
                    HeapSlot::Occupied { generation, .. } => {
                        self.slots_value.set(
                            slot,
                            HeapSlot::Vacant {
                                generation: generation + 1,
                                next: self.free_head_value.get(),
                            },
                        );
                        self.free_head_value.set(Option::Some(slot));
                        collected += 1;
                    },
                    HeapSlot::Vacant { .. } => (),
                }
            }
            slot += 1;
        }
        self.live_count_value.set(reachable);
        for (key, _) in self.weak_entries_value.entries() {
            if !self.contains(key.owner)
                || !marked_weak_key(self, weak_target_value(key.target), marked, marked_symbols) {
                self.weak_entries_value.remove(key);
            }
        }
        GcStats { live_before, reachable, collected, live_after: reachable }
    }
}

fn weak_target(heap: Heap, value: Value) -> Option[WeakTarget] {
    match value {
        Value::Object(object) => if heap.contains(object) {
            Option::Some(WeakTarget::Object(object))
        } else {
            Option::None
        },
        Value::Symbol(symbol) => if !symbol.is_registered() {
            Option::Some(WeakTarget::Symbol(symbol))
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn weak_target_value(target: WeakTarget) -> Value {
    match target {
        WeakTarget::Object(object) => Value::Object(object),
        WeakTarget::Symbol(symbol) => Value::Symbol(symbol),
    }
}

fn weak_key_live(heap: Heap, value: Value) -> bool {
    weak_target(heap, value).is_some()
}

pub fn is_weak_target(heap: Heap, value: Value) -> bool {
    weak_key_live(heap, value)
}

fn weak_entry_key(heap: Heap, owner: ObjectId, value: Value) -> Option[WeakEntryKey] {
    if !heap.contains(owner) {
        Option::None
    } else {
        match weak_target(heap, value) {
            Some(target) => Option::Some(WeakEntryKey { owner, target }),
            None => Option::None,
        }
    }
}

pub fn weak_map_set(heap: Heap, owner: ObjectId, key: Value, value: Value) -> bool {
    match weak_entry_key(heap, owner, key) {
        Some(entry_key) => {
            heap.weak_entries_value.set(entry_key, WeakEntry { value });
            true
        },
        None => false,
    }
}

pub fn weak_map_get(heap: Heap, owner: ObjectId, key: Value) -> Option[Value] {
    match weak_entry_key(heap, owner, key) {
        Some(entry_key) => match heap.weak_entries_value.get(entry_key) {
            Some(entry) => Option::Some(entry.value),
            None => Option::None,
        },
        None => Option::None,
    }
}

pub fn weak_map_has(heap: Heap, owner: ObjectId, key: Value) -> bool {
    match weak_entry_key(heap, owner, key) {
        Some(entry_key) => heap.weak_entries_value.contains(entry_key),
        None => false,
    }
}

pub fn weak_map_delete(heap: Heap, owner: ObjectId, key: Value) -> bool {
    match weak_entry_key(heap, owner, key) {
        Some(entry_key) => heap.weak_entries_value.remove_value(entry_key).is_some(),
        None => false,
    }
}

pub fn weak_set_add(heap: Heap, owner: ObjectId, key: Value) -> bool {
    weak_map_set(heap, owner, key, Value::Undefined)
}

pub fn weak_set_has(heap: Heap, owner: ObjectId, key: Value) -> bool {
    weak_map_has(heap, owner, key)
}

pub fn weak_set_delete(heap: Heap, owner: ObjectId, key: Value) -> bool {
    weak_map_delete(heap, owner, key)
}

pub fn weak_ref_set(heap: Heap, owner: ObjectId, target: Value) -> bool {
    weak_map_set(heap, owner, target, Value::Undefined)
}

pub fn weak_ref_deref(heap: Heap, owner: ObjectId) -> Option[Value] {
    if !heap.contains(owner) {
        Option::None
    } else {
        for (key, _) in heap.weak_entries_value.entries() {
            if key.owner == owner {
                let target = weak_target_value(key.target);
                if weak_target(heap, target).is_some() {
                    return Option::Some(target)
                }
            }
        }
        Option::None
    }
}

pub fn finalization_register(
    heap: Heap,
    owner: ObjectId,
    callback: Value,
    target: Value,
    held: Value,
    token: Option[Value],
) -> bool {
    let callable = match callback {
        Value::Object(object) => object.is_callable() && heap.contains(object),
        _ => false,
    };
    let token_valid = match token {
        Some(value) => weak_key_live(heap, value),
        None => true,
    };
    if !heap.contains(owner) || !callable || !weak_key_live(heap, target)
        || same_value(target, held)
        || !token_valid {
        false
    } else {
        heap.finalization_cells_value.push(
            Option::Some(FinalizationCell { owner, target, held, token, callback }),
        );
        true
    }
}

pub fn finalization_unregister(heap: Heap, owner: ObjectId, token: Value) -> Option[bool] {
    if !heap.contains(owner) || !weak_key_live(heap, token) {
        Option::None
    } else {
        let mut removed = false;
        let mut index = 0;
        while index < heap.finalization_cells_value.len() {
            match heap.finalization_cells_value[index] {
                Some(cell) => if cell.owner == owner {
                    match cell.token {
                        Some(candidate) => if weak_key_live(heap, candidate)
                            && same_value(candidate, token) {
                            heap.finalization_cells_value[index] = Option::None;
                            removed = true;
                        },
                        None => (),
                    }
                },
                None => (),
            }
            index += 1;
        }
        Option::Some(removed)
    }
}

pub fn take_finalization_jobs(heap: Heap) -> Vec[FinalizationJob] {
    let jobs: Vec[FinalizationJob] = Vec::with_capacity(heap.finalization_jobs_value.len());
    while let Some(job) = heap.finalization_jobs_value.pop_front() {
        jobs.push(job)
    }
    jobs
}

pub fn pop_finalization_job(heap: Heap) -> Option[FinalizationJob] {
    heap.finalization_jobs_value.pop_front()
}

pub fn new_object(heap: Heap, kind: ObjectKind, prototype: Option[ObjectId]) -> Result[
    ObjectId,
    TypeError,
] {
    heap.allocate(kind, prototype)
}

pub fn new_proxy(heap: Heap, target: ObjectId, handler: ObjectId) -> Result[ObjectId, TypeError] {
    if !heap.contains(target) || !heap.contains(handler) {
        return Result::Err(TypeError { message: "proxy target and handler must be live objects" })
    }
    let (kind, prototype) = match heap.get(target) {
        Some(value) => (value.kind(), value.prototype()),
        None => return Result::Err(TypeError { message: "proxy target is invalid" }),
    };
    let proxy = new_object(heap, kind, prototype)?;
    match heap.get(proxy) {
        Some(value) => {
            value.state_value.get().proxy_value.set(
                Option::Some(
                    ProxyData {
                        target_value: Ref::new(Option::Some(target)),
                        handler_value: Ref::new(Option::Some(handler)),
                    },
                ),
            );
            Result::Ok(proxy)
        },
        None => Result::Err(TypeError { message: "proxy allocation failed" }),
    }
}

pub fn revoke_proxy(heap: Heap, proxy: ObjectId) -> bool {
    match heap.get(proxy) {
        Some(value) => value.revoke_proxy(),
        None => false,
    }
}

pub fn register_typed_array(
    heap: Heap,
    object: ObjectId,
    view: TypedArrayView,
    buffer_object: ObjectId,
) -> bool {
    if !heap.contains(buffer_object) {
        false
    } else {
        match heap.get(object) {
            Some(target) => {
                target.state_value.get().typed_array_value.set(
                    Option::Some(TypedArrayState { view, buffer_object }),
                );
                true
            },
            None => false,
        }
    }
}

pub fn is_typed_array(heap: Heap, object: ObjectId) -> bool {
    match heap.get(object) {
        Some(value) => value.state_value.get().typed_array_value.get().is_some(),
        None => false,
    }
}

pub fn typed_array_element_length(heap: Heap, object: ObjectId) -> Option[isize] {
    match heap.get(object) {
        Some(value) => match value.state_value.get().typed_array_value.get() {
            Some(value) => Option::Some(typed_array_length(value.view)),
            None => Option::None,
        },
        None => Option::None,
    }
}

pub fn typed_array_view(heap: Heap, object: ObjectId) -> Option[TypedArrayView] {
    match heap.get(object) {
        Some(value) => value.typed_array_view(),
        None => Option::None,
    }
}

pub fn typed_array_buffer_object(heap: Heap, object: ObjectId) -> Option[ObjectId] {
    match heap.get(object) {
        Some(value) => match value.state_value.get().typed_array_value.get() {
            Some(value) => Option::Some(value.buffer_object),
            None => Option::None,
        },
        None => Option::None,
    }
}

pub fn is_shared_typed_array(heap: Heap, object: ObjectId) -> bool {
    match typed_array_view(heap, object) {
        Some(TypedArrayView::Uint8(value)) => value.buffer().is_shared(),
        Some(TypedArrayView::Int32(value)) => value.buffer().is_shared(),
        Some(TypedArrayView::Float64(value)) => value.buffer().is_shared(),
        Some(TypedArrayView::Numeric(value)) => value.buffer().is_shared(),
        Some(TypedArrayView::BigInt(value)) => value.buffer().is_shared(),
        None => false,
    }
}

pub fn is_typed_array_backed_by_variable_length_buffer(heap: Heap, object: ObjectId) -> bool {
    match typed_array_view(heap, object) {
        Some(TypedArrayView::Uint8(value)) => {
            value.buffer().is_resizable() || value.buffer().is_growable()
        },
        Some(TypedArrayView::Int32(value)) => {
            value.buffer().is_resizable() || value.buffer().is_growable()
        },
        Some(TypedArrayView::Float64(value)) => {
            value.buffer().is_resizable() || value.buffer().is_growable()
        },
        Some(TypedArrayView::Numeric(value)) => {
            value.buffer().is_resizable() || value.buffer().is_growable()
        },
        Some(TypedArrayView::BigInt(value)) => {
            value.buffer().is_resizable() || value.buffer().is_growable()
        },
        None => false,
    }
}

pub fn is_typed_array_detached(heap: Heap, object: ObjectId) -> bool {
    match heap.get(object) {
        Some(target) => match target.state_value.get().typed_array_value.get() {
            Some(value) => match value.view {
                TypedArrayView::Uint8(view) => view.buffer().is_detached(),
                TypedArrayView::Int32(view) => view.buffer().is_detached(),
                TypedArrayView::Float64(view) => view.buffer().is_detached(),
                TypedArrayView::Numeric(view) => view.buffer().is_detached(),
                TypedArrayView::BigInt(view) => view.buffer().is_detached(),
            },
            None => false,
        },
        None => false,
    }
}

pub fn is_typed_array_out_of_bounds(heap: Heap, object: ObjectId) -> bool {
    match typed_array_view(heap, object) {
        Some(TypedArrayView::Uint8(value)) => value.is_out_of_bounds(),
        Some(TypedArrayView::Int32(value)) => value.is_out_of_bounds(),
        Some(TypedArrayView::Float64(value)) => value.is_out_of_bounds(),
        Some(TypedArrayView::Numeric(value)) => value.is_out_of_bounds(),
        Some(TypedArrayView::BigInt(value)) => value.is_out_of_bounds(),
        None => false,
    }
}

pub fn is_typed_array_length_tracking(heap: Heap, object: ObjectId) -> bool {
    match typed_array_view(heap, object) {
        Some(TypedArrayView::Uint8(value)) => value.is_length_tracking(),
        Some(TypedArrayView::Int32(value)) => value.is_length_tracking(),
        Some(TypedArrayView::Float64(value)) => value.is_length_tracking(),
        Some(TypedArrayView::Numeric(value)) => value.is_length_tracking(),
        Some(TypedArrayView::BigInt(value)) => value.is_length_tracking(),
        None => false,
    }
}

pub fn is_typed_array_numeric_property(heap: Heap, object: ObjectId, key: PropertyKey) -> bool {
    match heap.get(object) {
        Some(value) => value.state_value.get().typed_array_value.get().is_some()
            && typed_array_numeric_index(key).is_some(),
        None => false,
    }
}

pub fn is_bigint_typed_array(heap: Heap, object: ObjectId) -> bool {
    match heap.get(object) {
        Some(target) => match target.state_value.get().typed_array_value.get() {
            Some(value) => match value.view {
                TypedArrayView::BigInt(_) => true,
                _ => false,
            },
            None => false,
        },
        None => false,
    }
}

pub fn is_typed_array_valid_numeric_property(heap: Heap, object: ObjectId, key: PropertyKey) -> bool {
    match heap.get(object) {
        Some(target) => match target.state_value.get().typed_array_value.get() {
            Some(value) => match typed_array_numeric_index(key) {
                Some(TypedArrayNumericIndex::Index(index)) => {
                    typed_array_element(value.view, index).is_some()
                },
                _ => false,
            },
            None => false,
        },
        None => false,
    }
}

pub fn new_ordinary_object(heap: Heap, prototype: Option[ObjectId]) -> Result[ObjectId, TypeError] {
    new_object(
        heap,
        ObjectKind::Ordinary,
        match prototype {
            Some(value) => Option::Some(value),
            None => heap.object_prototype(),
        },
    )
}

pub fn new_null_prototype_object(heap: Heap) -> Result[ObjectId, TypeError] {
    new_object(heap, ObjectKind::Ordinary, Option::None)
}

fn array_length_value(length: isize) -> Value {
    if length <= 2147483647 {
        Value::Int(length.to_i32())
    } else {
        Value::Float(num::parse_float64_structured(length.to_string()).unwrap_or(0.0))
    }
}

pub fn new_array(heap: Heap, length: isize) -> Result[ObjectId, TypeError] {
    if length < 0 || length > 4294967295 {
        return Result::Err(TypeError { message: "invalid array length" })
    }
    let object = new_object(heap, ObjectKind::Array, heap.array_prototype())?;
    if define_own_property(
        heap,
        object,
        string_property_key("length"),
        data_descriptor(array_length_value(length), true, false, false),
    ) {
        Result::Ok(object)
    } else {
        let _ = heap.free(object);
        Result::Err(TypeError { message: "cannot define array length" })
    }
}

pub fn new_array_with_values(heap: Heap, values: Vec[Value], length: isize) -> Result[
    ObjectId,
    TypeError,
] {
    let object = new_array(heap, length)?;
    let target = match heap.get(object) {
        Some(value) => value,
        None => return Result::Err(TypeError { message: "cannot initialize array" }),
    };
    if values.len() > length {
        if values.len() > 4294967295 {
            let _ = heap.free(object);
            return Result::Err(TypeError { message: "invalid array length" })
        }
        match target.state_value.get().array_length_value.get() {
            Some(state) => target.state_value.get().array_length_value.set(
                Option::Some(
                    ArrayLengthState {
                        value: values.len(),
                        writable: state.writable,
                        enumerable: state.enumerable,
                        configurable: state.configurable,
                    },
                ),
            ),
            None => {
                let _ = heap.free(object);
                return Result::Err(TypeError { message: "cannot initialize array" })
            },
        }
    }
    target.state_value.get().array_dense_properties_value.reserve(values.len());
    for value in values {
        target.state_value.get().array_dense_properties_value.push(
            Option::Some(ArrayElement::Default(value)),
        )
    }
    Result::Ok(object)
}

pub fn primitive_value(heap: Heap, object: ObjectId) -> Option[Value] {
    match heap.get(object) {
        Some(value) => value.primitive_value(),
        None => Option::None,
    }
}

pub fn set_primitive_value(heap: Heap, object: ObjectId, value: Value) -> bool {
    match heap.get(object) {
        Some(target) => {
            target.set_primitive_value(value);
            true
        },
        None => false,
    }
}

pub fn new_tdz_value(heap: Heap) -> Result[Value, TypeError] {
    let object = new_null_prototype_object(heap)?;
    if set_primitive_value(heap, object, Value::Undefined) {
        Result::Ok(Value::Object(object))
    } else {
        Result::Err(TypeError { message: "cannot initialize lexical binding" })
    }
}

pub fn is_tdz_value(heap: Heap, value: Value) -> bool {
    match value {
        Value::Object(object) => match primitive_value(heap, object) {
            Some(Value::Undefined) => true,
            _ => false,
        },
        _ => false,
    }
}

pub fn map_argument_index(heap: Heap, object: ObjectId, index: u32, cell: Ref[Value]) -> bool {
    match heap.get(object) {
        Some(target) => {
            target.argument_map_set(index, cell);
            true
        },
        None => false,
    }
}

pub fn data_descriptor(value: Value, writable: bool, enumerable: bool, configurable: bool) -> PropertyDescriptor {
    PropertyDescriptor::Data { value, writable, enumerable, configurable }
}

fn ordinary_property_from_descriptor(descriptor: PropertyDescriptor) -> OrdinaryProperty {
    match descriptor {
        PropertyDescriptor::Data { value, writable: true, enumerable: true, configurable: true } => {
            OrdinaryProperty::Default(value)
        },
        _ => OrdinaryProperty::Described(descriptor),
    }
}

fn ordinary_property_descriptor(property: OrdinaryProperty) -> PropertyDescriptor {
    match property {
        OrdinaryProperty::Default(value) => data_descriptor(value, true, true, true),
        OrdinaryProperty::Cached(cell) => {
            data_descriptor(cell.get().unwrap_or(Value::Undefined), true, true, true)
        },
        OrdinaryProperty::CachedDescribed { cell, writable, enumerable, configurable } => {
            data_descriptor(
                cell.get().unwrap_or(Value::Undefined),
                writable,
                enumerable,
                configurable,
            )
        },
        OrdinaryProperty::Described(descriptor) => descriptor,
    }
}

fn invalidate_ordinary_property(property: OrdinaryProperty) -> () {
    match property {
        OrdinaryProperty::Cached(cell) | OrdinaryProperty::CachedDescribed { cell, .. } => {
            cell.set(Option::None)
        },
        _ => (),
    }
}

pub fn accessor_descriptor(
    get: Option[Value],
    set: Option[Value],
    enumerable: bool,
    configurable: bool,
) -> PropertyDescriptor {
    PropertyDescriptor::Accessor { get, set, enumerable, configurable }
}

pub fn descriptor_enumerable(value: PropertyDescriptor) -> bool {
    match value {
        Data { enumerable, .. } | Accessor { enumerable, .. } => enumerable,
    }
}

pub fn descriptor_configurable(value: PropertyDescriptor) -> bool {
    match value {
        Data { configurable, .. } | Accessor { configurable, .. } => configurable,
    }
}

pub fn descriptor_writable(value: PropertyDescriptor) -> bool {
    match value {
        Data { writable, .. } => writable,
        Accessor { .. } => false,
    }
}

pub fn descriptor_value(value: PropertyDescriptor) -> Option[Value] {
    match value {
        Data { value, .. } => Option::Some(value),
        Accessor { .. } => Option::None,
    }
}

pub fn descriptor_get(value: PropertyDescriptor) -> Option[Value] {
    match value {
        Accessor { get, .. } => get,
        Data { .. } => Option::None,
    }
}

pub fn descriptor_set(value: PropertyDescriptor) -> Option[Value] {
    match value {
        Accessor { set, .. } => set,
        Data { .. } => Option::None,
    }
}

pub fn descriptor_is_data(value: PropertyDescriptor) -> bool {
    match value {
        Data { .. } => true,
        Accessor { .. } => false,
    }
}

fn descriptor_sealed(value: PropertyDescriptor, frozen: bool) -> PropertyDescriptor {
    match value {
        Data { value, writable, enumerable, configurable: _ } => PropertyDescriptor::Data {
            value,
            writable: writable && !frozen,
            enumerable,
            configurable: false,
        },
        Accessor { get, set, enumerable, configurable: _ } => {
            PropertyDescriptor::Accessor { get, set, enumerable, configurable: false }
        },
    }
}

fn optional_value_same(left: Option[Value], right: Option[Value]) -> bool {
    match (left, right) {
        (None, None) => true,
        (Some(left_value), Some(right_value)) => same_value(left_value, right_value),
        _ => false,
    }
}

fn compatible_descriptor(current: PropertyDescriptor, next: PropertyDescriptor) -> bool {
    if descriptor_configurable(current) {
        true
    } else if descriptor_configurable(next)
        || descriptor_enumerable(current) != descriptor_enumerable(next) {
        false
    } else {
        match (current, next) {
            (
                Data {
                    value: current_value,
                    writable: current_writable,
                    enumerable: _,
                    configurable: _,
                },
                Data { value: next_value, writable: next_writable, enumerable: _, configurable: _ },
            ) => if current_writable {
                true
            } else {
                !next_writable && same_value(current_value, next_value)
            },
            (
                Accessor { get: current_get, set: current_set, enumerable: _, configurable: _ },
                Accessor { get: next_get, set: next_set, enumerable: _, configurable: _ },
            ) => optional_value_same(current_get, next_get)
                && optional_value_same(current_set, next_set),
            _ => false,
        }
    }
}

pub fn compatible_property_descriptor(
    extensible: bool,
    next: PropertyDescriptor,
    current: Option[PropertyDescriptor],
) -> bool {
    match current {
        Some(value) => compatible_descriptor(value, next),
        None => extensible,
    }
}

fn argument_index(key: PropertyKey) -> Option[u32] {
    match key {
        PropertyKey::String(value) => canonical_array_index(value),
        PropertyKey::Symbol(_) => Option::None,
    }
}

fn mapped_descriptor(target: Object, key: PropertyKey, descriptor: PropertyDescriptor) -> PropertyDescriptor {
    match target.namespace_bindings_get(key) {
        Some(cell) => return match descriptor {
            PropertyDescriptor::Data { value: _, writable, enumerable, configurable } => {
                PropertyDescriptor::Data { value: cell.get(), writable, enumerable, configurable }
            },
            PropertyDescriptor::Accessor { .. } => descriptor,
        },
        None => (),
    }
    match (argument_index(key), descriptor) {
        (Some(index), PropertyDescriptor::Data { value: _, writable, enumerable, configurable }) => match target.argument_map_get(
            index,
        ) {
            Some(cell) => PropertyDescriptor::Data {
                value: cell.get(),
                writable,
                enumerable,
                configurable,
            },
            None => descriptor,
        },
        _ => descriptor,
    }
}

fn update_argument_mapping(target: Object, key: PropertyKey, descriptor: PropertyDescriptor) -> () {
    match argument_index(key) {
        Some(index) => match target.argument_map_get(index) {
            Some(cell) => match descriptor {
                PropertyDescriptor::Data { value, writable, .. } => {
                    cell.set(value);
                    if !writable {
                        target.argument_map_remove(index);
                    }
                },
                PropertyDescriptor::Accessor { .. } => {
                    target.argument_map_remove(index);
                },
            },
            None => (),
        },
        None => (),
    }
}

pub fn is_typed_array_variable_length(heap: Heap, object: ObjectId) -> bool {
    match typed_array_view(heap, object) {
        Some(TypedArrayView::Uint8(value)) => value.buffer().is_resizable()
            || value.buffer().is_growable() && value.is_length_tracking(),
        Some(TypedArrayView::Int32(value)) => value.buffer().is_resizable()
            || value.buffer().is_growable() && value.is_length_tracking(),
        Some(TypedArrayView::Float64(value)) => value.buffer().is_resizable()
            || value.buffer().is_growable() && value.is_length_tracking(),
        Some(TypedArrayView::Numeric(value)) => value.buffer().is_resizable()
            || value.buffer().is_growable() && value.is_length_tracking(),
        Some(TypedArrayView::BigInt(value)) => value.buffer().is_resizable()
            || value.buffer().is_growable() && value.is_length_tracking(),
        None => false,
    }
}

pub fn prevent_extensions(heap: Heap, object: ObjectId) -> bool {
    if is_typed_array_variable_length(heap, object) {
        return false
    }
    match heap.get(object) {
        Some(target) => {
            target.prevent_extensions();
            true
        },
        None => false,
    }
}

pub fn define_module_namespace_export(
    heap: Heap,
    object: ObjectId,
    key: PropertyKey,
    cell: Ref[Value],
) -> bool {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    if target.namespace_bindings_get(key).is_some()
        || !ordinary_define_own_property(
            heap,
            object,
            key,
            data_descriptor(cell.get(), true, true, false),
        ) {
        false
    } else {
        target.namespace_bindings_set(key, cell);
        true
    }
}

pub fn mark_module_namespace(heap: Heap, object: ObjectId) -> bool {
    match heap.get(object) {
        Some(target) => {
            target.state_value.get().module_namespace_value.set(true);
            true
        },
        None => false,
    }
}

pub fn is_module_namespace(heap: Heap, object: ObjectId) -> bool {
    match heap.get(object) {
        Some(target) => target.state_value.get().module_namespace_value.get(),
        None => false,
    }
}

pub fn seal_object(heap: Heap, object: ObjectId, frozen: bool) -> bool {
    if is_typed_array_variable_length(heap, object) {
        return false
    }
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    target.prevent_extensions();
    if frozen && target.namespace_bindings_len() > 0 {
        return false
    }
    match target.state_value.get().typed_array_value.get() {
        Some(value) => if typed_array_length(value.view) > 0 {
            return false
        },
        None => (),
    }
    match target.state_value.get().array_length_value.get() {
        Some(state) => target.state_value.get().array_length_value.set(
            Option::Some(
                ArrayLengthState {
                    value: state.value,
                    writable: if frozen {
                        false
                    } else {
                        state.writable
                    },
                    enumerable: state.enumerable,
                    configurable: false,
                },
            ),
        ),
        None => (),
    }
    let keys = target.state_value.get().properties_value.keys();
    for key in keys {
        match target.state_value.get().properties_value.get(key) {
            Some(property) => {
                let next = descriptor_sealed(
                    mapped_descriptor(target, key, ordinary_property_descriptor(property)),
                    frozen,
                );
                invalidate_ordinary_property(property);
                target.state_value.get().properties_value.insert(
                    key,
                    OrdinaryProperty::Described(next),
                );
                update_argument_mapping(target, key, next);
            },
            None => (),
        }
    }
    let mut dense_index = 0;
    while dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(element) => {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::Some(
                    ArrayElement::Described(
                        descriptor_sealed(array_element_descriptor(element), frozen),
                    ),
                );
            },
            None => (),
        }
        dense_index += 1;
    }
    for (index, descriptor) in target.sparse_entries() {
        target.sparse_set(index, descriptor_sealed(descriptor, frozen));
    }
    true
}

pub fn object_is_sealed(heap: Heap, object: ObjectId, frozen: bool) -> bool {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    if target.extensible() {
        return false
    }
    match target.state_value.get().typed_array_value.get() {
        Some(value) => if typed_array_length(value.view) > 0 {
            return false
        },
        None => (),
    }
    match target.state_value.get().array_length_value.get() {
        Some(state) => if state.configurable || frozen && state.writable {
            return false
        },
        None => (),
    }
    for property in target.state_value.get().properties_value.values() {
        let descriptor = ordinary_property_descriptor(property);
        if descriptor_configurable(descriptor)
            || frozen && descriptor_is_data(descriptor) && descriptor_writable(descriptor) {
            return false
        }
    }
    for descriptor in target.state_value.get().array_dense_properties_value {
        match descriptor {
            Some(value) => if descriptor_configurable(array_element_descriptor(value))
                || frozen && descriptor_is_data(array_element_descriptor(value))
                    && descriptor_writable(array_element_descriptor(value)) {
                return false
            },
            None => (),
        }
    }
    for (_, descriptor) in target.sparse_entries() {
        if descriptor_configurable(descriptor)
            || frozen && descriptor_is_data(descriptor) && descriptor_writable(descriptor) {
            return false
        }
    }
    true
}

fn ordinary_define_own_property(
    heap: Heap,
    object: ObjectId,
    key: PropertyKey,
    descriptor: PropertyDescriptor,
) -> bool {
    match heap.get(object) {
        Some(target) => match target.state_value.get().properties_value.get(key) {
            Some(current) => if compatible_descriptor(
                mapped_descriptor(target, key, ordinary_property_descriptor(current)),
                descriptor,
            ) {
                match (current, ordinary_property_from_descriptor(descriptor)) {
                    (OrdinaryProperty::Default(_), OrdinaryProperty::Default(value)) => {
                        target.state_value.get().properties_value.insert(
                            key,
                            OrdinaryProperty::Default(value),
                        );
                    },
                    (OrdinaryProperty::Cached(cell), OrdinaryProperty::Default(value)) => {
                        cell.set(Option::Some(value));
                    },
                    (_, next) => {
                        invalidate_ordinary_property(current);
                        target.state_value.get().properties_value.insert(key, next);
                    },
                }
                update_argument_mapping(target, key, descriptor);
                true
            } else {
                false
            },
            None => if target.state_value.get().extensible_value.get() {
                target.state_value.get().properties_value.insert(
                    key,
                    ordinary_property_from_descriptor(descriptor),
                );
                true
            } else {
                false
            },
        },
        None => false,
    }
}

fn module_namespace_define_own_property(
    target: Object,
    key: PropertyKey,
    descriptor: PropertyDescriptor,
) -> bool {
    match (target.namespace_bindings_get(key), descriptor) {
        (Some(cell), PropertyDescriptor::Data { value, writable, enumerable, configurable }) => writable
            && enumerable
            && !configurable
            && same_value(cell.get(), value),
        _ => false,
    }
}

fn array_descriptor_length(descriptor: PropertyDescriptor) -> Option[isize] {
    match descriptor {
        PropertyDescriptor::Data { value: Value::Int(value), .. } => if value >= 0 {
            Option::Some(value.to_isize())
        } else {
            Option::None
        },
        PropertyDescriptor::Data { value: Value::Float(value), .. } => if math::is_finite(value)
            && value >= 0.0
            && value <= 4294967295.0
            && math::trunc(value) == value {
            match num::parse_int_structured(value.to_string()) {
                Ok(value) => Option::Some(value),
                Err(_) => Option::None,
            }
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn array_length_descriptor(state: ArrayLengthState) -> PropertyDescriptor {
    data_descriptor(
        array_length_value(state.value),
        state.writable,
        state.enumerable,
        state.configurable,
    )
}

fn array_length_state(descriptor: PropertyDescriptor) -> Option[ArrayLengthState] {
    match (array_descriptor_length(descriptor), descriptor) {
        (Some(value), PropertyDescriptor::Data { value: _, writable, enumerable, configurable }) => Option::Some(
            ArrayLengthState { value, writable, enumerable, configurable },
        ),
        _ => Option::None,
    }
}

fn array_store_length_descriptor(target: Object, descriptor: PropertyDescriptor) -> bool {
    let next = match array_length_state(descriptor) {
        Some(value) => value,
        None => return false,
    };
    match target.state_value.get().array_length_value.get() {
        Some(current) => if compatible_descriptor(array_length_descriptor(current), descriptor) {
            target.state_value.get().array_length_value.set(Option::Some(next));
            true
        } else {
            false
        },
        None => if target.extensible() {
            target.state_value.get().array_length_value.set(Option::Some(next));
            true
        } else {
            false
        },
    }
}

fn array_current_length(target: Object) -> Option[(isize, bool)] {
    match target.state_value.get().array_length_value.get() {
        Some(state) => Option::Some((state.value, state.writable)),
        None => Option::None,
    }
}

const ARRAY_DENSE_GAP_LIMIT: isize = 256;

const ARRAY_DENSE_INDEX_LIMIT: isize = 1048576;

fn array_element_from_descriptor(descriptor: PropertyDescriptor) -> ArrayElement {
    match descriptor {
        PropertyDescriptor::Data { value, writable: true, enumerable: true, configurable: true } => ArrayElement::Default(
            value,
        ),
        _ => ArrayElement::Described(descriptor),
    }
}

fn array_element_descriptor(element: ArrayElement) -> PropertyDescriptor {
    match element {
        ArrayElement::Default(value) => data_descriptor(value, true, true, true),
        ArrayElement::Described(descriptor) => descriptor,
    }
}

fn array_element_value(element: ArrayElement) -> Option[Value] {
    match element {
        ArrayElement::Default(value) => Option::Some(value),
        ArrayElement::Described(PropertyDescriptor::Data { value, .. }) => Option::Some(value),
        ArrayElement::Described(PropertyDescriptor::Accessor { .. }) => Option::None,
    }
}

fn array_index_descriptor(target: Object, index: u32) -> Option[PropertyDescriptor] {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(value) => Option::Some(array_element_descriptor(value)),
            None => target.sparse_get(index),
        }
    } else {
        target.sparse_get(index)
    }
}

fn array_index_value(target: Object, index: u32) -> Option[Value] {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(element) => array_element_value(element),
            None => match target.sparse_get(index) {
                Some(PropertyDescriptor::Data { value, .. }) => Option::Some(value),
                _ => Option::None,
            },
        }
    } else {
        match target.sparse_get(index) {
            Some(PropertyDescriptor::Data { value, .. }) => Option::Some(value),
            _ => Option::None,
        }
    }
}

fn fast_array_slot(target: Object, index: u32) -> FastArraySlot {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(ArrayElement::Default(value)) => return FastArraySlot::Data(value),
            Some(ArrayElement::Described(Data { value, .. })) => {
                return FastArraySlot::Data(value)
            },
            Some(ArrayElement::Described(Accessor { .. })) => {
                return FastArraySlot::Observable
            },
            None => (),
        }
    }
    match target.sparse_get(index) {
        Some(Data { value, .. }) => FastArraySlot::Data(value),
        Some(Accessor { .. }) => FastArraySlot::Observable,
        None => FastArraySlot::Hole,
    }
}

fn take_fast_array_slot(target: Object, index: u32) -> FastArraySlot {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(ArrayElement::Default(value)) => {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::None;
                trim_array_dense_properties(target);
                return FastArraySlot::Data(value)
            },
            Some(ArrayElement::Described(Data { value, configurable: true, .. })) => {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::None;
                trim_array_dense_properties(target);
                return FastArraySlot::Data(value)
            },
            Some(_) => return FastArraySlot::Observable,
            None => (),
        }
    }
    match target.sparse_get(index) {
        Some(Data { value, configurable: true, .. }) => {
            target.sparse_remove(index);
            FastArraySlot::Data(value)
        },
        Some(_) => FastArraySlot::Observable,
        None => FastArraySlot::Hole,
    }
}

fn array_insert_new_default_element(target: Object, index: u32, value: Value) -> () {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        target.state_value.get().array_dense_properties_value[dense_index] = Option::Some(
            ArrayElement::Default(value),
        );
    } else if dense_index < ARRAY_DENSE_INDEX_LIMIT
        && dense_index
            <= target.state_value.get().array_dense_properties_value.len() + ARRAY_DENSE_GAP_LIMIT {
        while target.state_value.get().array_dense_properties_value.len() < dense_index {
            target.state_value.get().array_dense_properties_value.push(Option::None)
        }
        target.state_value.get().array_dense_properties_value.push(
            Option::Some(ArrayElement::Default(value)),
        );
    } else {
        target.sparse_set(index, data_descriptor(value, true, true, true));
    }
}

fn array_insert_index_descriptor(target: Object, index: u32, descriptor: PropertyDescriptor) -> () {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(_) => {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::Some(
                    array_element_from_descriptor(descriptor),
                );
            },
            None => if target.sparse_get(index).is_some() {
                target.sparse_set(index, descriptor);
            } else {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::Some(
                    array_element_from_descriptor(descriptor),
                );
            },
        }
    } else if target.sparse_get(index).is_some() {
        target.sparse_set(index, descriptor);
    } else if dense_index < ARRAY_DENSE_INDEX_LIMIT
        && dense_index
            <= target.state_value.get().array_dense_properties_value.len() + ARRAY_DENSE_GAP_LIMIT {
        while target.state_value.get().array_dense_properties_value.len() < dense_index {
            target.state_value.get().array_dense_properties_value.push(Option::None)
        }
        target.state_value.get().array_dense_properties_value.push(
            Option::Some(array_element_from_descriptor(descriptor)),
        );
    } else {
        target.sparse_set(index, descriptor);
    }
}

fn array_insert_new_index_descriptor(target: Object, index: u32, descriptor: PropertyDescriptor) -> () {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        target.state_value.get().array_dense_properties_value[dense_index] = Option::Some(
            array_element_from_descriptor(descriptor),
        );
    } else if dense_index < ARRAY_DENSE_INDEX_LIMIT
        && dense_index
            <= target.state_value.get().array_dense_properties_value.len() + ARRAY_DENSE_GAP_LIMIT {
        while target.state_value.get().array_dense_properties_value.len() < dense_index {
            target.state_value.get().array_dense_properties_value.push(Option::None)
        }
        target.state_value.get().array_dense_properties_value.push(
            Option::Some(array_element_from_descriptor(descriptor)),
        );
    } else {
        target.sparse_set(index, descriptor);
    }
}

fn array_remove_index_descriptor(target: Object, index: u32) -> bool {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(element) => if descriptor_configurable(array_element_descriptor(element)) {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::None;
                while !target.state_value.get().array_dense_properties_value.is_empty()
                    && target.state_value.get().array_dense_properties_value[target.state_value.get().array_dense_properties_value.len()
                        - 1].is_none() {
                    target.state_value.get().array_dense_properties_value.truncate(
                        target.state_value.get().array_dense_properties_value.len() - 1,
                    );
                }
                true
            } else {
                false
            },
            None => match target.sparse_get(index) {
                Some(descriptor) => if descriptor_configurable(descriptor) {
                    target.sparse_remove(index);
                    true
                } else {
                    false
                },
                None => true,
            },
        }
    } else {
        match target.sparse_get(index) {
            Some(descriptor) => if descriptor_configurable(descriptor) {
                target.sparse_remove(index);
                true
            } else {
                false
            },
            None => true,
        }
    }
}

fn array_define_own_index(target: Object, index: u32, descriptor: PropertyDescriptor) -> bool {
    match array_index_descriptor(target, index) {
        Some(current) => if compatible_descriptor(current, descriptor) {
            array_insert_index_descriptor(target, index, descriptor);
            true
        } else {
            false
        },
        None => if target.extensible() {
            array_insert_new_index_descriptor(target, index, descriptor);
            true
        } else {
            false
        },
    }
}

fn write_existing_array_index_value(target: Object, index: u32, value: Value) -> ArrayIndexWriteResult {
    let dense_index = index.to_isize();
    if dense_index < target.state_value.get().array_dense_properties_value.len() {
        match target.state_value.get().array_dense_properties_value[dense_index] {
            Some(ArrayElement::Default(_)) => {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::Some(
                    ArrayElement::Default(value),
                );
                return ArrayIndexWriteResult::Written
            },
            Some(ArrayElement::Described(Data { value: _, writable, enumerable, configurable })) => return if writable {
                target.state_value.get().array_dense_properties_value[dense_index] = Option::Some(
                    ArrayElement::Described(
                        PropertyDescriptor::Data { value, writable, enumerable, configurable },
                    ),
                );
                ArrayIndexWriteResult::Written
            } else {
                ArrayIndexWriteResult::ReadOnly
            },
            Some(ArrayElement::Described(Accessor { .. })) => {
                return ArrayIndexWriteResult::Unhandled
            },
            None => (),
        }
    }
    match target.sparse_get(index) {
        Some(Data { value: _, writable, enumerable, configurable }) => if writable {
            target.sparse_set(
                index,
                PropertyDescriptor::Data { value, writable, enumerable, configurable },
            );
            ArrayIndexWriteResult::Written
        } else {
            ArrayIndexWriteResult::ReadOnly
        },
        Some(Accessor { .. }) | None => ArrayIndexWriteResult::Unhandled,
    }
}

fn set_existing_array_index_value(target: Object, index: u32, value: Value) -> bool {
    match write_existing_array_index_value(target, index, value) {
        ArrayIndexWriteResult::Written => true,
        ArrayIndexWriteResult::ReadOnly | ArrayIndexWriteResult::Unhandled => false,
    }
}

fn normalized_array_length_descriptor(descriptor: PropertyDescriptor, length: isize) -> Option[
    PropertyDescriptor,
] {
    match descriptor {
        PropertyDescriptor::Data { value: _, writable, enumerable, configurable } => {
            Option::Some(
                PropertyDescriptor::Data {
                    value: array_length_value(length),
                    writable,
                    enumerable,
                    configurable,
                },
            )
        },
        _ => Option::None,
    }
}

fn compare_array_index(left: u32, right: u32) -> isize {
    if left < right {
        -1
    } else if left > right {
        1
    } else {
        0
    }
}

fn trim_array_dense_properties(target: Object) -> () {
    let mut length = target.state_value.get().array_dense_properties_value.len();
    while length > 0 && target.state_value.get().array_dense_properties_value[length - 1].is_none() {
        length -= 1;
    }
    if length < target.state_value.get().array_dense_properties_value.len() {
        target.state_value.get().array_dense_properties_value.truncate(length)
    }
}

fn array_delete_indices_from(target: Object, minimum: isize) -> Option[u32] {
    let sparse_indices: Vec[u32] = Vec::new();
    for (index, _) in target.sparse_entries() {
        if index.to_isize() >= minimum {
            sparse_indices.push(index)
        }
    }
    collections::sort_by(sparse_indices, compare_array_index);
    let mut sparse_cursor = sparse_indices.len();
    let mut dense_cursor = target.state_value.get().array_dense_properties_value.len();
    let mut dense_index: Option[u32] = Option::None;
    loop {
        if dense_index.is_none() {
            while dense_cursor > minimum {
                dense_cursor -= 1;
                if target.state_value.get().array_dense_properties_value[dense_cursor].is_some() {
                    dense_index = Option::Some(dense_cursor.to_u32());
                    break
                }
            }
        }
        let sparse_index = if sparse_cursor > 0 {
            Option::Some(sparse_indices[sparse_cursor - 1])
        } else {
            Option::None
        };
        let delete_dense = match (dense_index, sparse_index) {
            (Some(dense), Some(sparse)) => dense > sparse,
            (Some(_), None) => true,
            (None, Some(_)) => false,
            (None, None) => {
                trim_array_dense_properties(target);
                return Option::None
            },
        };
        if delete_dense {
            match dense_index {
                Some(index) => match target.state_value.get().array_dense_properties_value[index.to_isize()] {
                    Some(element) => if descriptor_configurable(array_element_descriptor(element)) {
                        target.state_value.get().array_dense_properties_value[index.to_isize()] = Option::None;
                        dense_index = Option::None;
                    } else {
                        trim_array_dense_properties(target);
                        return Option::Some(index)
                    },
                    None => {
                        dense_index = Option::None;
                    },
                },
                None => (),
            }
        } else {
            match sparse_index {
                Some(index) => match target.sparse_get(index) {
                    Some(descriptor) => if descriptor_configurable(descriptor) {
                        target.sparse_remove(index);
                        sparse_cursor -= 1;
                    } else {
                        trim_array_dense_properties(target);
                        return Option::Some(index)
                    },
                    None => {
                        sparse_cursor -= 1;
                    },
                },
                None => (),
            }
        }
    }
}

fn array_define_length(heap: Heap, object: ObjectId, descriptor: PropertyDescriptor) -> bool {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    let (old_length, old_writable) = match array_current_length(target) {
        Some(value) => value,
        None => match array_descriptor_length(descriptor) {
            Some(length) => match normalized_array_length_descriptor(descriptor, length) {
                Some(value) => return array_store_length_descriptor(target, value),
                None => return false,
            },
            None => return false,
        },
    };
    let new_length = match array_descriptor_length(descriptor) {
        Some(value) => value,
        None => return false,
    };
    let normalized = match normalized_array_length_descriptor(descriptor, new_length) {
        Some(value) => value,
        None => return false,
    };
    if new_length >= old_length {
        return array_store_length_descriptor(target, normalized)
    } else if !old_writable {
        return false
    }
    let final_writable = descriptor_writable(normalized);
    let temporary = match normalized {
        PropertyDescriptor::Data { value, writable: _, enumerable, configurable } => {
            PropertyDescriptor::Data { value, writable: true, enumerable, configurable }
        },
        _ => return false,
    };
    if !array_store_length_descriptor(target, temporary) {
        return false
    }
    match array_delete_indices_from(target, new_length) {
        Some(index) => {
            let rollback = data_descriptor(
                array_length_value(index.to_isize() + 1),
                final_writable,
                false,
                false,
            );
            let _ = array_store_length_descriptor(target, rollback);
            return false
        },
        None => (),
    }
    if final_writable {
        true
    } else {
        array_store_length_descriptor(
            target,
            match normalized {
                PropertyDescriptor::Data { value, writable: _, enumerable, configurable } => {
                    PropertyDescriptor::Data { value, writable: false, enumerable, configurable }
                },
                _ => normalized,
            },
        )
    }
}

fn array_define_index(heap: Heap, object: ObjectId, index: u32, descriptor: PropertyDescriptor) -> bool {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    let (length, writable) = match array_current_length(target) {
        Some(value) => value,
        None => return false,
    };
    if index.to_isize() >= length && !writable {
        return false
    } else if !array_define_own_index(target, index, descriptor) {
        return false
    } else if index.to_isize() < length {
        return true
    }
    match target.state_value.get().array_length_value.get() {
        Some(state) => {
            target.state_value.get().array_length_value.set(
                Option::Some(
                    ArrayLengthState {
                        value: index.to_isize() + 1,
                        writable,
                        enumerable: state.enumerable,
                        configurable: state.configurable,
                    },
                ),
            );
            true
        },
        None => false,
    }
}

fn fast_array_prototype_property_absent(heap: Heap, target: Object, key: PropertyKey) -> bool {
    let mut prototype = target.state_value.get().prototype_value.get();
    while prototype.is_some() {
        match prototype {
            Some(object) => match heap.get(object) {
                Some(candidate) => if candidate.is_proxy() || candidate.own_property(key).is_some()
                    || candidate.state_value.get().typed_array_value.get().is_some()
                        && typed_array_numeric_index(key).is_some() {
                    return false
                } else {
                    prototype = candidate.state_value.get().prototype_value.get();
                },
                None => return false,
            },
            None => (),
        }
    }
    true
}

fn fast_array_object(target: Object) -> bool {
    match target.kind() {
        ObjectKind::Array => !target.is_proxy(),
        _ => false,
    }
}

pub fn try_fast_array_set(heap: Heap, object: ObjectId, index: isize, value: Value) -> bool {
    if index < 0 || index > 4294967294 {
        return false
    }
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    if !fast_array_object(target) || !target.extensible() {
        return false
    }
    let length_state = match target.state_value.get().array_length_value.get() {
        Some(state) => state,
        None => return false,
    };
    if array_index_descriptor(target, index.to_u32()).is_some()
        || index >= length_state.value && !length_state.writable
        || !fast_array_prototype_property_absent(
            heap,
            target,
            string_property_key(index.to_string()),
        ) {
        return false
    }
    array_insert_new_default_element(target, index.to_u32(), value);
    if index >= length_state.value {
        target.state_value.get().array_length_value.set(
            Option::Some(
                ArrayLengthState {
                    value: index + 1,
                    writable: length_state.writable,
                    enumerable: length_state.enumerable,
                    configurable: length_state.configurable,
                },
            ),
        )
    }
    true
}

pub fn try_fast_array_push(heap: Heap, object: ObjectId, values: Vec[Value]) -> Option[isize] {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return Option::None,
    };
    if !fast_array_object(target) {
        return Option::None
    }
    let length_state = match target.state_value.get().array_length_value.get() {
        Some(state) => if state.writable {
            state
        } else {
            return Option::None
        },
        _ => return Option::None,
    };
    let length = length_state.value;
    if values.len() > 4294967295 - length || values.len() > 0 && !target.extensible() {
        return Option::None
    }
    let mut index = 0;
    while index < values.len() {
        let array_index = (length + index).to_u32();
        let key = string_property_key(array_index.to_string());
        if array_index_descriptor(target, array_index).is_some()
            || !fast_array_prototype_property_absent(heap, target, key) {
            return Option::None
        }
        index += 1;
    }
    index = 0;
    while index < values.len() {
        array_insert_new_default_element(target, (length + index).to_u32(), values[index]);
        index += 1;
    }
    let next_length = length + values.len();
    target.state_value.get().array_length_value.set(
        Option::Some(
            ArrayLengthState {
                value: next_length,
                writable: length_state.writable,
                enumerable: length_state.enumerable,
                configurable: length_state.configurable,
            },
        ),
    );
    Option::Some(next_length)
}

pub fn try_fast_array_pop(heap: Heap, object: ObjectId) -> Option[Value] {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return Option::None,
    };
    if !fast_array_object(target) {
        return Option::None
    }
    let length_state = match target.state_value.get().array_length_value.get() {
        Some(state) => if state.writable {
            state
        } else {
            return Option::None
        },
        _ => return Option::None,
    };
    let length = length_state.value;
    let value = if length == 0 {
        Value::Undefined
    } else {
        let index = (length - 1).to_u32();
        match take_fast_array_slot(target, index) {
            FastArraySlot::Data(value) => value,
            FastArraySlot::Observable => return Option::None,
            FastArraySlot::Hole => if fast_array_prototype_property_absent(
                heap,
                target,
                string_property_key(index.to_string()),
            ) {
                Value::Undefined
            } else {
                return Option::None
            },
        }
    };
    let next_length = if length == 0 {
        0
    } else {
        length - 1
    };
    target.state_value.get().array_length_value.set(
        Option::Some(
            ArrayLengthState {
                value: next_length,
                writable: length_state.writable,
                enumerable: length_state.enumerable,
                configurable: length_state.configurable,
            },
        ),
    );
    Option::Some(value)
}

pub fn try_fast_array_shift(heap: Heap, object: ObjectId) -> Option[Value] {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return Option::None,
    };
    if !fast_array_object(target) {
        return Option::None
    }
    let length_state = match target.state_value.get().array_length_value.get() {
        Some(state) => if state.writable {
            state
        } else {
            return Option::None
        },
        _ => return Option::None,
    };
    let length = length_state.value;
    if length == 0 {
        return Option::Some(Value::Undefined)
    }
    let mut index: u32 = 0;
    while index < length.to_u32() {
        match fast_array_slot(target, index) {
            FastArraySlot::Data(_) => (),
            FastArraySlot::Observable => return Option::None,
            FastArraySlot::Hole => if !fast_array_prototype_property_absent(
                heap,
                target,
                string_property_key(index.to_string()),
            ) {
                return Option::None
            },
        }
        index += 1;
    }
    let first = match take_fast_array_slot(target, 0) {
        FastArraySlot::Data(value) => value,
        FastArraySlot::Hole => Value::Undefined,
        FastArraySlot::Observable => return Option::None,
    };
    index = 1;
    while index < length.to_u32() {
        match take_fast_array_slot(target, index) {
            FastArraySlot::Data(value) => {
                array_insert_new_default_element(target, index - 1, value);
            },
            FastArraySlot::Hole => (),
            FastArraySlot::Observable => return Option::None,
        }
        index += 1;
    }
    target.state_value.get().array_length_value.set(
        Option::Some(
            ArrayLengthState {
                value: length - 1,
                writable: length_state.writable,
                enumerable: length_state.enumerable,
                configurable: length_state.configurable,
            },
        ),
    );
    Option::Some(first)
}

pub fn try_fast_array_slice(
    heap: Heap,
    source: ObjectId,
    target: ObjectId,
    first: isize,
    final_index: isize,
) -> bool {
    let source_object = match heap.get(source) {
        Some(value) => value,
        None => return false,
    };
    let target_object = match heap.get(target) {
        Some(value) => value,
        None => return false,
    };
    if !fast_array_object(source_object) || !fast_array_object(target_object)
        || !target_object.extensible()
        || !target_object.state_value.get().array_dense_properties_value.is_empty()
        || target_object.sparse_len() > 0 {
        return false
    }
    let count = final_index - first;
    if count < 0 || count >= ARRAY_DENSE_INDEX_LIMIT {
        return false
    }
    let length_state = match target_object.state_value.get().array_length_value.get() {
        Some(state) => if state.writable && state.value == count {
            state
        } else {
            return false
        },
        _ => return false,
    };
    let mut index = 0;
    while index < count {
        let source_index = (first + index).to_u32();
        match fast_array_slot(source_object, source_index) {
            FastArraySlot::Data(_) => (),
            FastArraySlot::Observable => return false,
            FastArraySlot::Hole => if !fast_array_prototype_property_absent(
                heap,
                source_object,
                string_property_key(source_index.to_string()),
            ) {
                return false
            },
        }
        index += 1;
    }
    target_object.state_value.get().array_dense_properties_value.reserve(count);
    index = 0;
    while index < count {
        match fast_array_slot(source_object, (first + index).to_u32()) {
            FastArraySlot::Data(value) => target_object.state_value.get().array_dense_properties_value.push(
                Option::Some(ArrayElement::Default(value)),
            ),
            FastArraySlot::Hole => target_object.state_value.get().array_dense_properties_value.push(
                Option::None,
            ),
            FastArraySlot::Observable => return false,
        }
        index += 1;
    }
    target_object.state_value.get().array_length_value.set(Option::Some(length_state));
    true
}

fn typed_array_define_numeric_property(
    state: TypedArrayState,
    key: PropertyKey,
    descriptor: PropertyDescriptor,
) -> bool {
    let index = match typed_array_numeric_index(key) {
        Some(TypedArrayNumericIndex::Index(value)) => value,
        Some(TypedArrayNumericIndex::Invalid) | None => return false,
    };
    if typed_array_element(state.view, index).is_none() {
        return false
    }
    match descriptor {
        PropertyDescriptor::Data { value, writable, enumerable, configurable } => if writable
            && enumerable
            && configurable {
            match typed_array_set_value(state.view, index, value) {
                Ok(value) => value,
                Err(_) => false,
            }
        } else {
            false
        },
        PropertyDescriptor::Accessor { .. } => false,
    }
}

pub fn define_own_property(
    heap: Heap,
    object: ObjectId,
    key: PropertyKey,
    descriptor: PropertyDescriptor,
) -> bool {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    if target.namespace_bindings_get(key).is_some() {
        return module_namespace_define_own_property(target, key, descriptor)
    }
    match target.state_value.get().typed_array_value.get() {
        Some(value) => if typed_array_numeric_index(key).is_some() {
            return typed_array_define_numeric_property(value, key, descriptor)
        },
        None => (),
    }
    match target.kind() {
        ObjectKind::Array => match key {
            PropertyKey::String(value) => if is_length_property_key(key) {
                array_define_length(heap, object, descriptor)
            } else {
                match canonical_array_index(value) {
                    Some(index) => array_define_index(heap, object, index, descriptor),
                    None => ordinary_define_own_property(heap, object, key, descriptor),
                }
            },
            PropertyKey::Symbol(_) => ordinary_define_own_property(heap, object, key, descriptor),
        },
        _ => ordinary_define_own_property(heap, object, key, descriptor),
    }
}

pub fn define_private_field(heap: Heap, object: ObjectId, name: ObjectId, value: Value) -> bool {
    if !heap.contains(name) {
        return false
    }
    match heap.get(object) {
        Some(target) => if target.private_elements_get(name).is_some() {
            false
        } else {
            target.private_elements_set(name, PrivateElement::Field(value));
            true
        },
        None => false,
    }
}

pub fn define_private_method(heap: Heap, object: ObjectId, name: ObjectId, value: Value) -> bool {
    if !heap.contains(name) {
        return false
    }
    match heap.get(object) {
        Some(target) => if target.private_elements_get(name).is_some() {
            false
        } else {
            target.private_elements_set(name, PrivateElement::Method(value));
            true
        },
        None => false,
    }
}

pub fn define_private_accessor(
    heap: Heap,
    object: ObjectId,
    name: ObjectId,
    value: Value,
    getter: bool,
) -> bool {
    if !heap.contains(name) {
        return false
    }
    match heap.get(object) {
        Some(target) => match target.private_elements_get(name) {
            None => {
                target.private_elements_set(
                    name,
                    if getter {
                        PrivateElement::Accessor { get: Option::Some(value), set: Option::None }
                    } else {
                        PrivateElement::Accessor { get: Option::None, set: Option::Some(value) }
                    },
                );
                true
            },
            Some(PrivateElement::Accessor { get, set }) => if getter && get.is_none() {
                target.private_elements_set(
                    name,
                    PrivateElement::Accessor { get: Option::Some(value), set },
                );
                true
            } else if !getter && set.is_none() {
                target.private_elements_set(
                    name,
                    PrivateElement::Accessor { get, set: Option::Some(value) },
                );
                true
            } else {
                false
            },
            Some(_) => false,
        },
        None => false,
    }
}

pub fn private_element(heap: Heap, object: ObjectId, name: ObjectId) -> Option[PrivateElement] {
    match heap.get(object) {
        Some(target) => target.private_elements_get(name),
        None => Option::None,
    }
}

pub fn has_private_element(heap: Heap, object: ObjectId, name: ObjectId) -> bool {
    match heap.get(object) {
        Some(target) => target.private_elements_get(name).is_some(),
        None => false,
    }
}

pub fn set_private_field(heap: Heap, object: ObjectId, name: ObjectId, value: Value) -> bool {
    match heap.get(object) {
        Some(target) => match target.private_elements_get(name) {
            Some(PrivateElement::Field(_)) => {
                target.private_elements_set(name, PrivateElement::Field(value));
                true
            },
            _ => false,
        },
        None => false,
    }
}

pub fn delete_property(heap: Heap, object: ObjectId, key: PropertyKey) -> bool {
    match heap.get(object) {
        Some(target) => match target.state_value.get().typed_array_value.get() {
            Some(value) => match typed_array_numeric_index(key) {
                Some(TypedArrayNumericIndex::Index(index)) => {
                    typed_array_element(value.view, index).is_none()
                },
                Some(TypedArrayNumericIndex::Invalid) => true,
                None => delete_ordinary_property(target, key),
            },
            None => match target.kind() {
                ObjectKind::Array => match key {
                    PropertyKey::String(value) => if is_length_property_key(key) {
                        match target.state_value.get().array_length_value.get() {
                            Some(state) => if state.configurable {
                                target.state_value.get().array_length_value.set(Option::None);
                                true
                            } else {
                                false
                            },
                            None => true,
                        }
                    } else {
                        match canonical_array_index(value) {
                            Some(index) => array_remove_index_descriptor(target, index),
                            None => delete_ordinary_property(target, key),
                        }
                    },
                    PropertyKey::Symbol(_) => delete_ordinary_property(target, key),
                },
                _ => delete_ordinary_property(target, key),
            },
        },
        None => false,
    }
}

fn delete_ordinary_property(target: Object, key: PropertyKey) -> bool {
    match target.state_value.get().properties_value.get(key) {
        Some(property) => if descriptor_configurable(ordinary_property_descriptor(property)) {
            invalidate_ordinary_property(property);
            target.state_value.get().properties_value.remove(key);
            match argument_index(key) {
                Some(index) => {
                    target.argument_map_remove(index);
                },
                None => (),
            }
            true
        } else {
            false
        },
        None => true,
    }
}

pub fn set_prototype_of(heap: Heap, object: ObjectId, prototype: Option[ObjectId]) -> bool {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return false,
    };
    match prototype {
        Some(value) => if !heap.contains(value) {
            return false
        },
        None => (),
    }
    if target.state_value.get().prototype_value.get() == prototype {
        true
    } else if target.state_value.get().immutable_prototype_value.get() {
        false
    } else if !target.state_value.get().extensible_value.get() {
        false
    } else {
        let mut cursor = prototype;
        while cursor.is_some() {
            match cursor {
                Some(current) => if current == object {
                    return false
                } else {
                    match heap.get(current) {
                        Some(candidate) => if candidate.is_proxy() {
                            cursor = Option::None;
                        } else {
                            cursor = candidate.state_value.get().prototype_value.get();
                        },
                        None => return false,
                    }
                },
                None => (),
            }
        }
        target.state_value.get().prototype_value.set(prototype);
        true
    }
}

pub fn set_immutable_prototype(heap: Heap, object: ObjectId) -> bool {
    match heap.get(object) {
        Some(target) => {
            target.state_value.get().immutable_prototype_value.set(true);
            true
        },
        None => false,
    }
}

fn invalid_object_error() -> TypeError {
    TypeError { message: "object does not belong to this heap or is no longer alive" }
}

pub fn get_property(heap: Heap, object: ObjectId, key: PropertyKey) -> Result[
    Option[Value],
    TypeError,
] {
    if !heap.contains(object) {
        return Result::Err(invalid_object_error())
    }
    let mut cursor = Option::Some(object);
    while cursor.is_some() {
        match cursor {
            Some(current) => {
                let target = match heap.get(current) {
                    Some(value) => value,
                    None => return Result::Err(invalid_object_error()),
                };
                match target.own_property(key) {
                    Some(descriptor) => match descriptor {
                        Data { value, .. } => return Result::Ok(Option::Some(value)),
                        Accessor { get: None, .. } => {
                            return Result::Ok(Option::Some(Value::Undefined))
                        },
                        Accessor { get: Some(_), .. } => {
                            return Result::Err(
                                TypeError {
                                    message: "accessor invocation requires the call runtime",
                                },
                            )
                        },
                    },
                    None => match target.state_value.get().typed_array_value.get() {
                        Some(_) => if typed_array_numeric_index(key).is_some() {
                            return Result::Ok(Option::None)
                        } else {
                            cursor = target.state_value.get().prototype_value.get();
                        },
                        None => {
                            cursor = target.state_value.get().prototype_value.get();
                        },
                    },
                }
            },
            None => (),
        }
    }
    Result::Ok(Option::None)
}

pub fn try_fast_property_read(heap: Heap, object: ObjectId, key: PropertyKey) -> Option[Value] {
    if !heap.contains(object) {
        return Option::None
    }
    let mut cursor = Option::Some(object);
    while cursor.is_some() {
        match cursor {
            Some(current) => {
                let target = match heap.get(current) {
                    Some(value) => value,
                    None => return Option::None,
                };
                if target.is_proxy() {
                    return Option::None
                }
                match target.own_property(key) {
                    Some(Data { value, .. }) => return Option::Some(value),
                    Some(Accessor { get: None, .. }) => return Option::Some(Value::Undefined),
                    Some(Accessor { get: Some(_), .. }) => return Option::None,
                    None => match target.state_value.get().typed_array_value.get() {
                        Some(_) => if typed_array_numeric_index(key).is_some() {
                            return Option::Some(Value::Undefined)
                        } else {
                            cursor = target.state_value.get().prototype_value.get();
                        },
                        None => {
                            cursor = target.state_value.get().prototype_value.get();
                        },
                    },
                }
            },
            None => (),
        }
    }
    Option::Some(Value::Undefined)
}

pub fn try_fast_property_present(heap: Heap, object: ObjectId, key: PropertyKey) -> Option[bool] {
    if !heap.contains(object) {
        return Option::None
    }
    let mut cursor = Option::Some(object);
    while cursor.is_some() {
        match cursor {
            Some(current) => {
                let target = match heap.get(current) {
                    Some(value) => value,
                    None => return Option::None,
                };
                if target.is_proxy() {
                    return Option::None
                } else if target.own_property(key).is_some() {
                    return Option::Some(true)
                }
                match target.state_value.get().typed_array_value.get() {
                    Some(_) => if typed_array_numeric_index(key).is_some() {
                        return Option::Some(false)
                    } else {
                        cursor = target.state_value.get().prototype_value.get();
                    },
                    None => {
                        cursor = target.state_value.get().prototype_value.get();
                    },
                }
            },
            None => (),
        }
    }
    Option::Some(false)
}

pub fn get_property_descriptor(heap: Heap, object: ObjectId, key: PropertyKey) -> Result[
    Option[PropertyDescriptor],
    TypeError,
] {
    if !heap.contains(object) {
        return Result::Err(invalid_object_error())
    }
    let mut cursor = Option::Some(object);
    while cursor.is_some() {
        match cursor {
            Some(current) => {
                let target = match heap.get(current) {
                    Some(value) => value,
                    None => return Result::Err(invalid_object_error()),
                };
                match target.own_property(key) {
                    Some(value) => return Result::Ok(Option::Some(value)),
                    None => match target.state_value.get().typed_array_value.get() {
                        Some(_) => if typed_array_numeric_index(key).is_some() {
                            return Result::Ok(Option::None)
                        } else {
                            cursor = target.state_value.get().prototype_value.get();
                        },
                        None => {
                            cursor = target.state_value.get().prototype_value.get();
                        },
                    },
                }
            },
            None => (),
        }
    }
    Result::Ok(Option::None)
}

pub fn set_existing_data_property(heap: Heap, object: ObjectId, key: PropertyKey, value: Value) -> bool {
    match heap.get(object) {
        Some(target) => if target.state_value.get().module_namespace_value.get() {
            false
        } else {
            match target.state_value.get().typed_array_value.get() {
                Some(state) => match typed_array_numeric_index(key) {
                    Some(TypedArrayNumericIndex::Index(index)) => match typed_array_set_value(
                        state.view,
                        index,
                        value,
                    ) {
                        Ok(value) => value,
                        Err(_) => false,
                    },
                    Some(TypedArrayNumericIndex::Invalid) => false,
                    None => set_existing_ordinary_data_property(target, key, value),
                },
                None => match target.kind() {
                    ObjectKind::Array => match key {
                        PropertyKey::String(key_value) => if is_length_property_key(key) {
                            match (
                                target.state_value.get().array_length_value.get(),
                                array_descriptor_length(data_descriptor(value, true, false, false)),
                            ) {
                                (Some(state), Some(length)) => if state.writable {
                                    target.state_value.get().array_length_value.set(
                                        Option::Some(
                                            ArrayLengthState {
                                                value: length,
                                                writable: state.writable,
                                                enumerable: state.enumerable,
                                                configurable: state.configurable,
                                            },
                                        ),
                                    );
                                    true
                                } else {
                                    false
                                },
                                _ => false,
                            }
                        } else {
                            match canonical_array_index(key_value) {
                                Some(index) => set_existing_array_index_value(target, index, value),
                                None => set_existing_ordinary_data_property(target, key, value),
                            }
                        },
                        PropertyKey::Symbol(_) => {
                            set_existing_ordinary_data_property(target, key, value)
                        },
                    },
                    _ => set_existing_ordinary_data_property(target, key, value),
                },
            }
        },
        None => false,
    }
}

pub fn set_existing_array_index(heap: Heap, object: ObjectId, index: isize, value: Value) -> bool {
    if index < 0 || index > 4294967294 {
        return false
    }
    match heap.get(object) {
        Some(target) => match target.kind() {
            ObjectKind::Array => set_existing_array_index_value(target, index.to_u32(), value),
            _ => false,
        },
        None => false,
    }
}

fn set_existing_ordinary_data_property(target: Object, key: PropertyKey, value: Value) -> bool {
    match target.state_value.get().properties_value.get(key) {
        Some(OrdinaryProperty::Default(_)) => {
            target.state_value.get().properties_value.insert(key, OrdinaryProperty::Default(value));
            update_argument_mapping(target, key, data_descriptor(value, true, true, true));
            true
        },
        Some(OrdinaryProperty::Cached(cell)) => {
            cell.set(Option::Some(value));
            update_argument_mapping(target, key, data_descriptor(value, true, true, true));
            true
        },
        Some(OrdinaryProperty::CachedDescribed { cell, writable, enumerable, configurable }) => if writable {
            cell.set(Option::Some(value));
            update_argument_mapping(
                target,
                key,
                PropertyDescriptor::Data { value, writable, enumerable, configurable },
            );
            true
        } else {
            false
        },
        Some(OrdinaryProperty::Described(Data { value: _, writable, enumerable, configurable })) => if writable {
            target.state_value.get().properties_value.insert(
                key,
                ordinary_property_from_descriptor(
                    PropertyDescriptor::Data { value, writable, enumerable, configurable },
                ),
            );
            update_argument_mapping(
                target,
                key,
                PropertyDescriptor::Data { value, writable, enumerable, configurable },
            );
            true
        } else {
            false
        },
        _ => false,
    }
}

fn inherited_descriptor(heap: Heap, object: ObjectId, key: PropertyKey) -> Result[
    Option[PropertyDescriptor],
    TypeError,
] {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return Result::Err(invalid_object_error()),
    };
    let mut cursor = target.state_value.get().prototype_value.get();
    while cursor.is_some() {
        match cursor {
            Some(current) => {
                let candidate = match heap.get(current) {
                    Some(value) => value,
                    None => return Result::Err(invalid_object_error()),
                };
                match candidate.own_property(key) {
                    Some(descriptor) => return Result::Ok(Option::Some(descriptor)),
                    None => match candidate.state_value.get().typed_array_value.get() {
                        Some(_) => if typed_array_numeric_index(key).is_some() {
                            return Result::Ok(Option::None)
                        } else {
                            cursor = candidate.state_value.get().prototype_value.get();
                        },
                        None => {
                            cursor = candidate.state_value.get().prototype_value.get();
                        },
                    },
                }
            },
            None => (),
        }
    }
    Result::Ok(Option::None)
}

pub fn set_property(heap: Heap, object: ObjectId, key: PropertyKey, value: Value) -> Result[
    bool,
    TypeError,
] {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return Result::Err(invalid_object_error()),
    };
    if target.state_value.get().module_namespace_value.get() {
        return Result::Ok(false)
    }
    match target.state_value.get().typed_array_value.get() {
        Some(state) => match typed_array_numeric_index(key) {
            Some(TypedArrayNumericIndex::Index(index)) => {
                let written = typed_array_set_value(state.view, index, value)?;
                if typed_array_element(state.view, index).is_some() {
                    return Result::Ok(written)
                } else {
                    return Result::Ok(true)
                }
            },
            Some(TypedArrayNumericIndex::Invalid) => {
                let _ = typed_array_set_value(state.view, -1, value)?;
                return Result::Ok(true)
            },
            None => (),
        },
        None => (),
    }
    let array_length = match target.kind() {
        ObjectKind::Array => is_length_property_key(key),
        _ => false,
    };
    if array_length {
        return match target.state_value.get().array_length_value.get() {
            Some(state) => if state.writable {
                Result::Ok(
                    define_own_property(
                        heap,
                        object,
                        key,
                        PropertyDescriptor::Data {
                            value,
                            writable: state.writable,
                            enumerable: state.enumerable,
                            configurable: state.configurable,
                        },
                    ),
                )
            } else {
                Result::Ok(false)
            },
            _ => Result::Ok(false),
        }
    }
    match target.own_property(key) {
        Some(Data { writable, .. }) => if writable {
            Result::Ok(set_existing_data_property(heap, object, key, value))
        } else {
            Result::Ok(false)
        },
        Some(Accessor { set: None, .. }) => Result::Ok(false),
        Some(Accessor { set: Some(_), .. }) => Result::Err(
            TypeError { message: "accessor invocation requires the call runtime" },
        ),
        None => match inherited_descriptor(heap, object, key) {
            Err(error) => Result::Err(error),
            Ok(Some(Data { writable: false, .. })) | Ok(Some(Accessor { set: None, .. })) => {
                Result::Ok(false)
            },
            Ok(Some(Accessor { set: Some(_), .. })) => Result::Err(
                TypeError { message: "accessor invocation requires the call runtime" },
            ),
            Ok(_) => Result::Ok(
                define_own_property(heap, object, key, data_descriptor(value, true, true, true)),
            ),
        },
    }
}

fn canonical_array_index(value: JsString) -> Option[u32] {
    if value.len() == 1 && value.get(0) == 48 {
        Option::Some(0)
    } else if value.len() == 0 || value.get(0) == 48 {
        Option::None
    } else {
        let mut index = 0;
        let mut result: u64 = 0;
        while index < value.len() {
            let current = value.get(index);
            if current < 48 || current > 57 {
                return Option::None
            } else {
                result = result * 10 + (current - 48).to_u64();
                if result > 4294967294 {
                    return Option::None
                }
            }
            index += 1;
        }
        Option::Some(result.to_u32())
    }
}

fn compare_indexed_key(left: (u32, PropertyKey), right: (u32, PropertyKey)) -> isize {
    if left.0 < right.0 {
        -1
    } else if left.0 > right.0 {
        1
    } else {
        0
    }
}

pub fn own_property_keys(heap: Heap, object: ObjectId) -> Vec[PropertyKey] {
    let target = match heap.get(object) {
        Some(value) => value,
        None => return Vec::new(),
    };
    let indexed: Vec[(u32, PropertyKey)] = Vec::new();
    let strings: Vec[PropertyKey] = Vec::new();
    let symbols: Vec[PropertyKey] = Vec::new();
    let mut dense_index = 0;
    while dense_index < target.state_value.get().array_dense_properties_value.len() {
        if target.state_value.get().array_dense_properties_value[dense_index].is_some() {
            indexed.push((dense_index.to_u32(), string_property_key(dense_index.to_string())));
        }
        dense_index += 1;
    }
    for (index, _) in target.sparse_entries() {
        indexed.push((index, string_property_key(index.to_string())))
    }
    if target.state_value.get().array_length_value.get().is_some() {
        strings.push(string_property_key("length"))
    }
    for key in target.state_value.get().properties_value.keys() {
        match key {
            PropertyKey::String(value) => match canonical_array_index(value) {
                Some(index) => indexed.push((index, key)),
                None => strings.push(key),
            },
            PropertyKey::Symbol(_) => symbols.push(key),
        }
    }
    collections::sort_by(indexed, compare_indexed_key);
    let typed_length = match target.state_value.get().typed_array_value.get() {
        Some(value) => typed_array_length(value.view),
        None => 0,
    };
    let result = Vec::with_capacity(typed_length + indexed.len() + strings.len() + symbols.len());
    let mut typed_index = 0;
    while typed_index < typed_length {
        result.push(string_property_key(typed_index.to_string()));
        typed_index += 1;
    }
    for entry in indexed {
        result.push(entry.1)
    }
    for key in strings {
        result.push(key)
    }
    for key in symbols {
        result.push(key)
    }
    result
}
