package arraybuffer;

use gomlang::quickjs::bigint;
use std::math;
use std::testing;

fn expect_buffer(value: Result[ArrayBuffer, BufferError]) -> ArrayBuffer {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            loop {}
        },
    }
}

fn expect_view(value: Result[DataView, BufferError]) -> DataView {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            loop {}
